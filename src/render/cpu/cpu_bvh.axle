// cpu_bvh — a bounding-volume hierarchy over triangles, for the shadow rays of the CPU backend.
//
// Built once per frame from the triangles that may cast shadows (camera-relative, 9 floats each). The build is a
// median split: the triangles of a node are ordered by the centroid coordinate along the longest axis of their
// centroids (a stable merge sort on a fixed-point key, so ties keep their input order), cut in half, and each half
// becomes a child; leaves hold up to four triangles. No random number, hash or thread takes part, so the same
// triangles always give the same tree and the same answers. A leaf's triangles are stored as a corner and two
// edges, ready for the Moller-Trumbore test. Nodes are two adjacent array slots per split (the right child is the
// left child plus one), bounds six floats per node.
//
// Queries: `occluded` answers whether anything lies on a ray before a distance (any hit, for shadows), `nearest`
// the distance of the closest hit (for explaining a pixel, to show what a shadow ray hit). Both are read-only, so
// any number of threads may ask at once. Triangles are double-sided.

use crate::core::math::vec3::Vec3;
use crate::render::scene::scene_extract::RenderExtract;

// A leaf holds at most this many triangles.
const BVH_LEAF : i32 = 4;

// Hits closer than this along the ray are the surface's own (a ray starts on it).
const BVH_T_MIN : f32 = 0.00001;

// Determinants smaller than this are parallel rays.
const BVH_DET_MIN : f32 = 0.000000000001;

// Larger than any coordinate, for an empty bound.
const BVH_HUGE : f32 = 100000000000000000000.0;

// Fixed-point scale of centroid sort keys.
const BVH_KEY_SCALE : f32 = 1024.0;

/** A triangle BVH. */
pub class CpuBvh {
    count : i32;
    tri   : f32[];
    box   : f32[];
    first : i32[];
    size  : i32[];
    nodes : i32 = 0;

    /** Builds the tree over `count` triangles of 9 floats each (three corners); the array is copied. */
    constructor(corners : f32[], count : i32) {
        self.count = count;
        let cap : i32 = 2 * count + 2;
        self.tri = malloc<f32>((count * 9 + 9) as i64);
        self.box = malloc<f32>((cap * 6) as i64);
        self.first = malloc<i32>(cap as i64);
        self.size = malloc<i32>(cap as i64);
        let mut order : i32[] = malloc<i32>((count + 1) as i64);
        let mut cent : f32[] = malloc<f32>((count * 3 + 3) as i64);
        for (t of 0..count) {
            order[t] = t;
            for (k of 0..3) {
                cent[t * 3 + k] = (corners[t * 9 + k] + corners[t * 9 + 3 + k] + corners[t * 9 + 6 + k])
                    / (3.0 as f32);
            }
        }
        if (count > 0) {
            self.nodes = 1;
            self.split(0, 0, count, order, cent, corners, 0);
        }
        for (i of 0..count) {
            let s : i32 = order[i] * 9;
            for (k of 0..3) {
                self.tri[i * 9 + k] = corners[s + k];
                self.tri[i * 9 + 3 + k] = corners[s + 3 + k] - corners[s + k];
                self.tri[i * 9 + 6 + k] = corners[s + 6 + k] - corners[s + k];
            }
        }
    }

    /** How many triangles the tree holds. */
    pub fn triangleCount(self) : i32 {
        return self.count;
    }

    /** How many nodes the tree has. */
    pub fn nodeCount(self) : i32 {
        return self.nodes;
    }

    // Fills `node` over order[begin..end) and recurses.
    fn split(
        mut self,
        node : i32,
        begin : i32,
        end : i32,
        order : i32[],
        cent : f32[],
        corners : f32[],
        depth : i32
    ) : void {
        let mut lo : Vec3 = Vec3::splat(BVH_HUGE);
        let mut hi : Vec3 = Vec3::splat(-BVH_HUGE);
        let mut cLo : Vec3 = Vec3::splat(BVH_HUGE);
        let mut cHi : Vec3 = Vec3::splat(-BVH_HUGE);
        for (i of begin..end) {
            let t : i32 = order[i];
            for (v of 0..3) {
                lo = lo.componentMin(Vec3::make(
                    corners[t * 9 + v * 3],
                    corners[t * 9 + v * 3 + 1],
                    corners[t * 9 + v * 3 + 2]
                ));
                hi = hi.componentMax(Vec3::make(
                    corners[t * 9 + v * 3],
                    corners[t * 9 + v * 3 + 1],
                    corners[t * 9 + v * 3 + 2]
                ));
            }
            cLo = cLo.componentMin(Vec3::make(cent[t * 3], cent[t * 3 + 1], cent[t * 3 + 2]));
            cHi = cHi.componentMax(Vec3::make(cent[t * 3], cent[t * 3 + 1], cent[t * 3 + 2]));
        }
        self.box[node * 6] = lo.x;
        self.box[node * 6 + 1] = lo.y;
        self.box[node * 6 + 2] = lo.z;
        self.box[node * 6 + 3] = hi.x;
        self.box[node * 6 + 4] = hi.y;
        self.box[node * 6 + 5] = hi.z;
        let n : i32 = end - begin;
        let ex : f32 = cHi.x - cLo.x;
        let ey : f32 = cHi.y - cLo.y;
        let ez : f32 = cHi.z - cLo.z;
        let mut axis : i32 = 0;
        let mut extent : f32 = ex;
        if (ey > extent) {
            axis = 1;
            extent = ey;
        }
        if (ez > extent) {
            axis = 2;
            extent = ez;
        }
        if (n <= BVH_LEAF || depth >= 48 || !(extent > (0.0 as f32))) {
            self.first[node] = begin;
            self.size[node] = n;
            return;
        }
        let mut keys : i64[] = malloc<i64>(n as i64);
        for (i of 0..n) {
            keys[i] = (cent[order[begin + i] * 3 + axis] * BVH_KEY_SCALE) as i64;
        }
        let sorted : i32[] = RenderExtract::sortedOrder(keys, n);
        let mut copy : i32[] = malloc<i32>(n as i64);
        for (i of 0..n) {
            copy[i] = order[begin + sorted[i]];
        }
        for (i of 0..n) {
            order[begin + i] = copy[i];
        }
        let mid : i32 = begin + n / 2;
        let left : i32 = self.nodes;
        self.nodes = self.nodes + 2;
        self.first[node] = left;
        self.size[node] = 0;
        self.split(left, begin, mid, order, cent, corners, depth + 1);
        self.split(left + 1, mid, end, order, cent, corners, depth + 1);
    }

    // The slab test of node `node` against a ray with inverse direction (ix, iy, iz), up to `tmax`.
    fn boxHit(
        self,
        node : i32,
        ox : f32,
        oy : f32,
        oz : f32,
        ix : f32,
        iy : f32,
        iz : f32,
        tmax : f32
    ) : bool {
        let b : i32 = node * 6;
        let mut t0 : f32 = 0.0;
        let mut t1 : f32 = tmax;
        let ax : f32 = (self.box[b] - ox) * ix;
        let bx : f32 = (self.box[b + 3] - ox) * ix;
        t0 = CpuBvh::most(t0, CpuBvh::least(ax, bx));
        t1 = CpuBvh::least(t1, CpuBvh::most(ax, bx));
        let ay : f32 = (self.box[b + 1] - oy) * iy;
        let by : f32 = (self.box[b + 4] - oy) * iy;
        t0 = CpuBvh::most(t0, CpuBvh::least(ay, by));
        t1 = CpuBvh::least(t1, CpuBvh::most(ay, by));
        let az : f32 = (self.box[b + 2] - oz) * iz;
        let bz : f32 = (self.box[b + 5] - oz) * iz;
        t0 = CpuBvh::most(t0, CpuBvh::least(az, bz));
        t1 = CpuBvh::least(t1, CpuBvh::most(az, bz));
        return t0 <= t1;
    }

    static fn least(a : f32, b : f32) : f32 {
        if (a < b) {
            return a;
        }
        return b;
    }

    static fn most(a : f32, b : f32) : f32 {
        if (a > b) {
            return a;
        }
        return b;
    }

    // 1 / d with a huge finite value for a zero component (division by zero would trap).
    static fn inverse(d : f32) : f32 {
        if (d > (0.0000000001 as f32) || d < (-0.0000000001 as f32)) {
            return (1.0 as f32) / d;
        }
        if (d < (0.0 as f32)) {
            return -BVH_HUGE;
        }
        return BVH_HUGE;
    }

    // The distance along the ray of triangle `t` (index into the reordered array), or -1 for a miss.
    fn hitTriangle(
        self,
        t : i32,
        ox : f32,
        oy : f32,
        oz : f32,
        dx : f32,
        dy : f32,
        dz : f32,
        tmax : f32
    ) : f32 {
        let b : i32 = t * 9;
        let e1x : f32 = self.tri[b + 3];
        let e1y : f32 = self.tri[b + 4];
        let e1z : f32 = self.tri[b + 5];
        let e2x : f32 = self.tri[b + 6];
        let e2y : f32 = self.tri[b + 7];
        let e2z : f32 = self.tri[b + 8];
        let px : f32 = dy * e2z - dz * e2y;
        let py : f32 = dz * e2x - dx * e2z;
        let pz : f32 = dx * e2y - dy * e2x;
        let det : f32 = e1x * px + e1y * py + e1z * pz;
        if (det < BVH_DET_MIN && det > -BVH_DET_MIN) {
            return -1.0;
        }
        let inv : f32 = (1.0 as f32) / det;
        let sx : f32 = ox - self.tri[b];
        let sy : f32 = oy - self.tri[b + 1];
        let sz : f32 = oz - self.tri[b + 2];
        let u : f32 = (sx * px + sy * py + sz * pz) * inv;
        if (u < (0.0 as f32) || u > (1.0 as f32)) {
            return -1.0;
        }
        let qx : f32 = sy * e1z - sz * e1y;
        let qy : f32 = sz * e1x - sx * e1z;
        let qz : f32 = sx * e1y - sy * e1x;
        let v : f32 = (dx * qx + dy * qy + dz * qz) * inv;
        if (v < (0.0 as f32) || u + v > (1.0 as f32)) {
            return -1.0;
        }
        let t : f32 = (e2x * qx + e2y * qy + e2z * qz) * inv;
        if (t > BVH_T_MIN && t < tmax) {
            return t;
        }
        return -1.0;
    }

    // Any hit below `tmax` in the subtree of `node`.
    fn anyHit(
        self,
        node : i32,
        ox : f32,
        oy : f32,
        oz : f32,
        dx : f32,
        dy : f32,
        dz : f32,
        ix : f32,
        iy : f32,
        iz : f32,
        tmax : f32
    ) : bool {
        if (!self.boxHit(node, ox, oy, oz, ix, iy, iz, tmax)) {
            return false;
        }
        if (self.size[node] > 0) {
            for (i of self.first[node]..self.first[node] + self.size[node]) {
                if (self.hitTriangle(i, ox, oy, oz, dx, dy, dz, tmax) > (0.0 as f32)) {
                    return true;
                }
            }
            return false;
        }
        let left : i32 = self.first[node];
        return self.anyHit(left, ox, oy, oz, dx, dy, dz, ix, iy, iz, tmax)
            || self.anyHit(left + 1, ox, oy, oz, dx, dy, dz, ix, iy, iz, tmax);
    }

    /** True when something lies on the ray from (ox, oy, oz) along the direction (dx, dy, dz) before distance `tmax` (in units of the direction's length). */
    pub fn occluded(self, ox : f32, oy : f32, oz : f32, dx : f32, dy : f32, dz : f32, tmax : f32) : bool {
        if (self.nodes == 0) {
            return false;
        }
        return self.anyHit(
            0,
            ox,
            oy,
            oz,
            dx,
            dy,
            dz,
            CpuBvh::inverse(dx),
            CpuBvh::inverse(dy),
            CpuBvh::inverse(dz),
            tmax
        );
    }

    /** The distance of the nearest hit on the ray below `tmax`, or -1 for none. */
    pub fn nearest(self, ox : f32, oy : f32, oz : f32, dx : f32, dy : f32, dz : f32, tmax : f32) : f32 {
        if (self.nodes == 0) {
            return -1.0;
        }
        let ix : f32 = CpuBvh::inverse(dx);
        let iy : f32 = CpuBvh::inverse(dy);
        let iz : f32 = CpuBvh::inverse(dz);
        let mut best : f32 = tmax;
        let mut found : bool = false;
        let mut stack : i32[] = malloc<i32>(64);
        let mut top : i32 = 0;
        stack[0] = 0;
        top = 1;
        while (top > 0) {
            top = top - 1;
            let node : i32 = stack[top];
            if (!self.boxHit(node, ox, oy, oz, ix, iy, iz, best)) {
                continue;
            }
            if (self.size[node] > 0) {
                for (i of self.first[node]..self.first[node] + self.size[node]) {
                    let t : f32 = self.hitTriangle(i, ox, oy, oz, dx, dy, dz, best);
                    if (t > (0.0 as f32)) {
                        best = t;
                        found = true;
                    }
                }
            } else if (top < 62) {
                stack[top] = self.first[node];
                stack[top + 1] = self.first[node] + 1;
                top = top + 2;
            }
        }
        if (found) {
            return best;
        }
        return -1.0;
    }
}

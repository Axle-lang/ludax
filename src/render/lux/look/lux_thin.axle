// lux_thin — crossing a thin, perforated surface: a portal's sheet, a stained pane, a curtain of leaves, a grate.
//
// A thin surface has no inside worth tracing: the ray that meets it goes on behind it, bent and tinted, and the surface
// adds what it emits (handbook 3.17):
//
//   axes      the two world axes of the face struck (u, v): the coordinates a look reads its fields in, continuous
//             across a wall of such cells in one plane
//   onward    d' = normalize(d + bendU û + bendV v̂), the bend from the look's `Bend` ops
//   seen      L = tint · L_behind(d') + emit
//
// The program traces the onward ray (passing through the surface's own obstacle class) and calls `luxThinSeen`; the
// look (`LuxLookBank`, interface `Thin`) gives the bend, the tint and the emission.

use crate::core::math::vec3::Vec3;

/** The two world axes of a face, the coordinates its look is read in. */
pub struct LuxFaceAxes {
    /** The first axis: x, or z on a face whose normal is along x. */
    pub u : Vec3 = Vec3 { x: 1.0, y: 0.0, z: 0.0 };

    /** The second axis: y, or z on a horizontal face. */
    pub v : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };
}

/** The axes of a face of axis-aligned normal `n`. */
pub fn luxFaceAxes(n : Vec3) : LuxFaceAxes {
    let mut u : Vec3 = Vec3::make(1.0, 0.0, 0.0);
    let mut v : Vec3 = Vec3::make(0.0, 1.0, 0.0);
    if (n.y != 0.0) {
        v = Vec3::make(0.0, 0.0, 1.0);
    } else if (n.x != 0.0) {
        u = Vec3::make(0.0, 0.0, 1.0);
    }
    return LuxFaceAxes { u: u, v: v };
}

/** The direction a ray `d` goes on in behind a thin surface whose look bends it by (`bendU`, `bendV`) along `axes`. */
pub fn luxThinOnward(d : Vec3, axes : LuxFaceAxes, bendU : f32, bendV : f32) : Vec3 {
    return d.plus(axes.u.scale(bendU)).plus(axes.v.scale(bendV)).normalized();
}

/** What a thin surface shows: what is behind it, tinted, and what it emits. */
pub fn luxThinSeen(behind : Vec3, tint : Vec3, emit : Vec3) : Vec3 {
    return behind.times(tint).plus(emit);
}

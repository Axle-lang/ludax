// lux_immersion — the view from inside a medium bounded by a free surface: an eye under water, in a lava lake, in a fog
// bank with a top. And the light that reaches what lies inside.
//
// From inside, a ray crosses the medium up to the first solid or the boundary, whichever comes first (handbook 3.17):
//
//   a solid        its light through the medium, `T(t) L + G(t)` (`luxMediumSegment`)
//   the boundary   Snell's window: within asin(1/n) of the normal the world beyond, refracted, weighted by 1 - F, the
//                  underside's reflection by F; outside it total internal reflection, the underside alone
//   nothing        the glow of the medium over the whole reach
//
// The medium scatters the light that reached it, less of it the deeper the eye: the source at depth is the calibrated
// source dimmed by the medium above (`luxDepthSource`). What lies inside is lit by the sun refracted at the boundary
// (within asin(1/n) of the normal however low the sun), its path through the medium `depth / cos θ_t`
// (`LuxSunInside`): the same refraction for every point, computed once a frame.

use crate::core::math::scalar::max;
use crate::core::math::vec3::Vec3;
use crate::render::lux::medium::lux_interface::LuxFluidQuality;
use crate::render::lux::medium::lux_medium::{
    LuxMedium, LuxRefraction, luxMediumSource, luxMediumTransmit, luxRefract
};

/** The least cosine the sun's refracted path is taken to dive at, so a path through the medium stays finite. */
const LUXI_SUN_DIVE : f32 = 0.05;

/** What a ray from inside does at the boundary. */
pub struct LuxExit {
    /** The direction it leaves in, or its reflection when it cannot leave. */
    pub dir : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** True outside Snell's window: total internal reflection, the boundary is a mirror. */
    pub total : bool = false;

    /** The Fresnel reflectance of the crossing. */
    pub fresnel : f32 = 1.0;

    /** The underside's reflection back into the medium. */
    pub mirror : Vec3 = Vec3 { x: 0.0, y: -1.0, z: 0.0 };
}

/** The sun as seen from inside a medium: the direction toward it after refraction, and the share that crossed the boundary. */
pub struct LuxSunInside {
    /** The direction from a point inside toward the sun, refracted: within asin(1/n) of the boundary's normal. */
    pub toSun : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** The share of the sun that crossed the boundary, 1 - F. */
    pub crossed : f32 = 1.0;
}

/**
 * How far along `d` from `o` a ray inside meets a horizontal boundary at height `top`: the reach when it does not rise
 * (or rises too slowly to matter).
 */
pub fn luxBoundaryDistance(o : Vec3, d : Vec3, top : f32, q : LuxFluidQuality) : f32 {
    if (d.y > q.immersedLevel) {
        return (top - o.y) / d.y;
    }
    return q.immersedReach;
}

/** What a ray `d` from inside does at a boundary whose resolved normal, pointing out of the medium, is `up`. */
pub fn luxExit(d : Vec3, up : Vec3, m : LuxMedium) : LuxExit {
    let down : Vec3 = up.negated();
    let out : LuxRefraction = luxRefract(d, down, m.index, 1.0);
    return LuxExit {
        dir: out.dir,
        total: out.total,
        fresnel: out.fresnel,
        mirror: d.minus(down.scale((2.0 as f32) * d.dot(down))),
    };
}

/** What the boundary shows from inside: the underside alone outside Snell's window, else the world beyond and the underside by Fresnel. */
pub fn luxAcrossBoundary(beyond : Vec3, underside : Vec3, e : LuxExit) : Vec3 {
    if (e.total) {
        return underside;
    }
    return beyond.lerp(underside, e.fresnel);
}

/** The light the medium scatters at `depth` metres under its boundary: the calibrated source of `deep`, dimmed by the medium above. */
pub fn luxDepthSource(m : LuxMedium, deep : Vec3, depth : f32) : Vec3 {
    return luxMediumSource(m, deep).times(luxMediumTransmit(m, depth));
}

/** The sun of direction `sunDir` (toward it) refracted into a medium under a horizontal boundary: once a frame. */
pub fn luxSunInside(sunDir : Vec3, m : LuxMedium) : LuxSunInside {
    let into : LuxRefraction = luxRefract(sunDir.negated(), Vec3::make(0.0, 1.0, 0.0), 1.0, m.index);
    return LuxSunInside { toSun: into.dir.negated(), crossed: (1.0 as f32) - into.fresnel };
}

/** How far the sun's light travels through the medium to a point `depth` metres under the boundary. */
pub fn luxSunPath(sun : LuxSunInside, depth : f32) : f32 {
    return depth / max(sun.toSun.y, LUXI_SUN_DIVE);
}

// lux_tiles — the picture cut into tiles, the unit a fused group of screen layers is run over.
//
// A fused group (`LuxGraph.groupOf`) takes each tile through all of its layers before moving to the next, so the
// tile's pixels are read from the processor's cache rather than from memory by every layer in turn. A tile of
// `LUX_TILE_W` x `LUX_TILE_H` pixels is 1 024 pixels: with the eight or so f32 planes a lit pixel carries (depth,
// normal, albedo, light), about 32 KB, which stays in the 48 KB first-level data cache of the reference machine (Zen 5)
// while a group works on it. Tiles are wide and short because rows are contiguous in memory: a row of 64 f32 is four
// cache lines, read whole.
//
// Tiles are numbered row by row, left to right. The job pool hands tiles out in chunks; a tile's results go to its
// own pixels only, so the order the workers take tiles in never changes the picture (handbook 4.1 §6).

/** The width of a tile, pixels: 64 f32 are four 64-byte cache lines and eight `f32x8` lanes groups. */
pub const LUX_TILE_W : i32 = 64;

/** The height of a tile, pixels. */
pub const LUX_TILE_H : i32 = 16;

/** The pixels of one tile: columns `x0` up to `x1` excluded, rows `y0` up to `y1` excluded. */
pub struct LuxTile {
    /** The first column. */
    pub x0 : i32 = 0;

    /** The first row. */
    pub y0 : i32 = 0;

    /** One past the last column. */
    pub x1 : i32 = 0;

    /** One past the last row. */
    pub y1 : i32 = 0;
}

/** A picture of `width` x `height` pixels cut into tiles; the last column and row of tiles may be smaller. */
pub struct LuxTiles {
    /** The picture's width, pixels. */
    pub width : i32 = 0;

    /** The picture's height, pixels. */
    pub height : i32 = 0;

    /** Tiles across. */
    pub across : i32 = 0;

    /** Tiles down. */
    pub down : i32 = 0;

    /** The tiles of a `width` x `height` picture; a picture with no pixels has no tiles. */
    pub static fn cover(width : i32, height : i32) : LuxTiles {
        let w : i32 = luxAtLeastZero(width);
        let h : i32 = luxAtLeastZero(height);
        return LuxTiles {
            width: w,
            height: h,
            across: (w + LUX_TILE_W - 1) / LUX_TILE_W,
            down: (h + LUX_TILE_H - 1) / LUX_TILE_H,
        };
    }

    /** How many tiles there are. */
    pub fn count(self) : i32 {
        return self.across * self.down;
    }

    /** Tile `i`, numbered row by row; its edges are clipped to the picture. */
    pub fn tile(self, i : i32) : LuxTile {
        let row : i32 = i / luxAtLeastOneTile(self.across);
        let col : i32 = i - row * self.across;
        let x0 : i32 = col * LUX_TILE_W;
        let y0 : i32 = row * LUX_TILE_H;
        return LuxTile {
            x0: x0,
            y0: y0,
            x1: luxSmaller(x0 + LUX_TILE_W, self.width),
            y1: luxSmaller(y0 + LUX_TILE_H, self.height),
        };
    }
}

fn luxAtLeastZero(v : i32) : i32 {
    if (v < 0) {
        return 0;
    }
    return v;
}

fn luxAtLeastOneTile(v : i32) : i32 {
    if (v < 1) {
        return 1;
    }
    return v;
}

fn luxSmaller(a : i32, b : i32) : i32 {
    if (a < b) {
        return a;
    }
    return b;
}

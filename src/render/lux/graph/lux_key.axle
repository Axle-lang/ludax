// lux_key — what a cached light computation was made from, as plain integers a layer can compare.
//
// A layer of light is stale when something it was made from has changed. Each such thing is one integer of a
// `LuxKey`: the world's edit epoch, the step of the sun along its day, the camera's cell, the epoch of the art table
// (timecycle), the epoch of the settings, and the frame number. A layer names the parts it depends on with a mask of
// `LUX_IN_*` bits and is re-run when one of those parts differs from the key it was last made from.
//
// Only integers, never floats and never a hash: two keys are equal exactly when their inputs are, the comparison
// costs six loads, and the same run gives the same decisions on every machine and with any number of threads.
// Floats that move continuously (the sun, the camera) enter through a step or a cell, so a cache made at one step
// stays valid until the next one, and the layer that reads it blends between generations instead of popping.

/** The world (blocks, chunks, edits) a layer was made from. */
pub const LUX_IN_WORLD : u32 = 1;

/** The step of the sun along its day (`LuxView.sunStep`). */
pub const LUX_IN_SUN : u32 = 2;

/** The camera's cell (`LuxView.cameraCell`): world-space caches centred on the camera. */
pub const LUX_IN_CAMERA : u32 = 4;

/** The epoch of the art table that grades the hour (timecycle). */
pub const LUX_IN_TIMECYCLE : u32 = 8;

/** The epoch of the settings (resolution, quality, feature switches). */
pub const LUX_IN_SETTINGS : u32 = 16;

/** The frame number: a layer with this bit runs every frame. */
pub const LUX_IN_FRAME : u32 = 32;

/** Every input: a layer that depends on everything. */
pub const LUX_IN_ALL : u32 = 63;

/** The inputs of one frame, as the integers caches are compared on. */
pub struct LuxKey {
    /** The world's edit epoch. */
    pub world : i64 = 0;

    /** The sun's step along its day. */
    pub sun : i64 = 0;

    /** The camera's cell, packed. */
    pub camera : i64 = 0;

    /** The epoch of the timecycle table. */
    pub timecycle : i64 = 0;

    /** The epoch of the settings. */
    pub settings : i64 = 0;

    /** The frame number. */
    pub frame : i64 = 0;

    /** True when this key and `other` differ in at least one of the inputs named by `mask`. */
    pub fn differsIn(self, other : LuxKey, mask : u32) : bool {
        if ((mask & LUX_IN_WORLD) != 0 && self.world != other.world) {
            return true;
        }
        if ((mask & LUX_IN_SUN) != 0 && self.sun != other.sun) {
            return true;
        }
        if ((mask & LUX_IN_CAMERA) != 0 && self.camera != other.camera) {
            return true;
        }
        if ((mask & LUX_IN_TIMECYCLE) != 0 && self.timecycle != other.timecycle) {
            return true;
        }
        if ((mask & LUX_IN_SETTINGS) != 0 && self.settings != other.settings) {
            return true;
        }
        return (mask & LUX_IN_FRAME) != 0 && self.frame != other.frame;
    }

    /** The mask of the inputs in which this key and `other` differ. */
    pub fn changes(self, other : LuxKey) : u32 {
        let mut mask : u32 = 0;
        if (self.world != other.world) {
            mask = mask | LUX_IN_WORLD;
        }
        if (self.sun != other.sun) {
            mask = mask | LUX_IN_SUN;
        }
        if (self.camera != other.camera) {
            mask = mask | LUX_IN_CAMERA;
        }
        if (self.timecycle != other.timecycle) {
            mask = mask | LUX_IN_TIMECYCLE;
        }
        if (self.settings != other.settings) {
            mask = mask | LUX_IN_SETTINGS;
        }
        if (self.frame != other.frame) {
            mask = mask | LUX_IN_FRAME;
        }
        return mask;
    }
}

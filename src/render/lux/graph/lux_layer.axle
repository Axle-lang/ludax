// lux_layer — what a layer of light declares about itself: where it lives, how often it must be redone, at what cost.
//
// A layer is one computation of the light: the sky's tables, a page of sun shadow, the fog grid, the shading of the
// screen, the grade. Each declares, besides the buffers it reads and writes (`LuxGraph`), the facts the scheduler
// decides with:
//   - its domain: per screen pixel, per world cell, in the sun's space, per sky direction, or a handful of numbers.
//     Screen layers of the same scale are fused into one walk over tiles; the others are not;
//   - its scale: 1 for full resolution, 2 for half, 4 for a quarter. Smooth signals are computed coarse
//     (handbook 1.1);
//   - its inputs (`LUX_IN_*`): which parts of the frame's key make it stale;
//   - its period: redone at least every `every` frames even when nothing it reads changed (0: never forced), for
//     inputs the key cannot see, such as clouds drifting;
//   - its slices: a refresh spread over `slices` frames, one slice a frame, published whole when the last one is
//     done (1: done in the frame it starts). This is how a heavy cache costs a fixed share of each frame instead of
//     a hitch; a reader keeps the previous generation until the new one is complete;
//   - its budget, nanoseconds a frame on one thread: what the layer is expected to cost, compared with what it
//     measures (`LuxBudget`).

/** Where a layer's results live. */
pub enum LuxDomain : i8 {
    /** One result per pixel of the picture, at the layer's scale. */
    Screen = 0,
    /** One result per cell of a grid fixed in the world. */
    World = 1,
    /** One result per texel of a map seen from the sun. */
    SunSpace = 2,
    /** One result per direction of the sky. */
    SkyDirections = 3,
    /** A handful of numbers for the whole frame (exposure, sun colour). */
    Scalar = 4,
}

/** The facts the scheduler needs about one layer; the buffers it touches are declared on the graph. */
pub struct LuxLayerDesc {
    /** Where the layer's results live. */
    pub domain : LuxDomain = LuxDomain::Screen;

    /** The divisor of its resolution: 1 full, 2 half, 4 quarter. */
    pub scale : i32 = 1;

    /** The inputs that make it stale, as `LUX_IN_*` bits. */
    pub inputs : u32 = 0;

    /** Redone at least every this many frames; 0 when only its inputs decide. */
    pub every : i32 = 0;

    /** The frames one refresh is spread over, at least 1. */
    pub slices : i32 = 1;

    /** What it is expected to cost, nanoseconds a frame on one thread. */
    pub budget : i64 = 0;
}

/** A description with every field given, the form the graph stores (a partial literal is unsafe, F9). */
pub fn luxLayer(domain : LuxDomain, scale : i32, inputs : u32, slices : i32) : LuxLayerDesc {
    return LuxLayerDesc {
        domain: domain,
        scale: scale,
        inputs: inputs,
        every: 0,
        slices: slices,
        budget: 0,
    };
}

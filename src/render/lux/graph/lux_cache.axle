// lux_cache — a cache of light kept from frame to frame, read from one copy while the next is written into the other.
//
// A cache that takes several frames to refresh (a sky table spread over slices, shadow pages rebuilt in the
// background) must never be seen half-written: a pixel would mix two suns, or two worlds, and the picture would tear
// for a frame. So a cache holds two copies. Readers only ever see the front one; the refresh writes the back one; and
// `publish` swaps them, which the scheduler does on the main thread between two frames, when no worker is running.
// A reader therefore sees one whole generation for a whole frame, whatever the threads and the clock are doing.
//
// The data is `planes` planes of `size` floats each (a plane per channel, which is what the SIMD loops read, see
// `lux_simd`). A refresh that rewrites only part of the cache (some pages, some probes) calls `carry` first so the
// back copy starts as the front one; a refresh that rewrites everything does not pay for it.
//
// Each generation remembers the key it was made from and gets a version number, raised by one at each publication:
// the layers that read the cache compare versions to know whether there is something new.

use crate::render::lux::graph::lux_key::LuxKey;

/** Two copies of a cache of light: readers see the front, the refresh writes the back, `publish` swaps them. */
pub class LuxCache {
    planes   : i32;
    size     : i64;
    first    : f32[];
    second   : f32[];
    front    : i32 = 0;
    version  : i64 = 0;
    madeFrom : LuxKey;

    /** A cache of `planes` planes of `size` floats each, every value zero, version 0. */
    constructor(planes : i32, size : i64) {
        self.planes = planes;
        self.size = size;
        let total : i64 = (planes as i64) * size + 1;
        self.first = new f32[total];
        self.second = new f32[total];
        for (i of 0..total) {
            self.first[i] = 0.0;
            self.second[i] = 0.0;
        }
        self.madeFrom = LuxKey { world: 0, sun: 0, camera: 0, timecycle: 0, settings: 0, frame: 0 };
    }

    /** The copy readers see; valid for the whole frame. */
    pub fn read(self) : f32[] {
        if (self.front == 0) {
            return self.first;
        }
        return self.second;
    }

    /** The copy the refresh writes; nobody reads it until `publish`. */
    pub fn write(self) : f32[] {
        if (self.front == 0) {
            return self.second;
        }
        return self.first;
    }

    /** Where plane `p` starts in either copy. */
    pub fn planeAt(self, p : i32) : i64 {
        return (p as i64) * self.size;
    }

    /** How many planes the cache has. */
    pub fn planeCount(self) : i32 {
        return self.planes;
    }

    /** How many floats one plane holds. */
    pub fn planeSize(self) : i64 {
        return self.size;
    }

    /** Copies the front into the back, for a refresh that rewrites only part of the cache. */
    pub fn carry(mut self) : void {
        let from : f32[] = self.read();
        let mut into : f32[] = self.write();
        let total : i64 = (self.planes as i64) * self.size;
        for (i of 0..total) {
            into[i] = from[i];
        }
    }

    /**
     * Makes the back copy the one readers see, made from `key`, and raises the version. Call it only between two
     * frames, with no worker running.
     */
    pub fn publish(mut self, key : LuxKey) : void {
        self.front = 1 - self.front;
        self.version = self.version + 1;
        self.madeFrom = key;
    }

    /** How many generations were published: 0 until the first one. */
    pub fn versionOf(self) : i64 {
        return self.version;
    }

    /** The key the generation readers see was made from. */
    pub fn key(self) : LuxKey {
        return self.madeFrom;
    }
}

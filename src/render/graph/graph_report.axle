// graph_report — a graph and its plan as text a person can read (design rule 8: observable).
//
// `GraphReport::text` lists the problems, the passes in the order they run with what each reads and writes, the
// culled passes, every used resource with its size, lifetime and memory block, and the saving from aliasing. When
// the backend has filled a `PassCosts`, each pass also shows its draw calls, triangles in and rasterised, and pixels
// shaded: those are deterministic. Measured time is added only when asked (`withTimes`), because it differs from run
// to run and a report without it can be compared byte for byte.

use crate::render::cmd::cmd_costs::PassCosts;
use crate::render::graph::graph_graph::RenderGraph;
use crate::render::graph::graph_plan::GraphPlan;
use crate::render::graph::graph_types::{GraphResKind, GraphFormat, PassKind, GraphNames, GraphIssues};

/** Renders reports. */
pub class GraphReport {
    /** The report of `plan`, compiled from `g`; `costs` may be null-like (a table with no counts) and `withTimes` adds measured time. */
    pub static fn text(g : RenderGraph, plan : GraphPlan, costs : PassCosts, withTimes : bool) : string {
        let mut s : string = "render graph: " + g.passTotal().toString() + " passes ("
            + plan.runCount().toString()
            + " run, "
            + plan.culledCount().toString()
            + " culled), "
            + g.resourceTotal().toString()
            + " resources\n";
        let issues : GraphIssues = plan.problems();
        if (issues.count() > 0) {
            s = s + "problems:\n";
            for (i of 0..issues.count()) {
                s = s + "  - " + issues.text(i) + "\n";
            }
        }
        s = s + "order:\n";
        for (i of 0..plan.runCount()) {
            let p : i32 = plan.passAt(i);
            s = s + "  " + i.toString() + ". " + g.passName(p) + " [" + GraphNames::passWord(g.passKindOf(p))
                + "] reads "
                + GraphReport::list(g, p, false)
                + " writes "
                + GraphReport::list(g, p, true)
                + "\n";
            if (costs.has(p)
                && (costs.drawCalls(p) > 0 || costs.pixelsShaded(p) > 0 || costs.trianglesSubmitted(p) > 0)) {
                s = s + "       " + costs.drawCalls(p).toString() + " draws, "
                    + costs.trianglesSubmitted(p).toString()
                    + " triangles in, "
                    + costs.trianglesRasterised(p).toString()
                    + " rasterised, "
                    + costs.pixelsShaded(p).toString()
                    + " pixels shaded\n";
            }
            if (withTimes && costs.has(p) && costs.callsOf(p) > 0) {
                s = s + "       " + GraphReport::millis(costs.nanosOf(p)) + " ms (CPU)\n";
            }
        }
        for (i of 0..plan.culledCount()) {
            s = s + "culled: " + g.passName(plan.culledAt(i)) + " (nothing that is drawn depends on it)\n";
        }
        s = s + "resources:\n";
        for (r of 0..g.resourceTotal()) {
            s = s + "  " + g.resourceName(r) + " " + GraphNames::kindWord(g.resourceKind(r));
            if (g.resourceFormat(r) != GraphFormat::Opaque) {
                s = s + " " + g.resourceWidth(r).toString() + "x" + g.resourceHeight(r).toString() + " "
                    + GraphNames::formatWord(g.resourceFormat(r));
            }
            s = s + " " + g.resourceBytes(r).toString() + " B";
            if (g.isImported(r)) {
                s = s + " imported";
            }
            if (g.isOutput(r)) {
                s = s + " output";
            }
            if (!plan.isUsed(r)) {
                s = s + " unused\n";
                continue;
            }
            s = s + " alive " + plan.firstUseOf(r).toString() + ".." + plan.lastUseOf(r).toString();
            if (plan.aliasGroup(r) >= 0) {
                s = s + " block " + plan.aliasGroup(r).toString();
            }
            s = s + "\n";
        }
        s = s + "memory: " + plan.transientBytes().toString() + " B transient, "
            + plan.aliasedBytes().toString()
            + " B with aliasing in "
            + plan.groupCount().toString()
            + " blocks, "
            + plan.persistentBytes().toString()
            + " B persistent\n";
        return s;
    }

    // The names of the resources pass `p` reads or writes, comma separated, or "-".
    static fn list(g : RenderGraph, p : i32, write : bool) : string {
        let mut s : string = "";
        for (e of 0..g.edgeTotal()) {
            if (g.edgePassOf(e) == p && g.edgeIsWrite(e) == write) {
                if (s.byteLength > 0) {
                    s = s + ", ";
                }
                s = s + g.edgeResourceName(e);
            }
        }
        if (s.byteLength == 0) {
            return "-";
        }
        return s;
    }

    // Milliseconds with two decimals from nanoseconds.
    static fn millis(nanos : i64) : string {
        let hundredths : i64 = nanos / 10000;
        let whole : i64 = hundredths / 100;
        let frac : i64 = hundredths % 100;
        let mut f : string = frac.toString();
        if (frac < 10) {
            f = "0" + f;
        }
        return whole.toString() + "." + f;
    }
}

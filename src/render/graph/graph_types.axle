// graph_types — the vocabulary of the render graph: resource kinds, formats, pass kinds, and the issues found.
//
// A graph is built from names and small enums only. `GraphIssues` is a fixed-capacity log of what validation
// found: a kind (so a test or a tool can branch on it) and a sentence (so a person can read it). It never grows,
// because a generic container of strings is not safe in the compiler we pin; the 128th problem and the ones after
// it are counted, not stored, and by then the graph is plainly broken.

/** What a resource is. */
pub enum GraphResKind : i8 {
    /** A colour render target. */
    Color = 0,
    /** A depth render target. */
    Depth = 1,
    /** A sampled texture (imported, or written by a pass and read later). */
    Texture = 2,
    /** An acceleration structure shadow rays traverse. */
    Accel = 3,
}

/** How the texels of an image resource are stored; decides its size. */
pub enum GraphFormat : i8 {
    /** Linear HDR colour, 4 x f32 (16 bytes per pixel). */
    Hdr = 0,
    /** 32-bit depth (4 bytes). */
    Depth32 = 1,
    /** 8-bit sRGB RGBA (4 bytes). */
    Srgb8 = 2,
    /** Not an image: the resource has an explicit byte size. */
    Opaque = 3,
}

/** What a pass does; the frame recorder turns each kind into commands. */
pub enum PassKind : i8 {
    /** Builds an acceleration structure from the scene. */
    BuildAccel = 0,
    /** Draws the scene's instances into colour and depth with full shading. */
    Forward = 1,
    /** Tone maps a colour resource into another. */
    Resolve = 2,
    /** A pass that records no commands of its own (a placeholder for work a backend does by itself). */
    Custom = 3,
}

/** The kinds of problem validation reports. */
pub enum GraphIssueKind : i8 {
    /** Two resources or two passes share a name. */
    DuplicateName = 0,
    /** A pass names a resource that was never declared. */
    UnknownResource = 1,
    /** A pass reads a resource that no pass writes. */
    UnwrittenRead = 2,
    /** A pass reads a resource it also writes before any other pass wrote it. */
    ReadBeforeWrite = 3,
    /** The dependencies between passes form a cycle. */
    Cycle = 4,
    /** No pass writes an output or an imported resource, so every pass would be culled. */
    NoOutput = 5,
    /** A pass was given a resource of the wrong kind for what it does. */
    WrongKind = 6,
}

// The most issues kept.
const GISS_ROOM : i32 = 128;

/** A log of validation problems: a kind and a sentence each. */
pub class GraphIssues {
    kinds : i32[];
    texts : string[];
    used  : i32 = 0;
    lost  : i32 = 0;

    /** An empty log. */
    constructor() {
        self.kinds = malloc<i32>(128);
        self.texts = malloc<string>(128);
        for (i of 0..128) {
            self.texts[i] = "";
        }
    }

    /** Records a problem. */
    pub fn add(mut self, kind : GraphIssueKind, text : string) : void {
        if (self.used >= GISS_ROOM) {
            self.lost = self.lost + 1;
            return;
        }
        self.kinds[self.used] = GraphIssues::codeOf(kind);
        self.texts[self.used] = text + "";
        self.used = self.used + 1;
    }

    /** How many problems are recorded (those beyond the log's capacity are not counted here). */
    pub fn count(self) : i32 {
        return self.used;
    }

    /** The sentence of problem `i`. */
    pub fn text(self, i : i32) : string {
        return self.texts[i] + "";
    }

    /** The kind of problem `i`. */
    pub fn kind(self, i : i32) : GraphIssueKind {
        return GraphIssues::kindOf(self.kinds[i]);
    }

    /** How many recorded problems are of `kind`. */
    pub fn countOf(self, kind : GraphIssueKind) : i32 {
        let code : i32 = GraphIssues::codeOf(kind);
        let mut n : i32 = 0;
        for (i of 0..self.used) {
            if (self.kinds[i] == code) {
                n = n + 1;
            }
        }
        return n;
    }

    /** How many problems did not fit. */
    pub fn dropped(self) : i32 {
        return self.lost;
    }

    /** The integer code of an issue kind. */
    pub static fn codeOf(kind : GraphIssueKind) : i32 {
        return match kind {
            GraphIssueKind::DuplicateName => 0,
            GraphIssueKind::UnknownResource => 1,
            GraphIssueKind::UnwrittenRead => 2,
            GraphIssueKind::ReadBeforeWrite => 3,
            GraphIssueKind::Cycle => 4,
            GraphIssueKind::NoOutput => 5,
            GraphIssueKind::WrongKind => 6,
        };
    }

    /** The issue kind of a code. */
    pub static fn kindOf(code : i32) : GraphIssueKind {
        return match code {
            0 => GraphIssueKind::DuplicateName,
            1 => GraphIssueKind::UnknownResource,
            2 => GraphIssueKind::UnwrittenRead,
            3 => GraphIssueKind::ReadBeforeWrite,
            4 => GraphIssueKind::Cycle,
            5 => GraphIssueKind::NoOutput,
            _ => GraphIssueKind::WrongKind,
        };
    }
}

/** Helpers that turn the enums into numbers and words. */
pub class GraphNames {
    /** Bytes one pixel of `format` takes (0 for `Opaque`). */
    pub static fn bytesPerPixel(format : GraphFormat) : i32 {
        return match format {
            GraphFormat::Hdr => 16,
            GraphFormat::Depth32 => 4,
            GraphFormat::Srgb8 => 4,
            GraphFormat::Opaque => 0,
        };
    }

    /** The word for a resource kind. */
    pub static fn kindWord(kind : GraphResKind) : string {
        return match kind {
            GraphResKind::Color => "color",
            GraphResKind::Depth => "depth",
            GraphResKind::Texture => "texture",
            GraphResKind::Accel => "accel",
        };
    }

    /** The word for a format. */
    pub static fn formatWord(format : GraphFormat) : string {
        return match format {
            GraphFormat::Hdr => "hdr",
            GraphFormat::Depth32 => "d32",
            GraphFormat::Srgb8 => "srgb8",
            GraphFormat::Opaque => "opaque",
        };
    }

    /** The word for a pass kind. */
    pub static fn passWord(kind : PassKind) : string {
        return match kind {
            PassKind::BuildAccel => "build-accel",
            PassKind::Forward => "forward",
            PassKind::Resolve => "resolve",
            PassKind::Custom => "custom",
        };
    }
}

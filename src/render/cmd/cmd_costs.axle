// cmd_costs — what each pass of a frame cost, filled in by the backend that ran it.
//
// Design rule 8: per-pass cost is observable. A backend knows which pass is open (BeginPass/EndPass in the
// stream) and adds to the slot of that pass: draw calls, triangles submitted and rasterised, pixels shaded.
// Those counts are deterministic and part of the render's identity. Time is not: it is measured with the
// `Profiler` (one scope per pass id) and copied here by `absorbProfile`, and it is reported separately so a
// report can be compared across runs with the times left out. Slots are indexed by pass id.

use crate::core::profile::entry::ProfileEntry;
use crate::core::profile::profiler::Profiler;

/** Per-pass counters and times for one frame. */
pub class PassCosts {
    slots   : i32;
    nanos   : i64[];
    calls   : i32[];
    draws   : i32[];
    trisIn  : i64[];
    trisOut : i64[];
    pixels  : i64[];

    /** A table for passes 0..`passCount`, all zero. */
    constructor(passCount : i32) {
        let mut n : i32 = passCount;
        if (n < 1) {
            n = 1;
        }
        self.slots = n;
        self.nanos = malloc<i64>(n as i64);
        self.calls = malloc<i32>(n as i64);
        self.draws = malloc<i32>(n as i64);
        self.trisIn = malloc<i64>(n as i64);
        self.trisOut = malloc<i64>(n as i64);
        self.pixels = malloc<i64>(n as i64);
        self.reset();
    }

    /** Zeroes every slot. */
    pub fn reset(mut self) : void {
        for (i of 0..self.slots) {
            self.nanos[i] = 0;
            self.calls[i] = 0;
            self.draws[i] = 0;
            self.trisIn[i] = 0;
            self.trisOut[i] = 0;
            self.pixels[i] = 0;
        }
    }

    /** How many passes the table has room for. */
    pub fn passCount(self) : i32 {
        return self.slots;
    }

    /** True when `pass` has a slot. */
    pub fn has(self, pass : i32) : bool {
        return pass >= 0 && pass < self.slots;
    }

    /** Counts one draw call in `pass` that submitted `triangles` triangles. */
    pub fn addDraw(mut self, pass : i32, triangles : i64) : void {
        if (self.has(pass)) {
            self.draws[pass] = self.draws[pass] + 1;
            self.trisIn[pass] = self.trisIn[pass] + triangles;
        }
    }

    /** Counts `triangles` triangles that survived clipping and culling in `pass`. */
    pub fn addRasterised(mut self, pass : i32, triangles : i64) : void {
        if (self.has(pass)) {
            self.trisOut[pass] = self.trisOut[pass] + triangles;
        }
    }

    /** Counts `count` pixels shaded in `pass`. */
    pub fn addPixels(mut self, pass : i32, count : i64) : void {
        if (self.has(pass)) {
            self.pixels[pass] = self.pixels[pass] + count;
        }
    }

    /** Draw calls in `pass`. */
    pub fn drawCalls(self, pass : i32) : i32 {
        return self.draws[pass];
    }

    /** Triangles submitted by the draws of `pass`. */
    pub fn trianglesSubmitted(self, pass : i32) : i64 {
        return self.trisIn[pass];
    }

    /** Triangles of `pass` that reached the rasteriser. */
    pub fn trianglesRasterised(self, pass : i32) : i64 {
        return self.trisOut[pass];
    }

    /** Pixels shaded in `pass`. */
    pub fn pixelsShaded(self, pass : i32) : i64 {
        return self.pixels[pass];
    }

    /** Measured inclusive time of `pass` in nanoseconds (0 until `absorbProfile`). */
    pub fn nanosOf(self, pass : i32) : i64 {
        return self.nanos[pass];
    }

    /** How often `pass` ran in the profiled frame. */
    pub fn callsOf(self, pass : i32) : i32 {
        return self.calls[pass];
    }

    /**
     * Copies the last finished profiler frame into the time slots: scope id k is pass k. Scopes outside the table
     * are ignored.
     */
    pub fn absorbProfile(mut self, profiler : Profiler) : void {
        for (rank of 0..profiler.entryCount()) {
            let e : ProfileEntry = profiler.entry(rank);
            if (self.has(e.scope)) {
                self.nanos[e.scope] = e.inclusiveNanos;
                self.calls[e.scope] = e.calls;
            }
        }
    }
}

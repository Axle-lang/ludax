// light_vndf — sampling the distribution of VISIBLE GGX normals (Heitz 2018, doc/LIGHTING_MATH.md §3).
//
// The reference path tracer draws the half-vector h from D_v(h) = G1(v) max(0, v.h) D(h) / (n.v): the GGX
// normals a
// viewer at v can actually see. Compared with sampling D(h) n.h this wastes no samples on back-facing
// microfacets
// and, for the height-correlated Smith model used here, gives the estimator weight G2 / G1 (bounded by 1) for
// the albedo of the lobe. All vectors are in TANGENT SPACE, +Z the surface normal (the sampler is a local
// construction; callers rotate in and out).
//
// Checks (suite): the density integrates to 1 over the hemisphere (quadrature, error below 1e-4); the mean of
// n.h over 200 000 seeded samples matches its quadrature value within four standard errors, and so does the
// albedo
// estimator mean(G2/G1) against the albedo table's E(mu, alpha).

use crate::core::math::scalar::{PI, max, saturate};
use crate::core::math::trig::{sqrt, sin, cos};
use crate::core::math::vec3::Vec3;
use crate::render::light::light_brdf::{lightGgxD, lightSmithV};

/** The Smith masking function G1 for a direction with cosine `nv` and width `alpha`. */
pub fn lightSmithG1(nv : f32, alpha : f32) : f32 {
    let a2 : f32 = alpha * alpha;
    return (2.0 as f32) * nv / max(nv + sqrt(a2 + ((1.0 as f32) - a2) * nv * nv), 0.000000001);
}

/** The joint masking-shadowing G2 = 4 n.l n.v V of the height-correlated model. */
pub fn lightSmithG2(nl : f32, nv : f32, alpha : f32) : f32 {
    return (4.0 as f32) * nl * nv * lightSmithV(nl, nv, alpha);
}

/**
 * Draws a visible normal for the view direction `v` (tangent space, v.z > 0) and width `alpha` from two
 * numbers
 * in [0, 1). The result is a unit vector with z >= 0.
 */
pub fn lightVndfSample(v : Vec3, alpha : f32, u1 : f32, u2 : f32) : Vec3 {
    let stretched : Vec3 = Vec3::make(alpha * v.x, alpha * v.y, v.z).normalized();
    let lenSq : f32 = stretched.x * stretched.x + stretched.y * stretched.y;
    let mut t1 : Vec3 = Vec3::make(1.0, 0.0, 0.0);
    if (lenSq > 0.0000001) {
        t1 = Vec3::make(-stretched.y, stretched.x, 0.0).scale((1.0 as f32) / sqrt(lenSq));
    }
    let t2 : Vec3 = stretched.cross(t1);
    let r : f32 = sqrt(u1);
    let phi : f32 = (2.0 as f32) * PI * u2;
    let p1 : f32 = r * cos(phi);
    let mut p2 : f32 = r * sin(phi);
    let s : f32 = (0.5 as f32) * ((1.0 as f32) + stretched.z);
    p2 = ((1.0 as f32) - s) * sqrt(max((1.0 as f32) - p1 * p1, 0.0)) + s * p2;
    let hemi : f32 = sqrt(max((1.0 as f32) - p1 * p1 - p2 * p2, 0.0));
    let nh : Vec3 = t1.scale(p1).plus(t2.scale(p2)).plus(stretched.scale(hemi));
    return Vec3::make(alpha * nh.x, alpha * nh.y, max(nh.z, 0.0)).normalized();
}

/** The density D_v(h) of `lightVndfSample` per unit solid angle of h: G1(v) max(0, v.h) D(h) / n.v. */
pub fn lightVndfPdf(v : Vec3, h : Vec3, alpha : f32) : f32 {
    if (v.z <= 0.0) {
        return 0.0;
    }
    return lightSmithG1(v.z, alpha) * max(v.dot(h), 0.0) * lightGgxD(saturate(h.z), alpha) / v.z;
}

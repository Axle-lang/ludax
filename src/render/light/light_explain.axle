// light_explain — why a pixel has its colour (doc/LIGHTING.md §9).
//
// `lightExplain` shades one surface point against a list of lights exactly as `lightShade` does, but keeps a
// `LightContribution` for every light: whether it reaches the point, if not the `LightReason`, N.L, the attenuation,
// the shadow factor and the RGB it adds, plus the ambient and emissive terms. The explanation also carries the
// independently computed shaded result, and `difference()` is the largest channel gap between the sum of the parts and
// that result. Both paths call `lightContribution`, add in light order and then in the order emissive, ambient, direct,
// so the gap is exactly 0 and a test fails the moment either path is changed alone.

use crate::core::collections::vec::Vec;
use crate::core::math::vec3::Vec3;
use crate::render::light::light_brdf::lightPrepare;
use crate::render::light::light_irradiance::LightReason;
use crate::render::light::light_material::{LightMaterial, LightSurface, LightDfg, LightPrepared};
use crate::render::light::light_shade::{LightContribution, LightShadeTerms, LightAmbientInput};
use crate::render::light::light_shade::{LightShadowQuery, lightContribution, lightAmbientTerms, lightShade};
use crate::render::light::light_source::LightSource;

/** The full account of one shaded point. */
pub class LightExplain {
    contributions : Vec<LightContribution>;
    ambient       : LightShadeTerms;
    shaded        : Vec3;

    /** An explanation built from the per-light contributions, the ambient terms and the independent result. */
    constructor(own contributions : Vec<LightContribution>, ambient : LightShadeTerms, shaded : Vec3) {
        self.contributions = contributions;
        self.ambient = ambient;
        self.shaded = shaded;
    }

    /** How many lights were considered. */
    pub fn count(self) : i32 {
        return self.contributions.len();
    }

    /** What light number `index` did. */
    pub fn light(self, index : i32) : LightContribution {
        return self.contributions.get(index);
    }

    /** How many lights actually reach the point and add light. */
    pub fn reaching(self) : i32 {
        let mut n : i32 = 0;
        for (i of 0..self.contributions.len()) {
            if (self.contributions.get(i).reason == LightReason::None) {
                n = n + 1;
            }
        }
        return n;
    }

    /** The ambient and emissive terms (the direct fields are zero here: the lights are in `light(i)`). */
    pub fn ambientTerms(self) : LightShadeTerms {
        return self.ambient;
    }

    /** The sum of the parts: emissive, then ambient, then the diffuse and the specular of every light in list order. */
    pub fn sum(self) : Vec3 {
        let mut diffuse : Vec3 = Vec3::zero();
        let mut specular : Vec3 = Vec3::zero();
        for (i of 0..self.contributions.len()) {
            diffuse = diffuse.plus(self.contributions.get(i).diffuse);
            specular = specular.plus(self.contributions.get(i).specular);
        }
        return self.ambient.emissive.plus(self.ambient.ambient()).plus(diffuse.plus(specular));
    }

    /** The shaded radiance computed by the renderer's path. */
    pub fn shadedResult(self) : Vec3 {
        return self.shaded;
    }

    /** The largest channel difference between `sum()` and `shadedResult()`; 0 when the explanation is faithful. */
    pub fn difference(self) : f32 {
        return self.sum().minus(self.shaded).abs().maxComponent();
    }
}

/** Shades a point and records every light's part; see the file header for the guarantee. */
pub fn lightExplain(
    lights : Vec<LightSource>,
    surface : LightSurface,
    material : LightMaterial,
    dfg : LightDfg,
    ambient : LightAmbientInput,
    shadows : LightShadowQuery
) : LightExplain {
    let prepared : LightPrepared = lightPrepare(material, dfg);
    let parts : Vec<LightContribution> = new Vec<LightContribution>();
    for (i of 0..lights.len()) {
        parts.push(lightContribution(lights.get(i), surface, prepared, shadows.visibility(i, surface)));
    }
    let mut terms : LightShadeTerms = lightAmbientTerms(material, surface, prepared, ambient);
    terms.emissive = material.emissive;
    let shaded : LightShadeTerms = lightShade(lights, surface, material, dfg, ambient, shadows);
    return new LightExplain(parts, terms, shaded.total());
}

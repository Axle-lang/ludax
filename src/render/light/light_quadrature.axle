// light_quadrature — Gauss-Legendre nodes and weights, computed, never typed in.
//
// The independent checks of the lighting maths integrate in f64 with Gauss-Legendre rules (exact for polynomials of
// degree 2n-1, spectrally accurate for smooth integrands) and the table generator of the BRDF uses the same rules. A
// node table pasted from a book is a table that can have a typo; here the nodes are the roots of the Legendre
// polynomial P_n found by Newton's method from the classical starting guess cos(pi (i + 3/4) / (n + 1/2)), iterated
// until the step is below 1e-15, with the deterministic `cosD` of the maths layer. The weights follow from the
// derivative: w = 2 / ((1 - x^2) P_n'(x)^2).
//
// Measured by the suite: the weights sum to 2 within 4e-16 and x^k integrates exactly up to degree 2n-1 for n up to 64
// (error below 1e-14).

use crate::core::math::scalar::{PI_D, absD, maxI};
use crate::core::math::trig::cosD;

// Newton steps at most per root (the classical start converges in about four), and the step at which it stops.
const LGAUSS_MAX_STEPS : i32 = 60;
const LGAUSS_STEP_TOL : f64 = 0.000000000000001;

/** A Gauss-Legendre rule of a fixed order on [-1, 1]; `node` and `weight` are read by index. */
pub class LightGauss {
    count   : i32;
    nodes   : f64[];
    weights : f64[];

    /** The rule with `order` nodes (at least 1). */
    constructor(order : i32) {
        let n : i32 = maxI(order, 1);
        self.count = n;
        self.nodes = new f64[n as i64];
        self.weights = new f64[n as i64];
        for (i of 0..n) {
            self.solve(i);
        }
    }

    // Finds root `i` (counted from x = +1 downwards) and its weight.
    fn solve(mut self, i : i32) : void {
        let n : i32 = self.count;
        let nf : f64 = n as f64;
        let mut x : f64 = cosD(PI_D * ((i as f64) + 0.75) / (nf + 0.5));
        let mut derivative : f64 = 1.0;
        for (iteration of 0..LGAUSS_MAX_STEPS) {
            let mut older : f64 = 1.0;
            let mut old : f64 = x;
            for (k of 2..(n + 1)) {
                let kf : f64 = k as f64;
                let next : f64 = ((2.0 * kf - 1.0) * x * old - (kf - 1.0) * older) / kf;
                older = old;
                old = next;
            }
            derivative = nf * (x * old - older) / (x * x - 1.0);
            let step : f64 = old / derivative;
            x = x - step;
            if (absD(step) < LGAUSS_STEP_TOL) {
                break;
            }
        }
        self.nodes[i as i64] = x;
        self.weights[i as i64] = 2.0 / ((1.0 - x * x) * derivative * derivative);
    }

    /** How many nodes there are. */
    pub fn order(self) : i32 {
        return self.count;
    }

    /** Node `i` on [-1, 1]. */
    pub fn node(self, i : i32) : f64 {
        return self.nodes[i as i64];
    }

    /** Weight of node `i` for an integral over [-1, 1]. */
    pub fn weight(self, i : i32) : f64 {
        return self.weights[i as i64];
    }

    /** Node `i` mapped onto [a, b]. */
    pub fn at(self, i : i32, a : f64, b : f64) : f64 {
        return 0.5 * (b - a) * self.nodes[i as i64] + 0.5 * (b + a);
    }

    /** Weight of node `i` for an integral over [a, b]. */
    pub fn scaled(self, i : i32, a : f64, b : f64) : f64 {
        return 0.5 * (b - a) * self.weights[i as i64];
    }
}

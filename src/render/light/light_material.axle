// light_material — a glTF metallic-roughness material and the surface point it is shaded at.
//
// Plain data, as in the glTF 2.0 specification: base colour, metallic, roughness, emissive, occlusion and the alpha
// mode. `LightPrepared` is what shading derives from a material once per pixel and view (F0, the diffuse albedo left
// after the specular lobe took its share, the multiple-scattering compensation), so that the per-light loop only
// evaluates the lobes. Differences from voxel-axle: it had albedo only; here the same sun lights a voxel block
// (metallic 0, roughness 1, albedo = block colour x baked light) and a glTF prop.

use crate::core::math::vec3::Vec3;

/** The glTF alpha modes. */
pub enum LightAlphaMode : i8 {
    /** Alpha is ignored. */
    Opaque = 0,
    /** A pixel below the cutoff is discarded, others are opaque. */
    Mask = 1,
    /** Alpha blends the pixel over what is behind. */
    Blend = 2,
}

/** Which diffuse lobe a material uses. */
pub enum LightDiffuseModel : i8 {
    /** albedo / pi. */
    Lambert = 0,
    /** Disney/Burley retro-reflection, normalised as in Frostbite so it never gains energy. */
    Burley = 1,
}

/** A glTF metallic-roughness material, in linear colour. */
pub struct LightMaterial {
    /** Base colour: the diffuse albedo of a dielectric and the F0 of a metal. */
    pub baseColor : Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 };

    /** Opacity, 0..1. */
    pub alpha : f32 = 1.0;

    /** How `alpha` is used. */
    pub alphaMode : LightAlphaMode = LightAlphaMode::Opaque;

    /** In `Mask` mode, the alpha below which a pixel is discarded. */
    pub alphaCutoff : f32 = 0.5;

    /** 0 = dielectric, 1 = metal. */
    pub metallic : f32 = 0.0;

    /** Perceptual roughness, 0..1; the GGX width is its square. */
    pub roughness : f32 = 1.0;

    /** Light the surface emits, in scene radiance. */
    pub emissive : Vec3 = Vec3 {};

    /** Ambient occlusion, 0..1, applied to indirect light only. */
    pub occlusion : f32 = 1.0;

    /** The diffuse lobe. */
    pub diffuseModel : LightDiffuseModel = LightDiffuseModel::Lambert;
}

/** The point being shaded: where it is, how it faces, and who it belongs to. */
pub struct LightSurface {
    /** Position in the shading space. */
    pub position : Vec3 = Vec3 {};

    /** Unit shading normal (after normal mapping). */
    pub normal : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Unit geometric normal of the triangle or voxel face. */
    pub geoNormal : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Unit vector from the point towards the eye. */
    pub view : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** The layer bit(s) of the object, tested against the lights' masks. */
    pub layer : u32 = 1;

    /** The object's id, tested against a light's exclusion. */
    pub objectId : i32 = 0;
}

/** The two integrals of the specular lobe that multiple scattering and energy conservation need (see light_dfg). */
pub struct LightDfg {
    /** The weight of F0 in the directional albedo of the specular lobe: albedo = F0 * a + b. */
    pub a : f32 = 0.0;

    /** The Fresnel-edge part of the directional albedo. */
    pub b : f32 = 0.0;
}

/** What shading derives from a material and a view direction, once, before the light loop. */
pub struct LightPrepared {
    /** Reflectance at normal incidence: lerp(0.04, baseColor, metallic). */
    pub f0 : Vec3 = Vec3 { x: 0.04, y: 0.04, z: 0.04 };

    /** Diffuse albedo that remains after the metal fraction and the specular lobe took theirs (no 1/pi). */
    pub diffuse : Vec3 = Vec3 {};

    /** GGX width alpha = roughness^2, floored. */
    pub alpha : f32 = 1.0;

    /** Perceptual roughness. */
    pub roughness : f32 = 1.0;

    /** Multiple-scattering factor 1 + F0 (1/E - 1) per channel. */
    pub compensation : Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 };

    /** The directional albedo of the compensated specular lobe for this view, per channel. */
    pub specularAlbedo : Vec3 = Vec3 {};

    /** The diffuse lobe. */
    pub diffuseModel : LightDiffuseModel = LightDiffuseModel::Lambert;
}

/** The two parts of a BRDF value, kept apart so each light's diffuse and specular share can be shown. */
pub struct LightBrdfTerms {
    /** The diffuse part, f_d. */
    pub diffuse : Vec3 = Vec3 {};

    /** The specular part, f_s, including the multiple-scattering compensation. */
    pub specular : Vec3 = Vec3 {};
}

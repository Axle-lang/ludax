// pathlight_noise — integer hashes and smooth value noise: the only source of variety in the worlds and textures built on it.
//
// Everything is a pure function of its integer inputs, so a world, a texture and a frame are the same on every
// run and every thread. The hash is Ludax's SplitMix64 finalizer, not a libm call.

use crate::core::id::hash::hashMix;

// 2^-24, which turns the hash's 24 returned bits into a fraction in [0, 1).
const LN_INV_24 : f32 = 0.000000059604645;

/** 24 well-mixed bits for the lattice point (x, y, z) under `seed`. */
pub fn lnHash(x : i32, y : i32, z : i32, seed : i32) : i32 {
    let mut h : i64 = (x as i64) * 73856093;
    h = h ^ ((y as i64) * 19349663);
    h = h ^ ((z as i64) * 83492791);
    h = h ^ ((seed as i64) * 2654435761);
    return (hashMix(h) >>> 40) as i32;
}

/** A uniform number in [0, 1) for the lattice point (x, y, z) under `seed`. */
pub fn lnUnit(x : i32, y : i32, z : i32, seed : i32) : f32 {
    return lnHash(x, y, z, seed) as f32 * LN_INV_24;
}

/** The cell containing `v`: rounds toward minus infinity. */
pub fn lnFloor(v : f32) : i32 {
    let t : i32 = v as i32;
    if ((t as f32) > v) {
        return t - 1;
    }
    return t;
}

fn lnFade(t : f32) : f32 {
    return t * t * ((3.0 as f32) - (2.0 as f32) * t);
}

/** Smooth value noise on the xz plane, in [0, 1). */
pub fn lnValue2(x : f32, z : f32, seed : i32) : f32 {
    let ix : i32 = lnFloor(x);
    let iz : i32 = lnFloor(z);
    let fx : f32 = lnFade(x - ix as f32);
    let fz : f32 = lnFade(z - iz as f32);
    let a : f32 = lnUnit(ix, 0, iz, seed);
    let b : f32 = lnUnit(ix + 1, 0, iz, seed);
    let c : f32 = lnUnit(ix, 0, iz + 1, seed);
    let d : f32 = lnUnit(ix + 1, 0, iz + 1, seed);
    let top : f32 = a + (b - a) * fx;
    let bottom : f32 = c + (d - c) * fx;
    return top + (bottom - top) * fz;
}

/** Fractal noise on the xz plane: `octaves` layers, each twice as fine and half as strong; in [0, 1). */
pub fn lnFbm2(x : f32, z : f32, octaves : i32, seed : i32) : f32 {
    let mut sum : f32 = 0.0;
    let mut amp : f32 = 0.5;
    let mut norm : f32 = 0.0;
    let mut fx : f32 = x;
    let mut fz : f32 = z;
    for (o of 0..octaves) {
        sum = sum + amp * lnValue2(fx, fz, seed + o * 31);
        norm = norm + amp;
        amp = amp * (0.5 as f32);
        fx = fx * (2.03 as f32);
        fz = fz * (2.03 as f32);
    }
    return sum / norm;
}

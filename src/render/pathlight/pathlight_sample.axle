// pathlight_sample — the baked light at a point, as the shader reads it.
//
// One plain value: block light, flooded sky light, sky access, the bounce tint and the share of each sky body's disc
// the point sees. Where the numbers come from is the caller's business (the valley's dense volumes, a streamed
// world's light), so the shader never knows.

use crate::core::math::vec3::Vec3;

/** Which baked shadow a surface asks the volume for: the sun's or the moon's. */
pub enum LumenBody : i8 {
    /** The sun's disc. */
    Sun,
    /** The moon's disc. */
    Moon,
}

/** The light at a point. */
pub struct LumenLightSample {
    /** Block light per channel, 1 = a lamp block's own strength; lamps that overlap add past it. */
    pub block : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Flooded sky light, 0..1. */
    pub sky : f32 = 1.0;

    /** Share of the sky the point sees, 0..1. */
    pub access : f32 = 1.0;

    /** The mean colour the sky rays hit: the hue of the bounce. */
    pub tint : Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 };

    /** Share of the sun's disc the point sees, 0..1: a soft shadow. */
    pub sun : f32 = 1.0;

    /** Share of the moon's disc the point sees, 0..1: the moon's own soft shadow. */
    pub moon : f32 = 1.0;
}

/** The baked shadow of `body` at a sampled point: each body reads its own. */
pub fn lumenBodyShare(s : LumenLightSample, body : LumenBody) : f32 {
    return match body {
        LumenBody::Sun => s.sun,
        LumenBody::Moon => s.moon,
    };
}

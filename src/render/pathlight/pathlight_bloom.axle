// pathlight_bloom — the bloom pyramid's arithmetic: halving a picture, blurring it, folding a level into the next.
//
// Bloom is light above display white spilled round its source. The source is halved four times and each level
// blurred with the binomial kernel 1-4-6-4-1; the levels are then folded each into the next finer one, weights
// included, so that the picture reads a single level. Every function here works on rows `begin` up to `end` of a
// flat picture of three floats a pixel and writes only those rows, so the display stage can hand them to the pool.
// `LumenPost` (pathlight_post) owns the levels and says in which order these run.

use crate::core::math::vec3::Vec3;
use crate::render::pathlight::pathlight_noise::lnFloor;

/** The blur kernel that shrinks a level: weights of the centre tap, of the taps one off it, and of those two off. */
const POST_TAP_CENTRE : f32 = 0.375;
const POST_TAP_NEAR : f32 = 0.25;
const POST_TAP_FAR : f32 = 0.0625;

// Bilinear read of a w x h picture of three channels at (u, v) in 0..1.
pub(crate) fn pkBilinear(buf : f32[], w : i32, h : i32, u : f32, v : f32) : Vec3 {
    let fx : f32 = u * (w as f32) - (0.5 as f32);
    let fy : f32 = v * (h as f32) - (0.5 as f32);
    let x0 : i32 = lnFloor(fx);
    let y0 : i32 = lnFloor(fy);
    let tx : f32 = fx - x0 as f32;
    let ty : f32 = fy - y0 as f32;
    let xa : i32 = pkClamp(x0, w);
    let xb : i32 = pkClamp(x0 + 1, w);
    let ya : i32 = pkClamp(y0, h);
    let yb : i32 = pkClamp(y0 + 1, h);
    let top : Vec3 = pkRead(buf, w, xa, ya).lerp(pkRead(buf, w, xb, ya), tx);
    let bottom : Vec3 = pkRead(buf, w, xa, yb).lerp(pkRead(buf, w, xb, yb), tx);
    return top.lerp(bottom, ty);
}

// Rows `begin` up to `end` of the picture `fine`, `w` wide, become themselves times `keep` plus `share` times the
// picture `coarse`, `cw` by `ch` and exactly half the size, read bilinearly. At exactly half the size a fine pixel
// lies a quarter of a coarse pixel from the centre of its own coarse pixel, so the weights are 3/4 and 1/4 each way
// and a row is a walk along two coarse rows: one new coarse column for every two pixels.
pub(crate) fn pkFoldRows(
    mut fine : f32[],
    w : i32,
    keep : f32,
    coarse : f32[],
    cw : i32,
    ch : i32,
    share : f32,
    begin : i32,
    end : i32
) : void {
    let near : f32 = share * (0.75 as f32);
    let far : f32 = share * (0.25 as f32);
    for (y of begin..end) {
        let cy : i32 = y >> 1;
        let rowA : i64 = ((pkClamp(cy, ch) * cw) * 3) as i64;
        let rowB : i64 = ((pkClamp(cy + ((y & 1) * 2 - 1), ch) * cw) * 3) as i64;
        let mut pr : f32 = 0.0;
        let mut pg : f32 = 0.0;
        let mut pb : f32 = 0.0;
        let mut nr : f32 = coarse[rowA] * near + coarse[rowB] * far;
        let mut ng : f32 = coarse[rowA + 1] * near + coarse[rowB + 1] * far;
        let mut nb : f32 = coarse[rowA + 2] * near + coarse[rowB + 2] * far;
        let mut cr : f32 = nr;
        let mut cg : f32 = ng;
        let mut cb : f32 = nb;
        let mut at : i64 = ((y * w) * 3) as i64;
        for (x of 0..w) {
            let mut sr : f32 = 0.0;
            let mut sg : f32 = 0.0;
            let mut sb : f32 = 0.0;
            if ((x & 1) == 0) {
                pr = cr;
                pg = cg;
                pb = cb;
                cr = nr;
                cg = ng;
                cb = nb;
                let k : i64 = (pkClamp((x >> 1) + 1, cw) * 3) as i64;
                nr = coarse[rowA + k] * near + coarse[rowB + k] * far;
                ng = coarse[rowA + k + 1] * near + coarse[rowB + k + 1] * far;
                nb = coarse[rowA + k + 2] * near + coarse[rowB + k + 2] * far;
                sr = cr * (0.75 as f32) + pr * (0.25 as f32);
                sg = cg * (0.75 as f32) + pg * (0.25 as f32);
                sb = cb * (0.75 as f32) + pb * (0.25 as f32);
            } else {
                sr = cr * (0.75 as f32) + nr * (0.25 as f32);
                sg = cg * (0.75 as f32) + ng * (0.25 as f32);
                sb = cb * (0.75 as f32) + nb * (0.25 as f32);
            }
            fine[at] = fine[at] * keep + sr;
            fine[at + 1] = fine[at + 1] * keep + sg;
            fine[at + 2] = fine[at + 2] * keep + sb;
            at = at + 3;
        }
    }
}

pub(crate) fn pkClamp(i : i32, n : i32) : i32 {
    if (i < 0) {
        return 0;
    }
    if (i >= n) {
        return n - 1;
    }
    return i;
}

pub(crate) fn pkRead(buf : f32[], w : i32, x : i32, y : i32) : Vec3 {
    let at : i64 = ((y * w + x) * 3) as i64;
    return Vec3 { x: buf[at], y: buf[at + 1], z: buf[at + 2] };
}

// Halves a w x h picture by 2 x 2 boxes into `dst`.
pub(crate) fn pkShrink(src : f32[], w : i32, h : i32, dst : f32[]) : void {
    let dw : i32 = w / 2;
    let dh : i32 = h / 2;
    for (y of 0..dh) {
        for (x of 0..dw) {
            for (c of 0..3) {
                let a : i64 = (((y * 2) * w + x * 2) * 3 + c) as i64;
                let b : i64 = a + 3;
                let d : i64 = a + (w * 3) as i64;
                dst[((y * dw + x) * 3 + c) as i64] = (src[a] + src[b] + src[d] + src[d + 3]) * (0.25 as f32);
            }
        }
    }
}

// The sideways half of a 1-4-6-4-1 blur of rows `begin` up to `end` of a picture `w` wide: `src` into `dst`.
pub(crate) fn pkBlurAcross(src : f32[], dst : f32[], w : i32, begin : i32, end : i32) : void {
    for (y of begin..end) {
        for (x of 0..w) {
            for (c of 0..3) {
                let mut s : f32 = 0.0;
                for (k of -2..3) {
                    let xi : i32 = pkClamp(x + k, w);
                    s = s + src[((y * w + xi) * 3 + c) as i64] * pkTap(k);
                }
                dst[((y * w + x) * 3 + c) as i64] = s;
            }
        }
    }
}

// The vertical half, rows `begin` up to `end` of a picture `w` by `h`: `src` into `dst`.
pub(crate) fn pkBlurDown(src : f32[], dst : f32[], w : i32, h : i32, begin : i32, end : i32) : void {
    for (y of begin..end) {
        for (x of 0..w) {
            for (c of 0..3) {
                let mut s : f32 = 0.0;
                for (k of -2..3) {
                    let yi : i32 = pkClamp(y + k, h);
                    s = s + src[((yi * w + x) * 3 + c) as i64] * pkTap(k);
                }
                dst[((y * w + x) * 3 + c) as i64] = s;
            }
        }
    }
}

pub(crate) fn pkTap(k : i32) : f32 {
    if (k == 0) {
        return POST_TAP_CENTRE;
    }
    if (k == 1 || k == -1) {
        return POST_TAP_NEAR;
    }
    return POST_TAP_FAR;
}

// pathlight_features — the parts of the picture a program may switch off, chosen by name.
//
// A picture is a sum of parts (the sun, the sky, lamps and their flooded light, emission, the traced bounce, light shafts, bloom, fog, the water's waves, its
// reflection and what is seen through it), and to judge one it helps to see the picture without the others. A feature list is text:
// `waves,reflection` keeps those two and nothing else, `-reflection` keeps everything but that, `all` and `none` are the
// two ends. The list becomes a mask of kept features; `LumenSettings::keepOnlyIn` applies it.

/** The parts of the picture that can be switched off. */
pub enum LumenFeature : i8 {
    /** Not a feature. */
    Unknown = 0,
    /** Lamps as point lights with their own shadows and highlights. */
    Lamps = 1,
    /** The traced diffuse bounce. */
    Bounce = 2,
    /** The sun's light shafts. */
    Shafts = 3,
    /** The glow round what is brighter than the display's white. */
    Bloom = 4,
    /** The haze of the air. */
    Fog = 5,
    /** The waves of the water (off: a flat surface). */
    Waves = 6,
    /** The water mirroring what lies above it. */
    Reflection = 7,
    /** What is seen through the water's surface. */
    Transmission = 8,
    /** The sun and the moon as direct light on the surfaces. */
    Sun = 9,
    /** The sky: the light of the dome on the surfaces, and the sky seen and mirrored. */
    Sky = 10,
    /** The lamps' baked light, flooded through the world and read on the surfaces. */
    Flood = 11,
    /** What surfaces emit by themselves: windows, lanterns. */
    Emission = 12,

    /** The feature called `name`, `Unknown` for anything else. */
    static fn fromName(name : string) : LumenFeature {
        if (name == "lamps") {
            return LumenFeature::Lamps;
        }
        if (name == "bounce") {
            return LumenFeature::Bounce;
        }
        if (name == "shafts") {
            return LumenFeature::Shafts;
        }
        if (name == "bloom") {
            return LumenFeature::Bloom;
        }
        if (name == "fog") {
            return LumenFeature::Fog;
        }
        if (name == "waves") {
            return LumenFeature::Waves;
        }
        if (name == "reflection") {
            return LumenFeature::Reflection;
        }
        if (name == "transmission") {
            return LumenFeature::Transmission;
        }
        if (name == "sun") {
            return LumenFeature::Sun;
        }
        if (name == "sky") {
            return LumenFeature::Sky;
        }
        if (name == "flood") {
            return LumenFeature::Flood;
        }
        if (name == "emission") {
            return LumenFeature::Emission;
        }
        return LumenFeature::Unknown;
    }

    /** The feature's bit in a mask of kept features. */
    pub fn bit(self) : i32 {
        return match self {
            LumenFeature::Lamps => 1,
            LumenFeature::Bounce => 2,
            LumenFeature::Shafts => 4,
            LumenFeature::Bloom => 8,
            LumenFeature::Fog => 16,
            LumenFeature::Waves => 32,
            LumenFeature::Reflection => 64,
            LumenFeature::Transmission => 128,
            LumenFeature::Sun => 256,
            LumenFeature::Sky => 512,
            LumenFeature::Flood => 1024,
            LumenFeature::Emission => 2048,
            _ => 0,
        };
    }
}

/** The mask with every feature kept. */
pub const LUMEN_FEATURES_ALL : i32 = 4095;

/** The names a feature list may use, for a message. */
pub const LUMEN_FEATURE_NAMES : string = "lamps, bounce, shafts, bloom, fog, waves, reflection, transmission, sun, sky, flood, emission";

/** The result of reading a feature list: the mask of kept features, or why the list is wrong (`problem` not empty). */
pub struct LumenFeatureChoice {
    /** The kept features, one bit each (`LumenFeature::bit`). */
    pub kept : i32 = 4095;

    /** What is wrong with the list, empty when it is fine. */
    pub problem : string = "";
}

use std::lang::IndexOutOfBoundsException;

// The byte that separates the names of a list, and the one that turns a name into "everything but".
const FEATURES_COMMA : i32 = 44;
const FEATURES_MINUS : i32 = 45;

// The bytes `from` up to `end` of `text`; the empty string for a range outside it (the callers keep to the text).
fn lumenFeatureSlice(text : string, from : i64, end : i64) : string {
    try {
        return text.substring(from as i32, end as i32);
    } catch e : IndexOutOfBoundsException {
        return "";
    }
}

// Where the name that starts at `from` ends: at the next comma, or at the end of the list.
fn lumenFeatureEnd(list : string, from : i64) : i64 {
    let n : i64 = list.byteLength;
    let mut i : i64 = from;
    while (i < n && list.byteAt(i) != FEATURES_COMMA) {
        i = i + 1;
    }
    return i;
}

/**
 * Reads a feature list. A name alone is kept and nothing else is (when any name is alone); a name after `-` is dropped
 * from what is kept; `all` keeps everything and `none` nothing. `waves,reflection`, `-reflection` and `all,-fog` are
 * lists; an empty list keeps everything. A name that is not a feature is a problem that lists the ones that are.
 */
pub fn lumenFeaturesParse(list : string) : LumenFeatureChoice {
    let n : i64 = list.byteLength;
    // First pass: does any name stand alone? Then only those are kept.
    let mut onlyListed : bool = false;
    let mut at : i64 = 0;
    while (at < n) {
        let end : i64 = lumenFeatureEnd(list, at);
        let name : string = lumenFeatureSlice(list, at, end);
        if (name == "none" || (name.length > 0 && name != "all" && list.byteAt(at) != FEATURES_MINUS)) {
            onlyListed = true;
        }
        at = end + 1;
    }
    let mut kept : i32 = LUMEN_FEATURES_ALL;
    if (onlyListed) {
        kept = 0;
    }
    // Second pass: apply each name, in order.
    at = 0;
    while (at < n) {
        let end : i64 = lumenFeatureEnd(list, at);
        let name : string = lumenFeatureSlice(list, at, end);
        at = end + 1;
        if (name.length == 0) {
            continue;
        }
        if (name == "all") {
            kept = LUMEN_FEATURES_ALL;
        } else if (name == "none") {
            kept = 0;
        } else if (name.byteAt(0) == FEATURES_MINUS) {
            let feature : LumenFeature = LumenFeature::fromName(lumenFeatureSlice(name, 1, name.byteLength));
            if (feature == LumenFeature::Unknown) {
                return LumenFeatureChoice {
                    kept: kept,
                    problem: "unknown feature ${name}; the features are ${LUMEN_FEATURE_NAMES}",
                };
            }
            kept = kept & (LUMEN_FEATURES_ALL - feature.bit());
        } else {
            let feature : LumenFeature = LumenFeature::fromName(name);
            if (feature == LumenFeature::Unknown) {
                return LumenFeatureChoice {
                    kept: kept,
                    problem: "unknown feature ${name}; the features are ${LUMEN_FEATURE_NAMES}",
                };
            }
            kept = kept | feature.bit();
        }
    }
    return LumenFeatureChoice { kept: kept, problem: "" };
}

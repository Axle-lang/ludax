// pathlight_post — from radiance to pixels: exposure, bloom, vignette, tone curve, sRGB, upscale, dither.
//
// The renderer's picture is scene radiance, linear and unbounded (the sun's disc is a hundred thousand times
// the lit ground). An eye adapts: the exposure follows the geometric mean of the picture's luminance, easing
// toward it within about a tenth of a second: fast enough that turning toward the sun is not followed by a visible
// drift of brightness, slow enough that a flash of lantern does not pump the whole picture. Light
// above the display's white is not thrown away: it is blurred at four scales and added back as bloom, which is
// how a lantern or the sun reads as bright when the monitor cannot be. Ludax's tone curve and sRGB transfer do
// the last step, through two small tables built from those very functions (the curve and the encode are
// smooth, so interpolating a table of them is exact to well under one 8-bit code, and a table lookup is much
// cheaper than a power function a million times a frame).
//
// Every stage that touches each pixel runs on the worker pool, one row range per job (see `frame`): the bright
// pass and the first blur at half size, the composition at render size, the upscale and pack at output size.
// The coarser bloom levels are a few thousand pixels and stay on one thread.

use crate::core::math::scalar::{saturate, max, min};
use crate::core::math::vec3::Vec3;
use crate::render::light::light_color::{lightToneCurve, lightSrgbEncode, LIGHT_TONE_KNEE};
use crate::render::light::light_math::{lightLog2, lightExp2, lightPow};
use crate::render::pathlight::pathlight_bloom::{
    pkBilinear, pkBlurAcross, pkBlurDown, pkClamp, pkFoldRows, pkShrink
};
use crate::render::pathlight::pathlight_noise::{lnFloor, lnUnit};
use crate::render::pathlight::pathlight_settings::LumenSettings;

/** How fast the exposure follows the picture, in e-foldings a second: about a tenth of a second to settle, so a turn of
 * the head is not followed by a visible drift of brightness. */
const POST_ADAPT : f32 = 9.0;

/** How much of a pixel's difference from its neighbours the sharpening adds back. */
const POST_SHARPEN : f32 = 0.6;

/** How much of the picture's dimness the exposure makes up for, as a power of the ratio (1 would match the key
 * exactly): below 1 a dark place stays darker than a bright one. */
const EXPOSURE_FOLLOW : f32 = 0.78;

/** The exposed brightness past which a pixel adds no more to the bloom: a lamp glows, it does not flood the picture. */
const BLOOM_CEILING : f32 = 6.0;

/** The exposure that puts an average picture at this share of white. */
const POST_KEY : f32 = 0.17;

/** The exposure is never pushed outside these bounds, however dark or bright the picture. */
const POST_EXPOSURE_MIN : f32 = 0.04;
const POST_EXPOSURE_MAX : f32 = 90.0;

/** Entries of each lookup table. */
const POST_TABLE : i32 = 4096;

/** Below this a channel contributes nothing to its tone-table entry. */
const POST_TONE_MIN : f32 = 0.0001;

/** The weights of red, green and blue in luminance (Rec. 709), which add to 1. */
const POST_LUMA_R : f32 = 0.2126;
const POST_LUMA_G : f32 = 0.7152;
const POST_LUMA_B : f32 = 0.0722;

/** The darkest luminance the exposure meter takes the logarithm of, so a black pixel does not drag the mean to minus infinity. */
const POST_METER_FLOOR : f32 = 0.00002;

/** The exposure meter reads every this many pixels each way. */
const POST_METER_STEP : i32 = 4;

/** The side of the dither tile, a power of two. */
const POST_DITHER_SIDE : i32 = 64;

/** The seed of the dither noise that hides banding in the 8-bit output. */
const POST_DITHER_SEED : i32 = 977;

/** How much the vignette darkens the corners, at 0.5 of the half-diagonal. */
const POST_VIGNETTE : f32 = 0.9;

/** Where highlights start losing saturation, and how much of the picture's brightness that takes. */
const POST_CLIP_KNEE : f32 = 0.8;
const POST_CLIP_RANGE : f32 = 2.5;

/** A little overall contrast, applied as a lerp away from grey. */
const POST_GRADE : f32 = 1.12;

/** How much of a clipping highlight's saturation survives, as film loses its own. */
const POST_CLIP_DESAT : f32 = 0.85;

/** How much of the bloom's radiance the picture adds. */
const POST_BLOOM_GAIN : f32 = 0.35;

/** The weight of each bloom level, from half resolution down to a sixteenth. */
const POST_BLOOM_W1 : f32 = 0.9;
const POST_BLOOM_W2 : f32 = 0.75;
const POST_BLOOM_W3 : f32 = 0.6;
const POST_BLOOM_W4 : f32 = 0.5;

/** The `word` table has `POST_TABLE` entries below this linear value and as many above: the sRGB transfer is steepest
 * near black; with the split at 1/16 the nearest entry is within 0.03 of a display code below it and 0.07 above. */
const POST_WORD_SPLIT : f32 = 0.0625;
const POST_WORD_LOW : f32 = 65536.0;
const POST_WORD_HIGH : f32 = 4369.0667;

/** The largest exposed channel the tone table covers; brighter values map to the curve's ceiling. */
const POST_TONE_MAX : f32 = 40.0;

/** The parts of the display stage that run on the pool. */
pub enum LumenPass : i8 {
    /** Pick the light above white and halve the picture. */
    Bright,
    /** Blur the half-size level sideways. */
    BlurAcross,
    /** Blur the half-size level up and down. */
    BlurDown,
    /** Fold the coarser bloom levels into the half-size one; after `coarse`. */
    Fold,
    /** Combine picture, bloom and grade into display values at render size. */
    Compose,
    /** Scale to the output size, dither and pack into words. */
    Pack,
}

/** The display stage for a picture of `w` by `h`, shown at `scale` times that size. */
pub class LumenPost {
    w : i32;
    h : i32;

    /** How many output pixels each render pixel becomes. */
    pub scale : i32;

    /** The exposure the picture is shown with. */
    pub exposure : f32 = 0.6;

    /** Bloom strength for the coming frame. */
    pub strength : f32 = 0.5;

    /** True when the coming frame shows radiance clipped at 1 (the raw debug view). */
    pub raw : bool = false;

    lv1  : f32[];
    lv2  : f32[];
    lv3  : f32[];
    lv4  : f32[];
    tmp  : f32[];
    disp : f32[];
    tone : f32[];
    code : f32[];

    // The dither as a tile: the same noise for every frame, so a still picture does not shimmer, read with two masks
    // instead of hashed for every output pixel.
    dither : f32[];

    // The same tile and the sRGB transfer as integers with eight more bits than a display code, for `composeWords`:
    // `word` is 256 * (255 * code + 0.5) over the linear value (see `pkWordIndex`), `grain` is 256 * dither.
    grain : i32[];
    word  : i32[];

    /** The words of the finished picture, `w * scale` by `h * scale`. */
    pub out : i32[];

    /** A stage for `w` by `h` pictures (both multiples of 16) shown at `scale` times that size. */
    constructor(w : i32, h : i32, scale : i32) {
        self.w = w;
        self.h = h;
        self.scale = scale;
        self.lv1 = new f32[((w / 2) as i64) * (h / 2) * 3];
        self.lv2 = new f32[((w / 4) as i64) * (h / 4) * 3];
        self.lv3 = new f32[((w / 8) as i64) * (h / 8) * 3];
        self.lv4 = new f32[((w / 16) as i64) * (h / 16) * 3];
        self.tmp = new f32[((w / 2) as i64) * (h / 2) * 3];
        self.disp = new f32[(w as i64) * h * 3];
        self.out = new i32[(w as i64) * scale * h * scale];
        self.dither = new f32[(POST_DITHER_SIDE * POST_DITHER_SIDE) as i64];
        for (ty of 0..POST_DITHER_SIDE) {
            for (tx of 0..POST_DITHER_SIDE) {
                self.dither[(ty * POST_DITHER_SIDE + tx) as i64] = lnUnit(tx, ty, 0, POST_DITHER_SEED)
                    - (0.5 as f32);
            }
        }
        self.grain = new i32[(POST_DITHER_SIDE * POST_DITHER_SIDE) as i64];
        for (i of 0..(POST_DITHER_SIDE * POST_DITHER_SIDE)) {
            self.grain[i as i64] = lnFloor(self.dither[i as i64] * (256.0 as f32));
        }
        self.word = new i32[(POST_TABLE * 2 + 1) as i64];
        for (i of 0..(POST_TABLE * 2 + 1)) {
            let code : f32 = lightSrgbEncode(pkWordValue(i));
            self.word[i as i64] = ((code * (255.0 as f32) + (0.5 as f32)) * (256.0 as f32)) as i32;
        }
        self.tone = new f32[(POST_TABLE + 1) as i64];
        self.code = new f32[(POST_TABLE + 1) as i64];
        // The tone table is T(m) / m over the largest channel m, so a colour is scaled by one lookup; the code
        // table is the sRGB transfer indexed by the square root of the linear value, which spends its entries
        // where the transfer is steep (near black).
        for (i of 0..(POST_TABLE + 1)) {
            let m : f32 = ((i as f32) / (POST_TABLE as f32)) * POST_TONE_MAX;
            let mut gain : f32 = 1.0;
            if (m > POST_TONE_MIN) {
                gain = lightToneCurve(m, LIGHT_TONE_KNEE) / m;
            }
            self.tone[i as i64] = gain;
            let root : f32 = (i as f32) / (POST_TABLE as f32);
            self.code[i as i64] = lightSrgbEncode(root * root);
        }
    }

    /** Moves the exposure toward what the picture asks for; `seconds` is the time since the last call. */
    pub fn adapt(mut self, hdr : f32[], s : LumenSettings, seconds : f32, instant : bool) : void {
        self.strength = s.bloom;
        if (!s.autoExposure) {
            self.exposure = s.exposure * lightExp2(s.exposureBias);
            return;
        }
        // One pixel in sixteen: the mean of a logarithm over 57 000 pixels of a 720p picture is the mean over all of
        // them to the third digit, and this runs on the thread that waits for the frame.
        let mut sum : f32 = 0.0;
        let mut n : i32 = 0;
        let mut y : i32 = 1;
        while (y < self.h) {
            let mut x : i32 = 1;
            while (x < self.w) {
                let at : i64 = ((y * self.w + x) * 3) as i64;
                let lum : f32 = POST_LUMA_R * hdr[at] + POST_LUMA_G * hdr[at + 1] + POST_LUMA_B * hdr[at + 2];
                sum = sum + lightLog2(max(lum, POST_METER_FLOOR));
                n = n + 1;
                x = x + POST_METER_STEP;
            }
            y = y + POST_METER_STEP;
        }
        let mean : f32 = lightExp2(sum / (max(n, 1) as f32));
        // Only most of the way to the key: a dark cave is not brought up to the brightness of noon, so what glows in
        // it still glows instead of going white.
        let mut want : f32 = lightPow(POST_KEY / mean, EXPOSURE_FOLLOW);
        if (want < POST_EXPOSURE_MIN) {
            want = POST_EXPOSURE_MIN;
        }
        if (want > POST_EXPOSURE_MAX) {
            want = POST_EXPOSURE_MAX;
        }
        want = want * lightExp2(s.exposureBias);
        if (instant) {
            self.exposure = want;
            return;
        }
        let blend : f32 = saturate(seconds * POST_ADAPT);
        let current : f32 = lightLog2(self.exposure);
        self.exposure = lightExp2(current + (lightLog2(want) - current) * blend);
    }

    /** How many rows of work a pass has. */
    pub fn rowsOf(self, pass : LumenPass) : i32 {
        return match pass {
            LumenPass::Bright => self.h / 2,
            LumenPass::BlurAcross => self.h / 2,
            LumenPass::BlurDown => self.h / 2,
            LumenPass::Fold => self.h / 2,
            LumenPass::Compose => self.h,
            LumenPass::Pack => self.packRows(),
        };
    }

    // At the picture's own size `compose` writes the finished words itself, and there is nothing left to pack.
    fn packRows(self) : i32 {
        if (self.scale == 1 && !self.raw) {
            return 0;
        }
        return self.h * self.scale;
    }

    /** Runs rows `begin` up to `end` of `pass` over the radiance picture `hdr`. */
    pub fn rows(mut self, pass : LumenPass, hdr : f32[], begin : i32, end : i32) : void {
        match pass {
            LumenPass::Bright => self.bright(hdr, begin, end),
            LumenPass::BlurAcross => pkBlurAcross(self.lv1, self.tmp, self.w / 2, begin, end),
            LumenPass::BlurDown => pkBlurDown(self.tmp, self.lv1, self.w / 2, self.h / 2, begin, end),
            LumenPass::Fold => pkFoldRows(
                self.lv1,
                self.w / 2,
                POST_BLOOM_W1,
                self.lv2,
                self.w / 4,
                self.h / 4,
                1.0,
                begin,
                end
            ),
            LumenPass::Compose => self.composeRows(hdr, begin, end),
            LumenPass::Pack => self.pack(begin, end),
        }
    }

    /**
     * The coarser bloom levels: small enough for one thread. The pass `Fold` must follow, once: it folds them into
     * the half-size level the picture reads, and without it the bloom is that level alone.
     */
    pub fn coarse(mut self) : void {
        let hw : i32 = self.w / 2;
        let hh : i32 = self.h / 2;
        pkShrink(self.lv1, hw, hh, self.lv2);
        pkShrink(self.lv2, hw / 2, hh / 2, self.lv3);
        pkShrink(self.lv3, hw / 4, hh / 4, self.lv4);
        pkBlurAcross(self.lv2, self.tmp, hw / 2, 0, hh / 2);
        pkBlurDown(self.tmp, self.lv2, hw / 2, hh / 2, 0, hh / 2);
        pkBlurAcross(self.lv3, self.tmp, hw / 4, 0, hh / 4);
        pkBlurDown(self.tmp, self.lv3, hw / 4, hh / 4, 0, hh / 4);
        pkBlurAcross(self.lv4, self.tmp, hw / 8, 0, hh / 8);
        pkBlurDown(self.tmp, self.lv4, hw / 8, hh / 8, 0, hh / 8);
        // The coarser levels are folded each into the next finer one, weights included, so that the picture reads one
        // level for a pixel instead of four; the last fold, into the half-size level, is the pass `Fold`.
        pkFoldRows(self.lv3, hw / 4, POST_BLOOM_W3, self.lv4, hw / 8, hh / 8, POST_BLOOM_W4, 0, hh / 4);
        pkFoldRows(self.lv2, hw / 2, POST_BLOOM_W2, self.lv3, hw / 4, hh / 4, 1.0, 0, hh / 2);
    }

    // Half-size copy of the light above white in the exposed picture: the bloom's source.
    fn bright(mut self, hdr : f32[], begin : i32, end : i32) : void {
        let hw : i32 = self.w / 2;
        for (y of begin..end) {
            for (x of 0..hw) {
                let mut r : f32 = 0.0;
                let mut g : f32 = 0.0;
                let mut b : f32 = 0.0;
                for (k of 0..4) {
                    let at : i64 = (((y * 2 + k / 2) * self.w + x * 2 + k % 2) * 3) as i64;
                    let c : Vec3 = Vec3 { x: hdr[at], y: hdr[at + 1], z: hdr[at + 2] }
                        .scale(self.exposure)
                        .componentMin(Vec3::splat(BLOOM_CEILING));
                    let m : f32 = c.maxComponent();
                    let keep : f32 = max(m - (1.0 as f32), 0.0) / max(m, 0.0001);
                    r = r + c.x * keep;
                    g = g + c.y * keep;
                    b = b + c.z * keep;
                }
                let o : i64 = ((y * hw + x) * 3) as i64;
                self.lv1[o] = r * (0.25 as f32);
                self.lv1[o + 1] = g * (0.25 as f32);
                self.lv1[o + 2] = b * (0.25 as f32);
            }
        }
    }

    // The composition of rows `begin` up to `end`: straight to words when the picture is shown at its own size.
    fn composeRows(mut self, hdr : f32[], begin : i32, end : i32) : void {
        if (self.scale == 1 && !self.raw) {
            self.composeWords(hdr, begin, end);
        } else {
            self.compose(hdr, begin, end);
        }
    }

    // `compose` and `pack` in one pass, for a picture shown at its own size: sharpen, expose, bloom, vignette, grade,
    // tone, encode, dither, pack. The same picture as the general path, written for the loop that runs it for every
    // pixel of every frame:
    //   - every field it reads is bound to a local before the loop (a store through `out` could change any of them for
    //     all the compiler knows, so it would load them again for each pixel);
    //   - the bloom is one level at exactly half the size, so a pixel's bilinear read has fixed weights (3/4 and 1/4
    //     each way) and walks along the row: one new column of the level for every two pixels, no floor, no clamp;
    //   - the sRGB code comes from a table over the linear value itself, as an integer with eight more bits, so the
    //     dither is an integer add and the three channels are packed with shifts: no square root, no conversion back.
    fn composeWords(mut self, hdr : f32[], begin : i32, end : i32) : void {
        let w : i32 = self.w;
        let h : i32 = self.h;
        let hw : i32 = w / 2;
        let hh : i32 = h / 2;
        let lv1 : f32[] = self.lv1;
        let tone : f32[] = self.tone;
        let word : i32[] = self.word;
        let grain : i32[] = self.grain;
        let mut out : i32[] = self.out;
        let exposure : f32 = self.exposure;
        let bloom : bool = self.strength > 0.0;
        let kb : f32 = self.strength * POST_BLOOM_GAIN;
        let kNear : f32 = kb * (0.75 as f32);
        let kFar : f32 = kb * (0.25 as f32);
        let inv_w : f32 = (1.0 as f32) / (w as f32);
        let inv_h : f32 = (1.0 as f32) / (h as f32);
        let mask : i32 = POST_DITHER_SIDE - 1;
        let row : i64 = (w * 3) as i64;
        let toneScale : f32 = (POST_TABLE as f32) / POST_TONE_MAX;
        for (y of begin..end) {
            let dy : f32 = ((y as f32) + (0.5 as f32)) * inv_h - (0.5 as f32);
            let dy2 : f32 = dy * dy;
            let inner : bool = y > 0 && y < h - 1;
            let ditherRow : i32 = (y & mask) * POST_DITHER_SIDE;

            // The two rows of the bloom level this row lies between: its own with 3/4, the next one out with 1/4.
            let by : i32 = y >> 1;
            let rowA : i64 = ((pkClamp(by, hh) * hw) * 3) as i64;
            let rowB : i64 = ((pkClamp(by + ((y & 1) * 2 - 1), hh) * hw) * 3) as i64;

            // The level's columns before, at and after the pixel, each already blended down its two rows.
            let mut pr : f32 = 0.0;
            let mut pg : f32 = 0.0;
            let mut pb : f32 = 0.0;
            let mut cr : f32 = 0.0;
            let mut cg : f32 = 0.0;
            let mut cb : f32 = 0.0;
            let mut nr : f32 = 0.0;
            let mut ng : f32 = 0.0;
            let mut nb : f32 = 0.0;
            if (bloom) {
                nr = lv1[rowA] * kNear + lv1[rowB] * kFar;
                ng = lv1[rowA + 1] * kNear + lv1[rowB + 1] * kFar;
                nb = lv1[rowA + 2] * kNear + lv1[rowB + 2] * kFar;
                cr = nr;
                cg = ng;
                cb = nb;
            }
            let mut at : i64 = ((y * w) * 3) as i64;
            let mut o : i64 = (y * w) as i64;
            for (x of 0..w) {
                let mut r : f32 = hdr[at];
                let mut g : f32 = hdr[at + 1];
                let mut b : f32 = hdr[at + 2];
                if (inner && x > 0 && x < w - 1) {
                    r = pkSharp(r, hdr[at - 3], hdr[at + 3], hdr[at - row], hdr[at + row]);
                    g = pkSharp(g, hdr[at - 2], hdr[at + 4], hdr[at - row + 1], hdr[at + row + 1]);
                    b = pkSharp(b, hdr[at - 1], hdr[at + 5], hdr[at - row + 2], hdr[at + row + 2]);
                }
                r = r * exposure;
                g = g * exposure;
                b = b * exposure;
                if (bloom) {
                    if ((x & 1) == 0) {
                        // A new pair of pixels: the columns move on by one.
                        pr = cr;
                        pg = cg;
                        pb = cb;
                        cr = nr;
                        cg = ng;
                        cb = nb;
                        let k : i64 = (pkClamp((x >> 1) + 1, hw) * 3) as i64;
                        nr = lv1[rowA + k] * kNear + lv1[rowB + k] * kFar;
                        ng = lv1[rowA + k + 1] * kNear + lv1[rowB + k + 1] * kFar;
                        nb = lv1[rowA + k + 2] * kNear + lv1[rowB + k + 2] * kFar;
                        r = r + cr * (0.75 as f32) + pr * (0.25 as f32);
                        g = g + cg * (0.75 as f32) + pg * (0.25 as f32);
                        b = b + cb * (0.75 as f32) + pb * (0.25 as f32);
                    } else {
                        r = r + cr * (0.75 as f32) + nr * (0.25 as f32);
                        g = g + cg * (0.75 as f32) + ng * (0.25 as f32);
                        b = b + cb * (0.75 as f32) + nb * (0.25 as f32);
                    }
                }

                // The grade, as in `grade`.
                let dx : f32 = ((x as f32) + (0.5 as f32)) * inv_w - (0.5 as f32);
                let dim : f32 = (1.0 as f32) - POST_VIGNETTE * (dx * dx + dy2);
                r = r * dim;
                g = g * dim;
                b = b * dim;
                let grey : f32 = POST_LUMA_R * r + POST_LUMA_G * g + POST_LUMA_B * b;
                let peak : f32 = max(max(r, max(g, b)), 0.0);
                if (peak > POST_CLIP_KNEE) {
                    // Only a highlight loses saturation, so only a highlight pays for the division.
                    let fade : f32 = min((peak - POST_CLIP_KNEE) / (peak + POST_CLIP_RANGE), 1.0)
                        * POST_CLIP_DESAT;
                    r = r + (grey - r) * fade;
                    g = g + (grey - g) * fade;
                    b = b + (grey - b) * fade;
                }
                r = grey + (r - grey) * POST_GRADE;
                g = grey + (g - grey) * POST_GRADE;
                b = grey + (b - grey) * POST_GRADE;
                let m : f32 = max(max(r, max(g, b)), 0.0);
                let mut gain : f32 = 0.0;
                if (m >= POST_TONE_MAX) {
                    gain = lightToneCurve(m, LIGHT_TONE_KNEE) / m;
                } else {
                    let f : f32 = m * toneScale;
                    let k : i32 = f as i32;
                    let lo : f32 = tone[k as i64];
                    gain = lo + (tone[(k + 1) as i64] - lo) * (f - k as f32);
                }
                let n : i32 = grain[(ditherRow + (x & mask)) as i64];
                out[o] = (((word[pkWordIndex(r * gain) as i64] + n) >> 8) << 16)
                    | (((word[pkWordIndex(g * gain) as i64] + n) >> 8) << 8)
                    | ((word[pkWordIndex(b * gain) as i64] + n) >> 8);
                at = at + 3;
                o = o + 1;
            }
        }
    }

    // Picture, bloom, vignette and grade into display values (encoded, 0..1) at render size.
    fn compose(mut self, hdr : f32[], begin : i32, end : i32) : void {
        let hw : i32 = self.w / 2;
        let hh : i32 = self.h / 2;
        let bloom : bool = self.strength > 0.0;
        let kb : f32 = self.strength * POST_BLOOM_GAIN;
        let inv_w : f32 = (1.0 as f32) / (self.w as f32);
        let inv_h : f32 = (1.0 as f32) / (self.h as f32);
        for (y of begin..end) {
            let v : f32 = ((y as f32) + (0.5 as f32)) * inv_h;
            let dy : f32 = v - (0.5 as f32);
            for (x of 0..self.w) {
                let u : f32 = ((x as f32) + (0.5 as f32)) * inv_w;
                let at : i64 = ((y * self.w + x) * 3) as i64;
                let c : Vec3 = self.sharpened(hdr, x, y);
                if (self.raw) {
                    self.disp[at] = saturate(c.x);
                    self.disp[at + 1] = saturate(c.y);
                    self.disp[at + 2] = saturate(c.z);
                    continue;
                }

                let mut e : Vec3 = c.scale(self.exposure);
                if (bloom) {
                    e = e.plus(pkBilinear(self.lv1, hw, hh, u, v).scale(kb));
                }
                let dx : f32 = u - (0.5 as f32);
                let shown : Vec3 = self.grade(e, dx * dx + dy * dy);
                self.disp[at] = shown.x;
                self.disp[at + 1] = shown.y;
                self.disp[at + 2] = shown.z;
            }
        }
    }

    // Vignette, highlight roll-off, grade and tone curve of the exposed colour `e`, as encoded display values in
    // 0..1; `edge2` is the squared distance of the pixel from the middle of the picture.
    fn grade(self, e : Vec3, edge2 : f32) : Vec3 {
        let dimmed : Vec3 = e.scale((1.0 as f32) - POST_VIGNETTE * edge2);
        let grey : f32 = POST_LUMA_R * dimmed.x + POST_LUMA_G * dimmed.y + POST_LUMA_B * dimmed.z;
        let peak : f32 = max(dimmed.maxComponent(), 0.0);
        // Highlights lose their saturation as they clip, like film: a lantern on grass goes
        // yellow-white, not neon.
        let clipped : f32 = saturate((peak - POST_CLIP_KNEE) / (peak + POST_CLIP_RANGE));
        let rolled : Vec3 = dimmed.lerp(Vec3 { x: grey, y: grey, z: grey }, clipped * POST_CLIP_DESAT);
        let graded : Vec3 = Vec3 { x: grey, y: grey, z: grey }.lerp(rolled, POST_GRADE);
        let m : f32 = max(graded.maxComponent(), 0.0);
        let gain : f32 = self.toneGain(m);
        return Vec3 {
            x: self.encode(max(graded.x, 0.0) * gain),
            y: self.encode(max(graded.y, 0.0) * gain),
            z: self.encode(max(graded.z, 0.0) * gain),
        };
    }

    // The picture at (x, y) with its detail brought back: the pixel plus a share of its difference from the mean
    // of its four neighbours, kept inside the range of those neighbours so no edge grows a halo. A picture drawn
    // at half the output size and scaled up, with history that resamples it, is softer than the same one drawn
    // directly; this takes back about what that cost.
    fn sharpened(self, hdr : f32[], x : i32, y : i32) : Vec3 {
        let at : i64 = ((y * self.w + x) * 3) as i64;
        let c : Vec3 = Vec3 { x: hdr[at], y: hdr[at + 1], z: hdr[at + 2] };
        if (x == 0 || y == 0 || x == self.w - 1 || y == self.h - 1) {
            return c;
        }
        let row : i64 = (self.w * 3) as i64;
        let l : Vec3 = Vec3 { x: hdr[at - 3], y: hdr[at - 2], z: hdr[at - 1] };
        let r : Vec3 = Vec3 { x: hdr[at + 3], y: hdr[at + 4], z: hdr[at + 5] };
        let u : Vec3 = Vec3 { x: hdr[at - row], y: hdr[at - row + 1], z: hdr[at - row + 2] };
        let d : Vec3 = Vec3 { x: hdr[at + row], y: hdr[at + row + 1], z: hdr[at + row + 2] };
        let mean : Vec3 = l.plus(r).plus(u).plus(d).scale((0.25 as f32));
        let lo : Vec3 = l.componentMin(r).componentMin(u).componentMin(d);
        let hi : Vec3 = l.componentMax(r).componentMax(u).componentMax(d);
        let sharp : Vec3 = c.plus(c.minus(mean).scale(POST_SHARPEN));
        return sharp.componentMax(lo.componentMin(c)).componentMin(hi.componentMax(c));
    }

    // T(m) / m by table.
    fn toneGain(self, m : f32) : f32 {
        if (m >= POST_TONE_MAX) {
            return lightToneCurve(m, LIGHT_TONE_KNEE) / m;
        }
        let f : f32 = m * ((POST_TABLE as f32) / POST_TONE_MAX);
        let i : i32 = f as i32;
        let t : f32 = f - i as f32;
        return self.tone[i as i64] + (self.tone[(i + 1) as i64] - self.tone[i as i64]) * t;
    }

    // The sRGB encoding of a linear value in 0..1, by table over its square root.
    fn encode(self, x : f32) : f32 {
        let s : f32 = saturate(x).sqrt() * (POST_TABLE as f32);
        let mut i : i32 = s as i32;
        if (i >= POST_TABLE) {
            i = POST_TABLE - 1;
        }
        let t : f32 = s - i as f32;
        return self.code[i as i64] + (self.code[(i + 1) as i64] - self.code[i as i64]) * t;
    }

    // Output rows: the display values bilinearly scaled to the output size, dithered under one code and packed.
    fn pack(mut self, begin : i32, end : i32) : void {
        let ow : i32 = self.w * self.scale;
        let oh : i32 = self.h * self.scale;
        let mask : i32 = POST_DITHER_SIDE - 1;
        for (oy of begin..end) {
            let v : f32 = ((oy as f32) + (0.5 as f32)) / (oh as f32);
            for (ox of 0..ow) {
                let n : f32 = self.dither[((oy & mask) * POST_DITHER_SIDE + (ox & mask)) as i64];
                let mut c : Vec3 = Vec3::zero();
                if (self.scale == 1) {
                    let at : i64 = ((oy * self.w + ox) * 3) as i64;
                    c = Vec3 { x: self.disp[at], y: self.disp[at + 1], z: self.disp[at + 2] };
                } else {
                    c = pkBilinear(self.disp, self.w, self.h, ((ox as f32) + (0.5 as f32)) / (ow as f32), v);
                }
                self.out[(oy * ow + ox) as i64] = pkPack(
                    pkCode(c.x, n),
                    pkCode(c.y, n),
                    pkCode(c.z, n)
                );
            }
        }
    }
}

// One channel sharpened: the value plus a share of its difference from the mean of its four neighbours, kept inside
// the range of those neighbours and itself, so no edge grows a halo.
fn pkSharp(c : f32, l : f32, r : f32, u : f32, d : f32) : f32 {
    let lo : f32 = min(min(l, r), min(u, d));
    let hi : f32 = max(max(l, r), max(u, d));
    let sharp : f32 = c + (c - (l + r + u + d) * (0.25 as f32)) * POST_SHARPEN;
    return min(max(sharp, min(lo, c)), max(hi, c));
}

// The entry of the `word` table for the linear value `x`: the nearest of 4096 over 0..1/16, where the transfer is
// steep, or of 4096 over the rest. Anything below 0 reads the first entry and anything above 1 the last.
fn pkWordIndex(x : f32) : i32 {
    let c : f32 = min(max(x, 0.0), 1.0);
    if (c < POST_WORD_SPLIT) {
        return (c * POST_WORD_LOW + (0.5 as f32)) as i32;
    }
    return ((c - POST_WORD_SPLIT) * POST_WORD_HIGH + (POST_TABLE as f32) + (0.5 as f32)) as i32;
}

// The linear value the entry `i` of the `word` table stands for.
fn pkWordValue(i : i32) : f32 {
    if (i < POST_TABLE) {
        return (i as f32) / POST_WORD_LOW;
    }
    return POST_WORD_SPLIT + ((i - POST_TABLE) as f32) / POST_WORD_HIGH;
}

// The framebuffer word of three 0..255 channels: 0x00RRGGBB.
fn pkPack(r : i32, g : i32, b : i32) : i32 {
    return ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF);
}

fn pkCode(v : f32, n : f32) : i32 {
    let c : i32 = (v * (255.0 as f32) + n + (0.5 as f32)) as i32;
    if (c < 0) {
        return 0;
    }
    if (c > 255) {
        return 255;
    }
    return c;
}

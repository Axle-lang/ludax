// pathlight_celestial — what hangs in the sky: the sun's and the moon's discs and the stars.
//
// The sun disc is only a size and an edge (the sky draws it from its irradiance); the moon gets a face of dark
// seas and craters from two octaves of value noise, and the stars are single cells of a fine direction grid
// chosen by a hash, so a star is where it always was and twinkles with the animation time.

use crate::core::math::scalar::{PI, smoothstep};
use crate::core::math::trig::sin;
use crate::core::math::vec3::Vec3;
use crate::render::pathlight::pathlight_noise::{lnFloor, lnUnit, lnValue2};

// ---- the discs

/** Angular radii, in radians, of the discs drawn in the sky (the sun is drawn a little larger than life). */
pub const SUN_RADIUS : f32 = 0.012;
pub const MOON_RADIUS : f32 = 0.017;

/** Width of the smooth edge of a drawn disc, in cosine units. */
pub const DISC_EDGE : f32 = 0.00002;

// ---- the moon's face

/** The moon's maria: noise scale on the disc, its offsets, and the seed. */
const MOON_MARIA_SCALE : f32 = 2.6;
const MOON_MARIA_SHIFT_A : f32 = 9.0;
const MOON_MARIA_SHIFT_B : f32 = 4.0;
const MOON_MARIA_SEED : i32 = 311;

/** The moon's craters: a finer noise, its offset and seed. */
const MOON_CRATER_SCALE : f32 = 9.0;
const MOON_CRATER_SHIFT : f32 = 2.0;
const MOON_CRATER_SEED : i32 = 313;

/** The moon is dark in the maria between these noise values, by this much, and by this much in craters. */
const MOON_MARIA_FROM : f32 = 0.45;
const MOON_MARIA_TO : f32 = 0.7;
const MOON_MARIA_DARK : f32 = 0.55;
const MOON_CRATER_DARK : f32 = 0.18;

// ---- the stars

/** Cells per radian of the fine grid the stars are placed on, and the hash level above which a cell holds one. */
const STAR_FREQ : f32 = 260.0;
const STAR_CHANCE : f32 = 0.9975;

/** A star's hash seeds: its presence and its warmth. */
const STAR_SEED : i32 = 331;
const STAR_WARM_SEED : i32 = 332;

/** A star twinkles between `STAR_TWINKLE_BASE - STAR_TWINKLE_DEPTH` and 1, this fast, out of step by its warmth. */
const STAR_TWINKLE_BASE : f32 = 0.9;
const STAR_TWINKLE_DEPTH : f32 = 0.1;
const STAR_TWINKLE_PACE : f32 = 3.0;
const STAR_TWINKLE_PHASE : f32 = 40.0;

/** The brightness of the brightest star. */
const STAR_GAIN : f32 = 0.9;

// A cold star's colour; the warmth of a star blends it towards `starWarm`.
fn starCold() : Vec3 {
    return Vec3 { x: 0.8, y: 0.9, z: 1.2 };
}

// A warm star's colour.
fn starWarm() : Vec3 {
    return Vec3 { x: 1.2, y: 0.95, z: 0.7 };
}

/**
 * The radiance of the moon's disc along `dir`: a full moon with a few dark seas, darkened where low-frequency
 * noise is high. `moonDir` is the unit direction toward the moon and `moonIrr` its irradiance.
 */
pub fn lumenMoonDisc(dir : Vec3, moonDir : Vec3, moonIrr : Vec3) : Vec3 {
    let s : f32 = sin(MOON_RADIUS);
    let t1 : Vec3 = moonDir.anyPerpendicular().normalized();
    let t2 : Vec3 = moonDir.cross(t1);
    let a : f32 = dir.dot(t1) / MOON_RADIUS;
    let b : f32 = dir.dot(t2) / MOON_RADIUS;

    let seaU : f32 = a * MOON_MARIA_SCALE + MOON_MARIA_SHIFT_A;
    let seaV : f32 = b * MOON_MARIA_SCALE + MOON_MARIA_SHIFT_B;
    let sea : f32 = lnValue2(seaU, seaV, MOON_MARIA_SEED);
    let craterU : f32 = a * MOON_CRATER_SCALE + MOON_CRATER_SHIFT;
    let craterV : f32 = b * MOON_CRATER_SCALE;
    let crater : f32 = lnValue2(craterU, craterV, MOON_CRATER_SEED);

    let seas : f32 = MOON_MARIA_DARK * smoothstep(MOON_MARIA_FROM, MOON_MARIA_TO, sea);
    let shade : f32 = (1.0 as f32) - seas - MOON_CRATER_DARK * crater;
    return moonIrr.scale(shade / (PI * s * s));
}

/** The radiance of a star along `dir` at animation time `time`, or zero where there is none. */
pub fn lumenStars(dir : Vec3, time : f32) : Vec3 {
    let cx : i32 = lnFloor(dir.x * STAR_FREQ);
    let cy : i32 = lnFloor(dir.y * STAR_FREQ);
    let cz : i32 = lnFloor(dir.z * STAR_FREQ);
    let h : f32 = lnUnit(cx, cy, cz, STAR_SEED);
    if (h < STAR_CHANCE) {
        return Vec3::zero();
    }

    let k : f32 = (h - STAR_CHANCE) / ((1.0 as f32) - STAR_CHANCE);
    let warm : f32 = lnUnit(cx, cy, cz, STAR_WARM_SEED);
    let phase : f32 = time * STAR_TWINKLE_PACE + warm * STAR_TWINKLE_PHASE;
    let twinkle : f32 = STAR_TWINKLE_BASE + STAR_TWINKLE_DEPTH * sin(phase);
    return starCold().lerp(starWarm(), warm).scale(k * k * twinkle * STAR_GAIN);
}

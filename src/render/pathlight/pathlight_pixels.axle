// pathlight_pixels — reading and writing the interleaved float pictures the frame keeps.
//
// Every picture of the frame (radiance, albedo, position, light) is one `f32` array with three floats a pixel, so
// a pixel's colour is read and written as a `Vec3` rather than as three indexed loads that a reader has to keep
// in step. The helpers are free functions because the frame, the spatial filter and the display all use them.

use crate::core::math::vec3::Vec3;

/** Element `i` of an interleaved three-component `f32` picture, as a vector. */
pub fn pixelAt(buf : f32[], i : i64) : Vec3 {
    return Vec3 { x: buf[i * 3], y: buf[i * 3 + 1], z: buf[i * 3 + 2] };
}

/** Writes `v` as element `i` of an interleaved three-component `f32` picture. */
pub fn pixelPut(buf : f32[], i : i64, v : Vec3) : void {
    buf[i * 3] = v.x;
    buf[i * 3 + 1] = v.y;
    buf[i * 3 + 2] = v.z;
}

/** The brightness of a linear colour (Rec. 709 weights): what noise and exposure are measured in. */
pub fn pixelLuma(c : Vec3) : f32 {
    return (0.2126 as f32) * c.x + (0.7152 as f32) * c.y + (0.0722 as f32) * c.z;
}

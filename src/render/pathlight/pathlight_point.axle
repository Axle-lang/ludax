// pathlight_point — the shading inputs of one surface point: position, normals, albedo, roughness, emission.
//
// A plain value; what turns a struck surface into one is the caller's (the valley reads its texture atlas, the
// streamed world its model tables), the shader only reads it.

use crate::core::math::vec3::Vec3;

/** The shading inputs of one surface point. */
pub struct LumenPoint {
    /** World position of the hit. */
    pub pos : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Geometric normal of the face, unit, toward the viewer's side. */
    pub ng : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Shading normal after the texel's relief. */
    pub n : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Linear albedo. */
    pub albedo : Vec3 = Vec3 { x: 0.5, y: 0.5, z: 0.5 };

    /** Perceptual roughness. */
    pub rough : f32 = 1.0;

    /** 0 dielectric, 1 metal. */
    pub metal : f32 = 0.0;

    /** Light the surface emits, scene radiance. */
    pub emissive : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** The block id. */
    pub block : i32 = 0;

    /** The surface layer bit, tested against the lamps' include and exclude masks. */
    pub layer : u32 = 1;
}

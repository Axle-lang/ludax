// scene_material — a glTF metallic-roughness material as the renderer sees it.
//
// The shading maths takes a `LightMaterial` (plain numbers); a scene material adds what only a renderer needs:
// which textures modulate each number (by id into `RenderAssets`, -1 for none) and whether both faces of a
// triangle are drawn. Colours are linear. `toLight` hands the constant part to the lighting library; textures
// are applied per pixel by the backend on top of it.

use crate::core::math::vec3::Vec3;
use crate::render::light::light_material::{LightAlphaMode, LightMaterial};

/** A surface description: constants, texture references and alpha behaviour. */
pub struct RenderMaterial {
    /** Linear base colour: the albedo of a dielectric and the F0 of a metal. */
    pub baseColor : Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 };

    /** Opacity, 0..1; used by `Blend`, tested against the cutoff by `Mask`. */
    pub alpha : f32 = 1.0;

    /** Opaque, Mask or Blend. */
    pub alphaMode : LightAlphaMode = LightAlphaMode::Opaque;

    /** In Mask mode the alpha below which a pixel is dropped. */
    pub alphaCutoff : f32 = 0.5;

    /** 0 = dielectric, 1 = metal. */
    pub metallic : f32 = 0.0;

    /** Perceptual roughness, 0..1. */
    pub roughness : f32 = 1.0;

    /** Light the surface emits, in scene radiance. */
    pub emissive : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Texture id multiplied into base colour and alpha (sRGB source, linear here), or -1. */
    pub baseColorTexture : i32 = -1;

    /** Texture id of a tangent-space normal map (stored linearly in 0..1), or -1. */
    pub normalTexture : i32 = -1;

    /** Strength of the normal map's slope: 1 = as authored. */
    pub normalScale : f32 = 1.0;

    /** Texture id of the glTF metallic-roughness map (green roughness, blue metallic), or -1. */
    pub metalRoughTexture : i32 = -1;

    /** Texture id multiplied into the emissive colour, or -1. */
    pub emissiveTexture : i32 = -1;

    /** True when the back of a triangle is drawn (and lit as a front) instead of culled. */
    pub doubleSided : bool = false;

    /** A rough dielectric of one colour. */
    pub static fn matte(color : Vec3) : RenderMaterial {
        return RenderMaterial { baseColor: color, metallic: 0.0, roughness: 0.9 };
    }

    /** A dielectric with a chosen roughness. */
    pub static fn plastic(color : Vec3, roughness : f32) : RenderMaterial {
        return RenderMaterial { baseColor: color, metallic: 0.0, roughness: roughness };
    }

    /** A metal: the colour is its F0. */
    pub static fn metal(color : Vec3, roughness : f32) : RenderMaterial {
        return RenderMaterial { baseColor: color, metallic: 1.0, roughness: roughness };
    }

    /** A surface that glows `radiance` and reflects nothing of note. */
    pub static fn glowing(radiance : Vec3) : RenderMaterial {
        return RenderMaterial { baseColor: Vec3::make(0.0, 0.0, 0.0), emissive: radiance, roughness: 1.0 };
    }

    /** The constant part as the lighting library's material. */
    pub fn toLight(self) : LightMaterial {
        return LightMaterial {
            baseColor: self.baseColor,
            alpha: self.alpha,
            alphaMode: self.alphaMode,
            alphaCutoff: self.alphaCutoff,
            metallic: self.metallic,
            roughness: self.roughness,
            emissive: self.emissive,
        };
    }

    /** True when the material blends over what is behind it. */
    pub fn isBlended(self) : bool {
        return self.alphaMode == LightAlphaMode::Blend;
    }
}

// scene_assets — the meshes, materials and textures a frame refers to by number.
//
// Instances, commands and the graph name things by small whole numbers; this table is what the numbers mean.
// Ids are the order of insertion, so they are the same on every run that inserts in the same order. Meshes and
// textures are classes and are stored in arrays this file grows itself (generic containers of ours cannot hold
// classes); the table takes ownership of what it is given, so ask it for the object afterwards. A material is
// plain data and is copied.

use crate::core::collections::vec::Vec;
use crate::render::scene::scene_material::RenderMaterial;
use crate::render::scene::scene_mesh::MeshData;
use crate::render::texture::texture::Texture;

/** Meshes, materials and textures by id. */
pub class RenderAssets {
    meshes    : MeshData[];
    meshCount : i32 = 0;
    meshRoom  : i32 = 8;
    mats      : Vec<RenderMaterial>;
    texes     : Texture[];
    texCount  : i32 = 0;
    texRoom   : i32 = 8;

    /** An empty table. */
    constructor() {
        self.meshes = malloc<MeshData>(8);
        self.mats = new Vec<RenderMaterial>();
        self.texes = malloc<Texture>(8);
    }

    /** Stores a mesh and returns its id. The table owns it from now on. */
    pub fn addMesh(mut self, own mesh : MeshData) : i32 {
        if (self.meshCount == self.meshRoom) {
            let mut bigger : MeshData[] = malloc<MeshData>((self.meshRoom * 2) as i64);
            for (i of 0..self.meshCount) {
                bigger[i] = self.meshes[i];
            }
            self.meshes = bigger;
            self.meshRoom = self.meshRoom * 2;
        }
        self.meshes[self.meshCount] = mesh;
        self.meshCount = self.meshCount + 1;
        return self.meshCount - 1;
    }

    /** Stores a texture and returns its id. The table owns it from now on. */
    pub fn addTexture(mut self, own texture : Texture) : i32 {
        if (self.texCount == self.texRoom) {
            let mut bigger : Texture[] = malloc<Texture>((self.texRoom * 2) as i64);
            for (i of 0..self.texCount) {
                bigger[i] = self.texes[i];
            }
            self.texes = bigger;
            self.texRoom = self.texRoom * 2;
        }
        self.texes[self.texCount] = texture;
        self.texCount = self.texCount + 1;
        return self.texCount - 1;
    }

    /** Stores a copy of a material and returns its id. */
    pub fn addMaterial(mut self, m : RenderMaterial) : i32 {
        self.mats.push(m);
        return self.mats.len() - 1;
    }

    /** How many meshes. */
    pub fn meshTotal(self) : i32 {
        return self.meshCount;
    }

    /** How many materials. */
    pub fn materialTotal(self) : i32 {
        return self.mats.len();
    }

    /** How many textures. */
    pub fn textureTotal(self) : i32 {
        return self.texCount;
    }

    /** True when `id` names a mesh. */
    pub fn hasMesh(self, id : i32) : bool {
        return id >= 0 && id < self.meshCount;
    }

    /** True when `id` names a material. */
    pub fn hasMaterial(self, id : i32) : bool {
        return id >= 0 && id < self.mats.len();
    }

    /** True when `id` names a texture. */
    pub fn hasTexture(self, id : i32) : bool {
        return id >= 0 && id < self.texCount;
    }

    /** The mesh with id `id`; the id must exist (ask `hasMesh`). */
    pub fn mesh(self, id : i32) : MeshData {
        return self.meshes[id];
    }

    /** The material with id `id`; the id must exist (ask `hasMaterial`). */
    pub fn material(self, id : i32) : RenderMaterial {
        return self.mats.get(id);
    }

    /** The texture with id `id`; the id must exist (ask `hasTexture`). */
    pub fn texture(self, id : i32) : Texture {
        return self.texes[id];
    }
}

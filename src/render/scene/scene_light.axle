// scene_light — a light as a component: physical units, no position of its own.
//
// An entity that shines carries a `LightComp`. Strength is given the way a lighting designer says it (lux for the
// sun, candela for a lamp) and converted to scene units only by the lighting library's `LightSource`
// constructors, so this file never touches the scale. The entity's world transform supplies where the light is
// (its translation) and which way it points (its rotation applied to local -Z, like a camera).
// `toSource` joins the two into the `LightSource` that shading reads, in camera-relative space.

use crate::core::math::vec3::Vec3;
use crate::render::light::light_source::{LightKind, LightShadowMode, LightSource};

/** The data of one light, attached to an entity. */
pub struct LightComp {
    /** Directional, Point, Spot or Emissive. */
    pub kind : LightKind = LightKind::Point;

    /** Linear RGB tint. */
    pub color : Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 };

    /** Lux for a directional light, candela for a point or spot light, cd/m^2 for an emissive disc. */
    pub amount : f32 = 0.0;

    /** Reach in world units where the smooth window ends; 0 = unlimited. */
    pub range : f32 = 0.0;

    /** Radius of the glowing sphere (point, spot) or disc (emissive). */
    pub radius : f32 = 0.0;

    /** Angular diameter of a directional light, radians (the sun is about 0.0093). */
    pub angularDiameter : f32 = 0.0;

    /** Spot: half-angle of full strength, radians. */
    pub innerAngle : f32 = 0.3;

    /** Spot: half-angle where the light ends, radians. */
    pub outerAngle : f32 = 0.5;

    /** None or Ray here; Map and Baked are for other backends. */
    pub shadowMode : LightShadowMode = LightShadowMode::None;

    /** Surfaces whose layer shares a bit with this are lit. */
    pub includeLayers : u32 = 4294967295;

    /** Surfaces whose layer shares a bit with this are never lit. */
    pub excludeLayers : u32 = 0;

    /** True for a light that never moves. */
    pub isStatic : bool = false;

    /** The sun or moon: `lux` of illuminance, an angular diameter in radians, shining along local -Z. */
    pub static fn sun(color : Vec3, lux : f32, angularDiameter : f32) : LightComp {
        return LightComp {
            kind: LightKind::Directional,
            color: color,
            amount: lux,
            angularDiameter: angularDiameter,
        };
    }

    /** A lamp of `candela`, a sphere of `radius`, reaching `range` (0 = unlimited). */
    pub static fn point(color : Vec3, candela : f32, radius : f32, range : f32) : LightComp {
        return LightComp {
            kind: LightKind::Point,
            color: color,
            amount: candela,
            radius: radius,
            range: range,
        };
    }

    /** A spot of `candela` along local -Z with half-angles `inner` <= `outer` (radians). */
    pub static fn spot(
        color : Vec3,
        candela : f32,
        inner : f32,
        outer : f32,
        radius : f32,
        range : f32
    ) : LightComp {
        return LightComp {
            kind: LightKind::Spot,
            color: color,
            amount: candela,
            innerAngle: inner,
            outerAngle: outer,
            radius: radius,
            range: range,
        };
    }

    /** The same light with the given shadow mode. */
    pub fn withShadows(self, mode : LightShadowMode) : LightComp {
        return LightComp {
            kind: self.kind,
            color: self.color,
            amount: self.amount,
            range: self.range,
            radius: self.radius,
            angularDiameter: self.angularDiameter,
            innerAngle: self.innerAngle,
            outerAngle: self.outerAngle,
            shadowMode: mode,
            includeLayers: self.includeLayers,
            excludeLayers: self.excludeLayers,
            isStatic: self.isStatic,
        };
    }

    /**
     * The light as the lighting library shades it, placed at `position` and pointing along `direction`
     * (both in the space the frame is shaded in: camera-relative world axes).
     */
    pub fn toSource(self, position : Vec3, direction : Vec3) : LightSource {
        let mut s : LightSource = match self.kind {
            LightKind::Directional => LightSource::directional(
                self.color,
                self.amount,
                direction,
                self.angularDiameter
            ),
            LightKind::Point => LightSource::point(
                self.color,
                self.amount,
                position,
                self.radius,
                self.range
            ),
            LightKind::Spot => LightSource::spot(
                self.color,
                self.amount,
                position,
                direction,
                self.innerAngle,
                self.outerAngle,
                self.radius,
                self.range
            ),
            LightKind::Emissive => LightSource::emissive(
                self.color,
                self.amount,
                position,
                direction,
                self.radius,
                self.range
            ),
        };
        s.shadowMode = self.shadowMode;
        s.includeLayers = self.includeLayers;
        s.excludeLayers = self.excludeLayers;
        s.isStatic = self.isStatic;
        return s;
    }
}

// scene_mesh — triangles in the flat layout a GPU takes: parallel arrays of floats, an index list, and bounds.
//
// `MeshData` knows nothing of files or importers; an importer (or a procedural builder, see scene_shapes) fills
// it. Positions, normals and texture coordinates are separate `f32` arrays (3, 3 and 2 floats per vertex),
// indices are `i32` (read as unsigned by a GPU), triangles are counter-clockwise seen from outside, and the
// bounds are an `Aabb` kept by `finish`. Arrays are plain `malloc` buffers: no fixed-size arrays, no generic
// containers, so the same bytes can be uploaded unchanged later.

use crate::core::math::geom::Aabb;
use crate::core::math::vec2::Vec2;
use crate::core::math::vec3::Vec3;

// Floats per vertex position or normal, floats per texture coordinate, and indices per triangle.
const MESH_VEC3 : i32 = 3;
const MESH_VEC2 : i32 = 2;
const MESH_CORNERS : i32 = 3;

/** An indexed triangle mesh with per-vertex normals and texture coordinates. */
pub class MeshData {
    verts : i32;
    tris  : i32;
    pos   : f32[];
    nor   : f32[];
    tex   : f32[];
    idx   : i32[];
    box   : Aabb;

    /** A mesh with room for `vertexCount` vertices and `triangleCount` triangles, all zero until set. */
    constructor(vertexCount : i32, triangleCount : i32) {
        self.verts = vertexCount;
        self.tris = triangleCount;
        self.pos = new f32[(vertexCount * MESH_VEC3) as i64];
        self.nor = new f32[(vertexCount * MESH_VEC3) as i64];
        self.tex = new f32[(vertexCount * MESH_VEC2) as i64];
        self.idx = new i32[(triangleCount * MESH_CORNERS) as i64];
        self.box = Aabb::empty();
        for (i of 0..vertexCount * MESH_VEC3) {
            self.pos[i] = 0.0;
            self.nor[i] = 0.0;
        }
        for (i of 0..vertexCount * MESH_VEC2) {
            self.tex[i] = 0.0;
        }
        for (i of 0..triangleCount * MESH_CORNERS) {
            self.idx[i] = 0;
        }
    }

    /** How many vertices. */
    pub fn vertexCount(self) : i32 {
        return self.verts;
    }

    /** How many triangles. */
    pub fn triangleCount(self) : i32 {
        return self.tris;
    }

    /** Sets vertex `i`: position, unit normal, texture coordinate (v grows downwards, like an image). */
    pub fn setVertex(mut self, i : i32, p : Vec3, n : Vec3, uv : Vec2) : void {
        let b3 : i32 = i * MESH_VEC3;
        self.pos[b3] = p.x;
        self.pos[b3 + 1] = p.y;
        self.pos[b3 + 2] = p.z;
        self.nor[b3] = n.x;
        self.nor[b3 + 1] = n.y;
        self.nor[b3 + 2] = n.z;
        self.tex[i * MESH_VEC2] = uv.x;
        self.tex[i * MESH_VEC2 + 1] = uv.y;
    }

    /** Sets triangle `t` to the vertices `a`, `b`, `c`, counter-clockwise seen from outside. */
    pub fn setTriangle(mut self, t : i32, a : i32, b : i32, c : i32) : void {
        self.idx[t * MESH_CORNERS] = a;
        self.idx[t * MESH_CORNERS + 1] = b;
        self.idx[t * MESH_CORNERS + 2] = c;
    }

    /** Computes the bounds from the positions; call once after the last `setVertex`. */
    pub fn finish(mut self) : void {
        let mut b : Aabb = Aabb::empty();
        for (i of 0..self.verts) {
            b = b.expandedToPoint(self.position(i));
        }
        self.box = b;
    }

    /** The position of vertex `i`. */
    pub fn position(self, i : i32) : Vec3 {
        return Vec3 {
            x: self.pos[i * MESH_VEC3],
            y: self.pos[i * MESH_VEC3 + 1],
            z: self.pos[i * MESH_VEC3 + 2],
        };
    }

    /** The normal of vertex `i`. */
    pub fn normal(self, i : i32) : Vec3 {
        return Vec3 {
            x: self.nor[i * MESH_VEC3],
            y: self.nor[i * MESH_VEC3 + 1],
            z: self.nor[i * MESH_VEC3 + 2],
        };
    }

    /** The texture coordinate of vertex `i`. */
    pub fn uv(self, i : i32) : Vec2 {
        return Vec2 { x: self.tex[i * MESH_VEC2], y: self.tex[i * MESH_VEC2 + 1] };
    }

    /** Vertex number `k` (0..3 * triangleCount) of the index list. */
    pub fn index(self, k : i32) : i32 {
        return self.idx[k];
    }

    /** The bounds of the positions (empty before `finish`). */
    pub fn bounds(self) : Aabb {
        return self.box;
    }

    /** The raw position array (3 floats per vertex): for backends that copy it, not for writing. */
    pub fn positionData(self) : f32[] {
        return self.pos;
    }

    /** The raw normal array (3 floats per vertex). */
    pub fn normalData(self) : f32[] {
        return self.nor;
    }

    /** The raw texture-coordinate array (2 floats per vertex). */
    pub fn uvData(self) : f32[] {
        return self.tex;
    }

    /** The raw index array (3 per triangle). */
    pub fn indexData(self) : i32[] {
        return self.idx;
    }

    // The position of corner `k` of triangle `t`.
    fn corner(self, t : i32, k : i32) : Vec3 {
        return self.position(self.idx[t * MESH_CORNERS + k]);
    }

    /** The area of triangle `t` (half the length of the cross product of two edges). */
    pub fn triangleArea(self, t : i32) : f32 {
        let a : Vec3 = self.corner(t, 0);
        let b : Vec3 = self.corner(t, 1);
        let c : Vec3 = self.corner(t, 2);
        return b.minus(a).cross(c.minus(a)).length() * (0.5 as f32);
    }

    /** The sum of the areas of all triangles. */
    pub fn surfaceArea(self) : f32 {
        let mut total : f32 = 0.0;
        for (t of 0..self.tris) {
            total = total + self.triangleArea(t);
        }
        return total;
    }

    /** The unit normal of triangle `t` from its winding (zero for a degenerate triangle). */
    pub fn faceNormal(self, t : i32) : Vec3 {
        let a : Vec3 = self.corner(t, 0);
        let b : Vec3 = self.corner(t, 1);
        let c : Vec3 = self.corner(t, 2);
        return b.minus(a).cross(c.minus(a)).normalizedOr(Vec3::zero());
    }
}

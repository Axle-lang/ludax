// level — how serious a log record is.

/** Severity of a log record; a logger drops records below its threshold. */
pub enum LogLevel : i8 {
    Trace = 0,
    Debug = 1,
    Info = 2,
    Warn = 3,
    Error = 4,

    /** The level whose rank is `rank`; a value out of range answers Error so corruption is never hidden. */
    pub static fn fromRank(rank : i32) : LogLevel {
        return match rank {
            0 => LogLevel::Trace,
            1 => LogLevel::Debug,
            2 => LogLevel::Info,
            3 => LogLevel::Warn,
            _ => LogLevel::Error,
        };
    }

    /** The ordering key: a higher number is more serious. */
    pub fn rank(self) : i32 {
        return self as i32;
    }

    /** Five characters wide, so columns of records line up. */
    pub fn label(self) : string {
        return match self {
            LogLevel::Trace => "TRACE",
            LogLevel::Debug => "DEBUG",
            LogLevel::Info => "INFO ",
            LogLevel::Warn => "WARN ",
            LogLevel::Error => "ERROR",
        };
    }
}

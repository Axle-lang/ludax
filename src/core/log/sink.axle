// sink — where log records go: the trait, a console sink, and a combinator.
//
// A sink is the seam between the logger and the world: stdout in a terminal run, a ring in memory for the
// in-engine console, a file in a shipped game. `Logger` is generic over its sink because Axle 0.18.3 cannot
// store a class in a trait-typed field (E0709), so the sink type is a compile-time parameter instead of a
// runtime one; the cost is none, the price is a type argument.

use crate::core::log::record::LogRecord;

/** Receives every record a logger lets through. */
pub trait LogSink {
    /** Takes one record; keep copies of its strings if they must outlive the call. */
    fn write(mut self, record : LogRecord) : void;
}

/** Prints each record to the standard output on its own line. */
pub class StdoutSink : LogSink {
    /** A console sink. */
    constructor() {}

    /** Prints the record. */
    pub fn write(mut self, record : LogRecord) : void {
        println(record.format());
    }
}

/** Sends each record to two sinks, `first` before `second`; nest them for more. */
pub class TeeSink<A : LogSink, B : LogSink> : LogSink {
    firstSink  : A;
    secondSink : B;

    /** A fan-out over the two sinks, which it owns. */
    constructor(own first : A, own second : B) {
        self.firstSink = first;
        self.secondSink = second;
    }

    /** The sink records reach first. */
    pub fn first(self) : A {
        return self.firstSink;
    }

    /** The sink records reach second. */
    pub fn second(self) : B {
        return self.secondSink;
    }

    /** Passes the record to both sinks. */
    pub fn write(mut self, record : LogRecord) : void {
        self.firstSink.write(record);
        self.secondSink.write(record);
    }
}

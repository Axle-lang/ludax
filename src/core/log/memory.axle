// memory — a sink that remembers the most recent records.
//
// A fixed-capacity ring: once full, each new record replaces the oldest. This is what an in-engine console
// reads, and what a crash report attaches. Storage is allocated once, up front, so logging never allocates a
// buffer; each record copies its two strings, which it must, because a record's text is only borrowed from
// the caller.
//
// Records are held as parallel arrays rather than an array of `LogRecord`: Axle 0.18.3 rejects containers of
// structs that hold strings, so the string arrays and the numeric arrays are kept side by side.

use crate::core::log::level::LogLevel;
use crate::core::log::record::LogRecord;
use crate::core::log::sink::LogSink;
use crate::core::math::scalar::atLeastOne;

/** Keeps the last `capacity` records, oldest first when read back. */
pub class MemorySink : LogSink {
    channels  : string[];
    messages  : string[];
    levels    : i32[];
    sequences : i64[];
    frames    : i64[];
    size      : i32 = 0;
    next      : i32 = 0;
    total     : i64 = 0;
    slots     : i32 = 1;

    /** A ring for `capacity` records (at least one). */
    constructor(capacity : i32) {
        let n : i32 = atLeastOne(capacity);
        self.slots = n;
        self.channels = new string[n as i64];
        self.messages = new string[n as i64];
        self.levels = new i32[n as i64];
        self.sequences = new i64[n as i64];
        self.frames = new i64[n as i64];
        for (i of 0..n) {
            self.channels[i] = "";
            self.messages[i] = "";
            self.levels[i] = 0;
            self.sequences[i] = 0;
            self.frames[i] = 0;
        }
    }

    /** Stores a copy of the record, replacing the oldest when the ring is full. */
    pub fn write(mut self, record : LogRecord) : void {
        let slot : i32 = self.next;
        self.channels[slot] = record.channel + "";
        self.messages[slot] = record.message + "";
        self.levels[slot] = record.level.rank();
        self.sequences[slot] = record.sequence;
        self.frames[slot] = record.frame;
        self.next = (slot + 1) % self.slots;
        if (self.size < self.slots) {
            self.size = self.size + 1;
        }
        self.total = self.total + 1;
    }

    /** How many records are held now. */
    pub fn count(self) : i32 {
        return self.size;
    }

    /** How many records ever arrived; the difference to `count` is how many were overwritten. */
    pub fn received(self) : i64 {
        return self.total;
    }

    /**
     * The `index`-th retained record counting from the oldest (0) to the newest (`count() - 1`); `index` must
     * be in that range.
     */
    pub fn at(self, index : i32) : LogRecord {
        let slot : i32 = (self.next - self.size + index + self.slots) % self.slots;
        return LogRecord {
            sequence: self.sequences[slot],
            frame: self.frames[slot],
            level: LogLevel::fromRank(self.levels[slot]),
            channel: self.channels[slot] + "",
            message: self.messages[slot] + "",
        };
    }

    /** Forgets every record but keeps counting sequence numbers (they belong to the logger, not the ring). */
    pub fn clear(mut self) : void {
        self.size = 0;
        self.next = 0;
    }
}

// record — one line of the log, and how it is printed.

use crate::core::log::level::LogLevel;

/** One log entry. The strings are only borrowed: a sink that keeps a record must copy them. */
pub struct LogRecord {
    /**
     * Position in the logger's output, counted from 0; gaps never occur, so a reader can see what it missed.
     */
    pub sequence : i64;

    /** The simulation frame the logger was told about when the record was made. */
    pub frame : i64;

    /** How serious it is. */
    pub level : LogLevel;

    /** The subsystem it came from ("physics", "assets"); empty for none. */
    pub channel : string;

    /** What happened. */
    pub message : string;

    /** The record as one display line: `[WARN ] #12 f340 physics: body fell out of the world`. */
    pub fn format(self) : string {
        let mut channel : string = "";
        if (self.channel.length > 0) {
            channel = "${self.channel}: ";
        }
        return "[${self.level.label()}] #${self.sequence} f${self.frame} ${channel}${self.message}";
    }
}

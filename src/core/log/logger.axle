// logger — leveled logging with a pluggable sink.
//
// A `Logger` filters by level, numbers what it lets through, stamps it with the current frame and hands it to
// its sink. The sequence number and the frame are the only clocks: a wall-clock time stamp would make two
// runs of the same simulation produce different logs, so a sink that wants real time adds it itself.

use crate::core::log::level::LogLevel;
use crate::core::log::record::LogRecord;
use crate::core::log::sink::LogSink;

/** Filters records by level, numbers them and writes them to one sink. */
pub class Logger<S : LogSink> {
    target    : S;
    threshold : LogLevel = LogLevel::Info;
    counter   : i64 = 0;
    frameNo   : i64 = 0;

    /** A logger writing to `sink`, which it owns; records below `threshold` are dropped. */
    constructor(own sink : S, threshold : LogLevel) {
        self.target = sink;
        self.threshold = threshold;
    }

    /** The sink, for reading back what a `MemorySink` holds. */
    pub fn sink(self) : S {
        return self.target;
    }

    /** Changes the level below which records are dropped. */
    pub fn setThreshold(mut self, level : LogLevel) : void {
        self.threshold = level;
    }

    /** Whether a record of `level` would be written; lets a caller skip building an expensive message. */
    pub fn enabled(self, level : LogLevel) : bool {
        return level.rank() >= self.threshold.rank();
    }

    /** Sets the frame number stamped on following records; the main loop calls it once per frame. */
    pub fn setFrame(mut self, frame : i64) : void {
        self.frameNo = frame;
    }

    /** How many records passed the filter so far. */
    pub fn written(self) : i64 {
        return self.counter;
    }

    /** Writes one record at `level` from `channel` unless the level is below the threshold. */
    pub fn log(mut self, level : LogLevel, channel : string, message : string) : void {
        if (!self.enabled(level)) {
            return;
        }
        let record : LogRecord = LogRecord {
            sequence: self.counter,
            frame: self.frameNo,
            level: level,
            channel: channel,
            message: message,
        };
        self.counter = self.counter + 1;
        self.target.write(record);
    }

    /** Fine-grained tracing, normally filtered out. */
    pub fn trace(mut self, channel : string, message : string) : void {
        self.log(LogLevel::Trace, channel, message);
    }

    /** Detail useful while developing. */
    pub fn debug(mut self, channel : string, message : string) : void {
        self.log(LogLevel::Debug, channel, message);
    }

    /** Ordinary events worth keeping. */
    pub fn info(mut self, channel : string, message : string) : void {
        self.log(LogLevel::Info, channel, message);
    }

    /** Something unexpected that the engine recovered from. */
    pub fn warn(mut self, channel : string, message : string) : void {
        self.log(LogLevel::Warn, channel, message);
    }

    /** Something failed. */
    pub fn error(mut self, channel : string, message : string) : void {
        self.log(LogLevel::Error, channel, message);
    }
}

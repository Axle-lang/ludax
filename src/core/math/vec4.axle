// vec4 — a four-component f32 vector.
//
// A homogeneous point (`w` = 1), a direction (`w` = 0), a clip-space position, or an RGBA colour. A `struct`,
// so a value; every operation is a named method, and the in-place forms end in `In`.

use crate::core::math::scalar::{lerp, approxEqWithin};
use crate::core::math::vec3::Vec3;

// Below this squared length a vector has no usable direction.
const V4_TINY : f32 = 0.00000000000000000001;

/** A four-component vector. */
pub struct Vec4 {
    /** X component. */
    pub x : f32 = 0.0;

    /** Y component. */
    pub y : f32 = 0.0;

    /** Z component. */
    pub z : f32 = 0.0;

    /** W component: 1 for a point, 0 for a direction. */
    pub w : f32 = 0.0;

    /** A vector from its components. */
    pub static fn make(x : f32, y : f32, z : f32, w : f32) : Vec4 {
        return Vec4 { x: x, y: y, z: z, w: w };
    }

    /** The zero vector. */
    pub static fn zero() : Vec4 {
        return Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
    }

    /** A 3D vector extended with `w`. */
    pub static fn fromVec3(v : Vec3, w : f32) : Vec4 {
        return Vec4 { x: v.x, y: v.y, z: v.z, w: w };
    }

    /** The first three components. */
    pub fn xyz(self) : Vec3 {
        return Vec3 { x: self.x, y: self.y, z: self.z };
    }

    /** Component-wise sum. */
    pub fn plus(self, o : Vec4) : Vec4 {
        return Vec4 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z, w: self.w + o.w };
    }

    /** Component-wise difference. */
    pub fn minus(self, o : Vec4) : Vec4 {
        return Vec4 { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z, w: self.w - o.w };
    }

    /** Component-wise product. */
    pub fn times(self, o : Vec4) : Vec4 {
        return Vec4 { x: self.x * o.x, y: self.y * o.y, z: self.z * o.z, w: self.w * o.w };
    }

    /** This vector multiplied by the number `k`. */
    pub fn scale(self, k : f32) : Vec4 {
        return Vec4 { x: self.x * k, y: self.y * k, z: self.z * k, w: self.w * k };
    }

    /** The dot product. */
    pub fn dot(self, o : Vec4) : f32 {
        return self.x * o.x + self.y * o.y + self.z * o.z + self.w * o.w;
    }

    /** The squared length. */
    pub fn lengthSquared(self) : f32 {
        return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w;
    }

    /** The Euclidean length. */
    pub fn length(self) : f32 {
        return self.lengthSquared().sqrt();
    }

    /** The same direction with length 1; the zero vector stays zero. */
    pub fn normalized(self) : Vec4 {
        let lenSq : f32 = self.lengthSquared();
        if (!(lenSq > V4_TINY)) {
            return Vec4::zero();
        }
        return self.scale((1.0 as f32) / lenSq.sqrt());
    }

    /** The point `t` of the way from this vector to `o`; `t` is not clamped. */
    pub fn lerp(self, o : Vec4, t : f32) : Vec4 {
        return Vec4 {
            x: lerp(self.x, o.x, t),
            y: lerp(self.y, o.y, t),
            z: lerp(self.z, o.z, t),
            w: lerp(self.w, o.w, t),
        };
    }

    /** Whether every component differs from `o`'s by at most `tolerance`. */
    pub fn approxEq(self, o : Vec4, tolerance : f32) : bool {
        return approxEqWithin(self.x, o.x, tolerance) && approxEqWithin(self.y, o.y, tolerance)
            && approxEqWithin(self.z, o.z, tolerance)
            && approxEqWithin(self.w, o.w, tolerance);
    }

    /** Overwrites all four components. */
    pub fn set(mut self, x : f32, y : f32, z : f32, w : f32) : void {
        self.x = x;
        self.y = y;
        self.z = z;
        self.w = w;
    }

    /** `self += o`. */
    pub fn addIn(mut self, o : Vec4) : void {
        self.x = self.x + o.x;
        self.y = self.y + o.y;
        self.z = self.z + o.z;
        self.w = self.w + o.w;
    }

    /** `self -= o`. */
    pub fn subIn(mut self, o : Vec4) : void {
        self.x = self.x - o.x;
        self.y = self.y - o.y;
        self.z = self.z - o.z;
        self.w = self.w - o.w;
    }

    /** `self *= k`. */
    pub fn scaleIn(mut self, k : f32) : void {
        self.x = self.x * k;
        self.y = self.y * k;
        self.z = self.z * k;
        self.w = self.w * k;
    }

    /** `self += o * k`. */
    pub fn mulAddIn(mut self, o : Vec4, k : f32) : void {
        self.x = self.x + o.x * k;
        self.y = self.y + o.y * k;
        self.z = self.z + o.z * k;
        self.w = self.w + o.w * k;
    }
}

// dquat — a unit quaternion: a rotation in three dimensions.
// Generated from quat.axle by tools/gen_math_f64.sh: edit the original, not this file.
//
// Four f64 fields, a value type. Rotations compose with `mul` (Hamilton product), interpolate with `slerp`,
// and convert to `DMat3`/`DMat4`; the conversion agrees with `DMat4::rotationX/Y/Z` exactly in convention:
// counter-clockwise when looking from the positive axis towards the origin, right-handed, +Y up.
//
// `a.mul(b)` applies `b` first and then `a`, the same order as matrix multiplication. Keep quaternions
// normalised: drift from repeated `mul` is removed with `normalized`, and the methods that need a unit
// quaternion assume it rather than pay for a square root each call.

use crate::core::math::dmat3::DMat3;
use crate::core::math::dmat4::DMat4;
use crate::core::math::dvec3::DVec3;
use crate::core::math::scalar::{approxEqWithinD, absD, clampD};
use crate::core::math::trig::{sinD, cosD, acosD, atan2D};

// Below this squared length a quaternion has no usable rotation.
const D_Q_TINY : f64 = 0.00000000000000000001;

// Beyond this dot product two rotations are so close that slerp's sine would vanish; a lerp takes over.
const D_Q_NEAR_PARALLEL : f64 = 0.9995;

/** A rotation. Defaults to the identity (no rotation). */
pub struct DQuat {
    /** X component of the vector part. */
    pub x : f64 = 0.0;

    /** Y component of the vector part. */
    pub y : f64 = 0.0;

    /** Z component of the vector part. */
    pub z : f64 = 0.0;

    /** The scalar part: the cosine of half the angle. */
    pub w : f64 = 1.0;

    /** The rotation that does nothing. */
    pub static fn identity() : DQuat {
        return DQuat {};
    }

    /** A quaternion from its four components, as given (not normalised). */
    pub static fn make(x : f64, y : f64, z : f64, w : f64) : DQuat {
        return DQuat { x: x, y: y, z: z, w: w };
    }

    /** The turn of `radians` about `axis`, counter-clockwise seen from the tip; a zero axis: identity. */
    pub static fn fromAxisAngle(axis : DVec3, radians : f64) : DQuat {
        let unit : DVec3 = axis.normalized();
        if (unit.lengthSquared() == 0.0) {
            return DQuat {};
        }
        let half : f64 = radians * (0.5 as f64);
        let s : f64 = sinD(half);
        return DQuat { x: unit.x * s, y: unit.y * s, z: unit.z * s, w: cosD(half) };
    }

    /**
     * The turn made of `yaw` about +Y (heading), then `pitch` about the heading's right-hand X axis, then
     * `roll` about the resulting Z axis: `Ry(yaw) * Rx(pitch) * Rz(roll)`. With +Y up and the camera looking
     * down -Z, positive pitch tips the nose up, and positive yaw turns to the left.
     */
    pub static fn fromEuler(yaw : f64, pitch : f64, roll : f64) : DQuat {
        let qy : DQuat = DQuat::fromAxisAngle(DVec3::unitY(), yaw);
        let qx : DQuat = DQuat::fromAxisAngle(DVec3::unitX(), pitch);
        let qz : DQuat = DQuat::fromAxisAngle(DVec3::unitZ(), roll);
        return qy.mul(qx).mul(qz);
    }

    /** The shortest rotation taking the direction `from` to the direction `to`; neither must be unit. */
    pub static fn fromTo(from : DVec3, to : DVec3) : DQuat {
        let a : DVec3 = from.normalized();
        let b : DVec3 = to.normalized();
        if (a.lengthSquared() == 0.0 || b.lengthSquared() == 0.0) {
            return DQuat {};
        }
        let d : f64 = a.dot(b);
        if (d < -0.999999) {
            let axis : DVec3 = a.anyPerpendicular();
            return DQuat { x: axis.x, y: axis.y, z: axis.z, w: 0.0 };
        }
        let c : DVec3 = a.cross(b);
        return DQuat { x: c.x, y: c.y, z: c.z, w: (1.0 as f64) + d }.normalized();
    }

    /** The rotation a 3x3 rotation matrix stands for (it must be proper: orthonormal, determinant 1). */
    pub static fn fromMat3(m : DMat3) : DQuat {
        let trace : f64 = m.m00 + m.m11 + m.m22;
        if (trace > 0.0) {
            let s : f64 = (2.0 as f64) * (trace + (1.0 as f64)).sqrt();
            return DQuat {
                x: (m.m21 - m.m12) / s,
                y: (m.m02 - m.m20) / s,
                z: (m.m10 - m.m01) / s,
                w: s * (0.25 as f64),
            };
        }
        if (m.m00 > m.m11 && m.m00 > m.m22) {
            let s : f64 = (2.0 as f64) * ((1.0 as f64) + m.m00 - m.m11 - m.m22).sqrt();
            return DQuat {
                x: s * (0.25 as f64),
                y: (m.m01 + m.m10) / s,
                z: (m.m02 + m.m20) / s,
                w: (m.m21 - m.m12) / s,
            };
        }
        if (m.m11 > m.m22) {
            let s : f64 = (2.0 as f64) * ((1.0 as f64) + m.m11 - m.m00 - m.m22).sqrt();
            return DQuat {
                x: (m.m01 + m.m10) / s,
                y: s * (0.25 as f64),
                z: (m.m12 + m.m21) / s,
                w: (m.m02 - m.m20) / s,
            };
        }
        let s : f64 = (2.0 as f64) * ((1.0 as f64) + m.m22 - m.m00 - m.m11).sqrt();
        return DQuat {
            x: (m.m02 + m.m20) / s,
            y: (m.m12 + m.m21) / s,
            z: s * (0.25 as f64),
            w: (m.m10 - m.m01) / s,
        };
    }

    /** The Hamilton product: the rotation `o` followed by this one. */
    pub fn mul(self, o : DQuat) : DQuat {
        return DQuat {
            x: self.w * o.x + self.x * o.w + self.y * o.z - self.z * o.y,
            y: self.w * o.y - self.x * o.z + self.y * o.w + self.z * o.x,
            z: self.w * o.z + self.x * o.y - self.y * o.x + self.z * o.w,
            w: self.w * o.w - self.x * o.x - self.y * o.y - self.z * o.z,
        };
    }

    /** The opposite turn, for a unit quaternion (its inverse, without the division). */
    pub fn conjugate(self) : DQuat {
        return DQuat { x: -self.x, y: -self.y, z: -self.z, w: self.w };
    }

    /** The inverse of any non-zero quaternion; the zero quaternion answers the identity. */
    pub fn inverse(self) : DQuat {
        let lenSq : f64 = self.lengthSquared();
        if (!(lenSq > D_Q_TINY)) {
            return DQuat {};
        }
        let k : f64 = (1.0 as f64) / lenSq;
        return DQuat { x: -self.x * k, y: -self.y * k, z: -self.z * k, w: self.w * k };
    }

    /** The four-dimensional dot product; its absolute value is 1 for two equal rotations. */
    pub fn dot(self, o : DQuat) : f64 {
        return self.x * o.x + self.y * o.y + self.z * o.z + self.w * o.w;
    }

    /** The squared length. */
    pub fn lengthSquared(self) : f64 {
        return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w;
    }

    /** The length: 1 for a rotation. */
    pub fn length(self) : f64 {
        return self.lengthSquared().sqrt();
    }

    /** The same rotation with length 1 again; a zero quaternion answers the identity. */
    pub fn normalized(self) : DQuat {
        let lenSq : f64 = self.lengthSquared();
        if (!(lenSq > D_Q_TINY)) {
            return DQuat {};
        }
        let k : f64 = (1.0 as f64) / lenSq.sqrt();
        return DQuat { x: self.x * k, y: self.y * k, z: self.z * k, w: self.w * k };
    }

    /** The vector `v` rotated by this unit quaternion. */
    pub fn rotate(self, v : DVec3) : DVec3 {
        let u : DVec3 = DVec3 { x: self.x, y: self.y, z: self.z };
        let t : DVec3 = u.cross(v).scale(2.0);
        return v.plus(t.scale(self.w)).plus(u.cross(t));
    }

    /** The angle of the turn in radians, `0..2*pi`. */
    pub fn angle(self) : f64 {
        return (2.0 as f64) * acosD(clampD(self.w, -1.0, 1.0));
    }

    /** The axis of the turn; the +X axis for the identity, which has none. */
    pub fn axis(self) : DVec3 {
        let v : DVec3 = DVec3 { x: self.x, y: self.y, z: self.z };
        return v.normalizedOr(DVec3::unitX());
    }

    /** The turn `t` of the way from this rotation to `o` along the shortest great arc, at constant speed. */
    pub fn slerp(self, o : DQuat, t : f64) : DQuat {
        let mut target : DQuat = o;
        let mut d : f64 = self.dot(o);
        if (d < 0.0) {
            target = DQuat { x: -o.x, y: -o.y, z: -o.z, w: -o.w };
            d = -d;
        }
        if (d > D_Q_NEAR_PARALLEL) {
            return self.nlerp(target, t);
        }
        let theta : f64 = acosD(d);
        let inv : f64 = (1.0 as f64) / sinD(theta);
        let a : f64 = sinD(((1.0 as f64) - t) * theta) * inv;
        let b : f64 = sinD(t * theta) * inv;
        return DQuat {
            x: self.x * a + target.x * b,
            y: self.y * a + target.y * b,
            z: self.z * a + target.z * b,
            w: self.w * a + target.w * b,
        };
    }

    /** The straight blend of two rotations, renormalised: cheaper than `slerp`, with uneven speed. */
    pub fn nlerp(self, o : DQuat, t : f64) : DQuat {
        let s : f64 = (1.0 as f64) - t;
        return DQuat {
            x: self.x * s + o.x * t,
            y: self.y * s + o.y * t,
            z: self.z * s + o.z * t,
            w: self.w * s + o.w * t,
        }.normalized();
    }

    /** This rotation as a 3x3 matrix. */
    pub fn toMat3(self) : DMat3 {
        let xx : f64 = self.x * self.x;
        let yy : f64 = self.y * self.y;
        let zz : f64 = self.z * self.z;
        let xy : f64 = self.x * self.y;
        let xz : f64 = self.x * self.z;
        let yz : f64 = self.y * self.z;
        let wx : f64 = self.w * self.x;
        let wy : f64 = self.w * self.y;
        let wz : f64 = self.w * self.z;
        let two : f64 = 2.0;
        return DMat3 {
            m00: (1.0 as f64) - two * (yy + zz),
            m01: two * (xy - wz),
            m02: two * (xz + wy),
            m10: two * (xy + wz),
            m11: (1.0 as f64) - two * (xx + zz),
            m12: two * (yz - wx),
            m20: two * (xz - wy),
            m21: two * (yz + wx),
            m22: (1.0 as f64) - two * (xx + yy),
        };
    }

    /** This rotation as a 4x4 matrix with no translation. */
    pub fn toMat4(self) : DMat4 {
        return DMat4::fromMat3(self.toMat3());
    }

    /** Whether the two quaternions are the same rotation to within `tolerance`; `q` and `-q` are the same. */
    pub fn sameRotation(self, o : DQuat, tolerance : f64) : bool {
        return absD(self.dot(o)) >= (1.0 as f64) - tolerance;
    }

    /** Whether every component differs from `o`'s by at most `tolerance`. */
    pub fn approxEq(self, o : DQuat, tolerance : f64) : bool {
        return approxEqWithinD(self.x, o.x, tolerance) && approxEqWithinD(self.y, o.y, tolerance)
            && approxEqWithinD(self.z, o.z, tolerance)
            && approxEqWithinD(self.w, o.w, tolerance);
    }

    /** The heading of this rotation: the angle about +Y of where it sends -Z, from `-pi` to `pi`. */
    pub fn yaw(self) : f64 {
        let forward : DVec3 = self.rotate(DVec3 { x: 0.0, y: 0.0, z: -1.0 });
        return atan2D(-forward.x, -forward.z);
    }
}

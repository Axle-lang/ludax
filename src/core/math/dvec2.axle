// dvec2 — a two-component f64 vector.
// Generated from vec2.axle by tools/gen_math_f64.sh: edit the original, not this file.
//
// A point or direction in the plane (screen space, UI, 2D gameplay). A `struct`, so a value: copied on
// assignment, stored inline in arrays, never aliased. Axle has no operator overloading, so every operation is
// a named method (`a.plus(b)`); the forms that change the vector they are called on end in `In` and are meant
// for hot loops (`a.addIn(b)` is `a += b`). Methods that divide check first: float division by zero traps.

use crate::core::math::scalar::{minD, maxD, lerpD, approxEqWithinD};

// Below this squared length a vector has no usable direction.
const D_V2_TINY : f64 = 0.00000000000000000001;

/** A point or direction in the plane. */
pub struct DVec2 {
    /** Horizontal component. */
    pub x : f64 = 0.0;

    /** Vertical component. */
    pub y : f64 = 0.0;

    /** A vector from its components. */
    pub static fn make(x : f64, y : f64) : DVec2 {
        return DVec2 { x: x, y: y };
    }

    /** The origin. */
    pub static fn zero() : DVec2 {
        return DVec2 { x: 0.0, y: 0.0 };
    }

    /** The same value in both components. */
    pub static fn splat(v : f64) : DVec2 {
        return DVec2 { x: v, y: v };
    }

    /** The +X axis. */
    pub static fn unitX() : DVec2 {
        return DVec2 { x: 1.0, y: 0.0 };
    }

    /** The +Y axis. */
    pub static fn unitY() : DVec2 {
        return DVec2 { x: 0.0, y: 1.0 };
    }

    /** Component-wise sum. */
    pub fn plus(self, o : DVec2) : DVec2 {
        return DVec2 { x: self.x + o.x, y: self.y + o.y };
    }

    /** Component-wise difference. */
    pub fn minus(self, o : DVec2) : DVec2 {
        return DVec2 { x: self.x - o.x, y: self.y - o.y };
    }

    /** Component-wise product. */
    pub fn times(self, o : DVec2) : DVec2 {
        return DVec2 { x: self.x * o.x, y: self.y * o.y };
    }

    /** This vector multiplied by the number `k`. */
    pub fn scale(self, k : f64) : DVec2 {
        return DVec2 { x: self.x * k, y: self.y * k };
    }

    /** This vector pointing the other way. */
    pub fn negated(self) : DVec2 {
        return DVec2 { x: -self.x, y: -self.y };
    }

    /** The dot product: the cosine of the angle between, times both lengths. */
    pub fn dot(self, o : DVec2) : f64 {
        return self.x * o.x + self.y * o.y;
    }

    /** The z component of the 3D cross product: positive when `o` lies counter-clockwise of this vector. */
    pub fn cross(self, o : DVec2) : f64 {
        return self.x * o.y - self.y * o.x;
    }

    /** This vector turned a quarter turn counter-clockwise. */
    pub fn perp(self) : DVec2 {
        return DVec2 { x: -self.y, y: self.x };
    }

    /** The squared length: cheaper than `length` and enough to compare distances. */
    pub fn lengthSquared(self) : f64 {
        return self.x * self.x + self.y * self.y;
    }

    /** The Euclidean length. */
    pub fn length(self) : f64 {
        return self.lengthSquared().sqrt();
    }

    /** The squared distance to `o`. */
    pub fn distanceSquared(self, o : DVec2) : f64 {
        return self.minus(o).lengthSquared();
    }

    /** The distance to `o`. */
    pub fn distance(self, o : DVec2) : f64 {
        return self.minus(o).length();
    }

    /** The same direction with length 1; the zero vector stays zero. */
    pub fn normalized(self) : DVec2 {
        return self.normalizedOr(DVec2::zero());
    }

    /** The same direction with length 1, or `fallback` when this vector is too short to have one. */
    pub fn normalizedOr(self, fallback : DVec2) : DVec2 {
        let lenSq : f64 = self.lengthSquared();
        if (!(lenSq > D_V2_TINY)) {
            return fallback;
        }
        return self.scale((1.0 as f64) / lenSq.sqrt());
    }

    /** The point `t` of the way from this vector to `o`; `t` is not clamped. */
    pub fn lerp(self, o : DVec2, t : f64) : DVec2 {
        return DVec2 { x: lerpD(self.x, o.x, t), y: lerpD(self.y, o.y, t) };
    }

    /** The smaller of each component pair. */
    pub fn componentMin(self, o : DVec2) : DVec2 {
        return DVec2 { x: minD(self.x, o.x), y: minD(self.y, o.y) };
    }

    /** The larger of each component pair. */
    pub fn componentMax(self, o : DVec2) : DVec2 {
        return DVec2 { x: maxD(self.x, o.x), y: maxD(self.y, o.y) };
    }

    /** Whether every component differs from `o`'s by at most `tolerance`. */
    pub fn approxEq(self, o : DVec2, tolerance : f64) : bool {
        return approxEqWithinD(self.x, o.x, tolerance) && approxEqWithinD(self.y, o.y, tolerance);
    }

    /** Overwrites both components. */
    pub fn set(mut self, x : f64, y : f64) : void {
        self.x = x;
        self.y = y;
    }

    /** `self += o`. */
    pub fn addIn(mut self, o : DVec2) : void {
        self.x = self.x + o.x;
        self.y = self.y + o.y;
    }

    /** `self -= o`. */
    pub fn subIn(mut self, o : DVec2) : void {
        self.x = self.x - o.x;
        self.y = self.y - o.y;
    }

    /** `self *= k`. */
    pub fn scaleIn(mut self, k : f64) : void {
        self.x = self.x * k;
        self.y = self.y * k;
    }

    /** `self += o * k`: the step of an integrator. */
    pub fn mulAddIn(mut self, o : DVec2, k : f64) : void {
        self.x = self.x + o.x * k;
        self.y = self.y + o.y * k;
    }

    /** Scales this vector to length 1; the zero vector stays zero. */
    pub fn normalizeIn(mut self) : void {
        let lenSq : f64 = self.x * self.x + self.y * self.y;
        if (!(lenSq > D_V2_TINY)) {
            self.x = 0.0;
            self.y = 0.0;
            return;
        }
        let inv : f64 = (1.0 as f64) / lenSq.sqrt();
        self.x = self.x * inv;
        self.y = self.y * inv;
    }
}

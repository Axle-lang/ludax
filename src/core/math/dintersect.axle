// dintersect — rays and shapes against each other.
// Generated from intersect.axle by tools/gen_math_f64.sh: edit the original, not this file.
//
// Every test answers with a `DRayHit` or a plain `bool`; nothing here allocates or divides by a value that
// may be zero. Touching counts as overlapping. A ray's `t` is measured in lengths of its direction vector,
// so it is a distance for a unit direction. A ray that starts inside a solid shape hits it at `t = 0`.

use crate::core::math::dgeom::{DAabb, DPlane, DRay, DSphere};
use crate::core::math::dvec3::DVec3;
use crate::core::math::scalar::{HUGE_D, absD, minD, maxD};

// Below this a ray is treated as parallel to a slab or a plane, and a determinant as zero.
const D_X_TINY : f64 = 0.0000000001;

/** The outcome of a ray test. */
pub struct DRayHit {
    /** Whether the ray touched the shape. */
    pub hit : bool = false;

    /** How far along the ray the first contact is; meaningless when there was no hit. */
    pub t : f64 = 0.0;

    /** For a triangle: the barycentric weight of the second vertex at the contact. */
    pub u : f64 = 0.0;

    /** For a triangle: the barycentric weight of the third vertex at the contact. */
    pub v : f64 = 0.0;

    /** A miss. */
    pub static fn miss() : DRayHit {
        return DRayHit {};
    }

    /** A hit at distance `t`. */
    pub static fn at(t : f64) : DRayHit {
        return DRayHit { hit: true, t: t };
    }
}

/** Where a ray meets a plane, from either side; a ray parallel to the plane or pointing away misses. */
pub fn rayPlaneD(ray : DRay, plane : DPlane) : DRayHit {
    let denom : f64 = plane.normal.dot(ray.direction);
    if (absD(denom) < D_X_TINY) {
        return DRayHit::miss();
    }
    let t : f64 = -plane.signedDistance(ray.origin) / denom;
    if (t < 0.0) {
        return DRayHit::miss();
    }
    return DRayHit::at(t);
}

// What is left of a ray after some axis slabs of a box: the interval `lo..hi`, or nothing (`alive` false).
struct DRaySlab {
    lo    : f64 = 0.0;
    hi    : f64 = 0.0;
    alive : bool = true;
}

fn rayClipSlabD(slab : DRaySlab, origin : f64, direction : f64, boxMin : f64, boxMax : f64) : DRaySlab {
    if (absD(direction) < D_X_TINY) {
        if (origin < boxMin || origin > boxMax) {
            return DRaySlab { lo: slab.lo, hi: slab.hi, alive: false };
        }
        return slab;
    }
    let inv : f64 = (1.0 as f64) / direction;
    let mut near : f64 = (boxMin - origin) * inv;
    let mut far : f64 = (boxMax - origin) * inv;
    if (near > far) {
        let swap : f64 = near;
        near = far;
        far = swap;
    }
    let lo : f64 = maxD(slab.lo, near);
    let hi : f64 = minD(slab.hi, far);
    return DRaySlab { lo: lo, hi: hi, alive: lo <= hi };
}

/** Where a ray enters a box (`t = 0` when it starts inside); an empty box is never hit. */
pub fn rayAabbD(ray : DRay, bounds : DAabb) : DRayHit {
    if (bounds.isEmpty()) {
        return DRayHit::miss();
    }
    let mut slab : DRaySlab = DRaySlab { lo: 0.0, hi: HUGE_D, alive: true };
    slab = rayClipSlabD(slab, ray.origin.x, ray.direction.x, bounds.min.x, bounds.max.x);
    if (slab.alive) {
        slab = rayClipSlabD(slab, ray.origin.y, ray.direction.y, bounds.min.y, bounds.max.y);
    }
    if (slab.alive) {
        slab = rayClipSlabD(slab, ray.origin.z, ray.direction.z, bounds.min.z, bounds.max.z);
    }
    if (!slab.alive) {
        return DRayHit::miss();
    }
    return DRayHit::at(slab.lo);
}

/** Where a ray enters a ball (`t = 0` when it starts inside); a zero direction or a ball behind misses. */
pub fn raySphereD(ray : DRay, sphere : DSphere) : DRayHit {
    let a : f64 = ray.direction.lengthSquared();
    if (!(a > D_X_TINY)) {
        return DRayHit::miss();
    }
    let oc : DVec3 = ray.origin.minus(sphere.center);
    let b : f64 = oc.dot(ray.direction);
    let c : f64 = oc.lengthSquared() - sphere.radius * sphere.radius;
    let disc : f64 = b * b - a * c;
    if (disc < 0.0) {
        return DRayHit::miss();
    }
    let root : f64 = disc.sqrt();
    let exit : f64 = (-b + root) / a;
    if (exit < 0.0) {
        return DRayHit::miss();
    }
    return DRayHit::at(maxD(0.0, (-b - root) / a));
}

/**
 * Where a ray meets the triangle `a`, `b`, `c` (Moeller-Trumbore), with the barycentric weights `u` of
 * `b` and `v` of `c`. With `cullBackFaces` a triangle seen from behind (clockwise) is missed. A ray
 * parallel to the triangle, or a degenerate triangle, misses.
 */
pub fn rayTriangleD(ray : DRay, a : DVec3, b : DVec3, c : DVec3, cullBackFaces : bool) : DRayHit {
    let e1 : DVec3 = b.minus(a);
    let e2 : DVec3 = c.minus(a);
    let p : DVec3 = ray.direction.cross(e2);
    let det : f64 = e1.dot(p);
    if (cullBackFaces && det < D_X_TINY) {
        return DRayHit::miss();
    }
    if (absD(det) < D_X_TINY) {
        return DRayHit::miss();
    }
    let inv : f64 = (1.0 as f64) / det;
    let from : DVec3 = ray.origin.minus(a);
    let u : f64 = from.dot(p) * inv;
    if (u < 0.0 || u > 1.0) {
        return DRayHit::miss();
    }
    let q : DVec3 = from.cross(e1);
    let v : f64 = ray.direction.dot(q) * inv;
    if (v < 0.0 || u + v > 1.0) {
        return DRayHit::miss();
    }
    let t : f64 = e2.dot(q) * inv;
    if (t < 0.0) {
        return DRayHit::miss();
    }
    return DRayHit { hit: true, t: t, u: u, v: v };
}

/** Whether two boxes share a point; boxes that only touch overlap, an empty box overlaps nothing. */
pub fn aabbOverlapD(a : DAabb, b : DAabb) : bool {
    if (a.isEmpty() || b.isEmpty()) {
        return false;
    }
    let overX : bool = a.min.x <= b.max.x && a.max.x >= b.min.x;
    let overY : bool = a.min.y <= b.max.y && a.max.y >= b.min.y;
    let overZ : bool = a.min.z <= b.max.z && a.max.z >= b.min.z;
    return overX && overY && overZ;
}

/** Whether two balls share a point; balls that only touch overlap. */
pub fn sphereOverlapD(a : DSphere, b : DSphere) : bool {
    let reach : f64 = a.radius + b.radius;
    return a.center.distanceSquared(b.center) <= reach * reach;
}

/** Whether a ball and a box share a point. */
pub fn sphereAabbOverlapD(s : DSphere, b : DAabb) : bool {
    if (b.isEmpty()) {
        return false;
    }
    return s.center.distanceSquared(b.closestPoint(s.center)) <= s.radius * s.radius;
}

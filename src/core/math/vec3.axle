// vec3 — a three-component f32 vector.
//
// A point, direction or colour in space. A `struct`, so a value: copied on assignment, stored inline in
// arrays, never aliased. Axle has no operator overloading, so every operation is a named method
// (`a.plus(b)`); the forms that change the vector they are called on end in `In` and are meant for hot loops
// (`a.addIn(b)` is `a += b`). Methods that divide check first: float division by zero traps in Axle.
//
// Space is right-handed with +Y up; `cross` follows the right-hand rule.

use crate::core::math::scalar::{min, max, abs, lerp, approxEqWithin};

// Below this squared length a vector has no usable direction.
const V3_TINY : f32 = 0.00000000000000000001;

/** A point or direction in space. */
pub struct Vec3 {
    /** X component. */
    pub x : f32 = 0.0;

    /** Y component. */
    pub y : f32 = 0.0;

    /** Z component. */
    pub z : f32 = 0.0;

    /** A vector from its components. */
    pub static fn make(x : f32, y : f32, z : f32) : Vec3 {
        return Vec3 { x: x, y: y, z: z };
    }

    /** The origin. */
    pub static fn zero() : Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
    }

    /** The same value in all three components. */
    pub static fn splat(v : f32) : Vec3 {
        return Vec3 { x: v, y: v, z: v };
    }

    /** The +X axis. */
    pub static fn unitX() : Vec3 {
        return Vec3 { x: 1.0, y: 0.0, z: 0.0 };
    }

    /** The +Y axis: up. */
    pub static fn unitY() : Vec3 {
        return Vec3 { x: 0.0, y: 1.0, z: 0.0 };
    }

    /** The +Z axis. */
    pub static fn unitZ() : Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 1.0 };
    }

    /** Component-wise sum. */
    pub fn plus(self, o : Vec3) : Vec3 {
        return Vec3 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z };
    }

    /** Component-wise difference. */
    pub fn minus(self, o : Vec3) : Vec3 {
        return Vec3 { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z };
    }

    /** Component-wise product: a colour tint or a non-uniform scale. */
    pub fn times(self, o : Vec3) : Vec3 {
        return Vec3 { x: self.x * o.x, y: self.y * o.y, z: self.z * o.z };
    }

    /** This vector multiplied by the number `k`. */
    pub fn scale(self, k : f32) : Vec3 {
        return Vec3 { x: self.x * k, y: self.y * k, z: self.z * k };
    }

    /** This vector pointing the other way. */
    pub fn negated(self) : Vec3 {
        return Vec3 { x: -self.x, y: -self.y, z: -self.z };
    }

    /** The dot product: the cosine of the angle between, times both lengths. */
    pub fn dot(self, o : Vec3) : f32 {
        return self.x * o.x + self.y * o.y + self.z * o.z;
    }

    /** The cross product: perpendicular to both, right-handed, as long as the parallelogram's area. */
    pub fn cross(self, o : Vec3) : Vec3 {
        return Vec3 {
            x: self.y * o.z - self.z * o.y,
            y: self.z * o.x - self.x * o.z,
            z: self.x * o.y - self.y * o.x,
        };
    }

    /** The squared length: cheaper than `length` and enough to compare distances. */
    pub fn lengthSquared(self) : f32 {
        return self.x * self.x + self.y * self.y + self.z * self.z;
    }

    /** The Euclidean length. */
    pub fn length(self) : f32 {
        return self.lengthSquared().sqrt();
    }

    /** The squared distance to `o`. */
    pub fn distanceSquared(self, o : Vec3) : f32 {
        return self.minus(o).lengthSquared();
    }

    /** The distance to `o`. */
    pub fn distance(self, o : Vec3) : f32 {
        return self.minus(o).length();
    }

    /** The same direction with length 1; the zero vector stays zero. */
    pub fn normalized(self) : Vec3 {
        return self.normalizedOr(Vec3::zero());
    }

    /** The same direction with length 1, or `fallback` when this vector is too short to have one. */
    pub fn normalizedOr(self, fallback : Vec3) : Vec3 {
        let lenSq : f32 = self.lengthSquared();
        if (!(lenSq > V3_TINY)) {
            return fallback;
        }
        return self.scale((1.0 as f32) / lenSq.sqrt());
    }

    /** The point `t` of the way from this vector to `o`; `t` is not clamped. */
    pub fn lerp(self, o : Vec3, t : f32) : Vec3 {
        return Vec3 { x: lerp(self.x, o.x, t), y: lerp(self.y, o.y, t), z: lerp(self.z, o.z, t) };
    }

    /** The smaller of each component pair. */
    pub fn componentMin(self, o : Vec3) : Vec3 {
        return Vec3 { x: min(self.x, o.x), y: min(self.y, o.y), z: min(self.z, o.z) };
    }

    /** The larger of each component pair. */
    pub fn componentMax(self, o : Vec3) : Vec3 {
        return Vec3 { x: max(self.x, o.x), y: max(self.y, o.y), z: max(self.z, o.z) };
    }

    /** The largest component. */
    pub fn maxComponent(self) : f32 {
        return max(self.x, max(self.y, self.z));
    }

    /** The absolute value of each component. */
    pub fn abs(self) : Vec3 {
        return Vec3 { x: abs(self.x), y: abs(self.y), z: abs(self.z) };
    }

    /** This vector mirrored about the plane whose unit normal is `normal` (a bounce off it). */
    pub fn reflect(self, normal : Vec3) : Vec3 {
        return self.minus(normal.scale((2.0 as f32) * self.dot(normal)));
    }

    /** The part of this vector that lies along `onto`; zero when `onto` is the zero vector. */
    pub fn projectOn(self, onto : Vec3) : Vec3 {
        let lenSq : f32 = onto.lengthSquared();
        if (!(lenSq > V3_TINY)) {
            return Vec3::zero();
        }
        return onto.scale(self.dot(onto) / lenSq);
    }

    /** Some unit vector perpendicular to this one, for building a frame around a direction. */
    pub fn anyPerpendicular(self) : Vec3 {
        let ax : f32 = abs(self.x);
        let ay : f32 = abs(self.y);
        let az : f32 = abs(self.z);
        if (ax <= ay && ax <= az) {
            return self.cross(Vec3::unitX()).normalized();
        }
        if (ay <= az) {
            return self.cross(Vec3::unitY()).normalized();
        }
        return self.cross(Vec3::unitZ()).normalized();
    }

    /** Whether every component differs from `o`'s by at most `tolerance`. */
    pub fn approxEq(self, o : Vec3, tolerance : f32) : bool {
        return approxEqWithin(self.x, o.x, tolerance) && approxEqWithin(self.y, o.y, tolerance)
            && approxEqWithin(self.z, o.z, tolerance);
    }

    /** Whether no component is infinite or not-a-number. */
    pub fn isFinite(self) : bool {
        return self.x.isFinite() && self.y.isFinite() && self.z.isFinite();
    }

    /** Overwrites all three components. */
    pub fn set(mut self, x : f32, y : f32, z : f32) : void {
        self.x = x;
        self.y = y;
        self.z = z;
    }

    /** `self += o`. */
    pub fn addIn(mut self, o : Vec3) : void {
        self.x = self.x + o.x;
        self.y = self.y + o.y;
        self.z = self.z + o.z;
    }

    /** `self -= o`. */
    pub fn subIn(mut self, o : Vec3) : void {
        self.x = self.x - o.x;
        self.y = self.y - o.y;
        self.z = self.z - o.z;
    }

    /** `self *= k`. */
    pub fn scaleIn(mut self, k : f32) : void {
        self.x = self.x * k;
        self.y = self.y * k;
        self.z = self.z * k;
    }

    /** `self += o * k`: the step of an integrator. */
    pub fn mulAddIn(mut self, o : Vec3, k : f32) : void {
        self.x = self.x + o.x * k;
        self.y = self.y + o.y * k;
        self.z = self.z + o.z * k;
    }

    /** Points this vector the other way. */
    pub fn negateIn(mut self) : void {
        self.x = -self.x;
        self.y = -self.y;
        self.z = -self.z;
    }

    /** `self = self x o`. */
    pub fn crossIn(mut self, o : Vec3) : void {
        let cx : f32 = self.y * o.z - self.z * o.y;
        let cy : f32 = self.z * o.x - self.x * o.z;
        let cz : f32 = self.x * o.y - self.y * o.x;
        self.x = cx;
        self.y = cy;
        self.z = cz;
    }

    /** Scales this vector to length 1; the zero vector stays zero. */
    pub fn normalizeIn(mut self) : void {
        let lenSq : f32 = self.x * self.x + self.y * self.y + self.z * self.z;
        if (!(lenSq > V3_TINY)) {
            self.x = 0.0;
            self.y = 0.0;
            self.z = 0.0;
            return;
        }
        let inv : f32 = (1.0 as f32) / lenSq.sqrt();
        self.x = self.x * inv;
        self.y = self.y * inv;
        self.z = self.z * inv;
    }
}

// dvec4 — a four-component f64 vector.
// Generated from vec4.axle by tools/gen_math_f64.sh: edit the original, not this file.
//
// A homogeneous point (`w` = 1), a direction (`w` = 0), a clip-space position, or an RGBA colour. A `struct`,
// so a value; every operation is a named method, and the in-place forms end in `In`.

use crate::core::math::dvec3::DVec3;
use crate::core::math::scalar::{lerpD, approxEqWithinD};

// Below this squared length a vector has no usable direction.
const D_V4_TINY : f64 = 0.00000000000000000001;

/** A four-component vector. */
pub struct DVec4 {
    /** X component. */
    pub x : f64 = 0.0;

    /** Y component. */
    pub y : f64 = 0.0;

    /** Z component. */
    pub z : f64 = 0.0;

    /** W component: 1 for a point, 0 for a direction. */
    pub w : f64 = 0.0;

    /** A vector from its components. */
    pub static fn make(x : f64, y : f64, z : f64, w : f64) : DVec4 {
        return DVec4 { x: x, y: y, z: z, w: w };
    }

    /** The zero vector. */
    pub static fn zero() : DVec4 {
        return DVec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
    }

    /** A 3D vector extended with `w`. */
    pub static fn fromVec3(v : DVec3, w : f64) : DVec4 {
        return DVec4 { x: v.x, y: v.y, z: v.z, w: w };
    }

    /** The first three components. */
    pub fn xyz(self) : DVec3 {
        return DVec3 { x: self.x, y: self.y, z: self.z };
    }

    /** Component-wise sum. */
    pub fn plus(self, o : DVec4) : DVec4 {
        return DVec4 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z, w: self.w + o.w };
    }

    /** Component-wise difference. */
    pub fn minus(self, o : DVec4) : DVec4 {
        return DVec4 { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z, w: self.w - o.w };
    }

    /** Component-wise product. */
    pub fn times(self, o : DVec4) : DVec4 {
        return DVec4 { x: self.x * o.x, y: self.y * o.y, z: self.z * o.z, w: self.w * o.w };
    }

    /** This vector multiplied by the number `k`. */
    pub fn scale(self, k : f64) : DVec4 {
        return DVec4 { x: self.x * k, y: self.y * k, z: self.z * k, w: self.w * k };
    }

    /** The dot product. */
    pub fn dot(self, o : DVec4) : f64 {
        return self.x * o.x + self.y * o.y + self.z * o.z + self.w * o.w;
    }

    /** The squared length. */
    pub fn lengthSquared(self) : f64 {
        return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w;
    }

    /** The Euclidean length. */
    pub fn length(self) : f64 {
        return self.lengthSquared().sqrt();
    }

    /** The same direction with length 1; the zero vector stays zero. */
    pub fn normalized(self) : DVec4 {
        let lenSq : f64 = self.lengthSquared();
        if (!(lenSq > D_V4_TINY)) {
            return DVec4::zero();
        }
        return self.scale((1.0 as f64) / lenSq.sqrt());
    }

    /** The point `t` of the way from this vector to `o`; `t` is not clamped. */
    pub fn lerp(self, o : DVec4, t : f64) : DVec4 {
        return DVec4 {
            x: lerpD(self.x, o.x, t),
            y: lerpD(self.y, o.y, t),
            z: lerpD(self.z, o.z, t),
            w: lerpD(self.w, o.w, t),
        };
    }

    /** Whether every component differs from `o`'s by at most `tolerance`. */
    pub fn approxEq(self, o : DVec4, tolerance : f64) : bool {
        return approxEqWithinD(self.x, o.x, tolerance) && approxEqWithinD(self.y, o.y, tolerance)
            && approxEqWithinD(self.z, o.z, tolerance)
            && approxEqWithinD(self.w, o.w, tolerance);
    }

    /** Overwrites all four components. */
    pub fn set(mut self, x : f64, y : f64, z : f64, w : f64) : void {
        self.x = x;
        self.y = y;
        self.z = z;
        self.w = w;
    }

    /** `self += o`. */
    pub fn addIn(mut self, o : DVec4) : void {
        self.x = self.x + o.x;
        self.y = self.y + o.y;
        self.z = self.z + o.z;
        self.w = self.w + o.w;
    }

    /** `self -= o`. */
    pub fn subIn(mut self, o : DVec4) : void {
        self.x = self.x - o.x;
        self.y = self.y - o.y;
        self.z = self.z - o.z;
        self.w = self.w - o.w;
    }

    /** `self *= k`. */
    pub fn scaleIn(mut self, k : f64) : void {
        self.x = self.x * k;
        self.y = self.y * k;
        self.z = self.z * k;
        self.w = self.w * k;
    }

    /** `self += o * k`. */
    pub fn mulAddIn(mut self, o : DVec4, k : f64) : void {
        self.x = self.x + o.x * k;
        self.y = self.y + o.y * k;
        self.z = self.z + o.z * k;
        self.w = self.w + o.w * k;
    }
}

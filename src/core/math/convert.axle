// convert — between the f64 world and the f32 renderer.
//
// Positions in a large world are f64; the GPU and the hot loops are f32. The two meet here: the one safe
// way down is to subtract a nearby origin (usually the camera) in f64 first, so that the f32 result is
// small and keeps its precision. Narrowing a far-away absolute position directly would lose centimetres at
// ten kilometres from the origin, which is why `relativeVec3` exists and a bare `narrowVec3` is for
// local values only.

use crate::core::math::dmat4::DMat4;
use crate::core::math::dquat::DQuat;
use crate::core::math::dvec3::DVec3;
use crate::core::math::mat4::Mat4;
use crate::core::math::quat::Quat;
use crate::core::math::vec3::Vec3;

/** The f64 vector with the same components. Exact. */
pub fn widenVec3(v : Vec3) : DVec3 {
    return DVec3 { x: v.x as f64, y: v.y as f64, z: v.z as f64 };
}

/** The f32 vector nearest to `v`. Only for values already small (local offsets, directions). */
pub fn narrowVec3(v : DVec3) : Vec3 {
    return Vec3 { x: v.x as f32, y: v.y as f32, z: v.z as f32 };
}

/** Where `world` lies relative to `origin`: subtracted in f64, then narrowed, so it stays precise. */
pub fn relativeVec3(world : DVec3, origin : DVec3) : Vec3 {
    return narrowVec3(world.minus(origin));
}

/** The f64 quaternion with the same components. Exact. */
pub fn widenQuat(q : Quat) : DQuat {
    return DQuat { x: q.x as f64, y: q.y as f64, z: q.z as f64, w: q.w as f64 };
}

/** The f32 quaternion nearest to `q`, renormalised. */
pub fn narrowQuat(q : DQuat) : Quat {
    return Quat { x: q.x as f32, y: q.y as f32, z: q.z as f32, w: q.w as f32 }.normalized();
}

/** The f32 matrix nearest to `m`; for a model matrix already made relative to the camera. */
pub fn narrowMat4(m : DMat4) : Mat4 {
    return Mat4 {
        m00: m.m00 as f32,
        m01: m.m01 as f32,
        m02: m.m02 as f32,
        m03: m.m03 as f32,
        m10: m.m10 as f32,
        m11: m.m11 as f32,
        m12: m.m12 as f32,
        m13: m.m13 as f32,
        m20: m.m20 as f32,
        m21: m.m21 as f32,
        m22: m.m22 as f32,
        m23: m.m23 as f32,
        m30: m.m30 as f32,
        m31: m.m31 as f32,
        m32: m.m32 as f32,
        m33: m.m33 as f32,
    };
}

/** The f64 matrix with the same fields. Exact. */
pub fn widenMat4(m : Mat4) : DMat4 {
    return DMat4 {
        m00: m.m00 as f64,
        m01: m.m01 as f64,
        m02: m.m02 as f64,
        m03: m.m03 as f64,
        m10: m.m10 as f64,
        m11: m.m11 as f64,
        m12: m.m12 as f64,
        m13: m.m13 as f64,
        m20: m.m20 as f64,
        m21: m.m21 as f64,
        m22: m.m22 as f64,
        m23: m.m23 as f64,
        m30: m.m30 as f64,
        m31: m.m31 as f64,
        m32: m.m32 as f64,
        m33: m.m33 as f64,
    };
}

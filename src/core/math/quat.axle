// quat — a unit quaternion: a rotation in three dimensions.
//
// Four f32 fields, a value type. Rotations compose with `mul` (Hamilton product), interpolate with `slerp`,
// and convert to `Mat3`/`Mat4`; the conversion agrees with `Mat4::rotationX/Y/Z` exactly in convention:
// counter-clockwise when looking from the positive axis towards the origin, right-handed, +Y up.
//
// `a.mul(b)` applies `b` first and then `a`, the same order as matrix multiplication. Keep quaternions
// normalised: drift from repeated `mul` is removed with `normalized`, and the methods that need a unit
// quaternion assume it rather than pay for a square root each call.

use crate::core::math::mat3::Mat3;
use crate::core::math::mat4::Mat4;
use crate::core::math::scalar::{approxEqWithin, abs, clamp};
use crate::core::math::trig::{sin, cos, acos, atan2};
use crate::core::math::vec3::Vec3;

// Below this squared length a quaternion has no usable rotation.
const Q_TINY : f32 = 0.00000000000000000001;

// Below this dot product two directions are antiparallel and their rotation axis is undefined; any
// perpendicular axis does for the half turn.
const Q_ANTIPARALLEL : f32 = -0.999999;

// Beyond this dot product two rotations are so close that slerp's sine would vanish; a lerp takes over.
const Q_NEAR_PARALLEL : f32 = 0.9995;

/** A rotation. Defaults to the identity (no rotation). */
pub struct Quat {
    /** X component of the vector part. */
    pub x : f32 = 0.0;

    /** Y component of the vector part. */
    pub y : f32 = 0.0;

    /** Z component of the vector part. */
    pub z : f32 = 0.0;

    /** The scalar part: the cosine of half the angle. */
    pub w : f32 = 1.0;

    /** The rotation that does nothing. */
    pub static fn identity() : Quat {
        return Quat {};
    }

    /** A quaternion from its four components, as given (not normalised). */
    pub static fn make(x : f32, y : f32, z : f32, w : f32) : Quat {
        return Quat { x: x, y: y, z: z, w: w };
    }

    /** The turn of `radians` about `axis`, counter-clockwise seen from the tip; a zero axis: identity. */
    pub static fn fromAxisAngle(axis : Vec3, radians : f32) : Quat {
        let unit : Vec3 = axis.normalized();
        if (unit.lengthSquared() == 0.0) {
            return Quat {};
        }
        let half : f32 = radians * (0.5 as f32);
        let s : f32 = sin(half);
        return Quat { x: unit.x * s, y: unit.y * s, z: unit.z * s, w: cos(half) };
    }

    /**
     * The turn made of `yaw` about +Y (heading), then `pitch` about the heading's right-hand X axis, then
     * `roll` about the resulting Z axis: `Ry(yaw) * Rx(pitch) * Rz(roll)`. With +Y up and the camera looking
     * down -Z, positive pitch tips the nose up, and positive yaw turns to the left.
     */
    pub static fn fromEuler(yaw : f32, pitch : f32, roll : f32) : Quat {
        let qy : Quat = Quat::fromAxisAngle(Vec3::unitY(), yaw);
        let qx : Quat = Quat::fromAxisAngle(Vec3::unitX(), pitch);
        let qz : Quat = Quat::fromAxisAngle(Vec3::unitZ(), roll);
        return qy.mul(qx).mul(qz);
    }

    /** The shortest rotation taking the direction `from` to the direction `to`; neither must be unit. */
    pub static fn fromTo(from : Vec3, to : Vec3) : Quat {
        let a : Vec3 = from.normalized();
        let b : Vec3 = to.normalized();
        if (a.lengthSquared() == 0.0 || b.lengthSquared() == 0.0) {
            return Quat {};
        }
        let d : f32 = a.dot(b);
        if (d < Q_ANTIPARALLEL) {
            let axis : Vec3 = a.anyPerpendicular();
            return Quat { x: axis.x, y: axis.y, z: axis.z, w: 0.0 };
        }
        let c : Vec3 = a.cross(b);
        return Quat { x: c.x, y: c.y, z: c.z, w: (1.0 as f32) + d }.normalized();
    }

    /** The rotation a 3x3 rotation matrix stands for (it must be proper: orthonormal, determinant 1). */
    pub static fn fromMat3(m : Mat3) : Quat {
        let trace : f32 = m.m00 + m.m11 + m.m22;
        if (trace > 0.0) {
            let s : f32 = (2.0 as f32) * (trace + (1.0 as f32)).sqrt();
            return Quat {
                x: (m.m21 - m.m12) / s,
                y: (m.m02 - m.m20) / s,
                z: (m.m10 - m.m01) / s,
                w: s * (0.25 as f32),
            };
        }
        if (m.m00 > m.m11 && m.m00 > m.m22) {
            let s : f32 = (2.0 as f32) * ((1.0 as f32) + m.m00 - m.m11 - m.m22).sqrt();
            return Quat {
                x: s * (0.25 as f32),
                y: (m.m01 + m.m10) / s,
                z: (m.m02 + m.m20) / s,
                w: (m.m21 - m.m12) / s,
            };
        }
        if (m.m11 > m.m22) {
            let s : f32 = (2.0 as f32) * ((1.0 as f32) + m.m11 - m.m00 - m.m22).sqrt();
            return Quat {
                x: (m.m01 + m.m10) / s,
                y: s * (0.25 as f32),
                z: (m.m12 + m.m21) / s,
                w: (m.m02 - m.m20) / s,
            };
        }
        let s : f32 = (2.0 as f32) * ((1.0 as f32) + m.m22 - m.m00 - m.m11).sqrt();
        return Quat {
            x: (m.m02 + m.m20) / s,
            y: (m.m12 + m.m21) / s,
            z: s * (0.25 as f32),
            w: (m.m10 - m.m01) / s,
        };
    }

    /** The Hamilton product: the rotation `o` followed by this one. */
    pub fn mul(self, o : Quat) : Quat {
        return Quat {
            x: self.w * o.x + self.x * o.w + self.y * o.z - self.z * o.y,
            y: self.w * o.y - self.x * o.z + self.y * o.w + self.z * o.x,
            z: self.w * o.z + self.x * o.y - self.y * o.x + self.z * o.w,
            w: self.w * o.w - self.x * o.x - self.y * o.y - self.z * o.z,
        };
    }

    /** The opposite turn, for a unit quaternion (its inverse, without the division). */
    pub fn conjugate(self) : Quat {
        return Quat { x: -self.x, y: -self.y, z: -self.z, w: self.w };
    }

    /** The inverse of any non-zero quaternion; the zero quaternion answers the identity. */
    pub fn inverse(self) : Quat {
        let lenSq : f32 = self.lengthSquared();
        if (!(lenSq > Q_TINY)) {
            return Quat {};
        }
        let k : f32 = (1.0 as f32) / lenSq;
        return Quat { x: -self.x * k, y: -self.y * k, z: -self.z * k, w: self.w * k };
    }

    /** The four-dimensional dot product; its absolute value is 1 for two equal rotations. */
    pub fn dot(self, o : Quat) : f32 {
        return self.x * o.x + self.y * o.y + self.z * o.z + self.w * o.w;
    }

    /** The squared length. */
    pub fn lengthSquared(self) : f32 {
        return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w;
    }

    /** The length: 1 for a rotation. */
    pub fn length(self) : f32 {
        return self.lengthSquared().sqrt();
    }

    /** The same rotation with length 1 again; a zero quaternion answers the identity. */
    pub fn normalized(self) : Quat {
        let lenSq : f32 = self.lengthSquared();
        if (!(lenSq > Q_TINY)) {
            return Quat {};
        }
        let k : f32 = (1.0 as f32) / lenSq.sqrt();
        return Quat { x: self.x * k, y: self.y * k, z: self.z * k, w: self.w * k };
    }

    /** The vector `v` rotated by this unit quaternion. */
    pub fn rotate(self, v : Vec3) : Vec3 {
        let u : Vec3 = Vec3 { x: self.x, y: self.y, z: self.z };
        let t : Vec3 = u.cross(v).scale(2.0);
        return v.plus(t.scale(self.w)).plus(u.cross(t));
    }

    /** The angle of the turn in radians, `0..2*pi`. */
    pub fn angle(self) : f32 {
        return (2.0 as f32) * acos(clamp(self.w, -1.0, 1.0));
    }

    /** The axis of the turn; the +X axis for the identity, which has none. */
    pub fn axis(self) : Vec3 {
        let v : Vec3 = Vec3 { x: self.x, y: self.y, z: self.z };
        return v.normalizedOr(Vec3::unitX());
    }

    /** The turn `t` of the way from this rotation to `o` along the shortest great arc, at constant speed. */
    pub fn slerp(self, o : Quat, t : f32) : Quat {
        let mut target : Quat = o;
        let mut d : f32 = self.dot(o);
        if (d < 0.0) {
            target = Quat { x: -o.x, y: -o.y, z: -o.z, w: -o.w };
            d = -d;
        }
        if (d > Q_NEAR_PARALLEL) {
            return self.nlerp(target, t);
        }
        let theta : f32 = acos(d);
        let inv : f32 = (1.0 as f32) / sin(theta);
        let a : f32 = sin(((1.0 as f32) - t) * theta) * inv;
        let b : f32 = sin(t * theta) * inv;
        return Quat {
            x: self.x * a + target.x * b,
            y: self.y * a + target.y * b,
            z: self.z * a + target.z * b,
            w: self.w * a + target.w * b,
        };
    }

    /** The straight blend of two rotations, renormalised: cheaper than `slerp`, with uneven speed. */
    pub fn nlerp(self, o : Quat, t : f32) : Quat {
        let s : f32 = (1.0 as f32) - t;
        return Quat {
            x: self.x * s + o.x * t,
            y: self.y * s + o.y * t,
            z: self.z * s + o.z * t,
            w: self.w * s + o.w * t,
        }.normalized();
    }

    /** This rotation as a 3x3 matrix. */
    pub fn toMat3(self) : Mat3 {
        let xx : f32 = self.x * self.x;
        let yy : f32 = self.y * self.y;
        let zz : f32 = self.z * self.z;
        let xy : f32 = self.x * self.y;
        let xz : f32 = self.x * self.z;
        let yz : f32 = self.y * self.z;
        let wx : f32 = self.w * self.x;
        let wy : f32 = self.w * self.y;
        let wz : f32 = self.w * self.z;
        let two : f32 = 2.0;
        return Mat3 {
            m00: (1.0 as f32) - two * (yy + zz),
            m01: two * (xy - wz),
            m02: two * (xz + wy),
            m10: two * (xy + wz),
            m11: (1.0 as f32) - two * (xx + zz),
            m12: two * (yz - wx),
            m20: two * (xz - wy),
            m21: two * (yz + wx),
            m22: (1.0 as f32) - two * (xx + yy),
        };
    }

    /** This rotation as a 4x4 matrix with no translation. */
    pub fn toMat4(self) : Mat4 {
        return Mat4::fromMat3(self.toMat3());
    }

    /** Whether the two quaternions are the same rotation to within `tolerance`; `q` and `-q` are the same. */
    pub fn sameRotation(self, o : Quat, tolerance : f32) : bool {
        return abs(self.dot(o)) >= (1.0 as f32) - tolerance;
    }

    /** Whether every component differs from `o`'s by at most `tolerance`. */
    pub fn approxEq(self, o : Quat, tolerance : f32) : bool {
        return approxEqWithin(self.x, o.x, tolerance) && approxEqWithin(self.y, o.y, tolerance)
            && approxEqWithin(self.z, o.z, tolerance)
            && approxEqWithin(self.w, o.w, tolerance);
    }

    /** The heading of this rotation: the angle about +Y of where it sends -Z, from `-pi` to `pi`. */
    pub fn yaw(self) : f32 {
        let forward : Vec3 = self.rotate(Vec3 { x: 0.0, y: 0.0, z: -1.0 });
        return atan2(-forward.x, -forward.z);
    }
}

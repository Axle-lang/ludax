// scalar — constants and one-number helpers, in f32 and f64.
//
// Every other file of the maths library builds on these. The f32 names are plain (`clamp`, `PI`); the
// f64 twins carry a `D` suffix (`clampD`) or `_D` for constants, because Axle has no overloads.
//
// A bare float literal is an `f64` in Axle, so an f32 expression such as `x * 0.5` does not typecheck. The
// constants below are typed once, here, so the rest of the code does not have to cast.

/** Pi, the ratio of a circle's circumference to its diameter. */
pub const PI : f32 = 3.14159265358979323846;

/** Two pi: one full turn in radians. */
pub const TAU : f32 = 6.28318530717958647692;

/** Half of pi: a quarter turn in radians. */
pub const HALF_PI : f32 = 1.57079632679489661923;

/** Multiply degrees by this to get radians. */
pub const DEG2RAD : f32 = 0.01745329251994329577;

/** Multiply radians by this to get degrees. */
pub const RAD2DEG : f32 = 57.29577951308232087680;

/** The default tolerance of `approxEq`: about ten f32 steps near 1. */
pub const EPSILON : f32 = 0.000001;

/** A number larger than any coordinate, standing in for infinity where a real one is awkward. */
pub const HUGE : f32 = 340282346638528859811704183484516925440.0;

/** `HUGE` as an f64. */
pub const HUGE_D : f64 = 340282346638528859811704183484516925440.0;

/** Pi as an f64. */
pub const PI_D : f64 = 3.14159265358979323846;

/** Two pi as an f64. */
pub const TAU_D : f64 = 6.28318530717958647692;

/** Half of pi as an f64. */
pub const HALF_PI_D : f64 = 1.57079632679489661923;

/** Multiply degrees by this to get radians (f64). */
pub const DEG2RAD_D : f64 = 0.01745329251994329577;

/** Multiply radians by this to get degrees (f64). */
pub const RAD2DEG_D : f64 = 57.29577951308232087680;

/** The default tolerance of `approxEqD`. */
pub const EPSILON_D : f64 = 0.000000000001;

// Beyond this many radians a turn count no longer fits an i64 and the angle has no meaning left.
const SCALAR_WRAP_LIMIT : f64 = 1000000000000000.0;

/** The smaller of two numbers. */
pub fn min(a : f32, b : f32) : f32 {
    if (a < b) {
        return a;
    }
    return b;
}

/** The larger of two numbers. */
pub fn max(a : f32, b : f32) : f32 {
    if (a > b) {
        return a;
    }
    return b;
}

/** The absolute value. */
pub fn abs(a : f32) : f32 {
    if (a < 0.0) {
        return -a;
    }
    return a;
}

/** `-1`, `0` or `1` by the sign of `a`; zero stays zero. */
pub fn sign(a : f32) : f32 {
    if (a > 0.0) {
        return 1.0;
    }
    if (a < 0.0) {
        return -1.0;
    }
    return 0.0;
}

/** `a` limited to the range `lo..hi`. */
pub fn clamp(a : f32, lo : f32, hi : f32) : f32 {
    if (a < lo) {
        return lo;
    }
    if (a > hi) {
        return hi;
    }
    return a;
}

/** `a` limited to the range `0..1`. */
pub fn saturate(a : f32) : f32 {
    return clamp(a, 0.0, 1.0);
}

/** The point `t` of the way from `a` to `b`; `t` is not clamped. */
pub fn lerp(a : f32, b : f32, t : f32) : f32 {
    return a + (b - a) * t;
}

/** Where `v` lies between `a` and `b` as a fraction, 0 at `a` and 1 at `b`; 0 when `a == b`. */
pub fn inverseLerp(a : f32, b : f32, v : f32) : f32 {
    let span : f32 = b - a;
    if (span == 0.0) {
        return 0.0;
    }
    return (v - a) / span;
}

/** Moves `v` from the range `inLo..inHi` to the range `outLo..outHi`, unclamped. */
pub fn remap(v : f32, inLo : f32, inHi : f32, outLo : f32, outHi : f32) : f32 {
    return lerp(outLo, outHi, inverseLerp(inLo, inHi, v));
}

/** Hermite ease from 0 at `edge0` to 1 at `edge1`, flat at both ends; a step when the edges meet. */
pub fn smoothstep(edge0 : f32, edge1 : f32, v : f32) : f32 {
    if (edge0 == edge1) {
        if (v < edge0) {
            return 0.0;
        }
        return 1.0;
    }
    let t : f32 = saturate((v - edge0) / (edge1 - edge0));
    return t * t * ((3.0 as f32) - (2.0 as f32) * t);
}

/** Like `smoothstep` with a quintic whose first and second derivatives vanish at both ends. */
pub fn smootherstep(edge0 : f32, edge1 : f32, v : f32) : f32 {
    if (edge0 == edge1) {
        if (v < edge0) {
            return 0.0;
        }
        return 1.0;
    }
    let t : f32 = saturate((v - edge0) / (edge1 - edge0));
    return t * t * t * (t * (t * (6.0 as f32) - (15.0 as f32)) + (10.0 as f32));
}

/** Whether two numbers differ by at most `tolerance`. */
pub fn approxEqWithin(a : f32, b : f32, tolerance : f32) : bool {
    return abs(a - b) <= tolerance;
}

/** Whether two numbers are equal to within `EPSILON`, absolute below 1 and relative above. */
pub fn approxEq(a : f32, b : f32) : bool {
    let scale : f32 = max(1.0, max(abs(a), abs(b)));
    return abs(a - b) <= EPSILON * scale;
}

/** Whether `a` is neither infinite nor not-a-number. */
pub fn isFinite(a : f32) : bool {
    return a.isFinite();
}

/** `a` degrees expressed in radians. */
pub fn toRadians(a : f32) : f32 {
    return a * DEG2RAD;
}

/** `a` radians expressed in degrees. */
pub fn toDegrees(a : f32) : f32 {
    return a * RAD2DEG;
}

/** An angle brought into `-PI..PI`. */
pub fn wrapAngle(a : f32) : f32 {
    return wrapAngleD(a as f64) as f32;
}

/** The smaller of two numbers (f64). */
pub fn minD(a : f64, b : f64) : f64 {
    if (a < b) {
        return a;
    }
    return b;
}

/** The larger of two numbers (f64). */
pub fn maxD(a : f64, b : f64) : f64 {
    if (a > b) {
        return a;
    }
    return b;
}

/** The absolute value (f64). */
pub fn absD(a : f64) : f64 {
    if (a < 0.0) {
        return -a;
    }
    return a;
}

/** `-1`, `0` or `1` by the sign of `a` (f64). */
pub fn signD(a : f64) : f64 {
    if (a > 0.0) {
        return 1.0;
    }
    if (a < 0.0) {
        return -1.0;
    }
    return 0.0;
}

/** `a` limited to the range `lo..hi` (f64). */
pub fn clampD(a : f64, lo : f64, hi : f64) : f64 {
    if (a < lo) {
        return lo;
    }
    if (a > hi) {
        return hi;
    }
    return a;
}

/** `a` limited to the range `0..1` (f64). */
pub fn saturateD(a : f64) : f64 {
    return clampD(a, 0.0, 1.0);
}

/** The point `t` of the way from `a` to `b` (f64). */
pub fn lerpD(a : f64, b : f64, t : f64) : f64 {
    return a + (b - a) * t;
}

/** Where `v` lies between `a` and `b` as a fraction; 0 when `a == b` (f64). */
pub fn inverseLerpD(a : f64, b : f64, v : f64) : f64 {
    let span : f64 = b - a;
    if (span == 0.0) {
        return 0.0;
    }
    return (v - a) / span;
}

/** Moves `v` from the range `inLo..inHi` to the range `outLo..outHi`, unclamped (f64). */
pub fn remapD(v : f64, inLo : f64, inHi : f64, outLo : f64, outHi : f64) : f64 {
    return lerpD(outLo, outHi, inverseLerpD(inLo, inHi, v));
}

/** Hermite ease from 0 at `edge0` to 1 at `edge1` (f64). */
pub fn smoothstepD(edge0 : f64, edge1 : f64, v : f64) : f64 {
    if (edge0 == edge1) {
        if (v < edge0) {
            return 0.0;
        }
        return 1.0;
    }
    let t : f64 = saturateD((v - edge0) / (edge1 - edge0));
    return t * t * (3.0 - 2.0 * t);
}

/** Whether two numbers differ by at most `tolerance` (f64). */
pub fn approxEqWithinD(a : f64, b : f64, tolerance : f64) : bool {
    return absD(a - b) <= tolerance;
}

/** Whether two numbers are equal to within `EPSILON_D`, absolute below 1 and relative above (f64). */
pub fn approxEqD(a : f64, b : f64) : bool {
    let scale : f64 = maxD(1.0, maxD(absD(a), absD(b)));
    return absD(a - b) <= EPSILON_D * scale;
}

/** `a` degrees expressed in radians (f64). */
pub fn toRadiansD(a : f64) : f64 {
    return a * DEG2RAD_D;
}

/** `a` radians expressed in degrees (f64). */
pub fn toDegreesD(a : f64) : f64 {
    return a * RAD2DEG_D;
}

/** An angle brought into `-PI..PI` (f64). */
pub fn wrapAngleD(a : f64) : f64 {
    if (!a.isFinite() || a > SCALAR_WRAP_LIMIT || a < -SCALAR_WRAP_LIMIT) {
        return 0.0;
    }
    let turns : i64 = (a / TAU_D).round();
    return a - (turns as f64) * TAU_D;
}

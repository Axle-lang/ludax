// transform — translation, rotation and scale as separate parts.
//
// The form in which things are placed in a world and animated: three small parts that can be blended, instead
// of a 4x4 matrix that cannot. `toMat4` produces the matrix a shader needs (`T * R * S`: scale first, then
// rotate, then move, with column vectors).
//
// A TRS triple cannot represent every composition: a rotation under a non-uniform scale shears. `mul` and
// `inverse` are exact whenever the scale involved is uniform (or the rotations are multiples of a quarter
// turn); otherwise they are the usual approximation of a scene graph, and `toMat4` with `inverseAffine` is
// the exact route.

use crate::core::math::mat3::Mat3;
use crate::core::math::mat4::Mat4;
use crate::core::math::quat::Quat;
use crate::core::math::vec3::Vec3;

/** A placement: scale, then rotate, then translate. Defaults to the identity. */
pub struct Transform {
    /** Where the origin of the local space is. */
    pub translation : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** How the local axes are turned. */
    pub rotation : Quat = Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 };

    /** How much the local axes are stretched, per axis. */
    pub scale : Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 };

    /** The placement that changes nothing. */
    pub static fn identity() : Transform {
        return Transform {};
    }

    /** A placement from its three parts. */
    pub static fn make(translation : Vec3, rotation : Quat, scale : Vec3) : Transform {
        return Transform { translation: translation, rotation: rotation, scale: scale };
    }

    /** A placement that only moves. */
    pub static fn fromTranslation(translation : Vec3) : Transform {
        return Transform { translation: translation };
    }

    /** A placement that only turns. */
    pub static fn fromRotation(rotation : Quat) : Transform {
        return Transform { rotation: rotation };
    }

    /** The point `p` of local space placed in the parent space. */
    pub fn transformPoint(self, p : Vec3) : Vec3 {
        return self.rotation.rotate(p.times(self.scale)).plus(self.translation);
    }

    /** The direction `v` of local space placed in the parent space (no translation). */
    pub fn transformVector(self, v : Vec3) : Vec3 {
        return self.rotation.rotate(v.times(self.scale));
    }

    /** The placement of a child that sits at `child` inside this one: `child` is applied first. */
    pub fn mul(self, child : Transform) : Transform {
        return Transform {
            translation: self.transformPoint(child.translation),
            rotation: self.rotation.mul(child.rotation).normalized(),
            scale: self.scale.times(child.scale),
        };
    }

    /**
     * The placement that undoes this one. An axis scaled by zero cannot be undone and stays zero. Exact for
     * a uniform scale; see the file header.
     */
    pub fn inverse(self) : Transform {
        let inverseScale : Vec3 = Vec3 {
            x: Transform::reciprocal(self.scale.x),
            y: Transform::reciprocal(self.scale.y),
            z: Transform::reciprocal(self.scale.z),
        };
        let inverseRotation : Quat = self.rotation.conjugate();
        let moved : Vec3 = inverseRotation.rotate(self.translation.times(inverseScale));
        return Transform { translation: moved.negated(), rotation: inverseRotation, scale: inverseScale };
    }

    // 1 / v, or 0 where v is zero: float division by zero traps in Axle.
    static fn reciprocal(v : f32) : f32 {
        if (v == 0.0) {
            return 0.0;
        }
        return (1.0 as f32) / v;
    }

    /** The blend `t` of the way to `o`: positions and scales straight, rotations along the great arc. */
    pub fn lerp(self, o : Transform, t : f32) : Transform {
        return Transform {
            translation: self.translation.lerp(o.translation, t),
            rotation: self.rotation.slerp(o.rotation, t),
            scale: self.scale.lerp(o.scale, t),
        };
    }

    /** The equivalent 4x4 matrix `T * R * S`. */
    pub fn toMat4(self) : Mat4 {
        let r : Mat3 = self.rotation.toMat3();
        let t : Vec3 = self.translation;
        let k : Vec3 = self.scale;
        return Mat4 {
            m00: r.m00 * k.x,
            m01: r.m01 * k.y,
            m02: r.m02 * k.z,
            m03: t.x,
            m10: r.m10 * k.x,
            m11: r.m11 * k.y,
            m12: r.m12 * k.z,
            m13: t.y,
            m20: r.m20 * k.x,
            m21: r.m21 * k.y,
            m22: r.m22 * k.z,
            m23: t.z,
        };
    }
}

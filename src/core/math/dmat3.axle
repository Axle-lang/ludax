// dmat3 — a 3x3 f64 matrix: rotations, scales and normal transforms.
// Generated from mat3.axle by tools/gen_math_f64.sh: edit the original, not this file.
//
// Nine named fields, a value type. Same conventions as `mat4`: `mRC` is row R, column C; column vectors
// (`v' = M * v`); right-handed with +Y up. A rotation from a quaternion lives in `quat` (`toMat3`).

use crate::core::math::dvec3::DVec3;
use crate::core::math::scalar::{absD, approxEqWithinD};
use crate::core::math::trig::{sinD, cosD};

// Below this a determinant is treated as zero: the matrix has no inverse.
const D_M3_TINY : f64 = 0.000000000000000000000000000001;

/** A 3x3 matrix. Defaults to the identity. */
pub struct DMat3 {
    /** Row 0, column 0. */
    pub m00 : f64 = 1.0;

    /** Row 0, column 1. */
    pub m01 : f64 = 0.0;

    /** Row 0, column 2. */
    pub m02 : f64 = 0.0;

    /** Row 1, column 0. */
    pub m10 : f64 = 0.0;

    /** Row 1, column 1. */
    pub m11 : f64 = 1.0;

    /** Row 1, column 2. */
    pub m12 : f64 = 0.0;

    /** Row 2, column 0. */
    pub m20 : f64 = 0.0;

    /** Row 2, column 1. */
    pub m21 : f64 = 0.0;

    /** Row 2, column 2. */
    pub m22 : f64 = 1.0;

    /** The identity: transforms nothing. */
    pub static fn identity() : DMat3 {
        return DMat3 {};
    }

    /** The matrix whose columns are `a`, `b` and `c`: where the three axes go. */
    pub static fn fromColumns(a : DVec3, b : DVec3, c : DVec3) : DMat3 {
        return DMat3 {
            m00: a.x,
            m01: b.x,
            m02: c.x,
            m10: a.y,
            m11: b.y,
            m12: c.y,
            m20: a.z,
            m21: b.z,
            m22: c.z,
        };
    }

    /** Scales along the axes by the components of `v`. */
    pub static fn scaling(v : DVec3) : DMat3 {
        return DMat3 { m00: v.x, m11: v.y, m22: v.z };
    }

    /** Turns counter-clockwise about +X by `radians`, seen from +X looking at the origin. */
    pub static fn rotationX(radians : f64) : DMat3 {
        let s : f64 = sinD(radians);
        let c : f64 = cosD(radians);
        return DMat3 { m11: c, m12: -s, m21: s, m22: c };
    }

    /** Turns counter-clockwise about +Y by `radians`. */
    pub static fn rotationY(radians : f64) : DMat3 {
        let s : f64 = sinD(radians);
        let c : f64 = cosD(radians);
        return DMat3 { m00: c, m02: s, m20: -s, m22: c };
    }

    /** Turns counter-clockwise about +Z by `radians`. */
    pub static fn rotationZ(radians : f64) : DMat3 {
        let s : f64 = sinD(radians);
        let c : f64 = cosD(radians);
        return DMat3 { m00: c, m01: -s, m10: s, m11: c };
    }

    /** This matrix times `o`: `o` is applied first. */
    pub fn mul(self, o : DMat3) : DMat3 {
        return DMat3 {
            m00: self.m00 * o.m00 + self.m01 * o.m10 + self.m02 * o.m20,
            m01: self.m00 * o.m01 + self.m01 * o.m11 + self.m02 * o.m21,
            m02: self.m00 * o.m02 + self.m01 * o.m12 + self.m02 * o.m22,
            m10: self.m10 * o.m00 + self.m11 * o.m10 + self.m12 * o.m20,
            m11: self.m10 * o.m01 + self.m11 * o.m11 + self.m12 * o.m21,
            m12: self.m10 * o.m02 + self.m11 * o.m12 + self.m12 * o.m22,
            m20: self.m20 * o.m00 + self.m21 * o.m10 + self.m22 * o.m20,
            m21: self.m20 * o.m01 + self.m21 * o.m11 + self.m22 * o.m21,
            m22: self.m20 * o.m02 + self.m21 * o.m12 + self.m22 * o.m22,
        };
    }

    /** Rows and columns exchanged. */
    pub fn transposed(self) : DMat3 {
        return DMat3 {
            m00: self.m00,
            m01: self.m10,
            m02: self.m20,
            m10: self.m01,
            m11: self.m11,
            m12: self.m21,
            m20: self.m02,
            m21: self.m12,
            m22: self.m22,
        };
    }

    /** The determinant: zero exactly when the matrix has no inverse. */
    pub fn determinant(self) : f64 {
        return self.m00 * (self.m11 * self.m22 - self.m12 * self.m21)
            - self.m01 * (self.m10 * self.m22 - self.m12 * self.m20)
            + self.m02 * (self.m10 * self.m21 - self.m11 * self.m20);
    }

    /** Whether `inverse` is meaningful. */
    pub fn isInvertible(self) : bool {
        return absD(self.determinant()) > D_M3_TINY;
    }

    /** The inverse by cofactors; a singular matrix has none and answers the identity. */
    pub fn inverse(self) : DMat3 {
        let det : f64 = self.determinant();
        if (!(absD(det) > D_M3_TINY)) {
            return DMat3 {};
        }
        let k : f64 = (1.0 as f64) / det;
        return DMat3 {
            m00: (self.m11 * self.m22 - self.m12 * self.m21) * k,
            m01: (self.m02 * self.m21 - self.m01 * self.m22) * k,
            m02: (self.m01 * self.m12 - self.m02 * self.m11) * k,
            m10: (self.m12 * self.m20 - self.m10 * self.m22) * k,
            m11: (self.m00 * self.m22 - self.m02 * self.m20) * k,
            m12: (self.m02 * self.m10 - self.m00 * self.m12) * k,
            m20: (self.m10 * self.m21 - self.m11 * self.m20) * k,
            m21: (self.m01 * self.m20 - self.m00 * self.m21) * k,
            m22: (self.m00 * self.m11 - self.m01 * self.m10) * k,
        };
    }

    /**
     * The matrix that transforms surface normals when this one transforms positions: the inverse transpose.
     * Equal to the matrix itself for a pure rotation; differs under non-uniform scale.
     */
    pub fn normalMatrix(self) : DMat3 {
        return self.inverse().transposed();
    }

    /** The vector `v` transformed: `M * v`. */
    pub fn transform(self, v : DVec3) : DVec3 {
        return DVec3 {
            x: self.m00 * v.x + self.m01 * v.y + self.m02 * v.z,
            y: self.m10 * v.x + self.m11 * v.y + self.m12 * v.z,
            z: self.m20 * v.x + self.m21 * v.y + self.m22 * v.z,
        };
    }

    /** Whether every field differs from `o`'s by at most `tolerance`. */
    pub fn approxEq(self, o : DMat3, tolerance : f64) : bool {
        return approxEqWithinD(self.m00, o.m00, tolerance) && approxEqWithinD(self.m01, o.m01, tolerance)
            && approxEqWithinD(self.m02, o.m02, tolerance)
            && approxEqWithinD(self.m10, o.m10, tolerance)
            && approxEqWithinD(self.m11, o.m11, tolerance)
            && approxEqWithinD(self.m12, o.m12, tolerance)
            && approxEqWithinD(self.m20, o.m20, tolerance)
            && approxEqWithinD(self.m21, o.m21, tolerance)
            && approxEqWithinD(self.m22, o.m22, tolerance);
    }
}

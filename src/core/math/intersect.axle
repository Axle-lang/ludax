// intersect — rays and shapes against each other.
//
// Every test answers with a `RayHit` or a plain `bool`; nothing here allocates or divides by a value that
// may be zero. Touching counts as overlapping. A ray's `t` is measured in lengths of its direction vector,
// so it is a distance for a unit direction. A ray that starts inside a solid shape hits it at `t = 0`.

use crate::core::math::geom::{Aabb, Plane, Ray, Sphere};
use crate::core::math::scalar::{HUGE, abs, min, max};
use crate::core::math::vec3::Vec3;

// Below this a ray is treated as parallel to a slab or a plane, and a determinant as zero.
const X_TINY : f32 = 0.0000000001;

/** The outcome of a ray test. */
pub struct RayHit {
    /** Whether the ray touched the shape. */
    pub hit : bool = false;

    /** How far along the ray the first contact is; meaningless when there was no hit. */
    pub t : f32 = 0.0;

    /** For a triangle: the barycentric weight of the second vertex at the contact. */
    pub u : f32 = 0.0;

    /** For a triangle: the barycentric weight of the third vertex at the contact. */
    pub v : f32 = 0.0;

    /** A miss. */
    pub static fn miss() : RayHit {
        return RayHit {};
    }

    /** A hit at distance `t`. */
    pub static fn at(t : f32) : RayHit {
        return RayHit { hit: true, t: t };
    }
}

/** Where a ray meets a plane, from either side; a ray parallel to the plane or pointing away misses. */
pub fn rayPlane(ray : Ray, plane : Plane) : RayHit {
    let denom : f32 = plane.normal.dot(ray.direction);
    if (abs(denom) < X_TINY) {
        return RayHit::miss();
    }
    let t : f32 = -plane.signedDistance(ray.origin) / denom;
    if (t < 0.0) {
        return RayHit::miss();
    }
    return RayHit::at(t);
}

// What is left of a ray after some axis slabs of a box: the interval `lo..hi`, or nothing (`alive` false).
struct RaySlab {
    lo    : f32 = 0.0;
    hi    : f32 = 0.0;
    alive : bool = true;
}

fn rayClipSlab(slab : RaySlab, origin : f32, direction : f32, boxMin : f32, boxMax : f32) : RaySlab {
    if (abs(direction) < X_TINY) {
        if (origin < boxMin || origin > boxMax) {
            return RaySlab { lo: slab.lo, hi: slab.hi, alive: false };
        }
        return slab;
    }
    let inv : f32 = (1.0 as f32) / direction;
    let mut near : f32 = (boxMin - origin) * inv;
    let mut far : f32 = (boxMax - origin) * inv;
    if (near > far) {
        let swap : f32 = near;
        near = far;
        far = swap;
    }
    let lo : f32 = max(slab.lo, near);
    let hi : f32 = min(slab.hi, far);
    return RaySlab { lo: lo, hi: hi, alive: lo <= hi };
}

/** Where a ray enters a box (`t = 0` when it starts inside); an empty box is never hit. */
pub fn rayAabb(ray : Ray, bounds : Aabb) : RayHit {
    if (bounds.isEmpty()) {
        return RayHit::miss();
    }
    let mut slab : RaySlab = RaySlab { lo: 0.0, hi: HUGE, alive: true };
    slab = rayClipSlab(slab, ray.origin.x, ray.direction.x, bounds.min.x, bounds.max.x);
    if (slab.alive) {
        slab = rayClipSlab(slab, ray.origin.y, ray.direction.y, bounds.min.y, bounds.max.y);
    }
    if (slab.alive) {
        slab = rayClipSlab(slab, ray.origin.z, ray.direction.z, bounds.min.z, bounds.max.z);
    }
    if (!slab.alive) {
        return RayHit::miss();
    }
    return RayHit::at(slab.lo);
}

/** Where a ray enters a ball (`t = 0` when it starts inside); a zero direction or a ball behind misses. */
pub fn raySphere(ray : Ray, sphere : Sphere) : RayHit {
    let a : f32 = ray.direction.lengthSquared();
    if (!(a > X_TINY)) {
        return RayHit::miss();
    }
    let oc : Vec3 = ray.origin.minus(sphere.center);
    let b : f32 = oc.dot(ray.direction);
    let c : f32 = oc.lengthSquared() - sphere.radius * sphere.radius;
    let disc : f32 = b * b - a * c;
    if (disc < 0.0) {
        return RayHit::miss();
    }
    let root : f32 = disc.sqrt();
    let exit : f32 = (-b + root) / a;
    if (exit < 0.0) {
        return RayHit::miss();
    }
    return RayHit::at(max(0.0, (-b - root) / a));
}

/**
 * Where a ray meets the triangle `a`, `b`, `c` (Moeller-Trumbore), with the barycentric weights `u` of
 * `b` and `v` of `c`. With `cullBackFaces` a triangle seen from behind (clockwise) is missed. A ray
 * parallel to the triangle, or a degenerate triangle, misses.
 */
pub fn rayTriangle(ray : Ray, a : Vec3, b : Vec3, c : Vec3, cullBackFaces : bool) : RayHit {
    let e1 : Vec3 = b.minus(a);
    let e2 : Vec3 = c.minus(a);
    let p : Vec3 = ray.direction.cross(e2);
    let det : f32 = e1.dot(p);
    if (cullBackFaces && det < X_TINY) {
        return RayHit::miss();
    }
    if (abs(det) < X_TINY) {
        return RayHit::miss();
    }
    let inv : f32 = (1.0 as f32) / det;
    let from : Vec3 = ray.origin.minus(a);
    let u : f32 = from.dot(p) * inv;
    if (u < 0.0 || u > 1.0) {
        return RayHit::miss();
    }
    let q : Vec3 = from.cross(e1);
    let v : f32 = ray.direction.dot(q) * inv;
    if (v < 0.0 || u + v > 1.0) {
        return RayHit::miss();
    }
    let t : f32 = e2.dot(q) * inv;
    if (t < 0.0) {
        return RayHit::miss();
    }
    return RayHit { hit: true, t: t, u: u, v: v };
}

/** Whether two boxes share a point; boxes that only touch overlap, an empty box overlaps nothing. */
pub fn aabbOverlap(a : Aabb, b : Aabb) : bool {
    if (a.isEmpty() || b.isEmpty()) {
        return false;
    }
    return a.min.x <= b.max.x && a.max.x >= b.min.x && a.min.y <= b.max.y && a.max.y >= b.min.y
        && a.min.z <= b.max.z
        && a.max.z >= b.min.z;
}

/** Whether two balls share a point; balls that only touch overlap. */
pub fn sphereOverlap(a : Sphere, b : Sphere) : bool {
    let reach : f32 = a.radius + b.radius;
    return a.center.distanceSquared(b.center) <= reach * reach;
}

/** Whether a ball and a box share a point. */
pub fn sphereAabbOverlap(s : Sphere, b : Aabb) : bool {
    if (b.isEmpty()) {
        return false;
    }
    return s.center.distanceSquared(b.closestPoint(s.center)) <= s.radius * s.radius;
}

// id_allocator — issues and retires `EntityId`s, recycling slots with a new generation.
//
// Slots are numbered from 0 with no gaps. A retired slot goes onto a stack and is the next one handed out, so
// the sequence of ids depends only on the order of `create` and `destroy` calls: the same calls give the same
// ids on every run. A slot's generation rises by one each time it is retired (and skips 0 on wrap-around).

use crate::core::collections::vec::Vec;
use crate::core::id::entity_id::EntityId;

// Generations start here, so a zeroed id never names a live slot.
const ID_FIRST_GENERATION : i32 = 1;

/** Hands out ids and says which ones are still alive. */
pub class IdAllocator {
    generations : Vec<i32>;
    alive       : Vec<bool>;
    retired     : Vec<i32>;
    live        : i32 = 0;

    /** An allocator that has issued nothing. */
    constructor() {
        self.generations = new Vec<i32>();
        self.alive = new Vec<bool>();
        self.retired = new Vec<i32>();
    }

    /** A new id: the most recently retired slot with its bumped generation, or the next fresh slot. */
    pub fn create(mut self) : EntityId {
        self.live = self.live + 1;
        if (self.retired.isEmpty()) {
            self.generations.push(ID_FIRST_GENERATION);
            self.alive.push(true);
            return EntityId::make(self.generations.len() - 1, ID_FIRST_GENERATION);
        }
        let index : i32 = self.retired.pop();
        self.alive.set(index, true);
        return EntityId::make(index, self.generations.get(index));
    }

    /** Retires `id`; false (and nothing changes) when it is not alive, e.g. on a second destroy. */
    pub fn destroy(mut self, id : EntityId) : bool {
        if (!self.isAlive(id)) {
            return false;
        }
        let mut next : i32 = id.generation + 1;
        if (next <= 0) {
            next = ID_FIRST_GENERATION;
        }
        self.generations.set(id.index, next);
        self.alive.set(id.index, false);
        self.retired.push(id.index);
        self.live = self.live - 1;
        return true;
    }

    /** True when `id` was issued by this allocator and has not been destroyed. */
    pub fn isAlive(self, id : EntityId) : bool {
        if (!self.alive.has(id.index)) {
            return false;
        }
        return self.alive.get(id.index) && self.generations.get(id.index) == id.generation;
    }

    /** The id now living in slot `index`, or the none id when that slot is free or never issued. */
    pub fn idAt(self, index : i32) : EntityId {
        if (!self.alive.has(index) || !self.alive.get(index)) {
            return EntityId::none();
        }
        return EntityId::make(index, self.generations.get(index));
    }

    /** How many ids are alive. */
    pub fn liveCount(self) : i32 {
        return self.live;
    }

    /** How many slots exist, alive or free: one more than the highest index ever issued. */
    pub fn slotCount(self) : i32 {
        return self.generations.len();
    }
}

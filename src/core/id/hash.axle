// hash — the engine's hash functions and the trait that lets a type key a `Map`.
//
// Two hashes, both fixed by their definition and so identical on every machine and every run: FNV-1a 64 for
// strings and byte buffers, and the SplitMix64 finalizer as the fast integer mix. Neither depends on a
// process seed, which is what a deterministic simulation and a content hash on disk both need (`std`'s
// `HashMap` is seeded per process, and that is why the engine does not use it for anything whose order can be
// seen).

/** The FNV-1a 64-bit offset basis (0xcbf29ce484222325), as the signed value of the same 64 bits. */
const FNV_OFFSET : i64 = -3750763034362895579;

/** The FNV-1a 64-bit prime (0x100000001b3). */
const FNV_PRIME : i64 = 1099511628211;

/** SplitMix64's first multiplier (0xbf58476d1ce4e5b9) as signed bits. */
const MIX_MULTIPLIER_A : i64 = -4658895280553007687;

/** SplitMix64's second multiplier (0x94d049bb133111eb) as signed bits. */
const MIX_MULTIPLIER_B : i64 = -7723592293110705685;

/** The golden-ratio increment (0x9e3779b97f4a7c15) as signed bits; added first so 0 does not map to 0. */
const MIX_GAMMA : i64 = -7046029254386353131;

/** Reads a signed byte as its unsigned value 0..255. */
const HASH_BYTE_MASK : i64 = 255;

/** FNV-1a 64 of the UTF-8 bytes of `text`; the empty string hashes to the offset basis. */
pub fn hashFnv1a64(text : string) : i64 {
    let mut h : i64 = FNV_OFFSET;
    for (i of 0..text.byteLength) {
        h = (h ^ (text.byteAt(i) as i64)) * FNV_PRIME;
    }
    return h;
}

/** FNV-1a 64 of the first `count` bytes of `data`. */
pub fn hashFnv1a64Bytes(data : i8[], count : i32) : i64 {
    let mut h : i64 = FNV_OFFSET;
    for (i of 0..count) {
        h = (h ^ ((data[i as i64] as i64) & HASH_BYTE_MASK)) * FNV_PRIME;
    }
    return h;
}

/** A fast 64-bit hash of an integer (the SplitMix64 finalizer): every input bit reaches all output bits. */
pub fn hashMix(x : i64) : i64 {
    let mut z : i64 = x + MIX_GAMMA;
    z = (z ^ (z >>> 30)) * MIX_MULTIPLIER_A;
    z = (z ^ (z >>> 27)) * MIX_MULTIPLIER_B;
    return z ^ (z >>> 31);
}

/** Folds hash `b` into hash `a`; the order matters, so `(a, b)` and `(b, a)` differ. */
pub fn hashCombine(a : i64, b : i64) : i64 {
    return hashMix(a ^ (b + MIX_GAMMA + (a << 6) + (a >>> 2)));
}

/** A type that can key a `Map`: `i64` and `i32`. Equality comes from `==` on the key itself. */
pub trait MapKey {
    /** A hash of the key; equal keys must give equal hashes. */
    fn hashKey(self) : i64;

    impl i64 : MapKey {
        hashKey => hashMix(self),
    }
    impl i32 : MapKey {
        hashKey => hashMix(self as i64),
    }
}

// string_id — interned strings: each distinct text gets a small number, handed out in first-seen order.
//
// Names, tags and asset paths are compared and hashed all over the engine; turning each into an `i32` once
// makes those operations integer ones. The numbers depend only on the order texts were first interned, so
// they are the same on every run (unlike a hash). Texts are never forgotten.
//
// Storage is `std`'s `ArrayList<string>` and `HashMap<string, i32>`, not our `Vec` and `Map`: ours cannot
// hold strings (see vec). The `HashMap` is only ever asked for one key, never walked, so its per-process seed
// cannot show in the ids.

use std::collections::ArrayList;
use std::collections::HashMap;
use std::ffi::runtime::panicMsg;

/** The small number standing for an interned string. */
pub struct StringId {
    /** The number: 0 for the first text interned, 1 for the next, and -1 in the none id. */
    pub raw : i32;

    /** The id that names no string. */
    pub static fn none() : StringId {
        return StringId { raw: -1 };
    }

    /** True for the none id. */
    pub fn isNone(self) : bool {
        return self.raw < 0;
    }

    /** True when both name the same string (ids from one interner). */
    pub fn same(self, other : StringId) : bool {
        return self.raw == other.raw;
    }
}

/** Assigns `StringId`s to strings and maps them back. */
pub class StringInterner {
    ids   : HashMap<string, i32>;
    names : ArrayList<string>;

    /** An interner that knows no strings. */
    constructor() {
        self.ids = new HashMap<string, i32>();
        self.names = new ArrayList<string>();
    }

    /** The id of `text`, assigning the next free number when it is new. */
    pub fn intern(mut self, text : string) : StringId {
        let known : i32 = self.ids.get(text) ?? -1;
        if (known >= 0) {
            return StringId { raw: known };
        }
        let raw : i32 = self.names.size() as i32;
        self.ids.put(text, raw);
        self.names.add(text);
        return StringId { raw: raw };
    }

    /** The id of `text` if it was interned, else the none id; never adds anything. */
    pub fn find(self, text : string) : StringId {
        return StringId { raw: self.ids.get(text) ?? -1 };
    }

    /** The text behind `id` (borrowed from the interner; copy it to keep it); aborts on the none id. */
    pub fn name(self, id : StringId) : string {
        if (id.raw < 0 || id.raw as i64 >= self.names.size()) {
            panicMsg("StringInterner.name: unknown id");
        }
        return self.names.getOrDefault(id.raw, "");
    }

    /** How many distinct strings are interned. */
    pub fn len(self) : i32 {
        return self.names.size() as i32;
    }
}

// entity_id — a generational reference to a slot: an index plus the slot's generation.
//
// Reusing a slot bumps its generation, so a reference kept past the death of what it named no longer matches
// and can be told apart from the new tenant. The same pair serves entities, `Slab` slots and any other
// recycled storage. Axle 0.18.3 cannot build a typed `Handle<T>` (a generic struct cannot be constructed from
// a literal), so there is one id type; a game that wants the type safety wraps it in a struct of its own.

/** Where the generation sits in the packed form of an id; the index takes the low half. */
const ENTITY_GENERATION_SHIFT : i64 = 32;

/** Keeps the index half of the packed form, undoing the sign extension of a negative index. */
const ENTITY_INDEX_MASK : i64 = 4294967295;

/** Which slot, and which life of that slot. A zeroed value is not a valid id: generations start at 1. */
pub struct EntityId {
    /** The slot number, 0 or more; -1 in the none id. */
    pub index : i32;

    /** The slot's generation when this id was issued, 1 or more; 0 in the none id. */
    pub generation : i32;

    /** An id from its two parts. */
    pub static fn make(index : i32, generation : i32) : EntityId {
        return EntityId { index: index, generation: generation };
    }

    /** The id that names nothing; no allocator ever issues it. */
    pub static fn none() : EntityId {
        return EntityId { index: -1, generation: 0 };
    }

    /** The id packed by `bits`: generation in the high 32 bits, index in the low 32. */
    pub static fn fromBits(bits : i64) : EntityId {
        return EntityId { index: bits as i32, generation: (bits >>> ENTITY_GENERATION_SHIFT) as i32 };
    }

    /** True for the none id. */
    pub fn isNone(self) : bool {
        return self.index < 0;
    }

    /** True when both parts match. */
    pub fn same(self, other : EntityId) : bool {
        return self.index == other.index && self.generation == other.generation;
    }

    /** The id as one integer, for tables, files and wire formats; `fromBits` reverses it. */
    pub fn bits(self) : i64 {
        return ((self.generation as i64) << ENTITY_GENERATION_SHIFT)
            | ((self.index as i64) & ENTITY_INDEX_MASK);
    }
}

// pcg32 — a small, fast, explicitly seeded random number generator.
//
// PCG-XSH-RR 64/32 (M.E. O'Neill, pcg-random.org): 64 bits of state, a 32-bit output, and a `stream` that
// selects one of 2^63 distinct sequences for the same seed. Every game system that needs randomness owns its
// own `Pcg32` built from a seed it was given, so a replay, a network peer and a test all draw the same
// numbers in the same order. There is no global generator and no seeding from the clock: where a seed comes
// from is a decision of the caller.
//
// The output of `new Pcg32(42, 54)` is the published reference sequence of the PCG paper's demo program
// (0xa15c02b7, 0x7b47f409, ...); the test suite pins it. A 128-bit sibling (Pcg64) is not offered: Axle has
// no 128-bit integer, and two chained 64-bit steps would not be the published generator.

/** The LCG multiplier of the PCG family. */
const PCG_MULTIPLIER : u64 = 6364136223846793005;

/** Scale that maps the top 24 bits of an output onto [0, 1): 2^-24, exact in `f32`. */
const F32_UNIT : f32 = 0.000000059604645;

/** Scale that maps 53 random bits onto [0, 1): 2^-53, exact in `f64`. */
const F64_UNIT : f64 = 0.00000000000000011102230246251565;

/**
 * A random number generator with explicit seed and stream; the same seed and stream give the same numbers.
 */
pub class Pcg32 {
    state : u64 = 0;
    inc   : u64 = 1;

    /** A generator for `seed` on sequence `stream`; two streams of one seed are unrelated sequences. */
    constructor(seed : u64, stream : u64) {
        self.inc = (stream << 1) | 1;
        self.step();
        self.state = self.state + seed;
        self.step();
    }

    // One LCG transition; the output function reads the state from before it.
    fn step(mut self) : u64 {
        let before : u64 = self.state;
        self.state = before * PCG_MULTIPLIER + self.inc;
        return before;
    }

    /** The next 32 uniformly distributed bits. */
    pub fn nextU32(mut self) : u32 {
        let before : u64 = self.step();
        let xorshifted : u32 = (((before >>> 18) ^ before) >>> 27) as u32;
        let rot : u32 = (before >>> 59) as u32;
        return (xorshifted >>> rot) | (xorshifted << ((0 as u32 - rot) & 31));
    }

    /** The next 64 uniformly distributed bits (two draws, the first one in the high half). */
    pub fn nextU64(mut self) : u64 {
        let high : u64 = self.nextU32() as u64;
        let low : u64 = self.nextU32() as u64;
        return (high << 32) | low;
    }

    /**
     * A uniform `f32` in [0, 1): 24 random bits, so every value is exactly representable and 1.0 never
     * occurs.
     */
    pub fn nextF32(mut self) : f32 {
        return (self.nextU32() >>> 8) as f32 * F32_UNIT;
    }

    /** A uniform `f64` in [0, 1) with 53 random bits. */
    pub fn nextF64(mut self) : f64 {
        return (self.nextU64() >>> 11) as f64 * F64_UNIT;
    }

    /** A fair coin. */
    pub fn nextBool(mut self) : bool {
        return (self.nextU32() & 1) == 1;
    }

    /** A uniform `u32` in [0, bound) without modulo bias; 0 when `bound` is 0. */
    pub fn nextBelow(mut self, bound : u32) : u32 {
        if (bound == 0) {
            return 0;
        }
        // Reject the first `2^32 mod bound` values so that every residue is equally likely.
        let threshold : u32 = (0 as u32 - bound) % bound;
        let mut r : u32 = self.nextU32();
        while (r < threshold) {
            r = self.nextU32();
        }
        return r % bound;
    }

    /** A uniform `i32` in [lo, hi); `lo` when the range is empty. */
    pub fn range(mut self, lo : i32, hi : i32) : i32 {
        if (hi <= lo) {
            return lo;
        }
        let width : u32 = (hi as i64 - lo as i64) as u32;
        return lo + self.nextBelow(width) as i32;
    }

    /** A uniform `f32` in [lo, hi). */
    pub fn rangeF32(mut self, lo : f32, hi : f32) : f32 {
        return lo + (hi - lo) * self.nextF32();
    }

    /** Puts the first `count` entries of `items` in a uniformly random order (Fisher-Yates). */
    pub fn shuffle(mut self, items : i32[], count : i32) : void {
        let mut i : i32 = count - 1;
        while (i > 0) {
            let j : i32 = self.nextBelow((i + 1) as u32) as i32;
            let kept : i32 = items[i];
            items[i] = items[j];
            items[j] = kept;
            i = i - 1;
        }
    }

    /** The numbers 0 .. count-1 in a random order; the caller shuffles any parallel data by these indices. */
    pub fn permutation(mut self, count : i32) : i32[] {
        let mut order : i32[] = malloc<i32>(count as i64);
        for (i of 0..count) {
            order[i] = i;
        }
        self.shuffle(order, count);
        return order;
    }
}

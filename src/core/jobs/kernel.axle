// kernel — the unit of parallel work, and the rules that make its results deterministic.
//
// A parallel loop over `count` items is cut into chunks of `grain` consecutive items: chunk `c` covers items
// `c * grain` up to `min(count, (c + 1) * grain)`. The cut depends on `count` and `grain` alone, never on how
// many threads there are or how the scheduler behaves, so a kernel that writes its result at the index (or
// the chunk number) it was handed produces the same bytes with 1 worker, 8 workers or none. That is the
// engine's determinism contract for jobs: threads decide how fast, never what.
//
// The kernel is a trait with one method. Axle closures capture scalars only and a thread's entry cannot be a
// closure, so a kernel is a class that holds its own inputs and outputs (arrays, counts) in fields.

/**
 * A piece of data-parallel work. `runRange` is called once for every chunk of a parallel loop, possibly on
 * several threads at the same time for different chunks. It must only write to places that belong to the
 * items in `[begin, end)` (or to its chunk, `begin / grain`) and only read what no other chunk writes.
 */
pub trait RangeKernel {
    /** Processes the items `begin` up to, but not including, `end`. Must not throw. */
    fn runRange(mut self, begin : i32, end : i32) : void;
}

/**
 * A kernel that does nothing. It measures the cost of dispatching a loop (chunking, waking, reporting) apart
 * from any work, and it is the one implementor the library itself provides: Axle 0.18.3 refuses to compile a
 * function taking a trait that no class in the program implements (E0605), and a game that never writes a
 * kernel must still build.
 */
pub class NoopKernel : RangeKernel {
    /** The empty kernel. */
    constructor() {}

    /** Does nothing. */
    pub fn runRange(mut self, begin : i32, end : i32) : void {}
}

/** How many chunks a loop over `count` items has at the given `grain` (a grain below 1 counts as 1). */
pub fn chunkCount(count : i32, grain : i32) : i32 {
    if (count <= 0) {
        return 0;
    }
    let size : i64 = chunkSize(grain) as i64;
    return ((count as i64 + size - 1) / size) as i32;
}

/** The grain actually used for a requested one: at least 1. */
pub fn chunkSize(grain : i32) : i32 {
    if (grain < 1) {
        return 1;
    }
    return grain;
}

/** The first item of chunk `chunk`. */
pub fn chunkBegin(chunk : i32, grain : i32) : i32 {
    return (chunk as i64 * chunkSize(grain) as i64) as i32;
}

/** One past the last item of chunk `chunk` of a loop over `count` items. */
pub fn chunkEnd(chunk : i32, count : i32, grain : i32) : i32 {
    let end : i64 = (chunk as i64 + 1) * chunkSize(grain) as i64;
    if (end > count as i64) {
        return count;
    }
    return end as i32;
}

/**
 * Runs a loop on the calling thread, chunk by chunk in order. It is the reference a parallel run must match,
 * and the fallback for a machine or a test with no worker threads.
 */
pub fn runSerial(kernel : RangeKernel, count : i32, grain : i32) : void {
    let chunks : i32 = chunkCount(count, grain);
    for (chunk of 0..chunks) {
        kernel.runRange(chunkBegin(chunk, grain), chunkEnd(chunk, count, grain));
    }
}

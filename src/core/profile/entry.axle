// entry — one line of the per-frame profile.

/** What one named scope cost in a frame. */
pub struct ProfileEntry {
    /** The scope's id, as handed out by `ProfileNames`. */
    pub scope : i32;

    /** How many times the scope ran. */
    pub calls : i32;

    /** Time spent inside the scope including everything it called; recursion counts a nested call twice. */
    pub inclusiveNanos : i64;

    /**
     * Time spent in the scope itself, children excluded; summing it over all scopes gives the time covered by
     * any scope.
     */
    pub selfNanos : i64;
}

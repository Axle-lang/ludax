// names — interned profiler scope names.
//
// A scope is named once, when the system that owns it starts, and carries the resulting small integer from
// then on: the hot path never touches a string. Ids are handed out in order of first registration, so they
// are the same on every run that registers in the same order, and they index flat arrays directly.

use crate::core::math::scalar::atLeastOne;

/** Maps scope names to small stable ids and back. */
pub class ProfileNames {
    names : string[];
    used  : i32 = 0;
    limit : i32 = 1;

    /** A table for at most `capacity` distinct names (at least one). */
    constructor(capacity : i32) {
        let n : i32 = atLeastOne(capacity);
        self.limit = n;
        self.names = new string[n as i64];
        for (i of 0..n) {
            self.names[i] = "";
        }
    }

    /**
     * The id of `name`, registering it on first use. When the table is full every new name shares the last
     * id, so a profile degrades gracefully instead of failing.
     */
    pub fn id(mut self, name : string) : i32 {
        for (i of 0..self.used) {
            if (self.names[i] == name) {
                return i;
            }
        }
        if (self.used == self.limit) {
            return self.limit - 1;
        }
        self.names[self.used] = name + "";
        self.used = self.used + 1;
        return self.used - 1;
    }

    /** The name registered under `id`; empty for an id never handed out. */
    pub fn name(self, id : i32) : string {
        if (id < 0 || id >= self.used) {
            return "";
        }
        return self.names[id] + "";
    }

    /** How many names are registered. */
    pub fn count(self) : i32 {
        return self.used;
    }

    /** How many names the table can hold. */
    pub fn capacity(self) : i32 {
        return self.limit;
    }
}

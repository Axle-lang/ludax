// ring — a fixed-capacity FIFO queue over a circular buffer.
//
// For the places that must not allocate in steady state: input events, a trail of recent positions, a frame-
// time history. The capacity is chosen at construction and never changes. `push` refuses when full,
// `pushOverwrite` drops the oldest element instead; which of the two is right is the caller's decision, so
// both exist. Indexing is by age: `get(0)` is the oldest element.

use std::ffi::runtime::panicMsg;

/** A circular queue holding at most `capacity()` elements of `T`. */
pub class Ring<T> {
    items : T[];
    room  : i32;
    head  : i32 = 0;
    used  : i32 = 0;

    /** An empty ring that holds up to `capacity` elements (at least 1). */
    constructor(capacity : i32) {
        let least : i32 = match type T {
            string => unsupported "Ring<string>: generic arrays of strings corrupt memory in Axle 0.18.3",
            _ => 1,
        };
        self.room = capacity;
        if (self.room < least) {
            self.room = least;
        }
        self.items = malloc<T>(self.room as i64);
    }

    /** How many elements are queued. */
    pub fn len(self) : i32 {
        return self.used;
    }

    /** The most it can hold. */
    pub fn capacity(self) : i32 {
        return self.room;
    }

    /** True when nothing is queued. */
    pub fn isEmpty(self) : bool {
        return self.used == 0;
    }

    /** True when the next `push` would be refused. */
    pub fn isFull(self) : bool {
        return self.used == self.room;
    }

    /** Appends `v` as the newest element. False (and nothing changes) when full. */
    pub fn push(mut self, v : T) : bool {
        if (self.used == self.room) {
            return false;
        }
        let held : T = v;
        self.store(self.slot(self.used), held);
        self.used = self.used + 1;
        return true;
    }

    /** Appends `v`; when full, the oldest element is dropped to make room. True when one was dropped. */
    pub fn pushOverwrite(mut self, v : T) : bool {
        if (self.used < self.room) {
            self.push(v);
            return false;
        }
        let held : T = v;
        self.store(self.head, held);
        self.head = self.slot(1);
        return true;
    }

    /** Removes and returns the oldest element; aborts when empty. */
    pub fn pop(mut self) : T {
        if (self.used == 0) {
            panicMsg("Ring.pop: empty");
        }
        let oldest : T = self.items[self.head as i64];
        self.head = self.slot(1);
        self.used = self.used - 1;
        return oldest;
    }

    /** Removes and returns the oldest element, or returns `fallback` when empty. */
    pub fn popOr(mut self, fallback : T) : T {
        if (self.used == 0) {
            return fallback;
        }
        return self.pop();
    }

    /** The element of age `i` (0 is the oldest, `len() - 1` the newest); aborts when out of range. */
    pub fn get(self, i : i32) : T {
        if (i < 0 || i >= self.used) {
            panicMsg("Ring.get: index out of range");
        }
        return self.items[self.slot(i) as i64];
    }

    /** Drops every element. */
    pub fn clear(mut self) : void {
        self.head = 0;
        self.used = 0;
    }

    // The one place a value enters the array; see `Vec.store` for why the copy is made by the caller.
    fn store(mut self, at : i32, own v : T) : void {
        self.items[at as i64] = v;
    }

    fn slot(self, offset : i32) : i32 {
        let at : i32 = self.head + offset;
        if (at >= self.room) {
            return at - self.room;
        }
        return at;
    }
}

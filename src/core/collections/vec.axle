// vec — a growable array of values, the engine's workhorse container.
//
// `std`'s `ArrayList<T>` cannot hold a struct of ours as a field or a parameter, and the engine keeps almost
// everything in structs, so `Vec<T>` is a plain generic class over a `malloc`'d `T[]`. It grows by doubling,
// keeps its elements packed in push order, and never shrinks by itself.
//
// `T` may be a number, a bool or a struct of those. A `string` (or class) element is refused at compile time:
// Axle 0.18.3 frees the strings of a generic `T[]` twice when the array is replaced by a bigger one, so
// `Vec<string>` would corrupt the heap (see StringInterner for strings).
//
// Failure modes. An index outside `0..len()`, or a `pop`/`last` on an empty vector, is a bug in the caller
// and aborts the process with a message (Axle has no panic that can be caught, and a checked exception would
// force `!` onto every hot loop). Callers that cannot know ask first: `has(i)`, `isEmpty()`, or use `getOr` /
// `popOr`.

use std::ffi::runtime::panicMsg;

/** A growable, packed sequence of `T`: a number, a bool or a plain struct, never a string or class. */
pub class Vec<T> {
    items : T[];
    used  : i32 = 0;
    room  : i32;

    /** An empty vector with room for a few elements. */
    constructor() {
        self.room = match type T {
            string => unsupported "Vec<string>: generic arrays of strings corrupt memory in Axle 0.18.3",
            _ => 8,
        };
        self.items = malloc<T>(self.room as i64);
    }

    /** An empty vector with room for `capacity` elements before its first growth. */
    constructor(capacity : i32) {
        let least : i32 = match type T {
            string => unsupported "Vec<string>: generic arrays of strings corrupt memory in Axle 0.18.3",
            _ => 1,
        };
        self.room = capacity;
        if (self.room < least) {
            self.room = least;
        }
        self.items = malloc<T>(self.room as i64);
    }

    /** How many elements there are. */
    pub fn len(self) : i32 {
        return self.used;
    }

    /** True when there are none. */
    pub fn isEmpty(self) : bool {
        return self.used == 0;
    }

    /** How many elements fit before the next growth. */
    pub fn capacity(self) : i32 {
        return self.room;
    }

    /** True when `i` names an element. */
    pub fn has(self, i : i32) : bool {
        return i >= 0 && i < self.used;
    }

    /** The element at `i`; aborts when `i` is outside `0..len()`. */
    pub fn get(self, i : i32) : T {
        if (i < 0 || i >= self.used) {
            panicMsg("Vec.get: index out of range");
        }
        return self.items[i as i64];
    }

    /** The element at `i`, or `fallback` when `i` is outside `0..len()`. */
    pub fn getOr(self, i : i32, fallback : T) : T {
        if (i < 0 || i >= self.used) {
            return fallback;
        }
        return self.items[i as i64];
    }

    /** Replaces the element at `i`; aborts when `i` is outside `0..len()`. */
    pub fn set(mut self, i : i32, v : T) : void {
        if (i < 0 || i >= self.used) {
            panicMsg("Vec.set: index out of range");
        }
        let held : T = v;
        self.store(i, held);
    }

    /** The last element; aborts when empty. */
    pub fn last(self) : T {
        if (self.used == 0) {
            panicMsg("Vec.last: empty");
        }
        return self.items[(self.used - 1) as i64];
    }

    /** Appends `v`, growing the storage when it is full. */
    pub fn push(mut self, v : T) : void {
        if (self.used == self.room) {
            self.grow(self.room * 2);
        }
        let held : T = v;
        self.store(self.used, held);
        self.used = self.used + 1;
    }

    /** Removes and returns the last element; aborts when empty. */
    pub fn pop(mut self) : T {
        if (self.used == 0) {
            panicMsg("Vec.pop: empty");
        }
        self.used = self.used - 1;
        return self.items[self.used as i64];
    }

    /** Removes and returns the last element, or returns `fallback` when empty. */
    pub fn popOr(mut self, fallback : T) : T {
        if (self.used == 0) {
            return fallback;
        }
        self.used = self.used - 1;
        return self.items[self.used as i64];
    }

    /** Removes the element at `i` by moving the last one into its place: O(1), order changes. Returns it. */
    pub fn swapRemove(mut self, i : i32) : T {
        if (i < 0 || i >= self.used) {
            panicMsg("Vec.swapRemove: index out of range");
        }
        let gone : T = self.items[i as i64];
        self.used = self.used - 1;
        self.items[i as i64] = self.items[self.used as i64];
        return gone;
    }

    /** Removes the element at `i` and shifts the rest down: O(n), order kept. Returns it. */
    pub fn removeAt(mut self, i : i32) : T {
        if (i < 0 || i >= self.used) {
            panicMsg("Vec.removeAt: index out of range");
        }
        let gone : T = self.items[i as i64];
        for (k of i..self.used - 1) {
            self.items[k as i64] = self.items[(k + 1) as i64];
        }
        self.used = self.used - 1;
        return gone;
    }

    /** Exchanges the elements at `i` and `j`; aborts when either is outside `0..len()`. */
    pub fn swap(mut self, i : i32, j : i32) : void {
        if (i < 0 || i >= self.used || j < 0 || j >= self.used) {
            panicMsg("Vec.swap: index out of range");
        }
        let held : T = self.items[i as i64];
        self.items[i as i64] = self.items[j as i64];
        self.items[j as i64] = held;
    }

    /** Drops every element; the storage is kept for reuse. */
    pub fn clear(mut self) : void {
        self.used = 0;
    }

    /** Drops the elements from `n` on; does nothing when `n >= len()`. */
    pub fn truncate(mut self, n : i32) : void {
        if (n >= 0 && n < self.used) {
            self.used = n;
        }
    }

    /** Makes room for at least `capacity` elements in total, so pushes up to it never reallocate. */
    pub fn reserve(mut self, capacity : i32) : void {
        if (capacity > self.room) {
            self.grow(capacity);
        }
    }

    // The one place a value enters the array. `v` is a copy made by the caller: Axle will only move a value
    // into an array slot from an `own` parameter, and a public `own` parameter would force callers to give up
    // (or re-create) every number and string they push. Copying first keeps `push(x)` usable on a borrowed
    // `x`.
    fn store(mut self, i : i32, own v : T) : void {
        self.items[i as i64] = v;
    }

    fn grow(mut self, capacity : i32) : void {
        let mut bigger : T[] = malloc<T>(capacity as i64);
        for (i of 0..self.used) {
            bigger[i as i64] = self.items[i as i64];
        }
        self.items = bigger;
        self.room = capacity;
    }
}

// string_map — `Map` for string keys: insertion-ordered, deterministic, values of any plain type.
//
// `Map` cannot hold strings (see vec), so the keys are turned into numbers first: a private `StringInterner`
// numbers each distinct key in first-seen order, and a `Map<i32, V>` does the rest. The consequence worth
// knowing is that a removed key's text stays in the interner (a few bytes) so that putting it back is cheap.
// Iteration order, slots and the rules for them are exactly `Map`'s.

use crate::core::collections::map::Map;
use crate::core::id::string_id::StringId;
use crate::core::id::string_id::StringInterner;

/** Values of type `V` keyed by string, iterated in insertion order. */
pub class StringMap<V> {
    names   : StringInterner;
    entries : Map<i32, V>;

    /** An empty map. */
    constructor() {
        self.names = new StringInterner();
        self.entries = new Map<i32, V>();
    }

    /** How many keys are present. */
    pub fn len(self) : i32 {
        return self.entries.len();
    }

    /** True when no key is present. */
    pub fn isEmpty(self) : bool {
        return self.entries.isEmpty();
    }

    /** The slot holding `key`, or -1 when it is absent. */
    pub fn find(self, key : string) : i32 {
        let id : StringId = self.names.find(key);
        if (id.isNone()) {
            return -1;
        }
        return self.entries.find(id.raw);
    }

    /** True when `key` is present. */
    pub fn has(self, key : string) : bool {
        return self.find(key) >= 0;
    }

    /** Stores `v` under `key`. True when the key is new (and goes last); false when it replaced a value. */
    pub fn put(mut self, key : string, v : V) : bool {
        let id : StringId = self.names.intern(key);
        return self.entries.put(id.raw, v);
    }

    /** The value under `key`; aborts when the key is absent. */
    pub fn get(self, key : string) : V {
        return self.entries.valueAt(self.find(key));
    }

    /** The value under `key`, or `fallback` when the key is absent. */
    pub fn getOr(self, key : string, fallback : V) : V {
        let at : i32 = self.find(key);
        if (at < 0) {
            return fallback;
        }
        return self.entries.valueAt(at);
    }

    /** Removes `key`. True when it was present. */
    pub fn remove(mut self, key : string) : bool {
        let id : StringId = self.names.find(key);
        if (id.isNone()) {
            return false;
        }
        return self.entries.remove(id.raw);
    }

    /** Removes every key. */
    pub fn clear(mut self) : void {
        self.entries.clear();
    }

    /** The first slot in insertion order, or -1 when the map is empty. */
    pub fn first(self) : i32 {
        return self.entries.first();
    }

    /** The slot after `slot` in insertion order, or -1 at the end. */
    pub fn next(self, slot : i32) : i32 {
        return self.entries.next(slot);
    }

    /** The key in `slot` (borrowed from the map; copy it to keep it); aborts when the slot is not present. */
    pub fn keyAt(self, slot : i32) : string {
        return self.names.name(StringId { raw: self.entries.keyAt(slot) });
    }

    /** The value in `slot`; aborts when the slot is not present. */
    pub fn valueAt(self, slot : i32) : V {
        return self.entries.valueAt(slot);
    }

    /** Replaces the value in `slot`; aborts when the slot is not present. */
    pub fn setValueAt(mut self, slot : i32, v : V) : void {
        self.entries.setValueAt(slot, v);
    }
}

// slab — a pool of values addressed by generational ids.
//
// `insert` returns an `EntityId`; `remove` frees the slot for reuse and bumps its generation, so an id kept
// past its value's removal is recognised as stale (`has` says false, `getOr` gives the fallback) instead of
// reading whatever moved in. Slots never move, so a value keeps its slot number for life. Free slots are
// reused most recently freed first, which makes the ids a pure function of the sequence of calls.
//
// Iterate with `0..slotCount()` and `isLiveAt(slot)`: slot order, which is deterministic. A removed value's
// bytes stay in its slot until the slot is reused; for a `T` that owns memory (a string, a class) that memory
// lives until then.

use std::ffi::runtime::panicMsg;

use crate::core::id::entity_id::EntityId;
use crate::core::id::id_allocator::IdAllocator;

// Slots a slab starts with, before its first doubling.
const SLAB_INITIAL_CAPACITY : i32 = 8;

/** Values of type `T` with stable slots and generation-checked ids. */
pub class Slab<T> {
    ids   : IdAllocator;
    slots : T[];
    room  : i32;

    /** An empty slab. */
    constructor() {
        self.ids = new IdAllocator();
        self.room = match type T {
            string => unsupported "Slab<string>: generic arrays of strings corrupt memory in Axle 0.18.3",
            _ => SLAB_INITIAL_CAPACITY,
        };
        self.slots = new T[self.room as i64];
    }

    /** How many values are alive. */
    pub fn len(self) : i32 {
        return self.ids.liveCount();
    }

    /** Stores `v` in a free (or new) slot and returns the id that names it. */
    pub fn insert(mut self, v : T) : EntityId {
        let id : EntityId = self.ids.create();
        if (id.index == self.room) {
            self.grow();
        }
        let held : T = v;
        self.store(id.index, held);
        return id;
    }

    /** True when `id` names a value that is still alive. */
    pub fn has(self, id : EntityId) : bool {
        return self.ids.isAlive(id);
    }

    /** The value `id` names; aborts when `id` is stale or was never issued. */
    pub fn get(self, id : EntityId) : T {
        if (!self.ids.isAlive(id)) {
            panicMsg("Slab.get: stale or unknown id");
        }
        return self.slots[id.index as i64];
    }

    /** The value `id` names, or `fallback` when `id` is stale or was never issued. */
    pub fn getOr(self, id : EntityId, fallback : T) : T {
        if (!self.ids.isAlive(id)) {
            return fallback;
        }
        return self.slots[id.index as i64];
    }

    /** Replaces the value `id` names. False (and nothing changes) when `id` is stale. */
    pub fn set(mut self, id : EntityId, v : T) : bool {
        if (!self.ids.isAlive(id)) {
            return false;
        }
        let held : T = v;
        self.store(id.index, held);
        return true;
    }

    /** Frees the value `id` names. False when `id` is stale, so a double remove is harmless. */
    pub fn remove(mut self, id : EntityId) : bool {
        return self.ids.destroy(id);
    }

    /** How many slots exist, alive or free; the bound for walking the slab. */
    pub fn slotCount(self) : i32 {
        return self.ids.slotCount();
    }

    /** True when slot `slot` (`0..slotCount()`) holds a value. */
    pub fn isLiveAt(self, slot : i32) : bool {
        return !self.ids.idAt(slot).isNone();
    }

    /** The id of the value in `slot`, or the none id when the slot is free. */
    pub fn idAt(self, slot : i32) : EntityId {
        return self.ids.idAt(slot);
    }

    /** The value in `slot`; aborts when the slot is free or out of range. */
    pub fn valueAt(self, slot : i32) : T {
        if (!self.isLiveAt(slot)) {
            panicMsg("Slab.valueAt: slot is free");
        }
        return self.slots[slot as i64];
    }

    // The one place a value enters the array; see `Vec.store` for why the copy is made by the caller.
    fn store(mut self, slot : i32, own v : T) : void {
        self.slots[slot as i64] = v;
    }

    fn grow(mut self) : void {
        let mut bigger : T[] = new T[(self.room * 2) as i64];
        for (i of 0..self.room) {
            bigger[i as i64] = self.slots[i as i64];
        }
        self.slots = bigger;
        self.room = self.room * 2;
    }
}

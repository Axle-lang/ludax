// sparse_set — a map from small whole-number keys to values, stored packed for fast iteration.
//
// The classic ECS component store. Values live in a dense array in the order they arrived; a sparse array,
// indexed by key, says where each key's value sits. Lookup, insert and remove are O(1), and walking
// `0..len()` touches only live values, contiguously. The sparse array is as long as the largest key seen, so
// keys should be small (entity indices, not hashes).
//
// Iteration order is the dense order: insertion order, except that `remove` fills the hole with the last
// element (swap-remove), so the order after a removal is still a pure function of the sequence of calls.

use std::ffi::runtime::panicMsg;

use crate::core::collections::vec::Vec;

/** Values of type `T` keyed by non-negative `i32`, packed densely. */
pub class SparseSet<T> {
    sparse : Vec<i32>;
    keys   : Vec<i32>;
    values : Vec<T>;

    /** An empty set. */
    constructor() {
        self.sparse = new Vec<i32>();
        self.keys = new Vec<i32>();
        self.values = new Vec<T>();
    }

    /** How many keys are present. */
    pub fn len(self) : i32 {
        return self.keys.len();
    }

    /** True when no key is present. */
    pub fn isEmpty(self) : bool {
        return self.keys.isEmpty();
    }

    /** True when `key` is present; any key, including negative ones, may be asked. */
    pub fn has(self, key : i32) : bool {
        return self.denseIndex(key) >= 0;
    }

    /** Where `key`'s value sits in the dense order, or -1 when it is absent. */
    pub fn denseIndex(self, key : i32) : i32 {
        if (!self.sparse.has(key)) {
            return -1;
        }
        return self.sparse.get(key);
    }

    /** Stores `v` under `key`, replacing any earlier value. True when new; aborts on a negative key. */
    pub fn insert(mut self, key : i32, v : T) : bool {
        if (key < 0) {
            panicMsg("SparseSet.insert: negative key");
        }
        let at : i32 = self.denseIndex(key);
        if (at >= 0) {
            self.values.set(at, v);
            return false;
        }
        while (self.sparse.len() <= key) {
            self.sparse.push(-1);
        }
        self.sparse.set(key, self.keys.len());
        self.keys.push(key);
        self.values.push(v);
        return true;
    }

    /** The value under `key`; aborts when the key is absent. */
    pub fn get(self, key : i32) : T {
        let at : i32 = self.denseIndex(key);
        if (at < 0) {
            panicMsg("SparseSet.get: key absent");
        }
        return self.values.get(at);
    }

    /** The value under `key`, or `fallback` when the key is absent. */
    pub fn getOr(self, key : i32, fallback : T) : T {
        let at : i32 = self.denseIndex(key);
        if (at < 0) {
            return fallback;
        }
        return self.values.get(at);
    }

    /** Removes `key` by moving the last element into its place. True when it was present. */
    pub fn remove(mut self, key : i32) : bool {
        let at : i32 = self.denseIndex(key);
        if (at < 0) {
            return false;
        }
        let lastKey : i32 = self.keys.last();
        self.keys.swapRemove(at);
        self.values.swapRemove(at);
        self.sparse.set(lastKey, at);
        self.sparse.set(key, -1);
        return true;
    }

    /** The key stored at dense position `dense` (`0..len()`). */
    pub fn keyAt(self, dense : i32) : i32 {
        return self.keys.get(dense);
    }

    /** The value stored at dense position `dense` (`0..len()`). */
    pub fn valueAt(self, dense : i32) : T {
        return self.values.get(dense);
    }

    /** Replaces the value stored at dense position `dense`. */
    pub fn setValueAt(mut self, dense : i32, v : T) : void {
        self.values.set(dense, v);
    }

    /** Removes every key; the storage is kept. */
    pub fn clear(mut self) : void {
        for (dense of 0..self.keys.len()) {
            self.sparse.set(self.keys.get(dense), -1);
        }
        self.keys.clear();
        self.values.clear();
    }
}

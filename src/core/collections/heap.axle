// heap — a binary min-heap: the element with the smallest key comes out first.
//
// Closures here capture only scalars and traits cannot be called through a generic free function, so an
// ordering passed in as code is awkward. The ordering is data instead: every element is pushed with an `i64`
// key, and the smallest key pops first. Event times in ticks, A* costs in fixed point, priorities all fit;
// for a max-heap push the negated key, and for a float key push a quantised one.
//
// Elements with equal keys pop in the order they were pushed (each push takes a sequence number that breaks
// ties), so the pop order is fully determined by the sequence of calls, with no dependence on how the heap is
// laid out.

use std::ffi::runtime::panicMsg;

use crate::core::collections::vec::Vec;

/** A min-priority queue of `T` ordered by an `i64` key, first-in-first-out among equal keys. */
pub class Heap<T> {
    keys    : Vec<i64>;
    serials : Vec<i64>;
    values  : Vec<T>;
    pushes  : i64 = 0;

    /** An empty heap. */
    constructor() {
        self.keys = new Vec<i64>();
        self.serials = new Vec<i64>();
        self.values = new Vec<T>();
    }

    /** How many elements are queued. */
    pub fn len(self) : i32 {
        return self.keys.len();
    }

    /** True when nothing is queued. */
    pub fn isEmpty(self) : bool {
        return self.keys.isEmpty();
    }

    /** Queues `v` under `key`. */
    pub fn push(mut self, key : i64, v : T) : void {
        self.keys.push(key);
        self.serials.push(self.pushes);
        self.values.push(v);
        self.pushes = self.pushes + 1;
        self.siftUp(self.keys.len() - 1);
    }

    /** The smallest key; aborts when empty. */
    pub fn peekKey(self) : i64 {
        if (self.keys.isEmpty()) {
            panicMsg("Heap.peekKey: empty");
        }
        return self.keys.get(0);
    }

    /** The element with the smallest key, left in place; aborts when empty. */
    pub fn peek(self) : T {
        if (self.keys.isEmpty()) {
            panicMsg("Heap.peek: empty");
        }
        return self.values.get(0);
    }

    /** Removes and returns the element with the smallest key; aborts when empty. */
    pub fn pop(mut self) : T {
        if (self.keys.isEmpty()) {
            panicMsg("Heap.pop: empty");
        }
        let top : T = self.values.get(0);
        self.keys.swapRemove(0);
        self.serials.swapRemove(0);
        self.values.swapRemove(0);
        if (!self.keys.isEmpty()) {
            self.siftDown(0);
        }
        return top;
    }

    /** Removes and returns the element with the smallest key, or returns `fallback` when empty. */
    pub fn popOr(mut self, fallback : T) : T {
        if (self.keys.isEmpty()) {
            return fallback;
        }
        return self.pop();
    }

    /** Drops every element and restarts the tie-break numbering. */
    pub fn clear(mut self) : void {
        self.keys.clear();
        self.serials.clear();
        self.values.clear();
        self.pushes = 0;
    }

    // True when the element at `a` must leave before the one at `b`.
    fn before(self, a : i32, b : i32) : bool {
        let ka : i64 = self.keys.get(a);
        let kb : i64 = self.keys.get(b);
        if (ka != kb) {
            return ka < kb;
        }
        return self.serials.get(a) < self.serials.get(b);
    }

    fn swapAt(mut self, a : i32, b : i32) : void {
        self.keys.swap(a, b);
        self.serials.swap(a, b);
        self.values.swap(a, b);
    }

    fn siftUp(mut self, from : i32) : void {
        let mut at : i32 = from;
        while (at > 0) {
            let parent : i32 = (at - 1) / 2;
            if (!self.before(at, parent)) {
                return;
            }
            self.swapAt(at, parent);
            at = parent;
        }
    }

    fn siftDown(mut self, from : i32) : void {
        let n : i32 = self.keys.len();
        let mut at : i32 = from;
        while (true) {
            let left : i32 = at * 2 + 1;
            let right : i32 = left + 1;
            let mut first : i32 = at;
            if (left < n && self.before(left, first)) {
                first = left;
            }
            if (right < n && self.before(right, first)) {
                first = right;
            }
            if (first == at) {
                return;
            }
            self.swapAt(at, first);
            at = first;
        }
    }
}

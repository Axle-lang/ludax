// bitset — a growable set of small non-negative integers, one bit each.
//
// For flags per entity, visited marks, component masks. Bits beyond the end read as clear, and `set` grows
// the set to fit, so callers never size it by hand. Whole-set `unionWith`, `intersectWith` and `subtract`
// work a 64-bit word at a time. `nextSet` walks the members in ascending order.

use std::core::bits::popcount64;
use std::core::bits::trailingZeros64;
use std::ffi::runtime::panicMsg;

use crate::core::collections::vec::Vec;

/** The bit pattern with only the lowest bit set. */
const BITSET_ONE : i64 = 1;

/** The bit pattern with every bit set. */
const BITSET_ALL : i64 = -1;

/** A set of integers `0..`, stored as bits in 64-bit words. */
pub class BitSet {
    words : Vec<i64>;

    /** An empty set. */
    constructor() {
        self.words = new Vec<i64>();
    }

    /** An empty set with room for bits `0..bits` before it first grows. */
    constructor(bits : i32) {
        self.words = new Vec<i64>((bits + 63) / 64);
    }

    /** Adds `bit` to the set, growing it when needed; aborts on a negative bit. */
    pub fn set(mut self, bit : i32) : void {
        if (bit < 0) {
            panicMsg("BitSet.set: negative bit");
        }
        self.ensureWords((bit >> 6) + 1);
        let w : i32 = bit >> 6;
        self.words.set(w, self.words.get(w) | (BITSET_ONE << (bit & 63)));
    }

    /** Removes `bit` from the set; a bit that is not there is left alone. */
    pub fn unset(mut self, bit : i32) : void {
        if (bit >= 0 && (bit >> 6) < self.words.len()) {
            let w : i32 = bit >> 6;
            self.words.set(w, self.words.get(w) & ~(BITSET_ONE << (bit & 63)));
        }
    }

    /** True when `bit` is in the set; any bit, including negative ones, may be asked. */
    pub fn has(self, bit : i32) : bool {
        if (bit < 0 || (bit >> 6) >= self.words.len()) {
            return false;
        }
        return ((self.words.get(bit >> 6) >>> (bit & 63)) & 1) != 0;
    }

    /** How many bits are in the set. */
    pub fn count(self) : i32 {
        let mut n : i32 = 0;
        for (w of 0..self.words.len()) {
            n = n + popcount64(self.words.get(w));
        }
        return n;
    }

    /** True when no bit is in the set. */
    pub fn isEmpty(self) : bool {
        for (w of 0..self.words.len()) {
            if (self.words.get(w) != 0) {
                return false;
            }
        }
        return true;
    }

    /** The smallest member that is `from` or more, or -1 when there is none. */
    pub fn nextSet(self, from : i32) : i32 {
        let mut start : i32 = from;
        if (start < 0) {
            start = 0;
        }
        let mut w : i32 = start >> 6;
        if (w >= self.words.len()) {
            return -1;
        }
        let mut word : i64 = self.words.get(w) & (BITSET_ALL << (start & 63));
        while (true) {
            if (word != 0) {
                return w * 64 + trailingZeros64(word);
            }
            w = w + 1;
            if (w >= self.words.len()) {
                return -1;
            }
            word = self.words.get(w);
        }
        return -1;
    }

    /** Removes every bit; the storage is kept. */
    pub fn clearAll(mut self) : void {
        for (w of 0..self.words.len()) {
            self.words.set(w, 0);
        }
    }

    /** Adds every member of `other` to this set. */
    pub fn unionWith(mut self, other : BitSet) : void {
        self.ensureWords(other.words.len());
        for (w of 0..other.words.len()) {
            self.words.set(w, self.words.get(w) | other.words.get(w));
        }
    }

    /** Keeps only the members that are also in `other`. */
    pub fn intersectWith(mut self, other : BitSet) : void {
        for (w of 0..self.words.len()) {
            self.words.set(w, self.words.get(w) & other.words.getOr(w, 0));
        }
    }

    /** Removes every member of `other` from this set. */
    pub fn subtract(mut self, other : BitSet) : void {
        for (w of 0..self.words.len()) {
            self.words.set(w, self.words.get(w) & ~other.words.getOr(w, 0));
        }
    }

    fn ensureWords(mut self, n : i32) : void {
        while (self.words.len() < n) {
            self.words.push(0);
        }
    }
}

// fixedstep — the accumulator that turns uneven frames into even simulation ticks.
//
// The simulation advances in steps of one constant length, whatever the frame rate: that is what makes
// physics stable and a replay exact. The renderer's frames arrive at irregular intervals; `FixedStep` takes
// each frame's real duration, banks it, and hands out whole steps. What is left over after the last step is
// the fraction `alpha` of a step the renderer is already into, used to interpolate between the previous and
// the current state so motion looks smooth at any refresh rate.
//
// Time is banked as integer nanoseconds, so the number of steps a series of frames yields is exact and the
// same on every machine. The "spiral of death" (a step that takes longer to simulate than it simulates, so
// every frame owes more steps than the last) is cut by a cap: a frame never banks more than
// `maxStepsPerFrame` steps, and the excess real time is dropped, counted in `droppedNanos` so a console can
// show that the game ran slow.
//
// Use:
//     fixed.advanceNanos(frameNanos);
//     while (fixed.takeStep()) {
//         world.tick(fixed.stepSeconds());
//     }
//     render(world, fixed.alpha());

use crate::core::math::scalar::{atLeastOne, atLeastOneI64};
use crate::core::time::clock::{NANOS_PER_SECOND, nanosToSeconds};

/** Banks real frame time and releases it as fixed-length simulation steps. */
pub class FixedStep {
    stepNanos   : i64 = 1;
    maxBanked   : i64 = 1;
    banked      : i64 = 0;
    tickCount   : i64 = 0;
    droppedTime : i64 = 0;

    /**
     * Steps of `stepNanos` each; a single frame releases at most `maxStepsPerFrame` of them (at least one).
     */
    constructor(stepNanos : i64, maxStepsPerFrame : i32) {
        let cap : i32 = atLeastOne(maxStepsPerFrame);
        self.stepNanos = atLeastOneI64(stepNanos);
        self.maxBanked = self.stepNanos * cap as i64;
    }

    /** A stepper that ticks `hertz` times per second (the step is rounded to whole nanoseconds). */
    pub static fn atHertz(hertz : i32, maxStepsPerFrame : i32) : FixedStep {
        let rate : i32 = atLeastOne(hertz);
        return new FixedStep(NANOS_PER_SECOND / rate as i64, maxStepsPerFrame);
    }

    /** Banks the real duration of a frame; negative durations count as zero. */
    pub fn advanceNanos(mut self, frameNanos : i64) : void {
        if (frameNanos <= 0) {
            return;
        }
        self.banked = self.banked + frameNanos;
        if (self.banked > self.maxBanked) {
            self.droppedTime = self.droppedTime + (self.banked - self.maxBanked);
            self.banked = self.maxBanked;
        }
    }

    /** Releases one step if a whole one is banked; call in a loop until it answers false. */
    pub fn takeStep(mut self) : bool {
        if (self.banked < self.stepNanos) {
            return false;
        }
        self.banked = self.banked - self.stepNanos;
        self.tickCount = self.tickCount + 1;
        return true;
    }

    /**
     * How far into the next step the banked time reaches, in [0, 1): the interpolation factor for rendering.
     */
    pub fn alpha(self) : f32 {
        return (self.banked as f64 / self.stepNanos as f64) as f32;
    }

    /** The length of every step in seconds, the `dt` the simulation is given. */
    pub fn stepSeconds(self) : f32 {
        return nanosToSeconds(self.stepNanos) as f32;
    }

    /** The length of every step in nanoseconds. */
    pub fn stepNanos(self) : i64 {
        return self.stepNanos;
    }

    /** Steps released so far; the simulation's clock. */
    pub fn ticks(self) : i64 {
        return self.tickCount;
    }

    /** Simulated time so far in seconds: `ticks` whole steps, independent of any real clock. */
    pub fn simulatedSeconds(self) : f64 {
        return nanosToSeconds(self.tickCount * self.stepNanos);
    }

    /** Real time thrown away by the per-frame cap, in nanoseconds. */
    pub fn droppedNanos(self) : i64 {
        return self.droppedTime;
    }
}

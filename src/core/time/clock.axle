// clock — the monotonic clock, unit conversions and the Stopwatch.
//
// The one place the engine reads real time. `std::time::monotonicNanos` is a reading with an arbitrary
// origin, good only for differences, which is exactly what profiling and frame pacing need. Nothing that
// decides what happens in the simulation may call it: simulation time is the tick count of a `FixedStep`,
// which is why this file is the entire "wall clock" surface of the engine and easy to audit.
//
// Durations are whole nanoseconds in an `i64` (292 years of range). Integers keep the accumulation in
// `FixedStep` and `Timer` exact: the same frame times always give the same ticks, with no float drift.

use std::time::monotonicNanos;

/** Nanoseconds in one second. */
pub const NANOS_PER_SECOND : i64 = 1000000000;

/** Nanoseconds in one millisecond. */
pub const NANOS_PER_MILLI : i64 = 1000000;

/** The monotonic clock in nanoseconds; its origin is arbitrary, so only differences mean anything. */
pub fn nowNanos() : i64 {
    return monotonicNanos();
}

/** A duration in seconds as whole nanoseconds, rounded to the nearest; negative input counts as zero. */
pub fn secondsToNanos(seconds : f64) : i64 {
    if (seconds <= 0.0) {
        return 0;
    }
    return (seconds * NANOS_PER_SECOND as f64 + 0.5) as i64;
}

/** A duration in nanoseconds as seconds. */
pub fn nanosToSeconds(nanos : i64) : f64 {
    return nanos as f64 / NANOS_PER_SECOND as f64;
}

/** A duration in nanoseconds as milliseconds. */
pub fn nanosToMillis(nanos : i64) : f64 {
    return nanos as f64 / NANOS_PER_MILLI as f64;
}

/** Measures elapsed real time since it was started or last restarted. */
pub class Stopwatch {
    startedAt : i64 = 0;

    /** A stopwatch that starts now. */
    constructor() {
        self.startedAt = nowNanos();
    }

    /**
     * A stopwatch whose start is the clock reading `startNanos`; this is how tests supply their own clock.
     */
    constructor(startNanos : i64) {
        self.startedAt = startNanos;
    }

    /** Nanoseconds from the start to the clock reading `now`. */
    pub fn elapsedNanosAt(self, now : i64) : i64 {
        return now - self.startedAt;
    }

    /** Nanoseconds since the start. */
    pub fn elapsedNanos(self) : i64 {
        return self.elapsedNanosAt(nowNanos());
    }

    /** Seconds since the start. */
    pub fn elapsedSeconds(self) : f64 {
        return nanosToSeconds(self.elapsedNanos());
    }

    /** Starts over from the clock reading `now` and answers the nanoseconds that had elapsed. */
    pub fn lapAt(mut self, now : i64) : i64 {
        let elapsed : i64 = now - self.startedAt;
        self.startedAt = now;
        return elapsed;
    }

    /**
     * Starts over from now and answers the nanoseconds that had elapsed: one call per frame gives frame
     * times.
     */
    pub fn lap(mut self) : i64 {
        return self.lapAt(nowNanos());
    }
}

// timer — a countdown driven by simulation time, one-shot or repeating.
//
// A `Timer` is told how much time passed (the fixed step) rather than reading a clock, so a cooldown or a
// spawn interval behaves identically in a replay, on a slow machine and under a debugger. For measuring real
// time see `Stopwatch` in `clock`.

/** Counts down a duration of simulation time. */
pub class Timer {
    length    : i64 = 1;
    left      : i64 = 1;
    looping   : bool = false;
    completed : bool = false;

    /** A timer of `durationNanos` (at least 1); a repeating one starts over each time it runs out. */
    constructor(durationNanos : i64, repeating : bool) {
        self.length = durationNanos;
        if (durationNanos < 1) {
            self.length = 1;
        }
        self.left = self.length;
        self.looping = repeating;
    }

    /**
     * Lets `dtNanos` pass and answers how many times the timer ran out in that span (0 or 1 unless
     * repeating).
     */
    pub fn advance(mut self, dtNanos : i64) : i32 {
        if (dtNanos <= 0 || (self.completed && !self.looping)) {
            return 0;
        }
        if (dtNanos < self.left) {
            self.left = self.left - dtNanos;
            return 0;
        }
        if (!self.looping) {
            self.left = 0;
            self.completed = true;
            return 1;
        }
        let over : i64 = dtNanos - self.left;
        let extra : i64 = over / self.length;
        self.left = self.length - over % self.length;
        return (1 + extra) as i32;
    }

    /** Whether a one-shot timer has run out; a repeating timer is never finished. */
    pub fn finished(self) : bool {
        return self.completed;
    }

    /** Time left until the next expiry, in nanoseconds. */
    pub fn remainingNanos(self) : i64 {
        return self.left;
    }

    /** Progress through the current period: 0 just started, approaching 1 as it runs out, 1 when finished. */
    pub fn fraction(self) : f32 {
        return (1.0 - self.left as f64 / self.length as f64) as f32;
    }

    /** Starts the period over and clears `finished`. */
    pub fn restart(mut self) : void {
        self.left = self.length;
        self.completed = false;
    }
}

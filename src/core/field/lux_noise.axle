// lux_noise — value noise with its exact gradient, in the core so that rendering and simulation share one noise.
//
// A field (`lux_field`) needs, at a point, the value of its noise and how fast it changes: the gradient tilts a normal,
// bends a ray through a portal, turns a swirl into the velocity of a particle. Value noise on a unit lattice:
//
//   n(x, y) = lerp(lerp(a, b, s(fx)), lerp(c, d, s(fx)), s(fy))     a..d hashed at the four corners, in [0, 1)
//   s(t)    = t² (3 - 2t),   s'(t) = 6 t (1 - t)                       the fade, continuous slope at the corners
//   ∂n/∂x   = s'(fx) ((b - a) + ((d - c) - (b - a)) s(fy))
//   ∂n/∂y   = s'(fy) (bottom - top)
//
// Exact, so a gradient costs a few multiplies more than the value, not two more evaluations. Its slope is at most 1.5
// a lattice cell (|s'| ≤ 1.5, corners in [0, 1)): the Lipschitz bound a domain warp needs to keep its footprint safe.
// The corners come from the core's SplitMix64 finalizer: the same field on every machine and thread.

use crate::core::id::hash::hashMix;

/** The largest slope of one octave of value noise, per lattice cell. */
pub const LUX_NOISE_SLOPE : f32 = 1.5;

// 2^-24: the 24 bits a corner keeps, as a fraction in [0, 1).
const LUXN_INV_24 : f32 = 0.000000059604645;

/** A uniform number in [0, 1) for the lattice point (x, y) under `seed`. */
pub fn luxNoiseCorner(x : i32, y : i32, seed : i32) : f32 {
    let mut h : i64 = (x as i64) * 73856093;
    h = h ^ ((y as i64) * 19349663);
    h = h ^ ((seed as i64) * 2654435761);
    return ((hashMix(h) >>> 40) as i32) as f32 * LUXN_INV_24;
}

/** The lattice cell holding `v`: rounds toward minus infinity. */
pub fn luxNoiseFloor(v : f32) : i32 {
    let t : i32 = v as i32;
    if ((t as f32) > v) {
        return t - 1;
    }
    return t;
}

/**
 * Value noise at (x, y) under `seed`, written to `out` at `at`: the value in [0, 1), then ∂/∂x and ∂/∂y. Written into
 * the caller's registers, not returned as a struct: a struct built per call is not kept in registers (F14).
 */
pub fn luxNoise2(x : f32, y : f32, seed : i32, mut out : f32[], at : i64) : void {
    let ix : i32 = luxNoiseFloor(x);
    let iy : i32 = luxNoiseFloor(y);
    let tx : f32 = x - ix as f32;
    let ty : f32 = y - iy as f32;
    let three : f32 = 3.0;
    let two : f32 = 2.0;
    let six : f32 = 6.0;
    let one : f32 = 1.0;
    let sx : f32 = tx * tx * (three - two * tx);
    let sy : f32 = ty * ty * (three - two * ty);
    let dsx : f32 = six * tx * (one - tx);
    let dsy : f32 = six * ty * (one - ty);
    let a : f32 = luxNoiseCorner(ix, iy, seed);
    let b : f32 = luxNoiseCorner(ix + 1, iy, seed);
    let c : f32 = luxNoiseCorner(ix, iy + 1, seed);
    let d : f32 = luxNoiseCorner(ix + 1, iy + 1, seed);
    let top : f32 = a + (b - a) * sx;
    let bottom : f32 = c + (d - c) * sx;
    out[at] = top + (bottom - top) * sy;
    out[at + 1] = dsx * ((b - a) + ((d - c) - (b - a)) * sy);
    out[at + 2] = dsy * (bottom - top);
}

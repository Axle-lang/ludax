// inspect — a scene as readable text: the tree, names, and where everything is.
//
// What an editor's hierarchy panel shows, and what a developer wants in a log when a scene looks wrong. The text
// is indented two spaces per level, one entity a line (`name (slot.generation) at x y z`), children in attach
// order, roots in slot order, so two equal scenes give equal text and a diff of two dumps says what moved.

use crate::core::collections::vec::Vec;
use crate::core::id::entity_id::EntityId;
use crate::core::math::dtransform::DTransform;
use crate::world::scene::Scene;

// Rounding to three decimals: the scale and its digit count.
const INSPECT_MILLI : f64 = 1000.0;
const INSPECT_MILLI_DIGITS : i32 = 3;
const INSPECT_INDENT : string = "  ";

/** Dumps scenes as text. */
pub class SceneInspector {
    /** The whole scene, every root with its subtree. Positions are the entities' world positions, rounded to 1/1000. */
    pub static fn dump(scene : Scene) : string {
        return SceneInspector::dumpWith(scene, true);
    }

    /** Like `dump` without the ids: two scenes with the same tree, names and positions give the same text even when their slots differ (after a reload, say). */
    pub static fn dumpStructure(scene : Scene) : string {
        return SceneInspector::dumpWith(scene, false);
    }

    static fn dumpWith(scene : Scene, ids : bool) : string {
        let mut out : string = "";
        let world = scene.entities();
        for (slot of 0..world.slots()) {
            let e : EntityId = world.idAt(slot);
            if (!e.isNone() && scene.parent(e).isNone()) {
                out = out + SceneInspector::subtreeWith(scene, e, 0, ids);
            }
        }
        return out;
    }

    /** `root` and everything below it, indented `depth` levels. */
    pub static fn subtree(scene : Scene, root : EntityId, depth : i32) : string {
        return SceneInspector::subtreeWith(scene, root, depth, true);
    }

    static fn subtreeWith(scene : Scene, root : EntityId, depth : i32, ids : bool) : string {
        let mut out : string = "";
        let stack : Vec<i64> = new Vec<i64>();
        let levels : Vec<i32> = new Vec<i32>();
        stack.push(root.bits());
        levels.push(depth);
        while (!stack.isEmpty()) {
            let e : EntityId = EntityId::fromBits(stack.pop());
            let level : i32 = levels.pop();
            out = out + SceneInspector::lineWith(scene, e, level, ids);

            // Reversed, so that they come off the stack in attach order.
            let kids : Vec<i64> = scene.childrenReversed(e);
            for (k of 0..kids.len()) {
                stack.push(kids.get(k));
                levels.push(level + 1);
            }
        }
        return out;
    }

    /** The line describing one entity. */
    pub static fn line(scene : Scene, e : EntityId, depth : i32) : string {
        return SceneInspector::lineWith(scene, e, depth, true);
    }

    static fn lineWith(scene : Scene, e : EntityId, depth : i32, ids : bool) : string {
        let mut pad : string = "";
        for (i of 0..depth) {
            pad = pad + INSPECT_INDENT;
        }

        let mut name : string = scene.nameOf(e);
        if (name.byteLength == 0) {
            name = "(unnamed)";
        }

        let t : DTransform = scene.worldTransform(e);
        let mut tag : string = "";
        if (ids) {
            tag = " (${e.index}.${e.generation})";
        }

        let x : string = SceneInspector::milli(t.translation.x);
        let y : string = SceneInspector::milli(t.translation.y);
        let z : string = SceneInspector::milli(t.translation.z);
        return "${pad}${name}${tag} at ${x} ${y} ${z}\n";
    }

    // A number with exactly three decimals, from an i64 so that rounding is the same everywhere.
    static fn milli(v : f64) : string {
        let scaled : f64 = v * INSPECT_MILLI;
        let mut n : i64 = (scaled + 0.5) as i64;
        if (v < 0.0) {
            n = (scaled - 0.5) as i64;
        }
        let mut sign : string = "";
        if (n < 0) {
            sign = "-";
            n = -n;
        }
        let whole : i64 = n / (INSPECT_MILLI as i64);
        let frac : i64 = n % (INSPECT_MILLI as i64);
        let mut f : string = "${frac}";
        while (f.byteLength < INSPECT_MILLI_DIGITS) {
            f = "0${f}";
        }
        return "${sign}${whole}.${f}";
    }
}

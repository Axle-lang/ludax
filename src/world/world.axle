// world — which entities exist.
//
// An entity is only an `EntityId`: a slot number and a generation. The world issues them, retires them and says
// whether an id still names a living entity. What an entity *has* lives in `ComponentStore`s the game owns, and
// how entities relate lives in `Scene`; this file owns existence and nothing else, so a store can ask "is this
// still alive" without knowing about transforms or names. Ids come out in a fixed order (see `IdAllocator`), so
// two runs that make the same calls hold the same ids.

use crate::core::id::entity_id::EntityId;
use crate::core::id::id_allocator::IdAllocator;

/** The set of living entities. */
pub class World {
    ids : IdAllocator;

    /** A world with no entity. */
    constructor() {
        self.ids = new IdAllocator();
    }

    /** A new entity. */
    pub fn create(mut self) : EntityId {
        return self.ids.create();
    }

    /** Removes `id`; false when it was not alive. Components it had are left to `ComponentStore::sweep`. */
    pub fn destroy(mut self, id : EntityId) : bool {
        return self.ids.destroy(id);
    }

    /** True when `id` names a living entity. */
    pub fn isAlive(self, id : EntityId) : bool {
        return self.ids.isAlive(id);
    }

    /** The living entity in slot `index`, or the none id. */
    pub fn idAt(self, index : i32) : EntityId {
        return self.ids.idAt(index);
    }

    /** How many entities are alive. */
    pub fn count(self) : i32 {
        return self.ids.liveCount();
    }

    /** How many slots exist, alive or free: slot numbers below this may be asked about with `idAt`. */
    pub fn slots(self) : i32 {
        return self.ids.slotCount();
    }
}

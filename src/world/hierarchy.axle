// hierarchy — who is whose child.
//
// A forest over entity slots: each slot has at most one parent and an ordered list of children, kept as
// first/last/next/previous links so attaching, detaching and walking are O(1) per step with no allocation. The
// order of children is the order they were attached, so a walk is the same on every run. It speaks in slot
// numbers; `Scene` turns ids into slots and refuses the dead.

use crate::core::collections::vec::Vec;

// The link value that means no slot: no parent, no child, no sibling.
const HIER_NONE : i32 = -1;

/** Parent and child links of the entities of a scene. */
pub(crate) class Hierarchy {
    parent : Vec<i32>;
    first  : Vec<i32>;
    last   : Vec<i32>;
    next   : Vec<i32>;
    prev   : Vec<i32>;
    kids   : Vec<i32>;

    /** A forest of no slot. */
    constructor() {
        self.parent = new Vec<i32>();
        self.first = new Vec<i32>();
        self.last = new Vec<i32>();
        self.next = new Vec<i32>();
        self.prev = new Vec<i32>();
        self.kids = new Vec<i32>();
    }

    /** Makes room for slot `index` and leaves it a root with no child. */
    pub(crate) fn reset(mut self, index : i32) : void {
        while (self.parent.len() <= index) {
            self.parent.push(HIER_NONE);
            self.first.push(HIER_NONE);
            self.last.push(HIER_NONE);
            self.next.push(HIER_NONE);
            self.prev.push(HIER_NONE);
            self.kids.push(0);
        }
        self.parent.set(index, HIER_NONE);
        self.first.set(index, HIER_NONE);
        self.last.set(index, HIER_NONE);
        self.next.set(index, HIER_NONE);
        self.prev.set(index, HIER_NONE);
        self.kids.set(index, 0);
    }

    /** The parent slot of `index`, or -1 for a root. */
    pub(crate) fn parentOf(self, index : i32) : i32 {
        return self.parent.getOr(index, HIER_NONE);
    }

    /** The first child slot of `index`, or -1. */
    pub(crate) fn firstChild(self, index : i32) : i32 {
        return self.first.getOr(index, HIER_NONE);
    }

    /** The sibling after `index`, or -1. */
    pub(crate) fn nextSibling(self, index : i32) : i32 {
        return self.next.getOr(index, HIER_NONE);
    }

    /** How many children `index` has. */
    pub(crate) fn childCount(self, index : i32) : i32 {
        return self.kids.getOr(index, 0);
    }

    /** True when `ancestor` is `index` or one of its parents, grandparents and so on. */
    pub(crate) fn isSelfOrAncestor(self, ancestor : i32, index : i32) : bool {
        let mut at : i32 = index;
        while (at >= 0) {
            if (at == ancestor) {
                return true;
            }
            at = self.parentOf(at);
        }
        return false;
    }

    /** Takes `index` out of its parent's list; it becomes a root. */
    pub(crate) fn detach(mut self, index : i32) : void {
        let p : i32 = self.parentOf(index);
        if (p < 0) {
            return;
        }
        let before : i32 = self.prev.get(index);
        let after : i32 = self.next.get(index);
        if (before >= 0) {
            self.next.set(before, after);
        } else {
            self.first.set(p, after);
        }
        if (after >= 0) {
            self.prev.set(after, before);
        } else {
            self.last.set(p, before);
        }
        self.kids.set(p, self.kids.get(p) - 1);
        self.parent.set(index, HIER_NONE);
        self.next.set(index, HIER_NONE);
        self.prev.set(index, HIER_NONE);
    }

    /** Makes `index` the last child of `newParent`; false when that would make a cycle or a slot its own parent. */
    pub(crate) fn attach(mut self, index : i32, newParent : i32) : bool {
        if (self.isSelfOrAncestor(index, newParent)) {
            return false;
        }
        self.detach(index);
        let tail : i32 = self.last.get(newParent);
        if (tail >= 0) {
            self.next.set(tail, index);
        } else {
            self.first.set(newParent, index);
        }
        self.prev.set(index, tail);
        self.last.set(newParent, index);
        self.parent.set(index, newParent);
        self.kids.set(newParent, self.kids.get(newParent) + 1);
        return true;
    }
}

// spatial — a uniform grid that answers "what is near this box".
//
// The broad phase of everything that needs neighbours: culling, overlap tests, area triggers. Boxes are put in
// every cell they touch (a hash from the cell to a chain of entries, no allocation per insert); a query walks
// the cells its box touches and returns each entity once. Boxes much larger than a cell would touch thousands of
// cells, so they go to a short list that every query checks exactly. The grid is rebuilt rather than updated
// (`clear`, then `insert` each box): for things that move every frame that is cheaper than moving entries, and
// it keeps results a pure function of the inserts. Answers come in cell order, then insertion order.

use std::ffi::runtime::panicMsg;

use crate::core::collections::map::Map;
use crate::core::collections::vec::Vec;
use crate::core::id::entity_id::EntityId;
use crate::core::math::dgeom::DAabb;

// A box wider than this many cells on any axis is not chained into cells.
const SPATIAL_BIG_CELLS : i32 = 12;

// A query wider than this many cells on any axis walks every chain instead of every covered cell: four times
// `SPATIAL_BIG_CELLS`, written out because a top-level constant must be a literal.
const SPATIAL_WALK_CELLS : i32 = 48;

// Cell coordinates are packed 21 bits each; this bias makes negative coordinates non-negative before masking.
const SPATIAL_COORD_BIAS : i64 = 1048576;

// The 21-bit mask that keeps one packed coordinate.
const SPATIAL_COORD_MASK : i64 = 2097151;

/** A grid of cubic cells over boxes of entities. */
pub class SpatialGrid {
    cell    : f64;
    heads   : Map<i64, i32>;
    bits    : Vec<i64>;
    chain   : Vec<i32>;
    bigBits : Vec<i64>;
    bigBox  : Vec<DAabb>;
    seen    : Map<i64, i32>;
    boxes   : i32 = 0;

    /** A grid whose cells are `cellSize` wide; aborts when that is not positive. A cell about as large as a typical box works best. */
    constructor(cellSize : f64) {
        if (cellSize <= 0.0) {
            panicMsg("SpatialGrid: cell size must be positive");
        }
        self.cell = cellSize;
        self.heads = new Map<i64, i32>();
        self.bits = new Vec<i64>();
        self.chain = new Vec<i32>();
        self.bigBits = new Vec<i64>();
        self.bigBox = new Vec<DAabb>();
        self.seen = new Map<i64, i32>();
    }

    /** Forgets every box. */
    pub fn clear(mut self) : void {
        self.heads.clear();
        self.bits.clear();
        self.chain.clear();
        self.bigBits.clear();
        self.bigBox.clear();
        self.boxes = 0;
    }

    /** How many boxes were inserted since the last `clear`. */
    pub fn count(self) : i32 {
        return self.boxes;
    }

    /** Puts `id` in the grid with the box `box`. */
    pub fn insert(mut self, id : EntityId, box : DAabb) : void {
        self.boxes = self.boxes + 1;
        let x0 : i32 = self.cellOf(box.min.x);
        let y0 : i32 = self.cellOf(box.min.y);
        let z0 : i32 = self.cellOf(box.min.z);
        let x1 : i32 = self.cellOf(box.max.x);
        let y1 : i32 = self.cellOf(box.max.y);
        let z1 : i32 = self.cellOf(box.max.z);
        if (x1 - x0 >= SPATIAL_BIG_CELLS || y1 - y0 >= SPATIAL_BIG_CELLS || z1 - z0 >= SPATIAL_BIG_CELLS) {
            self.bigBits.push(id.bits());
            self.bigBox.push(box);
            return;
        }
        for (z of z0..(z1 + 1)) {
            for (y of y0..(y1 + 1)) {
                for (x of x0..(x1 + 1)) {
                    let key : i64 = SpatialGrid::key(x, y, z);
                    let slot : i32 = self.heads.getOr(key, -1);
                    self.bits.push(id.bits());
                    self.chain.push(slot);
                    self.heads.put(key, self.bits.len() - 1);
                }
            }
        }
    }

    /**
     * Appends to `out` the bits (`EntityId::fromBits`) of every entity whose box shares a cell with `box`, once
     * each, and returns how many were appended. The answer may include boxes that miss `box` by less than a
     * cell; the large boxes are tested exactly.
     */
    pub fn query(mut self, box : DAabb, out : Vec<i64>) : i32 {
        let x0 : i32 = self.cellOf(box.min.x);
        let y0 : i32 = self.cellOf(box.min.y);
        let z0 : i32 = self.cellOf(box.min.z);
        let x1 : i32 = self.cellOf(box.max.x);
        let y1 : i32 = self.cellOf(box.max.y);
        let z1 : i32 = self.cellOf(box.max.z);
        let mut added : i32 = 0;
        self.seen.clear();
        for (i of 0..self.bigBits.len()) {
            if (SpatialGrid::overlaps(self.bigBox.get(i), box) && self.seen.put(self.bigBits.get(i), 1)) {
                out.push(self.bigBits.get(i));
                added = added + 1;
            }
        }
        if (x1 - x0 >= SPATIAL_WALK_CELLS || y1 - y0 >= SPATIAL_WALK_CELLS || z1 - z0 >= SPATIAL_WALK_CELLS) {
            // A query this large is cheaper as a walk over every chain than over every cell it covers.
            let mut s : i32 = self.heads.first();
            while (s >= 0) {
                let mut e : i32 = self.heads.valueAt(s);
                while (e >= 0) {
                    if (self.seen.put(self.bits.get(e), 1)) {
                        out.push(self.bits.get(e));
                        added = added + 1;
                    }
                    e = self.chain.get(e);
                }
                s = self.heads.next(s);
            }
            return added;
        }
        for (z of z0..(z1 + 1)) {
            for (y of y0..(y1 + 1)) {
                for (x of x0..(x1 + 1)) {
                    let mut e : i32 = self.heads.getOr(SpatialGrid::key(x, y, z), -1);
                    while (e >= 0) {
                        if (self.seen.put(self.bits.get(e), 1)) {
                            out.push(self.bits.get(e));
                            added = added + 1;
                        }
                        e = self.chain.get(e);
                    }
                }
            }
        }
        return added;
    }

    // The cell a coordinate falls in, rounding toward negative infinity.
    fn cellOf(self, v : f64) : i32 {
        let q : f64 = v / self.cell;
        let mut t : i32 = q as i32;
        if ((t as f64) > q) {
            t = t - 1;
        }
        return t;
    }

    // Three cell coordinates packed in 21 bits each; worlds up to a million cells either way keep them distinct.
    static fn key(x : i32, y : i32, z : i32) : i64 {
        let bx : i64 = ((x as i64) + SPATIAL_COORD_BIAS) & SPATIAL_COORD_MASK;
        let by : i64 = ((y as i64) + SPATIAL_COORD_BIAS) & SPATIAL_COORD_MASK;
        let bz : i64 = ((z as i64) + SPATIAL_COORD_BIAS) & SPATIAL_COORD_MASK;
        return bx | (by << 21) | (bz << 42);
    }

    static fn overlaps(a : DAabb, b : DAabb) : bool {
        return a.min.x <= b.max.x && a.max.x >= b.min.x && a.min.y <= b.max.y && a.max.y >= b.min.y
            && a.min.z <= b.max.z
            && a.max.z >= b.min.z;
    }
}

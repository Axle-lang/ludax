// store — the components of one kind, packed.
//
// A `ComponentStore<T>` keeps the `T` of every entity that has one, densely, so a system walks `0..len()` and
// touches only entities that matter. The store remembers the generation each entity had when it got its
// component: an id kept past the entity's death, or past the reuse of its slot, finds nothing. A destroyed
// entity's component stays until `sweep` removes it; `has` and `getOr` already refuse it, because they ask the
// world. Join two kinds by walking the smaller and asking the other (`has`/`get`).

use crate::core::collections::sparse_set::SparseSet;
use crate::core::id::entity_id::EntityId;
use crate::world::world::World;

/** One component kind: a `T` for each entity that has one. */
pub class ComponentStore<T> {
    values : SparseSet<T>;
    lives  : SparseSet<i32>;

    /** A store nobody is in. */
    constructor() {
        self.values = new SparseSet<T>();
        self.lives = new SparseSet<i32>();
    }

    /** How many components are stored, dead entities' included until `sweep`. */
    pub fn len(self) : i32 {
        return self.values.len();
    }

    /** Gives `id` the component `v`, replacing its old one; false (nothing stored) when `id` is not alive. */
    pub fn add(mut self, world : World, id : EntityId, v : T) : bool {
        if (!world.isAlive(id)) {
            return false;
        }
        self.values.insert(id.index, v);
        self.lives.insert(id.index, id.generation);
        return true;
    }

    /** True when `id` is alive and has a component here. */
    pub fn has(self, world : World, id : EntityId) : bool {
        if (!world.isAlive(id)) {
            return false;
        }
        return self.lives.getOr(id.index, 0) == id.generation;
    }

    /** `id`'s component, or `fallback` when it has none. */
    pub fn getOr(self, world : World, id : EntityId, fallback : T) : T {
        if (!self.has(world, id)) {
            return fallback;
        }
        return self.values.get(id.index);
    }

    /** `id`'s component; aborts when it has none, so ask `has` first (a join has already). */
    pub fn get(self, id : EntityId) : T {
        return self.values.get(id.index);
    }

    /** Replaces the component of `id` if it has one; false when it has none. */
    pub fn set(mut self, world : World, id : EntityId, v : T) : bool {
        if (!self.has(world, id)) {
            return false;
        }
        self.values.insert(id.index, v);
        return true;
    }

    /** Takes the component away from `id`; true when there was one. */
    pub fn remove(mut self, id : EntityId) : bool {
        if (self.lives.getOr(id.index, 0) != id.generation) {
            return false;
        }
        self.lives.remove(id.index);
        return self.values.remove(id.index);
    }

    /** The entity that owns the component at dense position `dense` (`0..len()`); it may be dead until `sweep`. */
    pub fn entityAt(self, dense : i32) : EntityId {
        let key : i32 = self.values.keyAt(dense);
        return EntityId::make(key, self.lives.get(key));
    }

    /** The component at dense position `dense`. */
    pub fn valueAt(self, dense : i32) : T {
        return self.values.valueAt(dense);
    }

    /** Replaces the component at dense position `dense`. */
    pub fn setValueAt(mut self, dense : i32, v : T) : void {
        self.values.setValueAt(dense, v);
    }

    /** Drops the components of entities that no longer exist; returns how many. */
    pub fn sweep(mut self, world : World) : i32 {
        let mut dropped : i32 = 0;
        let mut dense : i32 = self.values.len() - 1;
        while (dense >= 0) {
            if (!world.isAlive(self.entityAt(dense))) {
                let key : i32 = self.values.keyAt(dense);
                self.lives.remove(key);
                self.values.remove(key);
                dropped = dropped + 1;
            }
            dense = dense - 1;
        }
        return dropped;
    }
}

// query — the entities that have several kinds of component at once.
//
// A system usually wants "every entity with a position and a velocity". `Join2` and `Join3` walk the smallest of the stores they
// are given (the first, for three) and keeps the entities the others also have, so the cost follows the rarest kind and the order is the
// smallest store's dense order, the same on every run. The join holds only a position, not the stores: they are
// passed on each call, so a system keeps using them as it iterates. Components may be changed while joining (with
// `setValueAt` or `set`); adding or removing entities, or sweeping, while a join is open is not supported.
//
//     let j : Join2<DVec3, DVec3> = new Join2<DVec3, DVec3>(pos.len(), vel.len());
//     while (j.next2(world, pos, vel)) {
//         let e : EntityId = j.entity();
//         ... pos.get(e), vel.get(e) ...
//     }

use crate::core::id::entity_id::EntityId;
use crate::world::store::ComponentStore;
use crate::world::world::World;

/** A cursor over the entities that have a component in each of two stores. */
pub class Join2<A, B> {
    at         : i32 = -1;
    walkSecond : bool = false;
    current    : EntityId;

    /** A join that starts before the first entity; `sizeA` and `sizeB` are the stores' sizes. */
    constructor(sizeA : i32, sizeB : i32) {
        self.current = EntityId::none();
        self.walkSecond = sizeB < sizeA;
    }

    /** The entity the last successful `next` stopped at. */
    pub fn entity(self) : EntityId {
        return self.current;
    }

    /** Moves to the next entity that has a component in both `a` and `b`; false when there is none left. */
    pub fn next(mut self, world : World, a : ComponentStore<A>, b : ComponentStore<B>) : bool {
        let mut limit : i32 = a.len();
        if (self.walkSecond) {
            limit = b.len();
        }

        self.at = self.at + 1;
        while (self.at < limit) {
            let mut e : EntityId = a.entityAt(self.at);
            if (self.walkSecond) {
                e = b.entityAt(self.at);
            }
            if (a.has(world, e) && b.has(world, e)) {
                self.current = e;
                return true;
            }
            self.at = self.at + 1;
        }

        return false;
    }
}

/** A cursor over the entities that have a component in each of three stores, in the first store's order. */
pub class Join3<A, B, C> {
    at      : i32 = -1;
    current : EntityId;

    /** A join that starts before the first entity. */
    constructor() {
        self.current = EntityId::none();
    }

    /** The entity the last successful `next` stopped at. */
    pub fn entity(self) : EntityId {
        return self.current;
    }

    /** Moves to the next entity that has a component in `a`, `b` and `c`; false when there is none left. */
    pub fn next(
        mut self,
        world : World,
        a : ComponentStore<A>,
        b : ComponentStore<B>,
        c : ComponentStore<C>
    ) : bool {
        self.at = self.at + 1;
        while (self.at < a.len()) {
            // The first store is the smallest by contract, so its dense order is the one walked.
            let e : EntityId = a.entityAt(self.at);
            if (a.has(world, e) && b.has(world, e) && c.has(world, e)) {
                self.current = e;
                return true;
            }
            self.at = self.at + 1;
        }
        return false;
    }
}

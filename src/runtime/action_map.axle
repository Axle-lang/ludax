// action_map — what the player means, not which key they pressed.
//
// A game asks for "jump" and "steer", never for key 32 or axis 0. An `ActionMap` holds named actions and the
// bindings that feed them: a key, a chord (two codes together, like ctrl+S), an analog axis with a dead zone
// and a scale, or a pair of keys standing in for an axis (A and D for steering). `evaluate` reads one
// `InputState` and gives every action a value in [-1, 1]; an action is "down" when that value is at least
// half. When several bindings feed one action, the strongest wins (the first on a tie), so a stick and a key
// can steer the same wheel. Pressed and released are changes of "down" between two `evaluate` calls, so call it
// once per simulation step.

use crate::core::collections::vec::Vec;
use crate::core::id::string_id::{StringId, StringInterner};
use crate::core::math::scalar::{abs, clamp};
use crate::runtime::input_state::InputState;

/** An action counts as down at or above this absolute value. */
pub const ACTION_PRESS_LEVEL : f32 = 0.5;

// The four ways a binding can read the snapshot.
enum BindKind : i8 {
    Key = 0,
    Chord = 1,
    Axis = 2,
    KeyPair = 3,
}

struct ActionBinding {
    action : i32;
    kind   : BindKind;
    code   : i32 = 0;
    other  : i32 = 0;
    scale  : f32 = 1.0;
    dead   : f32 = 0.0;
}

/** Named actions and the bindings that drive them. */
pub class ActionMap {
    names    : StringInterner;
    binds    : Vec<ActionBinding>;
    value    : Vec<f32>;
    nowDown  : Vec<bool>;
    prevDown : Vec<bool>;

    /** No actions. */
    constructor() {
        self.names = new StringInterner();
        self.binds = new Vec<ActionBinding>();
        self.value = new Vec<f32>();
        self.nowDown = new Vec<bool>();
        self.prevDown = new Vec<bool>();
    }

    /** The number of action `name`, declaring it on first use. */
    pub fn action(mut self, name : string) : i32 {
        let known : StringId = self.names.find(name);
        if (!known.isNone()) {
            return known.raw;
        }
        let id : StringId = self.names.intern(name);
        self.value.push(0.0);
        self.nowDown.push(false);
        self.prevDown.push(false);
        return id.raw;
    }

    /** The number of action `name`, or -1 when it was never declared. */
    pub fn find(self, name : string) : i32 {
        return self.names.find(name).raw;
    }

    /** How many actions exist. */
    pub fn count(self) : i32 {
        return self.value.len();
    }

    /** The name of the action. */
    pub fn nameOf(self, action : i32) : string {
        return self.names.name(StringId { raw: action }) + "";
    }

    /** The action is 1 while key or button `code` is down. */
    pub fn bindKey(mut self, action : i32, code : i32) : void {
        self.binds.push(ActionBinding { action: action, kind: BindKind::Key, code: code });
    }

    /** The action is 1 while both `first` and `second` are down (a chord such as ctrl+S). */
    pub fn bindChord(mut self, action : i32, first : i32, second : i32) : void {
        self.binds.push(ActionBinding { action: action, kind: BindKind::Chord, code: first, other: second });
    }

    /**
     * The action follows analog axis `axis` times `scale`; readings within `dead` of zero count as zero and
     * the rest is stretched so the value still reaches the full range.
     */
    pub fn bindAxis(mut self, action : i32, axis : i32, scale : f32, dead : f32) : void {
        self.binds.push(ActionBinding {
            action: action,
            kind: BindKind::Axis,
            code: axis,
            scale: scale,
            dead: dead,
        });
    }

    /** The action is -`scale` while `negative` is down and +`scale` while `positive` is down (both: 0). */
    pub fn bindKeyPair(mut self, action : i32, negative : i32, positive : i32, scale : f32) : void {
        self.binds.push(ActionBinding {
            action: action,
            kind: BindKind::KeyPair,
            code: negative,
            other: positive,
            scale: scale,
        });
    }

    /** Removes every binding of the action (rebinding starts with this). */
    pub fn clearBindings(mut self, action : i32) : void {
        let mut i : i32 = 0;
        while (i < self.binds.len()) {
            if (self.binds.get(i).action == action) {
                self.binds.removeAt(i);
            } else {
                i = i + 1;
            }
        }
    }

    /** How many bindings exist. */
    pub fn bindingCount(self) : i32 {
        return self.binds.len();
    }

    // The dead-zoned reading of an axis value.
    static fn deadZone(raw : f32, dead : f32) : f32 {
        let mag : f32 = abs(raw);
        if (mag <= dead || dead >= 1.0) {
            return 0.0;
        }
        let stretched : f32 = (mag - dead) / ((1.0 as f32) - dead);
        return ActionMap::signOf(raw) * stretched;
    }

    // The sign of a non-zero real: 1 or -1.
    static fn signOf(v : f32) : f32 {
        if (v < 0.0) {
            return -1.0;
        }
        return 1.0;
    }

    // What one binding says about the snapshot.
    fn read(self, binding : ActionBinding, input : InputState) : f32 {
        return match binding.kind {
            BindKind::Key => ActionMap::held(input.isDown(binding.code), binding.scale),
            BindKind::Chord => ActionMap::held(
                input.isDown(binding.code) && input.isDown(binding.other),
                binding.scale
            ),
            BindKind::Axis => ActionMap::deadZone(input.axis(binding.code), binding.dead) * binding.scale,
            BindKind::KeyPair => ActionMap::pair(input, binding),
        };
    }

    // +scale while the positive key is down, -scale while the negative one is (both cancel).
    static fn pair(input : InputState, binding : ActionBinding) : f32 {
        let mut v : f32 = 0.0;
        if (input.isDown(binding.other)) {
            v = v + binding.scale;
        }
        if (input.isDown(binding.code)) {
            v = v - binding.scale;
        }
        return v;
    }

    // A binding that answers its full scale when held and nothing when not.
    static fn held(down : bool, scale : f32) : f32 {
        if (down) {
            return scale;
        }
        return 0.0;
    }

    /** Reads the snapshot and updates every action's value and its pressed/released state. */
    pub fn evaluate(mut self, input : InputState) : void {
        for (action of 0..self.value.len()) {
            self.prevDown.set(action, self.nowDown.get(action));
            self.value.set(action, 0.0);
        }
        for (i of 0..self.binds.len()) {
            let binding : ActionBinding = self.binds.get(i);
            let v : f32 = self.read(binding, input);
            if (abs(v) > abs(self.value.get(binding.action))) {
                self.value.set(binding.action, v);
            }
        }
        for (action of 0..self.value.len()) {
            let v : f32 = clamp(self.value.get(action), -1.0, 1.0);
            self.value.set(action, v);
            self.nowDown.set(action, abs(v) >= ACTION_PRESS_LEVEL);
        }
    }

    /** The value of the action from the last `evaluate`, in [-1, 1]. */
    pub fn valueOf(self, action : i32) : f32 {
        return self.value.getOr(action, 0.0);
    }

    /** True while the action is down. */
    pub fn isDown(self, action : i32) : bool {
        return self.nowDown.getOr(action, false);
    }

    /** True when the action went down in the last `evaluate`. */
    pub fn wasPressed(self, action : i32) : bool {
        return self.nowDown.getOr(action, false) && !self.prevDown.getOr(action, false);
    }

    /** True when the action went up in the last `evaluate`. */
    pub fn wasReleased(self, action : i32) : bool {
        return !self.nowDown.getOr(action, false) && self.prevDown.getOr(action, false);
    }
}

// fan_out — a parallel-for over a component store, on the job pool.
//
// A system that does the same thing to every component of one kind (move every body, age every particle) can
// be cut into chunks and spread over the pool's workers. `FanOut` is the small helper that chooses the cut and
// runs it. The work itself is a `RangeKernel` that owns its inputs and writes each result at the index it was
// given (see the determinism contract in `core/jobs/kernel`): then the answer is the same with one worker or
// sixteen, and the store's dense order (`0..len()`) is exactly the index space the kernel is handed.

use crate::core::jobs::kernel::{RangeKernel, chunkCount};
use crate::core::jobs::pool::JobPool;
use crate::core::math::scalar::maxI;

/** How many chunks of work each worker is given at the automatic grain. */
const FAN_CHUNKS_PER_WORKER : i32 = 4;

/** A pool bound to one kernel, with helpers to run it over a store or a count. */
pub class FanOut {
    pool    : JobPool;
    workers : i32 = 1;

    /** Starts `workers` threads (0 or less: one fewer than the machine has) that will run `kernel`; keep the kernel alive until `shutdown`. */
    constructor(workers : i32, kernel : RangeKernel) {
        let mut n : i32 = workers;
        if (n <= 0) {
            n = JobPool::defaultWorkers();
        }
        self.pool = new JobPool(n, kernel);
        self.workers = self.pool.workerCount();
    }

    /** How many worker threads run. */
    pub fn workerCount(self) : i32 {
        return self.workers;
    }

    /** A grain that gives each worker about four chunks (at least `minGrain` items per chunk). */
    pub static fn grainFor(count : i32, workers : i32, minGrain : i32) : i32 {
        let w : i32 = maxI(workers, 1);
        let even : i32 = count / (w * FAN_CHUNKS_PER_WORKER);
        return maxI(maxI(even, minGrain), 1);
    }

    /** Runs the kernel over `[0, count)` with an automatic grain and waits; false when the pool has been shut down. */
    pub fn forCount(mut self, count : i32, minGrain : i32) : bool {
        return self.pool.run(count, FanOut::grainFor(count, self.workers, minGrain));
    }

    /** How many chunks a run over `count` items makes at the automatic grain. */
    pub fn chunksFor(self, count : i32, minGrain : i32) : i32 {
        return chunkCount(count, FanOut::grainFor(count, self.workers, minGrain));
    }

    /** Stops the workers. */
    pub fn shutdown(mut self) : void {
        self.pool.shutdown();
    }
}

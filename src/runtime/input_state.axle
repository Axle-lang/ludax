// input_state — one frame of input as plain data.
//
// Whatever the platform reports (key events, mouse motion, a gamepad's sticks) is boiled down to a snapshot the
// simulation reads: which of 320 digital codes are down, the mouse movement since the last snapshot, and eight
// analog axes. Codes 0..255 are keys (the platform's numbering), 256..271 mouse buttons and 272..319 gamepad
// buttons. The snapshot also remembers the previous frame's down bits, so "went down this frame" and "went up
// this frame" are answers, not events someone must have caught.
//
// Analog values are kept as integers in 1/4096 units. That is not a limitation to apologise for: it makes a
// snapshot exactly comparable, hashable and recordable (see `input_tape`), so a replay feeds the simulation
// bit-for-bit what the live run saw.

use crate::core::id::hash::combineHash;

/** How many digital codes (keys and buttons) a snapshot holds. */
pub const INPUT_CODES : i32 = 320;

/** How many analog axes a snapshot holds. */
pub const INPUT_AXES : i32 = 8;

/** The 32-bit words that hold the down bits. */
pub const INPUT_WORDS : i32 = 10;

/** Analog values are stored in this many units per 1.0. */
pub const INPUT_UNIT : i32 = 4096;

// A digital code names one bit of a 32-bit word.
const INPUT_CODE_SHIFT : i32 = 5;
const INPUT_CODE_MASK : i32 = 31;

// The seed of the snapshot hash (the FNV-1a 64-bit offset basis).
const INPUT_HASH_SEED : i64 = 1469598103934665603;

/** One frame of input. */
pub class InputState {
    down  : i32[];
    prev  : i32[];
    axisQ : i32[];
    dxQ   : i32 = 0;
    dyQ   : i32 = 0;

    /** Nothing pressed, nothing moved. */
    constructor() {
        self.down = malloc<i32>(INPUT_WORDS as i64);
        self.prev = malloc<i32>(INPUT_WORDS as i64);
        self.axisQ = malloc<i32>(INPUT_AXES as i64);
        for (i of 0..INPUT_WORDS) {
            self.down[i] = 0;
            self.prev[i] = 0;
        }
        for (i of 0..INPUT_AXES) {
            self.axisQ[i] = 0;
        }
    }

    /** The code of mouse button `n` (0 to 15). */
    pub static fn mouseButton(n : i32) : i32 {
        return 256 + n;
    }

    /** The code of gamepad button `n` (0 to 47). */
    pub static fn padButton(n : i32) : i32 {
        return 272 + n;
    }

    /** Starts a new frame: what is down now becomes "before", and the mouse movement restarts from zero. Axes keep their level. */
    pub fn beginFrame(mut self) : void {
        for (i of 0..INPUT_WORDS) {
            self.prev[i] = self.down[i];
        }
        self.dxQ = 0;
        self.dyQ = 0;
    }

    /** Puts a key or button down or up; codes outside the range are ignored. */
    pub fn setDown(mut self, code : i32, isDown : bool) : void {
        if (code < 0 || code >= INPUT_CODES) {
            return;
        }
        let word : i32 = code >> INPUT_CODE_SHIFT;
        let bit : i32 = 1 << (code & INPUT_CODE_MASK);
        if (isDown) {
            self.down[word] = self.down[word] | bit;
        } else {
            self.down[word] = self.down[word] & (bit ^ -1);
        }
    }

    /** True while `code` is down. */
    pub fn isDown(self, code : i32) : bool {
        if (code < 0 || code >= INPUT_CODES) {
            return false;
        }
        return (self.down[code >> INPUT_CODE_SHIFT] & (1 << (code & INPUT_CODE_MASK))) != 0;
    }

    /** True when `code` is down now and was up at the start of the frame. */
    pub fn wasPressed(self, code : i32) : bool {
        if (code < 0 || code >= INPUT_CODES) {
            return false;
        }
        let bit : i32 = 1 << (code & INPUT_CODE_MASK);
        return (self.down[code >> INPUT_CODE_SHIFT] & bit) != 0
            && (self.prev[code >> INPUT_CODE_SHIFT] & bit) == 0;
    }

    /** True when `code` is up now and was down at the start of the frame. */
    pub fn wasReleased(self, code : i32) : bool {
        if (code < 0 || code >= INPUT_CODES) {
            return false;
        }
        let bit : i32 = 1 << (code & INPUT_CODE_MASK);
        return (self.down[code >> INPUT_CODE_SHIFT] & bit) == 0
            && (self.prev[code >> INPUT_CODE_SHIFT] & bit) != 0;
    }

    /** How many codes are down. */
    pub fn downCount(self) : i32 {
        let mut n : i32 = 0;
        for (c of 0..INPUT_CODES) {
            if (self.isDown(c)) {
                n = n + 1;
            }
        }
        return n;
    }

    // A real number as stored units, rounded half away from zero.
    static fn quantise(v : f32) : i32 {
        let scaled : f64 = v as f64 * INPUT_UNIT as f64;
        if (scaled >= 0.0) {
            return (scaled + 0.5) as i32;
        }
        return 0 - ((0.0 - scaled + 0.5) as i32);
    }

    /** Adds mouse movement (in pixels) to this frame's total. */
    pub fn addMouseDelta(mut self, dx : f32, dy : f32) : void {
        self.dxQ = self.dxQ + InputState::quantise(dx);
        self.dyQ = self.dyQ + InputState::quantise(dy);
    }

    /** Mouse movement this frame, horizontal. */
    pub fn mouseDx(self) : f32 {
        return InputState::unitsToReal(self.dxQ);
    }

    /** Mouse movement this frame, vertical. */
    pub fn mouseDy(self) : f32 {
        return InputState::unitsToReal(self.dyQ);
    }

    /** Sets axis `i` (0 to 7) to `v`, clamped to [-1, 1]. */
    pub fn setAxis(mut self, i : i32, v : f32) : void {
        if (i < 0 || i >= INPUT_AXES) {
            return;
        }
        let mut q : i32 = InputState::quantise(v);
        if (q > INPUT_UNIT) {
            q = INPUT_UNIT;
        }
        if (q < 0 - INPUT_UNIT) {
            q = 0 - INPUT_UNIT;
        }
        self.axisQ[i] = q;
    }

    /** Axis `i`, from -1 to 1; 0 for an axis out of range. */
    pub fn axis(self, i : i32) : f32 {
        if (i < 0 || i >= INPUT_AXES) {
            return 0.0;
        }
        return InputState::unitsToReal(self.axisQ[i]);
    }

    /** Releases everything and zeroes the axes and the mouse (the previous-frame bits stay). */
    pub fn clear(mut self) : void {
        for (i of 0..INPUT_WORDS) {
            self.down[i] = 0;
        }
        for (i of 0..INPUT_AXES) {
            self.axisQ[i] = 0;
        }
        self.dxQ = 0;
        self.dyQ = 0;
    }

    // Stored units back to a real, in the range the axis or the mouse had.
    static fn unitsToReal(q : i32) : f32 {
        return (q as f64 / INPUT_UNIT as f64) as f32;
    }

    /** True when both snapshots hold the same down bits, mouse movement and axes (the previous-frame bits are not compared). */
    pub fn sameAs(self, o : InputState) : bool {
        for (i of 0..INPUT_WORDS) {
            if (self.down[i] != o.down[i]) {
                return false;
            }
        }
        for (i of 0..INPUT_AXES) {
            if (self.axisQ[i] != o.axisQ[i]) {
                return false;
            }
        }
        return self.dxQ == o.dxQ && self.dyQ == o.dyQ;
    }

    /** A hash of what `sameAs` compares: equal snapshots, equal hashes. */
    pub fn hash(self) : i64 {
        let mut h : i64 = INPUT_HASH_SEED;
        for (i of 0..INPUT_WORDS) {
            h = combineHash(h, self.down[i] as i64);
        }
        for (i of 0..INPUT_AXES) {
            h = combineHash(h, self.axisQ[i] as i64);
        }
        h = combineHash(h, self.dxQ as i64);
        return combineHash(h, self.dyQ as i64);
    }

    // The tape's view of a snapshot: field `f` of 20 (10 words, 2 mouse, 8 axes) as a number.
    pub(crate) fn field(self, f : i32) : i32 {
        if (f < INPUT_WORDS) {
            return self.down[f];
        }
        if (f == INPUT_WORDS) {
            return self.dxQ;
        }
        if (f == INPUT_WORDS + 1) {
            return self.dyQ;
        }
        return self.axisQ[f - INPUT_WORDS - 2];
    }

    // Sets field `f` (see `field`).
    pub(crate) fn setField(mut self, f : i32, v : i32) : void {
        if (f < INPUT_WORDS) {
            self.down[f] = v;
        } else if (f == INPUT_WORDS) {
            self.dxQ = v;
        } else if (f == INPUT_WORDS + 1) {
            self.dyQ = v;
        } else {
            self.axisQ[f - INPUT_WORDS - 2] = v;
        }
    }
}

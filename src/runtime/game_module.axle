// game_module — the seam between the main loop and a game.
//
// The loop knows nothing about what it runs. A game (or the physics, animation and audio layers, once they
// plug in) implements `GameModule`, and `GameLoop<M>` calls it in a fixed order every frame: `input` once,
// `simulate` for every whole fixed step the clock released, `render` once with the interpolation factor.
// Axle cannot keep a class in a trait-typed field, so the loop is generic over the module type and takes the
// module as an argument of every `frame` call instead of holding it: the module stays the caller's.

/**
 * What a game offers the main loop. `simulate` is the only place game state may change; `render` must not
 * change it, and `input` only reads devices into the state the next `simulate` will use.
 */
pub trait GameModule {
    /** Reads devices once per frame; `frame` counts frames from 0. */
    fn input(mut self, frame : i64) : void;

    /** Advances the simulation by one fixed step of `dt` seconds; `tick` counts steps from 0. */
    fn simulate(mut self, tick : i64, dt : f32) : void;

    /** Draws the state, `alpha` of the way from the previous step to the next (0 to just under 1). */
    fn render(mut self, alpha : f32) : void;

    /** True when the game wants the loop to end; asked after every step and every frame. */
    fn wantsQuit(self) : bool;
}

/**
 * A module that only counts what it is asked to do. It is the library's one implementor of `GameModule`
 * (Axle refuses a function taking a trait nobody implements) and a probe for the loop's own tests.
 */
pub class CountingModule : GameModule {
    /** Frames whose `input` was called. */
    pub inputs : i64 = 0;

    /** Steps simulated. */
    pub steps : i64 = 0;

    /** Frames rendered. */
    pub renders : i64 = 0;

    /** The `alpha` of the last render. */
    pub lastAlpha : f32 = 0.0;

    /** The tick number of the last step. */
    pub lastTick : i64 = -1;

    /** Quits after this many steps (0: never). */
    pub quitAfterSteps : i64 = 0;

    /** A module that counts and never quits. */
    constructor() {}

    /** Counts a frame of input. */
    pub fn input(mut self, frame : i64) : void {
        self.inputs = self.inputs + 1;
    }

    /** Counts a step. */
    pub fn simulate(mut self, tick : i64, dt : f32) : void {
        self.steps = self.steps + 1;
        self.lastTick = tick;
    }

    /** Counts a render. */
    pub fn render(mut self, alpha : f32) : void {
        self.renders = self.renders + 1;
        self.lastAlpha = alpha;
    }

    /** True once `quitAfterSteps` steps have run. */
    pub fn wantsQuit(self) : bool {
        return self.quitAfterSteps > 0 && self.steps >= self.quitAfterSteps;
    }
}

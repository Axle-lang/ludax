// ieee — IEEE 754 single-precision numbers to and from their 32 bits.
//
// Binary model files store floats as raw bits. Axle has no reinterpreting cast, so the bits are taken apart
// and put back with arithmetic: a sign, an 8-bit exponent and a 23-bit fraction become `fraction * 2^exponent`,
// computed in f64 where every step is exact, then narrowed to f32 (exact again, because the value came from
// an f32). Infinities and NaNs have no place in a model; `isFinite` lets a reader refuse them.

const IEEE_EXP_BITS : i32 = 23;
const IEEE_EXP_MAX : i32 = 255;
const IEEE_MANTISSA_MASK : i32 = 8388607;
const IEEE_HIDDEN_BIT : i32 = 8388608;
const IEEE_BIAS : i32 = 127;
const IEEE_SIGN_BIT : i32 = -2147483648;
// 2^-126 is the smallest normal; below it the fraction alone carries the value.
const IEEE_MIN_NORMAL_EXPONENT : i32 = -126;
// 2^-149 is the smallest subnormal, so a subnormal is its integer fraction times that.
const IEEE_SUBNORMAL_SHIFT : i32 = 149;
// A normal value is (fraction + hidden bit) * 2^(exponent - 150): the bias plus the mantissa bits, written out
// because a top-level constant must be a literal.
const IEEE_NORMAL_SHIFT : i32 = 150;

/** Conversions between f32 and its bit pattern. */
pub class Ieee {
    // 2 raised to the whole number `k` (|k| <= 300), exactly.
    static fn pow2(k : i32) : f64 {
        let mut n : i32 = k;
        let mut base : f64 = 2.0;
        if (n < 0) {
            n = -n;
            base = 0.5;
        }
        let mut result : f64 = 1.0;
        while (n > 0) {
            if ((n & 1) == 1) {
                result = result * base;
            }
            base = base * base;
            n = n >> 1;
        }
        return result;
    }

    /** True unless the bits are an infinity or a NaN. */
    pub static fn isFinite(bits : i32) : bool {
        return ((bits >>> IEEE_EXP_BITS) & IEEE_EXP_MAX) != IEEE_EXP_MAX;
    }

    /** The f32 whose bits are `bits`; infinities and NaNs give 0 (check `isFinite` first if that matters). */
    pub static fn toF32(bits : i32) : f32 {
        let e : i32 = (bits >>> IEEE_EXP_BITS) & IEEE_EXP_MAX;
        let frac : i32 = bits & IEEE_MANTISSA_MASK;
        if (e == IEEE_EXP_MAX) {
            return 0.0;
        }
        let mut mag : f64 = 0.0;
        if (e == 0) {
            mag = (frac as f64) * Ieee::pow2(-IEEE_SUBNORMAL_SHIFT);
        } else {
            mag = ((frac + IEEE_HIDDEN_BIT) as f64) * Ieee::pow2(e - IEEE_NORMAL_SHIFT);
        }
        if (bits < 0) {
            mag = -mag;
        }
        return mag as f32;
    }

    /** The bits of the finite f32 `x`; zero and negative zero both give 0, and only a non-zero negative value sets the sign bit. */
    pub static fn bitsOf(x : f32) : i32 {
        let v : f64 = x as f64;
        if (v == 0.0) {
            return 0;
        }

        let mut sign : i32 = 0;
        let mut a : f64 = v;
        if (a < 0.0) {
            sign = IEEE_SIGN_BIT;
            a = -a;
        }
        if (a < Ieee::pow2(IEEE_MIN_NORMAL_EXPONENT)) {
            return sign | ((a * Ieee::pow2(IEEE_SUBNORMAL_SHIFT)) as i32);
        }

        let mut e : i32 = 0;
        while (a >= Ieee::pow2(e + 1)) {
            e = e + 1;
        }
        while (a < Ieee::pow2(e)) {
            e = e - 1;
        }
        let frac : i32 = ((a / Ieee::pow2(e) - 1.0) * (IEEE_HIDDEN_BIT as f64)) as i32;
        return sign | ((e + IEEE_BIAS) << IEEE_EXP_BITS) | frac;
    }
}

// mesh_shapes — meshes made in code: box, sphere and plane.
//
// Test scenes, debug geometry, light proxies and the ground of a prototype all want a mesh without a file.
// Every shape is built with positions, outward normals, texture coordinates (`v` down) and tangents, wound
// counter-clockwise seen from outside, centred on the origin. Sizes are clamped to something drawable
// (a side of at least 0, a sphere of at least 3 segments and 2 rings) so a bad argument gives a small mesh,
// not an abort. The sphere uses the engine's own `sin` and `cos`, so it is the same on every machine.

use crate::core::math::scalar::{PI, TAU};
use crate::core::math::trig::{cos, sin};
use crate::core::math::vec2::Vec2;
use crate::core::math::vec3::Vec3;
use crate::data::model::mesh::Mesh;

const SHAPE_MIN_SEGMENTS : i32 = 3;
const SHAPE_MIN_RINGS : i32 = 2;
const SHAPE_MIN_CELLS : i32 = 1;

/** Builders for simple meshes. */
pub class MeshShapes {
    /** A box of size `w` x `h` x `d` centred on the origin: 24 vertices (flat faces), 12 triangles. */
    pub static fn box(w : f32, h : f32, d : f32) : Mesh {
        let m : Mesh = new Mesh();
        let half : Vec3 = Vec3 { x: w * (0.5 as f32), y: h * (0.5 as f32), z: d * (0.5 as f32) };

        MeshShapes::face(m, half, Vec3::unitX(), Vec3::unitZ().negated(), Vec3::unitY());
        MeshShapes::face(m, half, Vec3::unitX().negated(), Vec3::unitZ(), Vec3::unitY());
        MeshShapes::face(m, half, Vec3::unitY(), Vec3::unitX(), Vec3::unitZ().negated());
        MeshShapes::face(m, half, Vec3::unitY().negated(), Vec3::unitX(), Vec3::unitZ());
        MeshShapes::face(m, half, Vec3::unitZ(), Vec3::unitX(), Vec3::unitY());
        MeshShapes::face(m, half, Vec3::unitZ().negated(), Vec3::unitX().negated(), Vec3::unitY());

        m.computeTangents();
        return m;
    }

    // One face of a box: `n` the outward direction, `u` to the right and `v` up as seen from outside (u x v = n).
    static fn face(m : Mesh, half : Vec3, n : Vec3, u : Vec3, v : Vec3) : void {
        let centre : Vec3 = n.times(half);
        let eu : Vec3 = u.times(half);
        let ev : Vec3 = v.times(half);
        let base : i32 = m.vertexCount();

        m.addVertex(centre.minus(eu).minus(ev), n, Vec2 { x: 0.0, y: 1.0 });
        m.addVertex(centre.plus(eu).minus(ev), n, Vec2 { x: 1.0, y: 1.0 });
        m.addVertex(centre.plus(eu).plus(ev), n, Vec2 { x: 1.0, y: 0.0 });
        m.addVertex(centre.minus(eu).plus(ev), n, Vec2 { x: 0.0, y: 0.0 });
        m.addTriangle(base, base + 1, base + 2);
        m.addTriangle(base, base + 2, base + 3);
    }

    /** A sphere of `radius` with `segments` around and `rings` from pole to pole; poles on the Y axis. (segments + 1) * (rings + 1) vertices. */
    pub static fn sphere(radius : f32, segments : i32, rings : i32) : Mesh {
        let m : Mesh = new Mesh();
        let seg : i32 = MeshShapes::atLeast(segments, SHAPE_MIN_SEGMENTS);
        let rng : i32 = MeshShapes::atLeast(rings, SHAPE_MIN_RINGS);

        for (r of 0..(rng + 1)) {
            let phi : f32 = PI * (r as f32) / (rng as f32);
            let y : f32 = cos(phi);
            let ring : f32 = sin(phi);
            for (s of 0..(seg + 1)) {
                let theta : f32 = TAU * (s as f32) / (seg as f32);
                let n : Vec3 = Vec3 { x: ring * cos(theta), y: y, z: ring * sin(theta) };
                let uv : Vec2 = Vec2 { x: (s as f32) / (seg as f32), y: (r as f32) / (rng as f32) };
                m.addVertex(n.scale(radius), n, uv);
            }
        }

        for (r of 0..rng) {
            for (s of 0..seg) {
                let a : i32 = r * (seg + 1) + s;
                let b : i32 = a + seg + 1;
                // The pole rings collapse to one point, so their degenerate triangles are omitted.
                if (r != 0) {
                    m.addTriangle(a, a + 1, b);
                }
                if (r != rng - 1) {
                    m.addTriangle(a + 1, b + 1, b);
                }
            }
        }

        m.computeTangents();
        return m;
    }

    /** A flat plane of `width` (X) by `depth` (Z) facing +Y, cut into `divX` x `divZ` cells. */
    pub static fn plane(width : f32, depth : f32, divX : i32, divZ : i32) : Mesh {
        let m : Mesh = new Mesh();
        let nx : i32 = MeshShapes::atLeast(divX, SHAPE_MIN_CELLS);
        let nz : i32 = MeshShapes::atLeast(divZ, SHAPE_MIN_CELLS);

        for (j of 0..(nz + 1)) {
            for (i of 0..(nx + 1)) {
                let fu : f32 = (i as f32) / (nx as f32);
                let fv : f32 = (j as f32) / (nz as f32);
                let p : Vec3 = Vec3 {
                    x: (fu - (0.5 as f32)) * width,
                    y: 0.0,
                    z: (fv - (0.5 as f32)) * depth,
                };
                m.addVertex(p, Vec3::unitY(), Vec2 { x: fu, y: fv });
            }
        }

        for (j of 0..nz) {
            for (i of 0..nx) {
                let a : i32 = j * (nx + 1) + i;
                let b : i32 = a + nx + 1;
                m.addTriangle(a, b, a + 1);
                m.addTriangle(a + 1, b, b + 1);
            }
        }

        m.computeTangents();
        return m;
    }

    // `v` raised to `least`, so a shape asked for with a bad size is still drawable.
    static fn atLeast(v : i32, least : i32) : i32 {
        if (v < least) {
            return least;
        }
        return v;
    }
}

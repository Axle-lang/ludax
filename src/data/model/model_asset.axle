// model_asset — an imported model: meshes, materials, a node tree, skins, clips and textures.
//
// The common result of the glTF and Blockbench importers, and the value of a model asset in the asset
// database. Everything is plain data addressed by index: a node names its mesh and skin by index, a mesh
// primitive names its material, a material names its texture. Nothing refers to files any more; the
// importer has read every buffer and decoded every picture it could. Counts and indices are checked by the
// importer, but an index read from a model is still looked up with the `…Count` methods first.
//
// A model that failed to import is an empty one with `ok()` false and `error()` saying why. `warnings`
// lists what was skipped on the way (a point primitive, a texture in a format we cannot decode) without
// failing the import.

use crate::core::collections::vec::Vec;
use crate::core::math::mat4::Mat4;
use crate::core::math::transform::Transform;
use crate::core::math::vec3::Vec3;
use crate::core::math::vec4::Vec4;
use crate::data::image::image::Image;
use crate::data::model::mesh::Mesh;
use crate::data::model::model_anim::{ModelClip, ModelSkin};
use crate::data::slots::DataSlots;
use crate::data::text::DataText;

// A parent chain longer than this is a cycle; stop rather than walk it forever.
const MODEL_NODE_DEPTH_LIMIT : i32 = 10000;

/** Surface parameters of a material (the metallic-roughness model of glTF). */
pub class ModelMaterial {
    /** The material's name. */
    pub name : string;

    /** Base colour multiplier, linear RGBA. */
    pub baseColor : Vec4 = Vec4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 };

    /** 0 for a dielectric, 1 for a metal. */
    pub metallic : f32 = 1.0;

    /** 0 mirror-smooth, 1 fully rough. */
    pub roughness : f32 = 1.0;

    /** Emitted light, linear RGB. */
    pub emissive : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** The index of the base colour picture in the model's textures, or -1. */
    pub baseColorTexture : i32 = -1;

    /** A default white material. */
    constructor(name : string) {
        self.name = DataText::copy(name);
    }
}

/** A mesh with one or more primitives, each a `Mesh` drawn with one material. */
pub class ModelMesh {
    /** The mesh's name. */
    pub name  : string;
    parts     : DataSlots<Mesh>;
    materials : Vec<i32>;

    /** An empty mesh. */
    constructor(name : string) {
        self.name = DataText::copy(name);
        self.parts = new DataSlots<Mesh>();
        self.materials = new Vec<i32>();
    }

    /** Adds a primitive drawn with material number `material` (-1 for none); the mesh takes it over. */
    pub fn addPrimitive(mut self, own part : Mesh, material : i32) : void {
        self.parts.push(part);
        self.materials.push(material);
    }

    /** How many primitives. */
    pub fn primitiveCount(self) : i32 {
        return self.parts.len();
    }

    /** The geometry of primitive `i`. */
    pub fn primitive(self, i : i32) : Mesh {
        return self.parts.get(i);
    }

    /** The material index of primitive `i`, or -1. */
    pub fn material(self, i : i32) : i32 {
        return self.materials.get(i);
    }
}

/** A node of the scene tree. */
pub class ModelNode {
    /** The node's name. */
    pub name : string;

    /** The index of the parent node, or -1 for a root. */
    pub parent : i32 = -1;

    /** Indices of the child nodes, in file order. */
    pub children : Vec<i32>;

    /** The mesh index, or -1. */
    pub mesh : i32 = -1;

    /** The skin index, or -1. */
    pub skin : i32 = -1;

    /** The placement relative to the parent. A node given as a matrix is decomposed into this. */
    pub local : Transform = Transform {};

    /** True when the file gave the placement as a matrix (kept exactly in `matrix`). */
    pub hasMatrix : bool = false;

    /** The matrix from the file, valid when `hasMatrix`. */
    pub matrix : Mat4 = Mat4 {};

    /** A node with no content. */
    constructor(name : string) {
        self.name = DataText::copy(name);
        self.children = new Vec<i32>();
    }
}

/** A whole imported model. */
pub class ModelAsset {
    /** The model's name ("" when the file gave none). */
    pub name     : string;
    failure      : string;
    warningText  : string;
    meshes       : DataSlots<ModelMesh>;
    materials    : DataSlots<ModelMaterial>;
    nodes        : DataSlots<ModelNode>;
    skins        : DataSlots<ModelSkin>;
    clips        : DataSlots<ModelClip>;
    textures     : DataSlots<Image>;
    roots        : Vec<i32>;
    externalText : string;

    /** An empty model. */
    constructor() {
        self.name = "";
        self.failure = "";
        self.warningText = "";
        self.meshes = new DataSlots<ModelMesh>();
        self.materials = new DataSlots<ModelMaterial>();
        self.nodes = new DataSlots<ModelNode>();
        self.skins = new DataSlots<ModelSkin>();
        self.clips = new DataSlots<ModelClip>();
        self.textures = new DataSlots<Image>();
        self.roots = new Vec<i32>();
        self.externalText = "";
    }

    /** True when the import worked. */
    pub fn ok(self) : bool {
        return self.failure.byteLength == 0;
    }

    /** Why the import failed, or an empty string. */
    pub fn error(self) : string {
        return self.failure;
    }

    /** Marks the model as failed. */
    pub(crate) fn fail(mut self, why : string) : void {
        if (self.failure.byteLength == 0) {
            self.failure = DataText::copy(why);
        }
    }

    /** What the importer skipped, one per line; empty if nothing. */
    pub fn warnings(self) : string {
        return self.warningText;
    }

    /** Records something skipped. */
    pub(crate) fn warn(mut self, text : string) : void {
        self.warningText = "${self.warningText}${text}\n";
    }

    /** Lists the external file `path` the model was built from (the importer's record, used to declare dependencies); newline separated. */
    pub fn externalFiles(self) : string {
        return self.externalText;
    }

    /** Records an external file read. */
    pub(crate) fn noteFile(mut self, path : string) : void {
        self.externalText = "${self.externalText}${path}\n";
    }

    // ---- parts ----

    /** Adds a mesh (taken over); returns its index. */
    pub fn addMesh(mut self, own m : ModelMesh) : i32 {
        return self.meshes.push(m);
    }

    /** How many meshes. */
    pub fn meshCount(self) : i32 {
        return self.meshes.len();
    }

    /** Mesh `i`. */
    pub fn mesh(self, i : i32) : ModelMesh {
        return self.meshes.get(i);
    }

    /** Adds a material (taken over); returns its index. */
    pub fn addMaterial(mut self, own m : ModelMaterial) : i32 {
        return self.materials.push(m);
    }

    /** How many materials. */
    pub fn materialCount(self) : i32 {
        return self.materials.len();
    }

    /** Material `i`. */
    pub fn material(self, i : i32) : ModelMaterial {
        return self.materials.get(i);
    }

    /** Adds a node (taken over); returns its index. */
    pub fn addNode(mut self, own n : ModelNode) : i32 {
        return self.nodes.push(n);
    }

    /** How many nodes. */
    pub fn nodeCount(self) : i32 {
        return self.nodes.len();
    }

    /** Node `i`. */
    pub fn node(self, i : i32) : ModelNode {
        return self.nodes.get(i);
    }

    /** Adds a skin (taken over); returns its index. */
    pub fn addSkin(mut self, own s : ModelSkin) : i32 {
        return self.skins.push(s);
    }

    /** How many skins. */
    pub fn skinCount(self) : i32 {
        return self.skins.len();
    }

    /** Skin `i`. */
    pub fn skin(self, i : i32) : ModelSkin {
        return self.skins.get(i);
    }

    /** Adds an animation clip (taken over); returns its index. */
    pub fn addClip(mut self, own c : ModelClip) : i32 {
        return self.clips.push(c);
    }

    /** How many clips. */
    pub fn clipCount(self) : i32 {
        return self.clips.len();
    }

    /** Clip `i`. */
    pub fn clip(self, i : i32) : ModelClip {
        return self.clips.get(i);
    }

    /** Adds a texture picture (taken over); returns its index. */
    pub fn addTexture(mut self, own img : Image) : i32 {
        return self.textures.push(img);
    }

    /** How many texture pictures. */
    pub fn textureCount(self) : i32 {
        return self.textures.len();
    }

    /** Texture picture `i`. */
    pub fn texture(self, i : i32) : Image {
        return self.textures.get(i);
    }

    /** Makes node `i` a root of the scene to show. */
    pub fn addRoot(mut self, i : i32) : void {
        self.roots.push(i);
    }

    /** How many root nodes the default scene has. */
    pub fn rootCount(self) : i32 {
        return self.roots.len();
    }

    /** The node index of root `i`. */
    pub fn root(self, i : i32) : i32 {
        return self.roots.get(i);
    }

    /** The placement of node `i` in model space: its local placements multiplied up the tree. */
    pub fn worldMatrix(self, i : i32) : Mat4 {
        let mut m : Mat4 = Mat4::identity();
        let mut at : i32 = i;
        let mut steps : i32 = 0;
        while (at >= 0 && at < self.nodes.len() && steps < MODEL_NODE_DEPTH_LIMIT) {
            let n : ModelNode = self.nodes.get(at);
            if (n.hasMatrix) {
                m = n.matrix.mul(m);
            } else {
                m = n.local.toMat4().mul(m);
            }
            at = n.parent;
            steps = steps + 1;
        }
        return m;
    }
}

// base64 — RFC 4648 base64, and the `data:` URIs that carry it.
//
// glTF buffers and Blockbench textures travel inside JSON as base64. Decoding is forgiving about white space
// (line breaks inside long strings are common) and about the URL-safe alphabet, and strict about the rest: a
// character outside the alphabet, padding anywhere but at the end, or a length that cannot come from an
// encoder is a failure, reported by the return value, never an abort.

use crate::data::bytes::ByteBuf;
use crate::data::text::DataText;

const B64_CHAR_BITS : i32 = 6;
const B64_CHAR_MASK : i32 = 63;
const B64_BYTE_BITS : i32 = 8;
const B64_BYTE_MASK : i32 = 255;
// Three source bytes make a group of four characters; the padding character is '='.
const B64_GROUP : i32 = 4;
const B64_GROUP_BYTES : i32 = 3;
const B64_PAD : i32 = 61;
// Rounding slack for the output buffer: three source bytes make four output characters plus padding.
const B64_ENCODE_SLACK : i32 = 8;

// What `digit` answers for a character that carries no value: white space is skipped, anything else is an error.
const B64_SKIP : i32 = -1;
const B64_INVALID : i32 = -2;

// The ASCII ranges of the alphabet and the value each starts at: A-Z are 0..25, a-z 26..51, 0-9 52..61, then the
// two symbols, which come in a standard (+ /) and a URL-safe (- _) spelling.
const B64_UPPER_A : i32 = 65;
const B64_UPPER_Z : i32 = 90;
const B64_LOWER_A : i32 = 97;
const B64_LOWER_Z : i32 = 122;
const B64_DIGIT_0 : i32 = 48;
const B64_DIGIT_9 : i32 = 57;
const B64_LOWER_START : i32 = 26;
const B64_DIGIT_START : i32 = 52;
const B64_PLUS : i32 = 43;
const B64_MINUS : i32 = 45;
const B64_SLASH : i32 = 47;
const B64_UNDERSCORE : i32 = 95;
const B64_VALUE_PLUS : i32 = 62;
const B64_VALUE_SLASH : i32 = 63;

// The white space a long encoded string is wrapped with.
const B64_TAB : i32 = 9;
const B64_LF : i32 = 10;
const B64_CR : i32 = 13;
const B64_SPACE : i32 = 32;

/** Base64 coding. */
pub class Base64 {
    // The value of a base64 character, `B64_SKIP` for white space, `B64_INVALID` for anything else.
    static fn digit(c : i32) : i32 {
        if (c >= B64_UPPER_A && c <= B64_UPPER_Z) {
            return c - B64_UPPER_A;
        }
        if (c >= B64_LOWER_A && c <= B64_LOWER_Z) {
            return c - B64_LOWER_A + B64_LOWER_START;
        }
        if (c >= B64_DIGIT_0 && c <= B64_DIGIT_9) {
            return c - B64_DIGIT_0 + B64_DIGIT_START;
        }
        if (c == B64_PLUS || c == B64_MINUS) {
            return B64_VALUE_PLUS;
        }
        if (c == B64_SLASH || c == B64_UNDERSCORE) {
            return B64_VALUE_SLASH;
        }
        if (c == B64_SPACE || c == B64_TAB || c == B64_LF || c == B64_CR) {
            return B64_SKIP;
        }
        return B64_INVALID;
    }

    // True when `text` holds `marker` at byte offset `at`.
    static fn matchesAt(text : string, at : i32, marker : string) : bool {
        let m : i32 = marker.byteLength as i32;
        for (k of 0..m) {
            if (text.byteAt(at + k) != marker.byteAt(k)) {
                return false;
            }
        }
        return true;
    }

    /** Appends to `out` the bytes that `text` encodes, from byte offset `from` on; false when the text is not valid base64 (what was appended is then meaningless). */
    pub static fn decodeFrom(text : string, from : i32, out : ByteBuf) : bool {
        let n : i32 = text.byteLength as i32;
        let mut acc : i32 = 0;
        let mut bits : i32 = 0;
        let mut pad : i32 = 0;
        let mut chars : i32 = 0;
        for (i of from..n) {
            let c : i32 = text.byteAt(i) as i32;
            if (c == B64_PAD) {
                pad = pad + 1;
                continue;
            }
            let d : i32 = Base64::digit(c);
            if (d == B64_SKIP) {
                continue;
            }
            if (d == B64_INVALID || pad > 0) {
                return false;
            }
            chars = chars + 1;
            acc = (acc << B64_CHAR_BITS) | d;
            bits = bits + B64_CHAR_BITS;
            if (bits >= B64_BYTE_BITS) {
                bits = bits - B64_BYTE_BITS;
                out.push((acc >> bits) & B64_BYTE_MASK);
                acc = acc & ((1 << bits) - 1);
            }
        }
        if (chars % B64_GROUP == 1 || pad > 2) {
            return false;
        }
        if (pad > 0 && (chars + pad) % B64_GROUP != 0) {
            return false;
        }
        return true;
    }

    /** Appends to `out` the bytes `text` encodes; false when it is not valid base64. */
    pub static fn decode(text : string, out : ByteBuf) : bool {
        return Base64::decodeFrom(text, 0, out);
    }

    /** `bytes` as base64 text with padding. */
    pub static fn encode(bytes : ByteBuf) : string {
        let alphabet : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        let out : ByteBuf = new ByteBuf(bytes.len() * B64_GROUP / B64_GROUP_BYTES + B64_ENCODE_SLACK);
        let n : i32 = bytes.len();
        let mut i : i32 = 0;
        while (i < n) {
            let b0 : i32 = bytes.get(i);
            let b1 : i32 = bytes.getOr(i + 1, 0);
            let b2 : i32 = bytes.getOr(i + 2, 0);

            // The 24 bits of three bytes, cut into four 6-bit characters; the last two exist only when their
            // source bytes do, and padding stands in for the rest.
            out.push(alphabet.byteAt((b0 >> 2) & B64_CHAR_MASK) as i32);
            out.push(alphabet.byteAt(((b0 << 4) | (b1 >> 4)) & B64_CHAR_MASK) as i32);
            if (i + 1 < n) {
                out.push(alphabet.byteAt(((b1 << 2) | (b2 >> 6)) & B64_CHAR_MASK) as i32);
            } else {
                out.push(B64_PAD);
            }
            if (i + 2 < n) {
                out.push(alphabet.byteAt(b2 & B64_CHAR_MASK) as i32);
            } else {
                out.push(B64_PAD);
            }
            i = i + B64_GROUP_BYTES;
        }
        return DataText::fromBytes(out, 0, out.len());
    }

    /**
     * Where the base64 payload of a `data:` URI starts (just after `;base64,`), or -1 when `uri` is not a
     * base64 data URI.
     */
    pub static fn dataUriStart(uri : string) : i32 {
        let n : i32 = uri.byteLength as i32;
        let head : string = "data:";
        let headLen : i32 = head.byteLength as i32;
        if (n < headLen) {
            return -1;
        }
        for (i of 0..headLen) {
            if (uri.byteAt(i) != head.byteAt(i)) {
                return -1;
            }
        }

        let marker : string = ";base64,";
        let m : i32 = marker.byteLength as i32;
        for (at of headLen..(n - m + 1)) {
            if (Base64::matchesAt(uri, at, marker)) {
                return at + m;
            }
        }
        return -1;
    }
}

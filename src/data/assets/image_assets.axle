// image_assets — pictures by name, loaded once.
//
// A game asks for "grass.png" in many places and wants one decoded copy. `ImageAssets` maps a name to a small
// whole-number id (the order of first load, so ids are the same on every run), loads a file the first time a name
// is asked for, and also takes pictures made in code under a name of their choosing. A name that failed to load
// is not remembered as loaded: asking again tries again, and `lastError` says why the last attempt failed. The
// cache takes ownership of the pictures it is given; ask `get` for them afterwards.

use crate::core::collections::string_map::StringMap;
use crate::data::files::DataFiles;
use crate::data::image::image::Image;

// How many pictures an empty cache has room for before it grows.
const IMAGE_ASSET_ROOM : i32 = 8;

/** A cache of images by name. */
pub class ImageAssets {
    ids    : StringMap<i32>;
    images : Image[];
    used   : i32 = 0;
    room   : i32 = IMAGE_ASSET_ROOM;
    err    : string;
    none   : Image;

    /** An empty cache. */
    constructor() {
        self.ids = new StringMap<i32>();
        self.images = malloc<Image>(IMAGE_ASSET_ROOM as i64);
        self.err = "";
        self.none = new Image(0, 0);
    }

    /** How many pictures are held. */
    pub fn count(self) : i32 {
        return self.used;
    }

    /** Why the last `load` failed, or an empty string. */
    pub fn lastError(self) : string {
        return self.err;
    }

    /** Stores `img` under `name` (replacing a picture of that name, which keeps its id) and returns its id. */
    pub fn put(mut self, name : string, own img : Image) : i32 {
        if (self.ids.has(name)) {
            let id : i32 = self.ids.get(name);
            self.images[id] = img;
            return id;
        }

        if (self.used == self.room) {
            let mut bigger : Image[] = malloc<Image>((self.room * 2) as i64);
            for (i of 0..self.used) {
                bigger[i] = self.images[i];
            }
            self.images = bigger;
            self.room = self.room * 2;
        }
        self.images[self.used] = img;
        self.ids.put(name, self.used);
        self.used = self.used + 1;
        return self.used - 1;
    }

    /** The id of the picture called `name`, or -1 when there is none. */
    pub fn find(self, name : string) : i32 {
        return self.ids.getOr(name, -1);
    }

    /** The id of the PNG file `path`, loading it on the first ask; -1 when it cannot be read (see `lastError`). */
    pub fn load(mut self, path : string) : i32 {
        let known : i32 = self.find(path);
        if (known >= 0) {
            return known;
        }

        try {
            let img : Image = DataFiles::loadPng(path);
            self.err = "";
            return self.put(path, img);
        } catch e : IOException {
            self.err = e.message;
            return -1;
        }
    }

    /** The picture with id `id`; the empty image for an id that does not exist. */
    pub fn get(self, id : i32) : Image {
        if (id < 0 || id >= self.used) {
            return self.none;
        }
        return self.images[id];
    }
}

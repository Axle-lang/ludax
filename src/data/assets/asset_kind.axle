// asset_kind — what an asset is, and the number that names it.
//
// A kind decides how the bytes of a file are turned into a value: a picture is decoded, a JSON file parsed, a
// model imported, anything else is kept as bytes. The default kind of a path comes from its extension, so
// most callers never name one. An `AssetId` is derived from the logical path alone, so it is the same in every
// run, on every machine, and in a saved file that refers to the asset.

/** How the bytes of an asset file are read. */
pub enum AssetKind : i8 {
    Image = 0,
    Json = 1,
    Model = 2,
    Bytes = 3,

    /** The kind with code `n`; an unknown code answers Bytes. */
    pub static fn fromCode(n : i32) : AssetKind {
        return match n {
            0 => AssetKind::Image,
            1 => AssetKind::Json,
            2 => AssetKind::Model,
            _ => AssetKind::Bytes,
        };
    }

    /** The number the kind is stored as. */
    pub fn code(self) : i32 {
        return self as i32;
    }

    /** The kind's name, for messages. */
    pub fn label(self) : string {
        return match self {
            AssetKind::Image => "image",
            AssetKind::Json => "json",
            AssetKind::Model => "model",
            AssetKind::Bytes => "bytes",
        };
    }

    /** The kind a file with the (lower-case, dotted) extension `ext` is read as: `.png` image, `.json` json, `.gltf` `.glb` `.bbmodel` model, else bytes. */
    pub static fn fromExtension(ext : string) : AssetKind {
        if (ext == ".png") {
            return AssetKind::Image;
        }
        if (ext == ".json") {
            return AssetKind::Json;
        }
        if (ext == ".gltf" || ext == ".glb" || ext == ".bbmodel") {
            return AssetKind::Model;
        }
        return AssetKind::Bytes;
    }
}

/** The stable number naming an asset: a hash of its logical path. */
pub struct AssetId {
    /** The number, never negative; -1 in the none id. */
    pub raw : i32;

    /** The id of no asset: what a failed call answers. */
    pub static fn none() : AssetId {
        return AssetId { raw: -1 };
    }

    /** True for the none id. */
    pub fn isNone(self) : bool {
        return self.raw < 0;
    }

    /** True when both are the same id. */
    pub fn same(self, other : AssetId) : bool {
        return self.raw == other.raw;
    }
}

// slots — numbered storage for class values: loaded assets, the parts of a model.
//
// A `Vec` cannot hold a class in Axle, and the loaded values (images, documents, models) are classes, so this
// is the small grown-by-doubling array the asset database keeps one of per kind. A slot is numbered in the
// order it was filled and never moves, which lets the database hand out a slot number and replace the value
// under it when an asset is reloaded.

/** The slots a fresh `DataSlots` has room for before its first growth. */
const SLOTS_ROOM : i32 = 8;

/** Numbered storage for class values. */
pub(crate) class DataSlots<T> {
    items : T[];
    used  : i32 = 0;
    room  : i32;

    /** Empty storage. */
    constructor() {
        self.room = SLOTS_ROOM;
        self.items = malloc<T>(self.room as i64);
    }

    /** How many slots are filled. */
    pub(crate) fn len(self) : i32 {
        return self.used;
    }

    /** Stores `v` in a new slot and returns its number. */
    pub(crate) fn push(mut self, own v : T) : i32 {
        if (self.used == self.room) {
            self.grow();
        }
        self.items[self.used] = v;
        self.used = self.used + 1;
        return self.used - 1;
    }

    /** The value in slot `i`; the caller has checked the number. */
    pub(crate) fn get(self, i : i32) : T {
        return self.items[i];
    }

    /** Replaces the value in slot `i`. */
    pub(crate) fn set(mut self, i : i32, own v : T) : void {
        self.items[i] = v;
    }

    // Doubles the storage and copies the filled slots; a slot number stays valid across growth.
    fn grow(mut self) : void {
        let newRoom : i32 = self.room * 2;
        let mut bigger : T[] = malloc<T>(newRoom as i64);
        for (i of 0..self.used) {
            bigger[i] = self.items[i];
        }
        self.items = bigger;
        self.room = newRoom;
    }
}

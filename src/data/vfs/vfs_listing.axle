// vfs_listing — the names found in one directory of the virtual file system.
//
// A directory can be spread over several mounts, so a listing merges: each name appears once, and a name that
// is a directory in one mount and a file in another counts as a directory. Names come back in byte order, so
// the order never depends on which mount was asked first or on the disk.

use crate::core::collections::vec::Vec;
use crate::core::id::string_id::{StringId, StringInterner};
use crate::data::vfs::vfs_path::VfsPath;

// The interned id answered for a position outside the listing.
const LISTING_NO_ID : i32 = -1;

/** The immediate children of a directory, sorted by name. */
pub class VfsListing {
    names  : StringInterner;
    dirs   : Vec<bool>;
    order  : Vec<i32>;
    sorted : bool = true;

    /** An empty listing. */
    constructor() {
        self.names = new StringInterner();
        self.dirs = new Vec<bool>();
        self.order = new Vec<i32>();
    }

    /** How many names it holds. */
    pub fn count(self) : i32 {
        return self.order.len();
    }

    /** The `i`-th name in byte order (borrowed; copy to keep); "" outside the listing. */
    pub fn name(mut self, i : i32) : string {
        let id : i32 = self.idAt(i);
        if (id < 0) {
            return "";
        }
        return self.names.name(StringId { raw: id });
    }

    /** True when the `i`-th name is a directory. */
    pub fn isDirectory(mut self, i : i32) : bool {
        let id : i32 = self.idAt(i);
        if (id < 0) {
            return false;
        }
        return self.dirs.get(id);
    }

    /** True when `name` is in the listing. */
    pub fn has(self, name : string) : bool {
        return !self.names.find(name).isNone();
    }

    /** Adds a name (once); a directory beats a file of the same name. Used by the mounts. */
    pub(crate) fn add(mut self, name : string, isDir : bool) : void {
        if (name.byteLength == 0) {
            return;
        }
        let known : StringId = self.names.find(name);
        if (!known.isNone()) {
            if (isDir) {
                self.dirs.set(known.raw, true);
            }
            return;
        }

        let id : StringId = self.names.intern(name);
        self.dirs.push(isDir);
        self.order.push(id.raw);
        self.sorted = false;
    }

    // The interned id at position `i` in byte order, or -1 outside the listing.
    fn idAt(mut self, i : i32) : i32 {
        if (i < 0 || i >= self.order.len()) {
            return LISTING_NO_ID;
        }
        self.sort();
        return self.order.get(i);
    }

    // Insertion sort by byte order; a directory listing is short.
    fn sort(mut self) : void {
        if (self.sorted) {
            return;
        }
        let n : i32 = self.order.len();
        for (i of 1..n) {
            let moving : i32 = self.order.get(i);
            let key : string = self.names.name(StringId { raw: moving });
            let mut j : i32 = i - 1;
            while (j >= 0
                && VfsPath::compare(self.names.name(StringId { raw: self.order.get(j) }), key) > 0) {
                self.order.set(j + 1, self.order.get(j));
                j = j - 1;
            }
            self.order.set(j + 1, moving);
        }
        self.sorted = true;
    }
}

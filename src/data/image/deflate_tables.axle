// deflate_tables — the length and distance code tables that RFC 1951 shares between both directions.
//
// `Deflater` turns a match into a code and its extra bits, `Inflater` turns them back, and both need the same
// table: for each of the 29 length codes and 30 distance codes, the smallest value it stands for and how many
// extra bits follow it. The RFC prints the tables out; here they are derived from the rule behind them (the extra
// bits grow by one every four length codes and every two distance codes), which is shorter than 59 literals and
// cannot be mistyped.

/** The shortest match deflate can code. */
pub(crate) const DEFLATE_MIN_MATCH : i32 = 3;

/** The longest match deflate can code; it has a code of its own. */
pub(crate) const DEFLATE_MAX_MATCH : i32 = 258;

/** The literal/length symbol that closes a block. */
pub(crate) const DEFLATE_END_OF_BLOCK : i32 = 256;

/** The first literal/length symbol that stands for a match length. */
pub(crate) const DEFLATE_FIRST_LENGTH : i32 = 257;

/** How many length codes (symbols 257..285) and distance codes exist. */
pub(crate) const DEFLATE_LENGTH_CODES : i32 = 29;
pub(crate) const DEFLATE_DISTANCE_CODES : i32 = 30;

/** A canonical code is at most this many bits long. */
pub(crate) const DEFLATE_MAX_CODE_BITS : i32 = 15;

// The first length code and the first distance code that carry extra bits, and the divisor at which the count
// of extra bits steps up.
const DEFLATE_LENGTH_PLAIN : i32 = 8;
const DEFLATE_LENGTH_EXTRA_STEP : i32 = 4;
const DEFLATE_DISTANCE_PLAIN : i32 = 4;
const DEFLATE_DISTANCE_EXTRA_STEP : i32 = 2;

/** The smallest value and the extra-bit count of every length code and every distance code. */
pub(crate) class DeflateTables {
    /** The match length each length code starts at. */
    pub(crate) lenBase : i32[];

    /** How many extra bits follow each length code. */
    pub(crate) lenExtra : i32[];

    /** The distance each distance code starts at. */
    pub(crate) dstBase : i32[];

    /** How many extra bits follow each distance code. */
    pub(crate) dstExtra : i32[];

    constructor() {
        self.lenBase = new i32[DEFLATE_LENGTH_CODES as i64];
        self.lenExtra = new i32[DEFLATE_LENGTH_CODES as i64];
        self.dstBase = new i32[DEFLATE_DISTANCE_CODES as i64];
        self.dstExtra = new i32[DEFLATE_DISTANCE_CODES as i64];

        // Length codes 257..284: a base length and the number of extra bits that follow it.
        let lastLength : i32 = DEFLATE_LENGTH_CODES - 1;
        let mut base : i32 = DEFLATE_MIN_MATCH;
        for (i of 0..lastLength) {
            self.lenBase[i] = base;
            let mut extra : i32 = 0;
            if (i >= DEFLATE_LENGTH_PLAIN) {
                extra = (i - DEFLATE_LENGTH_EXTRA_STEP) / DEFLATE_LENGTH_EXTRA_STEP;
            }
            self.lenExtra[i] = extra;
            base = base + (1 << extra);
        }
        // The last code is the length 258 on its own.
        self.lenBase[lastLength] = DEFLATE_MAX_MATCH;
        self.lenExtra[lastLength] = 0;

        // Distance codes: likewise a base distance and its extra bits.
        let mut dist : i32 = 1;
        for (i of 0..DEFLATE_DISTANCE_CODES) {
            self.dstBase[i] = dist;
            let mut extra : i32 = 0;
            if (i >= DEFLATE_DISTANCE_PLAIN) {
                extra = (i - DEFLATE_DISTANCE_EXTRA_STEP) / DEFLATE_DISTANCE_EXTRA_STEP;
            }
            self.dstExtra[i] = extra;
            dist = dist + (1 << extra);
        }
    }
}

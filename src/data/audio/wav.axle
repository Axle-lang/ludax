// wav — the RIFF/WAVE codec: bytes to an `AudioClip` and back.
//
// Decoding accepts PCM at 8 (unsigned), 16, 24 and 32 bits (signed) and IEEE float at 32 bits, any channel count
// up to 64, with a plain or a WAVE_FORMAT_EXTENSIBLE `fmt ` chunk. Chunks are walked by their declared sizes with
// the RIFF pad byte after an odd one; chunks it does not know (LIST, fact, cue, ...) are skipped. Input is
// untrusted, so every size is checked against what the buffer really holds and a bad file comes back as an error
// message in the result, never as an abort or an out-of-range read. Encoding writes 16-bit PCM or 32-bit float;
// more than two channels are written with an EXTENSIBLE header, which is what players expect there.

use crate::core::math::scalar::clampI;
use crate::data::audio::clip::AudioClip;
use crate::data::model::ieee::Ieee;

/** Most channels a file may declare. */
pub const WAV_MAX_CHANNELS : i32 = 64;

/** Highest sample rate a file may declare. */
pub const WAV_MAX_RATE : i32 = 1000000;

// The format tags of the `fmt ` chunk.
const WAV_FORMAT_PCM : i32 = 1;
const WAV_FORMAT_FLOAT : i32 = 3;
const WAV_FORMAT_EXTENSIBLE : i32 = 0xFFFE;

// The size of a plain PCM and a plain float `fmt ` body, and of the EXTENSIBLE one that carries a GUID.
const WAV_FMT_PCM : i32 = 16;
const WAV_FMT_FLOAT : i32 = 18;
const WAV_FMT_EXTENSIBLE : i32 = 40;

// A chunk is an 8-byte header (size and tag) around its body, and a file starts with 12 bytes of RIFF header.
const WAV_CHUNK_HEAD : i32 = 8;
const WAV_RIFF_HEAD : i32 = 12;

// Offsets inside a RIFF header and a chunk header: the form size follows "RIFF", the form type follows that, and
// a chunk's size follows its tag.
const WAV_RIFF_SIZE_AT : i32 = 4;
const WAV_RIFF_TYPE_AT : i32 = 8;
const WAV_CHUNK_SIZE_AT : i32 = 4;

/** A tag is four ASCII characters. */
const WAV_TAG_LEN : i32 = 4;

// Offsets of the fields inside a `fmt ` body (WAVEFORMATEX, then WAVEFORMATEXTENSIBLE).
const WAV_AT_CODE : i32 = 0;
const WAV_AT_CHANNELS : i32 = 2;
const WAV_AT_RATE : i32 = 4;
const WAV_AT_BYTE_RATE : i32 = 8;
const WAV_AT_ALIGN : i32 = 12;
const WAV_AT_BITS : i32 = 14;
const WAV_AT_EXT_SIZE : i32 = 16;
const WAV_AT_EXT_VALID_BITS : i32 = 18;
const WAV_AT_EXT_MASK : i32 = 20;
const WAV_AT_EXT_CODE : i32 = 24;
const WAV_AT_EXT_GUID_TAIL : i32 = 26;

// The extension that follows the base fields is 22 bytes: valid bits, channel mask, and a 16-byte GUID.
const WAV_EXT_BYTES : i32 = 22;

// The last 14 bytes of KSDATAFORMAT_SUBTYPE_xxx, 00000000-0010-8000-00AA00389B71, as little-endian 16-bit words
// (the first two bytes of the GUID are the format code itself).
const WAV_GUID_WORD_1 : i32 = 0;
const WAV_GUID_WORD_2 : i32 = 0x0010;
const WAV_GUID_WORD_3 : i32 = 0x0080;
const WAV_GUID_WORD_4 : i32 = 0xAA00;
const WAV_GUID_WORD_5 : i32 = 0x3800;
const WAV_GUID_WORD_6 : i32 = 0x719B;

// `i8` is signed, so a byte read from the file is masked back to 0..255; a 16-bit word is masked the same way.
const WAV_BYTE_MASK : i32 = 0xFF;

// A `fact` chunk body is one 32-bit frame count.
const WAV_FACT_BODY : i32 = 4;

// Sample scales: a signed integer of n bits spans -2^(n-1)..2^(n-1)-1 and maps to -1..1 by dividing by 2^(n-1).
// The sign mask of the same width turns the unsigned read into a signed value.
const WAV_PCM8_CENTRE : i32 = 128;
const WAV_PCM16_SIGN : i32 = 0x8000;
const WAV_PCM16_MAX : i32 = 32767;
const WAV_PCM16_MASK : i32 = 0xFFFF;
const WAV_PCM24_SIGN : i32 = 0x800000;
const WAV_PCM32_SCALE : f64 = 2147483648.0;

// The largest finite f32, as an f64: anything beyond it is an infinity once narrowed, and a sample cannot be one.
const WAV_F32_MAX : f64 = 340282346638528859811704183484516925440.0;

/** The outcome of decoding: the clip, or an error message when the bytes were not an acceptable WAVE file. */
pub class WavResult {
    ok      : bool = false;
    message : string = "";
    audio   : AudioClip;

    constructor(good : bool, message : string, own audio : AudioClip) {
        self.ok = good;
        self.message = message;
        self.audio = audio;
    }

    // A failed decode: the reason, and the empty clip every failure carries.
    pub(file) static fn refused(message : string) : WavResult {
        return new WavResult(false, message, new AudioClip(1, 1, 0));
    }

    /** True when the file decoded. */
    pub fn isOk(self) : bool {
        return self.ok;
    }

    /** Why decoding failed; empty on success. */
    pub fn error(self) : string {
        return self.message;
    }

    /** The decoded clip (an empty clip when decoding failed). */
    pub fn clip(self) : AudioClip {
        return self.audio;
    }
}

/** An encoded file: `size` valid bytes at the start of `bytes`. */
pub class WavFile {
    /** The file contents; read only the first `size` bytes. */
    pub bytes : i8[];

    /** How many bytes of `bytes` are the file. */
    pub size : i32 = 0;

    constructor(bytes : i8[], size : i32) {
        self.bytes = bytes;
        self.size = size;
    }
}

/** The fields of a `fmt ` chunk; `error` is empty when they describe a file `decode` can read. */
struct WavFormat {
    code     : i32;
    channels : i32;
    rate     : i32;
    bits     : i32;
    align    : i32;
    error    : string;

    // A format that carries only the reason it was refused.
    pub(file) static fn refused(error : string) : WavFormat {
        return WavFormat { code: 0, channels: 0, rate: 0, bits: 0, align: 0, error: error };
    }
}

/** The sizes of the encoded file's parts, worked out before a byte is written. */
struct WavLayout {
    bits       : i32;
    isFloat    : bool;
    extensible : bool;
    fmtSize    : i32;
    dataBytes  : i32;
}

/** Decodes and encodes WAVE files. */
pub class WavCodec {
    /** Decodes the first `length` bytes of `data`. Failure is reported in the result. */
    pub static fn decode(data : i8[], length : i32) : WavResult {
        if (length < WAV_RIFF_HEAD) {
            return WavResult::refused("wav: shorter than a RIFF header");
        }
        let isRiff : bool = WavCodec::isTag(data, 0, "RIFF");
        let isWave : bool = WavCodec::isTag(data, WAV_RIFF_TYPE_AT, "WAVE");
        if (!isRiff || !isWave) {
            return WavResult::refused("wav: not a RIFF/WAVE file");
        }

        let end : i64 = WavCodec::u32At(data, WAV_RIFF_SIZE_AT) + WAV_CHUNK_HEAD as i64;
        if (end > length as i64) {
            return WavResult::refused("wav: truncated, the RIFF size is larger than the file");
        }
        if (end < WAV_RIFF_HEAD as i64) {
            return WavResult::refused("wav: RIFF size too small");
        }

        let mut pos : i64 = WAV_RIFF_HEAD as i64;
        let mut haveFmt : bool = false;
        let mut fmt : WavFormat = WavFormat::refused("");

        // Walk the chunks by their declared sizes, skipping the pad byte after an odd one.
        while (pos + WAV_CHUNK_HEAD as i64 <= end) {
            let size : i64 = WavCodec::u32At(data, (pos + WAV_CHUNK_SIZE_AT as i64) as i32);
            let body : i64 = pos + WAV_CHUNK_HEAD as i64;
            if (body + size > end) {
                return WavResult::refused("wav: truncated, the chunk at offset ${pos} is larger than the file");
            }

            if (WavCodec::isTag(data, pos as i32, "fmt ")) {
                fmt = WavCodec::parseFmt(data, body as i32, size);
                if (fmt.error != "") {
                    return WavResult::refused(fmt.error);
                }
                haveFmt = true;
            } else if (WavCodec::isTag(data, pos as i32, "data")) {
                if (!haveFmt) {
                    return WavResult::refused("wav: data chunk before fmt chunk");
                }
                let frames : i32 = (size / fmt.align as i64) as i32;
                let clip : AudioClip = new AudioClip(fmt.rate, fmt.channels, frames);
                WavCodec::readSamples(data, body as i32, fmt, clip);
                return new WavResult(true, "", clip);
            }
            pos = body + size + (size & 1);
        }

        if (!haveFmt) {
            return WavResult::refused("wav: no fmt chunk");
        }
        return WavResult::refused("wav: no data chunk");
    }

    /** 16-bit PCM, little endian: exactly what `decode` reads back for samples that are multiples of 1/32768. */
    pub static fn encode16(clip : AudioClip) : WavFile {
        return WavCodec::encodeWith(clip, 16);
    }

    /** 32-bit IEEE float: lossless for `f32` samples. */
    pub static fn encodeFloat(clip : AudioClip) : WavFile {
        return WavCodec::encodeWith(clip, 32);
    }

    // Reads the `fmt ` body at `body`, `size` bytes long; the result carries an error when it is unusable.
    static fn parseFmt(data : i8[], body : i32, size : i64) : WavFormat {
        if (size < WAV_FMT_PCM as i64) {
            return WavFormat::refused("wav: fmt chunk too small");
        }
        let mut code : i32 = WavCodec::u16At(data, body + WAV_AT_CODE);

        // An EXTENSIBLE chunk carries the real format tag after the base fields.
        if (code == WAV_FORMAT_EXTENSIBLE) {
            if (size < WAV_FMT_EXTENSIBLE as i64) {
                return WavFormat::refused("wav: extensible fmt chunk too small");
            }
            code = WavCodec::u16At(data, body + WAV_AT_EXT_CODE);
        }

        let mut fmt : WavFormat = WavFormat {
            code: code,
            channels: WavCodec::u16At(data, body + WAV_AT_CHANNELS),
            rate: WavCodec::u32At(data, body + WAV_AT_RATE) as i32,
            bits: WavCodec::u16At(data, body + WAV_AT_BITS),
            align: WavCodec::u16At(data, body + WAV_AT_ALIGN),
            error: "",
        };
        fmt.error = WavCodec::checkFormat(fmt);
        return fmt;
    }

    // Format sanity: only what readSamples understands, and a block alignment that agrees with the layout.
    static fn checkFormat(fmt : WavFormat) : string {
        if (fmt.channels < 1 || fmt.channels > WAV_MAX_CHANNELS) {
            return "wav: unsupported channel count ${fmt.channels}";
        }
        if (fmt.rate < 1 || fmt.rate > WAV_MAX_RATE) {
            return "wav: unsupported sample rate ${fmt.rate}";
        }

        let bits : i32 = fmt.bits;
        if (fmt.code == WAV_FORMAT_PCM) {
            if (bits != 8 && bits != 16 && bits != 24 && bits != 32) {
                return "wav: unsupported PCM bit depth ${bits}";
            }
        } else if (fmt.code == WAV_FORMAT_FLOAT) {
            if (bits != 32) {
                return "wav: unsupported float bit depth ${bits}";
            }
        } else {
            return "wav: unsupported format code ${fmt.code}";
        }
        if (fmt.align != fmt.channels * (bits / 8)) {
            return "wav: block alignment disagrees with channels and bit depth";
        }
        return "";
    }

    static fn readSamples(data : i8[], at : i32, fmt : WavFormat, clip : AudioClip) : void {
        let total : i32 = clip.frames * clip.channels;
        let width : i32 = fmt.bits / 8;
        for (i of 0..total) {
            clip.samples[i as i64] = WavCodec::sampleAt(data, at + i * width, fmt);
        }
    }

    // One sample of the file's format, scaled to -1..1.
    static fn sampleAt(data : i8[], p : i32, fmt : WavFormat) : f32 {
        if (fmt.code == WAV_FORMAT_FLOAT) {
            return Ieee::toF32(WavCodec::u32At(data, p) as i32);
        }
        if (fmt.bits == 8) {
            // 8-bit PCM is unsigned, centred on 128.
            return ((WavCodec::byteAt(data, p) - WAV_PCM8_CENTRE) as f32) / (WAV_PCM8_CENTRE as f32);
        }
        if (fmt.bits == 16) {
            let raw : i32 = WavCodec::u16At(data, p);
            return (WavCodec::signExtend(raw, WAV_PCM16_SIGN) as f32) / (WAV_PCM16_SIGN as f32);
        }
        if (fmt.bits == 24) {
            let low : i32 = WavCodec::u16At(data, p);
            let raw : i32 = low | (WavCodec::byteAt(data, p + 2) << 16);
            return (WavCodec::signExtend(raw, WAV_PCM24_SIGN) as f32) / (WAV_PCM24_SIGN as f32);
        }
        return ((WavCodec::u32At(data, p) as i32) as f64 / WAV_PCM32_SCALE) as f32;
    }

    // A two's-complement value read as unsigned, as signed: when the sign bit is set, subtract twice its weight.
    static fn signExtend(raw : i32, signBit : i32) : i32 {
        return raw - ((raw & signBit) << 1);
    }

    static fn encodeWith(clip : AudioClip, bits : i32) : WavFile {
        let isFloat : bool = bits == 32;
        let extensible : bool = clip.channels > 2;
        let layout : WavLayout = WavLayout {
            bits: bits,
            isFloat: isFloat,
            extensible: extensible,
            fmtSize: WavCodec::fmtSize(isFloat, extensible),
            dataBytes: clip.frames * clip.channels * (bits / 8),
        };

        let factSize : i32 = WavCodec::factSize(isFloat);
        let header : i32 = WAV_RIFF_HEAD + WAV_CHUNK_HEAD + layout.fmtSize + factSize + WAV_CHUNK_HEAD;
        let total : i32 = header + layout.dataBytes + (layout.dataBytes & 1);
        let mut out : i8[] = new i8[(total + 1) as i64];
        for (i of 0..total + 1) {
            out[i as i64] = 0 as i8;
        }

        WavCodec::putTag(out, 0, "RIFF");
        WavCodec::putU32(out, WAV_RIFF_SIZE_AT, total - WAV_CHUNK_HEAD);
        WavCodec::putTag(out, WAV_RIFF_TYPE_AT, "WAVE");

        WavCodec::putTag(out, WAV_RIFF_HEAD, "fmt ");
        WavCodec::putU32(out, WAV_RIFF_HEAD + WAV_CHUNK_SIZE_AT, layout.fmtSize);
        WavCodec::writeFmt(out, WAV_RIFF_HEAD + WAV_CHUNK_HEAD, clip, layout);

        let mut at : i32 = WAV_RIFF_HEAD + WAV_CHUNK_HEAD + layout.fmtSize;

        // A float file carries a fact chunk with the frame count.
        if (isFloat) {
            WavCodec::putTag(out, at, "fact");
            WavCodec::putU32(out, at + WAV_CHUNK_SIZE_AT, WAV_FACT_BODY);
            WavCodec::putU32(out, at + WAV_CHUNK_HEAD, clip.frames);
            at = at + factSize;
        }

        WavCodec::putTag(out, at, "data");
        WavCodec::putU32(out, at + WAV_CHUNK_SIZE_AT, layout.dataBytes);
        WavCodec::writeSamples(out, clip, at + WAV_CHUNK_HEAD, isFloat);

        return new WavFile(out, total);
    }

    // The fmt chunk body: the base WAVEFORMATEX fields, then the EXTENSIBLE extension when it is needed.
    static fn writeFmt(out : i8[], at : i32, clip : AudioClip, layout : WavLayout) : void {
        let width : i32 = layout.bits / 8;
        let mut code : i32 = WAV_FORMAT_PCM;
        if (layout.isFloat) {
            code = WAV_FORMAT_FLOAT;
        }
        let mut tagCode : i32 = code;
        if (layout.extensible) {
            tagCode = WAV_FORMAT_EXTENSIBLE;
        }

        WavCodec::putU16(out, at + WAV_AT_CODE, tagCode);
        WavCodec::putU16(out, at + WAV_AT_CHANNELS, clip.channels);
        WavCodec::putU32(out, at + WAV_AT_RATE, clip.rate);
        WavCodec::putU32(out, at + WAV_AT_BYTE_RATE, clip.rate * clip.channels * width);
        WavCodec::putU16(out, at + WAV_AT_ALIGN, clip.channels * width);
        WavCodec::putU16(out, at + WAV_AT_BITS, layout.bits);

        if (layout.extensible) {
            WavCodec::putU16(out, at + WAV_AT_EXT_SIZE, WAV_EXT_BYTES);
            WavCodec::putU16(out, at + WAV_AT_EXT_VALID_BITS, layout.bits);
            WavCodec::putU32(out, at + WAV_AT_EXT_MASK, 0);
            WavCodec::putU16(out, at + WAV_AT_EXT_CODE, code);

            let tail : i32 = at + WAV_AT_EXT_GUID_TAIL;
            WavCodec::putU16(out, tail, WAV_GUID_WORD_1);
            WavCodec::putU16(out, tail + 2, WAV_GUID_WORD_2);
            WavCodec::putU16(out, tail + 4, WAV_GUID_WORD_3);
            WavCodec::putU16(out, tail + 6, WAV_GUID_WORD_4);
            WavCodec::putU16(out, tail + 8, WAV_GUID_WORD_5);
            WavCodec::putU16(out, tail + 10, WAV_GUID_WORD_6);
        } else if (layout.isFloat) {
            WavCodec::putU16(out, at + WAV_AT_EXT_SIZE, 0);
        }
    }

    // The size of the `fmt ` body the chosen encoding needs.
    static fn fmtSize(isFloat : bool, extensible : bool) : i32 {
        if (extensible) {
            return WAV_FMT_EXTENSIBLE;
        }
        if (isFloat) {
            return WAV_FMT_FLOAT;
        }
        return WAV_FMT_PCM;
    }

    // The size of the `fact` chunk a float file carries, or 0 when it carries none.
    static fn factSize(isFloat : bool) : i32 {
        if (isFloat) {
            return WAV_CHUNK_HEAD + WAV_FACT_BODY;
        }
        return 0;
    }

    // Writes every sample at `at`, 16-bit PCM or 32-bit float as asked.
    static fn writeSamples(out : i8[], clip : AudioClip, at : i32, isFloat : bool) : void {
        let count : i32 = clip.frames * clip.channels;
        for (i of 0..count) {
            let v : f32 = clip.samples[i as i64];
            if (isFloat) {
                WavCodec::putU32(out, at + i * 4, WavCodec::floatBits(v));
            } else {
                let q : i32 = WavCodec::pcm16Of(v);
                WavCodec::putU16(out, at + i * 2, q & WAV_PCM16_MASK);
            }
        }
    }

    // A sample as a signed 16-bit integer, rounded and clamped to its range.
    static fn pcm16Of(v : f32) : i32 {
        let rounded : i32 = WavCodec::roundHalfAway(v * (WAV_PCM16_SIGN as f32));
        return clampI(rounded, -WAV_PCM16_SIGN, WAV_PCM16_MAX);
    }

    // The nearest whole number, halves away from zero.
    static fn roundHalfAway(x : f32) : i32 {
        let wide : f64 = x as f64;
        if (wide >= 0.0) {
            return (wide + 0.5) as i32;
        }
        return 0 - ((0.0 - wide + 0.5) as i32);
    }

    // The IEEE-754 binary32 bit pattern of `x`; a NaN or an infinity (a sample cannot be one) is written as 0.
    static fn floatBits(x : f32) : i32 {
        let wide : f64 = x as f64;
        let isNumber : bool = wide == wide;
        if (!isNumber || wide > WAV_F32_MAX || wide < -WAV_F32_MAX) {
            return 0;
        }
        return Ieee::bitsOf(x);
    }

    static fn byteAt(data : i8[], at : i32) : i32 {
        return (data[at as i64] as i32) & WAV_BYTE_MASK;
    }

    static fn u16At(data : i8[], at : i32) : i32 {
        return WavCodec::byteAt(data, at) | (WavCodec::byteAt(data, at + 1) << 8);
    }

    // An unsigned 32-bit little-endian value, as an i64 so sizes above 2^31 stay positive.
    static fn u32At(data : i8[], at : i32) : i64 {
        let lo : i64 = WavCodec::u16At(data, at) as i64;
        let hi : i64 = WavCodec::u16At(data, at + 2) as i64;
        return lo | (hi << 16);
    }

    // Whether the four bytes at `at` spell `name`.
    static fn isTag(data : i8[], at : i32, name : string) : bool {
        for (i of 0..WAV_TAG_LEN) {
            if (WavCodec::byteAt(data, at + i) != (name.charAt(i) as i32)) {
                return false;
            }
        }
        return true;
    }

    static fn putTag(out : i8[], at : i32, s : string) : void {
        for (i of 0..WAV_TAG_LEN) {
            out[(at + i) as i64] = s.charAt(i) as i8;
        }
    }

    static fn putU16(out : i8[], at : i32, v : i32) : void {
        out[at as i64] = (v & WAV_BYTE_MASK) as i8;
        out[(at + 1) as i64] = ((v >> 8) & WAV_BYTE_MASK) as i8;
    }

    static fn putU32(out : i8[], at : i32, v : i32) : void {
        WavCodec::putU16(out, at, v & WAV_PCM16_MASK);
        WavCodec::putU16(out, at + 2, (v >>> 16) & WAV_PCM16_MASK);
    }
}

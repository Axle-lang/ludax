// bytes — a growable run of bytes, and the checksums file formats put on them.
//
// Every importer and exporter of the data layer works on a `ByteBuf`: the bytes of a file read whole, or the
// bytes about to be written. Axle's `i8` is signed, so the buffer hides the sign: a read gives 0..255 and a
// write keeps the low 8 bits. An index outside the buffer aborts, like the containers of the core layer, so a
// decoder checks `len()` before it trusts a size read from a file.
//
// `Crc32` and `adler32` live here because each is a checksum over a byte range: the last thing a PNG chunk and
// a zlib stream carry, and the reason those codecs need nothing but a `ByteBuf`.

use std::ffi::libc::mem::libc_memcpy;
use std::ffi::runtime::panicMsg;
use std::text::{addrAsPtr, bufferAddr};

/** The smallest room a `ByteBuf` starts with, so the first few pushes do not grow it. */
const BYTES_MIN_ROOM : i32 = 16;

/** The low 8 bits: reads mask a signed byte with it, writes keep that many bits. */
const BYTES_MASK : i32 = 255;

/** The length in bytes of a file signature, as `tagAt` compares it. */
const BYTES_TAG_LEN : i32 = 4;

/** The reflected CRC-32 polynomial (0xEDB88320), as the signed value of the same 32 bits. */
const CRC32_POLY : i32 = -306674912;

/** CRC-32 has one table entry per byte value. */
const CRC32_TABLE_SIZE : i32 = 256;

/** CRC-32 folds a byte over one bit per entry bit. */
const CRC32_BITS : i32 = 8;

/** The largest prime below 65536: Adler-32 reduces both of its sums modulo it. */
const ADLER_MOD : i32 = 65521;

/**
 * Copies `count` bytes of `src` from `srcAt` to `dst` at `dstAt` in one `memcpy`; aborts when either range
 * leaves its array. The ranges must not overlap (two arrays, or two distant ranges of one): for an overlapping
 * match copy use a forward loop.
 */
pub fn bytesCopy(dst : i8[], dstAt : i32, src : i8[], srcAt : i32, count : i32) : void {
    if (count <= 0) {
        return;
    }
    if (dstAt < 0 || srcAt < 0 || dstAt + count > (dst.length as i32)
        || srcAt + count > (src.length as i32)) {
        panicMsg("bytesCopy: range outside its array");
    }
    libc_memcpy(
        addrAsPtr(bufferAddr(dst) + (dstAt as i64)),
        addrAsPtr(bufferAddr(src) + (srcAt as i64)),
        count as i64
    );
}

/** A growable array of bytes. */
pub class ByteBuf {
    data : i8[];
    used : i32 = 0;
    room : i32;

    /** An empty buffer with room for `capacity` bytes (at least 16). */
    constructor(capacity : i32) {
        self.room = capacity;
        if (self.room < BYTES_MIN_ROOM) {
            self.room = BYTES_MIN_ROOM;
        }
        self.data = new i8[self.room as i64];
    }

    /** How many bytes it holds. */
    pub fn len(self) : i32 {
        return self.used;
    }

    /** The byte at `i`, 0 to 255; aborts outside the buffer. */
    pub fn get(self, i : i32) : i32 {
        if (i < 0 || i >= self.used) {
            panicMsg("ByteBuf.get: index out of range");
        }
        return self.byteAt(i);
    }

    /** The byte at `i`, or `fallback` outside the buffer. */
    pub fn getOr(self, i : i32, fallback : i32) : i32 {
        if (i < 0 || i >= self.used) {
            return fallback;
        }
        return self.byteAt(i);
    }

    /** Replaces the byte at `i` with the low 8 bits of `v`; aborts outside the buffer. */
    pub fn set(mut self, i : i32, v : i32) : void {
        if (i < 0 || i >= self.used) {
            panicMsg("ByteBuf.set: index out of range");
        }
        self.data[i] = (v & BYTES_MASK) as i8;
    }

    /** Appends the low 8 bits of `v`. */
    pub fn push(mut self, v : i32) : void {
        if (self.used == self.room) {
            self.grow(self.room * 2);
        }
        self.data[self.used] = (v & BYTES_MASK) as i8;
        self.used = self.used + 1;
    }

    /** Appends `v` as 4 bytes, most significant first. */
    pub fn pushBe32(mut self, v : i32) : void {
        self.push(v >>> 24);
        self.push(v >>> 16);
        self.push(v >>> 8);
        self.push(v);
    }

    /** Appends `v` as 4 bytes, least significant first. */
    pub fn pushLe32(mut self, v : i32) : void {
        self.push(v);
        self.push(v >>> 8);
        self.push(v >>> 16);
        self.push(v >>> 24);
    }

    /** Appends the bytes of `text` (its UTF-8 form). */
    pub fn pushText(mut self, text : string) : void {
        for (i of 0..text.byteLength) {
            self.push(text.byteAt(i) as i32);
        }
    }

    /** Appends bytes `from..to` of `other`. */
    pub fn pushRange(mut self, other : ByteBuf, from : i32, to : i32) : void {
        if (to <= from) {
            return;
        }
        if (from < 0 || to > other.used) {
            panicMsg("ByteBuf.pushRange: range out of bounds");
        }
        let n : i32 = to - from;
        if (self.used + n > self.room) {
            let mut room : i32 = self.room * 2;
            while (room < self.used + n) {
                room = room * 2;
            }
            self.grow(room);
        }
        bytesCopy(self.data, self.used, other.data, from, n);
        self.used = self.used + n;
    }

    /** The big-endian 32-bit number at `i` (bits above bit 31 are not used); aborts when it runs off the end. */
    pub fn be32(self, i : i32) : i32 {
        return (self.get(i) << 24) | (self.get(i + 1) << 16) | (self.get(i + 2) << 8) | self.get(i + 3);
    }

    /** The little-endian 32-bit number at `i`. */
    pub fn le32(self, i : i32) : i32 {
        return self.get(i) | (self.get(i + 1) << 8) | (self.get(i + 2) << 16) | (self.get(i + 3) << 24);
    }

    /** True when the 4 bytes at `i` are the characters of `tag` (4 bytes of text). */
    pub fn tagAt(self, i : i32, tag : string) : bool {
        if (i < 0 || i + BYTES_TAG_LEN > self.used) {
            return false;
        }
        for (k of 0..BYTES_TAG_LEN) {
            if (self.get(i + k) != (tag.charAt(k) as i32)) {
                return false;
            }
        }
        return true;
    }

    /** Empties the buffer; the storage is kept. */
    pub fn clear(mut self) : void {
        self.used = 0;
    }

    /** Cuts the buffer down to `n` bytes (no effect when it is shorter). */
    pub fn truncate(mut self, n : i32) : void {
        if (n >= 0 && n < self.used) {
            self.used = n;
        }
    }

    /** The storage, for the standard streams; only the first `len()` bytes mean anything. */
    pub fn raw(self) : i8[] {
        return self.data;
    }

    /** Makes `len()` bytes of room for stream reads to fill: the buffer is `n` bytes long, all 0. */
    pub fn resize(mut self, n : i32) : void {
        if (n > self.room) {
            self.grow(n);
        }
        for (i of 0..n) {
            self.data[i] = 0;
        }
        self.used = n;
    }

    /** Makes room for `n` bytes without changing the length or zeroing anything: a decoder fills `raw()` directly. */
    pub fn reserve(mut self, n : i32) : void {
        if (n > self.room) {
            self.grow(n);
        }
    }

    /** Sets the length to `n` (at most the reserved room) after a decoder wrote that many bytes through `raw()`. */
    pub fn setLen(mut self, n : i32) : void {
        if (n < 0 || n > self.room) {
            panicMsg("ByteBuf.setLen: length exceeds the reserved room");
        }
        self.used = n;
    }

    // The byte at `i`, masked and without a bounds check: every caller has already asked `used`.
    fn byteAt(self, i : i32) : i32 {
        return (self.data[i] as i32) & BYTES_MASK;
    }

    // Copies the bytes into a larger run and takes it as the storage.
    fn grow(mut self, newRoom : i32) : void {
        let mut bigger : i8[] = new i8[newRoom as i64];
        for (i of 0..self.used) {
            bigger[i] = self.data[i];
        }
        self.data = bigger;
        self.room = newRoom;
    }
}

/** CRC-32 (the checksum of PNG chunks) with its table built once per instance. */
pub class Crc32 {
    table : i32[];

    /** Builds the 256-entry table of the reflected polynomial 0xEDB88320. */
    constructor() {
        self.table = new i32[CRC32_TABLE_SIZE];
        for (n of 0..CRC32_TABLE_SIZE) {
            let mut c : i32 = n;
            for (k of 0..CRC32_BITS) {
                if ((c & 1) != 0) {
                    c = CRC32_POLY ^ (c >>> 1);
                } else {
                    c = c >>> 1;
                }
            }
            self.table[n] = c;
        }
    }

    /** The CRC-32 of bytes `from..to` of `b`. */
    pub fn sum(self, b : ByteBuf, from : i32, to : i32) : i32 {
        let mut c : i32 = -1;
        for (i of from..to) {
            c = self.table[(c ^ b.get(i)) & BYTES_MASK] ^ (c >>> 8);
        }
        return c ^ -1;
    }
}

/** The Adler-32 of bytes `from..to` of `b` (the checksum at the end of a zlib stream). */
pub fn adler32(b : ByteBuf, from : i32, to : i32) : i32 {
    let mut s1 : i32 = 1;
    let mut s2 : i32 = 0;
    for (i of from..to) {
        s1 = (s1 + b.get(i)) % ADLER_MOD;
        s2 = (s2 + s1) % ADLER_MOD;
    }
    return (s2 << 16) | s1;
}

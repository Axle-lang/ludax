// nbt_writer — builds an NBT document into a byte buffer.
//
// The mirror of `NbtReader`: no tree, the caller emits tags in order. Nesting is the caller's discipline, as
// in the format itself: `beginCompound(name)` ... `end()`, and a list says its element type and length up
// front (`beginList`), after which its elements are written with the unnamed forms (`putIntItem` ..., and a
// compound element simply starts writing its named tags). A compound inside a list is closed with `end()`.
// Numbers are big-endian.
//
// `copyRaw` splices bytes lifted from a reader unchanged, which is how a program keeps the tags it does not
// model through a save without parsing them.

use crate::data::bytes::ByteBuf;
use crate::data::serial::nbt_reader::{
    NBT_TAG_BYTE, NBT_TAG_BYTE_ARRAY, NBT_TAG_COMPOUND, NBT_TAG_DOUBLE, NBT_TAG_END, NBT_TAG_FLOAT,
    NBT_TAG_INT, NBT_TAG_INT_ARRAY, NBT_TAG_LIST, NBT_TAG_LONG, NBT_TAG_LONG_ARRAY, NBT_TAG_SHORT,
    NBT_TAG_STRING
};

const NBT_WRITER_WORD_BITS : i32 = 32;

/** Writes one NBT document into `out()`. */
pub class NbtWriter {
    out : ByteBuf;

    /** A writer with an empty buffer sized for `capacity` bytes. */
    constructor(capacity : i32) {
        self.out = new ByteBuf(capacity);
    }

    /** A writer that appends to `into` (taken). */
    constructor(own into : ByteBuf) {
        self.out = into;
    }

    /** Empties the buffer so the writer can build the next document. */
    pub fn clear(mut self) : void {
        self.out.clear();
    }

    /** The bytes written so far. */
    pub fn bytes(self) : ByteBuf {
        return self.out;
    }

    // Writes a tag header: type, then the name (omitted inside lists).
    fn header(mut self, t : i32, name : string) : void {
        self.out.push(t);
        self.writeName(name);
    }

    fn writeName(mut self, name : string) : void {
        let n : i32 = name.byteLength as i32;
        self.out.push(n >> 8);
        self.out.push(n);
        self.out.pushText(name);
    }

    /** Starts the root compound with its (usually empty) name. */
    pub fn beginRoot(mut self, name : string) : void {
        self.header(NBT_TAG_COMPOUND, name);
    }

    /** Starts a named compound inside a compound. */
    pub fn beginCompound(mut self, name : string) : void {
        self.header(NBT_TAG_COMPOUND, name);
    }

    /** Ends the compound being written. */
    pub fn end(mut self) : void {
        self.out.push(NBT_TAG_END);
    }

    /** Writes a named byte. */
    pub fn putByte(mut self, name : string, v : i32) : void {
        self.header(NBT_TAG_BYTE, name);
        self.out.push(v);
    }

    /** Writes a named short. */
    pub fn putShort(mut self, name : string, v : i32) : void {
        self.header(NBT_TAG_SHORT, name);
        self.out.push(v >> 8);
        self.out.push(v);
    }

    /** Writes a named int. */
    pub fn putInt(mut self, name : string, v : i32) : void {
        self.header(NBT_TAG_INT, name);
        self.out.pushBe32(v);
    }

    /** Writes a named long. */
    pub fn putLong(mut self, name : string, v : i64) : void {
        self.header(NBT_TAG_LONG, name);
        self.pushLong(v);
    }

    /** Writes a named float. */
    pub fn putFloat(mut self, name : string, v : f32) : void {
        self.header(NBT_TAG_FLOAT, name);
        let slot : f32 = v;
        unsafe {
            let view : ptr<i32> = (&slot) as ptr<i32>;
            self.out.pushBe32(*view);
        }
    }

    /** Writes a named double. */
    pub fn putDouble(mut self, name : string, v : f64) : void {
        self.header(NBT_TAG_DOUBLE, name);
        let slot : f64 = v;
        unsafe {
            let view : ptr<i64> = (&slot) as ptr<i64>;
            self.pushLong(*view);
        }
    }

    /** Writes a named string. */
    pub fn putString(mut self, name : string, v : string) : void {
        self.header(NBT_TAG_STRING, name);
        self.writeName(v);
    }

    /** Writes the header of a named byte array of `n` bytes; push the bytes with `pushByte`. */
    pub fn beginByteArray(mut self, name : string, n : i32) : void {
        self.header(NBT_TAG_BYTE_ARRAY, name);
        self.out.pushBe32(n);
    }

    /** Writes the header of a named int array of `n` ints; push them with `pushInt`. */
    pub fn beginIntArray(mut self, name : string, n : i32) : void {
        self.header(NBT_TAG_INT_ARRAY, name);
        self.out.pushBe32(n);
    }

    /** Writes the header of a named long array of `n` longs; push them with `pushLong`. */
    pub fn beginLongArray(mut self, name : string, n : i32) : void {
        self.header(NBT_TAG_LONG_ARRAY, name);
        self.out.pushBe32(n);
    }

    /** Writes the header of a named list of `n` elements of type `elemType`. */
    pub fn beginList(mut self, name : string, elemType : i32, n : i32) : void {
        self.header(NBT_TAG_LIST, name);
        self.out.push(elemType);
        self.out.pushBe32(n);
    }

    /** Writes one string element of a list of strings. */
    pub fn putStringItem(mut self, v : string) : void {
        self.writeName(v);
    }

    /** Writes one int element of a list of ints. */
    pub fn putIntItem(mut self, v : i32) : void {
        self.out.pushBe32(v);
    }

    /** Appends a raw byte (array contents). */
    pub fn pushByte(mut self, v : i32) : void {
        self.out.push(v);
    }

    /** Appends a raw int (array contents). */
    pub fn pushInt(mut self, v : i32) : void {
        self.out.pushBe32(v);
    }

    /** Appends a raw long (array contents). */
    pub fn pushLong(mut self, v : i64) : void {
        self.out.pushBe32((v >> NBT_WRITER_WORD_BITS) as i32);
        self.out.pushBe32(v as i32);
    }

    /** Appends bytes `from..to` of `src` unchanged: a tag copied from a reader, header included. */
    pub fn copyRaw(mut self, src : ByteBuf, from : i32, to : i32) : void {
        self.out.pushRange(src, from, to);
    }

    /** The list type id for compounds, so callers do not import the tag constants. */
    pub static fn compoundType() : i32 {
        return NBT_TAG_COMPOUND;
    }
}

// files — whole files in and out of a `ByteBuf`, and images by path.
//
// The one place of the data layer that touches the disk, so every codec above stays a function from bytes to
// bytes and can be tested without a file. Failures are `IOException`s; a file that opens but holds no valid PNG
// is an `IOException` too, with the codec's reason in its message.

use std::io::{FileInputStream, FileOutputStream, FileOpenMode};

use crate::data::bytes::ByteBuf;
use crate::data::image::image::Image;
use crate::data::image::png::PngCodec;

/** Bytes asked of the stream at a time: a whole file is copied in runs of this size. */
const FILES_CHUNK : i32 = 65536;

/** Reads and writes whole files. */
pub class DataFiles {
    /** The bytes of the file at `path`. */
    pub static fn read(path : string) : ByteBuf ! IOException {
        let stream = new FileInputStream(path);
        let out : ByteBuf = new ByteBuf(FILES_CHUNK);
        let mut chunk : i8[] = malloc<i8>(FILES_CHUNK as i64);

        let mut n : i64 = stream.readBytes(chunk, 0, FILES_CHUNK);
        while (n > 0) {
            let count : i32 = n as i32;
            for (i of 0..count) {
                out.push(chunk[i] as i32);
            }
            n = stream.readBytes(chunk, 0, FILES_CHUNK);
        }

        stream.close();
        return out;
    }

    /** Writes `bytes` to `path`, replacing the file. */
    pub static fn write(path : string, bytes : ByteBuf) : void ! IOException {
        let stream = new FileOutputStream(path, FileOpenMode::WRITE);
        stream.writeBytes(bytes.raw(), 0, bytes.len());
        stream.close();
    }

    /** The picture in the PNG file at `path`. */
    pub static fn loadPng(path : string) : Image ! IOException {
        let codec : PngCodec = new PngCodec();
        let img : Image = codec.decode(DataFiles::read(path));
        if (img.isEmpty()) {
            throw IOException("${path}: ${codec.error()}");
        }
        return img;
    }

    /** Writes `img` to `path` as a PNG. */
    pub static fn savePng(path : string, img : Image) : void ! IOException {
        let codec : PngCodec = new PngCodec();
        DataFiles::write(path, codec.encode(img));
    }
}

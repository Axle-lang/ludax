// plane — one 32-bit value per voxel cell, laid out like the grid (slot * 4096 + local).
//
// The flood keeps its state in planes: three for block light (red, green, blue), one for the sky light and
// one for the sky seeds. A plane grows with the grid and a new chunk starts at zero, which in every plane
// means "no light".

use crate::core::math::scalar::maxI;
use crate::voxel::light::grid::VOX_CHUNK_CELLS;

/** An array of one `i32` per cell of a `VoxelGrid`, addressed by cell id. */
pub class VoxLightPlane {
    cells : i32[];
    room  : i32;

    /** An empty plane. */
    constructor() {
        self.room = 0;
        self.cells = new i32[1];
    }

    /** Makes the plane cover `slots` chunks; new cells are zero, existing ones are kept. */
    pub fn ensure(mut self, slots : i32) : void {
        if (slots <= self.room) {
            return;
        }
        let want : i32 = maxI(self.room * 2, slots);
        let total : i64 = want as i64 * VOX_CHUNK_CELLS as i64;
        let old : i64 = self.room as i64 * VOX_CHUNK_CELLS as i64;
        let mut bigger : i32[] = new i32[total];
        for (i of 0..old) {
            bigger[i] = self.cells[i];
        }
        for (i of old..total) {
            bigger[i] = 0;
        }
        self.cells = bigger;
        self.room = want;
    }

    /** The value of cell id `id`; 0 for a cell the plane does not cover yet. */
    pub fn get(self, id : i32) : i32 {
        if (!self.covers(id)) {
            return 0;
        }
        return self.cells[id as i64];
    }

    /** Sets the value of cell id `id`. */
    pub fn set(mut self, id : i32, v : i32) : void {
        if (!self.covers(id)) {
            return;
        }
        self.cells[id as i64] = v;
    }

    /** Sets every cell to zero. */
    pub fn clear(mut self) : void {
        for (i of 0..self.room as i64 * VOX_CHUNK_CELLS as i64) {
            self.cells[i] = 0;
        }
    }

    // True when cell id `id` is one this plane holds.
    fn covers(self, id : i32) : bool {
        return id >= 0 && id < self.room * VOX_CHUNK_CELLS;
    }
}

// sample — what a reader of the light gets back: one record, and the ambient-occlusion neighbour rule.
//
// `VoxelLightSample` is the read seam of the module: the same five terms whether the question is "the cell",
// "this corner of this face" or "this point in the world". They stay separate, as in voxel-axle's FaceLight:
// direct light (sun, block) and ambient (sky, bounce) are never summed here, because the shading that follows
// needs to dim one without the other (a cloud, a shadow) and to explain which one made a pixel.
//
//   blockLight     red, green, blue; 1.0 is a full-strength (255) lamp at its own cell. It can exceed 1 where
//                  lamps overlap.
//   skyLight       0..1, the flooded sky light (what reaches a cell through gaps and under overhangs).
//   sunVisibility  0..1, the share of the sun's disc that is visible (soft shadow).
//   skyAccess      0..1, the share of the sky hemisphere that is visible (ambient occlusion by distance).
//   bounceTint     the mean colour the sky rays saw: white in the open, tinted by what surrounds the cell.

use crate::core::math::vec3::Vec3;

// The darkest ambient-occlusion count: two solid sides close the corner whatever the diagonal is.
const VOX_AO_CLOSED : i32 = 3;

/** The light at a place, as the read seam hands it out. */
pub struct VoxelLightSample {
    /** Block light per channel, 1.0 = a 255 emission at its own cell. */
    pub blockLight : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Flooded sky light, 0..1. */
    pub skyLight : f32 = 1.0;

    /** Visible share of the sun's disc, 0..1. */
    pub sunVisibility : f32 = 1.0;

    /** Visible share of the sky hemisphere, 0..1. */
    pub skyAccess : f32 = 1.0;

    /** Mean colour seen by the sky rays: the hue of the ambient light. */
    pub bounceTint : Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 };

    /** What a place with nothing around it reads as: no lamps, full sky, full sun, white. */
    pub static fn open() : VoxelLightSample {
        return VoxelLightSample {};
    }
}

/**
 * The classic corner-darkening count for a vertex of a face: `side1` and `side2` say whether the two cells
 * beside the corner (in the plane in front of the face) are solid, `corner` whether the one diagonal to it
 * is. 0 is open, 3 is the deepest crease: two solid sides close the corner whatever the diagonal is.
 */
pub fn voxAo(side1 : bool, side2 : bool, corner : bool) : i32 {
    if (side1 && side2) {
        return VOX_AO_CLOSED;
    }
    let mut n : i32 = 0;
    if (side1) {
        n = n + 1;
    }
    if (side2) {
        n = n + 1;
    }
    if (corner) {
        n = n + 1;
    }
    return n;
}

/** A running weighted mean of samples. */
pub class VoxSampleMean {
    weight : f64 = 0.0;
    br     : f64 = 0.0;
    bg     : f64 = 0.0;
    bb     : f64 = 0.0;
    sky    : f64 = 0.0;
    sun    : f64 = 0.0;
    access : f64 = 0.0;
    tr     : f64 = 0.0;
    tg     : f64 = 0.0;
    tb     : f64 = 0.0;

    /** An empty mean. */
    constructor() {}

    /** Adds `s` with weight `w`. */
    pub fn add(mut self, s : VoxelLightSample, w : f64) : void {
        self.weight = self.weight + w;
        self.br = self.br + w * s.blockLight.x as f64;
        self.bg = self.bg + w * s.blockLight.y as f64;
        self.bb = self.bb + w * s.blockLight.z as f64;
        self.sky = self.sky + w * s.skyLight as f64;
        self.sun = self.sun + w * s.sunVisibility as f64;
        self.access = self.access + w * s.skyAccess as f64;
        self.tr = self.tr + w * s.bounceTint.x as f64;
        self.tg = self.tg + w * s.bounceTint.y as f64;
        self.tb = self.tb + w * s.bounceTint.z as f64;
    }

    /** The total weight added. */
    pub fn total(self) : f64 {
        return self.weight;
    }

    /** The mean; `fallback` when nothing was added. */
    pub fn result(self, fallback : VoxelLightSample) : VoxelLightSample {
        if (self.weight <= 0.0) {
            return fallback;
        }
        let k : f64 = 1.0 / self.weight;
        return VoxelLightSample {
            blockLight: Vec3 { x: (self.br * k) as f32, y: (self.bg * k) as f32, z: (self.bb * k) as f32 },
            skyLight: (self.sky * k) as f32,
            sunVisibility: (self.sun * k) as f32,
            skyAccess: (self.access * k) as f32,
            bounceTint: Vec3 { x: (self.tr * k) as f32, y: (self.tg * k) as f32, z: (self.tb * k) as f32 },
        };
    }
}

/** The scale from a byte to 0..1, as an `f32` constant. */
const VOX_UNIT_SCALE : f32 = 0.003921568627450980;

/** A byte-sized level 0..255 (or more, for summed lamps) as light in units of 1.0 = 255. */
pub fn voxUnit(level : i32) : f32 {
    return level as f32 * VOX_UNIT_SCALE;
}

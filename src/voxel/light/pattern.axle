// pattern — the fixed fans of rays the bakes cast: a disc for the sun, a hemisphere for the sky.
//
// No random numbers per frame: both fans are a low-discrepancy spiral (Vogel's golden-angle sunflower), so
// `n` rays cover the disc or the hemisphere evenly with no clumps, and the same fan comes out of every run
// and every machine (the trig is the engine's own deterministic one). A fan of n rays on a plain spiral
// gives n+1 visible shades of penumbra and bands; to break the bands each cell uses one of 16 copies of the
// fan, turned by a multiple of 1/16 of a turn, chosen by a hash of the cell's coordinates: a fixed function
// of position, so a cell's answer never flickers, but neighbours do not share their bands. Copy 0 is the
// unturned fan, which is what the analytic tests use.

use crate::core::id::hash::{hashCombine, hashMix};
use crate::core::math::scalar::TAU_D;
use crate::core::math::trig::{cosD, sinD, sqrtD};

/** How many turned copies of a fan exist. */
pub const VOX_ROTATIONS : i32 = 16;

// The golden angle in radians, pi * (3 - sqrt 5).
const VOX_GOLDEN_ANGLE : f64 = 2.39996322972865332;

// Every ray stores three coordinates, even when the fan is flat.
const VOX_FAN_STRIDE : i32 = 3;

/** A fan of `count()` unit directions or disc points in 16 turned copies. */
pub class VoxRayPattern {
    data  : f64[];
    total : i32;

    /**
     * The sunflower on the unit disc: `n` points (a, b) with a^2 + b^2 < 1, equal area each. Read with
     * `a` and `b`.
     */
    pub static fn disc(n : i32) : VoxRayPattern {
        let p : VoxRayPattern = new VoxRayPattern(n);
        for (k of 0..VOX_ROTATIONS) {
            let turn : f64 = TAU_D * k as f64 / VOX_ROTATIONS as f64;
            for (i of 0..n) {
                let r : f64 = sqrtD((i as f64 + 0.5) / n as f64);
                let angle : f64 = VOX_GOLDEN_ANGLE * i as f64 + turn;
                p.put(k, i, r * cosD(angle), r * sinD(angle), 0.0);
            }
        }
        return p;
    }

    /**
     * `n` unit directions in the upper hemisphere around +Y, cosine weighted (more rays near the zenith,
     * where they matter for ambient light). Read with `a` (x), `b` (y, always > 0) and `c` (z).
     */
    pub static fn hemisphere(n : i32) : VoxRayPattern {
        let p : VoxRayPattern = new VoxRayPattern(n);
        for (k of 0..VOX_ROTATIONS) {
            let turn : f64 = TAU_D * k as f64 / VOX_ROTATIONS as f64;
            for (i of 0..n) {
                let u : f64 = (i as f64 + 0.5) / n as f64;
                let r : f64 = sqrtD(u);
                let angle : f64 = VOX_GOLDEN_ANGLE * i as f64 + turn;
                p.put(k, i, r * cosD(angle), sqrtD(1.0 - u), r * sinD(angle));
            }
        }
        return p;
    }

    constructor(n : i32) {
        self.total = n;
        self.data = new f64[n as i64 * VOX_ROTATIONS as i64 * VOX_FAN_STRIDE as i64];
    }

    fn put(mut self, copy : i32, i : i32, a : f64, b : f64, c : f64) : void {
        let at : i64 = VoxRayPattern::slot(copy, i, self.total);
        self.data[at] = a;
        self.data[at + 1] = b;
        self.data[at + 2] = c;
    }

    // The first component of ray `i` of `copy` in the flat array.
    static fn slot(copy : i32, i : i32, total : i32) : i64 {
        return (copy as i64 * total as i64 + i as i64) * VOX_FAN_STRIDE as i64;
    }

    /** How many rays are in the fan. */
    pub fn count(self) : i32 {
        return self.total;
    }

    /** First coordinate of ray `i` in copy `copy`. */
    pub fn a(self, copy : i32, i : i32) : f64 {
        return self.data[VoxRayPattern::slot(copy, i, self.total)];
    }

    /** Second coordinate of ray `i` in copy `copy`. */
    pub fn b(self, copy : i32, i : i32) : f64 {
        return self.data[VoxRayPattern::slot(copy, i, self.total) + 1];
    }

    /** Third coordinate of ray `i` in copy `copy` (0 for a disc). */
    pub fn c(self, copy : i32, i : i32) : f64 {
        return self.data[VoxRayPattern::slot(copy, i, self.total) + 2];
    }

    /** The copy a cell uses: 0..15, a fixed hash of its coordinates; always 0 when `turned` is false. */
    pub static fn copyFor(x : i32, y : i32, z : i32, turned : bool) : i32 {
        if (!turned) {
            return 0;
        }
        let h : i64 = hashCombine(hashCombine(hashMix(x as i64), hashMix(y as i64)), hashMix(z as i64));
        return (h & (VOX_ROTATIONS - 1)) as i32;
    }
}

// queue — the work list of a flood: a FIFO of 64-bit entries that grows when it fills.
//
// The engine's `Ring` has a fixed capacity on purpose (it must not allocate in steady state); a flood cannot
// know how many cells an edit will touch. This wrapper keeps a `Ring` and, when the ring is full, moves its
// contents into one twice the size. A flood step is then a push and a pop on a ring, with growth being rare.
// An entry packs a cell id (low 32 bits) and a payload (high 32 bits: the old key in the removal pass).

use crate::core::collections::ring::Ring;

// An entry is a payload in the high half and a cell id in the low half.
const VOX_QUEUE_HALF : i32 = 32;
const VOX_QUEUE_HALF_MASK : i64 = 4294967295;

/** A first-in first-out queue of `(id, payload)` pairs. */
pub class VoxLightQueue {
    ring : Ring<i64>;

    /** An empty queue with room for `capacity` entries before its first growth. */
    constructor(capacity : i32) {
        self.ring = new Ring<i64>(capacity);
    }

    /** True when nothing is queued. */
    pub fn isEmpty(self) : bool {
        return self.ring.isEmpty();
    }

    /** How many entries are queued. */
    pub fn len(self) : i32 {
        return self.ring.len();
    }

    /** Queues cell `id` with `payload`. */
    pub fn push(mut self, id : i32, payload : i32) : void {
        if (self.ring.isFull()) {
            self.grow();
        }
        self.ring.push((payload as i64) << VOX_QUEUE_HALF | (id as i64));
    }

    /** Removes the oldest entry and returns it; aborts when empty. */
    pub fn pop(mut self) : i64 {
        return self.ring.pop();
    }

    /** The cell id of a popped entry. */
    pub static fn idOf(entry : i64) : i32 {
        return (entry & VOX_QUEUE_HALF_MASK) as i32;
    }

    /** The payload of a popped entry. */
    pub static fn payloadOf(entry : i64) : i32 {
        return (entry >> VOX_QUEUE_HALF) as i32;
    }

    /** Drops every entry. */
    pub fn clear(mut self) : void {
        self.ring.clear();
    }

    fn grow(mut self) : void {
        let bigger : Ring<i64> = new Ring<i64>(self.ring.capacity() * 2);
        while (!self.ring.isEmpty()) {
            bigger.push(self.ring.pop());
        }
        self.ring = bigger;
    }
}

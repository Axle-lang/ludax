// dda — walking a ray through the voxel cells it crosses, in order (Amanatides & Woo).
//
// Every bake in the module (sun, sky access, bounce) is a bundle of rays, and every ray is this one
// traversal, so it is written once and tested against a brute-force reference. The walk is in `f64`: a long
// ray accumulates the `tMax` values by repeated addition, and an `f32` would drift a cell off after a few
// hundred steps.
//
// The ray is `origin + t * dir` with `dir` of unit length (so `t` is a distance). The first cell is the one
// holding the origin, entered at t = 0. When the ray passes exactly through an edge or corner the axes are
// stepped one after another in the order x, y, z; that is the documented tie rule, and the cell between two
// diagonal cells is therefore visited (at the same t) rather than skipped, which keeps a thin diagonal wall
// from leaking.

/** The largest `t` of an axis the ray never moves along. */
const VOX_DDA_NEVER : f64 = 1000000000000.0;

/** The cell (as a coordinate) containing the real coordinate `v`: rounds toward minus infinity. */
pub fn voxFloor(v : f64) : i32 {
    let t : i32 = v as i32;
    if ((t as f64) > v) {
        return t - 1;
    }
    return t;
}

/** A ray walker. Call `start`, then read the current cell and call `advance` for the next. */
pub class VoxelDda {
    cx     : i32 = 0;
    cy     : i32 = 0;
    cz     : i32 = 0;
    stepX  : i32 = 0;
    stepY  : i32 = 0;
    stepZ  : i32 = 0;
    nextX  : f64 = 0.0;
    nextY  : f64 = 0.0;
    nextZ  : f64 = 0.0;
    deltaX : f64 = 0.0;
    deltaY : f64 = 0.0;
    deltaZ : f64 = 0.0;
    enter  : f64 = 0.0;
    via    : i32 = -1;

    /** A walker that has not started a ray. */
    constructor() {}

    /** Begins a ray at (ox, oy, oz) going along the unit vector (dx, dy, dz); the current cell is the origin's. */
    pub fn start(mut self, ox : f64, oy : f64, oz : f64, dx : f64, dy : f64, dz : f64) : void {
        self.cx = voxFloor(ox);
        self.cy = voxFloor(oy);
        self.cz = voxFloor(oz);
        self.enter = 0.0;
        self.via = -1;
        self.stepX = voxDdaSign(dx);
        self.stepY = voxDdaSign(dy);
        self.stepZ = voxDdaSign(dz);
        self.deltaX = voxDdaDelta(dx);
        self.deltaY = voxDdaDelta(dy);
        self.deltaZ = voxDdaDelta(dz);
        self.nextX = voxDdaFirst(ox, self.cx, dx);
        self.nextY = voxDdaFirst(oy, self.cy, dy);
        self.nextZ = voxDdaFirst(oz, self.cz, dz);
    }

    /** The x of the current cell. */
    pub fn x(self) : i32 {
        return self.cx;
    }

    /** The y of the current cell. */
    pub fn y(self) : i32 {
        return self.cy;
    }

    /** The z of the current cell. */
    pub fn z(self) : i32 {
        return self.cz;
    }

    /** The distance along the ray at which it entered the current cell. */
    pub fn entryT(self) : f64 {
        return self.enter;
    }

    /** The distance along the ray at which it will leave the current cell. */
    pub fn exitT(self) : f64 {
        let mut t : f64 = self.nextX;
        if (self.nextY < t) {
            t = self.nextY;
        }
        if (self.nextZ < t) {
            t = self.nextZ;
        }
        return t;
    }

    /** The face of the current cell the ray came in through (see `VoxelGrid` numbering); -1 at the start. */
    pub fn entryFace(self) : i32 {
        return self.via;
    }

    /** Moves to the next cell along the ray. */
    pub fn advance(mut self) : void {
        if (self.nextX <= self.nextY && self.nextX <= self.nextZ) {
            self.enter = self.nextX;
            self.nextX = self.nextX + self.deltaX;
            self.cx = self.cx + self.stepX;
            self.via = VoxelDda::faceOf(0, self.stepX);
            return;
        }
        if (self.nextY <= self.nextZ) {
            self.enter = self.nextY;
            self.nextY = self.nextY + self.deltaY;
            self.cy = self.cy + self.stepY;
            self.via = VoxelDda::faceOf(1, self.stepY);
            return;
        }
        self.enter = self.nextZ;
        self.nextZ = self.nextZ + self.deltaZ;
        self.cz = self.cz + self.stepZ;
        self.via = VoxelDda::faceOf(2, self.stepZ);
    }

    // The face of the cell entered by a step along `axis` in direction `step`: the ray comes in through the
    // opposite face, 2 * axis being the positive one.
    static fn faceOf(axis : i32, step : i32) : i32 {
        if (step > 0) {
            return axis * 2 + 1;
        }
        return axis * 2;
    }
}

fn voxDdaSign(d : f64) : i32 {
    if (d > 0.0) {
        return 1;
    }
    if (d < 0.0) {
        return -1;
    }
    return 0;
}

// The distance along the ray between two crossings of cell boundaries on one axis.
fn voxDdaDelta(d : f64) : f64 {
    if (d == 0.0) {
        return VOX_DDA_NEVER;
    }
    if (d < 0.0) {
        return -1.0 / d;
    }
    return 1.0 / d;
}

// The distance along the ray at which it first leaves cell `c` along one axis.
fn voxDdaFirst(o : f64, c : i32, d : f64) : f64 {
    if (d == 0.0) {
        return VOX_DDA_NEVER;
    }
    if (d > 0.0) {
        return ((c + 1) as f64 - o) / d;
    }
    return (c as f64 - o) / d;
}

// mesher — turns the blocks of one chunk into a `VoxMesh`, looking across the borders into its neighbours.
//
// The chunk and a one-block shell around it are copied into an 18 x 18 x 18 array first (the shell comes from
// the six face neighbours, the twelve edge neighbours and the eight corner neighbours through the store; a chunk
// that is not loaded reads as air). After that every question is an array read: whether a face shows, and the
// three cells that decide the ambient occlusion of each of a face's four corners.
//
// A face of block A shows when the cell across it is clear and not the same stuff as A (see `faceShows`). For
// each of the six directions and each of the 16 layers a 16 x 16 mask of shown faces is built and then either
// emitted tile by tile (face culling) or merged greedily into rectangles of one block id. Rectangles are only
// merged when the shading is flat across them, i.e. all four corners of a tile have the same occlusion count and
// neighbouring tiles agree: merging a tile whose corners differ would smear its shading over the rectangle, so
// those stay single. The result is identical in light to the tile-by-tile mesh, with fewer triangles.

use crate::voxel::light::sample::voxAo;
use crate::voxel::world::blocks::VoxBlocks;
use crate::voxel::world::chunk::VoxChunk;
use crate::voxel::world::mesh::VoxMesh;
use crate::voxel::world::store::VoxChunkStore;

// The padded grid is one block of shell around a 16-cube, 18 cells a side.
const MESH_SIDE : i32 = 16;
const MESH_SHELL : i32 = 1;
const MESH_PAD : i32 = 18;

// Its strides: local (x, y, z) sits at MESH_ORIGIN + x + MESH_STRIDE_Y * y + MESH_STRIDE_Z * z.
const MESH_STRIDE_X : i32 = 1;
const MESH_STRIDE_Y : i32 = 324;
const MESH_STRIDE_Z : i32 = 18;
const MESH_ORIGIN : i32 = 343;

// The padded array, one layer of the padded grid, and the chunk it wraps.
const MESH_PAD_CELLS : i32 = 5832;
const MESH_LAYER_CELLS : i32 = 256;
const MESH_CHUNK_CELLS : i32 = 4096;

// The chunk's local index is y * 256 + z * 16 + x.
const MESH_LOCAL_Z_SHIFT : i32 = 4;
const MESH_LOCAL_Y_SHIFT : i32 = 8;

const MESH_ZERO : f32 = 0.0;

// One rectangle of a layer: which axis and side, the layer it sits on, where and how big, and what it shows.
struct MeshRect {
    axis   : i32 = 0;
    sign   : i32 = 1;
    layer  : i32 = 0;
    a      : i32 = 0;
    b      : i32 = 0;
    width  : i32 = 0;
    height : i32 = 0;
    block  : i32 = 0;
    shade  : i32 = 0;
}

/** A mesh builder. It keeps scratch arrays, so reuse one per thread. */
pub class VoxMesher {
    cells : i32[];
    block : i32[];
    shade : i32[];
    taken : i32[];
    flat  : i32[];

    /** A mesher. */
    constructor() {
        self.cells = malloc<i32>(MESH_PAD_CELLS as i64);
        self.block = malloc<i32>(MESH_LAYER_CELLS as i64);
        self.shade = malloc<i32>(MESH_LAYER_CELLS as i64);
        self.taken = malloc<i32>(MESH_LAYER_CELLS as i64);
        self.flat = malloc<i32>(MESH_CHUNK_CELLS as i64);
    }

    fn stride(axis : i32) : i32 {
        if (axis == 0) {
            return MESH_STRIDE_X;
        }
        if (axis == 1) {
            return MESH_STRIDE_Y;
        }
        return MESH_STRIDE_Z;
    }

    // Copies chunk (cx, cy, cz) and the shell around it into the padded array.
    fn gather(mut self, store : VoxChunkStore, cx : i32, cy : i32, cz : i32) : void {
        let x0 : i32 = cx * MESH_SIDE;
        let y0 : i32 = cy * MESH_SIDE;
        let z0 : i32 = cz * MESH_SIDE;
        if (store.has(cx, cy, cz)) {
            let chunk : VoxChunk = store.chunk(cx, cy, cz);
            chunk.copyCells(self.flat);
        } else {
            for (i of 0..MESH_CHUNK_CELLS) {
                self.flat[i as i64] = 0;
            }
        }
        for (y of 0 - MESH_SHELL..MESH_SIDE + MESH_SHELL) {
            for (z of 0 - MESH_SHELL..MESH_SIDE + MESH_SHELL) {
                for (x of 0 - MESH_SHELL..MESH_SIDE + MESH_SHELL) {
                    let at : i64 = (MESH_ORIGIN + x * MESH_STRIDE_X + y * MESH_STRIDE_Y
                        + z * MESH_STRIDE_Z) as i64;
                    if (x >= 0 && x < MESH_SIDE && y >= 0 && y < MESH_SIDE && z >= 0 && z < MESH_SIDE) {
                        let local : i32 = (y << MESH_LOCAL_Y_SHIFT) | (z << MESH_LOCAL_Z_SHIFT) | x;
                        self.cells[at] = self.flat[local as i64];
                    } else {
                        self.cells[at] = store.blockAt(x0 + x, y0 + y, z0 + z);
                    }
                }
            }
        }
    }

    fn occ(self, at : i32) : bool {
        return VoxBlocks::occludes(self.cells[at as i64]);
    }

    // The occlusion count of the corner of a face whose front cell is `front`, towards (+-su, +-sv).
    fn corner(self, front : i32, du : i32, dv : i32) : i32 {
        return voxAo(self.occ(front + du), self.occ(front + dv), self.occ(front + du + dv));
    }

    // The coordinate on world axis `ax` of a point given by its coordinate along the face axis `d` and along the two tangents.
    fn comp(d : i32, ax : i32, pd : f32, pu : f32, pv : f32) : f32 {
        if (ax == d) {
            return pd;
        }
        if (ax == (d + 1) % 3) {
            return pu;
        }
        return pv;
    }

    fn unitOf(d : i32, ax : i32, sign : i32) : f32 {
        if (ax != d) {
            return MESH_ZERO;
        }
        return sign as f32;
    }

    // Adds the vertex at tangent corner (cu, cv) of the rectangle, on `plane` cells along the face axis.
    fn corner4(mut self, mesh : VoxMesh, r : MeshRect, plane : i32, cu : i32, cv : i32, ao : i32) : void {
        let pu : f32 = (r.a + cu * r.width) as f32;
        let pv : f32 = (r.b + cv * r.height) as f32;
        let pd : f32 = plane as f32;
        mesh.vertex(
            VoxMesher::comp(r.axis, 0, pd, pu, pv),
            VoxMesher::comp(r.axis, 1, pd, pu, pv),
            VoxMesher::comp(r.axis, 2, pd, pu, pv),
            VoxMesher::unitOf(r.axis, 0, r.sign),
            VoxMesher::unitOf(r.axis, 1, r.sign),
            VoxMesher::unitOf(r.axis, 2, r.sign),
            (cu * r.width) as f32,
            (cv * r.height) as f32,
            r.block,
            ao
        );
    }

    // Emits the four vertices of `r` in the winding its side needs.
    fn emit(mut self, mesh : VoxMesh, r : MeshRect) : void {
        let ao0 : i32 = r.shade & 3;
        let ao1 : i32 = (r.shade >> 2) & 3;
        let ao2 : i32 = (r.shade >> 4) & 3;
        let ao3 : i32 = (r.shade >> 6) & 3;
        let mut plane : i32 = r.layer;
        if (r.sign > 0) {
            plane = r.layer + 1;
            self.corner4(mesh, r, plane, 0, 0, ao0);
            self.corner4(mesh, r, plane, 1, 0, ao1);
            self.corner4(mesh, r, plane, 1, 1, ao2);
            self.corner4(mesh, r, plane, 0, 1, ao3);
        } else {
            self.corner4(mesh, r, plane, 0, 0, ao0);
            self.corner4(mesh, r, plane, 0, 1, ao3);
            self.corner4(mesh, r, plane, 1, 1, ao2);
            self.corner4(mesh, r, plane, 1, 0, ao1);
        }
        mesh.quad(r.width * r.height, ao0 + ao2 > ao1 + ao3);
    }

    /**
     * Builds the mesh of chunk (cx, cy, cz) into `mesh` (which is cleared first). `greedy` merges equal flat
     * tiles into rectangles; false emits one quad per exposed block face. Neighbouring chunks that are not
     * loaded count as air, so build once the neighbours are in.
     */
    pub fn build(
        mut self,
        store : VoxChunkStore,
        cx : i32,
        cy : i32,
        cz : i32,
        mesh : VoxMesh,
        greedy : bool
    ) : void {
        mesh.clear();
        if (!store.has(cx, cy, cz)) {
            return;
        }
        let here : VoxChunk = store.chunk(cx, cy, cz);
        if (here.isUniform() && here.firstBlock() == 0) {
            return;
        }
        self.gather(store, cx, cy, cz);
        for (d of 0..3) {
            let u : i32 = (d + 1) % 3;
            let v : i32 = (d + 2) % 3;
            let sd : i32 = VoxMesher::stride(d);
            let su : i32 = VoxMesher::stride(u);
            let sv : i32 = VoxMesher::stride(v);
            for (side of 0..2) {
                let mut sign : i32 = 1;
                if (side == 1) {
                    sign = -1;
                }
                for (s of 0..MESH_SIDE) {
                    let mut any : bool = false;
                    for (b of 0..MESH_SIDE) {
                        for (a of 0..MESH_SIDE) {
                            let base : i32 = MESH_ORIGIN + s * sd + a * su + b * sv;
                            let at : i64 = (b * MESH_SIDE + a) as i64;
                            let mine : i32 = self.cells[base as i64];
                            let front : i32 = base + sign * sd;
                            self.taken[at] = 0;
                            self.block[at] = 0;
                            if (VoxBlocks::faceShows(mine, self.cells[front as i64])) {
                                self.block[at] = mine;
                                self.shade[at] = self.corner(front, 0 - su, 0 - sv)
                                    | (self.corner(front, su, 0 - sv) << 2)
                                    | (self.corner(front, su, sv) << 4)
                                    | (self.corner(front, 0 - su, sv) << 6);
                                mesh.expose();
                                any = true;
                            }
                        }
                    }
                    if (any) {
                        self.mergeSlice(mesh, d, sign, s, greedy);
                    }
                }
            }
        }
    }

    // Emits the rectangles of the mask in `block` / `shade` for layer `s`.
    fn mergeSlice(mut self, mesh : VoxMesh, d : i32, sign : i32, s : i32, greedy : bool) : void {
        for (b of 0..MESH_SIDE) {
            let mut a : i32 = 0;
            while (a < MESH_SIDE) {
                let i : i32 = b * MESH_SIDE + a;
                if (self.block[i as i64] == 0 || self.taken[i as i64] == 1) {
                    a = a + 1;
                } else {
                    let id : i32 = self.block[i as i64];
                    let sig : i32 = self.shade[i as i64];
                    let even : bool = (sig & 3) == ((sig >> 2) & 3) && ((sig >> 2) & 3) == ((sig >> 4) & 3)
                        && ((sig >> 4) & 3) == ((sig >> 6) & 3);
                    let mut w : i32 = 1;
                    let mut h : i32 = 1;
                    if (greedy && even) {
                        while (a + w < MESH_SIDE && self.same(i + w, id, sig)) {
                            w = w + 1;
                        }
                        let mut grow : bool = true;
                        while (grow && b + h < MESH_SIDE) {
                            for (k of 0..w) {
                                if (!self.same((b + h) * MESH_SIDE + a + k, id, sig)) {
                                    grow = false;
                                }
                            }
                            if (grow) {
                                h = h + 1;
                            }
                        }
                    }
                    for (rb of 0..h) {
                        for (ra of 0..w) {
                            self.taken[((b + rb) * MESH_SIDE + a + ra) as i64] = 1;
                        }
                    }
                    let r : MeshRect = MeshRect {
                        axis: d,
                        sign: sign,
                        layer: s,
                        a: a,
                        b: b,
                        width: w,
                        height: h,
                        block: id,
                        shade: sig,
                    };
                    self.emit(mesh, r);
                    a = a + w;
                }
            }
        }
    }

    // True when mask cell `i` is free and holds the same block and shading.
    fn same(self, i : i32, id : i32, sig : i32) : bool {
        return self.taken[i as i64] == 0 && self.block[i as i64] == id && self.shade[i as i64] == sig;
    }

    /** Counts the exposed block faces of chunk (cx, cy, cz) the slow, obvious way: every cell against its six neighbours. */
    pub static fn bruteExposed(store : VoxChunkStore, cx : i32, cy : i32, cz : i32) : i32 {
        let mut n : i32 = 0;
        for (y of 0..MESH_SIDE) {
            for (z of 0..MESH_SIDE) {
                for (x of 0..MESH_SIDE) {
                    let wx : i32 = cx * MESH_SIDE + x;
                    let wy : i32 = cy * MESH_SIDE + y;
                    let wz : i32 = cz * MESH_SIDE + z;
                    let here : i32 = store.blockAt(wx, wy, wz);
                    if (VoxBlocks::faceShows(here, store.blockAt(wx + 1, wy, wz))) {
                        n = n + 1;
                    }
                    if (VoxBlocks::faceShows(here, store.blockAt(wx - 1, wy, wz))) {
                        n = n + 1;
                    }
                    if (VoxBlocks::faceShows(here, store.blockAt(wx, wy + 1, wz))) {
                        n = n + 1;
                    }
                    if (VoxBlocks::faceShows(here, store.blockAt(wx, wy - 1, wz))) {
                        n = n + 1;
                    }
                    if (VoxBlocks::faceShows(here, store.blockAt(wx, wy, wz + 1))) {
                        n = n + 1;
                    }
                    if (VoxBlocks::faceShows(here, store.blockAt(wx, wy, wz - 1))) {
                        n = n + 1;
                    }
                }
            }
        }
        return n;
    }
}

// chunk — 16 x 16 x 16 blocks stored as a palette and packed indices.
//
// Most chunks of a world hold very few kinds of block, so a chunk keeps a palette (the distinct block ids it has
// seen) and, per cell, the index of its block in the palette. The index width follows the palette: no array at
// all while the whole chunk is one block (open sky, solid rock), 4 bits per cell up to 16 entries, 8 bits up to
// 256, 16 bits beyond. A write that needs a new palette entry the current width cannot name widens the packing
// first. The palette only grows while a chunk is edited (an overwritten block stays in it); `compact` rebuilds
// the smallest one, and is what saving does.
//
// The cell order is the light module's: local index `y * 256 + z * 16 + x`, so a chunk copies into a
// `VoxelGrid` slot without a permutation. Two flags travel with the data: `dirty` (the blocks changed since
// the mesh was last built) and `edited` (they differ from what the generator makes, so the chunk must be kept
// when it leaves memory).

use std::ffi::runtime::panicMsg;

/** Cells in a chunk. */
pub const VW_CELLS : i32 = 4096;

/** Blocks along one side of a chunk. */
pub const VW_SIDE : i32 = 16;

// Bookkeeping bytes counted per chunk by `bytesUsed`: the object, its flags and its two array headers.
const VW_CHUNK_OVERHEAD : i32 = 96;

// The packings a chunk can use: one value for the whole chunk, then 4, 8 or 16 bits per cell.
const VW_BITS_UNIFORM : i32 = 0;
const VW_BITS_NIBBLE : i32 = 4;
const VW_BITS_BYTE : i32 = 8;
const VW_BITS_WORD : i32 = 16;

// Bits in a byte, and the masks a nibble packing needs.
const VW_BYTE_BITS : i32 = 8;
const VW_NIBBLE_MASK : i32 = 15;
const VW_NIBBLE_HIGH : i32 = 240;
const VW_BYTE_MASK : i32 = 255;

// The local index is y * 256 + z * 16 + x.
const VW_Z_SHIFT : i32 = 4;
const VW_Y_SHIFT : i32 = 8;

/** One chunk of blocks. */
pub class VoxChunk {
    palette    : i32[];
    palLen     : i32 = 1;
    palRoom    : i32 = 4;
    bits       : i32 = 0;
    data       : i8[];
    dataLen    : i32 = 0;
    flagDirty  : bool = true;
    flagEdited : bool = false;

    /** A chunk of air. */
    constructor() {
        self.palette = malloc<i32>(self.palRoom as i64);
        self.palette[0] = 0;
        self.data = malloc<i8>(1);
    }

    /** True while every cell holds the same block (the chunk stores no per-cell array). */
    pub fn isUniform(self) : bool {
        return self.bits == VW_BITS_UNIFORM;
    }

    /** The block of a uniform chunk (the first palette entry otherwise). */
    pub fn firstBlock(self) : i32 {
        return self.palette[0];
    }

    /** Bits used per cell: 0, 4, 8 or 16. */
    pub fn bitsPerCell(self) : i32 {
        return self.bits;
    }

    /** How many palette entries there are (some may be unused after edits; see `compact`). */
    pub fn paletteSize(self) : i32 {
        return self.palLen;
    }

    /** Palette entry `i`. */
    pub fn paletteAt(self, i : i32) : i32 {
        if (i < 0 || i >= self.palLen) {
            panicMsg("VoxChunk.paletteAt: index out of range");
        }
        return self.palette[i as i64];
    }

    /** The bytes of memory this chunk holds: palette, packed cells and bookkeeping. */
    pub fn bytesUsed(self) : i32 {
        return VW_CHUNK_OVERHEAD + self.palRoom * 4 + self.dataLen;
    }

    /** True when the blocks changed since `clearDirty` (the mesh is out of date). */
    pub fn isDirty(self) : bool {
        return self.flagDirty;
    }

    /** Marks the mesh as built. */
    pub fn clearDirty(mut self) : void {
        self.flagDirty = false;
    }

    /** Marks the blocks as changed. */
    pub fn markDirty(mut self) : void {
        self.flagDirty = true;
    }

    /** True when the chunk differs from what the generator makes there. */
    pub fn isEdited(self) : bool {
        return self.flagEdited;
    }

    /** Sets whether the chunk must be kept when it leaves memory. */
    pub fn setEdited(mut self, on : bool) : void {
        self.flagEdited = on;
    }

    /** The block at local index `i` (0..4095). */
    pub fn get(self, i : i32) : i32 {
        return self.palette[VoxChunk::readIndex(self.data, self.bits, i) as i64];
    }

    /** The block at local cell (x, y, z), each 0..15. */
    pub fn at(self, x : i32, y : i32, z : i32) : i32 {
        return self.get((y << VW_Y_SHIFT) | (z << VW_Z_SHIFT) | x);
    }

    // The palette index stored for cell `i`.
    fn readIndex(data : i8[], bits : i32, i : i32) : i32 {
        if (bits == VW_BITS_UNIFORM) {
            return 0;
        }
        if (bits == VW_BITS_NIBBLE) {
            let b : i32 = (data[(i >> 1) as i64] as i32) & VW_BYTE_MASK;
            if ((i & 1) == 0) {
                return b & VW_NIBBLE_MASK;
            }
            return b >> VW_BITS_NIBBLE;
        }
        if (bits == VW_BITS_BYTE) {
            return (data[i as i64] as i32) & VW_BYTE_MASK;
        }
        let lo : i32 = (data[(i * 2) as i64] as i32) & VW_BYTE_MASK;
        let hi : i32 = (data[(i * 2 + 1) as i64] as i32) & VW_BYTE_MASK;
        return lo | (hi << VW_BITS_BYTE);
    }

    fn writeIndex(mut data : i8[], bits : i32, i : i32, v : i32) : void {
        if (bits == VW_BITS_NIBBLE) {
            let at : i64 = (i >> 1) as i64;
            let b : i32 = (data[at] as i32) & VW_BYTE_MASK;
            if ((i & 1) == 0) {
                data[at] = ((b & VW_NIBBLE_HIGH) | v) as i8;
            } else {
                data[at] = ((b & VW_NIBBLE_MASK) | (v << VW_BITS_NIBBLE)) as i8;
            }
            return;
        }
        if (bits == VW_BITS_BYTE) {
            data[i as i64] = v as i8;
            return;
        }
        data[(i * 2) as i64] = (v & VW_BYTE_MASK) as i8;
        data[(i * 2 + 1) as i64] = ((v >> VW_BITS_BYTE) & VW_BYTE_MASK) as i8;
    }

    // Bytes the packed array needs at `bits` per cell.
    pub(crate) static fn bytesFor(bits : i32) : i32 {
        if (bits == VW_BITS_UNIFORM) {
            return 0;
        }
        return VW_CELLS * bits / VW_BYTE_BITS;
    }

    // How many palette entries `bits` can name.
    pub(crate) static fn capacityFor(bits : i32) : i32 {
        if (bits == VW_BITS_UNIFORM) {
            return 1;
        }
        return 1 << bits;
    }

    // The narrowest packing that names `entries` palette entries.
    static fn bitsFor(entries : i32) : i32 {
        if (entries <= VoxChunk::capacityFor(VW_BITS_UNIFORM)) {
            return VW_BITS_UNIFORM;
        }
        if (entries <= VoxChunk::capacityFor(VW_BITS_NIBBLE)) {
            return VW_BITS_NIBBLE;
        }
        if (entries <= VoxChunk::capacityFor(VW_BITS_BYTE)) {
            return VW_BITS_BYTE;
        }
        return VW_BITS_WORD;
    }

    // The palette index of `id`, or -1.
    fn find(self, id : i32) : i32 {
        for (i of 0..self.palLen) {
            if (self.palette[i as i64] == id) {
                return i;
            }
        }
        return -1;
    }

    // Appends `id` to the palette.
    fn addEntry(mut self, id : i32) : i32 {
        if (self.palLen == self.palRoom) {
            let mut bigger : i32[] = malloc<i32>((self.palRoom * 2) as i64);
            for (i of 0..self.palLen) {
                bigger[i as i64] = self.palette[i as i64];
            }
            self.palette = bigger;
            self.palRoom = self.palRoom * 2;
        }
        self.palette[self.palLen as i64] = id;
        self.palLen = self.palLen + 1;
        return self.palLen - 1;
    }

    // Re-packs the cells at `newBits` per cell (same palette).
    fn repack(mut self, newBits : i32) : void {
        let mut fresh : i8[] = malloc<i8>(VoxChunk::bytesFor(newBits) as i64 + 1);
        for (i of 0..VoxChunk::bytesFor(newBits)) {
            fresh[i as i64] = 0;
        }
        if (self.bits > 0) {
            for (i of 0..VW_CELLS) {
                VoxChunk::writeIndex(fresh, newBits, i, VoxChunk::readIndex(self.data, self.bits, i));
            }
        }
        self.data = fresh;
        self.dataLen = VoxChunk::bytesFor(newBits);
        self.bits = newBits;
    }

    /**
     * Sets the block at local index `i`. Returns true when the block changed. The chunk is marked dirty; it is
     * not marked edited (the caller decides whether a write is an edit or generation).
     */
    pub fn set(mut self, i : i32, id : i32) : bool {
        let mut p : i32 = self.find(id);
        if (p < 0) {
            if (self.palLen >= VoxChunk::capacityFor(self.bits)) {
                if (self.bits == VW_BITS_WORD) {
                    self.compact();
                    if (self.palLen >= VoxChunk::capacityFor(self.bits)) {
                        self.repack(VW_BITS_WORD);
                    }
                }
                if (self.palLen >= VoxChunk::capacityFor(self.bits)) {
                    self.repack(VoxChunk::bitsFor(self.palLen + 1));
                }
            }
            p = self.addEntry(id);
        }
        if (self.bits == VW_BITS_UNIFORM) {
            if (p == 0) {
                return false;
            }
            self.repack(VW_BITS_NIBBLE);
        }
        let old : i32 = VoxChunk::readIndex(self.data, self.bits, i);
        if (old == p) {
            return false;
        }
        VoxChunk::writeIndex(self.data, self.bits, i, p);
        self.flagDirty = true;
        return true;
    }

    /** Sets the block at local cell (x, y, z). Returns true when it changed. */
    pub fn put(mut self, x : i32, y : i32, z : i32, id : i32) : bool {
        return self.set((y << VW_Y_SHIFT) | (z << VW_Z_SHIFT) | x, id);
    }

    /** Makes every cell `id` and drops the per-cell array. */
    pub fn fillUniform(mut self, id : i32) : void {
        self.palette[0] = id;
        self.palLen = 1;
        self.bits = VW_BITS_UNIFORM;
        self.data = malloc<i8>(1);
        self.dataLen = 0;
        self.flagDirty = true;
    }

    /** Loads all 4096 cells from `cells` (block ids, local order) with the narrowest packing; flags untouched but dirty. */
    pub fn fromCells(mut self, cells : i32[]) : void {
        self.palLen = 0;
        let mut indices : i32[] = malloc<i32>(VW_CELLS as i64);
        for (i of 0..VW_CELLS) {
            let id : i32 = cells[i as i64];
            let mut p : i32 = -1;
            // The previous cell usually has the same block: try its slot before searching.
            if (i > 0 && self.palette[indices[(i - 1) as i64] as i64] == id) {
                p = indices[(i - 1) as i64];
            } else {
                p = self.find(id);
            }
            if (p < 0) {
                p = self.addEntry(id);
            }
            indices[i as i64] = p;
        }
        let want : i32 = VoxChunk::bitsFor(self.palLen);
        self.bits = want;
        self.dataLen = VoxChunk::bytesFor(want);
        self.data = malloc<i8>(self.dataLen as i64 + 1);
        for (i of 0..self.dataLen) {
            self.data[i as i64] = 0;
        }
        if (want > 0) {
            for (i of 0..VW_CELLS) {
                VoxChunk::writeIndex(self.data, want, i, indices[i as i64]);
            }
        }
        self.flagDirty = true;
    }

    /** Copies all 4096 blocks into `out` (local order). */
    pub fn copyCells(self, mut out : i32[]) : void {
        for (i of 0..VW_CELLS) {
            out[i as i64] = self.get(i);
        }
    }

    /** Rebuilds the palette with only the blocks in use, in order of first appearance, and the narrowest packing. */
    pub fn compact(mut self) : void {
        let mut cells : i32[] = malloc<i32>(VW_CELLS as i64);
        self.copyCells(cells);
        let wasDirty : bool = self.flagDirty;
        self.fromCells(cells);
        self.flagDirty = wasDirty;
    }

    /** How many different blocks the chunk actually holds (a count over the cells, not the palette). */
    pub fn distinctBlocks(self) : i32 {
        if (self.bits == VW_BITS_UNIFORM) {
            return 1;
        }
        let mut seen : i32[] = malloc<i32>(self.palLen as i64);
        for (p of 0..self.palLen) {
            seen[p as i64] = 0;
        }
        for (i of 0..VW_CELLS) {
            seen[VoxChunk::readIndex(self.data, self.bits, i) as i64] = 1;
        }
        let mut n : i32 = 0;
        for (p of 0..self.palLen) {
            n = n + seen[p as i64];
        }
        return n;
    }

    /** The packed byte `i` (for the writer of files). */
    pub(crate) fn packedByte(self, i : i32) : i32 {
        return (self.data[i as i64] as i32) & VW_BYTE_MASK;
    }

    /** The number of packed bytes. */
    pub(crate) fn packedLen(self) : i32 {
        return self.dataLen;
    }

    /**
     * Replaces the contents with a palette and packed cells read from a file. Returns false, leaving the chunk
     * untouched, when the pieces do not fit together (width, palette size, byte count, or an index past the palette).
     */
    pub(crate) fn restore(
        mut self,
        bits : i32,
        entries : i32[],
        count : i32,
        packed : i8[],
        packedLen : i32
    ) : bool {
        if (bits != VW_BITS_UNIFORM && bits != VW_BITS_NIBBLE && bits != VW_BITS_BYTE
            && bits != VW_BITS_WORD) {
            return false;
        }
        if (count < 1 || count > VoxChunk::capacityFor(bits) || packedLen != VoxChunk::bytesFor(bits)) {
            return false;
        }
        if (bits == VW_BITS_UNIFORM && count != 1) {
            return false;
        }
        for (i of 0..VW_CELLS) {
            if (bits > 0 && VoxChunk::readIndex(packed, bits, i) >= count) {
                return false;
            }
        }
        let mut pal : i32[] = malloc<i32>(count as i64 + 1);
        for (i of 0..count) {
            pal[i as i64] = entries[i as i64];
        }
        let mut data : i8[] = malloc<i8>(packedLen as i64 + 1);
        for (i of 0..packedLen) {
            data[i as i64] = packed[i as i64];
        }
        self.palette = pal;
        self.palRoom = count + 1;
        self.palLen = count;
        self.bits = bits;
        self.data = data;
        self.dataLen = packedLen;
        self.flagDirty = true;
        return true;
    }
}

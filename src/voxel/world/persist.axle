// persist — saving a world's edits to a file and reading them back.
//
// What is saved is the edit layer of the world and nothing else: the chunks someone changed, deflated, behind a
// checksummed table of contents (see region). Everything untouched is rebuilt from the seed on load, so a save
// of a world that was flown over for a thousand chunks and edited in three is three chunks long. The seed and
// sea level are not in the file; a game keeps them next to it (a world is "seed + edits").

use crate::data::bytes::ByteBuf;
use crate::data::files::DataFiles;
use crate::voxel::world::region::VoxRegion;
use crate::voxel::world::world::VoxWorld;

/** Whole-world save and load. */
pub class VoxWorldFiles {
    /** The edits of `world` as the bytes of a region file. */
    pub static fn toBytes(world : VoxWorld) : ByteBuf {
        return world.editRegion().toBytes();
    }

    /** Applies the edits in the region file `bytes` to `world`. False (the world unchanged) when they are damaged. */
    pub static fn fromBytes(world : VoxWorld, bytes : ByteBuf) : bool {
        let region : VoxRegion = new VoxRegion();
        if (!region.load(bytes)) {
            return false;
        }
        return world.applyRegion(region);
    }

    /** Writes the edits of `world` to the file `path`. */
    pub static fn save(path : string, world : VoxWorld) : void ! IOException {
        DataFiles::write(path, VoxWorldFiles::toBytes(world));
    }

    /** Reads the edits in the file `path` into `world`. False when the file is not a whole, undamaged region. */
    pub static fn load(path : string, world : VoxWorld) : bool ! IOException {
        return VoxWorldFiles::fromBytes(world, DataFiles::read(path));
    }
}

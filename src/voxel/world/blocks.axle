// blocks — the block ids of the streaming voxel world and what each one means to a mesher and to light.
//
// A block id is an `i32` stored in chunks; id 0 is air. The world module ships one small set (stone, dirt, grass,
// sand, water, snow, wood, leaves, bedrock, gravel, a lamp) because a terrain generator has to put something
// down. The table is data, not law: a game may define its own ids as long as it hands the world a matching
// `BlockLightTable`. The light table lives here too, so that the generator, the mesher and the light bridge agree
// on one answer to "is this block solid".

use crate::data::image::image::Image;
use crate::voxel::light::block::{BlockLight, BlockLightTable};

/** Air. */
pub const VW_AIR : i32 = 0;

/** Stone. */
pub const VW_STONE : i32 = 1;

/** Dirt. */
pub const VW_DIRT : i32 = 2;

/** Grass-topped dirt. */
pub const VW_GRASS : i32 = 3;

/** Sand. */
pub const VW_SAND : i32 = 4;

/** Water: clear, stops a little light, is not solid to the eye of a mesher (its faces show against air). */
pub const VW_WATER : i32 = 5;

/** Snow. */
pub const VW_SNOW : i32 = 6;

/** Tree trunk. */
pub const VW_LOG : i32 = 7;

/** Leaves: let light through, dimmed. */
pub const VW_LEAVES : i32 = 8;

/** Bedrock, the floor of the world. */
pub const VW_BEDROCK : i32 = 9;

/** Gravel. */
pub const VW_GRAVEL : i32 = 10;

/** A lamp, the one placeable light source. */
pub const VW_LAMP : i32 = 11;

/** How many ids the table above defines. */
pub const VW_BLOCK_COUNT : i32 = 12;

/** Ids the world's light table reserves: the blocks above, with room for a game's own ids. */
pub const VW_BLOCK_LIGHT_IDS : i32 = 16;

/** What the world's own blocks mean. All functions are pure. */
pub class VoxBlocks {
    /** True for a block a mesher draws a face against and a body cannot enter (air, water and leaves are not). */
    pub static fn isSolid(id : i32) : bool {
        return id != VW_AIR && id != VW_WATER && id != VW_LEAVES;
    }

    /** True for a block whose neighbours' faces must still be drawn: air, water and leaves. */
    pub static fn isTransparent(id : i32) : bool {
        return !VoxBlocks::isSolid(id);
    }

    /** True for a block that darkens the corners next to it (ambient occlusion): the opaque ones. */
    pub static fn occludes(id : i32) : bool {
        return VoxBlocks::isSolid(id);
    }

    /**
     * True when the face between a block `a` and its neighbour `b` is drawn on `a`'s side: `a` is something and
     * `b` is clear and not the same stuff (so water against water, or leaves against leaves, has no wall).
     */
    pub static fn faceShows(a : i32, b : i32) : bool {
        if (a == VW_AIR) {
            return false;
        }
        if (b == VW_AIR) {
            return true;
        }
        return VoxBlocks::isTransparent(b) && a != b;
    }

    /** A flat colour (an `Image` pixel) for a map of the world. */
    pub static fn color(id : i32) : i32 {
        return match id {
            VW_STONE => Image::pack(122, 122, 126, 255),
            VW_DIRT => Image::pack(121, 85, 58, 255),
            VW_GRASS => Image::pack(86, 140, 62, 255),
            VW_SAND => Image::pack(222, 207, 150, 255),
            VW_WATER => Image::pack(48, 96, 190, 255),
            VW_SNOW => Image::pack(240, 244, 250, 255),
            VW_LOG => Image::pack(100, 72, 40, 255),
            VW_LEAVES => Image::pack(52, 110, 44, 255),
            VW_BEDROCK => Image::pack(40, 40, 44, 255),
            VW_GRAVEL => Image::pack(140, 136, 132, 255),
            VW_LAMP => Image::pack(255, 224, 160, 255),
            _ => Image::pack(0, 0, 0, 0),
        };
    }

    /** The light table for the world's blocks: stone and friends stop all light, water and leaves some. */
    pub static fn lightTable() : BlockLightTable {
        let t : BlockLightTable = new BlockLightTable(VW_BLOCK_LIGHT_IDS);
        t.define(VW_STONE, BlockLight::solid(120, 120, 124));
        t.define(VW_DIRT, BlockLight::solid(121, 85, 58));
        t.define(VW_GRASS, BlockLight::solid(86, 140, 62));
        t.define(VW_SAND, BlockLight::solid(222, 207, 150));
        t.define(VW_WATER, BlockLight::tinted(70, 40, 12));
        t.define(VW_SNOW, BlockLight::solid(240, 244, 250));
        t.define(VW_LOG, BlockLight::solid(100, 72, 40));
        t.define(VW_LEAVES, BlockLight::tinted(90, 90, 90));
        t.define(VW_BEDROCK, BlockLight::solid(40, 40, 44));
        t.define(VW_GRAVEL, BlockLight::solid(140, 136, 132));
        t.define(VW_LAMP, BlockLight::lamp(255, 224, 160));
        return t;
    }
}

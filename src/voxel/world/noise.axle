// noise — integer hashes and smooth value noise for the terrain generator.
//
// Everything is a pure function of its integer inputs and the seed, so a chunk comes out the same on every run,
// every machine and every thread, and in whatever order chunks are generated. The hash is the SplitMix64
// finalizer of the core layer; the interpolation uses only `+` and `*` on `f32`, which are exact IEEE operations,
// so no libm call enters the result.

use crate::core::id::hash::mixI64;

const VN_INV_24 : f32 = 0.000000059604645;
const VN_TWO : f32 = 2.0;
const VN_THREE : f32 = 3.0;
const VN_HALF : f32 = 0.5;
const VN_ZERO : f32 = 0.0;
const VN_ONE : f32 = 1.0;
const VN_LACUNARITY : f32 = 2.03;

// The lattice hash keeps the 24 best-mixed bits of the 64-bit mixer.
const VN_HASH_SHIFT : i32 = 40;

// Each octave draws from a different seed.
const VN_OCTAVE_SALT : i32 = 31;

// Large primes that spread the three coordinates and the seed apart before mixing.
const VN_PRIME_X : i64 = 73856093;
const VN_PRIME_Y : i64 = 19349663;
const VN_PRIME_Z : i64 = 83492791;
const VN_PRIME_SEED : i64 = 2654435761;

/** Noise functions; every result is in [0, 1). */
pub class VoxNoise {
    /** 24 well-mixed bits for the lattice point (x, y, z) under `seed`. */
    pub static fn hash(x : i32, y : i32, z : i32, seed : i32) : i32 {
        let mut h : i64 = (x as i64) * VN_PRIME_X;
        h = h ^ ((y as i64) * VN_PRIME_Y);
        h = h ^ ((z as i64) * VN_PRIME_Z);
        h = h ^ ((seed as i64) * VN_PRIME_SEED);
        return (mixI64(h) >>> VN_HASH_SHIFT) as i32;
    }

    /** The cell containing `v`: rounds toward minus infinity. */
    pub static fn floor(v : f32) : i32 {
        let t : i32 = v as i32;
        if ((t as f32) > v) {
            return t - 1;
        }
        return t;
    }

    fn unit(x : i32, y : i32, z : i32, seed : i32) : f32 {
        return VoxNoise::hash(x, y, z, seed) as f32 * VN_INV_24;
    }

    fn fade(t : f32) : f32 {
        return t * t * (VN_THREE - VN_TWO * t);
    }

    /** Smooth value noise on the xz plane. */
    pub static fn value2(x : f32, z : f32, seed : i32) : f32 {
        let ix : i32 = VoxNoise::floor(x);
        let iz : i32 = VoxNoise::floor(z);
        let fx : f32 = VoxNoise::fade(x - ix as f32);
        let fz : f32 = VoxNoise::fade(z - iz as f32);
        let a : f32 = VoxNoise::unit(ix, 0, iz, seed);
        let b : f32 = VoxNoise::unit(ix + 1, 0, iz, seed);
        let c : f32 = VoxNoise::unit(ix, 0, iz + 1, seed);
        let d : f32 = VoxNoise::unit(ix + 1, 0, iz + 1, seed);
        let top : f32 = a + (b - a) * fx;
        let bottom : f32 = c + (d - c) * fx;
        return top + (bottom - top) * fz;
    }

    /** Fractal noise on the xz plane: `octaves` layers, each finer and half as strong, normalised. */
    pub static fn fbm2(x : f32, z : f32, octaves : i32, seed : i32) : f32 {
        let mut sum : f32 = 0.0;
        let mut amp : f32 = VN_HALF;
        let mut norm : f32 = 0.0;
        let mut fx : f32 = x;
        let mut fz : f32 = z;
        for (o of 0..octaves) {
            sum = sum + amp * VoxNoise::value2(fx, fz, seed + o * VN_OCTAVE_SALT);
            norm = norm + amp;
            amp = amp * VN_HALF;
            fx = fx * VN_LACUNARITY;
            fz = fz * VN_LACUNARITY;
        }
        return sum / norm;
    }

    /** 0 below `lo`, 1 above `hi`, a smooth ramp between (`hi` must exceed `lo`). */
    pub static fn ramp(lo : f32, hi : f32, v : f32) : f32 {
        if (v <= lo) {
            return VN_ZERO;
        }
        if (v >= hi) {
            return VN_ONE;
        }
        return VoxNoise::fade((v - lo) / (hi - lo));
    }

    /** Smooth value noise in space. */
    pub static fn value3(x : f32, y : f32, z : f32, seed : i32) : f32 {
        let ix : i32 = VoxNoise::floor(x);
        let iy : i32 = VoxNoise::floor(y);
        let iz : i32 = VoxNoise::floor(z);
        let fx : f32 = VoxNoise::fade(x - ix as f32);
        let fy : f32 = VoxNoise::fade(y - iy as f32);
        let fz : f32 = VoxNoise::fade(z - iz as f32);
        let a : f32 = VoxNoise::unit(ix, iy, iz, seed);
        let b : f32 = VoxNoise::unit(ix + 1, iy, iz, seed);
        let c : f32 = VoxNoise::unit(ix, iy + 1, iz, seed);
        let d : f32 = VoxNoise::unit(ix + 1, iy + 1, iz, seed);
        let e : f32 = VoxNoise::unit(ix, iy, iz + 1, seed);
        let f : f32 = VoxNoise::unit(ix + 1, iy, iz + 1, seed);
        let g : f32 = VoxNoise::unit(ix, iy + 1, iz + 1, seed);
        let h : f32 = VoxNoise::unit(ix + 1, iy + 1, iz + 1, seed);
        let ab : f32 = a + (b - a) * fx;
        let cd : f32 = c + (d - c) * fx;
        let ef : f32 = e + (f - e) * fx;
        let gh : f32 = g + (h - g) * fx;
        let low : f32 = ab + (cd - ab) * fy;
        let high : f32 = ef + (gh - ef) * fy;
        return low + (high - low) * fz;
    }
}

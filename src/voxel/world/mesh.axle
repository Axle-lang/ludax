// mesh — the triangles of one chunk as plain arrays.
//
// Four vertices and six indices per quad. Per vertex: a position in the chunk's own coordinates (0..16 on each
// axis, so a renderer adds the chunk origin, or does that on the GPU and keeps f32 precision in a huge world), a
// normal, a texture coordinate that counts blocks (a quad of 3 x 2 merged blocks runs 0..3 by 0..2, so a tiling
// texture repeats once per block), the block id (to pick a texture or material), and an ambient-occlusion count.
// The count is the light module's: 0 open, up to 3 the deepest crease; shading it is the renderer's call.
// Triangles wind counter-clockwise seen from the side the normal points to.

use crate::core::collections::vec::Vec;

// Position and normal are three floats each, a texture coordinate two.
const MESH_TRIPLE : i32 = 3;
const MESH_PAIR : i32 = 2;

// Every array holds 4-byte elements (`f32` or `i32`), which is what `bytesUsed` counts.
const MESH_ELEMENT_BYTES : i64 = 4;

// A quad is four vertices.
const MESH_QUAD_VERTICES : i32 = 4;

// One vertex as the mesher builds it: position, normal, texture coordinate, block and occlusion count.
pub(crate) struct VoxVertex {
    px : f32 = 0.0;
    py : f32 = 0.0;
    pz : f32 = 0.0;
    nx : f32 = 0.0;
    ny : f32 = 0.0;
    nz : f32 = 0.0;
    u  : f32 = 0.0;
    v  : f32 = 0.0;
    id : i32 = 0;
    ao : i32 = 0;
}

/** The mesh of one chunk. */
pub class VoxMesh {
    pos   : Vec<f32>;
    nrm   : Vec<f32>;
    tex   : Vec<f32>;
    ids   : Vec<i32>;
    shade : Vec<i32>;
    tris  : Vec<i32>;
    quads : i32 = 0;
    seen  : i32 = 0;
    area  : i64 = 0;

    /** An empty mesh. */
    constructor() {
        self.pos = new Vec<f32>();
        self.nrm = new Vec<f32>();
        self.tex = new Vec<f32>();
        self.ids = new Vec<i32>();
        self.shade = new Vec<i32>();
        self.tris = new Vec<i32>();
    }

    /** Forgets everything, keeping the storage. */
    pub fn clear(mut self) : void {
        self.pos.clear();
        self.nrm.clear();
        self.tex.clear();
        self.ids.clear();
        self.shade.clear();
        self.tris.clear();
        self.quads = 0;
        self.seen = 0;
        self.area = 0;
    }

    /** How many vertices. */
    pub fn vertexCount(self) : i32 {
        return self.ids.len();
    }

    /** How many quads (two triangles each). */
    pub fn quadCount(self) : i32 {
        return self.quads;
    }

    /** How many indices (six per quad). */
    pub fn indexCount(self) : i32 {
        return self.tris.len();
    }

    /** How many block faces were exposed before merging (the quads cover exactly this many block faces). */
    pub fn exposedFaces(self) : i32 {
        return self.seen;
    }

    /** The total number of block faces the quads cover; equals `exposedFaces` when merging lost nothing. */
    pub fn coveredFaces(self) : i64 {
        return self.area;
    }

    /** The x of vertex `i` (chunk coordinates). */
    pub fn x(self, i : i32) : f32 {
        return self.pos.get(i * MESH_TRIPLE);
    }

    /** The y of vertex `i`. */
    pub fn y(self, i : i32) : f32 {
        return self.pos.get(i * MESH_TRIPLE + 1);
    }

    /** The z of vertex `i`. */
    pub fn z(self, i : i32) : f32 {
        return self.pos.get(i * MESH_TRIPLE + 2);
    }

    /** The x of the normal of vertex `i`. */
    pub fn nx(self, i : i32) : f32 {
        return self.nrm.get(i * MESH_TRIPLE);
    }

    /** The y of the normal of vertex `i`. */
    pub fn ny(self, i : i32) : f32 {
        return self.nrm.get(i * MESH_TRIPLE + 1);
    }

    /** The z of the normal of vertex `i`. */
    pub fn nz(self, i : i32) : f32 {
        return self.nrm.get(i * MESH_TRIPLE + 2);
    }

    /** The texture u of vertex `i`, in blocks. */
    pub fn u(self, i : i32) : f32 {
        return self.tex.get(i * MESH_PAIR);
    }

    /** The texture v of vertex `i`, in blocks. */
    pub fn v(self, i : i32) : f32 {
        return self.tex.get(i * MESH_PAIR + 1);
    }

    /** The block id of vertex `i`. */
    pub fn block(self, i : i32) : i32 {
        return self.ids.get(i);
    }

    /** The ambient-occlusion count (0..3) of vertex `i`. */
    pub fn occlusion(self, i : i32) : i32 {
        return self.shade.get(i);
    }

    /** Index `k` (into the vertices). */
    pub fn index(self, k : i32) : i32 {
        return self.tris.get(k);
    }

    /** Bytes of memory the arrays hold (capacity). */
    pub fn bytesUsed(self) : i64 {
        return (self.pos.capacity() + self.nrm.capacity() + self.tex.capacity() + self.ids.capacity()
            + self.shade.capacity()
            + self.tris.capacity()) as i64
            * MESH_ELEMENT_BYTES;
    }

    /** Appends one vertex. */
    pub(crate) fn vertex(mut self, v : VoxVertex) : void {
        self.pos.push(v.px);
        self.pos.push(v.py);
        self.pos.push(v.pz);
        self.nrm.push(v.nx);
        self.nrm.push(v.ny);
        self.nrm.push(v.nz);
        self.tex.push(v.u);
        self.tex.push(v.v);
        self.ids.push(v.id);
        self.shade.push(v.ao);
    }

    /** Appends the two triangles of the quad whose four vertices were just added; `flip` picks the other diagonal. */
    pub(crate) fn quad(mut self, covers : i32, flip : bool) : void {
        let b : i32 = self.ids.len() - MESH_QUAD_VERTICES;
        if (flip) {
            self.tris.push(b + 1);
            self.tris.push(b + 2);
            self.tris.push(b + 3);
            self.tris.push(b + 1);
            self.tris.push(b + 3);
            self.tris.push(b);
        } else {
            self.tris.push(b);
            self.tris.push(b + 1);
            self.tris.push(b + 2);
            self.tris.push(b);
            self.tris.push(b + 2);
            self.tris.push(b + 3);
        }
        self.quads = self.quads + 1;
        self.area = self.area + covers as i64;
    }

    /** Counts a block face as exposed. */
    pub(crate) fn expose(mut self) : void {
        self.seen = self.seen + 1;
    }
}

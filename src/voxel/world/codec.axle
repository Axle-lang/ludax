// codec — one chunk as bytes, and back.
//
// The stored form is the chunk's own palette form, so a uniform chunk is five bytes and a typical terrain chunk a
// few hundred before it is deflated: [bits per cell: 1 byte][palette entries: 4 bytes][entries: 4 bytes each]
// [packed cells: 2048, 4096 or 8192 bytes, none for a uniform chunk]. Decoding checks every length and every
// index against the palette and refuses a chunk that does not fit; nothing read from a file is trusted.

use crate::data::bytes::ByteBuf;
use crate::voxel::world::chunk::VoxChunk;

// The header is the width byte and the palette count; a palette entry is a 32-bit block id.
const VW_CODEC_HEAD : i32 = 5;
const VW_CODEC_ENTRY : i32 = 4;
const VW_CODEC_MAX_ENTRIES : i32 = 65536;
const VW_CODEC_MAX_BITS : i32 = 16;

/** Chunk <-> bytes. */
pub class VoxChunkCodec {
    /** Appends the stored form of `chunk` to `out` (the chunk's palette is compacted first). */
    pub static fn encode(chunk : VoxChunk, out : ByteBuf) : void {
        chunk.compact();
        out.push(chunk.bitsPerCell());
        out.pushLe32(chunk.paletteSize());
        for (i of 0..chunk.paletteSize()) {
            out.pushLe32(chunk.paletteAt(i));
        }
        for (i of 0..chunk.packedLen()) {
            out.push(chunk.packedByte(i));
        }
    }

    /**
     * Reads the stored form in bytes `from..to` of `buf` into `chunk`. Returns false, leaving `chunk` as it
     * was, for anything that is not exactly one well-formed chunk.
     */
    pub static fn decode(buf : ByteBuf, from : i32, to : i32, chunk : VoxChunk) : bool {
        if (from < 0 || to > buf.len() || to - from < VW_CODEC_HEAD) {
            return false;
        }
        let bits : i32 = buf.get(from);
        let count : i32 = buf.le32(from + 1);
        if (count < 1 || count > VW_CODEC_MAX_ENTRIES || bits < 0 || bits > VW_CODEC_MAX_BITS) {
            return false;
        }
        let packedLen : i32 = VoxChunk::bytesFor(bits);
        if (to - from != VW_CODEC_HEAD + count * VW_CODEC_ENTRY + packedLen) {
            return false;
        }
        let mut entries : i32[] = malloc<i32>(count as i64);
        for (i of 0..count) {
            entries[i as i64] = buf.le32(from + VW_CODEC_HEAD + i * VW_CODEC_ENTRY);
        }
        let mut packed : i8[] = malloc<i8>(packedLen as i64 + 1);
        let base : i32 = from + VW_CODEC_HEAD + count * VW_CODEC_ENTRY;
        for (i of 0..packedLen) {
            packed[i as i64] = buf.get(base + i) as i8;
        }
        return chunk.restore(bits, entries, count, packed, packedLen);
    }
}

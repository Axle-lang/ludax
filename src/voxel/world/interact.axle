// interact — pointing at a block, breaking it, placing one against it.
//
// The ray walks the cells it crosses with the light module's `VoxelDda` (Amanatides & Woo, in f64) and stops at
// the first block that is not air or water. The hit names that cell, the face the ray came in through, and the
// cell in front of that face (where a placed block goes). Breaking and placing are plain `VoxWorld::setBlock`
// calls, so they land in the journal that the mesher and the light bridge read; nothing here touches meshes or
// light.

use crate::core::math::dgeom::DRay;
use crate::core::math::dvec3::DVec3;
use crate::core::math::trig::sqrtD;
use crate::voxel::light::dda::VoxelDda;
use crate::voxel::world::blocks::{VW_AIR, VW_WATER};
use crate::voxel::world::world::VoxWorld;

/** What a ray found. */
pub struct VoxHit {
    /** True when the ray hit a block within range. */
    pub hit : bool = false;

    /** World x of the cell that was hit. */
    pub x : i32 = 0;

    /** World y of the cell that was hit. */
    pub y : i32 = 0;

    /** World z of the cell that was hit. */
    pub z : i32 = 0;

    /** The block that was hit. */
    pub block : i32 = 0;

    /**
     * The face of the hit block the ray entered through (0 +x, 1 -x, 2 +y, 3 -y, 4 +z, 5 -z); -1 when the ray
     * started inside it.
     */
    pub face : i32 = -1;

    /** The x of the cell in front of that face: where `place` puts a block (the hit cell when the ray started inside). */
    pub frontX : i32 = 0;

    /** The y of the cell in front of the face. */
    pub frontY : i32 = 0;

    /** The z of the cell in front of the face. */
    pub frontZ : i32 = 0;

    /** How far along the ray the block was entered. */
    pub distance : f64 = 0.0;
}

/** Ray casts and block edits through the world. */
pub class VoxInteract {
    dda : VoxelDda;

    /** An interaction helper. */
    constructor() {
        self.dda = new VoxelDda();
    }

    /**
     * Casts `ray` (its direction of any length, not zero) up to `reach` blocks through the loaded chunks of
     * `world`. Air and water are looked through. A ray that starts inside a block hits it at distance 0.
     */
    pub fn cast(mut self, world : VoxWorld, ray : DRay, reach : f64) : VoxHit {
        let dir : DVec3 = ray.direction;
        let len : f64 = sqrtD(dir.x * dir.x + dir.y * dir.y + dir.z * dir.z);
        if (len <= 0.0) {
            return VoxHit {};
        }

        // The walker wants a unit direction so that its t is a distance.
        let unit : DVec3 = DVec3 { x: dir.x / len, y: dir.y / len, z: dir.z / len };
        self.dda.start(DRay::make(ray.origin, unit));

        let mut px : i32 = self.dda.x();
        let mut py : i32 = self.dda.y();
        let mut pz : i32 = self.dda.z();
        while (self.dda.entryT() <= reach) {
            let x : i32 = self.dda.x();
            let y : i32 = self.dda.y();
            let z : i32 = self.dda.z();
            let id : i32 = world.blockAt(x, y, z);
            if (id != VW_AIR && id != VW_WATER) {
                return VoxHit {
                    hit: true,
                    x: x,
                    y: y,
                    z: z,
                    block: id,
                    face: self.dda.entryFace(),
                    frontX: px,
                    frontY: py,
                    frontZ: pz,
                    distance: self.dda.entryT(),
                };
            }

            px = x;
            py = y;
            pz = z;
            self.dda.advance();
        }
        return VoxHit {};
    }

    /** Breaks the block `hit` names (it becomes air). True when the world changed. */
    pub fn breakBlock(self, world : VoxWorld, hit : VoxHit) : bool {
        if (!hit.hit) {
            return false;
        }
        return world.setBlock(hit.x, hit.y, hit.z, VW_AIR);
    }

    /** Places `id` in front of the face `hit` names, if that cell is air or water. True when the world changed. */
    pub fn placeBlock(self, world : VoxWorld, hit : VoxHit, id : i32) : bool {
        if (!hit.hit || hit.face < 0) {
            return false;
        }
        let here : i32 = world.blockAt(hit.frontX, hit.frontY, hit.frontZ);
        if (here != VW_AIR && here != VW_WATER) {
            return false;
        }
        return world.setBlock(hit.frontX, hit.frontY, hit.frontZ, id);
    }
}

// physics_settings — the tunable numbers of a physics world, gathered in one value.
//
// Defaults suit metre-sized objects under Earth gravity stepped at 120 Hz. They are a starting point, not a
// law: a stiffer stack wants more `velocityIterations`, a game with fast small objects wants a shorter
// `substep`.

use crate::core::math::dvec3::DVec3;

/** Configuration of a `PhysicsWorld`. Copy the defaults and change what you need. */
pub struct PhysicsSettings {
    /** Gravitational acceleration in metres per second squared. */
    pub gravity : DVec3 = DVec3 { x: 0.0, y: -9.81, z: 0.0 };

    /** The fixed length of one internal step in seconds. */
    pub substep : f64 = 0.008333333333333333;

    /** Sequential-impulse iterations per step for contacts and joints. */
    pub velocityIterations : i32 = 10;

    /** Iterations of the position (split impulse) pass that pushes overlapping bodies apart and closes joints. */
    pub positionIterations : i32 = 6;

    /** Impacts slower than this (m/s) do not bounce, which keeps resting contacts from jittering. */
    pub restitutionThreshold : f64 = 1.0;

    /** Overlap (metres) that is left uncorrected, so resting contacts stay in contact. */
    pub penetrationSlop : f64 = 0.005;

    /** The fraction of the remaining overlap the position pass removes in one step. */
    pub pushFactor : f64 = 0.4;

    /** The fastest the position pass may push bodies apart (m/s). */
    pub maxPushSpeed : f64 = 4.0;

    /** The fraction of a joint's position error removed per step by the position pass. */
    pub jointBeta : f64 = 0.3;

    /** Whether contacts start from the previous step's impulses. */
    pub warmStarting : bool = true;

    /** Bodies slower than this linear speed (m/s) count as resting. */
    pub sleepLinearSpeed : f64 = 0.05;

    /** Bodies slower than this angular speed (rad/s) count as resting. */
    pub sleepAngularSpeed : f64 = 0.08;

    /** How long (seconds) a body must rest before it, with its whole island, falls asleep. */
    pub sleepTime : f64 = 0.5;

    /** Whether sleeping is enabled at all. */
    pub sleeping : bool = true;
}

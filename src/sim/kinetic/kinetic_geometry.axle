// kinetic_geometry — closest-point queries on segments and boxes that the narrow phase and the ray casts share.
//
// Small, stateless and exact enough for contacts: every division is guarded, because a float division by zero
// traps in Axle.

use crate::core::math::dmat3::DMat3;
use crate::core::math::dvec3::DVec3;
use crate::core::math::scalar::{clampD, absD};

// Squared lengths and denominators below this are treated as zero before dividing.
pub(crate) const KINETIC_GEOMETRY_TINY : f64 = 0.000000000001;

// Distances and denominators below this are too small to give a stable direction or ratio.
pub(crate) const KINETIC_GEOMETRY_SMALL : f64 = 0.000000001;

// Stands in for "no limit": larger than any distance in a scene, small enough to survive arithmetic.
pub(crate) const KINETIC_GEOMETRY_FAR : f64 = 1.0e300;

/** Geometric helpers for kinetic. */
pub(crate) class KineticGeometry {
    /** The parameter `t` in 0..1 of the point of segment `a`..`b` nearest to `p`. */
    pub(crate) static fn closestOnSegment(a : DVec3, b : DVec3, p : DVec3) : f64 {
        let ab : DVec3 = b.minus(a);
        let len2 : f64 = ab.lengthSquared();
        if (len2 < KINETIC_GEOMETRY_TINY) {
            return 0.0;
        }
        return clampD(p.minus(a).dot(ab) / len2, 0.0, 1.0);
    }

    /**
     * The nearest points of segments `p1`..`q1` and `p2`..`q2`: `x` is the parameter on the first, `y` on the
     * second (both 0..1), `z` the squared distance between the points.
     */
    pub(crate) static fn segmentSegment(p1 : DVec3, q1 : DVec3, p2 : DVec3, q2 : DVec3) : DVec3 {
        let d1 : DVec3 = q1.minus(p1);
        let d2 : DVec3 = q2.minus(p2);
        let r : DVec3 = p1.minus(p2);
        let a : f64 = d1.dot(d1);
        let e : f64 = d2.dot(d2);
        let f : f64 = d2.dot(r);
        let tiny : f64 = KINETIC_GEOMETRY_TINY;
        let mut s : f64 = 0.0;
        let mut t : f64 = 0.0;
        if (a <= tiny && e <= tiny) {
            s = 0.0;
            t = 0.0;
        } else if (a <= tiny) {
            s = 0.0;
            t = clampD(f / e, 0.0, 1.0);
        } else {
            let c : f64 = d1.dot(r);
            if (e <= tiny) {
                t = 0.0;
                s = clampD(-c / a, 0.0, 1.0);
            } else {
                let b : f64 = d1.dot(d2);
                let denom : f64 = a * e - b * b;
                if (denom > tiny * a * e) {
                    s = clampD((b * f - c * e) / denom, 0.0, 1.0);
                }
                t = (b * s + f) / e;
                if (t < 0.0) {
                    t = 0.0;
                    s = clampD(-c / a, 0.0, 1.0);
                } else if (t > 1.0) {
                    t = 1.0;
                    s = clampD((b - c) / a, 0.0, 1.0);
                }
            }
        }
        let c1 : DVec3 = p1.plus(d1.scale(s));
        let c2 : DVec3 = p2.plus(d2.scale(t));
        return DVec3 { x: s, y: t, z: c1.distanceSquared(c2) };
    }

    /** The squared distance from point `c` to the box centred on the origin with half extents `h`, axis-aligned. */
    pub(crate) static fn distSqToBox(c : DVec3, h : DVec3) : f64 {
        let dx : f64 = KineticGeometry::excess(c.x, h.x);
        let dy : f64 = KineticGeometry::excess(c.y, h.y);
        let dz : f64 = KineticGeometry::excess(c.z, h.z);
        return dx * dx + dy * dy + dz * dz;
    }

    // How far `v` lies outside the interval -h..h; zero inside.
    static fn excess(v : f64, h : f64) : f64 {
        let a : f64 = absD(v);
        if (a > h) {
            return a - h;
        }
        return 0.0;
    }

    /** Component `i` (0 x, 1 y, otherwise z) of `v`, for loops over the three axes. */
    pub(crate) static fn component(v : DVec3, i : i32) : f64 {
        if (i == 0) {
            return v.x;
        }
        if (i == 1) {
            return v.y;
        }
        return v.z;
    }

    /** Column `i` of a rotation matrix: the i-th local axis of the body in the world. */
    pub(crate) static fn column(m : DMat3, i : i32) : DVec3 {
        if (i == 0) {
            return DVec3 { x: m.m00, y: m.m10, z: m.m20 };
        }
        if (i == 1) {
            return DVec3 { x: m.m01, y: m.m11, z: m.m21 };
        }
        return DVec3 { x: m.m02, y: m.m12, z: m.m22 };
    }

    /** The sign of `v` as 1 or -1 (zero counts as positive). */
    pub(crate) static fn sgn(v : f64) : f64 {
        if (v < 0.0) {
            return -1.0;
        }
        return 1.0;
    }
}

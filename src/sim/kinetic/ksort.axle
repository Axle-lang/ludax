// ksort — the stable sorts kinetic uses to keep every iteration order deterministic.
//
// Two bottom-up merge sorts on plain arrays: indices ordered by a float key, and whole numbers. Both are stable
// and independent of the platform, which is the point: a pair list or a sweep order that came out of a hash or
// an unstable sort would make two runs of the same scene diverge. The working buffers are never swapped by
// assignment (arrays are owned values in Axle); each pass names its source and target instead.

/** Sorting helpers for kinetic's broad phase and contact lists. */
pub class KSort {
    /** Orders `idx[0..n]` so that `keys[idx[k]]` ascends; equal keys keep their relative order. */
    pub static fn indicesByKey(keys : f64[], idx : i32[], n : i32) : void {
        if (n < 2) {
            return;
        }
        let mut other : i32[] = malloc<i32>(n as i64);
        let mut width : i32 = 1;
        let mut forward : bool = true;
        while (width < n) {
            if (forward) {
                KSort::mergeIndices(keys, idx, other, n, width);
            } else {
                KSort::mergeIndices(keys, other, idx, n, width);
            }
            forward = !forward;
            width = width * 2;
        }
        if (!forward) {
            for (i of 0..n) {
                idx[i as i64] = other[i as i64];
            }
        }
    }

    static fn mergeIndices(keys : f64[], src : i32[], dst : i32[], n : i32, width : i32) : void {
        let mut start : i32 = 0;
        while (start < n) {
            let mid : i32 = KSort::lesser(start + width, n);
            let end : i32 = KSort::lesser(start + width * 2, n);
            let mut i : i32 = start;
            let mut j : i32 = mid;
            let mut k : i32 = start;
            while (i < mid && j < end) {
                if (keys[src[j as i64] as i64] < keys[src[i as i64] as i64]) {
                    dst[k as i64] = src[j as i64];
                    j = j + 1;
                } else {
                    dst[k as i64] = src[i as i64];
                    i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) {
                dst[k as i64] = src[i as i64];
                i = i + 1;
                k = k + 1;
            }
            while (j < end) {
                dst[k as i64] = src[j as i64];
                j = j + 1;
                k = k + 1;
            }
            start = start + width * 2;
        }
    }

    /** Sorts `a[0..n]` ascending. */
    pub static fn whole(a : i64[], n : i32) : void {
        if (n < 2) {
            return;
        }
        let mut other : i64[] = malloc<i64>(n as i64);
        let mut width : i32 = 1;
        let mut forward : bool = true;
        while (width < n) {
            if (forward) {
                KSort::mergeWhole(a, other, n, width);
            } else {
                KSort::mergeWhole(other, a, n, width);
            }
            forward = !forward;
            width = width * 2;
        }
        if (!forward) {
            for (i of 0..n) {
                a[i as i64] = other[i as i64];
            }
        }
    }

    static fn mergeWhole(src : i64[], dst : i64[], n : i32, width : i32) : void {
        let mut start : i32 = 0;
        while (start < n) {
            let mid : i32 = KSort::lesser(start + width, n);
            let end : i32 = KSort::lesser(start + width * 2, n);
            let mut i : i32 = start;
            let mut j : i32 = mid;
            let mut k : i32 = start;
            while (i < mid && j < end) {
                if (src[j as i64] < src[i as i64]) {
                    dst[k as i64] = src[j as i64];
                    j = j + 1;
                } else {
                    dst[k as i64] = src[i as i64];
                    i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) {
                dst[k as i64] = src[i as i64];
                i = i + 1;
                k = k + 1;
            }
            while (j < end) {
                dst[k as i64] = src[j as i64];
                j = j + 1;
                k = k + 1;
            }
            start = start + width * 2;
        }
    }

    /** Index of the first element of `a[0..n]` that is not below `key` (n when all are); `a` must be sorted. */
    pub static fn lowerBound(a : i64[], n : i32, key : i64) : i32 {
        let mut lo : i32 = 0;
        let mut hi : i32 = n;
        while (lo < hi) {
            let mid : i32 = lo + (hi - lo) / 2;
            if (a[mid as i64] < key) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }

    static fn lesser(a : i32, b : i32) : i32 {
        if (a < b) {
            return a;
        }
        return b;
    }
}

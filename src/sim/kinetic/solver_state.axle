// solver_state — the flat working copy of body motion that the constraint solvers iterate on.
//
// Before solving, the velocities, inverse masses and world inverse inertias of every body are copied into plain
// arrays; after solving, the velocities go back. Bodies that must not move under impulses (static, kinematic,
// asleep) get zero inverse mass and inertia, so the same formulas serve every pair without branches. One extra
// slot past the last body stands for "the world": a joint anchored to the world points at it, and since its
// inverse mass is zero nothing ever moves it.

use crate::core::math::dmat3::DMat3;
use crate::core::math::dvec3::DVec3;
use crate::sim::kinetic::body_store::BodyStore;

/** Working velocities and inverse masses for one solve. */
pub class SolverState {
    vel    : f64[];
    pseudo : f64[];
    invM   : f64[];
    invI   : f64[];
    room   : i32 = 0;
    bodies : i32 = 0;

    /** An empty state. */
    constructor() {
        self.vel = malloc<f64>(1);
        self.pseudo = malloc<f64>(1);
        self.invM = malloc<f64>(1);
        self.invI = malloc<f64>(1);
    }

    /** The pseudo slot that stands for the world. */
    pub fn worldSlot(self) : i32 {
        return self.bodies;
    }

    /** Copies motion and mass data from the store; sleeping, static and kinematic bodies become immovable. */
    pub fn load(mut self, s : BodyStore) : void {
        let n : i32 = s.slotCount();
        self.bodies = n;
        if (n + 1 > self.room) {
            let cap : i32 = n + 1 + n / 2;
            self.vel = malloc<f64>((cap * 6) as i64);
            self.pseudo = malloc<f64>((cap * 6) as i64);
            self.invM = malloc<f64>(cap as i64);
            self.invI = malloc<f64>((cap * 9) as i64);
            self.room = cap;
        }
        for (i of 0..n + 1) {
            let mut movable : bool = false;
            if (i < n) {
                movable = s.isLive(i) && s.isDynamic(i) && !s.asleep.get(i);
            }
            let mut lin : DVec3 = DVec3::zero();
            let mut ang : DVec3 = DVec3::zero();
            if (i < n && s.isLive(i) && !s.asleep.get(i)) {
                lin = s.lin.get(i);
                ang = s.ang.get(i);
            }
            self.setLin(i, lin);
            self.setAng(i, ang);
            self.setPseudo(i, DVec3::zero(), DVec3::zero());
            if (movable) {
                self.invM[i as i64] = s.invMass.get(i);
                let w : DMat3 = s.invInertiaW.get(i);
                let b : i64 = (i * 9) as i64;
                self.invI[b] = w.m00;
                self.invI[b + 1] = w.m01;
                self.invI[b + 2] = w.m02;
                self.invI[b + 3] = w.m10;
                self.invI[b + 4] = w.m11;
                self.invI[b + 5] = w.m12;
                self.invI[b + 6] = w.m20;
                self.invI[b + 7] = w.m21;
                self.invI[b + 8] = w.m22;
            } else {
                self.invM[i as i64] = 0.0;
                for (k of 0..9) {
                    self.invI[(i * 9 + k) as i64] = 0.0;
                }
            }
        }
    }

    /** Writes the solved velocities of movable bodies back into the store. */
    pub fn store(self, s : BodyStore) : void {
        for (i of 0..self.bodies) {
            if (self.invM[i as i64] > 0.0) {
                s.lin.set(i, self.lin(i));
                s.ang.set(i, self.ang(i));
            }
        }
    }

    /** Linear velocity of slot `i`. */
    pub fn lin(self, i : i32) : DVec3 {
        let b : i64 = (i * 6) as i64;
        return DVec3 { x: self.vel[b], y: self.vel[b + 1], z: self.vel[b + 2] };
    }

    /** Angular velocity of slot `i`. */
    pub fn ang(self, i : i32) : DVec3 {
        let b : i64 = (i * 6) as i64;
        return DVec3 { x: self.vel[b + 3], y: self.vel[b + 4], z: self.vel[b + 5] };
    }

    /** Sets the linear velocity of slot `i`. */
    pub fn setLin(mut self, i : i32, v : DVec3) : void {
        let b : i64 = (i * 6) as i64;
        self.vel[b] = v.x;
        self.vel[b + 1] = v.y;
        self.vel[b + 2] = v.z;
    }

    /** Sets the angular velocity of slot `i`. */
    pub fn setAng(mut self, i : i32, v : DVec3) : void {
        let b : i64 = (i * 6) as i64;
        self.vel[b + 3] = v.x;
        self.vel[b + 4] = v.y;
        self.vel[b + 5] = v.z;
    }

    /** The position pass's linear pseudo velocity of slot `i`. */
    pub fn pseudoLin(self, i : i32) : DVec3 {
        let b : i64 = (i * 6) as i64;
        return DVec3 { x: self.pseudo[b], y: self.pseudo[b + 1], z: self.pseudo[b + 2] };
    }

    /** The position pass's angular pseudo velocity of slot `i`. */
    pub fn pseudoAng(self, i : i32) : DVec3 {
        let b : i64 = (i * 6) as i64;
        return DVec3 { x: self.pseudo[b + 3], y: self.pseudo[b + 4], z: self.pseudo[b + 5] };
    }

    /** Sets both pseudo velocities of slot `i`. */
    pub fn setPseudo(mut self, i : i32, l : DVec3, a : DVec3) : void {
        let b : i64 = (i * 6) as i64;
        self.pseudo[b] = l.x;
        self.pseudo[b + 1] = l.y;
        self.pseudo[b + 2] = l.z;
        self.pseudo[b + 3] = a.x;
        self.pseudo[b + 4] = a.y;
        self.pseudo[b + 5] = a.z;
    }

    /** Inverse mass of slot `i` (zero when immovable). */
    pub fn invMass(self, i : i32) : f64 {
        return self.invM[i as i64];
    }

    /** The world inverse inertia tensor of slot `i` applied to `v`. */
    pub fn invInertia(self, i : i32, v : DVec3) : DVec3 {
        let b : i64 = (i * 9) as i64;
        return DVec3 {
            x: self.invI[b] * v.x + self.invI[b + 1] * v.y + self.invI[b + 2] * v.z,
            y: self.invI[b + 3] * v.x + self.invI[b + 4] * v.y + self.invI[b + 5] * v.z,
            z: self.invI[b + 6] * v.x + self.invI[b + 7] * v.y + self.invI[b + 8] * v.z,
        };
    }

    /** The world inverse inertia tensor of slot `i` as a matrix. */
    pub fn invInertiaMat(self, i : i32) : DMat3 {
        let b : i64 = (i * 9) as i64;
        return DMat3 {
            m00: self.invI[b],
            m01: self.invI[b + 1],
            m02: self.invI[b + 2],
            m10: self.invI[b + 3],
            m11: self.invI[b + 4],
            m12: self.invI[b + 5],
            m20: self.invI[b + 6],
            m21: self.invI[b + 7],
            m22: self.invI[b + 8],
        };
    }

    /** The pseudo velocity of the point at offset `r` from the centre of slot `i`. */
    pub fn pseudoPointVelocity(self, i : i32, r : DVec3) : DVec3 {
        return self.pseudoLin(i).plus(self.pseudoAng(i).cross(r));
    }

    /** Applies an angular impulse `l` to body `b` and its opposite to body `a` on the pseudo velocities. */
    pub fn applyPseudoAngular(mut self, a : i32, b : i32, l : DVec3) : void {
        if (self.invM[a as i64] > 0.0) {
            self.setPseudo(a, self.pseudoLin(a), self.pseudoAng(a).minus(self.invInertia(a, l)));
        }
        if (self.invM[b as i64] > 0.0) {
            self.setPseudo(b, self.pseudoLin(b), self.pseudoAng(b).plus(self.invInertia(b, l)));
        }
    }

    /** The velocity of the point at offset `r` from the centre of slot `i`. */
    pub fn pointVelocity(self, i : i32, r : DVec3) : DVec3 {
        return self.lin(i).plus(self.ang(i).cross(r));
    }

    /** Applies the impulse `p` at offset `ra` from body `a` (negated) and at `rb` from body `b`. */
    pub fn applyImpulse(mut self, a : i32, b : i32, p : DVec3, ra : DVec3, rb : DVec3) : void {
        let ma : f64 = self.invM[a as i64];
        let mb : f64 = self.invM[b as i64];
        if (ma > 0.0) {
            self.setLin(a, self.lin(a).minus(p.scale(ma)));
            self.setAng(a, self.ang(a).minus(self.invInertia(a, ra.cross(p))));
        }
        if (mb > 0.0) {
            self.setLin(b, self.lin(b).plus(p.scale(mb)));
            self.setAng(b, self.ang(b).plus(self.invInertia(b, rb.cross(p))));
        }
    }

    /** As `applyImpulse`, on the pseudo velocities of the position pass. */
    pub fn applyPseudoImpulse(mut self, a : i32, b : i32, p : DVec3, ra : DVec3, rb : DVec3) : void {
        let ma : f64 = self.invM[a as i64];
        let mb : f64 = self.invM[b as i64];
        if (ma > 0.0) {
            self.setPseudo(
                a,
                self.pseudoLin(a).minus(p.scale(ma)),
                self.pseudoAng(a).minus(self.invInertia(a, ra.cross(p)))
            );
        }
        if (mb > 0.0) {
            self.setPseudo(
                b,
                self.pseudoLin(b).plus(p.scale(mb)),
                self.pseudoAng(b).plus(self.invInertia(b, rb.cross(p)))
            );
        }
    }

    /** Applies an angular impulse `l` to body `b` and its opposite to body `a`. */
    pub fn applyAngular(mut self, a : i32, b : i32, l : DVec3) : void {
        if (self.invM[a as i64] > 0.0) {
            self.setAng(a, self.ang(a).minus(self.invInertia(a, l)));
        }
        if (self.invM[b as i64] > 0.0) {
            self.setAng(b, self.ang(b).plus(self.invInertia(b, l)));
        }
    }
}

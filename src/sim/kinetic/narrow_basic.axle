// narrow_basic — contact generation for spheres, capsules and planes.
//
// Every test here writes into a `ContactBuffer` with the normal pointing from the first argument to the second
// and returns whether the shapes overlap. Spheres and capsules reduce to closest-point problems: a capsule is
// a segment with a radius, so a capsule pair is the nearest points of two segments, and a capsule against a
// sphere or a plane is a sphere (or two) at the nearest points.

use crate::core::math::dquat::DQuat;
use crate::core::math::dvec3::DVec3;
use crate::sim::kinetic::contact_buffer::ContactBuffer;
use crate::sim::kinetic::kgeom::KGeom;
use crate::sim::kinetic::shape::Shape;

/** Narrow-phase tests among spheres, capsules and planes, and box against plane. */
pub class NarrowBasic {
    /** Sphere against sphere. */
    pub static fn sphereSphere(pa : DVec3, ra : f64, pb : DVec3, rb : f64, out : ContactBuffer) : bool {
        let d : DVec3 = pb.minus(pa);
        let dist2 : f64 = d.lengthSquared();
        let rs : f64 = ra + rb;
        if (dist2 >= rs * rs) {
            return false;
        }
        let dist : f64 = dist2.sqrt();
        let mut n : DVec3 = DVec3 { x: 0.0, y: 1.0, z: 0.0 };
        if (dist > 0.000000000001) {
            n = d.scale(1.0 / dist);
        }
        let depth : f64 = rs - dist;
        out.setNormal(n);
        out.add(pa.plus(n.scale(ra - depth * 0.5)), depth, 0);
        return true;
    }

    /** A sphere (first) against a plane (second): the normal points into the plane. */
    pub static fn spherePlane(p : DVec3, r : f64, plane : Shape, out : ContactBuffer) : bool {
        let sd : f64 = plane.normal.dot(p) - plane.offset;
        if (sd >= r) {
            return false;
        }
        out.setNormal(plane.normal.negated());
        out.add(p.minus(plane.normal.scale((r + sd) * 0.5)), r - sd, 0);
        return true;
    }

    /** A sphere (first) against a capsule (second). */
    pub static fn sphereCapsule(
        ps : DVec3,
        rs : f64,
        cap : Shape,
        pc : DVec3,
        qc : DQuat,
        out : ContactBuffer
    ) : bool {
        let c0 : DVec3 = cap.capsuleEnds(pc, qc, false);
        let c1 : DVec3 = cap.capsuleEnds(pc, qc, true);
        let t : f64 = KGeom::closestOnSegment(c0, c1, ps);
        return NarrowBasic::sphereSphere(ps, rs, c0.plus(c1.minus(c0).scale(t)), cap.radius, out);
    }

    /** A capsule (first) against a plane (second): one point per cap that dips below it. */
    pub static fn capsulePlane(
        cap : Shape,
        pc : DVec3,
        qc : DQuat,
        plane : Shape,
        out : ContactBuffer
    ) : bool {
        let mut hit : bool = false;
        for (k of 0..2) {
            let e : DVec3 = cap.capsuleEnds(pc, qc, k == 1);
            let sd : f64 = plane.normal.dot(e) - plane.offset;
            if (sd < cap.radius) {
                if (!hit) {
                    out.setNormal(plane.normal.negated());
                    hit = true;
                }
                out.add(e.minus(plane.normal.scale((cap.radius + sd) * 0.5)), cap.radius - sd, k);
            }
        }
        return hit;
    }

    /** A box (first) against a plane (second): each corner below the plane is a contact point. */
    pub static fn boxPlane(box : Shape, pb : DVec3, qb : DQuat, plane : Shape, out : ContactBuffer) : bool {
        let m = qb.toMat3();
        let ax : DVec3 = DVec3 { x: m.m00, y: m.m10, z: m.m20 }.scale(box.half.x);
        let ay : DVec3 = DVec3 { x: m.m01, y: m.m11, z: m.m21 }.scale(box.half.y);
        let az : DVec3 = DVec3 { x: m.m02, y: m.m12, z: m.m22 }.scale(box.half.z);
        let mut hit : bool = false;
        for (k of 0..8) {
            let mut c : DVec3 = pb;
            if ((k & 1) != 0) {
                c = c.plus(ax);
            } else {
                c = c.minus(ax);
            }
            if ((k & 2) != 0) {
                c = c.plus(ay);
            } else {
                c = c.minus(ay);
            }
            if ((k & 4) != 0) {
                c = c.plus(az);
            } else {
                c = c.minus(az);
            }
            let sd : f64 = plane.normal.dot(c) - plane.offset;
            if (sd < 0.0) {
                if (!hit) {
                    out.setNormal(plane.normal.negated());
                    hit = true;
                }
                out.add(c.minus(plane.normal.scale(sd * 0.5)), -sd, k);
            }
        }
        if (hit) {
            out.reduceToFour();
        }
        return hit;
    }

    /**
     * Capsule against capsule: the nearest points of the two axes make the main contact; when the axes are
     * nearly parallel and overlap along their length, a second point at the far end of the overlap keeps a
     * capsule lying on another from rocking.
     */
    pub static fn capsuleCapsule(
        sa : Shape,
        pa : DVec3,
        qa : DQuat,
        sb : Shape,
        pb : DVec3,
        qb : DQuat,
        out : ContactBuffer
    ) : bool {
        let a0 : DVec3 = sa.capsuleEnds(pa, qa, false);
        let a1 : DVec3 = sa.capsuleEnds(pa, qa, true);
        let b0 : DVec3 = sb.capsuleEnds(pb, qb, false);
        let b1 : DVec3 = sb.capsuleEnds(pb, qb, true);
        let r : f64 = sa.radius + sb.radius;
        let cl : DVec3 = KGeom::segmentSegment(a0, a1, b0, b1);
        if (cl.z >= r * r) {
            return false;
        }
        let ptA : DVec3 = a0.plus(a1.minus(a0).scale(cl.x));
        let ptB : DVec3 = b0.plus(b1.minus(b0).scale(cl.y));
        let dist : f64 = cl.z.sqrt();
        let mut n : DVec3 = DVec3 { x: 0.0, y: 1.0, z: 0.0 };
        if (dist > 0.000000001) {
            n = ptB.minus(ptA).scale(1.0 / dist);
        } else {
            let c : DVec3 = a1.minus(a0).cross(b1.minus(b0));
            if (c.lengthSquared() > 0.000000000001) {
                n = c.normalized();
            } else {
                n = a1.minus(a0).anyPerpendicular();
            }
        }
        let depth : f64 = r - dist;
        let main : DVec3 = ptA.plus(n.scale(sa.radius - depth * 0.5));
        out.setNormal(n);
        out.add(main, depth, 0);
        let mut extra : i32 = -1;
        let mut extraAt : DVec3 = main;
        let mut extraDepth : f64 = 0.0;
        let mut extraFar : f64 = 0.0;
        for (k of 0..4) {
            let mut pairA : DVec3 = a0;
            let mut pairB : DVec3 = b0;
            if (k < 2) {
                if (k == 1) {
                    pairA = a1;
                }
                let t : f64 = KGeom::closestOnSegment(b0, b1, pairA);
                pairB = b0.plus(b1.minus(b0).scale(t));
            } else {
                if (k == 3) {
                    pairB = b1;
                }
                let t : f64 = KGeom::closestOnSegment(a0, a1, pairB);
                pairA = a0.plus(a1.minus(a0).scale(t));
            }
            let d : DVec3 = pairB.minus(pairA);
            let d2 : f64 = d.lengthSquared();
            if (d2 >= r * r || d2 < 0.000000000001) {
                continue;
            }
            let dk : f64 = d2.sqrt();
            if (d.scale(1.0 / dk).dot(n) < 0.95) {
                continue;
            }
            let at : DVec3 = pairA.plus(n.scale(sa.radius - (r - dk) * 0.5));
            let far : f64 = at.distanceSquared(main);
            if (far > extraFar) {
                extraFar = far;
                extra = k + 1;
                extraAt = at;
                extraDepth = r - dk;
            }
        }
        let minRadius : f64 = sa.radius + sb.radius;
        if (extra > 0 && extraFar > 0.01 * minRadius * minRadius) {
            out.add(extraAt, extraDepth, extra);
        }
        return true;
    }
}

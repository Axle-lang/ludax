// contact_set — the contacts of one step, as the solver and the debug view see them.
//
// A manifold is the group of points between one pair of bodies; the points live in one packed list and a
// manifold names a run of it. The set also keeps the previous step's contacts: a new point whose pair and
// feature id match an old one inherits its accumulated impulses, which is what lets a stack settle (warm
// starting). Manifolds are ordered like the broad phase's pairs, so the match is a binary search.

use crate::core::collections::vec::Vec;
use crate::core::math::dvec3::DVec3;
use crate::sim::kinetic::kinetic_sort::KineticSort;

/** One contact point between two bodies, with the solver's working data. */
pub struct ContactPoint {
    /** Slot of the first body. */
    pub a : i32 = 0;

    /** Slot of the second body. */
    pub b : i32 = 0;

    /** Unit normal from body a toward body b. */
    pub normal : DVec3 = DVec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** World position of the contact. */
    pub point : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Penetration depth (positive when overlapping). */
    pub depth : f64 = 0.0;

    /** Feature id: which vertex, edge or face made the point, for matching with the previous step. */
    pub feature : i32 = 0;

    /** Combined friction coefficient. */
    pub friction : f64 = 0.0;

    /** Combined restitution. */
    pub restitution : f64 = 0.0;

    /** The normal impulse accumulated over the solver iterations (never negative). */
    pub jn : f64 = 0.0;

    /** The accumulated friction impulse along the first tangent. */
    pub jt1 : f64 = 0.0;

    /** The accumulated friction impulse along the second tangent. */
    pub jt2 : f64 = 0.0;

    /** Offset from body a's centre to the point, world axes. */
    pub rA : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Offset from body b's centre to the point, world axes. */
    pub rB : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** First friction direction, perpendicular to the normal. */
    pub t1 : DVec3 = DVec3 { x: 1.0, y: 0.0, z: 0.0 };

    /** Second friction direction. */
    pub t2 : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 1.0 };

    /** Effective mass along the normal. */
    pub massN : f64 = 0.0;

    /** Effective mass along the first tangent. */
    pub massT1 : f64 = 0.0;

    /** Effective mass along the second tangent. */
    pub massT2 : f64 = 0.0;

    /** The separating speed restitution asks for. */
    pub bounce : f64 = 0.0;

    /** The speed at which penetration is pushed out by the position pass. */
    pub push : f64 = 0.0;

    /** The impulse accumulated by the position pass. */
    pub jp : f64 = 0.0;
}

/** A run of contact points between one pair of bodies. */
pub struct Manifold {
    /** Slot of the first body (the lower one). */
    pub a : i32 = 0;

    /** Slot of the second body. */
    pub b : i32 = 0;

    /** Index of the first point in the set's point list. */
    pub first : i32 = 0;

    /** How many points (1 to 4). */
    pub count : i32 = 0;
}

/** All contacts of a step plus the previous step's, for warm starting. */
pub class ContactSet {
    pub(crate) points       : Vec<ContactPoint>;
    pub(crate) manifolds    : Vec<Manifold>;
    pub(crate) oldPoints    : Vec<ContactPoint>;
    pub(crate) oldManifolds : Vec<Manifold>;

    /** An empty set. */
    constructor() {
        self.points = new Vec<ContactPoint>();
        self.manifolds = new Vec<Manifold>();
        self.oldPoints = new Vec<ContactPoint>();
        self.oldManifolds = new Vec<Manifold>();
    }

    /** Moves this step's contacts to the "previous" side and empties the current lists. */
    pub fn beginStep(mut self) : void {
        self.oldPoints.clear();
        self.oldManifolds.clear();
        for (i of 0..self.points.len()) {
            self.oldPoints.push(self.points.get(i));
        }
        for (i of 0..self.manifolds.len()) {
            self.oldManifolds.push(self.manifolds.get(i));
        }
        self.points.clear();
        self.manifolds.clear();
    }

    /** How many manifolds this step has. */
    pub fn manifoldCount(self) : i32 {
        return self.manifolds.len();
    }

    /** How many contact points this step has. */
    pub fn pointCount(self) : i32 {
        return self.points.len();
    }

    /** Copies the accumulated impulses of the previous step's matching point (same pair, same feature) into `p`. */
    pub fn inherit(self, point : ContactPoint) : ContactPoint {
        let mut out : ContactPoint = point;
        let at : i32 = self.findOldManifold(point.a, point.b);
        if (at < 0) {
            return out;
        }
        let m : Manifold = self.oldManifolds.get(at);
        for (k of 0..m.count) {
            let old : ContactPoint = self.oldPoints.get(m.first + k);
            if (old.feature == point.feature) {
                out.jn = old.jn;
                out.jt1 = old.jt1;
                out.jt2 = old.jt2;
                return out;
            }
        }
        return out;
    }

    // Index of the previous step's manifold of the pair (a, b), or -1; they ascend by (a, b), so it is a
    // binary search.
    fn findOldManifold(self, a : i32, b : i32) : i32 {
        let key : i64 = KineticSort::pairKey(a, b);
        let mut lo : i32 = 0;
        let mut hi : i32 = self.oldManifolds.len();
        while (lo < hi) {
            let mid : i32 = lo + (hi - lo) / 2;
            let mm : Manifold = self.oldManifolds.get(mid);
            if (KineticSort::pairKey(mm.a, mm.b) < key) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if (lo >= self.oldManifolds.len()) {
            return -1;
        }
        let m : Manifold = self.oldManifolds.get(lo);
        if (m.a != a || m.b != b) {
            return -1;
        }
        return lo;
    }
}

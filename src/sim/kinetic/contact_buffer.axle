// contact_buffer — the scratch space a narrow-phase test writes its contact points into.
//
// One shared normal (from the first shape toward the second) and a short list of points, each with a depth and
// a feature id. The id names which vertex / edge / face produced the point, so the next step can find the same
// point again and reuse the impulse it had (warm starting). A buffer is reused for every pair; `clear` between.

use crate::core::collections::vec::Vec;
use crate::core::math::dvec3::DVec3;
use crate::sim::kinetic::clip_poly::ClipPoly;

/** Contact points of one shape pair, before they are copied into the world's contact list. */
pub class ContactBuffer {
    normalDir : DVec3 = DVec3 { x: 0.0, y: 1.0, z: 0.0 };
    points    : Vec<DVec3>;
    depths    : Vec<f64>;
    featureId : Vec<i32>;
    clipA     : ClipPoly;
    clipB     : ClipPoly;

    /** An empty buffer. */
    constructor() {
        self.points = new Vec<DVec3>();
        self.depths = new Vec<f64>();
        self.featureId = new Vec<i32>();
        self.clipA = new ClipPoly();
        self.clipB = new ClipPoly();
    }

    /** A scratch polygon for face clipping; the box-box test owns both for the duration of a call. */
    pub fn polyA(self) : ClipPoly {
        return self.clipA;
    }

    /** The second scratch polygon. */
    pub fn polyB(self) : ClipPoly {
        return self.clipB;
    }

    /** Forgets all points. */
    pub fn clear(mut self) : void {
        self.points.clear();
        self.depths.clear();
        self.featureId.clear();
    }

    /** The unit contact normal, pointing from the first shape toward the second. */
    pub fn normal(self) : DVec3 {
        return self.normalDir;
    }

    /** Sets the contact normal. */
    pub fn setNormal(mut self, n : DVec3) : void {
        self.normalDir = n;
    }

    /** Adds a point with its penetration depth (positive when the shapes overlap) and feature id. */
    pub fn add(mut self, p : DVec3, depth : f64, id : i32) : void {
        self.points.push(p);
        self.depths.push(depth);
        self.featureId.push(id);
    }

    /** How many points there are. */
    pub fn count(self) : i32 {
        return self.points.len();
    }

    /** Point `k` in world space. */
    pub fn pointAt(self, k : i32) : DVec3 {
        return self.points.get(k);
    }

    /** Penetration depth of point `k`. */
    pub fn depthAt(self, k : i32) : f64 {
        return self.depths.get(k);
    }

    /** Feature id of point `k`. */
    pub fn idAt(self, k : i32) : i32 {
        return self.featureId.get(k);
    }

    /** Reverses the normal: the same contact seen from the other shape. */
    pub fn flip(mut self) : void {
        self.normalDir = self.normalDir.negated();
    }

    /**
     * Keeps at most four points that cover the contact patch best: the deepest, the one farthest from it, then
     * the two that enclose the largest area. Four well spread points hold a box up; more only cost time.
     */
    pub fn reduceToFour(mut self) : void {
        let n : i32 = self.points.len();
        if (n <= 4) {
            return;
        }
        let mut best : i32 = 0;
        for (k of 1..n) {
            if (self.depths.get(k) > self.depths.get(best)) {
                best = k;
            }
        }
        let p0 : DVec3 = self.points.get(best);
        let mut far : i32 = -1;
        let mut farD : f64 = -1.0;
        for (k of 0..n) {
            let d : f64 = self.points.get(k).distanceSquared(p0);
            if (k != best && d > farD) {
                far = k;
                farD = d;
            }
        }
        let p1 : DVec3 = self.points.get(far);
        let nrm : DVec3 = self.normalDir;
        let mut third : i32 = -1;
        let mut thirdA : f64 = 0.0;
        for (k of 0..n) {
            if (k == best || k == far) {
                continue;
            }
            let a : f64 = p1.minus(p0).cross(self.points.get(k).minus(p0)).dot(nrm);
            let mag : f64 = a * a;
            if (third < 0 || mag > thirdA * thirdA) {
                third = k;
                thirdA = a;
            }
        }
        let p2 : DVec3 = self.points.get(third);
        let mut fourth : i32 = -1;
        let mut fourthA : f64 = 0.0;
        for (k of 0..n) {
            if (k == best || k == far || k == third) {
                continue;
            }
            let q : DVec3 = self.points.get(k);
            // The fourth corner lies on the other side of the third's triangle: most negative signed area
            // against the edge (p0, p1) when the third was positive, and vice versa.
            let a : f64 = p1.minus(p0).cross(q.minus(p0)).dot(nrm);
            let mut score : f64 = -a;
            if (thirdA < 0.0) {
                score = a;
            }
            let near : f64 = q.distanceSquared(p2);
            score = score + near * 0.000001;
            if (fourth < 0 || score > fourthA) {
                fourth = k;
                fourthA = score;
            }
        }
        let d0 : f64 = self.depths.get(best);
        let i0 : i32 = self.featureId.get(best);
        let d1 : f64 = self.depths.get(far);
        let i1 : i32 = self.featureId.get(far);
        let d2 : f64 = self.depths.get(third);
        let i2 : i32 = self.featureId.get(third);
        let q3 : DVec3 = self.points.get(fourth);
        let d3 : f64 = self.depths.get(fourth);
        let i3 : i32 = self.featureId.get(fourth);
        self.clear();
        self.add(p0, d0, i0);
        self.add(p1, d1, i1);
        self.add(p2, d2, i2);
        self.add(q3, d3, i3);
    }
}

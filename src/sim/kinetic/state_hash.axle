// state_hash — a fingerprint of a whole physics state, for determinism checks and replays.
//
// Every live body contributes its slot, position, velocities, orientation and sleep flag, quantised to a
// nanometre (or nano-unit) and folded in slot order with the engine's integer hash. The quantisation makes the
// hash independent of the last bit of a float, which no two correct compilers agree on, while any real
// divergence of a simulation shows up within a few steps.

use crate::core::id::hash::hashCombine;
use crate::core::math::dquat::DQuat;
use crate::core::math::dvec3::DVec3;
use crate::core::math::scalar::clampD;
use crate::sim::kinetic::body_store::BodyStore;

// The seed of the fold. Not the FNV offset basis: changing it changes every recorded hash.
const STATE_HASH_SEED : i64 = 1469598103934665603;

// Values are quantised to 1e-9 and clamped to 1e9 either way, so the product stays inside an i64.
const STATE_HASH_RANGE : f64 = 1.0e9;
const STATE_HASH_SCALE : f64 = 1.0e9;

// What a NaN or infinity folds to, so a blown-up body still changes the hash.
const STATE_HASH_NONFINITE : i64 = -1;

// Folded in for a sleeping body, so a body that fell asleep changes the hash.
const STATE_HASH_ASLEEP_TAG : i64 = 7;

/** Hashing of body state. */
pub(crate) class StateHash {
    /** The hash of every live body in `s`. */
    pub(crate) static fn compute(bodies : BodyStore) : i64 {
        let mut h : i64 = STATE_HASH_SEED;
        for (i of 0..bodies.slotCount()) {
            if (!bodies.isLive(i)) {
                continue;
            }
            h = hashCombine(h, i as i64);

            h = StateHash::vec(h, bodies.position.get(i));
            h = StateHash::vec(h, bodies.linearVelocity.get(i));
            h = StateHash::vec(h, bodies.angularVelocity.get(i));

            let q : DQuat = bodies.rotation.get(i);
            let qv : DVec3 = DVec3 { x: q.x, y: q.y, z: q.z };
            h = StateHash::vec(h, qv);
            h = hashCombine(h, StateHash::quantize(q.w));
            if (bodies.asleep.get(i)) {
                h = hashCombine(h, STATE_HASH_ASLEEP_TAG);
            }
        }
        return h;
    }

    static fn quantize(x : f64) : i64 {
        if (!x.isFinite()) {
            return STATE_HASH_NONFINITE;
        }
        let c : f64 = clampD(x, -STATE_HASH_RANGE, STATE_HASH_RANGE);
        return (c * STATE_HASH_SCALE) as i64;
    }

    static fn vec(h : i64, v : DVec3) : i64 {
        let mut r : i64 = hashCombine(h, StateHash::quantize(v.x));
        r = hashCombine(r, StateHash::quantize(v.y));
        return hashCombine(r, StateHash::quantize(v.z));
    }
}

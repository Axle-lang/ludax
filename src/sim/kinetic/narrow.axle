// narrow — picks the contact test for a pair of shapes.
//
// The pair table is ordered by shape kind (sphere, box, capsule, plane); a pair given in the other order is
// swapped, tested, and its normal flipped, so each combination is written once. The result is always a normal
// from the first shape toward the second and up to four points, each with a depth and a feature id.

use crate::core::math::dquat::DQuat;
use crate::core::math::dvec3::DVec3;
use crate::sim::kinetic::contact_buffer::ContactBuffer;
use crate::sim::kinetic::narrow_basic::NarrowBasic;
use crate::sim::kinetic::narrow_box::NarrowBox;
use crate::sim::kinetic::shape::{Shape, ShapeKind};

/** The narrow phase: exact contacts between two placed shapes. */
pub class Narrow {
    /**
     * Tests two shapes, each placed by a position and orientation. When they overlap, `out` (cleared first)
     * holds the normal from `sa` to `sb` and the contact points, and the answer is true.
     */
    pub static fn collide(
        sa : Shape,
        pa : DVec3,
        qa : DQuat,
        sb : Shape,
        pb : DVec3,
        qb : DQuat,
        out : ContactBuffer
    ) : bool {
        out.clear();
        let ka : i32 = sa.kind.code();
        let kb : i32 = sb.kind.code();
        if (ka > kb) {
            let hit : bool = Narrow::ordered(sb, pb, qb, sa, pa, qa, out);
            if (hit) {
                out.flip();
            }
            return hit;
        }
        return Narrow::ordered(sa, pa, qa, sb, pb, qb, out);
    }

    // Kinds ascend: sphere 0, box 1, capsule 2, plane 3. Box-capsule arrives as capsule-box and is flipped.
    static fn ordered(
        sa : Shape,
        pa : DVec3,
        qa : DQuat,
        sb : Shape,
        pb : DVec3,
        qb : DQuat,
        out : ContactBuffer
    ) : bool {
        return match sa.kind {
            ShapeKind::Sphere => match sb.kind {
                ShapeKind::Sphere => NarrowBasic::sphereSphere(pa, sa.radius, pb, sb.radius, out),
                ShapeKind::Cuboid => NarrowBox::sphereBox(pa, sa.radius, sb, pb, qb, out),
                ShapeKind::Capsule => NarrowBasic::sphereCapsule(pa, sa.radius, sb, pb, qb, out),
                ShapeKind::Plane => NarrowBasic::spherePlane(pa, sa.radius, sb, out),
            },
            ShapeKind::Cuboid => match sb.kind {
                ShapeKind::Sphere => false,
                ShapeKind::Cuboid => NarrowBox::boxBox(sa.half, pa, qa, sb.half, pb, qb, out),
                ShapeKind::Capsule => Narrow::flipIfHit(
                    NarrowBox::capsuleBox(sb, pb, qb, sa, pa, qa, out),
                    out
                ),
                ShapeKind::Plane => NarrowBasic::boxPlane(sa, pa, qa, sb, out),
            },
            ShapeKind::Capsule => match sb.kind {
                ShapeKind::Sphere => false,
                ShapeKind::Cuboid => false,
                ShapeKind::Capsule => NarrowBasic::capsuleCapsule(sa, pa, qa, sb, pb, qb, out),
                ShapeKind::Plane => NarrowBasic::capsulePlane(sa, pa, qa, sb, out),
            },
            ShapeKind::Plane => false,
        };
    }

    // Flips `out` when `hit`, so a test written in the other order still reports the normal from first to second.
    static fn flipIfHit(hit : bool, out : ContactBuffer) : bool {
        if (hit) {
            out.flip();
        }
        return hit;
    }
}

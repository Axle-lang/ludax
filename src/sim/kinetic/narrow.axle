// narrow — picks the contact test for a pair of shapes.
//
// The pair table is ordered by shape kind (sphere, box, capsule, plane); a pair given in the other order is
// swapped, tested, and its normal flipped, so each combination is written once. The result is always a normal
// from the first shape toward the second and up to four points, each with a depth and a feature id.

use crate::core::math::dquat::DQuat;
use crate::core::math::dvec3::DVec3;
use crate::sim::kinetic::contact_buffer::ContactBuffer;
use crate::sim::kinetic::narrow_basic::NarrowBasic;
use crate::sim::kinetic::narrow_box::NarrowBox;
use crate::sim::kinetic::shape::{Placed, Shape, ShapeKind};

/** The narrow phase: exact contacts between two placed shapes. */
pub class Narrow {
    /**
     * Tests two shapes, each placed by a position and orientation. When they overlap, `out` (cleared first)
     * holds the normal from `sa` to `sb` and the contact points, and the answer is true.
     */
    pub static fn collide(
        sa : Shape,
        pa : DVec3,
        qa : DQuat,
        sb : Shape,
        pb : DVec3,
        qb : DQuat,
        out : ContactBuffer
    ) : bool {
        let a : Placed = Placed { shape: sa, pos: pa, rot: qa };
        let b : Placed = Placed { shape: sb, pos: pb, rot: qb };
        return Narrow::collidePlaced(a, b, out);
    }

    /** As `collide`, for shapes already bundled with their placement. */
    pub(crate) static fn collidePlaced(a : Placed, b : Placed, out : ContactBuffer) : bool {
        out.clear();
        if (a.shape.kind.code() > b.shape.kind.code()) {
            return Narrow::flipIfHit(Narrow::ordered(b, a, out), out);
        }
        return Narrow::ordered(a, b, out);
    }

    // Kinds ascend: sphere 0, box 1, capsule 2, plane 3. Box-capsule arrives as capsule-box and is flipped.
    static fn ordered(a : Placed, b : Placed, out : ContactBuffer) : bool {
        return match a.shape.kind {
            ShapeKind::Sphere => Narrow::sphereVs(a, b, out),
            ShapeKind::Cuboid => Narrow::boxVs(a, b, out),
            ShapeKind::Capsule => Narrow::capsuleVs(a, b, out),
            ShapeKind::Plane => false,
        };
    }

    static fn sphereVs(a : Placed, b : Placed, out : ContactBuffer) : bool {
        let r : f64 = a.shape.radius;
        return match b.shape.kind {
            ShapeKind::Sphere => NarrowBasic::sphereSphere(a.pos, r, b.pos, b.shape.radius, out),
            ShapeKind::Cuboid => NarrowBox::sphereBox(a.pos, r, b, out),
            ShapeKind::Capsule => NarrowBasic::sphereCapsule(a.pos, r, b, out),
            ShapeKind::Plane => NarrowBasic::spherePlane(a.pos, r, b.shape, out),
        };
    }

    static fn boxVs(a : Placed, b : Placed, out : ContactBuffer) : bool {
        return match b.shape.kind {
            ShapeKind::Sphere => false,
            ShapeKind::Cuboid => NarrowBox::boxBox(a, b, out),
            ShapeKind::Capsule => Narrow::flipIfHit(NarrowBox::capsuleBox(b, a, out), out),
            ShapeKind::Plane => NarrowBasic::boxPlane(a, b.shape, out),
        };
    }

    static fn capsuleVs(a : Placed, b : Placed, out : ContactBuffer) : bool {
        return match b.shape.kind {
            ShapeKind::Capsule => NarrowBasic::capsuleCapsule(a, b, out),
            ShapeKind::Plane => NarrowBasic::capsulePlane(a, b.shape, out),
            _ => false,
        };
    }

    // Flips `out` when `hit`, so a test written in the other order still reports the normal from first to second.
    static fn flipIfHit(hit : bool, out : ContactBuffer) : bool {
        if (hit) {
            out.flip();
        }
        return hit;
    }
}

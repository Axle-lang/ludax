// debug_draw — the world as plain lines and points, for any renderer to draw.
//
// kinetic draws nothing itself. `PhysicsWorld.debugDraw` fills one of these with the wireframe of every shape,
// the contact points with their normals, and the joints, as flat arrays: lines are six numbers (two end points)
// and a colour, points are three numbers and a colour. Colours are 0xRRGGBB. The arrays can be read straight
// into a vertex buffer, or into the software line drawing of an example.

use crate::core::collections::vec::Vec;
use crate::core::math::dquat::DQuat;
use crate::core::math::dvec3::DVec3;
use crate::core::math::scalar::TAU_D;
use crate::core::math::trig::{sinD, cosD};
use crate::sim::kinetic::shape::{Shape, ShapeKind};

// Segments in a circle outline, and half the side of the square drawn for an infinite plane.
const DEBUG_RING_STEPS : i32 = 24;
const DEBUG_PLANE_PATCH : f64 = 20.0;

/** Colour of a static body's outline: grey, 0x888888. */
pub const DEBUG_COLOR_STATIC : i32 = 8947848;

/** Colour of an awake dynamic body's outline: cyan, 0x55FFFF. */
pub const DEBUG_COLOR_AWAKE : i32 = 5636095;

/** Colour of a sleeping body's outline: blue, 0x5555FF. */
pub const DEBUG_COLOR_ASLEEP : i32 = 5592575;

/** Colour of a kinematic body's outline: orange, 0xFFAA00. */
pub const DEBUG_COLOR_KINEMATIC : i32 = 16755200;

/** Colour of contact points and normals: red, 0xFF0000. */
pub const DEBUG_COLOR_CONTACT : i32 = 16711680;

/** Colour of joints: yellow, 0xFFFF00. */
pub const DEBUG_COLOR_JOINT : i32 = 16776960;

/** A list of coloured line segments and points. */
pub class DebugDraw {
    /** Line segments, six numbers each: x1 y1 z1 x2 y2 z2. */
    pub lines : Vec<f64>;

    /** One colour per line segment. */
    pub lineColors : Vec<i32>;

    /** Points, three numbers each: x y z. */
    pub points : Vec<f64>;

    /** One colour per point. */
    pub pointColors : Vec<i32>;

    /** An empty drawing. */
    constructor() {
        self.lines = new Vec<f64>();
        self.lineColors = new Vec<i32>();
        self.points = new Vec<f64>();
        self.pointColors = new Vec<i32>();
    }

    /** Empties the drawing. */
    pub fn clear(mut self) : void {
        self.lines.clear();
        self.lineColors.clear();
        self.points.clear();
        self.pointColors.clear();
    }

    /** How many line segments there are. */
    pub fn lineCount(self) : i32 {
        return self.lineColors.len();
    }

    /** How many points there are. */
    pub fn pointCount(self) : i32 {
        return self.pointColors.len();
    }

    /** Adds the segment `a`..`b`. */
    pub fn line(mut self, a : DVec3, b : DVec3, color : i32) : void {
        self.lines.push(a.x);
        self.lines.push(a.y);
        self.lines.push(a.z);
        self.lines.push(b.x);
        self.lines.push(b.y);
        self.lines.push(b.z);
        self.lineColors.push(color);
    }

    /** Adds a point. */
    pub fn point(mut self, p : DVec3, color : i32) : void {
        self.points.push(p.x);
        self.points.push(p.y);
        self.points.push(p.z);
        self.pointColors.push(color);
    }

    /** Adds a ring of radius `r` around `centre` in the plane spanned by the unit vectors `u` and `v`. */
    pub fn ring(mut self, centre : DVec3, u : DVec3, v : DVec3, r : f64, color : i32) : void {
        let steps : i32 = DEBUG_RING_STEPS;
        let mut prev : DVec3 = centre.plus(u.scale(r));
        for (k of 1..steps + 1) {
            let a : f64 = TAU_D * (k as f64) / (steps as f64);
            let p : DVec3 = centre.plus(u.scale(r * cosD(a))).plus(v.scale(r * sinD(a)));
            self.line(prev, p, color);
            prev = p;
        }
    }

    /** Adds the wireframe of `sh` placed at `pos` with orientation `rot`. */
    pub fn shape(mut self, sh : Shape, pos : DVec3, rot : DQuat, color : i32) : void {
        let ex : DVec3 = rot.rotate(DVec3 { x: 1.0, y: 0.0, z: 0.0 });
        let ey : DVec3 = rot.rotate(DVec3 { x: 0.0, y: 1.0, z: 0.0 });
        let ez : DVec3 = rot.rotate(DVec3 { x: 0.0, y: 0.0, z: 1.0 });
        match sh.kind {
            ShapeKind::Sphere => {
                self.ring(pos, ex, ey, sh.radius, color);
                self.ring(pos, ey, ez, sh.radius, color);
                self.ring(pos, ex, ez, sh.radius, color);
            },
            ShapeKind::Cuboid => self.wireBox(sh.half, pos, ex, ey, ez, color),
            ShapeKind::Capsule => self.wireCapsule(sh, pos, ex, ey, ez, color),
            ShapeKind::Plane => self.wirePlane(sh, color),
        }
    }

    // The two cap rings, the four side lines and a tip on each cap.
    fn wireCapsule(
        mut self,
        sh : Shape,
        pos : DVec3,
        ex : DVec3,
        ey : DVec3,
        ez : DVec3,
        color : i32
    ) : void {
        let top : DVec3 = pos.plus(ey.scale(sh.half.y));
        let bottom : DVec3 = pos.minus(ey.scale(sh.half.y));
        self.ring(top, ex, ez, sh.radius, color);
        self.ring(bottom, ex, ez, sh.radius, color);
        self.line(top.plus(ex.scale(sh.radius)), bottom.plus(ex.scale(sh.radius)), color);
        self.line(top.minus(ex.scale(sh.radius)), bottom.minus(ex.scale(sh.radius)), color);
        self.line(top.plus(ez.scale(sh.radius)), bottom.plus(ez.scale(sh.radius)), color);
        self.line(top.minus(ez.scale(sh.radius)), bottom.minus(ez.scale(sh.radius)), color);
        self.line(top, top.plus(ey.scale(sh.radius)), color);
        self.line(bottom, bottom.minus(ey.scale(sh.radius)), color);
    }

    // A plane is drawn as a patch around the point nearest the origin.
    fn wirePlane(mut self, sh : Shape, color : i32) : void {
        let c : DVec3 = sh.normal.scale(sh.offset);
        let u : DVec3 = sh.normal.anyPerpendicular();
        let v : DVec3 = sh.normal.cross(u);
        let e : f64 = DEBUG_PLANE_PATCH;
        self.line(c.plus(u.scale(e)).plus(v.scale(e)), c.minus(u.scale(e)).plus(v.scale(e)), color);
        self.line(c.minus(u.scale(e)).plus(v.scale(e)), c.minus(u.scale(e)).minus(v.scale(e)), color);
        self.line(c.minus(u.scale(e)).minus(v.scale(e)), c.plus(u.scale(e)).minus(v.scale(e)), color);
        self.line(c.plus(u.scale(e)).minus(v.scale(e)), c.plus(u.scale(e)).plus(v.scale(e)), color);
    }

    // The twelve edges of a box.
    fn wireBox(mut self, h : DVec3, pos : DVec3, ex : DVec3, ey : DVec3, ez : DVec3, color : i32) : void {
        for (i of 0..8) {
            let sx : f64 = (((i & 1) * 2) - 1) as f64;
            let sy : f64 = ((((i >> 1) & 1) * 2) - 1) as f64;
            let sz : f64 = ((((i >> 2) & 1) * 2) - 1) as f64;
            let c : DVec3 = pos.plus(ex.scale(sx * h.x)).plus(ey.scale(sy * h.y)).plus(ez.scale(sz * h.z));
            if ((i & 1) == 0) {
                self.line(c, c.plus(ex.scale(2.0 * h.x)), color);
            }
            if (((i >> 1) & 1) == 0) {
                self.line(c, c.plus(ey.scale(2.0 * h.y)), color);
            }
            if (((i >> 2) & 1) == 0) {
                self.line(c, c.plus(ez.scale(2.0 * h.z)), color);
            }
        }
    }
}

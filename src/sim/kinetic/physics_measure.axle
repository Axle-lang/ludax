// physics_measure — conserved quantities of a physics world: energy and momentum.
//
// These are read-only sums over the dynamic bodies, kept out of `PhysicsWorld` so the world file holds the
// stepping and the handle API only. Tests and tools use them to check that a scene neither gains nor loses energy
// beyond what damping and collisions account for; none of them feeds back into the simulation.

use crate::core::math::dvec3::DVec3;
use crate::sim::kinetic::body_store::BodyStore;

/** Energy and momentum sums over the dynamic bodies of a store. */
pub(crate) class PhysicsMeasure {
    /** Linear plus rotational kinetic energy of all dynamic bodies, in joules. */
    pub(crate) static fn kineticEnergy(bodies : BodyStore) : f64 {
        let mut e : f64 = 0.0;
        for (i of 0..bodies.slotCount()) {
            if (!bodies.isLive(i) || !bodies.isDynamic(i)) {
                continue;
            }
            e = e + 0.5 * bodies.mass.get(i) * bodies.linearVelocity.get(i).lengthSquared();

            // Rotational energy in the body frame, where the inertia tensor is diagonal; an axis with no
            // inverse inertia is locked and holds none.
            let wl : DVec3 = bodies.rotation.get(i).conjugate().rotate(bodies.angularVelocity.get(i));
            let inv : DVec3 = bodies.invInertia.get(i);
            e = e + PhysicsMeasure::axisEnergy(wl.x, inv.x);
            e = e + PhysicsMeasure::axisEnergy(wl.y, inv.y);
            e = e + PhysicsMeasure::axisEnergy(wl.z, inv.z);
        }
        return e;
    }

    // Energy of spinning at `w` about one principal axis with inverse inertia `inv`; a locked axis holds none.
    static fn axisEnergy(w : f64, inv : f64) : f64 {
        if (inv > 0.0) {
            return 0.5 * w * w / inv;
        }
        return 0.0;
    }

    /** Potential energy of all dynamic bodies in `gravity`, relative to the origin. */
    pub(crate) static fn potentialEnergy(bodies : BodyStore, gravity : DVec3) : f64 {
        let mut e : f64 = 0.0;
        for (i of 0..bodies.slotCount()) {
            if (!bodies.isLive(i) || !bodies.isDynamic(i)) {
                continue;
            }
            e = e - bodies.mass.get(i) * bodies.gravityScale.get(i) * gravity.dot(bodies.position.get(i));
        }
        return e;
    }

    /** Total linear momentum of all dynamic bodies. */
    pub(crate) static fn linearMomentum(bodies : BodyStore) : DVec3 {
        let mut p : DVec3 = DVec3::zero();
        for (i of 0..bodies.slotCount()) {
            if (bodies.isLive(i) && bodies.isDynamic(i)) {
                p = p.plus(bodies.linearVelocity.get(i).scale(bodies.mass.get(i)));
            }
        }
        return p;
    }
}

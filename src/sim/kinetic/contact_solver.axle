// contact_solver — sequential impulses for contacts: non-penetration, Coulomb friction and restitution.
//
// Each contact point is a constraint on the relative velocity of the two bodies at that point. The solver
// visits the points in a fixed order several times, correcting each in turn and keeping the total impulse
// applied so far (clamped so that contacts only push, and friction stays inside its cone). Starting from the
// previous step's totals (warm starting) is what lets a stack of boxes settle. Overlap is removed separately
// by a position pass on pseudo velocities (split impulse), so fixing a penetration never adds real energy.

use crate::core::math::dvec3::DVec3;
use crate::core::math::scalar::maxD;
use crate::sim::kinetic::body_store::BodyStore;
use crate::sim::kinetic::contact_set::{ContactPoint, ContactSet};
use crate::sim::kinetic::settings::PhysicsSettings;
use crate::sim::kinetic::solver_state::SolverState;

/** The contact half of the constraint solver. */
pub class ContactSolver {
    /** Computes effective masses, friction directions, bounce and push-out speeds for every point. */
    pub static fn prepare(cs : ContactSet, st : SolverState, s : BodyStore, cfg : PhysicsSettings) : void {
        let dt : f64 = cfg.substep;
        for (i of 0..cs.points.len()) {
            let mut p : ContactPoint = cs.points.get(i);
            p.rA = p.point.minus(s.pos.get(p.a));
            p.rB = p.point.minus(s.pos.get(p.b));
            let n : DVec3 = p.normal;
            p.t1 = n.anyPerpendicular();
            p.t2 = n.cross(p.t1);
            p.massN = ContactSolver::effectiveMass(st, p, n);
            p.massT1 = ContactSolver::effectiveMass(st, p, p.t1);
            p.massT2 = ContactSolver::effectiveMass(st, p, p.t2);
            let vn : f64 = st.pointVelocity(p.b, p.rB).minus(st.pointVelocity(p.a, p.rA)).dot(n);
            // Bounce off the speed the bodies had when the overlap was measured (the start of the step), not
            // the speed after this step's gravity: reflecting that would hand the ball a step of speed it never
            // earned and each bounce would climb a little higher.
            let before : f64 = s.prevLin
                .get(p.b)
                .plus(s.prevAng.get(p.b).cross(p.rB))
                .minus(s.prevLin.get(p.a).plus(s.prevAng.get(p.a).cross(p.rA)))
                .dot(n);
            p.bounce = 0.0;
            if (before < -cfg.restitutionThreshold) {
                p.bounce = -p.restitution * before;
            }
            // A contact that is already separating (or about to bounce) clears the overlap by itself; pushing
            // it as well would lift it for free.
            let over : f64 = maxD(p.depth - cfg.penetrationSlop, 0.0);
            let mut push : f64 = over * cfg.pushFactor / dt;
            if (push > cfg.maxPushSpeed) {
                push = cfg.maxPushSpeed;
            }
            let leaving : f64 = maxD(vn, p.bounce);
            p.push = maxD(push - leaving, 0.0);
            p.jp = 0.0;
            if (cfg.warmStarting) {
                p = cs.inherit(p);
            } else {
                p.jn = 0.0;
                p.jt1 = 0.0;
                p.jt2 = 0.0;
            }
            cs.points.set(i, p);
        }
    }

    // The inverse of how hard it is to change the relative speed along `d` at the contact point.
    static fn effectiveMass(st : SolverState, p : ContactPoint, d : DVec3) : f64 {
        let ra : DVec3 = p.rA.cross(d);
        let rb : DVec3 = p.rB.cross(d);
        let k : f64 = st.invMass(p.a) + st.invMass(p.b) + ra.dot(st.invInertia(p.a, ra))
            + rb.dot(st.invInertia(p.b, rb));
        if (k <= 0.0) {
            return 0.0;
        }
        return 1.0 / k;
    }

    /** Applies the impulses inherited from the previous step. */
    pub static fn warmStart(cs : ContactSet, st : SolverState) : void {
        for (i of 0..cs.points.len()) {
            let p : ContactPoint = cs.points.get(i);
            let imp : DVec3 = p.normal.scale(p.jn).plus(p.t1.scale(p.jt1)).plus(p.t2.scale(p.jt2));
            st.applyImpulse(p.a, p.b, imp, p.rA, p.rB);
        }
    }

    /** One pass over all points: friction first (limited by the normal impulse so far), then the normal. */
    pub static fn iterate(cs : ContactSet, st : SolverState) : void {
        for (i of 0..cs.points.len()) {
            let mut p : ContactPoint = cs.points.get(i);
            let n : DVec3 = p.normal;
            let vrel : DVec3 = st.pointVelocity(p.b, p.rB).minus(st.pointVelocity(p.a, p.rA));
            let mut n1 : f64 = p.jt1 - p.massT1 * vrel.dot(p.t1);
            let mut n2 : f64 = p.jt2 - p.massT2 * vrel.dot(p.t2);
            let limit : f64 = p.friction * p.jn;
            let len2 : f64 = n1 * n1 + n2 * n2;
            if (len2 > limit * limit) {
                let k : f64 = limit / len2.sqrt();
                n1 = n1 * k;
                n2 = n2 * k;
            }
            let d1 : f64 = n1 - p.jt1;
            let d2 : f64 = n2 - p.jt2;
            p.jt1 = n1;
            p.jt2 = n2;
            st.applyImpulse(p.a, p.b, p.t1.scale(d1).plus(p.t2.scale(d2)), p.rA, p.rB);

            let vn : f64 = st.pointVelocity(p.b, p.rB).minus(st.pointVelocity(p.a, p.rA)).dot(n);
            let lam : f64 = p.massN * (p.bounce - vn);
            let total : f64 = maxD(p.jn + lam, 0.0);
            let delta : f64 = total - p.jn;
            p.jn = total;
            st.applyImpulse(p.a, p.b, n.scale(delta), p.rA, p.rB);
            cs.points.set(i, p);
        }
    }

    /** One pass of the position pass: drives the pseudo velocity along each normal to the push-out speed. */
    pub static fn iteratePosition(cs : ContactSet, st : SolverState) : void {
        for (i of 0..cs.points.len()) {
            let mut p : ContactPoint = cs.points.get(i);
            if (p.push <= 0.0) {
                continue;
            }
            let va : DVec3 = st.pseudoLin(p.a).plus(st.pseudoAng(p.a).cross(p.rA));
            let vb : DVec3 = st.pseudoLin(p.b).plus(st.pseudoAng(p.b).cross(p.rB));
            let vn : f64 = vb.minus(va).dot(p.normal);
            let lam : f64 = p.massN * (p.push - vn);
            let total : f64 = maxD(p.jp + lam, 0.0);
            let delta : f64 = total - p.jp;
            p.jp = total;
            st.applyPseudoImpulse(p.a, p.b, p.normal.scale(delta), p.rA, p.rB);
            cs.points.set(i, p);
        }
    }
}

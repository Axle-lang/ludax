// clip_poly — a small convex polygon that can be cut by planes, for clipping box faces against each other.
//
// Every vertex carries a feature id. A vertex that survives a cut keeps its id; a vertex created where an edge
// crosses the cutting plane gets a new id derived from the edge's two ends and the plane, so the same
// geometric configuration gives the same ids on the next step.

use crate::core::collections::vec::Vec;
use crate::core::math::dvec3::DVec3;

// Feature ids above this name a vertex created by a cut; the ones below are the input's own.
const CLIPPED_ID_BASE : i32 = 4096;

// Ids are folded into this many values, so two edges cut by the same plane cannot overflow the id space.
const CLIPPED_ID_MASK : i32 = 4095;

// Odd weights that keep (a, b) and (b, a) ids apart before they are folded; any odd pair would do, these are
// the ones recorded contacts were made with.
const CLIPPED_ID_WEIGHT_A : i32 = 5;
const CLIPPED_ID_WEIGHT_B : i32 = 3;

/** The half space `(x - origin) . normal <= offset` that a polygon is cut to, and the number that names it. */
pub(crate) struct ClipPlane {
    pub(crate) origin : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };
    pub(crate) normal : DVec3 = DVec3 { x: 0.0, y: 1.0, z: 0.0 };
    pub(crate) offset : f64 = 0.0;

    /** Numbers the plane for the ids of the vertices it creates. */
    pub(crate) id : i32 = 0;
}

/** A polygon being clipped. */
pub(crate) class ClipPoly {
    pub(crate) pts : Vec<DVec3>;
    pub(crate) ids : Vec<i32>;

    /** An empty polygon. */
    constructor() {
        self.pts = new Vec<DVec3>();
        self.ids = new Vec<i32>();
    }

    /** Removes all vertices. */
    pub(crate) fn clear(mut self) : void {
        self.pts.clear();
        self.ids.clear();
    }

    /** Appends a vertex. */
    pub(crate) fn push(mut self, p : DVec3, id : i32) : void {
        self.pts.push(p);
        self.ids.push(id);
    }

    /** How many vertices. */
    pub(crate) fn count(self) : i32 {
        return self.pts.len();
    }

    /** Cuts `src` by `plane` and writes the result into this polygon (which is cleared first). */
    pub(crate) fn clipFrom(mut self, src : ClipPoly, plane : ClipPlane) : void {
        self.clear();
        let n : i32 = src.count();
        for (k of 0..n) {
            let a : DVec3 = src.pts.get(k);
            let ia : i32 = src.ids.get(k);
            let nextK : i32 = (k + 1) % n;
            let b : DVec3 = src.pts.get(nextK);
            let ib : i32 = src.ids.get(nextK);
            let da : f64 = a.minus(plane.origin).dot(plane.normal) - plane.offset;
            let db : f64 = b.minus(plane.origin).dot(plane.normal) - plane.offset;
            let inA : bool = da <= 0.0;
            let inB : bool = db <= 0.0;

            // An edge that crosses the plane gains a vertex at the crossing; an end that is inside is kept.
            if (inA != inB) {
                let t : f64 = da / (da - db);
                let cut : DVec3 = a.plus(b.minus(a).scale(t));
                self.push(cut, ClipPoly::cutId(ia, ib, plane.id));
            }
            if (inB) {
                self.push(b, ib);
            }
        }
    }

    // The id of a vertex where the edge ia-ib crosses plane `plane`: a pure function of the three, so the same
    // configuration gives the same id next step.
    static fn cutId(ia : i32, ib : i32, plane : i32) : i32 {
        let folded : i32 = ia * CLIPPED_ID_WEIGHT_A + ib * CLIPPED_ID_WEIGHT_B + plane + 1;
        return CLIPPED_ID_BASE + (folded & CLIPPED_ID_MASK);
    }
}

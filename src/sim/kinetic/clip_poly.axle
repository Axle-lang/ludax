// clip_poly — a small convex polygon that can be cut by planes, for clipping box faces against each other.
//
// Every vertex carries a feature id. A vertex that survives a cut keeps its id; a vertex created where an edge
// crosses the cutting plane gets a new id derived from the edge's two ends and the plane, so the same
// geometric configuration gives the same ids on the next step.

use crate::core::collections::vec::Vec;
use crate::core::math::dvec3::DVec3;

// Feature ids above this name a vertex created by a cut; the ones below are the input's own.
const CLIPPED_ID_BASE : i32 = 4096;

// Ids are folded into this many values, so two edges cut by the same plane cannot overflow the id space.
const CLIPPED_ID_MASK : i32 = 4095;

/** A polygon being clipped. */
pub class ClipPoly {
    pub(crate) pts : Vec<DVec3>;
    pub(crate) ids : Vec<i32>;

    /** An empty polygon. */
    constructor() {
        self.pts = new Vec<DVec3>();
        self.ids = new Vec<i32>();
    }

    /** Removes all vertices. */
    pub fn clear(mut self) : void {
        self.pts.clear();
        self.ids.clear();
    }

    /** Appends a vertex. */
    pub fn push(mut self, p : DVec3, id : i32) : void {
        self.pts.push(p);
        self.ids.push(id);
    }

    /** How many vertices. */
    pub fn count(self) : i32 {
        return self.pts.len();
    }

    /**
     * Cuts `src` by the half space `(x - origin) . normal <= offset` and writes the result into this polygon
     * (which is cleared first). `plane` numbers the cutting plane for the ids of new vertices.
     */
    pub fn clipFrom(
        mut self,
        src : ClipPoly,
        origin : DVec3,
        normal : DVec3,
        offset : f64,
        plane : i32
    ) : void {
        self.clear();
        let n : i32 = src.count();
        if (n == 0) {
            return;
        }
        for (k of 0..n) {
            let a : DVec3 = src.pts.get(k);
            let ia : i32 = src.ids.get(k);
            let nextK : i32 = (k + 1) % n;
            let b : DVec3 = src.pts.get(nextK);
            let ib : i32 = src.ids.get(nextK);
            let da : f64 = a.minus(origin).dot(normal) - offset;
            let db : f64 = b.minus(origin).dot(normal) - offset;
            let inA : bool = da <= 0.0;
            let inB : bool = db <= 0.0;
            if (inA && inB) {
                self.push(b, ib);
            } else if (inA && !inB) {
                let t : f64 = da / (da - db);
                self.push(a.plus(b.minus(a).scale(t)), ClipPoly::cutId(ia, ib, plane));
            } else if (!inA && inB) {
                let t : f64 = da / (da - db);
                self.push(a.plus(b.minus(a).scale(t)), ClipPoly::cutId(ia, ib, plane));
                self.push(b, ib);
            }
        }
    }

    // The id of a vertex where the edge ia-ib crosses plane `plane`: a pure function of the three, so the same
    // configuration gives the same id next step.
    static fn cutId(ia : i32, ib : i32, plane : i32) : i32 {
        return CLIPPED_ID_BASE + ((ia * 5 + ib * 3 + plane + 1) & CLIPPED_ID_MASK);
    }
}

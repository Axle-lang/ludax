// joint_set — the joints of a world: what they connect and the solver's working values for each.
//
// A joint ties two bodies together at anchor points given in each body's own frame (or one body to a fixed
// point of the world). Three kinds exist: a ball-and-socket (the anchors coincide, rotation is free), a distance
// joint (the anchors stay a fixed length apart, a rigid rod) and a hinge (a ball-and-socket whose bodies may only
// turn about one shared axis, optionally between two angle limits). The accumulated impulses stay in the joint
// from step to step so the next step starts from them (warm starting).

use crate::core::collections::vec::Vec;
use crate::core::math::dmat3::DMat3;
use crate::core::math::dvec3::DVec3;

/** The kind number of a ball-and-socket joint: the anchors coincide, rotation is free. */
pub(crate) const JOINT_BALL_SOCKET : i8 = 0;

/** The kind number of a distance joint: the anchors stay a fixed length apart. */
pub(crate) const JOINT_DISTANCE : i8 = 1;

/** The kind number of a hinge joint: rotation about one shared axis, optionally limited. */
pub(crate) const JOINT_HINGE : i8 = 2;

/** `Joint.limitSide` when the hinge is inside its limits. */
pub(crate) const JOINT_LIMIT_NONE : i32 = 0;

/** `Joint.limitSide` when the hinge is at or below its lower limit. */
pub(crate) const JOINT_LIMIT_LOWER : i32 = -1;

/** `Joint.limitSide` when the hinge is at or above its upper limit. */
pub(crate) const JOINT_LIMIT_UPPER : i32 = 1;

/** One joint: its definition followed by the solver's per-step data. */
pub(crate) struct Joint {
    /** One of `JOINT_BALL_SOCKET`, `JOINT_DISTANCE` or `JOINT_HINGE`; the literal 0 is `JOINT_BALL_SOCKET`. */
    pub(crate) kind : i8 = 0;

    /** Slot of the first body; -1 anchors to the world. */
    pub(crate) a : i32 = -1;

    /** Slot of the second body; -1 anchors to the world. */
    pub(crate) b : i32 = -1;

    /** Whether the joint exists; removed joints stay in the list as holes so handles stay valid. */
    pub(crate) active : bool = true;

    /** Whether the two bodies may still collide with each other. */
    pub(crate) collide : bool = false;

    /** Anchor on body a in its frame (a world point when `a` is -1). */
    pub(crate) anchorA : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Anchor on body b in its frame (a world point when `b` is -1). */
    pub(crate) anchorB : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Hinge axis in body a's frame (the world frame when `a` is -1). */
    pub(crate) axisA : DVec3 = DVec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Hinge axis in body b's frame. */
    pub(crate) axisB : DVec3 = DVec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** A direction perpendicular to the hinge axis in body a's frame: the zero of the hinge angle. */
    pub(crate) refA : DVec3 = DVec3 { x: 1.0, y: 0.0, z: 0.0 };

    /** The same direction in body b's frame. */
    pub(crate) refB : DVec3 = DVec3 { x: 1.0, y: 0.0, z: 0.0 };

    /** The rod length of a distance joint. */
    pub(crate) length : f64 = 1.0;

    /** Whether the hinge angle is limited. */
    pub(crate) limited : bool = false;

    /** The lowest hinge angle in radians. */
    pub(crate) lower : f64 = 0.0;

    /** The highest hinge angle in radians. */
    pub(crate) upper : f64 = 0.0;

    /** Offset from body a to its anchor, world axes (solver data). */
    pub(crate) rA : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Offset from body b to its anchor, world axes (solver data). */
    pub(crate) rB : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Inverse of the 3x3 effective mass of the point constraint (solver data). */
    pub(crate) kInv : DMat3 = DMat3 {};

    /** Velocity the point constraint is driven to, correcting drift (solver data). */
    pub(crate) bias : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Accumulated impulse of the point or rod constraint. */
    pub(crate) lin : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Direction of a distance joint's rod (solver data). */
    pub(crate) rod : DVec3 = DVec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Effective mass of a distance joint (solver data). */
    pub(crate) rodMass : f64 = 0.0;

    /** The first hinge alignment direction (solver data). */
    pub(crate) t1 : DVec3 = DVec3 { x: 1.0, y: 0.0, z: 0.0 };

    /** The second hinge alignment direction (solver data). */
    pub(crate) t2 : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 1.0 };

    /** The hinge axis in the world (solver data). */
    pub(crate) axisW : DVec3 = DVec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Effective masses of the two alignment rows and the limit row (solver data). */
    pub(crate) mass1 : f64 = 0.0;

    /** See `mass1`. */
    pub(crate) mass2 : f64 = 0.0;

    /** See `mass1`. */
    pub(crate) massAxis : f64 = 0.0;

    /** Alignment correction speeds of the two rows (solver data). */
    pub(crate) bias1 : f64 = 0.0;

    /** See `bias1`. */
    pub(crate) bias2 : f64 = 0.0;

    /** Accumulated angular impulse of the first alignment row. */
    pub(crate) imp1 : f64 = 0.0;

    /** Accumulated angular impulse of the second alignment row. */
    pub(crate) imp2 : f64 = 0.0;

    /** Accumulated angular impulse of the limit row. */
    pub(crate) impLimit : f64 = 0.0;

    /** The current hinge angle (solver data). */
    pub(crate) angle : f64 = 0.0;

    /** Which limit is touched this step: `JOINT_LIMIT_LOWER`, `JOINT_LIMIT_UPPER` or `JOINT_LIMIT_NONE` (solver data). */
    pub(crate) limitSide : i32 = 0;

    /** Correction speed of the limit row (solver data). */
    pub(crate) limitBias : f64 = 0.0;

    /** Impulse the position pass has applied to the limit row so far this step (solver data). */
    pub(crate) limitPos : f64 = 0.0;
}

/** The joints of a world, in creation order; a joint's handle is its index. */
pub(crate) class JointSet {
    pub(crate) items : Vec<Joint>;

    /** An empty set. */
    constructor() {
        self.items = new Vec<Joint>();
    }

    /** Adds a joint and returns its handle. */
    pub(crate) fn add(mut self, joint : Joint) : i32 {
        self.items.push(joint);
        return self.items.len() - 1;
    }

    /** How many handles have been issued, including removed joints. */
    pub(crate) fn count(self) : i32 {
        return self.items.len();
    }

    /** Whether handle `h` names a joint that still exists. */
    pub(crate) fn has(self, h : i32) : bool {
        return self.items.has(h) && self.items.get(h).active;
    }
}

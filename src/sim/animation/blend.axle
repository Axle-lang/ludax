// blend — combining poses: crossfades, additive layers and per-bone masks.
//
// All three work bone by bone on local transforms. A blend of weight 0 returns the first pose and weight 1 the
// second *exactly* (the arithmetic is skipped, not merely close), so a crossfade starts and ends on the clips'
// own values with no residue. Rotations blend along the shortest arc, translations and scales straight.
//
// An additive layer adds the difference between a layer pose and its reference pose (the layer's "neutral",
// usually the first frame of the additive clip) on top of a base pose: translation and scale by subtraction,
// rotation as the turn that takes the reference to the layer, scaled by the weight.
//
// A `BoneMask` gives each bone its own weight factor: the upper body follows the aiming clip while the legs
// keep walking. Every blend function writes into `out`, which may be one of the inputs.

use std::ffi::runtime::panicMsg;

use crate::core::math::quat::Quat;
use crate::core::math::transform::Transform;
use crate::core::math::vec3::Vec3;
use crate::sim::animation::skeleton::{Skeleton, Pose};

/** A weight between 0 and 1 for every bone. */
pub class BoneMask {
    count   : i32;
    weights : f32[];

    /** A mask of `count` bones, all `weight`. */
    constructor(count : i32, weight : f32) {
        self.count = count;
        self.weights = malloc<f32>((count + 1) as i64);
        for (i of 0..(count + 1)) {
            self.weights[i] = weight;
        }
    }

    /** A mask that is `inside` for `root` and every bone below it, and `outside` for the others. */
    pub static fn subtree(skeleton : Skeleton, root : i32, inside : f32, outside : f32) : BoneMask {
        let mut mask : BoneMask = new BoneMask(skeleton.boneCount(), outside);
        for (i of 0..skeleton.boneCount()) {
            if (skeleton.isInSubtree(i, root)) {
                mask.weights[i] = inside;
            }
        }
        return mask;
    }

    /** How many bones the mask covers. */
    pub fn boneCount(self) : i32 {
        return self.count;
    }

    /** The weight of `bone`. */
    pub fn get(self, bone : i32) : f32 {
        self.check(bone);
        return self.weights[bone];
    }

    /** Sets the weight of `bone`, limited to `0..1`. */
    pub fn set(mut self, bone : i32, weight : f32) : void {
        self.check(bone);
        let mut w : f32 = weight;
        if (w < 0.0) {
            w = 0.0;
        }
        if (w > 1.0) {
            w = 1.0;
        }
        self.weights[bone] = w;
    }

    fn check(self, bone : i32) : void {
        if (bone < 0 || bone >= self.count) {
            panicMsg("BoneMask: bone index out of range");
        }
    }
}

/** Blends poses. */
pub class PoseBlend {
    /** `out` = `a` at weight 0, `b` at weight 1, the bone-wise blend between; weights are limited to 0..1. */
    pub static fn lerp(a : Pose, b : Pose, weight : f32, out : Pose) : void {
        PoseBlend::sameSize(a, b, out);
        for (i of 0..out.boneCount()) {
            out.set(i, PoseBlend::mix(a.get(i), b.get(i), weight));
        }
    }

    /** Like `lerp` with each bone's weight multiplied by its mask weight. */
    pub static fn lerpMasked(a : Pose, b : Pose, weight : f32, mask : BoneMask, out : Pose) : void {
        PoseBlend::sameSize(a, b, out);
        if (mask.boneCount() != out.boneCount()) {
            panicMsg("PoseBlend: mask size differs");
        }
        for (i of 0..out.boneCount()) {
            out.set(i, PoseBlend::mix(a.get(i), b.get(i), weight * mask.get(i)));
        }
    }

    /** `out` = `base` plus the difference of `layer` from `reference`, scaled by `weight`. */
    pub static fn addLayer(base : Pose, layer : Pose, reference : Pose, weight : f32, out : Pose) : void {
        PoseBlend::sameSize(base, layer, out);
        PoseBlend::sameSize(base, reference, out);
        for (i of 0..out.boneCount()) {
            out.set(i, PoseBlend::plus(base.get(i), layer.get(i), reference.get(i), weight));
        }
    }

    /** Like `addLayer` with each bone's weight multiplied by its mask weight. */
    pub static fn addLayerMasked(
        base : Pose,
        layer : Pose,
        reference : Pose,
        weight : f32,
        mask : BoneMask,
        out : Pose
    ) : void {
        PoseBlend::sameSize(base, layer, out);
        PoseBlend::sameSize(base, reference, out);
        if (mask.boneCount() != out.boneCount()) {
            panicMsg("PoseBlend: mask size differs");
        }
        for (i of 0..out.boneCount()) {
            out.set(i, PoseBlend::plus(base.get(i), layer.get(i), reference.get(i), weight * mask.get(i)));
        }
    }

    // The blend of two transforms with exact endpoints.
    static fn mix(a : Transform, b : Transform, weight : f32) : Transform {
        if (!(weight > 0.0)) {
            return a;
        }
        if (weight >= 1.0) {
            return b;
        }
        return a.lerp(b, weight);
    }

    static fn plus(base : Transform, layer : Transform, reference : Transform, weight : f32) : Transform {
        if (!(weight > 0.0)) {
            return base;
        }
        let shift : Vec3 = layer.translation.minus(reference.translation).scale(weight);
        let grow : Vec3 = layer.scale.minus(reference.scale).scale(weight);
        let turn : Quat = reference.rotation.conjugate().mul(layer.rotation);
        let part : Quat = Quat::identity().slerp(turn, weight);
        return Transform {
            translation: base.translation.plus(shift),
            rotation: base.rotation.mul(part).normalized(),
            scale: base.scale.plus(grow),
        };
    }

    static fn sameSize(a : Pose, b : Pose, out : Pose) : void {
        if (a.boneCount() != out.boneCount() || b.boneCount() != out.boneCount()) {
            panicMsg("PoseBlend: poses differ in size");
        }
    }
}

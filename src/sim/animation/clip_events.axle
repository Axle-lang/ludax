// clip_events — which event markers of a clip a stretch of playback crosses.
//
// Playback is described by an unwrapped clock: seconds since the clip started, growing without bound while it
// loops. The markers crossed between two clock readings `from` and `to` are those whose time falls in the
// half-open stretch `[from, to)`, counted in every repetition of a loop, so a marker fires exactly once per
// pass, also when one step spans the loop point or several whole loops. Half-open means a marker sitting on
// the reading where one step ends is reported by the next step, never twice and never lost; a marker at time 0
// is reported by the first step of a clip that starts at clock 0.
//
// A clip that does not loop stops at its length; a marker placed exactly at the length is reported by the step
// that reaches it. Steps backwards (`to <= from`) report nothing.

use std::ffi::runtime::panicMsg;

use crate::sim::animation::clip::AnimationClip;

/** A growing list of fired events (marker id and the clock time it fired at). */
pub class EventBuffer {
    count : i32 = 0;
    room  : i32;
    ids   : i32[];
    times : f64[];

    /** An empty buffer. */
    constructor() {
        self.room = 16;
        self.ids = malloc<i32>(16);
        self.times = malloc<f64>(16);
    }

    /** Forgets every event. */
    pub fn clear(mut self) : void {
        self.count = 0;
    }

    /** How many events are held. */
    pub fn len(self) : i32 {
        return self.count;
    }

    /** The marker id of event `i`, in the order the events fired. */
    pub fn idAt(self, i : i32) : i32 {
        self.check(i);
        return self.ids[i];
    }

    /** The clock time event `i` fired at. */
    pub fn timeAt(self, i : i32) : f64 {
        self.check(i);
        return self.times[i];
    }

    /** True when an event with marker `id` is held. */
    pub fn has(self, id : i32) : bool {
        for (i of 0..self.count) {
            if (self.ids[i] == id) {
                return true;
            }
        }
        return false;
    }

    /** How many held events carry marker `id`. */
    pub fn countOf(self, id : i32) : i32 {
        let mut n : i32 = 0;
        for (i of 0..self.count) {
            if (self.ids[i] == id) {
                n = n + 1;
            }
        }
        return n;
    }

    /** Appends an event. */
    pub fn push(mut self, id : i32, time : f64) : void {
        if (self.count >= self.room) {
            let room : i32 = self.room * 2;
            let mut ids : i32[] = malloc<i32>(room as i64);
            let mut times : f64[] = malloc<f64>(room as i64);
            for (i of 0..self.count) {
                ids[i] = self.ids[i];
                times[i] = self.times[i];
            }
            self.ids = ids;
            self.times = times;
            self.room = room;
        }
        self.ids[self.count] = id;
        self.times[self.count] = time;
        self.count = self.count + 1;
    }

    fn check(self, i : i32) : void {
        if (i < 0 || i >= self.count) {
            panicMsg("EventBuffer: index out of range");
        }
    }
}

/** Finds the markers of a clip that playback crossed. */
pub class ClipEvents {
    /** Appends to `out` every marker of `clip` crossed while the clock ran from `from` to `to`, in firing order. */
    pub static fn collect(clip : AnimationClip, from : f64, to : f64, out : EventBuffer) : void {
        let length : f64 = clip.duration() as f64;
        if (!(to > from) || !(length > 0.0) || clip.eventLen() == 0) {
            return;
        }
        if (!clip.isLooping()) {
            ClipEvents::collectOnce(clip, from, to, length, out);
            return;
        }
        let first : i64 = ClipEvents::floorDiv(from, length);
        let last : i64 = ClipEvents::floorDiv(to, length);
        let mut pass : i64 = first;
        while (pass <= last) {
            let base : f64 = (pass as f64) * length;
            for (i of 0..clip.eventLen()) {
                let at : f64 = base + (clip.eventTime(i) as f64);
                if (at >= from && at < to) {
                    out.push(clip.eventId(i), at);
                }
            }
            pass = pass + 1;
        }
    }

    // One pass, clamped at the end: the stretch [from, to) within 0..length, plus the end itself once reached.
    static fn collectOnce(
        clip : AnimationClip,
        from : f64,
        to : f64,
        length : f64,
        out : EventBuffer
    ) : void {
        if (from >= length) {
            return;
        }
        let reachedEnd : bool = to >= length;
        for (i of 0..clip.eventLen()) {
            let at : f64 = clip.eventTime(i) as f64;
            let inside : bool = at >= from && at < to;
            let atEnd : bool = reachedEnd && at >= length;
            if (inside || atEnd) {
                out.push(clip.eventId(i), at);
            }
        }
    }

    static fn floorDiv(a : f64, b : f64) : i64 {
        let q : i64 = (a / b) as i64;
        if ((q as f64) * b > a) {
            return q - 1;
        }
        return q;
    }
}

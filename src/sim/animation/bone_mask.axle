// bone_mask — a weight factor for every bone, to blend part of a skeleton.
//
// A `BoneMask` gives each bone its own weight factor: the upper body follows the aiming clip while the legs
// keep walking. `PoseBlend` multiplies a blend weight by it bone by bone.

use std::ffi::runtime::panicMsg;

use crate::core::math::scalar::clamp;
use crate::sim::animation::skeleton::Skeleton;

/** A weight between 0 and 1 for every bone. */
pub class BoneMask {
    count   : i32;
    weights : f32[];

    /** A mask of `count` bones, all `weight`. */
    constructor(count : i32, weight : f32) {
        self.count = count;
        self.weights = new f32[(count + 1) as i64];
        for (i of 0..(count + 1)) {
            self.weights[i] = weight;
        }
    }

    /** A mask that is `inside` for `root` and every bone below it, and `outside` for the others. */
    pub static fn subtree(skeleton : Skeleton, root : i32, inside : f32, outside : f32) : BoneMask {
        let mut mask : BoneMask = new BoneMask(skeleton.boneCount(), outside);
        for (i of 0..skeleton.boneCount()) {
            if (skeleton.isInSubtree(i, root)) {
                mask.weights[i] = inside;
            }
        }
        return mask;
    }

    /** How many bones the mask covers. */
    pub fn boneCount(self) : i32 {
        return self.count;
    }

    /** The weight of `bone`. */
    pub fn get(self, bone : i32) : f32 {
        self.check(bone);
        return self.weights[bone];
    }

    /** Sets the weight of `bone`, limited to `0..1`. */
    pub fn set(mut self, bone : i32, weight : f32) : void {
        self.check(bone);
        self.weights[bone] = clamp(weight, 0.0, 1.0);
    }

    fn check(self, bone : i32) : void {
        if (bone < 0 || bone >= self.count) {
            panicMsg("BoneMask: bone index out of range");
        }
    }
}

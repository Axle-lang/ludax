// track_math — the interpolation modes and the time arithmetic that vector tracks and rotation tracks share.
//
// `TrackInterp` says how a track fills the gaps between keys; `TrackMath` wraps clock time into a clip, finds the
// segment around a time by binary search, and weighs the two values and two tangents of a cubic (Hermite) segment.

use crate::core::math::scalar::clamp;

/** How a track fills the time between two keys. */
pub enum TrackInterpolation : i8 {
    /** The value of the key before the time holds until the next key. */
    Step = 0,
    /** A straight blend of the two keys around the time (a shortest-path slerp for rotations). */
    Linear = 1,
    /** A Hermite spline through the keys using the stored tangents. */
    Cubic = 2,

    /** The interpolation whose number is `code` (0 step, 1 linear, 2 cubic); anything else answers Linear. */
    pub static fn fromCode(code : i32) : TrackInterpolation {
        return match code {
            0 => TrackInterpolation::Step,
            2 => TrackInterpolation::Cubic,
            _ => TrackInterpolation::Linear,
        };
    }

    /** The number that stands for this interpolation in files. */
    pub fn code(self) : i32 {
        return self as i32;
    }
}

/** The weights of the two values and two tangents of a cubic segment. */
pub(crate) struct HermiteWeights {
    /** Weight of the value at the segment start. */
    pub(crate) valueA : f32 = 0.0;

    /** Weight of the out-tangent at the segment start (times the segment length). */
    pub(crate) tanA : f32 = 0.0;

    /** Weight of the value at the segment end. */
    pub(crate) valueB : f32 = 0.0;

    /** Weight of the in-tangent at the segment end (times the segment length). */
    pub(crate) tanB : f32 = 0.0;
}

/** Time arithmetic shared by tracks, clips and events. */
pub class TrackMath {
    /**
     * The time to sample a clip of length `duration` at when `t` seconds have passed. A looping clip wraps `t`
     * into `0..duration`; otherwise `t` clamps to `0..duration`. A clip of no length always answers 0.
     */
    pub static fn wrapTime(t : f32, duration : f32, looping : bool) : f32 {
        if (!(duration > 0.0)) {
            return 0.0;
        }
        if (!looping) {
            return clamp(t, 0.0, duration);
        }
        let turns : i64 = (t / duration) as i64;
        let mut r : f32 = t - (turns as f32) * duration;
        if (r < 0.0) {
            r = r + duration;
        }
        if (r >= duration) {
            r = 0.0;
        }
        return r;
    }

    /**
     * The index `k` of the last key with `times[k] <= t`, for `count >= 2` sorted keys and `t` inside
     * `times[0]..times[count-1]`; the result is at most `count - 2`, so `k + 1` always exists.
     */
    pub static fn segment(times : f32[], count : i32, t : f32) : i32 {
        let mut lo : i32 = 0;
        let mut hi : i32 = count - 1;
        while (hi - lo > 1) {
            let mid : i32 = (lo + hi) / 2;
            if (times[mid] <= t) {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        return lo;
    }

    /** `floor(a / b)` as a whole number for `b > 0`: the pass of a looping clock, also for a negative clock. */
    pub(crate) static fn floorDiv(a : f64, b : f64) : i64 {
        let q : i64 = (a / b) as i64;
        if ((q as f64) * b > a) {
            return q - 1;
        }
        return q;
    }

    /** The four Hermite weights of the parameter `s` in `0..1`. */
    pub(crate) static fn weights(s : f32) : HermiteWeights {
        let two : f32 = 2.0;
        let three : f32 = 3.0;
        let one : f32 = 1.0;
        let s2 : f32 = s * s;
        let s3 : f32 = s2 * s;
        return HermiteWeights {
            valueA: two * s3 - three * s2 + one,
            tanA: s3 - two * s2 + s,
            valueB: three * s2 - two * s3,
            tanB: s3 - s2,
        };
    }
}

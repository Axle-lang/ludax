// skinning — linear blend skinning on the CPU.
//
// Each vertex names up to four bones (`joints`, four indices per vertex) and how much each one pulls on it
// (`weights`, four floats per vertex). The skinned position is the weighted sum of the vertex run through each
// bone's skinning matrix (`Pose::skinMatrices`). Weights are normalised by their sum on the way, so authoring
// error in the fourth decimal does not shrink the mesh; a vertex whose weights are all zero stays where it was.
//
// Positions and normals are flat `f32` arrays, three floats per vertex. Normals use the upper 3x3 of the
// matrices, which is right for rotations and uniform scale; a non-uniform scale in the rig needs the inverse
// transpose, which this helper does not do. Normals come out unit length. For skinning on the GPU the same
// matrices go to the vertex shader; this helper serves tools, tests, picking and CPU-only builds.

use crate::core::math::mat3::Mat3;
use crate::core::math::mat4::Mat4;
use crate::core::math::vec3::Vec3;

// How many bones pull on one vertex; the joint and weight arrays hold this many entries per vertex.
const SKIN_INFLUENCES : i32 = 4;

/** Applies skinning matrices to vertex data. */
pub class Skinning {
    /**
     * Writes into `out` the skinned positions of `vertexCount` vertices read from `positions`. `joints` and
     * `weights` hold four entries per vertex; `matrices` is the pose's skinning matrices.
     */
    pub static fn skinPositions(
        matrices : Mat4[],
        joints : i32[],
        weights : f32[],
        positions : f32[],
        out : f32[],
        vertexCount : i32
    ) : void {
        for (v of 0..vertexCount) {
            let p : Vec3 = Skinning::vec3At(positions, v);
            let first : i32 = v * SKIN_INFLUENCES;
            let mut sum : f32 = 0.0;
            let mut acc : Vec3 = Vec3::zero();
            for (k of 0..SKIN_INFLUENCES) {
                let w : f32 = weights[first + k];
                if (w > 0.0) {
                    let moved : Vec3 = matrices[joints[first + k]].transformPoint(p);
                    acc = acc.plus(moved.scale(w));
                    sum = sum + w;
                }
            }

            let mut r : Vec3 = p;
            if (sum > 0.0) {
                let one : f32 = 1.0;
                r = acc.scale(one / sum);
            }
            Skinning::setVec3(out, v, r);
        }
    }

    /** Like `skinPositions` for directions: normals are rotated (not moved) and renormalised. */
    pub static fn skinNormals(
        matrices : Mat4[],
        joints : i32[],
        weights : f32[],
        normals : f32[],
        out : f32[],
        vertexCount : i32
    ) : void {
        for (v of 0..vertexCount) {
            let n : Vec3 = Skinning::vec3At(normals, v);
            let first : i32 = v * SKIN_INFLUENCES;
            let mut acc : Vec3 = Vec3::zero();
            let mut any : bool = false;
            for (k of 0..SKIN_INFLUENCES) {
                let w : f32 = weights[first + k];
                if (w > 0.0) {
                    let m : Mat3 = matrices[joints[first + k]].upper3x3();
                    acc = acc.plus(m.transform(n).scale(w));
                    any = true;
                }
            }

            let mut r : Vec3 = n;
            if (any) {
                r = acc.normalizedOr(n);
            }
            Skinning::setVec3(out, v, r);
        }
    }

    // Vertex `v` of a flat three-floats-per-vertex array.
    static fn vec3At(data : f32[], v : i32) : Vec3 {
        return Vec3 { x: data[v * 3], y: data[v * 3 + 1], z: data[v * 3 + 2] };
    }

    static fn setVec3(data : f32[], v : i32, value : Vec3) : void {
        data[v * 3] = value.x;
        data[v * 3 + 1] = value.y;
        data[v * 3 + 2] = value.z;
    }
}

// skeleton — the bone hierarchy of a rig: what never changes while it plays.
//
// A `Skeleton` is the part of a rig that never changes while it plays: bones in parent-before-child order (a
// bone's parent has a smaller index, so one pass over the array walks the tree), their names, the local bind
// transform of each and the inverse bind matrix that carries a vertex from model space into the bone's bind
// space. The `Pose` (pose.axle) is the part that changes.
//
// Plain data on purpose: nothing here depends on the glTF importer; an adapter fills a `Skeleton` with
// `addBone` and, when the file has its own inverse bind matrices, `setInverseBind`.

use std::ffi::runtime::panicMsg;

use crate::core::id::string_id::{StringId, StringInterner};
use crate::core::math::mat4::Mat4;
use crate::core::math::scalar::atLeastOne;
use crate::core::math::transform::Transform;

/** The bones of a rig, parent before child, with their bind pose and inverse bind matrices. */
pub class Skeleton {
    count       : i32 = 0;
    room        : i32;
    parents     : i32[];
    nameIds     : i32[];
    bind        : Transform[];
    bindModel   : Mat4[];
    inverseBind : Mat4[];
    interner    : StringInterner;

    /** An empty skeleton with room for `capacity` bones. */
    constructor(capacity : i32) {
        let room : i32 = atLeastOne(capacity);
        self.room = room;
        self.parents = new i32[room as i64];
        self.nameIds = new i32[room as i64];
        self.bind = new Transform[room as i64];
        self.bindModel = new Mat4[room as i64];
        self.inverseBind = new Mat4[room as i64];
        self.interner = new StringInterner();
    }

    /**
     * Adds a bone and returns its index. `parent` is -1 for a root, otherwise the index of a bone added
     * earlier. Answers -1 and adds nothing when the parent is not an earlier bone, the name is already taken or
     * the capacity is used up. The inverse bind matrix is derived from the bind transforms.
     */
    pub fn addBone(mut self, name : string, parent : i32, bindLocal : Transform) : i32 {
        if (self.count >= self.room || parent >= self.count || parent < -1) {
            return -1;
        }
        if (!self.interner.find(name).isNone()) {
            return -1;
        }
        let i : i32 = self.count;
        self.parents[i] = parent;
        self.nameIds[i] = self.interner.intern(name).raw;
        self.bind[i] = bindLocal;
        let mut model : Mat4 = bindLocal.toMat4();
        if (parent >= 0) {
            model = self.bindModel[parent].mul(model);
        }
        self.bindModel[i] = model;
        self.inverseBind[i] = model.inverseAffine();
        self.count = self.count + 1;
        return i;
    }

    /** Replaces the inverse bind matrix of `bone` (a file's own matrices, which need not match the bind pose). */
    pub fn setInverseBind(mut self, bone : i32, m : Mat4) : void {
        self.check(bone);
        self.inverseBind[bone] = m;
    }

    /** How many bones there are. */
    pub fn boneCount(self) : i32 {
        return self.count;
    }

    /** The parent of `bone`, or -1 for a root. */
    pub fn parent(self, bone : i32) : i32 {
        self.check(bone);
        return self.parents[bone];
    }

    /** The name of `bone`, borrowed from the skeleton: copy it to keep it past the skeleton. */
    pub fn name(self, bone : i32) : string {
        self.check(bone);
        return self.interner.name(StringId { raw: self.nameIds[bone] });
    }

    /** The index of the bone called `name`, or -1. */
    pub fn find(self, name : string) : i32 {
        let id : StringId = self.interner.find(name);
        if (id.isNone()) {
            return -1;
        }
        // Bones are interned in index order, so the string id is the bone index.
        return id.raw;
    }

    /** The local bind transform of `bone`. */
    pub fn bindLocal(self, bone : i32) : Transform {
        self.check(bone);
        return self.bind[bone];
    }

    /** The matrix carrying model space into the bind space of `bone`. */
    pub fn inverseBindOf(self, bone : i32) : Mat4 {
        self.check(bone);
        return self.inverseBind[bone];
    }

    /** The model-space matrix of `bone` in the bind pose. */
    pub fn bindModelOf(self, bone : i32) : Mat4 {
        self.check(bone);
        return self.bindModel[bone];
    }

    /** True when `ancestor` is `bone` or one of the bones above it. */
    pub fn isInSubtree(self, bone : i32, ancestor : i32) : bool {
        let mut at : i32 = bone;
        while (at >= 0) {
            if (at == ancestor) {
                return true;
            }
            at = self.parents[at];
        }
        return false;
    }

    fn check(self, bone : i32) : void {
        if (bone < 0 || bone >= self.count) {
            panicMsg("Skeleton: bone index out of range");
        }
    }
}

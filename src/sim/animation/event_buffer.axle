// event_buffer — the growing list of events a stretch of playback fired.
//
// Filled by `ClipEvents::collect` and read by whoever reacts to footsteps, hits and other markers; each entry is a
// marker id and the clock time it fired at.

use std::ffi::runtime::panicMsg;

// The room an event buffer starts with; it doubles when full.
const EVENT_BUFFER_START_ROOM : i32 = 16;

/** A growing list of fired events (marker id and the clock time it fired at). */
pub class EventBuffer {
    count : i32 = 0;
    room  : i32;
    ids   : i32[];
    times : f64[];

    /** An empty buffer. */
    constructor() {
        self.room = EVENT_BUFFER_START_ROOM;
        self.ids = new i32[EVENT_BUFFER_START_ROOM as i64];
        self.times = new f64[EVENT_BUFFER_START_ROOM as i64];
    }

    /** Forgets every event. */
    pub fn clear(mut self) : void {
        self.count = 0;
    }

    /** How many events are held. */
    pub fn len(self) : i32 {
        return self.count;
    }

    /** The marker id of event `i`, in the order the events fired. */
    pub fn idAt(self, i : i32) : i32 {
        self.check(i);
        return self.ids[i];
    }

    /** The clock time event `i` fired at. */
    pub fn timeAt(self, i : i32) : f64 {
        self.check(i);
        return self.times[i];
    }

    /** True when an event with marker `id` is held. */
    pub fn has(self, id : i32) : bool {
        for (i of 0..self.count) {
            if (self.ids[i] == id) {
                return true;
            }
        }
        return false;
    }

    /** How many held events carry marker `id`. */
    pub fn countOf(self, id : i32) : i32 {
        let mut n : i32 = 0;
        for (i of 0..self.count) {
            if (self.ids[i] == id) {
                n = n + 1;
            }
        }
        return n;
    }

    /** Appends an event. */
    pub fn push(mut self, id : i32, time : f64) : void {
        if (self.count >= self.room) {
            let room : i32 = self.room * 2;
            let mut ids : i32[] = new i32[room as i64];
            let mut times : f64[] = new f64[room as i64];
            for (i of 0..self.count) {
                ids[i] = self.ids[i];
                times[i] = self.times[i];
            }
            self.ids = ids;
            self.times = times;
            self.room = room;
        }
        self.ids[self.count] = id;
        self.times[self.count] = time;
        self.count = self.count + 1;
    }

    fn check(self, i : i32) : void {
        if (i < 0 || i >= self.count) {
            panicMsg("EventBuffer: index out of range");
        }
    }
}

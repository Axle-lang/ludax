// music_track — a long clip that loops, described as data.
//
// A `MusicTrack` names a clip already loaded in the engine, the loop region inside it (an intro before the loop
// start plays once; the region between the loop points repeats) and a level. `AudioEngine::playMusic` plays it
// on the music bus and crossfades from whatever music was playing before with an equal-power curve, so the
// summed loudness stays level through the change. The clip is held in memory, decoded: this is not disk streaming.

/** A looping piece of music: a clip, where its loop starts and ends, and how loud it plays. */
pub struct MusicTrack {
    /** Clip id from `AudioEngine::addClip`. */
    pub clip : i32 = 0;

    /** Frame where the repeating part begins. */
    pub loopStart : i32 = 0;

    /** Frame where the repeating part ends and jumps back to `loopStart`; 0 means the end of the clip. */
    pub loopEnd : i32 = 0;

    /** Linear level of the track. */
    pub gain : f32 = 1.0;

    /** A track that loops the whole of `clip`. */
    pub static fn forClip(clip : i32) : MusicTrack {
        let mut t : MusicTrack = MusicTrack {};
        t.clip = clip;
        return t;
    }
}

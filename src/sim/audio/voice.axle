// voice — one sound being played: a position in a clip and everything that shapes it.
//
// A voice walks through a clip at a step per output frame (pitch times the ratio of sample rates times Doppler),
// reading between frames by linear or Catmull-Rom cubic interpolation. It loops inside loop points, fades in and
// out, and for a 3D sound runs a one-pole low-pass whose cutoff the engine sets from distance. Gains are ramped
// across each block so a moving emitter does not click. A voice never touches a device or a clock: `mix` adds
// `n` frames of itself into a stereo buffer and says whether it is still going.

use crate::core::math::trig::sin;
use crate::core::math::vec3::Vec3;
use crate::data::audio::clip::AudioClip;
use crate::sim::audio::spatial::{AudioEmitter, AudioAttenuation};

/** How a voice reads between two stored frames. */
pub enum AudioInterp : i8 {
    /** Straight line between neighbours: cheap, slightly dull at high pitch. */
    Linear = 0,
    /** Catmull-Rom through four neighbours: smoother when pitch-shifting. */
    Cubic = 1,
}

/** Everything that describes a sound to play; start from `AudioPlay::forClip(clip)` and change what you need. */
pub struct AudioPlay {
    /** Clip id from `AudioEngine::addClip`. */
    pub clip : i32 = 0;

    /** Bus the voice plays on (`AUDIO_BUS_SFX` ...). */
    pub bus : i32 = 1;

    /** Linear gain. */
    pub gain : f32 = 1.0;

    /** Playback speed ratio; 2 is an octave up and half the duration. */
    pub pitch : f32 = 1.0;

    /** Repeat between the loop points instead of ending. */
    pub looping : bool = false;

    /** First frame of the loop region. */
    pub loopStart : i32 = 0;

    /** Frame where the loop jumps back; 0 or less means the end of the clip. */
    pub loopEnd : i32 = 0;

    /** Higher survives voice stealing longer. */
    pub priority : i32 = 0;

    /** Left-right position -1..1 for a non-3D sound. */
    pub pan : f32 = 0.0;

    /** Treat `emitter` as a place in the world. */
    pub spatial : bool = false;

    /** Seconds over which the sound fades in from silence. */
    pub fadeIn : f32 = 0.0;

    /** Fade with an equal-power curve (for crossfades) instead of a straight line. */
    pub equalPower : bool = false;

    /** How to read between frames. */
    pub interp : AudioInterp = AudioInterp::Linear;

    /** Frame to start from. */
    pub startFrame : i32 = 0;

    /** The world placement, used when `spatial` is true. */
    pub emitter : AudioEmitter = AudioEmitter {
        position: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        velocity: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        minDistance: 1.0,
        maxDistance: 50.0,
        rolloff: 1.0,
        model: AudioAttenuation::Inverse,
        doppler: 1.0,
    };

    /** A plain one-shot of clip `clip` on the sfx bus. */
    pub static fn forClip(clip : i32) : AudioPlay {
        let mut p : AudioPlay = AudioPlay {};
        p.clip = clip;
        return p;
    }
}

/** The state of one playing sound; owned and driven by the engine. */
pub class AudioVoice {
    live        : bool = false;
    paused      : bool = false;
    serial      : i32 = 0;
    order       : i64 = 0;
    clipId      : i32 = 0;
    busId       : i32 = 1;
    gain        : f32 = 1.0;
    pitch       : f32 = 1.0;
    looping     : bool = false;
    loopStart   : f64 = 0.0;
    loopEnd     : f64 = 0.0;
    priority    : i32 = 0;
    pan         : f32 = 0.0;
    spatial     : bool = false;
    emitter     : AudioEmitter;
    fadeInLen   : i64 = 0;
    equalPower  : bool = false;
    cubic       : bool = false;
    position    : f64 = 0.0;
    age         : i64 = 0;
    fadeOutLen  : i64 = 0;
    fadeOutLeft : i64 = 0;
    lowState    : f32 = 0.0;
    lastLeft    : f32 = 0.0;
    lastRight   : f32 = 0.0;
    primed      : bool = false;

    constructor() {
        self.emitter = AudioPlay::forClip(0).emitter;
    }

    /** True while the voice occupies its slot. */
    pub(crate) fn isLive(self) : bool {
        return self.live;
    }

    pub(crate) fn isPaused(self) : bool {
        return self.paused;
    }

    pub(crate) fn serialNumber(self) : i32 {
        return self.serial;
    }

    pub(crate) fn startOrder(self) : i64 {
        return self.order;
    }

    pub(crate) fn priorityOf(self) : i32 {
        return self.priority;
    }

    pub(crate) fn clipIdOf(self) : i32 {
        return self.clipId;
    }

    pub(crate) fn busOf(self) : i32 {
        return self.busId;
    }

    pub(crate) fn gainOf(self) : f32 {
        return self.gain;
    }

    pub(crate) fn isSpatial(self) : bool {
        return self.spatial;
    }

    pub(crate) fn isLooping(self) : bool {
        return self.looping;
    }

    pub(crate) fn panOf(self) : f32 {
        return self.pan;
    }

    pub(crate) fn pitchOf(self) : f32 {
        return self.pitch;
    }

    pub(crate) fn positionFrames(self) : f64 {
        return self.position;
    }

    pub(crate) fn emitterOf(self) : AudioEmitter {
        return self.emitter;
    }

    pub(crate) fn fadingOut(self) : bool {
        return self.fadeOutLen > 0;
    }

    /** Takes the slot for a new sound. `order` ranks age (smaller is older); `rate` is the engine's frame rate. */
    pub(crate) fn begin(
        mut self,
        p : AudioPlay,
        clip : AudioClip,
        serial : i32,
        order : i64,
        rate : i32
    ) : void {
        self.live = true;
        self.paused = false;
        self.serial = serial;
        self.order = order;
        self.clipId = p.clip;
        self.busId = p.bus;
        self.gain = p.gain;
        self.pitch = p.pitch;
        self.looping = p.looping;
        self.loopStart = p.loopStart as f64;
        self.loopEnd = p.loopEnd as f64;
        if (p.loopEnd <= 0 || p.loopEnd > clip.frames) {
            self.loopEnd = clip.frames as f64;
        }
        if (self.loopStart < 0.0) {
            self.loopStart = 0.0;
        }
        if (self.loopEnd - self.loopStart < 1.0) {
            self.looping = false;
        }
        self.priority = p.priority;
        self.pan = p.pan;
        self.spatial = p.spatial;
        self.emitter = p.emitter;
        self.fadeInLen = (p.fadeIn * rate as f32) as i64;
        self.equalPower = p.equalPower;
        self.cubic = p.interp == AudioInterp::Cubic;
        self.position = p.startFrame as f64;
        self.age = 0;
        self.fadeOutLen = 0;
        self.fadeOutLeft = 0;
        self.lowState = 0.0;
        self.primed = false;
    }

    /** Frees the slot at once. */
    pub(crate) fn kill(mut self) : void {
        self.live = false;
    }

    pub(crate) fn setPaused(mut self, on : bool) : void {
        self.paused = on;
    }

    pub(crate) fn setGain(mut self, g : f32) : void {
        self.gain = g;
    }

    pub(crate) fn setPitch(mut self, p : f32) : void {
        self.pitch = p;
    }

    pub(crate) fn setEmitter(mut self, e : AudioEmitter) : void {
        self.emitter = e;
    }

    /** Starts fading out over `frames` frames; the voice frees itself at the end. 0 stops it at once. */
    pub(crate) fn fadeOut(mut self, frames : i64) : void {
        if (frames <= 0) {
            self.live = false;
            return;
        }
        if (self.fadeOutLen > 0) {
            return;
        }
        self.fadeOutLen = frames;
        self.fadeOutLeft = frames;
    }

    // The frame to read for index `i`, folding indices past the loop end back into the loop; -1 means silence.
    fn fold(self, i : i32, frames : i32) : i32 {
        let mut k : i32 = i;
        if (self.looping) {
            let le : i32 = self.loopEnd as i32;
            let ls : i32 = self.loopStart as i32;
            if (k >= le) {
                k = ls + (k - ls) % (le - ls);
            }
        }
        if (k < 0) {
            k = 0;
        }
        if (k >= frames) {
            return -1;
        }
        return k;
    }

    // One channel of the clip at fractional position `pos`.
    fn read(self, clip : AudioClip, ch : i32, i0 : i32, t : f32) : f32 {
        let frames : i32 = clip.frames;
        let c : i32 = clip.channels;
        let ia : i32 = self.fold(i0, frames);
        let ib : i32 = self.fold(i0 + 1, frames);
        let mut p1 : f32 = 0.0;
        let mut p2 : f32 = 0.0;
        if (ia >= 0) {
            p1 = clip.samples[(ia * c + ch) as i64];
        }
        if (ib >= 0) {
            p2 = clip.samples[(ib * c + ch) as i64];
        }
        if (!self.cubic) {
            return p1 + (p2 - p1) * t;
        }
        let iz : i32 = self.fold(i0 - 1, frames);
        let id : i32 = self.fold(i0 + 2, frames);
        let mut p0 : f32 = p1;
        let mut p3 : f32 = p2;
        if (iz >= 0) {
            p0 = clip.samples[(iz * c + ch) as i64];
        }
        if (id >= 0) {
            p3 = clip.samples[(id * c + ch) as i64];
        }
        let half : f32 = 0.5;
        let a : f32 = p2 - p0;
        let b : f32 = p0 * (2.0 as f32) - p1 * (5.0 as f32) + p2 * (4.0 as f32) - p3;
        let d : f32 = (p1 - p2) * (3.0 as f32) + p3 - p0;
        return p1 + half * t * (a + t * (b + t * d));
    }

    /**
     * Adds `n` frames of this voice to the stereo buffer `out` starting at frame `at`. `gl` and `gr` are the final
     * left and right gains (they are ramped from the previous block's values); `step` is clip frames advanced per
     * output frame; `damp` is the one-pole coefficient (1 = no filtering). Returns false once the voice is over.
     */
    pub(crate) fn mix(
        mut self,
        clip : AudioClip,
        out : f32[],
        at : i32,
        n : i32,
        gl : f32,
        gr : f32,
        step : f64,
        damp : f32
    ) : bool {
        if (!self.primed) {
            self.lastLeft = gl;
            self.lastRight = gr;
            self.primed = true;
        }
        let c : i32 = clip.channels;
        let stereoPath : bool = c == 2 && !self.spatial;
        let inv : f32 = (1.0 as f32) / (c as f32);
        let quarterTurn : f32 = 1.5707964;
        let one : f32 = 1.0;
        let dl : f32 = (gl - self.lastLeft) / (n as f32);
        let dr : f32 = (gr - self.lastRight) / (n as f32);
        let mut curL : f32 = self.lastLeft;
        let mut curR : f32 = self.lastRight;
        let mut alive : bool = true;
        for (k of 0..n) {
            if (!self.looping && self.position >= clip.frames as f64) {
                alive = false;
                break;
            }
            let i0 : i32 = self.position as i32;
            let t : f32 = (self.position - i0 as f64) as f32;
            // Fade envelope.
            let mut env : f32 = one;
            if (self.fadeInLen > 0 && self.age < self.fadeInLen) {
                env = (self.age as f32) / (self.fadeInLen as f32);
                if (self.equalPower) {
                    env = sin(env * quarterTurn);
                }
            }
            if (self.fadeOutLen > 0) {
                let f : f32 = (self.fadeOutLeft as f32) / (self.fadeOutLen as f32);
                if (self.equalPower) {
                    env = env * sin(f * quarterTurn);
                } else {
                    env = env * f;
                }
            }
            curL = curL + dl;
            curR = curR + dr;
            if (stereoPath) {
                let l : f32 = self.read(clip, 0, i0, t);
                let r : f32 = self.read(clip, 1, i0, t);
                out[((at + k) * 2) as i64] = out[((at + k) * 2) as i64] + l * curL * env;
                out[((at + k) * 2 + 1) as i64] = out[((at + k) * 2 + 1) as i64] + r * curR * env;
            } else {
                let mut s : f32 = 0.0;
                for (ch of 0..c) {
                    s = s + self.read(clip, ch, i0, t);
                }
                s = s * inv;
                if (self.spatial) {
                    self.lowState = self.lowState + damp * (s - self.lowState);
                    s = self.lowState;
                }
                out[((at + k) * 2) as i64] = out[((at + k) * 2) as i64] + s * curL * env;
                out[((at + k) * 2 + 1) as i64] = out[((at + k) * 2 + 1) as i64] + s * curR * env;
            }
            self.position = self.position + step;
            if (self.looping && self.position >= self.loopEnd) {
                self.position = self.position - (self.loopEnd - self.loopStart);
            }
            self.age = self.age + 1;
            if (self.fadeOutLen > 0) {
                self.fadeOutLeft = self.fadeOutLeft - 1;
                if (self.fadeOutLeft <= 0) {
                    alive = false;
                    break;
                }
            }
        }
        self.lastLeft = gl;
        self.lastRight = gr;
        if (!alive) {
            self.live = false;
        }
        return alive;
    }
}

// synth_clips — ready-made clips built from the synth parts, so a game needs no audio files.
//
// Each function returns a mono `AudioClip` computed sample by sample from oscillators, envelopes and filters. The
// sounds are simple on purpose (a plain tone, a struck bell, a noise burst, a seamlessly looping pad) and are
// meant to be combined: `mixInto` lays one clip over another at a time offset, which is enough to write a
// jingle. `pad` snaps every partial to a whole number of cycles over its length, so the clip loops with no click.

use crate::core::math::scalar::TAU;
use crate::core::math::trig::sin;
use crate::core::rng::pcg32::Pcg32;
use crate::data::audio::clip::AudioClip;
use crate::sim::audio::audio_math::AudioMath;
use crate::sim::audio::synth::{SynthWave, SynthAdsr, SynthFilter, SynthReverb};

// Each builder draws noise from its own Pcg32 stream, so two sounds made from one seed do not share their noise.
const SYNTH_STREAM_TONE : u64 = 3;
const SYNTH_STREAM_NOISE : u64 = 5;

// A bell is the sum of BELL_PARTIALS decaying sines (ratios and amplitudes after a measured church bell: the
// ratios are not whole numbers, which is what makes it sound struck rather than sung). Partial k lives
// `seconds / (1 + k * BELL_DAMPING)` long, so the high ones die first; at the end of its life a partial is down
// by e^-BELL_FADE. A BELL_ONSET ramp softens the first samples so the strike does not click.
const BELL_PARTIALS : i32 = 5;
const BELL_DAMPING : f32 = 0.8;
const BELL_FADE : f32 = 5.0;
const BELL_ONSET : f32 = 0.003;
const BELL_PEAK : f32 = 0.8;

// A noise burst falls by e^-BURST_FADE over its length.
const BURST_FADE : f32 = 8.0;
const BURST_PEAK : f32 = 0.8;

// A pad is a root, a just major third (5/4) and a fifth (3/2); each note mixes a triangle with a sine, with a
// slow tremolo of PAD_TREMOLO_DEPTH at PAD_TREMOLO_CYCLES whole cycles per clip, so it loops.
const PAD_THIRD : f32 = 1.25;
const PAD_FIFTH : f32 = 1.5;
const PAD_NOTES : i32 = 3;
const PAD_TRIANGLE : f32 = 0.6;
const PAD_SINE : f32 = 0.4;
const PAD_TREMOLO_DEPTH : f32 = 0.25;
const PAD_TREMOLO_CYCLES : f32 = 2.0;
const PAD_PEAK : f32 = 0.5;

/** Builders for synthesised clips. */
pub class Synth {
    /** A note of `wave` at `hz`, shaped by `env` and released after `gate` seconds; its length is `env.length(gate)`. */
    pub static fn tone(
        wave : SynthWave,
        hz : f32,
        gate : f32,
        env : SynthAdsr,
        rate : i32,
        seed : u64
    ) : AudioClip {
        let frames : i32 = (env.length(gate) * (rate as f32)) as i32;
        let mut clip : AudioClip = new AudioClip(rate, 1, frames);
        let rng : Pcg32 = new Pcg32(seed, SYNTH_STREAM_TONE);
        let step : f64 = hz as f64 / rate as f64;
        let mut phase : f64 = 0.0;
        for (i of 0..frames) {
            let t : f32 = (i as f32) / (rate as f32);
            clip.samples[i as i64] = wave.sample(phase as f32, rng) * env.level(t, gate);
            phase = phase + step;
            phase = phase - ((phase as i64) as f64);
        }
        return clip;
    }

    /** A struck bell: inharmonic partials that each die away exponentially, the high ones first. Peak 0.8. */
    pub static fn bell(hz : f32, seconds : f32, rate : i32) : AudioClip {
        let frames : i32 = (seconds * (rate as f32)) as i32;
        let mut clip : AudioClip = new AudioClip(rate, 1, frames);
        let ratios : f32[] = Synth::bellRatios();
        let amps : f32[] = Synth::bellAmps();
        for (i of 0..frames) {
            let t : f32 = (i as f32) / (rate as f32);
            let mut s : f32 = 0.0;
            for (k of 0..BELL_PARTIALS) {
                let life : f32 = seconds / ((1.0 as f32) + (k as f32) * BELL_DAMPING);
                let fade : f32 = AudioMath::exp(-(BELL_FADE * t / life) as f64) as f32;
                s = s + amps[k as i64] * fade * sin(TAU * hz * ratios[k as i64] * t);
            }

            let mut onset : f32 = 1.0;
            if (t < BELL_ONSET) {
                onset = t / BELL_ONSET;
            }
            clip.samples[i as i64] = s * onset;
        }
        return clip.normalised(BELL_PEAK);
    }

    // Frequency of each bell partial as a multiple of the fundamental.
    static fn bellRatios() : f32[] {
        let mut ratios : f32[] = new f32[BELL_PARTIALS as i64];
        ratios[0] = 1.0;
        ratios[1] = 2.0;
        ratios[2] = 2.76;
        ratios[3] = 5.4;
        ratios[4] = 8.93;
        return ratios;
    }

    // Starting level of each bell partial.
    static fn bellAmps() : f32[] {
        let mut amps : f32[] = new f32[BELL_PARTIALS as i64];
        amps[0] = 1.0;
        amps[1] = 0.6;
        amps[2] = 0.45;
        amps[3] = 0.25;
        amps[4] = 0.12;
        return amps;
    }

    /** White noise through a low-pass at `cutoffHz`, decaying exponentially to near silence over `seconds`. Peak 0.8. */
    pub static fn noiseBurst(seconds : f32, cutoffHz : f32, rate : i32, seed : u64) : AudioClip {
        let frames : i32 = (seconds * (rate as f32)) as i32;
        let mut clip : AudioClip = new AudioClip(rate, 1, frames);
        let rng : Pcg32 = new Pcg32(seed, SYNTH_STREAM_NOISE);
        let lp : SynthFilter = new SynthFilter(cutoffHz, rate, false);
        for (i of 0..frames) {
            let t : f32 = (i as f32) / (rate as f32);
            let n : f32 = SynthWave::Noise.sample(0.0, rng);
            let fade : f32 = AudioMath::exp(-(BURST_FADE * t / seconds) as f64) as f32;
            clip.samples[i as i64] = lp.process(n) * fade;
        }
        return clip.normalised(BURST_PEAK);
    }

    /** A sustained chord (root, major third, fifth) whose partials fit a whole number of cycles in `seconds`, so it loops seamlessly. Peak 0.5. */
    pub static fn pad(rootHz : f32, seconds : f32, rate : i32) : AudioClip {
        let frames : i32 = (seconds * (rate as f32)) as i32;
        let clip : AudioClip = new AudioClip(rate, 1, frames);
        let mut notes : f32[] = new f32[PAD_NOTES as i64];
        notes[0] = rootHz;
        notes[1] = rootHz * PAD_THIRD;
        notes[2] = rootHz * PAD_FIFTH;
        let tri : Pcg32 = new Pcg32(1, 1);
        for (k of 0..PAD_NOTES) {
            Synth::addPadNote(clip, notes[k as i64], seconds, tri);
        }
        return clip.normalised(PAD_PEAK);
    }

    // Mixes one note of the pad into `clip`, its pitch snapped to a whole number of cycles over `seconds`, so the
    // end meets the start. `unused` stands in for the noise source `SynthWave::sample` takes; triangles draw none.
    static fn addPadNote(mut clip : AudioClip, hz : f32, seconds : f32, unused : Pcg32) : void {
        let whole : i64 = ((hz * seconds) as f64 + 0.5) as i64;
        let cycles : f64 = whole as f64;
        let snapped : f64 = cycles / seconds as f64;
        let frames : i32 = clip.frames;
        let rate : i32 = clip.rate;
        for (i of 0..frames) {
            let turns : f64 = snapped * (i as f64) / (rate as f64);
            let phase : f32 = AudioMath::fract(turns) as f32;
            let tremolo : f32 = (1.0 as f32)
                + PAD_TREMOLO_DEPTH * sin(TAU * PAD_TREMOLO_CYCLES * (i as f32) / (frames as f32));
            let tri : f32 = SynthWave::Triangle.sample(phase, unused);
            let sn : f32 = sin(TAU * phase);
            clip.samples[i as i64] = clip.samples[i as i64] + (tri * PAD_TRIANGLE + sn * PAD_SINE) * tremolo;
        }
    }

    /** Adds `src * gain` into `dest` starting at frame `atFrame`; anything past the end of `dest` is dropped. Both must be mono. */
    pub static fn mixInto(mut dest : AudioClip, src : AudioClip, atFrame : i32, gain : f32) : void {
        for (i of 0..src.frames) {
            let at : i32 = atFrame + i;
            if (at >= 0 && at < dest.frames) {
                dest.samples[at as i64] = dest.samples[at as i64] + src.samples[i as i64] * gain;
            }
        }
    }

    /** The clip through a reverb, lengthened by `tailSeconds` so the tail is not cut off. */
    pub static fn withReverb(
        clip : AudioClip,
        room : f32,
        damping : f32,
        wet : f32,
        tailSeconds : f32
    ) : AudioClip {
        let extra : i32 = (tailSeconds * (clip.rate as f32)) as i32;
        let mut out : AudioClip = new AudioClip(clip.rate, 1, clip.frames + extra);
        let rev : SynthReverb = new SynthReverb(clip.rate, room, damping, wet);
        for (i of 0..out.frames) {
            out.samples[i as i64] = rev.process(clip.get(i, 0));
        }
        return out;
    }
}

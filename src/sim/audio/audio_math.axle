// audio_math — the few scalar functions audio needs, computed the same way on every machine.
//
// exp, ln and pow from additions, multiplications and divisions only (the C library's versions may differ in the
// last bit between platforms and would break "render twice, get the same bytes" across machines). Accuracy is
// about 1e-12 relative in f64, far below what a 24-bit signal can show. Trigonometry comes from `core::math::trig`.

use crate::core::math::scalar::clampD;

/** ln(2). */
const AUDIO_MATH_LN2 : f64 = 0.6931471805599453;

// exp's argument is clamped to +-this, where e^x is still a finite f64; `ln` answers its negative for x <= 0.
const AUDIO_MATH_EXP_LIMIT : f64 = 700.0;

// Taylor terms of exp on the reduced argument |r| <= ln(2)/2, and of the atanh series of ln on m in 0.75..1.5:
// enough for 1e-12 relative error.
const AUDIO_MATH_EXP_TERMS : i32 = 16;
const AUDIO_MATH_LN_TERMS : i32 = 14;

// `ln` halves or doubles x until it lies in this range, where the series converges fast.
const AUDIO_MATH_LN_HIGH : f64 = 1.5;
const AUDIO_MATH_LN_LOW : f64 = 0.75;

/** Deterministic exp, ln, pow and small helpers for the audio code. */
pub class AudioMath {
    /** 2^k exactly for whole k in -1000..1000. */
    pub static fn pow2(k : i32) : f64 {
        let mut n : i32 = k;
        let mut base : f64 = 2.0;
        if (k < 0) {
            n = 0 - k;
            base = 0.5;
        }
        let mut r : f64 = 1.0;
        while (n > 0) {
            if ((n & 1) == 1) {
                r = r * base;
            }
            base = base * base;
            n = n >> 1;
        }
        return r;
    }

    /** e^x, with x limited to -700..700. */
    pub static fn exp(x : f64) : f64 {
        let v : f64 = clampD(x, -AUDIO_MATH_EXP_LIMIT, AUDIO_MATH_EXP_LIMIT);
        let scaled : f64 = v / AUDIO_MATH_LN2;
        let mut k : i32 = 0;
        if (scaled >= 0.0) {
            k = (scaled + 0.5) as i32;
        } else {
            k = 0 - ((0.0 - scaled + 0.5) as i32);
        }
        let r : f64 = v - (k as f64) * AUDIO_MATH_LN2;
        let mut term : f64 = 1.0;
        let mut sum : f64 = 1.0;
        for (i of 1..AUDIO_MATH_EXP_TERMS) {
            term = term * r / (i as f64);
            sum = sum + term;
        }
        return sum * AudioMath::pow2(k);
    }

    /** The natural logarithm; for x <= 0 the answer is -700 (a quiet floor instead of NaN). */
    pub static fn ln(x : f64) : f64 {
        if (!(x > 0.0)) {
            return -AUDIO_MATH_EXP_LIMIT;
        }
        let mut m : f64 = x;
        let mut e : i32 = 0;
        while (m > AUDIO_MATH_LN_HIGH) {
            m = m * 0.5;
            e = e + 1;
        }
        while (m < AUDIO_MATH_LN_LOW) {
            m = m * 2.0;
            e = e - 1;
        }
        let s : f64 = (m - 1.0) / (m + 1.0);
        let s2 : f64 = s * s;
        let mut term : f64 = s;
        let mut sum : f64 = 0.0;
        for (i of 0..AUDIO_MATH_LN_TERMS) {
            sum = sum + term / ((2 * i + 1) as f64);
            term = term * s2;
        }
        return 2.0 * sum + (e as f64) * AUDIO_MATH_LN2;
    }

    /** a^b for a > 0; 0 for a <= 0. */
    pub static fn pow(a : f64, b : f64) : f64 {
        if (!(a > 0.0)) {
            return 0.0;
        }
        return AudioMath::exp(b * AudioMath::ln(a));
    }

    /** The fractional part of a non-negative number (x minus its floor). */
    pub static fn fract(x : f64) : f64 {
        return x - ((x as i64) as f64);
    }
}

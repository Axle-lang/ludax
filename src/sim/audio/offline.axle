// offline — bouncing the engine's output to a WAV file.
//
// There is no device in this engine; the way to hear it is to render a stretch of time into a clip and write that
// as a WAV through `WavCodec`. This file is that last step, with the one piece of file I/O the audio code has.

use std::io::{FileOutputStream, FileOpenMode};

use crate::data::audio::clip::AudioClip;
use crate::data::audio::wav::{WavCodec, WavFile};

/** Writes rendered audio to disk. */
pub class AudioOffline {
    /** The clip as a WAV file at `path`: 16-bit PCM, or 32-bit float when `asFloat`. Returns "" on success, else why it failed. */
    pub static fn save(path : string, clip : AudioClip, asFloat : bool) : string {
        let mut file : WavFile = WavCodec::encode16(clip);
        if (asFloat) {
            file = WavCodec::encodeFloat(clip);
        }
        try {
            let out = new FileOutputStream(path, FileOpenMode::WRITE);
            out.writeBytes(file.bytes, 0, file.size as i64);
            out.close();
        } catch e : IOException {
            return "audio: cannot write " + path;
        }
        return "";
    }
}

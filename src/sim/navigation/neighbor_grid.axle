// neighbor_grid — find the agents near a point without comparing every pair.
//
// A uniform grid of buckets over the area agents move in. `rebuild` files every agent under the bucket its
// position falls in (positions outside the area are clamped to the border buckets); `gather` then visits only
// the buckets a search circle overlaps. Buckets are visited in row order and agents inside a bucket in index
// order, so the neighbours always come back in the same order for the same positions: steering sums them in
// that order and stays reproducible.
//
// This is the navigation code's own small structure, so the steering behaviours can be used without a world. A
// game that already keeps its agents in the world's spatial index can hand `Steering::separation` the
// positions that index returns instead.

use crate::core::math::scalar::maxI;

// The bucket width of a grid asked for a width that is not positive.
const NEIGHBOR_DEFAULT_CELL : f32 = 1.0;

// Agents a grid has room for before its first `rebuild` grows it.
const NEIGHBOR_ROOM : i32 = 16;

/** A bucket grid over agent positions. */
pub class NeighborGrid {
    minX   : f32;
    minY   : f32;
    cell   : f32;
    cols   : i32;
    rows   : i32;
    starts : i32[];
    items  : i32[];
    room   : i32;
    holds  : i32 = 0;

    /** A grid covering `width` x `height` units from (`minX`, `minY`) in buckets `cell` wide. */
    constructor(minX : f32, minY : f32, width : f32, height : f32, cell : f32) {
        let mut size : f32 = cell;
        if (!(size > 0.0)) {
            size = NEIGHBOR_DEFAULT_CELL;
        }
        self.minX = minX;
        self.minY = minY;
        self.cell = size;
        let c : i32 = maxI((width / size) as i32 + 1, 1);
        let r : i32 = maxI((height / size) as i32 + 1, 1);
        self.cols = c;
        self.rows = r;
        self.starts = new i32[(c * r + 1) as i64];
        self.room = NEIGHBOR_ROOM;
        self.items = new i32[NEIGHBOR_ROOM as i64];
        for (i of 0..(c * r + 1)) {
            self.starts[i] = 0;
        }
    }

    /** Files the `count` agents at (`xs[i]`, `ys[i]`), replacing the previous contents. */
    pub fn rebuild(mut self, xs : f32[], ys : f32[], count : i32) : void {
        let buckets : i32 = self.cols * self.rows;
        if (count > self.room) {
            self.room = count;
            self.items = new i32[count as i64];
        }
        for (b of 0..(buckets + 1)) {
            self.starts[b] = 0;
        }
        for (i of 0..count) {
            let b : i32 = self.bucketOf(xs[i], ys[i]);
            self.starts[b + 1] = self.starts[b + 1] + 1;
        }
        for (b of 0..buckets) {
            self.starts[b + 1] = self.starts[b + 1] + self.starts[b];
        }
        let mut fill : i32[] = new i32[(buckets + 1) as i64];
        for (b of 0..buckets) {
            fill[b] = self.starts[b];
        }
        for (i of 0..count) {
            let b : i32 = self.bucketOf(xs[i], ys[i]);
            self.items[fill[b]] = i;
            fill[b] = fill[b] + 1;
        }
        self.holds = count;
    }

    /** How many agents are filed. */
    pub fn count(self) : i32 {
        return self.holds;
    }

    /**
     * Writes into `out` the indices of agents filed in buckets that the circle of `radius` around (`x`, `y`)
     * overlaps (a superset of those within `radius`: check the distance), at most `capacity` of them. Returns how many.
     */
    pub fn gather(self, x : f32, y : f32, radius : f32, out : i32[], capacity : i32) : i32 {
        // Agents beyond the area sit in the border buckets, so a circle out there still looks in them.
        let c0 : i32 = self.axisBucket(x - radius, self.minX, self.cols);
        let c1 : i32 = self.axisBucket(x + radius, self.minX, self.cols);
        let r0 : i32 = self.axisBucket(y - radius, self.minY, self.rows);
        let r1 : i32 = self.axisBucket(y + radius, self.minY, self.rows);

        let mut n : i32 = 0;
        for (r of r0..(r1 + 1)) {
            for (c of c0..(c1 + 1)) {
                let b : i32 = r * self.cols + c;
                for (k of self.starts[b]..self.starts[b + 1]) {
                    if (n < capacity) {
                        out[n] = self.items[k];
                        n = n + 1;
                    }
                }
            }
        }
        return n;
    }

    fn bucketOf(self, x : f32, y : f32) : i32 {
        let c : i32 = self.axisBucket(x, self.minX, self.cols);
        let r : i32 = self.axisBucket(y, self.minY, self.rows);
        return r * self.cols + c;
    }

    // The bucket along one axis that coordinate `v` falls in, clamped to the border buckets (`count` of them from `min`).
    fn axisBucket(self, v : f32, min : f32, count : i32) : i32 {
        let mut b : i32 = 0;
        if (v > min) {
            b = ((v - min) / self.cell) as i32;
        }
        if (b >= count) {
            b = count - 1;
        }
        return b;
    }
}

// funnel — the funnel algorithm that straightens a corridor of portals into the shortest path.
//
// A* over a mesh finds the polygons to cross (a corridor) and the doorways between them (portals). The funnel
// algorithm (the "simple stupid funnel") then walks the portals keeping the narrowest cone of sight from the
// current corner, and whenever the cone closes it fixes a corner at the vertex that closed it. The result is
// the shortest path inside the corridor: a polyline whose bends are polygon vertices, never longer than any
// other route through the same portals (in particular, not longer than the line through their midpoints).
//
// Coordinates are a plane (x, y) with y up, so "left" is counter-clockwise: walking along +x, left is +y.

use std::ffi::runtime::panicMsg;

use crate::core::math::vec2::Vec2;
use crate::sim::navigation::nav_path::{NavPath, NAV_PATH_SAME};

// Numbers per portal in `Funnel::pull`'s array: left x, left y, right x, right y.
const FUNNEL_PORTAL_STRIDE : i32 = 4;

/** The funnel algorithm. */
pub class Funnel {
    /**
     * Pulls a straight path through `count` portals from `start` to `goal` into `out`. `portals` holds four
     * numbers per portal, in the order crossed: the left end's x and y, then the right end's, as seen walking
     * from the start towards the goal.
     */
    pub static fn pull(portals : f32[], count : i32, start : Vec2, goal : Vec2, out : NavPath) : void {
        out.push(start.x, start.y);
        let n : i32 = count + 2;
        let mut cone : FunnelCone = new FunnelCone(start);
        let stride : i32 = FUNNEL_PORTAL_STRIDE;
        let mut i : i32 = 1;
        while (i < n) {
            // Portal 0 is the start and portal n-1 the goal, both of zero width.
            let mut left : Vec2 = goal;
            let mut right : Vec2 = goal;
            if (i <= count) {
                let at : i32 = (i - 1) * stride;
                left = Vec2::make(portals[at], portals[at + 1]);
                right = Vec2::make(portals[at + 2], portals[at + 3]);
            }

            // Narrow the right side; when it crosses over the left, the left end is a corner.
            if (cone.areaRight(right) >= 0.0) {
                if (cone.rightIsApex() || cone.areaLeft(right) < 0.0) {
                    cone.right = right;
                    cone.rightIdx = i;
                } else {
                    out.push(cone.left.x, cone.left.y);
                    i = cone.restartAtLeft();
                    continue;
                }
            }

            // Narrow the left side; when it crosses over the right, the right end is a corner.
            if (cone.areaLeft(left) <= 0.0) {
                if (cone.leftIsApex() || cone.areaRight(left) > 0.0) {
                    cone.left = left;
                    cone.leftIdx = i;
                } else {
                    out.push(cone.right.x, cone.right.y);
                    i = cone.restartAtRight();
                    continue;
                }
            }
            i = i + 1;
        }
        out.push(goal.x, goal.y);
    }

    // Twice the signed area of the triangle (a, b, c): positive when c is left of the ray a -> b.
    pub(crate) static fn area(a : Vec2, b : Vec2, c : Vec2) : f32 {
        return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
    }

    // True when the two points are close enough to count as one.
    pub(crate) static fn same(a : Vec2, b : Vec2) : bool {
        let dx : f32 = a.x - b.x;
        let dy : f32 = a.y - b.y;
        return dx * dx + dy * dy <= NAV_PATH_SAME * NAV_PATH_SAME;
    }
}

// The cone of sight the funnel keeps: the corner it stands on (apex) and the two ends that bound what it sees,
// each with the index of the portal it came from.
class FunnelCone {
    pub(crate) apex     : Vec2;
    pub(crate) left     : Vec2;
    pub(crate) right    : Vec2;
    pub(crate) apexIdx  : i32 = 0;
    pub(crate) leftIdx  : i32 = 0;
    pub(crate) rightIdx : i32 = 0;

    constructor(start : Vec2) {
        self.apex = start;
        self.left = start;
        self.right = start;
    }

    // Twice the signed area of (apex, right end, point).
    pub(crate) fn areaRight(self, p : Vec2) : f32 {
        return Funnel::area(self.apex, self.right, p);
    }

    // Twice the signed area of (apex, left end, point).
    pub(crate) fn areaLeft(self, p : Vec2) : f32 {
        return Funnel::area(self.apex, self.left, p);
    }

    pub(crate) fn rightIsApex(self) : bool {
        return Funnel::same(self.apex, self.right);
    }

    pub(crate) fn leftIsApex(self) : bool {
        return Funnel::same(self.apex, self.left);
    }

    // Makes the left end the new apex and reopens the cone there; answers the portal index to resume from.
    pub(crate) fn restartAtLeft(mut self) : i32 {
        return self.restart(self.left, self.leftIdx);
    }

    // Makes the right end the new apex and reopens the cone there; answers the portal index to resume from.
    pub(crate) fn restartAtRight(mut self) : i32 {
        return self.restart(self.right, self.rightIdx);
    }

    pub(crate) fn restart(mut self, corner : Vec2, idx : i32) : i32 {
        self.apex = corner;
        self.left = corner;
        self.right = corner;
        self.apexIdx = idx;
        self.leftIdx = idx;
        self.rightIdx = idx;
        return idx + 1;
    }
}

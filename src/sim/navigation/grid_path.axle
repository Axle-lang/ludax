// grid_path — a route over grid cells, and line-of-sight smoothing of it.
//
// A path is a list of cells, start first. `GridPath::smoothed` pulls it straight: it keeps only the cells from
// which the next kept cell is in clear sight (`GridLine::clear`, exact integer arithmetic), giving the corners
// of an any-angle route over the same cells.

use std::ffi::runtime::panicMsg;

use crate::sim::navigation::grid_line::GridLine;
use crate::sim::navigation::grid_map::GridMap;

// Cells a path has room for before it first grows.
const GRID_PATH_ROOM : i32 = 16;

/** A route over grid cells, start first. */
pub class GridPath {
    pts   : i32[];
    room  : i32;
    count : i32 = 0;
    ok    : bool = false;
    total : i32 = 0;

    /** An empty path that found nothing. */
    constructor() {
        self.room = GRID_PATH_ROOM;
        self.pts = new i32[(GRID_PATH_ROOM * 2) as i64];
    }

    /** True when the finder reached the goal. */
    pub fn found(self) : bool {
        return self.ok;
    }

    /** How many cells the path lists. */
    pub fn len(self) : i32 {
        return self.count;
    }

    /** The column of cell `i`. */
    pub fn xAt(self, i : i32) : i32 {
        self.check(i);
        return self.pts[i * 2];
    }

    /** The row of cell `i`. */
    pub fn yAt(self, i : i32) : i32 {
        self.check(i);
        return self.pts[i * 2 + 1];
    }

    /** The total step cost in `NAV_STEP_ORTHO` units per plain orthogonal step (1000 = one step). */
    pub fn cost(self) : i32 {
        return self.total;
    }

    /** The length in cells of the polyline through the cell centres (diagonals count as the square root of two). */
    pub fn length(self) : f32 {
        let mut sum : f32 = 0.0;
        for (i of 1..self.count) {
            let dx : f32 = (self.pts[i * 2] - self.pts[i * 2 - 2]) as f32;
            let dy : f32 = (self.pts[i * 2 + 1] - self.pts[i * 2 - 1]) as f32;
            sum = sum + (dx * dx + dy * dy).sqrt();
        }
        return sum;
    }

    /** Appends a cell. */
    pub fn push(mut self, x : i32, y : i32) : void {
        if (self.count >= self.room) {
            let room : i32 = self.room * 2;
            let mut grown : i32[] = new i32[(room * 2) as i64];
            for (i of 0..(self.count * 2)) {
                grown[i] = self.pts[i];
            }
            self.pts = grown;
            self.room = room;
        }
        self.pts[self.count * 2] = x;
        self.pts[self.count * 2 + 1] = y;
        self.count = self.count + 1;
    }

    /** Marks the result as found or not, with its cost. */
    pub fn finish(mut self, found : bool, cost : i32) : void {
        self.ok = found;
        self.total = cost;
    }

    /**
     * The same route with every cell dropped that a straight line can skip: from each kept cell the farthest
     * later cell in clear sight on `map` is next. Never passes a cell dearer than the dearest one the original
     * path used between the two, so a detour round mud is not straightened through it.
     */
    pub fn smoothed(self, map : GridMap) : GridPath {
        let out : GridPath = new GridPath();
        out.finish(self.ok, self.total);
        if (self.count == 0) {
            return out;
        }
        out.push(self.pts[0], self.pts[1]);
        let mut anchor : i32 = 0;
        while (anchor < self.count - 1) {
            let best : i32 = self.farthestInSight(map, anchor);
            out.push(self.pts[best * 2], self.pts[best * 2 + 1]);
            anchor = best;
        }
        return out;
    }

    // The index of the farthest cell after `anchor` that the line from `anchor` reaches, at the dearest cost
    // the original path paid on the way; the next cell is always reachable, so it is the floor.
    fn farthestInSight(self, map : GridMap, anchor : i32) : i32 {
        let ax : i32 = self.pts[anchor * 2];
        let ay : i32 = self.pts[anchor * 2 + 1];
        let mut best : i32 = anchor + 1;
        let mut dearest : i32 = map.costAt(self.pts[best * 2], self.pts[best * 2 + 1]);
        for (j of (anchor + 2)..self.count) {
            let before : i32 = map.costAt(self.pts[(j - 1) * 2], self.pts[(j - 1) * 2 + 1]);
            let tx : i32 = self.pts[j * 2];
            let ty : i32 = self.pts[j * 2 + 1];
            let last : i32 = map.costAt(tx, ty);
            if (before > dearest) {
                dearest = before;
            }
            if (last > dearest) {
                dearest = last;
            }

            if (GridLine::clear(map, ax, ay, tx, ty, dearest)) {
                best = j;
            }
        }
        return best;
    }

    fn check(self, i : i32) : void {
        if (i < 0 || i >= self.count) {
            panicMsg("GridPath: index out of range");
        }
    }
}

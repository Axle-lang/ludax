// nav_path — the path a navigation mesh query returns.
//
// The corners of the straight route, start first, with the length of the corridor it was pulled from and the
// number of polygons crossed. `Funnel::pull` fills one.

use std::ffi::runtime::panicMsg;

// Points a path has room for before it first grows.
// Points closer than this are the same point.
pub(crate) const NAV_PATH_SAME : f32 = 0.000001;

const NAV_PATH_ROOM : i32 = 8;

/** A route over a navigation mesh: the corners of the straight path, start first. */
pub class NavPath {
    pts      : f32[];
    room     : i32;
    count    : i32 = 0;
    ok       : bool = false;
    corridor : f32 = 0.0;
    crossed  : i32 = 0;

    /** An empty path that found nothing. */
    constructor() {
        self.room = NAV_PATH_ROOM;
        self.pts = new f32[(NAV_PATH_ROOM * 2) as i64];
    }

    /** True when a route was found. */
    pub fn found(self) : bool {
        return self.ok;
    }

    /** How many points the path has (start, corners, goal). */
    pub fn len(self) : i32 {
        return self.count;
    }

    /** The x of point `i`. */
    pub fn xAt(self, i : i32) : f32 {
        self.check(i);
        return self.pts[i * 2];
    }

    /** The y of point `i`. */
    pub fn yAt(self, i : i32) : f32 {
        self.check(i);
        return self.pts[i * 2 + 1];
    }

    /** The length of the straight-pulled path. */
    pub fn length(self) : f32 {
        let mut sum : f32 = 0.0;
        for (i of 1..self.count) {
            let dx : f32 = self.pts[i * 2] - self.pts[i * 2 - 2];
            let dy : f32 = self.pts[i * 2 + 1] - self.pts[i * 2 - 1];
            sum = sum + (dx * dx + dy * dy).sqrt();
        }
        return sum;
    }

    /** The length of the polyline from the start through the midpoint of every portal to the goal: what A* minimised. */
    pub fn corridorLength(self) : f32 {
        return self.corridor;
    }

    /** How many polygons the route passes through. */
    pub fn polygonsCrossed(self) : i32 {
        return self.crossed;
    }

    /** Appends a point unless it repeats the last one. */
    pub fn push(mut self, x : f32, y : f32) : void {
        if (self.count > 0) {
            let dx : f32 = x - self.pts[self.count * 2 - 2];
            let dy : f32 = y - self.pts[self.count * 2 - 1];
            if (dx * dx + dy * dy <= NAV_PATH_SAME * NAV_PATH_SAME) {
                return;
            }
        }
        if (self.count >= self.room) {
            let room : i32 = self.room * 2;
            let mut grown : f32[] = new f32[(room * 2) as i64];
            for (i of 0..(self.count * 2)) {
                grown[i] = self.pts[i];
            }
            self.pts = grown;
            self.room = room;
        }
        self.pts[self.count * 2] = x;
        self.pts[self.count * 2 + 1] = y;
        self.count = self.count + 1;
    }

    /** Records the outcome of the query. */
    pub fn finish(mut self, found : bool, corridor : f32, crossed : i32) : void {
        self.ok = found;
        self.corridor = corridor;
        self.crossed = crossed;
    }

    fn check(self, i : i32) : void {
        if (i < 0 || i >= self.count) {
            panicMsg("NavPath: index out of range");
        }
    }
}

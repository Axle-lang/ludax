// fluid_ground — the one question the fluid simulation asks of the terrain: how high is the ground here?
//
// The fluid engine owns no terrain and imports nothing from the voxel or openworld modules: a game supplies
// its ground as heights it already has, either by baking them into the world's heightmap once
// (`FluidWorld.sampleGround`) or cell by cell (`FluidWorld.setGround`). The trait exists for the first form —
// a game with procedural or streamed terrain implements `heightAt` and lets the world sample it. Heights are
// in the same cell units as water levels, so a ground step of one unit is one column that the water must
// climb over.

/**
 * The height of the solid ground, in cell units, under a column. Must be a pure function of its arguments:
 * the world samples it once, then owns the numbers.
 */
pub trait FluidGround {
    /** Height of the ground under column (`x`, `z`). */
    fn heightAt(self, x : i32, z : i32) : f64;
}

/** A flat ground at one height: the library's own implementor, for tests and games with a simple floor. */
pub class FluidFlatGround : FluidGround {
    level : f64 = 0.0;

    /** A ground everywhere at `level`. */
    constructor(level : f64) {
        self.level = level;
    }

    /** The same height under every column. */
    pub fn heightAt(self, x : i32, z : i32) : f64 {
        return self.level;
    }
}

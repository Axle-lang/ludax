// fluid_particle — the particle vocabulary of a `FluidWorld`: what a game or a renderer reads of the water
// that left the heightfield.
//
// The column model cannot hold water above its surface, so water that is thrown or sprayed lives in two
// populations that a `FluidWorld` simulates next to the columns. They differ in physics, not in look:
// `Liquid` particles are a true fluid (position-based, see `fluid_liquid`) and `Spray` drops are small
// ballistic bodies with quadratic air drag. There is no vapour: nothing evaporates, every drop lands again.
// Positions are world coordinates in cell units: x and z are the column coordinates the heightfield uses
// (column (i, j) spans [i, i+1) x [j, j+1)), y is height in the units of ground height.
//
// Volume accounting (the invariant the tests hold): every `Liquid` and `Spray` particle carries the volume of
// its radius (`fluidParticleVolume`) and counts as airborne until it merges into the columns. So
// `totalVolume + liquid + spray` equals what the game put in minus what the drains took.
//
// The structs here are plain data for rendering and for the ledger; the engine's own storage is in `fluid_pool`.

use crate::core::math::dvec3::DVec3;

/** Which population a particle belongs to; the kind picks the physics and the renderer's look. */
pub enum FluidParticleKind : i8 {
    /** Part of a coherent body of water: dense, cohesive, simulated as a fluid with pressure. */
    Liquid = 0,

    /** A small drop that left the liquid core: ballistic, with air drag, and it lands back in the columns. */
    Spray = 1,
}

/** A particle for rendering: where it is, how it moves and how far through its life it is. */
pub struct FluidParticle {
    /** Position in world coordinates: x and z in column units, y the height. */
    pub position : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Velocity in cells per second. */
    pub velocity : DVec3 = DVec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Radius in cells. */
    pub radius : f64 = 0.0;

    /** Which population the particle belongs to. */
    pub kind : FluidParticleKind = FluidParticleKind::Liquid;

    /** Seconds since the particle was born. */
    pub age : f64 = 0.0;

    /** Remaining life as a fade; always 1, as no particle fades out any more (kept so readers keep compiling). */
    pub life : f64 = 1.0;
}

/** Four thirds of pi: the volume of a unit sphere. */
const FLUID_SPHERE : f64 = 4.18879020478639;

/**
 * The volume a particle of `kind` and `radius` carries, in cell units. A liquid particle is the cube of its
 * diameter (the cell of the lattice the solver packs it into); a spray drop is a sphere.
 */
pub fn fluidParticleVolume(kind : FluidParticleKind, radius : f64) : f64 {
    return match kind {
        FluidParticleKind::Liquid => 8.0 * radius * radius * radius,
        FluidParticleKind::Spray => FLUID_SPHERE * radius * radius * radius,
    };
}

/** The volume bookkeeping of the particle layer, in cell units; see the header for the invariant. */
pub struct FluidLedger {
    /** Volume carried by liquid particles in flight. */
    pub liquid : f64 = 0.0;

    /** Volume carried by spray drops in flight. */
    pub spray : f64 = 0.0;

    /** Total volume that has ever left the columns as particles (thrown, jetted, broken off crests). */
    pub emitted : f64 = 0.0;

    /** Total volume that has ever returned to the columns from particles. */
    pub landed : f64 = 0.0;

    /** Liquid plus spray: what is in the air and will return. */
    pub fn airborne(self) : f64 {
        return self.liquid + self.spray;
    }
}

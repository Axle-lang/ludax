// hydro_params — every number that shapes the shallow-water engine and its overfall particles.
//
// `HydroWorld` is the metric twin of the older cell-unit `FluidWorld`: lengths in metres, times in seconds,
// depths and discharges in SI units, so a game that already has a terrain in metres hands it over unchanged.
// The numbers are split by module, each with its own struct and documented default, so a game tunes
// `params.fall.curtainSpacing` without knowing how the grid scheme works:
//
//   HydroParams      the grid solver: gravity, bed roughness (Manning), eddy viscosity, the CFL number, the wet
//                    threshold, the rest threshold that lets calm water sleep, infiltration, threads;
//   HydroFallParams  the overfall: when a bed drop becomes a waterfall, how finely the curtain is sampled, when
//                    a falling body breaks into spray (Weber), the splash and the foam it leaves.
//
// Everything is f32: physical fields live in grid-local metres (see `hydro_grid`), where f32 keeps better than
// a millimetre over a kilometre. A parameter whose zero would be nonsense means "use the default"; `checked()`
// applies that, and the world only ever holds a checked copy.

/** The most dye tracers a world may carry. */
pub const HYDRO_TRACERS_MAX : i32 = 8;

/** How the water leaves a lip and what it does in the air and on landing: the overfall module. */
pub struct HydroFallParams {
    /** The most airborne particles (liquid and spray together) alive at once. 0 switches the overfall off:
     * water then crosses a drop through the grid scheme alone, as a fast chute instead of a falling curtain. */
    pub capacity : i32 = 100000;

    /** The smallest bed drop between two neighbouring cells, in metres, that is treated as a lip. Smaller steps
     * are left to the grid scheme, which handles slopes and weirs well. */
    pub dropThreshold : f32 = 1.5;

    /** The least steepness, rise over run, of a cliff spread over two or three cells (a drop of at least
     * `dropThreshold` in total): a cliff resampled onto a grid still launches a curtain, a gentle ramp does not. */
    pub cliffSlope : f32 = 1.0;

    /** The longest gap between two neighbouring particles of a falling curtain, in metres, measured along the
     * crest and (at the landing speed) along the fall. Smaller means a denser, costlier and more continuous
     * sheet: the particles per metre of crest alive at once are about `fallTime * landingSpeed / spacing^2`. */
    pub curtainSpacing : f32 = 0.5;

    /** The smallest discharge per metre of crest, in m2/s, that is worth particles; thinner trickles stay on
     * the grid (a lip carrying less simply dribbles over it). */
    pub minDischarge : f32 = 0.002;

    /** The smallest parcel of water, in cubic metres, one particle may carry: a trickle gathers volume until it
     * can make a drop of this size (a sphere of about 2 cm radius). */
    pub minParcel : f32 = 0.00004;

    /** The slowest a curtain may leave the lip, in m/s: water that creeps over a lip is still thrown clear of
     * the wall by a little. */
    pub minExitSpeed : f32 = 0.5;

    /** Density of the air, kg/m3, for drag and for the Weber number of a breaking body. */
    pub airDensity : f32 = 1.2;

    /** Density of the water, kg/m3. */
    pub waterDensity : f32 = 1000.0;

    /** Surface tension of the water-air interface, N/m. */
    pub surfaceTension : f32 = 0.072;

    /** Drag coefficient of a falling parcel (a sphere in turbulent flow). */
    pub dragCoefficient : f32 = 0.47;

    /** The gas Weber number `airDensity * speed^2 * diameter / surfaceTension` above which a body is unstable
     * and, given time, breaks in two. Eleven to twelve is the textbook threshold. */
    pub weberCritical : f32 = 12.0;

    /** The time a body must stay unstable before it breaks, in units of `diameter / speed * sqrt(waterDensity /
     * airDensity)`, the aerodynamic time scale. Five matches the bag breakup time of drop experiments. */
    pub breakupTime : f32 = 5.0;

    /** The radius, in metres, under which a drop no longer breaks (surface tension holds it together). */
    pub minRadius : f32 = 0.004;

    /** The speed, in m/s, above which a landing parcel throws a crown of spray; slower ones just merge. */
    pub splashSpeed : f32 = 3.0;

    /** The largest share of a landing parcel's volume a splash may throw back up. */
    pub splashShare : f32 = 0.35;

    /** Share of a landing parcel's horizontal momentum the water under it keeps; the rest is lost to the splash. */
    pub landingKick : f32 = 0.5;

    /** Foam added to the cell under a landing per unit of `speed * depth added` (m2/s); 1 is solid white. */
    pub foamGain : f32 = 0.35;

    /** Turbulence added to the cell under a landing per unit of `speed * depth added`. */
    pub turbulenceGain : f32 = 0.5;

    /** Seed of the serial randomness (breakup scatter, splash crowns). */
    pub seed : u64 = 20240607;

    /** The share of a hard-landing parcel's water that becomes aerated parcels (foam, froth at the base of a fall).
     * A plunging jet entrains air at a few percent of its volume (Chanson's measurements of plunge pools are of that
     * order); 4 % turns 12 m3/s of falling water into about 20 000 short-lived parcels alive at once, and 100 m3/s
     * into the cap. The water is taken from the landing parcel and goes back to the grid when the parcel dies, so
     * nothing is made or lost. 0 switches the emitter off. */
    pub aerationShare : f32 = 0.04;

    /** The landing speed, m/s, above which a parcel aerates the water it lands in (a kinetic-energy threshold). */
    pub aerationSpeed : f32 = 6.0;

    /** The most aerated parcels alive at once, on top of `capacity`; 0 switches the emitter off. */
    pub aerationCapacity : i32 = 150000;

    /** The water one aerated parcel carries, m3 (a drop of about 2 cm); what the parcel is drawn as is `radius`. */
    pub aerationParcel : f32 = 0.00005;

    /** The most aerated parcels one landing makes. */
    pub aerationPerLanding : i32 = 32;

    /** The most aerated parcels launched in one substep: the budget that bounds the cost of a big fall. */
    pub aerationPerStep : i32 = 60000;

    /** The density of the aerated water for air drag, kg/m3 (froth is a tenth of water): the parcels are braked
     * ten times harder than drops of the same size. */
    pub aerationDensity : f32 = 100.0;

    /** The mean life of an aerated parcel, s; each lives between half and one and a half times that. */
    pub aerationLife : f32 = 2.0;

    /** The radius range of an aerated parcel as drawn, m. */
    pub aerationRadiusMin : f32 = 0.1;
    pub aerationRadiusMax : f32 = 0.4;
}

/** The grid solver of the metric water engine. */
pub struct HydroParams {
    /** Gravity, m/s2: the grid scheme (wave speed, pressure) and the airborne particles fall under the same number. */
    pub gravity : f32 = 9.81;

    /** Manning roughness of the bed, s/m^(1/3): 0.03 is a clean natural channel, 0.012 smooth concrete, 0.1 a
     * weedy floodplain. 0 switches the bed friction off. Applied semi-implicitly, so it is stable at any depth. */
    pub manning : f32 = 0.03;

    /** Eddy viscosity of the flow, m2/s: the momentum diffusion that rounds off shear layers and keeps jets from
     * staying razor thin. Limited to the explicit stability bound of the grid. */
    pub viscosity : f32 = 0.05;

    /** The Courant number of one substep: `dt = cfl * cellSize / max(|u| + sqrt(g h))`. The unsplit scheme is
     * positive below one half; a quarter keeps a margin for the second-order reconstruction. */
    pub cfl : f32 = 0.25;

    /** The depth, in metres, under which a cell counts as dry: it keeps its water but carries no velocity. */
    pub dryDepth : f32 = 0.001;

    /** The speed, in m/s, under which a cell's momentum is dropped: it makes a calm lake stay exactly at rest
     * against the rounding noise of f32, and lets it sleep. Flows slower than this do not creep. */
    pub restSpeed : f32 = 0.00001;

    /** The relative depth jump between two neighbouring cells under which they count as level, for sleeping:
     * a tile whose speeds and jumps are all below the thresholds costs nothing until something wakes it. */
    pub restJump : f32 = 0.0001;

    /** A cap on the speed of the water, m/s: a guard against a runaway cell, far above anything physical here. */
    pub maxSpeed : f32 = 40.0;

    /** Water lost into the ground, in metres of depth per second, from every wet cell. 0 loses none. */
    pub infiltration : f32 = 0.0;

    /** The most substeps one `step` may take; time that does not fit is dropped and counted (`lostSeconds`). */
    pub maxSubsteps : i32 = 64;

    /** Worker threads of the solver; 1 runs on the calling thread. The state is bit-identical for any count. */
    pub threads : i32 = 1;

    /** Radius, in cells, over which an inflow spreads: 0 pours into one cell, 1 into the 3 x 3 block around it. */
    pub inflowRadius : i32 = 1;

    /** The most drifters (markers that ride the water, see `hydro_drifters`); 0 switches them off. About 1.6 kB each. */
    pub drifters : i32 = 2048;

    /** Simulated seconds between two samples of a drifter's trail. */
    pub trailInterval : f32 = 0.25;

    /** How much faster a floating marker moves than the depth-averaged flow: the surface layer of a turbulent
     * stream runs 1.15 to 1.3 times the mean (log-law profile); 1.0 disables it. */
    pub drifterSurfaceFactor : f32 = 1.2;

    /** The eddy-mixing coefficient of floating markers: each substep a marker is displaced by `sqrt(2 D dt) N(0,1)`
     * along x and along z, with `D = drifterDiffusion * h * (u* + turbulence * sqrt(g h))`, `u*` the friction
     * velocity of the Manning bed and `turbulence` the engine's 0..1 field; 0 disables it. */
    pub drifterDiffusion : f32 = 0.5;

    /** How many passive dye tracers the world carries (0 to `HYDRO_TRACERS_MAX`; 0 switches them off). Each is a
     * conservative scalar per cell, advected with the water, carried by particles and returned where they land;
     * they cost 12 bytes per cell each. */
    pub tracers : i32 = 4;

    /** The overfall module. */
    pub fall : HydroFallParams;

    /** The defaults of every module (a struct literal cannot nest the defaults of its members). */
    pub static fn standard() : HydroParams {
        return HydroParams { fall: HydroFallParams {} };
    }

    /** These parameters with every nonsensical value replaced by its default. */
    pub fn checked(self) : HydroParams {
        let mut p : HydroParams = HydroParams {
            gravity: self.gravity,
            manning: self.manning,
            viscosity: self.viscosity,
            cfl: self.cfl,
            dryDepth: self.dryDepth,
            restSpeed: self.restSpeed,
            restJump: self.restJump,
            maxSpeed: self.maxSpeed,
            infiltration: self.infiltration,
            maxSubsteps: self.maxSubsteps,
            threads: self.threads,
            inflowRadius: self.inflowRadius,
            tracers: self.tracers,
            drifters: self.drifters,
            trailInterval: self.trailInterval,
            drifterSurfaceFactor: self.drifterSurfaceFactor,
            drifterDiffusion: self.drifterDiffusion,
            fall: self.fall,
        };
        if (p.gravity <= 0.0) {
            p.gravity = 9.81;
        }
        if (p.manning < 0.0) {
            p.manning = 0.0;
        }
        if (p.viscosity < 0.0) {
            p.viscosity = 0.0;
        }
        if (p.cfl <= 0.0 || p.cfl > 0.45) {
            p.cfl = 0.25;
        }
        if (p.dryDepth <= 0.0) {
            p.dryDepth = 0.001;
        }
        if (p.restSpeed < 0.0) {
            p.restSpeed = 0.0;
        }
        if (p.restJump < 0.0) {
            p.restJump = 0.0;
        }
        if (p.maxSpeed <= 0.0) {
            p.maxSpeed = 40.0;
        }
        if (p.infiltration < 0.0) {
            p.infiltration = 0.0;
        }
        if (p.maxSubsteps < 1) {
            p.maxSubsteps = 1;
        }
        if (p.threads < 1) {
            p.threads = 1;
        }
        if (p.drifters < 0) {
            p.drifters = 0;
        }
        if (p.drifterSurfaceFactor < 0.0) {
            p.drifterSurfaceFactor = 0.0;
        }
        if (p.drifterDiffusion < 0.0) {
            p.drifterDiffusion = 0.0;
        }
        if (p.trailInterval <= 0.0) {
            p.trailInterval = 0.25;
        }
        if (p.tracers < 0) {
            p.tracers = 0;
        }
        if (p.tracers > HYDRO_TRACERS_MAX) {
            p.tracers = HYDRO_TRACERS_MAX;
        }
        if (p.inflowRadius < 0) {
            p.inflowRadius = 0;
        }
        let fall : HydroFallParams = HydroParams::checkedFall(self.fall);
        return HydroParams {
            gravity: p.gravity,
            manning: p.manning,
            viscosity: p.viscosity,
            cfl: p.cfl,
            dryDepth: p.dryDepth,
            restSpeed: p.restSpeed,
            restJump: p.restJump,
            maxSpeed: p.maxSpeed,
            infiltration: p.infiltration,
            maxSubsteps: p.maxSubsteps,
            threads: p.threads,
            inflowRadius: p.inflowRadius,
            tracers: p.tracers,
            drifters: p.drifters,
            trailInterval: p.trailInterval,
            drifterSurfaceFactor: p.drifterSurfaceFactor,
            drifterDiffusion: p.drifterDiffusion,
            fall: fall,
        };
    }

    static fn checkedFall(fall : HydroFallParams) : HydroFallParams {
        let mut f : HydroFallParams = fall;
        if (f.capacity < 0) {
            f.capacity = 0;
        }
        if (f.cliffSlope <= 0.0) {
            f.cliffSlope = 1.0;
        }
        if (f.dropThreshold <= 0.0) {
            f.dropThreshold = 1.5;
        }
        if (f.curtainSpacing <= 0.01) {
            f.curtainSpacing = 0.5;
        }
        if (f.minDischarge < 0.0) {
            f.minDischarge = 0.0;
        }
        if (f.minParcel <= 0.0) {
            f.minParcel = 0.00004;
        }
        if (f.minExitSpeed < 0.1) {
            f.minExitSpeed = 0.1;
        }
        if (f.airDensity <= 0.0) {
            f.airDensity = 1.2;
        }
        if (f.waterDensity <= 0.0) {
            f.waterDensity = 1000.0;
        }
        if (f.surfaceTension <= 0.0) {
            f.surfaceTension = 0.072;
        }
        if (f.dragCoefficient < 0.0) {
            f.dragCoefficient = 0.0;
        }
        if (f.weberCritical <= 0.0) {
            f.weberCritical = 12.0;
        }
        if (f.breakupTime <= 0.0) {
            f.breakupTime = 5.0;
        }
        if (f.minRadius <= 0.0) {
            f.minRadius = 0.004;
        }
        if (f.splashSpeed <= 0.0) {
            f.splashSpeed = 3.0;
        }
        if (f.splashShare < 0.0 || f.splashShare > 0.9) {
            f.splashShare = 0.35;
        }
        if (f.landingKick < 0.0 || f.landingKick > 1.0) {
            f.landingKick = 0.5;
        }
        if (f.foamGain < 0.0) {
            f.foamGain = 0.0;
        }
        if (f.turbulenceGain < 0.0) {
            f.turbulenceGain = 0.0;
        }
        if (f.aerationShare < 0.0 || f.aerationShare > 0.5) {
            f.aerationShare = 0.04;
        }
        if (f.aerationSpeed <= 0.0) {
            f.aerationSpeed = 6.0;
        }
        if (f.aerationCapacity < 0) {
            f.aerationCapacity = 0;
        }
        if (f.aerationParcel <= 0.0) {
            f.aerationParcel = 0.00005;
        }
        if (f.aerationPerLanding < 1) {
            f.aerationPerLanding = 1;
        }
        if (f.aerationPerStep < 1) {
            f.aerationPerStep = 1;
        }
        if (f.aerationDensity <= 0.0) {
            f.aerationDensity = 100.0;
        }
        if (f.aerationLife <= 0.0) {
            f.aerationLife = 2.0;
        }
        if (f.aerationRadiusMin <= 0.0) {
            f.aerationRadiusMin = 0.1;
        }
        if (f.aerationRadiusMax < f.aerationRadiusMin) {
            f.aerationRadiusMax = f.aerationRadiusMin;
        }
        return f;
    }
}

// hydro_lips — overfalls: where the bed drops away and the water leaves it in a falling curtain.
//
// A heightfield cannot make a falling sheet of water. Where the bed drops by more than `dropThreshold` between
// two neighbouring cells (a lip: a cliff, a dam crest, an escarpment edge) and water leaves the higher cell over
// it, the grid scheme does not carry that water to the lower cell. Its flux across the lip is still computed
// (the hydrostatic reconstruction with a dry lower side is exactly the free-overfall outflow of the weir: the
// discharge settles at the critical value without any special-casing), the donor loses the water as usual, but
// the receiving cell is told nothing (`hydro_passes` stores the flux in the donor's view only). The water is
// instead accumulated here per lip and launched as particles:
//
//   discharge   `q`, the volume per second per metre of crest, is the mass flux of the face; over a substep the
//               lip passes `q * dt * cellSize` cubic metres, which are added to the lip's carry.
//   exit        the curtain leaves the crest at the critical speed `(g q)^(1/3)` of a free overfall (at least
//               `minExitSpeed`), at the elevation of the crest, normal to it, with the cell's own cross velocity.
//   spacing     particles are launched in layers. Along the crest, `ceil(cellSize / curtainSpacing)` per cell
//               at most, so no two neighbours are further apart than `curtainSpacing`. Along the fall, a layer
//               is launched every `curtainSpacing / landingSpeed` seconds, where the landing speed is
//               `sqrt(exit^2 + 2 g H)` for the fall height `H` found below the lip when the bed was loaded:
//               ballistic particles of one launch speed keep their time gap, so the gap in space grows with
//               the speed of the fall and is the spacing at the landing speed, the largest it ever gets.
//               A layer that is due several times in one substep is launched as several layers, each flown
//               for the time it has been due, so the curtain has no hole whatever the time step.
//   volume      each particle carries the volume its layer owes, `carry / (layers * across)`, rounded to f32;
//               what the rounding leaves stays in the carry, so the lip's books close exactly in f64. A trickle
//               waits until it can fill a parcel of `minParcel`; a lip passing less than `minDischarge` is not a
//               waterfall and its carry is poured straight into the cell below.
//   full pool   when the pool cannot take a layer the carry is poured into the cell below instead, with the
//               exit momentum: the water is never lost, it just falls without a curtain.
//
// Particles per metre of crest alive at once are about `fallTime * landingSpeed / spacing^2` (fall time `2H / ...`
// of the order `sqrt(2H / g)`): 100 to 300 for a 10 to 50 m fall at the default spacing of half a metre.

use crate::core::math::scalar::{max, maxI, min, minI};
use crate::sim::fluid::hydro_air::HydroAir;
use crate::sim::fluid::hydro_grid::{HYDRO_PAD, HydroGrid};
use crate::sim::fluid::hydro_params::{HYDRO_TRACERS_MAX, HydroFallParams};
use crate::sim::fluid::hydro_particles::{HYDRO_LIQUID, HydroParticles};
use crate::sim::fluid::hydro_passes::hydroCbrt;

/** The longest run of cells, along the flow, over which a drop is summed into one cliff. */
const HYDRO_CLIFF_RUN : i32 = 3;

/** The farthest, in cells, the fall height is traced below a lip. */
const HYDRO_TRACE : i32 = 32;

/** The most layers one substep may launch for one lip (a time step far longer than the layer period). */
const HYDRO_MAX_LAYERS : i32 = 8;

/** How far beyond the crest, as a share of a cell, a fresh particle starts, so it is clear of the lip cell. */
const HYDRO_CLEAR : f32 = 0.05;

/** One half, as an f32. */
const HYDRO_HALF_L : f32 = 0.5;

/** The lips of one world and their launch state. */
pub(crate) class HydroLips {
    /** How many lips there are. */
    pub(crate) count : i32 = 0;

    // Per lip: the face (stored at its high-index cell `face`), its cell, axis (0 normal to x, 1 to z), the
    // direction of the fall (+1 toward higher index), the fall height and the launch state.
    faces   : i32[];
    cellsX  : i32[];
    cellsZ  : i32[];
    axes    : u8[];
    dirs    : i8[];
    heights : f32[];
    carry   : f64[];

    // The dye each lip's carry holds, m3: tracer `t` of lip `n` at `n * tracers + t`; and a scratch for the shares.
    carryDye     : f64[];
    shareScratch : f32[];
    waited       : f32[];

    constructor() {
        self.faces = new i32[1];
        self.cellsX = new i32[1];
        self.cellsZ = new i32[1];
        self.axes = new u8[1];
        self.dirs = new i8[1];
        self.heights = new f32[1];
        self.carry = new f64[1];
        self.carryDye = new f64[1];
        self.shareScratch = new f32[(HYDRO_TRACERS_MAX + 1) as i64];
        self.waited = new f32[1];
    }

    // ---- detection ----

    /** Finds the lips of the bed (replacing the old ones) and marks their faces in the grid. */
    pub(crate) fn detect(mut self, g : Shared<HydroGrid>, threshold : f32, slope : f32) : void {
        for (i of 0..g.cells) {
            g.lipX[i as i64] = 0;
            g.lipZ[i as i64] = 0;
        }
        let mut found : i32 = 0;
        for (z of 0..g.depth) {
            for (x of 0..g.width) {
                let c : i32 = g.index(x, z);
                if (x > 0) {
                    found = found + HydroLips::mark(g, c, 1, threshold, slope, true);
                }
                if (z > 0) {
                    found = found + HydroLips::mark(g, c, g.pitch, threshold, slope, false);
                }
            }
        }

        let room : i64 = (found + 1) as i64;
        self.faces = new i32[room];
        self.cellsX = new i32[room];
        self.cellsZ = new i32[room];
        self.axes = new u8[room];
        self.dirs = new i8[room];
        self.heights = new f32[room];
        self.carry = new f64[room];
        self.carryDye = new f64[room * (g.tracers as i64) + 1];
        for (q of 0..room * (g.tracers as i64) + 1) {
            self.carryDye[q] = 0.0;
        }
        self.waited = new f32[room];

        let mut n : i32 = 0;
        for (z of 0..g.depth) {
            for (x of 0..g.width) {
                let c : i32 = g.index(x, z);
                if (g.lipX[c as i64] != 0) {
                    self.add(g, n, c, x, z, true);
                    n = n + 1;
                }
                if (g.lipZ[c as i64] != 0) {
                    self.add(g, n, c, x, z, false);
                    n = n + 1;
                }
            }
        }
        self.count = n;
    }

    // Flags the face between `c - step` and `c` when it is the lip of a cliff; 1 if it did. A cliff is a drop of
    // at least `threshold` metres in one cell, or over a short run of up to three cells that keeps descending
    // and is steep (`slope`, rise over run), so a cliff resampled onto a coarse grid is still found.
    static fn mark(
        g : Shared<HydroGrid>,
        c : i32,
        step : i32,
        threshold : f32,
        slope : f32,
        alongX : bool
    ) : i32 {
        let mut flag : i8 = 0;
        if (HydroLips::cliff(g, c - step, step, threshold, slope) > 0.0) {
            flag = 1;
        }
        if (HydroLips::cliff(g, c, -step, threshold, slope) > 0.0) {
            flag = -1;
        }
        if (flag == 0) {
            return 0;
        }
        if (alongX) {
            g.lipX[c as i64] = flag;
        } else {
            g.lipZ[c as i64] = flag;
        }
        return 1;
    }

    // The drop of the cliff that starts at cell `top` and descends toward `top + dir`, m; 0 when there is none.
    static fn cliff(g : Shared<HydroGrid>, top : i32, dir : i32, threshold : f32, slope : f32) : f32 {
        let start : f32 = g.bed[top as i64];
        let mut prev : f32 = start;
        let mut total : f32 = 0.0;
        let mut run : i32 = 0;
        for (k of 1..HYDRO_CLIFF_RUN + 1) {
            let next : f32 = g.bed[(top + k * dir) as i64];
            if (next >= prev) {
                break;
            }
            total = start - next;
            run = k;
            prev = next;
        }
        if (run == 0) {
            return 0.0;
        }
        if (run == 1) {
            if (total > threshold) {
                return total;
            }
            return 0.0;
        }
        if (total >= threshold && total >= slope * (run as f32) * g.cellSize) {
            return total;
        }
        return 0.0;
    }

    // Records lip number `n`, with the fall height traced below it.
    fn add(mut self, g : Shared<HydroGrid>, n : i32, c : i32, x : i32, z : i32, alongX : bool) : void {
        let i : i64 = n as i64;
        let mut flag : i8 = g.lipZ[c as i64];
        let mut step : i32 = g.pitch;
        self.axes[i] = 1;
        if (alongX) {
            flag = g.lipX[c as i64];
            step = 1;
            self.axes[i] = 0;
        }
        self.faces[i] = c;
        self.cellsX[i] = x;
        self.cellsZ[i] = z;
        self.dirs[i] = flag;
        self.carry[i] = 0.0;
        self.waited[i] = 0.0;

        // Trace the fall: from the donor, in the direction of the water, while the bed keeps dropping.
        let mut dir : i32 = 1;
        let mut donor : i32 = c - step;
        if (flag < 0) {
            dir = -1;
            donor = c;
        }
        let top : f32 = g.bed[donor as i64];
        let mut at : i32 = donor;
        let mut low : f32 = top;
        for (k of 0..HYDRO_TRACE) {
            let next : i32 = at + dir * step;
            let nx : i32 = next % g.pitch - HYDRO_PAD;
            let nz : i32 = next / g.pitch - HYDRO_PAD;
            if (!g.inside(nx, nz) || g.bed[next as i64] >= low) {
                break;
            }
            low = g.bed[next as i64];
            at = next;
        }
        self.heights[i] = top - low;
    }

    // ---- launch ----

    /** The volume waiting in the lips' carries, m3, summed in f64 in lip order (it is airborne water). */
    pub(crate) fn carried(self) : f64 {
        let mut sum : f64 = 0.0;
        for (n of 0..self.count) {
            sum = sum + self.carry[n as i64];
        }
        return sum;
    }

    /** The dye of tracer `t` waiting in the lips' carries, m3 (it is airborne dye). */
    pub(crate) fn carriedDye(self, t : i32, tracers : i32) : f64 {
        let mut sum : f64 = 0.0;
        for (n of 0..self.count) {
            sum = sum + self.carryDye[(n * tracers + t) as i64];
        }
        return sum;
    }

    /** Collects what the lips passed this substep and launches the layers that are due. */
    pub(crate) fn launch(
        mut self,
        air : Shared<HydroAir>,
        p : HydroFallParams,
        gravity : f32,
        dt : f32
    ) : void {
        let g : Shared<HydroGrid> = air.grid();
        for (n of 0..self.count) {
            let i : i64 = n as i64;
            let c : i32 = self.faces[i];
            let alongX : bool = self.axes[i] == 0;
            let tile : i64 = g.tileOf(self.cellsX[i], self.cellsZ[i]) as i64;
            if (g.tileRun[tile] == 0) {
                continue;
            }

            let mut step : i32 = g.pitch;
            if (alongX) {
                step = 1;
            }
            let falling : bool = self.dirs[i] > 0;
            let mut donor : i32 = c;
            let mut flux : f32 = 0.0;
            if (falling) {
                donor = c - step;
                flux = g.mLz[c as i64];
                if (alongX) {
                    flux = g.mLx[c as i64];
                }
            } else {
                flux = -g.mRz[c as i64];
                if (alongX) {
                    flux = -g.mRx[c as i64];
                }
            }
            let passed : f32 = max(flux, 0.0) * g.scale[donor as i64] * dt * g.cellSize;
            self.carry[i] = self.carry[i] + (passed as f64);
            for (t of 0..g.tracers) {
                let dyed : f32 = passed * g.conc[(t * g.cells + donor) as i64];
                self.carryDye[(n * g.tracers + t) as i64] = self.carryDye[(n * g.tracers + t) as i64]
                    + (dyed as f64);
            }
            self.waited[i] = self.waited[i] + dt;
            self.release(air, p, gravity, n);
        }
    }

    // Launches lip `n`'s layers if its carry and the time it waited allow, or pours a feeble one below.
    fn release(mut self, air : Shared<HydroAir>, p : HydroFallParams, gravity : f32, n : i32) : void {
        let i : i64 = n as i64;
        let g : Shared<HydroGrid> = air.grid();
        let carry : f64 = self.carry[i];
        if (carry <= 0.0) {
            self.waited[i] = 0.0;
            return;
        }

        let wait : f32 = self.waited[i];
        let crest : f32 = g.cellSize;
        let mean : f32 = (carry as f32) / (crest * max(wait, 0.000001));
        let exit : f32 = max(hydroCbrt(gravity * mean), p.minExitSpeed);
        let landing : f32 = (exit * exit + (2.0 as f32) * gravity * self.heights[i]).sqrt();
        let period : f32 = p.curtainSpacing / landing;
        if (wait < period) {
            return;
        }
        if (mean < p.minDischarge) {
            self.pourBelow(air, n, carry, exit);
            return;
        }
        if (carry < (p.minParcel as f64)) {
            return;
        }

        let layers : i32 = minI(maxI(((wait / period) + (0.999 as f32)) as i32, 1), HYDRO_MAX_LAYERS);
        let across : i32 = maxI(((crest / p.curtainSpacing) + (0.999 as f32)) as i32, 1);
        let most : i32 = maxI(((carry / (p.minParcel as f64)) as i32) / layers, 1);
        let each : i32 = minI(across, most);
        if (air.store.waterCount() + layers * each > air.store.capacity) {
            self.pourBelow(air, n, carry, exit);
            return;
        }
        self.launchLayers(air, n, layers, each, exit, mean);
    }

    // Launches `layers` layers of `each` particles across the crest, owing `carry / layers` each.
    fn launchLayers(
        mut self,
        air : Shared<HydroAir>,
        n : i32,
        layers : i32,
        each : i32,
        exit : f32,
        mean : f32
    ) : void {
        let i : i64 = n as i64;
        let g : Shared<HydroGrid> = air.grid();
        let store : HydroParticles = air.store;
        let alongX : bool = self.axes[i] == 0;
        let sign : f32 = hydroSign(self.dirs[i]);
        let c : i32 = self.faces[i];
        let cx : i32 = self.cellsX[i];
        let cz : i32 = self.cellsZ[i];
        let wait : f32 = self.waited[i];
        let share : f64 = self.carry[i] / ((layers * each) as f64);
        let volume : f32 = share as f32;
        let owed : f64 = hydroMaxF64(self.carry[i], 0.000000001);
        let mut shares : f32[] = self.shareScratch;
        for (t of 0..g.tracers) {
            let dyed : f64 = self.carryDye[(n * g.tracers + t) as i64];
            shares[t as i64] = min((dyed / owed) as f32, 1.0);
        }
        let dx : f32 = g.cellSize;
        let gravity : f32 = air.store.gravity;

        // Donor cell (the one that is higher) and its elevation, cross velocity and the nappe thickness.
        let mut donor : i32 = c;
        if (self.dirs[i] > 0) {
            donor = c - 1;
            if (!alongX) {
                donor = c - g.pitch;
            }
        }
        let crestY : f32 = g.bed[donor as i64] + HYDRO_HALF_L * min(mean / exit, g.h[donor as i64]);
        let mut cross : f32 = g.u[donor as i64];
        if (alongX) {
            cross = g.w[donor as i64];
        }

        for (layer of 0..layers) {
            // The layer was due at the middle of its share of the wait; it has flown since.
            let age : f32 = wait * ((1.0 as f32) - (((layer as f32) + HYDRO_HALF_L) / (layers as f32)));
            for (j of 0..each) {
                let along : f32 = ((j as f32) + HYDRO_HALF_L) / (each as f32);
                let mut x : f32 = 0.0;
                let mut z : f32 = 0.0;
                let mut vx : f32 = 0.0;
                let mut vz : f32 = 0.0;
                if (alongX) {
                    x = ((cx as f32) + sign * HYDRO_CLEAR) * dx + sign * exit * age;
                    z = ((cz as f32) + along) * dx + cross * age;
                    vx = sign * exit;
                    vz = cross;
                } else {
                    z = ((cz as f32) + sign * HYDRO_CLEAR) * dx + sign * exit * age;
                    x = ((cx as f32) + along) * dx + cross * age;
                    vz = sign * exit;
                    vx = cross;
                }
                let y : f32 = crestY - HYDRO_HALF_L * gravity * age * age;
                let added : bool = store.add(HYDRO_LIQUID, x, y, z, vx, -gravity * age, vz, volume);
                if (added) {
                    for (t of 0..g.tracers) {
                        store.setFraction(store.count - 1, t, shares[t as i64]);
                        self.carryDye[(n * g.tracers + t) as i64] = self.carryDye[(n * g.tracers + t) as i64]
                            - (shares[t as i64] as f64) * (volume as f64);
                    }
                }
                self.carry[i] = self.carry[i] - (volume as f64);
            }
        }
        self.waited[i] = 0.0;
    }

    // Pours lip `n`'s whole carry into the cell the water falls to, carrying the exit momentum.
    fn pourBelow(mut self, air : Shared<HydroAir>, n : i32, carry : f64, exit : f32) : void {
        let i : i64 = n as i64;
        let g : Shared<HydroGrid> = air.grid();
        let sign : f32 = hydroSign(self.dirs[i]);
        let mut x : i32 = self.cellsX[i];
        let mut z : i32 = self.cellsZ[i];
        if (self.dirs[i] < 0 && self.axes[i] == 0) {
            x = x - 1;
        }
        if (self.dirs[i] < 0 && self.axes[i] != 0) {
            z = z - 1;
        }
        air.pour(x, z, carry, sign * exit, self.axes[i] == 0, self.carryDye, n * g.tracers);
        for (t of 0..g.tracers) {
            self.carryDye[(n * g.tracers + t) as i64] = 0.0;
        }
        self.carry[i] = 0.0;

        self.waited[i] = 0.0;
    }
}

fn hydroSign(dir : i8) : f32 {
    if (dir < 0) {
        return -1.0;
    }
    return 1.0;
}

fn hydroMaxF64(a : f64, b : f64) : f64 {
    if (a > b) {
        return a;
    }
    return b;
}

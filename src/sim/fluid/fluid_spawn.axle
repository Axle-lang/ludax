// fluid_spawn — making particles, with the radius each population wants.
//
// Small functions that every phase which creates particles shares (the coupling when a drop splashes, the
// emission when a vent jets), so that how a spray drop is sized is decided once. A spawn answers false when the
// pool is full; the caller then keeps the volume where it was, so a full pool costs fidelity and never water.
// Randomness is the population's serial `Pcg32`, so the sequence of spawns, which is fixed by the order of the
// phases, fixes the numbers too.

use crate::core::math::dvec3::DVec3;
use crate::sim::fluid::fluid_particle_params::FluidSprayParams;
use crate::sim::fluid::fluid_pool::FluidPopulation;

/** The particle factories of a population, as static functions. */
pub(crate) class FluidSpawn {
    /** Adds one liquid particle at `at` moving at `velocity`; false when the liquid pool is full. */
    pub(crate) static fn liquid(pop : Shared<FluidPopulation>, at : DVec3, velocity : DVec3) : bool {
        return pop.liquid.add(at, velocity, pop.params.liquid.radius);
    }

    /** A spray radius drawn between the module's bounds, biased toward the small end (fine drops
     * outnumber big ones in real spray). */
    pub(crate) static fn sprayRadius(pop : Shared<FluidPopulation>) : f64 {
        let s : FluidSprayParams = pop.params.spray;
        let u : f64 = pop.rng.nextF64();
        return s.radiusMin + (s.radiusMax - s.radiusMin) * u * u;
    }

    /** Adds one spray drop of `radius`; false when the spray pool is full. */
    pub(crate) static fn spray(
        pop : Shared<FluidPopulation>,
        at : DVec3,
        velocity : DVec3,
        radius : f64
    ) : bool {
        return pop.spray.add(at, velocity, radius);
    }
}

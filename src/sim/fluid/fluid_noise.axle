// fluid_noise — deterministic randomness and small maths for code that runs on several threads.
//
// A parallel kernel cannot share a `Pcg32`: which thread draws first would decide who gets which number. The
// particle kernels therefore draw from a stateless hash of (seed, tick, particle, purpose), so a particle gets
// the same numbers whichever thread handles it and in whatever order. The serial phases (emission, landing)
// use a `Pcg32` of their own, drawn in a fixed particle order.
//
// No libm: the few transcendental needs (a cube root, a half-life decay) are
// small fixed-iteration routines, identical on every machine.

use crate::core::id::hash::{hashCombine, hashMix};
use crate::core::math::dvec2::DVec2;

/** 2^-53: maps the top 53 bits of a hash onto [0, 1). */
const FLUID_UNIT53 : f64 = 0.00000000000000011102230246251565;

/** Steps of the squaring that stands in for `exp`. */
const FLUID_DECAY_SQUARINGS : i32 = 6;

/** Natural log of 2, for half-lives. */
const FLUID_LN2 : f64 = 0.6931471805599453;

/** Hash-based random numbers and the small maths of the particle layer, as static functions. */
pub(crate) class FluidNoise {
    /** A uniform number in [0, 1) that depends only on its three keys. */
    pub(crate) static fn unit(seed : i64, a : i64, b : i64) : f64 {
        let h : i64 = hashMix(hashCombine(hashCombine(seed, a), b));
        return ((h >>> 11) as f64) * FLUID_UNIT53;
    }

    /** A uniform number in [-1, 1) that depends only on its three keys. */
    pub(crate) static fn signed(seed : i64, a : i64, b : i64) : f64 {
        return FluidNoise::unit(seed, a, b) * 2.0 - 1.0;
    }

    /** A random unit vector in the horizontal plane (x, z in a `DVec2`), by rejection from the square. */
    pub(crate) static fn disk(seed : i64, a : i64, b : i64) : DVec2 {
        for (k of 0..8) {
            let x : f64 = FluidNoise::signed(seed, a, b * 16 + (2 * k) as i64);
            let z : f64 = FluidNoise::signed(seed, a, b * 16 + (2 * k + 1) as i64);
            let len2 : f64 = x * x + z * z;
            if (len2 > 0.0001 && len2 <= 1.0) {
                return DVec2::make(x, z).scale(1.0 / len2.sqrt());
            }
        }
        return DVec2::make(1.0, 0.0);
    }

    /** The cube root of `v`; 0 for `v` at or below 0. Newton from a power-of-eight scaling, fixed steps. */
    pub(crate) static fn cbrt(v : f64) : f64 {
        if (v <= 0.0) {
            return 0.0;
        }
        let mut scaled : f64 = v;
        let mut factor : f64 = 1.0;
        while (scaled < 0.125) {
            scaled = scaled * 8.0;
            factor = factor * 0.5;
        }
        while (scaled > 8.0) {
            scaled = scaled * 0.125;
            factor = factor * 2.0;
        }

        let mut g : f64 = 1.0;
        for (k of 0..8) {
            g = (2.0 * g + scaled / (g * g)) / 3.0;
        }
        return g * factor;
    }

    /** The share left after `dt` seconds of decay with the given half-life: `0.5^(dt / half)`. */
    pub(crate) static fn decay(dt : f64, half : f64) : f64 {
        if (half <= 0.0) {
            return 0.0;
        }
        let n : f64 = 64.0;
        let x : f64 = FLUID_LN2 * dt / half / n;
        if (x >= 1.0) {
            return 0.0;
        }

        let mut r : f64 = 1.0 - x;
        for (k of 0..FLUID_DECAY_SQUARINGS) {
            r = r * r;
        }
        return r;
    }
}

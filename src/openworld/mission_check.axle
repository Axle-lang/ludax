// mission_check — the list of problems a mission book's validation found.
//
// `MissionBook::validate` finds what only the whole book can show (a missing stage, a prerequisite that does not
// exist, prerequisites that loop) and answers this report instead of stopping at the first: a text file with
// five mistakes should name all five. Each problem is a mission number (-1 for the book as a whole) and a
// message; the messages are interned so the report owns its strings and a caller may keep them after the book
// is gone.

use crate::core::collections::vec::Vec;
use crate::core::id::string_id::{StringId, StringInterner};

/** The problems `validate` found. */
pub class BookCheck {
    missions : Vec<i32>;
    texts    : Vec<i32>;
    words    : StringInterner;

    /** No problem. */
    constructor() {
        self.missions = new Vec<i32>();
        self.texts = new Vec<i32>();
        self.words = new StringInterner();
    }

    /** Records a problem with mission `mission` (-1: the book as a whole). */
    pub fn add(mut self, mission : i32, message : string) : void {
        self.missions.push(mission);
        self.texts.push(self.words.intern(message).raw);
    }

    /** How many problems. */
    pub fn count(self) : i32 {
        return self.missions.len();
    }

    /** True when there is none. */
    pub fn ok(self) : bool {
        return self.missions.len() == 0;
    }

    /** The mission problem `i` is about, or -1. */
    pub fn missionAt(self, i : i32) : i32 {
        return self.missions.get(i);
    }

    /** What is wrong in problem `i`. */
    pub fn messageAt(self, i : i32) : string {
        return self.words.name(StringId { raw: self.texts.get(i) }) + "";
    }
}

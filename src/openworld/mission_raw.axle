// mission_raw — the plain numbers of play state that the save format reads and writes.
//
// The board keeps its state in vectors; the save format wants it one mission and one objective at a time. These two
// structs are the hand-over, in a file of their own so that both sides can import them.

/** The raw play state of one mission. */
pub struct MissionRaw {
    /** The mission status code (see `MISSION_LOCKED` and friends in `mission_board`). */
    pub status : i32;

    /** The number of the open stage. */
    pub stage : i32;

    /** Nanoseconds the mission has been active. */
    pub elapsed : i64;

    /** Nanoseconds the open stage has been active. */
    pub inStage : i64;
}

/** The raw progress of one objective. */
pub struct ObjectiveRaw {
    /** How many kills or collects are counted so far. */
    pub count : i32;

    /** True when the objective is finished. */
    pub done : bool;
}

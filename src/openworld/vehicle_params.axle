// vehicle_params — what a car is made of, as numbers.
//
// The vehicle model (`vehicle_model`) is a pure function of these parameters, the previous `VehicleState`, the
// driver's `VehicleInput` and the ground. This file holds the parameters and the few closed-form questions a
// test or a tuner asks of them without simulating: how hard does the engine push the wheels in gear g at speed
// v, how hard does the air push back. Everything is SI (metres, kilograms, seconds, newtons, radians) and f64.
//
// The engine is a torque curve (a shoulder up to the peak, a fall to the redline) feeding a gearbox of fixed
// ratios and a final drive; the wheels turn that into a force at the road, which tyre grip then caps. It is an
// arcade model on purpose: believable numbers, a handful of knobs, no tyre lookup tables.

use crate::core::math::scalar::{absD, maxD};

// Radians per second to revolutions per minute: 60 / (2 pi).
pub(crate) const PARAMS_RAD_PER_SEC_TO_RPM : f64 = 9.549296585513721;

// Gravity, in metres per second squared: the rolling-resistance force and the model's weight use it.
pub(crate) const PARAMS_GRAVITY : f64 = 9.81;

// The torque curve: this share of peak torque at idle, rising to the peak and falling above it.
const PARAMS_TORQUE_AT_IDLE : f64 = 0.55;

// How much of the peak the curve loses from idle to the peak, and above it to the redline.
const PARAMS_TORQUE_FALL : f64 = 0.45;

// The gearbox can be given this many forward gears.
const PARAMS_MAX_GEARS : i32 = 8;

// The standard six-speed box: a short first for pulling away, an overdrive sixth for cruising.
const PARAMS_GEAR_1 : f64 = 3.6;
const PARAMS_GEAR_2 : f64 = 2.4;
const PARAMS_GEAR_3 : f64 = 1.7;
const PARAMS_GEAR_4 : f64 = 1.3;
const PARAMS_GEAR_5 : f64 = 1.0;
const PARAMS_GEAR_6 : f64 = 0.8;

// The dynamic pressure of moving air is half its density times speed squared; drag and downforce scale it.
const PARAMS_DYNAMIC_PRESSURE : f64 = 0.5;

/** The numbers that make one car. Build with `VehicleParams::arcade()` and change what you need. */
pub class VehicleParams {
    /** Mass in kilograms. */
    pub mass : f64 = 1200.0;

    /** Distance between the axles in metres. */
    pub wheelBase : f64 = 2.7;

    /** Half the distance between the left and right wheels, in metres. */
    pub halfTrack : f64 = 0.8;

    /** Wheel radius in metres. */
    pub wheelRadius : f64 = 0.33;

    /** The tallest steering angle at a standstill, in radians. */
    pub maxSteer : f64 = 0.55;

    /** The speed (m/s) at which the steering angle has halved: bigger means steering stays sharp longer. */
    pub steerSpeedRef : f64 = 20.0;

    /** How fast the wheels turn towards the commanded angle, radians per second. */
    pub steerRate : f64 = 3.0;

    /** Engine torque at the peak, in newton metres. */
    pub peakTorque : f64 = 320.0;

    /** Revolutions per minute at which the torque peaks. */
    pub peakRpm : f64 = 4500.0;

    /** Idle speed in rpm. */
    pub idleRpm : f64 = 900.0;

    /** The engine cuts power at this rpm. */
    pub redlineRpm : f64 = 7000.0;

    /** The rpm the clutch lets the engine hold when pulling away from rest. */
    pub launchRpm : f64 = 2800.0;

    /** Shift up above this rpm. */
    pub upshiftRpm : f64 = 6200.0;

    /** Shift down below this rpm. */
    pub downshiftRpm : f64 = 2400.0;

    /** Seconds without drive while the gearbox changes gear. */
    pub shiftTime : f64 = 0.25;

    /** Final drive ratio. */
    pub finalDrive : f64 = 3.7;

    /** Fraction of the engine's power that reaches the wheels. */
    pub driveEfficiency : f64 = 0.9;

    /** Reverse gear ratio (positive; the model reverses the sign). */
    pub reverseRatio : f64 = 3.4;

    /** The most speed, in m/s, the car reverses at (the drive is cut beyond it). */
    pub reverseMax : f64 = 8.0;

    /** Fraction of the weight on the driven wheels (the drive force cannot exceed their grip). */
    pub driveShare : f64 = 0.55;

    /** The most braking force, in newtons, before grip limits it. */
    pub brakeForce : f64 = 14000.0;

    /** Tyre friction coefficient on the ground. */
    pub grip : f64 = 1.05;

    /** Fraction of lateral grip left while the handbrake is on. */
    pub handbrakeGrip : f64 = 0.4;

    /** How hard sideways slip is pulled out, per second. */
    pub lateralStiffness : f64 = 10.0;

    /** How fast the yaw rate follows the steering, per second. */
    pub yawResponse : f64 = 10.0;

    /** Drag area: drag coefficient times frontal area, in square metres. */
    pub dragArea : f64 = 0.65;

    /** Downforce area: lift coefficient (downward) times area, in square metres. */
    pub downforceArea : f64 = 0.12;

    /** Rolling resistance coefficient. */
    pub rolling : f64 = 0.015;

    /** Air density in kilograms per cubic metre. */
    pub airDensity : f64 = 1.225;

    /** Spring stiffness per wheel, newtons per metre. */
    pub springK : f64 = 60000.0;

    /** Damping per wheel, newton seconds per metre. */
    pub damperC : f64 = 5000.0;

    /** Distance from a wheel's mount to the ground when the spring is fully extended, in metres. */
    pub restLength : f64 = 0.45;

    /** The closest a mount may come to the ground (the bump stop), in metres. */
    pub minGap : f64 = 0.12;

    /** Height of the centre of mass above the mounts' mean height, for weight transfer, in metres. */
    pub cgHeight : f64 = 0.5;

    /** Radius of gyration for pitch, metres. */
    pub pitchRadius : f64 = 1.2;

    /** Radius of gyration for roll, metres. */
    pub rollRadius : f64 = 0.7;

    /** Integration substeps per call of `step` (more is steadier on rough ground). */
    pub substeps : i32 = 2;

    gears     : f64[];
    gearTotal : i32 = 6;

    /** A mid-sized rear-drive car with a six-speed automatic. */
    constructor() {
        self.gears = new f64[PARAMS_MAX_GEARS as i64];
        self.gears[0] = PARAMS_GEAR_1;
        self.gears[1] = PARAMS_GEAR_2;
        self.gears[2] = PARAMS_GEAR_3;
        self.gears[3] = PARAMS_GEAR_4;
        self.gears[4] = PARAMS_GEAR_5;
        self.gears[5] = PARAMS_GEAR_6;

        // Gears past the sixth do not exist until `setGear` gives them a ratio.
        self.gears[6] = 0.0;
        self.gears[7] = 0.0;
    }

    /** The standard car. */
    pub static fn arcade() : VehicleParams {
        return new VehicleParams();
    }

    /** How many forward gears there are. */
    pub fn gearCount(self) : i32 {
        return self.gearTotal;
    }

    /** The ratio of forward gear `g` (1 to `gearCount`); 0 outside. */
    pub fn ratio(self, g : i32) : f64 {
        if (g < 1 || g > self.gearTotal) {
            return 0.0;
        }
        return self.gears[g - 1];
    }

    /** Sets the ratio of forward gear `g` (1 to 8; a new top gear extends the box); false for a bad gear or ratio. */
    pub fn setGear(mut self, g : i32, ratio : f64) : bool {
        if (g < 1 || g > PARAMS_MAX_GEARS || ratio <= 0.0) {
            return false;
        }
        self.gears[g - 1] = ratio;
        if (g > self.gearTotal) {
            self.gearTotal = g;
        }
        return true;
    }

    /** The torque (N m) the engine makes at `rpm` with the throttle wide open; 0 beyond the redline. */
    pub fn torqueAt(self, rpm : f64) : f64 {
        if (rpm >= self.redlineRpm) {
            return 0.0;
        }
        let r : f64 = maxD(rpm, self.idleRpm);
        if (r <= self.peakRpm) {
            let t : f64 = (r - self.idleRpm) / (self.peakRpm - self.idleRpm);
            return self.peakTorque * (PARAMS_TORQUE_AT_IDLE + PARAMS_TORQUE_FALL * t);
        }
        let t : f64 = (r - self.peakRpm) / (self.redlineRpm - self.peakRpm);
        return self.peakTorque * (1.0 - PARAMS_TORQUE_FALL * t * t);
    }

    /** The engine speed in rpm when the car moves at `speed` m/s in forward gear `g` (no clutch slip). */
    pub fn rpmAt(self, g : i32, speed : f64) : f64 {
        return absD(speed) / self.wheelRadius * self.ratio(g) * self.finalDrive * PARAMS_RAD_PER_SEC_TO_RPM;
    }

    /** The force at the road in forward gear `g` at `speed` m/s with the throttle fully open, before grip limits it. */
    pub fn engineForce(self, g : i32, speed : f64) : f64 {
        let rpm : f64 = self.rpmAt(g, speed);

        // Below the launch rpm the clutch slips: the engine is taken to run at the launch speed.
        let effective : f64 = maxD(rpm, self.launchRpm);
        let atWheels : f64 = self.torqueAt(effective) * self.ratio(g) * self.finalDrive
            * self.driveEfficiency;
        return atWheels / self.wheelRadius;
    }

    /** Air drag at `speed` m/s, in newtons (always positive). */
    pub fn dragForce(self, speed : f64) : f64 {
        return PARAMS_DYNAMIC_PRESSURE * self.airDensity * self.dragArea * speed * speed;
    }

    /** Downforce at `speed` m/s, in newtons. */
    pub fn downforce(self, speed : f64) : f64 {
        return PARAMS_DYNAMIC_PRESSURE * self.airDensity * self.downforceArea * speed * speed;
    }

    /** Rolling resistance on level ground, in newtons. */
    pub fn rollingForce(self) : f64 {
        return self.rolling * self.mass * PARAMS_GRAVITY;
    }
}

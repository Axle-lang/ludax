// mission_save — the play state of missions as bytes, and back.
//
// Layout: the tag `LXMS`, a version, the fingerprint of the definitions (8 bytes), the number of missions and
// of objectives, then for every mission its status, open stage and two clocks (nanoseconds, 8 bytes each),
// for every objective its count and done flag, the flags that are set (as word ids of the definitions), the
// rewards paid so far (word id and 8-byte total) and a CRC-32 of everything before it. All numbers are
// big-endian.
//
// Loading is all or nothing. Everything is read and checked — tag, version, checksum, that the fingerprint is
// the board's own (so a save from other definitions is refused, not misapplied), that counts match and that
// every status, stage and progress is possible — before the first field of the board is touched. Events waiting
// in the queue and unread notes are not saved: `update` first. Flags and rewards that no definition mentions
// are not saved either, since they cannot change anything.

use crate::core::collections::vec::Vec;
use crate::data::bytes::{ByteBuf, Crc32};
use crate::openworld::mission_board::{MISSION_FAILED, MISSION_LOCKED, MissionBoard};
use crate::openworld::mission_book::{BookObjective, MissionBook};
use crate::openworld::mission_raw::{MissionRaw, ObjectiveRaw};

// The format: tag, version, definitions fingerprint, then the two counts.
const SAVE_VERSION : i32 = 1;
const SAVE_TAG_BYTES : i32 = 4;
const SAVE_AT_VERSION : i32 = 4;
const SAVE_AT_FINGERPRINT : i32 = 8;
const SAVE_AT_MISSIONS : i32 = 16;
const SAVE_AT_OBJECTIVES : i32 = 20;
const SAVE_AT_BODY : i32 = 24;
const SAVE_COUNT_WORDS : i32 = 8;
const SAVE_CRC_BYTES : i32 = 4;

// A count word (the flags and the paid rewards each begin with one).
const SAVE_COUNT_WORD : i32 = 4;

// One mission record, one objective record, one flag word and one paid-reward record.
const SAVE_MISSION : i32 = 24;
const SAVE_OBJECTIVE : i32 = 8;
const SAVE_FLAG : i32 = 4;
const SAVE_PAID : i32 = 12;

// A 64-bit value is two big-endian words.
const SAVE_HALF : i32 = 32;
const SAVE_LOW_MASK : i64 = 4294967295;

/** The save format of `MissionBoard`. */
pub class MissionSave {
    static fn put64(out : ByteBuf, v : i64) : void {
        out.pushBe32((v >>> SAVE_HALF) as i32);
        out.pushBe32(v as i32);
    }

    static fn get64(b : ByteBuf, at : i32) : i64 {
        return ((b.be32(at) as i64) << SAVE_HALF) | ((b.be32(at + 4) as i64) & SAVE_LOW_MASK);
    }

    // A flag as the word the format stores.
    static fn bit(on : bool) : i32 {
        if (on) {
            return 1;
        }
        return 0;
    }

    /** The bytes of `board`'s play state. */
    pub static fn save(board : MissionBoard) : ByteBuf {
        let book : MissionBook = board.definitions();
        let missions : i32 = book.missionCount();
        let objectives : i32 = book.totalObjectives();
        let known : i32 = board.knownWords();
        let out : ByteBuf = new ByteBuf(256);
        out.pushText("LXMS");
        out.pushBe32(SAVE_VERSION);
        MissionSave::put64(out, board.fingerprintValue());
        out.pushBe32(missions);
        out.pushBe32(objectives);
        for (m of 0..missions) {
            let r : MissionRaw = board.rawMission(m);
            out.pushBe32(r.status);
            out.pushBe32(r.stage);
            MissionSave::put64(out, r.elapsed);
            MissionSave::put64(out, r.inStage);
        }
        for (o of 0..objectives) {
            let r : ObjectiveRaw = board.rawObjective(o);
            out.pushBe32(r.count);
            out.pushBe32(MissionSave::bit(r.done));
        }
        let mut flagCount : i32 = 0;
        for (w of 0..known) {
            if (board.isFlagWord(w)) {
                flagCount = flagCount + 1;
            }
        }
        out.pushBe32(flagCount);
        for (w of 0..known) {
            if (board.isFlagWord(w)) {
                out.pushBe32(w);
            }
        }
        let mut paidCount : i32 = 0;
        for (w of 0..known) {
            if (board.paidWord(w) >= 0) {
                paidCount = paidCount + 1;
            }
        }
        out.pushBe32(paidCount);
        for (w of 0..known) {
            if (board.paidWord(w) >= 0) {
                out.pushBe32(w);
                MissionSave::put64(out, board.paidWord(w));
            }
        }
        out.pushBe32(new Crc32().sum(out, 0, out.len()));
        return out;
    }

    /** Restores `board` from `b`. Answers "" on success, else what was wrong; on any problem the board is unchanged. */
    pub static fn load(board : MissionBoard, b : ByteBuf) : string {
        if (b.len() < SAVE_AT_BODY + SAVE_CRC_BYTES || !b.tagAt(0, "LXMS")) {
            return "not a mission save (wrong tag or too short)";
        }
        if (b.be32(SAVE_AT_VERSION) != SAVE_VERSION) {
            return "unsupported mission save version ${b.be32(SAVE_AT_VERSION)}";
        }
        let body : i32 = b.len() - 4;
        if (new Crc32().sum(b, 0, body) != b.be32(body)) {
            return "the mission save is damaged (checksum differs)";
        }
        if (MissionSave::get64(b, SAVE_AT_FINGERPRINT) != board.fingerprintValue()) {
            return "the mission save belongs to different mission definitions";
        }
        let book : MissionBook = board.definitions();
        let missions : i32 = book.missionCount();
        let objectives : i32 = book.totalObjectives();
        let known : i32 = board.knownWords();
        if (b.be32(SAVE_AT_MISSIONS) != missions || b.be32(SAVE_AT_OBJECTIVES) != objectives) {
            return "the mission save has a different number of missions or objectives";
        }
        if (body < SAVE_AT_BODY + missions * SAVE_MISSION + objectives * SAVE_OBJECTIVE + SAVE_COUNT_WORDS) {
            return "the mission save is too short";
        }
        let mut at : i32 = SAVE_AT_BODY;
        let raws : Vec<MissionRaw> = new Vec<MissionRaw>();
        for (m of 0..missions) {
            let r : MissionRaw = MissionRaw {
                status: b.be32(at),
                stage: b.be32(at + 4),
                elapsed: MissionSave::get64(b, at + 8),
                inStage: MissionSave::get64(b, at + 16),
            };
            at = at + SAVE_MISSION;
            if (r.status < MISSION_LOCKED || r.status > MISSION_FAILED) {
                return "mission ${m} has an impossible status";
            }
            if (r.stage < 0 || r.stage >= book.stageCount(m)) {
                return "mission ${m} has an impossible stage";
            }
            if (r.elapsed < 0 || r.inStage < 0) {
                return "mission ${m} has a negative clock";
            }
            raws.push(r);
        }
        let progress : Vec<ObjectiveRaw> = new Vec<ObjectiveRaw>();
        for (o of 0..objectives) {
            let c : i32 = b.be32(at);
            let d : i32 = b.be32(at + 4);
            at = at + SAVE_OBJECTIVE;
            let def : BookObjective = book.objectiveAt(o);
            if (c < 0 || c > def.target || (d != 0 && d != 1)) {
                return "objective ${o} has impossible progress";
            }
            progress.push(ObjectiveRaw { count: c, done: d == 1 });
        }
        let flagCount : i32 = b.be32(at);
        at = at + 4;
        if (flagCount < 0 || flagCount > known || at + flagCount * SAVE_FLAG + SAVE_COUNT_WORD > body) {
            return "the mission save has an impossible flag list";
        }
        let flagWords : Vec<i32> = new Vec<i32>();
        for (i of 0..flagCount) {
            let w : i32 = b.be32(at);
            at = at + SAVE_FLAG;
            if (w < 0 || w >= known) {
                return "the mission save names an unknown flag";
            }
            flagWords.push(w);
        }
        let paidCount : i32 = b.be32(at);
        at = at + 4;
        if (paidCount < 0 || paidCount > known || at + paidCount * SAVE_PAID != body) {
            return "the mission save has an impossible reward list";
        }
        let paidWords : Vec<i32> = new Vec<i32>();
        let paidAmounts : Vec<i64> = new Vec<i64>();
        for (i of 0..paidCount) {
            let w : i32 = b.be32(at);
            if (w < 0 || w >= known) {
                return "the mission save names an unknown reward";
            }
            let amount : i64 = MissionSave::get64(b, at + 4);
            if (amount < 0) {
                return "the mission save has a negative reward";
            }
            paidWords.push(w);
            paidAmounts.push(amount);
            at = at + SAVE_PAID;
        }
        board.clearLoose();
        for (m of 0..missions) {
            board.setRawMission(m, raws.get(m));
        }
        for (o of 0..objectives) {
            board.setRawObjective(o, progress.get(o));
        }
        for (i of 0..flagWords.len()) {
            board.setFlagWord(flagWords.get(i));
        }
        for (i of 0..paidWords.len()) {
            board.setPaidWord(paidWords.get(i), paidAmounts.get(i));
        }
        return "";
    }
}

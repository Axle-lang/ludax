// vehicle_state — a car at one instant, and what the driver asks of it.
//
// `VehicleState` is plain data: copy it, store it per tick, hash it. The model never keeps anything of its own,
// so a replay is a state plus a list of inputs. Axes: the car's heading `yaw` points along (cos yaw, sin yaw) in
// the horizontal (x, z) plane; `vf` is the speed along it (negative: reversing) and `vl` the sideways speed
// along (-sin yaw, cos yaw), so a drifting car has a `vl` the tyres are fighting. Positive steering and positive
// yaw rate turn towards that sideways direction.

use crate::core::math::trig::sqrtD;

/** What the driver is doing this step. */
pub struct VehicleInput {
    /** Accelerator, 0 (off) to 1 (flat out). */
    pub throttle : f64 = 0.0;

    /** Brake pedal, 0 to 1. */
    pub brake : f64 = 0.0;

    /** Steering wheel, -1 to 1 (positive turns towards positive yaw). */
    pub steer : f64 = 0.0;

    /** Reverse gear selected: the car reverses once it is nearly stopped. */
    pub reverse : bool = false;

    /** Handbrake: locks the back wheels' sideways grip down so the car can drift. */
    pub handbrake : bool = false;

    /** No pedals, wheel straight. */
    pub static fn idle() : VehicleInput {
        return VehicleInput { throttle: 0.0, brake: 0.0, steer: 0.0, reverse: false, handbrake: false };
    }
}

/** Everything that changes about a car from step to step. */
pub struct VehicleState {
    /** Position of the centre of mass: horizontal. */
    pub x : f64 = 0.0;

    /** Height of the centre of mass above sea level. */
    pub y : f64 = 0.0;

    /** Position of the centre of mass: horizontal. */
    pub z : f64 = 0.0;

    /** Heading in radians. */
    pub yaw : f64 = 0.0;

    /** Speed along the heading, m/s. */
    pub vf : f64 = 0.0;

    /** Speed sideways, m/s. */
    pub vl : f64 = 0.0;

    /** Vertical speed, m/s. */
    pub vy : f64 = 0.0;

    /** Turning rate, rad/s. */
    pub yawRate : f64 = 0.0;

    /** Nose-up tilt, radians. */
    pub pitch : f64 = 0.0;

    /** Right-side-up tilt, radians. */
    pub roll : f64 = 0.0;

    /** Change of pitch, rad/s. */
    pub pitchRate : f64 = 0.0;

    /** Change of roll, rad/s. */
    pub rollRate : f64 = 0.0;

    /** The angle the front wheels are turned to, radians. */
    pub steerAngle : f64 = 0.0;

    /** The gear: 1 and up forwards, -1 reverse. */
    pub gear : i32 = 1;

    /** Seconds left of the current gear change. */
    pub shiftLeft : f64 = 0.0;

    /** Engine speed in rpm. */
    pub rpm : f64 = 900.0;

    /** Sideways slip as the ratio |vl| / max(|vf|, 1). */
    pub slip : f64 = 0.0;

    /** True while the tyres were asked for more grip than they have. */
    pub sliding : bool = false;

    /** How many wheels touched the ground in the last step (0 to 4). */
    pub wheelsDown : i32 = 4;

    /** The speed over the ground, m/s (forward and sideways together). */
    pub fn groundSpeed(self) : f64 {
        return sqrtD(self.vf * self.vf + self.vl * self.vl);
    }
}

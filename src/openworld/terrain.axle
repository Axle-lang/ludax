// terrain — the one question the open world asks of the ground: how high is it here?
//
// Vehicles ride on it, streamed props stand on it, missions place waypoints on it. The openworld module does
// not own a terrain; the game supplies one by implementing `GroundHeight`, which is a function of the
// horizontal position alone (f64, so a position 100 km from the origin keeps its millimetres). The library
// ships two grounds, so tests and small games need nothing else.

use crate::core::math::scalar::{maxD, TAU_D};
use crate::core::math::trig::sinD;

/** The height of the ground, in metres, at a horizontal position. Must be a pure function of its arguments. */
pub trait GroundHeight {
    /** Height of the ground at (`x`, `z`). */
    fn heightAt(self, x : f64, z : f64) : f64;
}

// Each wave carries half the amplitude, so the two together stay within it.
const ROLL_WAVE_SHARE : f64 = 0.5;

// The second wave runs across the first, at this fraction of its frequency and with this phase.
const ROLL_CROSS_FREQUENCY : f64 = 0.7;
const ROLL_CROSS_PHASE : f64 = 1.3;

/** A flat plane at a fixed height. */
pub class FlatGround : GroundHeight {
    level : f64 = 0.0;

    /** A plane at height `level`. */
    constructor(level : f64) {
        self.level = level;
    }

    /** The same height everywhere. */
    pub fn heightAt(self, x : f64, z : f64) : f64 {
        return self.level;
    }
}

/** Gentle hills: two crossed sine waves, deterministic and smooth, for tests and demos. */
pub class RollingGround : GroundHeight {
    amplitude  : f64 = 1.0;
    wavelength : f64 = 100.0;

    /** Hills `amplitude` metres high whose crests are about `wavelength` metres apart. */
    constructor(amplitude : f64, wavelength : f64) {
        self.amplitude = amplitude;
        self.wavelength = maxD(wavelength, 1.0);
    }

    /** Height of the hills at (`x`, `z`). */
    pub fn heightAt(self, x : f64, z : f64) : f64 {
        let k : f64 = TAU_D / self.wavelength;
        let alongX : f64 = sinD(x * k);
        let alongZ : f64 = sinD(z * k * ROLL_CROSS_FREQUENCY + ROLL_CROSS_PHASE);
        return self.amplitude * (ROLL_WAVE_SHARE * alongX + ROLL_WAVE_SHARE * alongZ);
    }
}

// kinetic_dynamics — checks that the simulation obeys the physics it claims to.
//
// Each check compares a number with what mechanics says it should be: free fall against the discrete form of
// x = g t^2 / 2, the height of a bounce against the restitution coefficient, momentum against conservation, the
// sliding of a box on a slope against the friction angle atan(mu), a stack of boxes against rest.

use ludax::BodyDesc;
use ludax::Checks;
use ludax::DQuat;
use ludax::DVec3;
use ludax::EntityId;
use ludax::PhysicsSettings;
use ludax::PhysicsWorld;
use ludax::Shape;
use ludax::absD;
use ludax::cosD;
use ludax::sinD;

use crate::kinetic_shapes::{KIN_EDGE_TILT, KIN_LOOSE, KIN_TIGHT};

// The gravity the simulations use, and the value the expected results are written against.
const KIN_GRAVITY : f64 = 9.81;

/** The rigid-body dynamics checks. */
pub class KineticDynamicsSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        kinFreeFall(c);
        kinForce(c);
        kinBounce(c);
        kinMomentumElastic(c);
        kinMomentumInelastic(c);
        kinMomentumOffAxis(c);
        kinSlopes(c);
        kinStackTower(c);
        kinTwistedStack(c);
        kinPyramid(c);
        kinTopple(c);
        kinSleeping(c);
        kinKinematic(c);
        kinCapsulesRest(c);
    }
}

fn kinGround(w : PhysicsWorld) : EntityId {
    return w.addBody(BodyDesc::fixed(Shape::plane(DVec3::unitY(), 0.0), DVec3::zero()));
}

fn kinRun(w : PhysicsWorld, steps : i32) : void {
    for (i of 0..steps) {
        w.advance();
    }
}

fn kinFreeFall(c : Checks) : void {
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings {});
    let b : EntityId = w.addBody(BodyDesc::dynamic(
        Shape::sphere(0.5),
        DVec3::make(1.0, 100.0, -2.0),
        1.0
    ));
    let n : i32 = 120;
    kinRun(w, n);
    let dt : f64 = w.settings().substep;
    let nn : f64 = n as f64;
    // Velocity gains g dt per step and the position advances with the mean velocity of the step, which is exact
    // for constant acceleration: y_n = y_0 - g (n dt)^2 / 2 and v_n = -g n dt.
    let t1 : f64 = nn * dt;
    c.near(
        "free fall: height after 1 s is y0 - g t^2 / 2",
        w.position(b).y,
        100.0 - 0.5 * KIN_GRAVITY * t1 * t1,
        KIN_TIGHT
    );
    c.near(
        "free fall: the velocity after time t is -g t",
        w.linearVelocity(b).y,
        -KIN_GRAVITY * t1,
        KIN_TIGHT
    );
    c.near(
        "free fall: the drop in the first second is 4.905 m",
        100.0 - w.position(b).y,
        4.905,
        KIN_TIGHT
    );
    c.near("free fall: sideways motion stays zero (x)", w.position(b).x, 1.0, 0.0);
    c.near("free fall: sideways motion stays zero (z)", w.position(b).z, -2.0, 0.0);
    c.near("free fall: the simulated time after one second is 1", w.time(), 1.0, KIN_TIGHT);

    let wf : PhysicsWorld = new PhysicsWorld(PhysicsSettings {});
    let mut d : BodyDesc = BodyDesc::dynamic(Shape::sphere(0.5), DVec3::make(0.0, 50.0, 0.0), 1.0);
    d.gravityScale = 0.0;
    d.linearVelocity = DVec3::make(3.0, 0.0, 0.0);
    let f : EntityId = wf.addBody(d);
    kinRun(wf, 240);
    c.near(
        "free flight: no gravity, constant velocity moves 6 m in 2 s",
        wf.position(f).x,
        6.0,
        KIN_TIGHT
    );
    c.near("free flight: a body without gravity stays at its height", wf.position(f).y, 50.0, 0.0);

    let mut spin : BodyDesc = BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::make(0.0, 50.0, 0.0),
        1.0
    );
    spin.gravityScale = 0.0;
    spin.angularVelocity = DVec3::make(0.0, 2.0, 0.0);
    let s : EntityId = wf.addBody(spin);
    kinRun(wf, 120);
    c.near("spin: the angle after 1 s is 2 rad", wf.rotation(s).angle(), 2.0, KIN_LOOSE);
    c.near("spin: angular velocity is unchanged", wf.angularVelocity(s).y, 2.0, KIN_TIGHT);
}

fn kinForce(c : Checks) : void {
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings { gravity: DVec3::zero() });
    let b : EntityId = w.addBody(BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::zero(),
        2.0
    ));
    for (i of 0..120) {
        w.applyForce(b, DVec3::make(10.0, 0.0, 0.0));
        w.advance();
    }
    c.near("force: a = F / m gives 5 m/s after 1 s", w.linearVelocity(b).x, 5.0, KIN_TIGHT);
    let wt : PhysicsWorld = new PhysicsWorld(PhysicsSettings { gravity: DVec3::zero() });
    let t : EntityId = wt.addBody(BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::zero(),
        12.0
    ));
    // Cube of mass 12 and side 1: I = 2. A torque of 4 gives alpha = 2.
    for (i of 0..120) {
        wt.applyTorque(t, DVec3::make(0.0, 0.0, 4.0));
        wt.advance();
    }
    c.near("torque: alpha = tau / I", wt.angularVelocity(t).z, 2.0, KIN_TIGHT);
    let wi : PhysicsWorld = new PhysicsWorld(PhysicsSettings { gravity: DVec3::zero() });
    let i1 : EntityId = wi.addBody(BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::zero(),
        2.0
    ));
    wi.applyImpulseAt(i1, DVec3::make(0.0, 0.0, 4.0), DVec3::make(0.0, 0.5, 0.0));
    c.near("impulse: delta v = J / m", wi.linearVelocity(i1).z, 2.0, KIN_TIGHT);
    // r x J = (0, 0.5, 0) x (0, 0, 4) = (2, 0, 0); I = 2/12 * (1 + 1) = 1/3 -> omega_x = 6.
    c.near(
        "impulse: an off-centre impulse spins the body",
        wi.angularVelocity(i1).x,
        6.0,
        KIN_LOOSE
    );
    let wd : PhysicsWorld = new PhysicsWorld(PhysicsSettings { gravity: DVec3::zero() });
    let mut dd : BodyDesc = BodyDesc::dynamic(Shape::sphere(0.5), DVec3::zero(), 1.0);
    dd.linearVelocity = DVec3::make(10.0, 0.0, 0.0);
    dd.linearDamping = 1.0;
    let d : EntityId = wd.addBody(dd);
    kinRun(wd, 120);
    c.that(
        "damping: a damped body slows down",
        wd.linearVelocity(d).x < 4.0 && wd.linearVelocity(d).x > 2.0
    );
}

/** What a bounce run measured: its highest point and the energy at its start and peak. */
pub struct KinBounce {
    /** Highest centre height after the first bounce, in metres. */
    pub apex : f64;

    /** Total mechanical energy at the start. */
    pub start : f64;

    /** Highest total mechanical energy seen at any later step. */
    pub peak : f64;
}

// Drops a ball of restitution `e` from `h` above the ground and reports the run.
fn kinBounceApex(e : f64, h : f64) : KinBounce {
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings { sleeping: false });
    let g : EntityId = kinGround(w);
    let mut d : BodyDesc = BodyDesc::dynamic(
        Shape::sphere(0.5),
        DVec3::make(0.0, h + 0.5, 0.0),
        1.0
    );
    d.restitution = e;
    let b : EntityId = w.addBody(d);
    let e0 : f64 = w.kineticEnergy() + w.potentialEnergy();
    let mut maxE : f64 = e0;
    let mut bounced : bool = false;
    let mut apex : f64 = 0.0;
    let mut lastV : f64 = 0.0;
    for (i of 0..360) {
        w.advance();
        let v : f64 = w.linearVelocity(b).y;
        if (lastV < -1.0 && v > 0.0) {
            bounced = true;
        }
        lastV = v;
        if (bounced && w.position(b).y > apex) {
            apex = w.position(b).y;
        }
        let en : f64 = w.kineticEnergy() + w.potentialEnergy();
        if (en > maxE) {
            maxE = en;
        }
    }
    return KinBounce { apex: apex, start: e0, peak: maxE };
}

fn kinBounce(c : Checks) : void {
    let elastic : KinBounce = kinBounceApex(1.0, 5.0);
    c.near(
        "bounce: a perfectly elastic ball returns to its fall height",
        elastic.apex - 0.5,
        5.0,
        0.15
    );
    c.that(
        "bounce: energy never rises more than 1 % above the start (e = 1)",
        elastic.peak <= elastic.start * 1.01 + 0.0001
    );

    let half : KinBounce = kinBounceApex(0.5, 5.0);
    c.near("bounce: e = 0.5 returns e^2 of the height (1.25 m)", half.apex - 0.5, 1.25, 0.1);
    c.that("bounce: energy never rises (e = 0.5)", half.peak <= half.start * 1.01 + 0.0001);

    let dead : KinBounce = kinBounceApex(0.0, 5.0);
    c.that("bounce: e = 0 does not bounce", dead.apex < 0.55);
}

fn kinMomentumElastic(c : Checks) : void {
    // Head-on, equal restitution 1: the 1-D elastic formulas.
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings {
        gravity: DVec3::zero(),
        sleeping: false,
    });
    let mut da : BodyDesc = BodyDesc::dynamic(Shape::sphere(0.5), DVec3::make(-1.0, 0.0, 0.0), 1.0);
    da.restitution = 1.0;
    da.linearVelocity = DVec3::make(4.0, 0.0, 0.0);
    let mut db : BodyDesc = BodyDesc::dynamic(Shape::sphere(0.5), DVec3::make(1.0, 0.0, 0.0), 3.0);
    db.restitution = 1.0;
    db.linearVelocity = DVec3::make(-2.0, 0.0, 0.0);
    let a : EntityId = w.addBody(da);
    let b : EntityId = w.addBody(db);
    let p0 : DVec3 = w.linearMomentum();
    let ke0 : f64 = w.kineticEnergy();
    kinRun(w, 120);
    c.that("momentum: total momentum is conserved", w.linearMomentum().approxEq(p0, KIN_TIGHT));
    c.near(
        "momentum: elastic collision, first sphere (m=1, 4 m/s) leaves at -5",
        w.linearVelocity(a).x,
        -5.0,
        0.001
    );
    c.near(
        "momentum: elastic collision, second sphere (m=3, -2 m/s) leaves at 1",
        w.linearVelocity(b).x,
        1.0,
        0.001
    );
    c.near(
        "momentum: kinetic energy is conserved in the elastic collision",
        w.kineticEnergy(),
        ke0,
        0.001 * ke0
    );
}

fn kinMomentumInelastic(c : Checks) : void {
    let wi : PhysicsWorld = new PhysicsWorld(PhysicsSettings {
        gravity: DVec3::zero(),
        sleeping: false,
    });
    let mut ia : BodyDesc = BodyDesc::dynamic(Shape::sphere(0.5), DVec3::make(-1.0, 0.0, 0.0), 1.0);
    ia.linearVelocity = DVec3::make(4.0, 0.0, 0.0);
    let mut ib : BodyDesc = BodyDesc::dynamic(Shape::sphere(0.5), DVec3::make(1.0, 0.0, 0.0), 3.0);
    ib.linearVelocity = DVec3::make(-2.0, 0.0, 0.0);
    let ja : EntityId = wi.addBody(ia);
    let jb : EntityId = wi.addBody(ib);
    kinRun(wi, 120);
    c.near(
        "momentum: perfectly inelastic, first sphere takes the common velocity -0.5",
        wi.linearVelocity(ja).x,
        -0.5,
        0.001
    );
    c.near("momentum: perfectly inelastic, second sphere", wi.linearVelocity(jb).x, -0.5, 0.001);
}

fn kinMomentumOffAxis(c : Checks) : void {
    // Boxes meeting off-axis in zero gravity: linear and angular momentum about the origin are conserved.
    let wb : PhysicsWorld = new PhysicsWorld(PhysicsSettings {
        gravity: DVec3::zero(),
        sleeping: false,
    });
    let mut ba : BodyDesc = BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::make(-1.2, 0.0, 0.0),
        2.0
    );
    ba.linearVelocity = DVec3::make(3.0, 0.0, 0.0);
    ba.restitution = 0.5;
    let mut bb : BodyDesc = BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::make(1.2, 0.3, 0.0),
        1.0
    );
    bb.linearVelocity = DVec3::make(-1.0, 0.0, 0.0);
    bb.restitution = 0.5;
    wb.addBody(ba);
    wb.addBody(bb);
    let pb0 : DVec3 = wb.linearMomentum();
    kinRun(wb, 240);
    c.that(
        "momentum: boxes colliding off-centre conserve linear momentum",
        wb.linearMomentum().approxEq(pb0, KIN_LOOSE)
    );
    c.that(
        "momentum: the boxes have separated after the impact",
        wb.position(wb.bodyAt(0)).x < wb.position(wb.bodyAt(1)).x - 0.5
            || wb.linearVelocity(wb.bodyAt(0)).x < wb.linearVelocity(wb.bodyAt(1)).x
    );
}

// Runs a box on a slope of `deg` degrees; x = speed after 1 s, y = speed after 2 s, z = distance down the slope.
fn kinSlope(deg : f64) : DVec3 {
    let angle : f64 = deg * 0.017453292519943295;
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings { sleeping: false });
    let n : DVec3 = DVec3 { x: 0.0 - sinD(angle), y: cosD(angle), z: 0.0 };
    w.addBody(BodyDesc::fixed(Shape::plane(n, 0.0), DVec3::zero()));
    let mut d : BodyDesc = BodyDesc::dynamic(Shape::cuboid(0.5, 0.5, 0.5), n.scale(0.5005), 1.0);
    d.rotation = DQuat::fromAxisAngle(DVec3::unitZ(), angle);
    d.friction = 0.5;
    let b : EntityId = w.addBody(d);
    let start : DVec3 = w.position(b);
    // The unit vector pointing down the slope.
    let down : DVec3 = DVec3 { x: 0.0 - cosD(angle), y: 0.0 - sinD(angle), z: 0.0 };
    kinRun(w, 120);
    let v1 : f64 = w.linearVelocity(b).dot(down);
    kinRun(w, 120);
    let v2 : f64 = w.linearVelocity(b).dot(down);
    return DVec3 { x: v1, y: v2, z: w.position(b).minus(start).dot(down) };
}

fn kinSlopes(c : Checks) : void {
    // mu = 0.5 (both surfaces 0.5): the critical angle is atan(0.5) = 26.57 degrees.
    let low : DVec3 = kinSlope(20.0);
    c.that("slope: at 20 degrees the box stays put", low.z < 0.01 && low.y < 0.02);
    let near : DVec3 = kinSlope(25.0);
    c.that(
        "slope: at 25 degrees (below atan mu) the box still holds",
        near.z < 0.01 && near.y < 0.02
    );
    let over : DVec3 = kinSlope(28.0);
    c.that("slope: at 28 degrees (above atan mu) the box slides", over.z > 0.5 && over.y > 0.1);
    // a = g (sin t - mu cos t); the speed gained in the second second is a * 1 s.
    let steep : DVec3 = kinSlope(35.0);
    let a35 : f64 = KIN_GRAVITY * (0.5735764363510461 - 0.5 * 0.8191520442889918);
    c.near(
        "slope: sliding acceleration at 35 degrees is g (sin - mu cos)",
        steep.y - steep.x,
        a35,
        0.04 * a35
    );
    let a28 : f64 = KIN_GRAVITY * (0.4694715627858908 - 0.5 * 0.882947592858927);
    c.near("slope: sliding acceleration at 28 degrees", over.y - over.x, a28, 0.08 * a28);
    let sheer : DVec3 = kinSlope(60.0);
    let a60 : f64 = KIN_GRAVITY * (0.8660254037844386 - 0.5 * 0.5);
    c.near("slope: sliding acceleration at 60 degrees", sheer.y - sheer.x, a60, 0.04 * a60);
}

fn kinStackTower(c : Checks) : void {
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings { sleeping: false });
    kinGround(w);
    let mut handles : EntityId[] = new EntityId[5];
    for (i of 0..5) {
        let d : BodyDesc = BodyDesc::dynamic(
            Shape::cuboid(0.5, 0.5, 0.5),
            DVec3::make(0.0, 0.5 + (i as f64) * 1.001, 0.0),
            1.0
        );
        handles[i as i64] = w.addBody(d);
    }
    kinRun(w, 480);
    let mut vmax : f64 = 0.0;
    let mut dev : f64 = 0.0;
    for (i of 0..5) {
        let b : EntityId = handles[i as i64];
        let v : f64 = w.linearVelocity(b).length() + w.angularVelocity(b).length();
        if (v > vmax) {
            vmax = v;
        }
        let p : DVec3 = w.position(b);
        // Each contact settles about the penetration slop (5 mm) into the next one, so the tower sinks a little.
        let e : f64 = p.minus(DVec3::make(0.0, 0.5 + (i as f64) * 1.001, 0.0)).length()
            - 0.005 * (i as f64);
        if (e > dev) {
            dev = e;
        }
    }
    c.that("stack: after 4 s a stack of 5 boxes is still (max speed below 0.01)", vmax < 0.01);
    c.that(
        "stack: the boxes sit where they were stacked, less one slop (5 mm) per contact, within 5 mm",
        dev < 0.005
    );
    c.that("stack: the stack has contacts, it is not floating", w.contactCount() >= 20);
}

fn kinTwistedStack(c : Checks) : void {
    // The same with a second stack of offset, rotated boxes: it does not fall over either.
    let w2 : PhysicsWorld = new PhysicsWorld(PhysicsSettings { sleeping: false });
    kinGround(w2);
    let mut top : EntityId = EntityId::none();
    for (i of 0..4) {
        let mut d : BodyDesc = BodyDesc::dynamic(
            Shape::cuboid(0.5, 0.5, 0.5),
            DVec3::make(0.03 * (i as f64), 0.5 + (i as f64) * 1.001, 0.0),
            1.0
        );
        d.rotation = DQuat::fromAxisAngle(DVec3::unitY(), 0.2 * (i as f64));
        top = w2.addBody(d);
    }
    kinRun(w2, 480);
    c.that(
        "stack: a slightly offset, twisted tower of 4 stays up",
        w2.position(top).y > 3.4 && w2.linearVelocity(top).length() < 0.05
    );
}

fn kinPyramid(c : Checks) : void {
    // A wall of boxes (pyramid): 3 + 2 + 1.
    let w3 : PhysicsWorld = new PhysicsWorld(PhysicsSettings { sleeping: false });
    kinGround(w3);
    let mut apex : EntityId = EntityId::none();
    for (row of 0..3) {
        for (k of 0..3 - row) {
            let x : f64 = ((k as f64) - (2.0 - (row as f64)) * 0.5) * 1.02;
            apex = w3.addBody(BodyDesc::dynamic(
                Shape::cuboid(0.5, 0.5, 0.5),
                DVec3::make(x, 0.5 + (row as f64) * 1.001, 0.0),
                1.0
            ));
        }
    }
    kinRun(w3, 360);
    c.that(
        "stack: a pyramid of 6 boxes holds",
        w3.position(apex).y > 2.4 && w3.position(apex).y < 2.6
    );
}

fn kinTopple(c : Checks) : void {
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings { sleeping: false });
    kinGround(w);
    let mut d : BodyDesc = BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::make(0.0, 0.9, 0.0),
        1.0
    );
    d.rotation = DQuat::fromAxisAngle(DVec3::unitZ(), KIN_EDGE_TILT + 0.05);
    let b : EntityId = w.addBody(d);
    kinRun(w, 480);
    let up : DVec3 = w.rotation(b).rotate(DVec3::unitY());
    c.that(
        "topple: a box balanced past its tipping point falls onto a face",
        absD(up.y) > 0.999 || absD(up.x) > 0.999
    );
    c.near("topple: and lies at half its height", w.position(b).y, 0.5, 0.01);
    c.that("topple: and comes to rest", w.linearVelocity(b).length() < 0.01);
}

fn kinSleeping(c : Checks) : void {
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings {});
    kinGround(w);
    let b : EntityId = w.addBody(BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::make(0.0, 0.52, 0.0),
        1.0
    ));
    let t : EntityId = w.addBody(BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::make(0.0, 1.53, 0.0),
        1.0
    ));
    kinRun(w, 60);
    c.that("sleep: a body that has just landed is awake", !w.isAsleep(b));
    kinRun(w, 300);
    c.that("sleep: after resting for a while the box sleeps", w.isAsleep(b));
    c.that("sleep: and the one on top sleeps with it, in the same island", w.isAsleep(t));
    let h : i64 = w.stateHash();
    let y : f64 = w.position(b).y;
    kinRun(w, 120);
    c.that("sleep: a sleeping world does not change", w.stateHash() == h && w.position(b).y == y);
    c.near("sleep: asleep means zero velocity", w.linearVelocity(b).length(), 0.0, 0.0);
    // Something lands on the stack: the island wakes.
    let mut fall : BodyDesc = BodyDesc::dynamic(
        Shape::sphere(0.3),
        DVec3::make(0.0, 3.0, 0.0),
        0.5
    );
    fall.restitution = 0.0;
    let s : EntityId = w.addBody(fall);
    let mut woke : bool = false;
    for (i of 0..120) {
        w.advance();
        if (!w.isAsleep(t)) {
            woke = true;
        }
    }
    c.that("sleep: a body falling on a sleeping stack wakes it", woke);
    c.that(
        "sleep: the ball came to rest on the top box",
        w.position(s).y > 2.25 && w.position(s).y < 2.35
    );
    // A push wakes a sleeper.
    kinRun(w, 480);
    c.that(
        "sleep: the whole pile goes back to sleep",
        w.isAsleep(b) && w.isAsleep(t) && w.isAsleep(s)
    );
    w.applyImpulseAt(t, DVec3::make(2.0, 0.0, 0.0), w.position(t));
    c.that("sleep: an impulse wakes a body", !w.isAsleep(t));
    // A box that never rests (kinematic neighbour) does not sleep; sleeping can be turned off.
    let wn : PhysicsWorld = new PhysicsWorld(PhysicsSettings { sleeping: false });
    kinGround(wn);
    let nb : EntityId = wn.addBody(BodyDesc::dynamic(
        Shape::cuboid(0.5, 0.5, 0.5),
        DVec3::make(0.0, 0.52, 0.0),
        1.0
    ));
    kinRun(wn, 600);
    c.that("sleep: switched off, nothing sleeps", !wn.isAsleep(nb));
}

fn kinKinematic(c : Checks) : void {
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings {});
    let mut kd : BodyDesc = BodyDesc::kinematic(
        Shape::cuboid(4.0, 0.25, 2.0),
        DVec3::make(0.0, 0.0, 0.0)
    );
    kd.linearVelocity = DVec3::make(1.0, 0.0, 0.0);
    kd.friction = 0.8;
    let plat : EntityId = w.addBody(kd);
    let mut cd : BodyDesc = BodyDesc::dynamic(
        Shape::cuboid(0.3, 0.3, 0.3),
        DVec3::make(0.0, 0.56, 0.0),
        1.0
    );
    cd.friction = 0.8;
    let crate : EntityId = w.addBody(cd);
    kinRun(w, 240);
    c.near(
        "kinematic: the platform moves exactly with its velocity",
        w.position(plat).x,
        2.0,
        KIN_TIGHT
    );
    c.near("kinematic: gravity does not move it", w.position(plat).y, 0.0, 0.0);
    c.near(
        "kinematic: friction carries the crate along at the platform's speed",
        w.linearVelocity(crate).x,
        1.0,
        0.02
    );
    c.that(
        "kinematic: the crate rides on the platform",
        w.position(crate).y > 0.5 && w.position(crate).y < 0.6
    );
    c.that("kinematic: the crate stays awake while the platform moves", !w.isAsleep(crate));
}

fn kinCapsulesRest(c : Checks) : void {
    let w : PhysicsWorld = new PhysicsWorld(PhysicsSettings { sleeping: false });
    kinGround(w);
    let mut d : BodyDesc = BodyDesc::dynamic(
        Shape::capsule(0.4, 0.6),
        DVec3::make(0.0, 3.0, 0.0),
        1.0
    );
    d.rotation = DQuat::fromAxisAngle(DVec3::unitZ(), 1.0);
    let cap : EntityId = w.addBody(d);
    let ball : EntityId = w.addBody(BodyDesc::dynamic(
        Shape::sphere(0.3),
        DVec3::make(0.05, 5.0, 0.0),
        1.0
    ));
    kinRun(w, 600);
    c.that(
        "capsule: a dropped capsule ends up lying on its side",
        w.position(cap).y > 0.38 && w.position(cap).y < 0.42
    );
    c.that(
        "capsule: and is still",
        w.linearVelocity(cap).length() < 0.02 && w.angularVelocity(cap).length() < 0.05
    );
    c.that(
        "sphere: a ball dropped on a capsule ends on the ground or on it, still",
        w.linearVelocity(ball).length() < 0.05
    );
}

// runtime — runs the suites of the runtime layer: main loop, settings, input, scheduler.
//
// This file only orders the sub-suites; each of them builds its own loop, settings or scheduler. Keeping the
// order here rather than in `main` means the layer's registration does not change when a sub-suite is added.

use ludax::Checks;

use crate::runtime_input::RuntimeInputSuite;
use crate::runtime_loop::RuntimeLoopSuite;
use crate::runtime_sched::RuntimeSchedSuite;
use crate::runtime_settings::RuntimeSettingsSuite;

/** All runtime checks. */
pub class RuntimeSuite {
    /** Runs every check of the layer. */
    pub static fn run(c : Checks) : void {
        RuntimeLoopSuite::run(c);
        RuntimeSettingsSuite::run(c);
        RuntimeInputSuite::run(c);
        RuntimeSchedSuite::run(c);
    }
}

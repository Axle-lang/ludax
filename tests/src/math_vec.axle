// math_vec — Vec2, Vec3 and Vec4: identities, degenerate inputs and the in-place forms.
//
// The geometry checks state the identities a renderer relies on (the cross product's handedness, the
// perpendicular built from any direction), and the degenerate cases state the contract: zero normalises to
// zero rather than trapping. The in-place forms are checked against their value-returning twins, including
// through an array element and a class field, because those are the places a copied struct can quietly stay
// unchanged.

use ludax::{Checks, Vec2, Vec3, Vec4};

use crate::math_support::{
    MATH_TOL, MATH_TOL_COARSE, MATH_TOL_TIGHT, nearVec2, nearVec3, nearVec4, nearF
};

// A little class that keeps a Vec3 in a field, the way a body or a camera does.
class VecHolder {
    /** The held position, the way a body or a camera keeps one. */
    pub pos : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Moves the held position by `delta`, the in-place form. */
    pub fn push(mut self, delta : Vec3) : void {
        self.pos.addIn(delta);
    }
}

fn vecTestVec2(c : Checks) : void {
    let a : Vec2 = Vec2::make(3.0, 4.0);
    let b : Vec2 = Vec2::make(-1.0, 2.0);
    nearF(c, "Vec2 length 3-4-5", a.length(), 5.0, 0.0);
    nearF(c, "Vec2 lengthSquared", a.lengthSquared(), 25.0, 0.0);
    nearVec2(c, "Vec2 plus", a.plus(b), Vec2::make(2.0, 6.0), 0.0);
    nearVec2(c, "Vec2 minus", a.minus(b), Vec2::make(4.0, 2.0), 0.0);
    nearVec2(c, "Vec2 scale", a.scale(2.0), Vec2::make(6.0, 8.0), 0.0);
    nearVec2(c, "Vec2 times", a.times(b), Vec2::make(-3.0, 8.0), 0.0);
    nearF(c, "Vec2 dot", a.dot(b), 5.0, 0.0);
    nearF(
        c,
        "Vec2 cross is positive counter-clockwise",
        Vec2::unitX().cross(Vec2::unitY()),
        1.0,
        0.0
    );
    nearVec2(c, "Vec2 perp turns X into Y", Vec2::unitX().perp(), Vec2::unitY(), 0.0);
    nearF(c, "Vec2 normalized is unit", a.normalized().length(), 1.0, MATH_TOL_TIGHT);
    nearVec2(c, "Vec2 normalized of zero is zero", Vec2::zero().normalized(), Vec2::zero(), 0.0);
    nearVec2(
        c,
        "Vec2 normalizedOr gives the fallback",
        Vec2::zero().normalizedOr(Vec2::unitY()),
        Vec2::unitY(),
        0.0
    );
    nearVec2(c, "Vec2 lerp", a.lerp(b, 0.5), Vec2::make(1.0, 3.0), 0.0);
    nearF(c, "Vec2 distance", a.distance(Vec2::zero()), 5.0, 0.0);
    nearVec2(c, "Vec2 componentMin", a.componentMin(b), Vec2::make(-1.0, 2.0), 0.0);
    nearVec2(c, "Vec2 componentMax", a.componentMax(b), Vec2::make(3.0, 4.0), 0.0);
    let m : Vec2 = a;
    m.addIn(b);
    m.scaleIn(0.5);
    nearVec2(c, "Vec2 in-place add then scale", m, Vec2::make(1.0, 3.0), 0.0);
    m.mulAddIn(b, 2.0);
    nearVec2(c, "Vec2 mulAddIn", m, Vec2::make(-1.0, 7.0), 0.0);
    m.normalizeIn();
    nearF(c, "Vec2 normalizeIn", m.length(), 1.0, MATH_TOL_TIGHT);
    let z : Vec2 = Vec2::zero();
    z.normalizeIn();
    nearVec2(c, "Vec2 normalizeIn of zero stays zero", z, Vec2::zero(), 0.0);
}

fn vecTestBasics(c : Checks) : void {
    let a : Vec3 = Vec3::make(1.0, 2.0, 3.0);
    let b : Vec3 = Vec3::make(-2.0, 0.5, 4.0);
    nearVec3(c, "plus", a.plus(b), Vec3::make(-1.0, 2.5, 7.0), 0.0);
    nearVec3(c, "minus", a.minus(b), Vec3::make(3.0, 1.5, -1.0), 0.0);
    nearVec3(c, "times", a.times(b), Vec3::make(-2.0, 1.0, 12.0), 0.0);
    nearVec3(c, "scale", a.scale(-2.0), Vec3::make(-2.0, -4.0, -6.0), 0.0);
    nearVec3(c, "negated", a.negated(), Vec3::make(-1.0, -2.0, -3.0), 0.0);
    nearVec3(c, "splat", Vec3::splat(2.0), Vec3::make(2.0, 2.0, 2.0), 0.0);
    nearF(c, "dot", a.dot(b), 11.0, 0.0);
    nearF(c, "length of (2,3,6) is 7", Vec3::make(2.0, 3.0, 6.0).length(), 7.0, 0.0);
    nearF(c, "distance", a.distance(a.plus(Vec3::make(0.0, 0.0, 5.0))), 5.0, 0.0);
    nearF(c, "distanceSquared", a.distanceSquared(Vec3::zero()), 14.0, 0.0);
    nearVec3(c, "lerp at 0", a.lerp(b, 0.0), a, 0.0);
    nearVec3(c, "lerp at 1", a.lerp(b, 1.0), b, 0.0);
    nearVec3(c, "lerp at 0.5", a.lerp(b, 0.5), Vec3::make(-0.5, 1.25, 3.5), 0.0);
    nearVec3(c, "componentMin", a.componentMin(b), Vec3::make(-2.0, 0.5, 3.0), 0.0);
    nearVec3(c, "componentMax", a.componentMax(b), Vec3::make(1.0, 2.0, 4.0), 0.0);
    nearVec3(c, "abs", b.abs(), Vec3::make(2.0, 0.5, 4.0), 0.0);
    nearF(c, "maxComponent", b.maxComponent(), 4.0, 0.0);
    c.that("approxEq within tolerance", a.approxEq(a.plus(Vec3::splat(MATH_TOL_COARSE)), 0.01));
    c.that("approxEq outside tolerance", !a.approxEq(a.plus(Vec3::splat(0.1)), 0.01));
    c.that("isFinite", a.isFinite());
    c.that(
        "isFinite rejects an infinity",
        !Vec3::make(vecOverflowToInfinity(), 0.0, 0.0).isFinite()
    );
}

// An f32 infinity made by overflow, since Axle has no literal for it.
fn vecOverflowToInfinity() : f32 {
    let big : f32 = 3000000000000000000000000000000000000.0;
    return big * big;
}

fn vecTestGeometry(c : Checks) : void {
    let x : Vec3 = Vec3::unitX();
    let y : Vec3 = Vec3::unitY();
    let z : Vec3 = Vec3::unitZ();
    nearVec3(c, "x cross y is z (right-handed)", x.cross(y), z, 0.0);
    nearVec3(c, "y cross z is x", y.cross(z), x, 0.0);
    nearVec3(c, "z cross x is y", z.cross(x), y, 0.0);
    let a : Vec3 = Vec3::make(1.0, 2.0, 3.0);
    let b : Vec3 = Vec3::make(-2.0, 0.5, 4.0);
    nearVec3(c, "cross is anti-commutative", a.cross(b), b.cross(a).negated(), 0.0);
    nearF(c, "cross is perpendicular to its first operand", a.cross(b).dot(a), 0.0, MATH_TOL);
    nearF(c, "cross is perpendicular to its second operand", a.cross(b).dot(b), 0.0, MATH_TOL);
    nearVec3(c, "a cross a is zero", a.cross(a), Vec3::zero(), 0.0);
    nearF(c, "normalized is unit", a.normalized().length(), 1.0, MATH_TOL_TIGHT);
    nearVec3(
        c,
        "normalized of zero is zero, not a trap",
        Vec3::zero().normalized(),
        Vec3::zero(),
        0.0
    );
    nearVec3(
        c,
        "normalized of a tiny vector is zero",
        Vec3::splat(0.0000000000001).normalized(),
        Vec3::zero(),
        0.0
    );
    nearVec3(c, "normalizedOr fallback", Vec3::zero().normalizedOr(Vec3::unitZ()), z, 0.0);
    nearVec3(
        c,
        "reflect off the floor",
        Vec3::make(1.0, -1.0, 0.0).reflect(y),
        Vec3::make(1.0, 1.0, 0.0),
        0.0
    );
    nearVec3(
        c,
        "projectOn",
        Vec3::make(3.0, 4.0, 0.0).projectOn(x),
        Vec3::make(3.0, 0.0, 0.0),
        0.0
    );
    nearVec3(c, "projectOn zero is zero, not a trap", a.projectOn(Vec3::zero()), Vec3::zero(), 0.0);
    let mut dirs : Vec3[] = new Vec3[5];
    dirs[0] = x;
    dirs[1] = y;
    dirs[2] = z;
    dirs[3] = Vec3::make(1.0, 1.0, 1.0);
    dirs[4] = Vec3::make(-0.2, 7.0, 0.1);
    let mut i : i32 = 0;
    while (i < 5) {
        let p : Vec3 = dirs[i].anyPerpendicular();
        nearF(c, "anyPerpendicular is unit ${i}", p.length(), 1.0, MATH_TOL);
        nearF(
            c,
            "anyPerpendicular is perpendicular ${i}",
            p.dot(dirs[i].normalized()),
            0.0,
            MATH_TOL
        );
        i = i + 1;
    }
}

fn vecTestInPlace(c : Checks) : void {
    let a : Vec3 = Vec3::make(1.0, 2.0, 3.0);
    let b : Vec3 = Vec3::make(-2.0, 0.5, 4.0);
    let mut m : Vec3 = a;
    m.addIn(b);
    nearVec3(c, "addIn equals plus", m, a.plus(b), 0.0);
    m = a;
    m.subIn(b);
    nearVec3(c, "subIn equals minus", m, a.minus(b), 0.0);
    m = a;
    m.scaleIn(3.0);
    nearVec3(c, "scaleIn equals scale", m, a.scale(3.0), 0.0);
    m = a;
    m.mulAddIn(b, 2.0);
    nearVec3(c, "mulAddIn equals plus of scale", m, a.plus(b.scale(2.0)), 0.0);
    m = a;
    m.negateIn();
    nearVec3(c, "negateIn equals negated", m, a.negated(), 0.0);
    m = a;
    m.crossIn(b);
    nearVec3(c, "crossIn equals cross", m, a.cross(b), 0.0);
    m = a;
    m.normalizeIn();
    nearVec3(c, "normalizeIn equals normalized", m, a.normalized(), MATH_TOL_TIGHT);
    m = Vec3::zero();
    m.normalizeIn();
    nearVec3(c, "normalizeIn of zero stays zero", m, Vec3::zero(), 0.0);
    m.set(7.0, 8.0, 9.0);
    nearVec3(c, "set", m, Vec3::make(7.0, 8.0, 9.0), 0.0);
    let copy : Vec3 = m;
    m.addIn(a);
    nearVec3(
        c,
        "a copy is not changed by an in-place edit of the original",
        copy,
        Vec3::make(7.0, 8.0, 9.0),
        0.0
    );
    let mut store : Vec3[] = new Vec3[3];
    store[1] = a;
    store[1].addIn(b);
    nearVec3(c, "in-place edit of an array element", store[1], a.plus(b), 0.0);
    let h : VecHolder = new VecHolder();
    h.push(a);
    h.push(b);
    nearVec3(c, "in-place edit of a class field", h.pos, a.plus(b), 0.0);
}

fn vecTestVec4(c : Checks) : void {
    let a : Vec4 = Vec4::make(1.0, 2.0, 3.0, 4.0);
    let b : Vec4 = Vec4::make(0.5, -1.0, 2.0, 1.0);
    nearVec4(c, "Vec4 plus", a.plus(b), Vec4::make(1.5, 1.0, 5.0, 5.0), 0.0);
    nearVec4(c, "Vec4 minus", a.minus(b), Vec4::make(0.5, 3.0, 1.0, 3.0), 0.0);
    nearVec4(c, "Vec4 times", a.times(b), Vec4::make(0.5, -2.0, 6.0, 4.0), 0.0);
    nearVec4(c, "Vec4 scale", a.scale(2.0), Vec4::make(2.0, 4.0, 6.0, 8.0), 0.0);
    nearF(c, "Vec4 dot", a.dot(b), 8.5, 0.0);
    nearF(c, "Vec4 length of (1,1,1,1) is 2", Vec4::make(1.0, 1.0, 1.0, 1.0).length(), 2.0, 0.0);
    nearF(c, "Vec4 normalized is unit", a.normalized().length(), 1.0, MATH_TOL_TIGHT);
    nearVec4(c, "Vec4 normalized of zero", Vec4::zero().normalized(), Vec4::zero(), 0.0);
    nearVec4(c, "Vec4 lerp", a.lerp(b, 0.5), Vec4::make(0.75, 0.5, 2.5, 2.5), 0.0);
    nearVec3(c, "Vec4 xyz", a.xyz(), Vec3::make(1.0, 2.0, 3.0), 0.0);
    nearVec4(
        c,
        "Vec4 fromVec3",
        Vec4::fromVec3(Vec3::make(1.0, 2.0, 3.0), 1.0),
        Vec4::make(1.0, 2.0, 3.0, 1.0),
        0.0
    );
    let mut m : Vec4 = a;
    m.addIn(b);
    nearVec4(c, "Vec4 addIn", m, a.plus(b), 0.0);
    m = a;
    m.subIn(b);
    nearVec4(c, "Vec4 subIn", m, a.minus(b), 0.0);
    m = a;
    m.scaleIn(2.0);
    nearVec4(c, "Vec4 scaleIn", m, a.scale(2.0), 0.0);
    m = a;
    m.mulAddIn(b, 2.0);
    nearVec4(c, "Vec4 mulAddIn", m, a.plus(b.scale(2.0)), 0.0);
    m.set(0.0, 1.0, 0.0, 1.0);
    nearVec4(c, "Vec4 set", m, Vec4::make(0.0, 1.0, 0.0, 1.0), 0.0);
}

/** The vec suite. */
pub class MathVecSuite {
    /** Runs the vector checks. */
    pub static fn run(c : Checks) : void {
        vecTestVec2(c);
        vecTestBasics(c);
        vecTestGeometry(c);
        vecTestInPlace(c);
        vecTestVec4(c);
    }
}

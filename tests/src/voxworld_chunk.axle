// voxworld_chunk — palette-compressed chunks and the chunk store: representation upgrades, memory, coordinates.
//
// A chunk must read back exactly what was written however its packing changed on the way, a uniform chunk must
// hold no array, and the store must find chunks by negative coordinates as well as positive ones.

use ludax::{Checks, Pcg32, VoxChunk, VoxChunkStore, VW_AIR, VW_STONE};

/** Checks palette-compressed chunks and the chunk store. */
pub class VoxWorldChunkSuite {
    static fn fillThrough(c : Checks, kinds : i32, name : string) : void {
        let chunk : VoxChunk = new VoxChunk();
        let r : Pcg32 = new Pcg32(7, 3);
        let mut mirror : i32[] = malloc<i32>(4096);
        for (i of 0..4096) {
            mirror[i as i64] = 0;
        }
        for (step of 0..6000) {
            let i : i32 = r.range(0, 4096);
            let id : i32 = r.range(0, kinds);
            chunk.set(i, id);
            mirror[i as i64] = id;
        }
        let mut same : bool = true;
        for (i of 0..4096) {
            if (chunk.get(i) != mirror[i as i64]) {
                same = false;
            }
        }
        c.that("${name} reads back what was written", same);
    }

    /** Runs every check. */
    pub static fn run(c : Checks) : void {
        let a : VoxChunk = new VoxChunk();
        c.that("a new chunk is uniform", a.isUniform());
        c.sameInt("a uniform chunk is air", a.get(100), VW_AIR);
        c.sameInt("uniform chunk stores no cell array", a.bitsPerCell(), 0);
        let small : i32 = a.bytesUsed();
        a.set(5, VW_STONE);
        c.sameInt("one write upgrades to 4 bits", a.bitsPerCell(), 4);
        c.sameInt("written cell", a.get(5), VW_STONE);
        c.sameInt("other cell", a.get(6), VW_AIR);
        c.that("4-bit chunk costs more than a uniform one", a.bytesUsed() > small);
        c.that("writing the same block is no change", !a.set(5, VW_STONE));
        c.that("writing a different block is a change", a.set(5, 3));
        VoxWorldChunkSuite::fillThrough(c, 10, "10 kinds (4 bit)");
        VoxWorldChunkSuite::fillThrough(c, 40, "40 kinds (8 bit)");
        VoxWorldChunkSuite::fillThrough(c, 1200, "1200 kinds (16 bit)");

        let wide : VoxChunk = new VoxChunk();
        for (i of 0..300) {
            wide.set(i, i + 1);
        }
        c.sameInt("300 kinds need 16 bits", wide.bitsPerCell(), 16);
        for (i of 5..4096) {
            wide.set(i, 2);
        }
        for (i of 0..5) {
            wide.set(i, 2);
        }
        c.sameInt("overwritten palette is still wide before compaction", wide.bitsPerCell(), 16);
        let before : i32 = wide.bytesUsed();
        wide.compact();
        c.sameInt("compaction finds the uniform chunk again", wide.bitsPerCell(), 0);
        c.that("compaction frees memory", wide.bytesUsed() < before);
        c.sameInt("compaction keeps the blocks", wide.get(4000), 2);

        let cells : VoxChunk = new VoxChunk();
        let mut raw : i32[] = malloc<i32>(4096);
        for (i of 0..4096) {
            raw[i as i64] = i % 3;
        }
        cells.fromCells(raw);
        c.sameInt("three kinds pack in 4 bits", cells.bitsPerCell(), 4);
        c.sameInt("fromCells keeps order", cells.get(1000), 1000 % 3);
        c.sameInt("distinct blocks counts cells", cells.distinctBlocks(), 3);

        let s : VoxChunkStore = new VoxChunkStore();
        let one : VoxChunk = new VoxChunk();
        one.set(0, VW_STONE);
        s.insert(-1, 2, -3, one);
        c.that("store finds a chunk with negative coordinates", s.has(-1, 2, -3));
        c.that("store does not invent chunks", !s.has(1, 2, 3));
        c.sameInt("block through the store", s.blockAt(-16, 32, -48), VW_STONE);
        c.sameInt("unloaded chunk reads air", s.blockAt(100, 0, 0), VW_AIR);
        c.that("setBlock writes a loaded chunk", s.setBlock(-15, 33, -47, 4));
        c.sameInt("setBlock read back", s.blockAt(-15, 33, -47), 4);
        c.that("setBlock refuses an unloaded chunk", !s.setBlock(500, 0, 0, 1));
        let k : i64 = VoxChunkStore::key(-5, 70, 123456);
        c.sameInt("key round trip x", VoxChunkStore::keyX(k), -5);
        c.sameInt("key round trip y", VoxChunkStore::keyY(k), 70);
        c.sameInt("key round trip z", VoxChunkStore::keyZ(k), 123456);
        let bytes : i64 = s.bytesUsed();
        c.that("a one-chunk store has bounded memory", bytes > 0 && bytes < 4096);
        c.that("removal reports", s.remove(-1, 2, -3));
        c.sameInt("store empty after removal", s.count(), 0);
        let two : VoxChunk = new VoxChunk();
        s.insert(9, 9, 9, two);
        c.sameInt("slot reuse keeps the count", s.count(), 1);
    }
}

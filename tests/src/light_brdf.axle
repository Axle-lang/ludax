// light_brdf — GGX, Smith, Fresnel: normalisation, symmetry, twins; the albedo table; energy and the white
// furnace.
//
// A BRDF is hard to check by eye, so each property is stated as an integral with a known answer: D integrates
// to one, V is symmetric, the table's E matches a brute-force integral in a different domain, and a white
// furnace returns exactly the environment. The compensated shading path is exercised by the real
// `lightBrdf`/`lightShade` code rather than by a copy of its algebra, so a compensation bug shows as lost or
// gained energy. The furnace also runs uncompensated once, to prove the check can fail.

use ludax::{Checks, Pcg32, Vec3, LightGauss, LightDfg, LightDfgTable, LightMaterial, LightPrepared};
use ludax::{DVec2, clampD, cosD, sinD, acosD, sqrtD, PI_D, sqrt};
use ludax::{LightBrdfTerms};
use ludax::{LightDiffuseModel, LIGHT_ALPHA_MIN, lightAlpha, lightGgxD, lightGgxDD};
use ludax::{lightFresnelWeight, lightFresnelWeightD, lightFresnel, lightPrepare, lightBrdf};
use ludax::{lightSmithV, lightSmithVD};

use crate::light_support::{
    LIGHT_TOL, LIGHT_TOL_COARSE, LIGHT_TOL_LOOSE, LIGHT_TOL_ULP, LightWorst, LightSum, lightRel,
    lightText
};

// An orthonormal setup: normal +Y, the view in the XY plane at cosine `nv`.
fn viewAt(nv : f32) : Vec3 {
    return Vec3::make(sqrt(1.0 - nv * nv), nv, 0.0);
}

// The albedo of the shaded specular lobe (the real lightBrdf, f32, with compensation) for view cosine `nv`,
// per channel, integrated over the half-vector domain:
// E = (1/2pi) integral 4 f (n.l)(v.h) / (D n.h) du dphi.
fn shadedSpecular(p : LightPrepared, nv : f32, order : i32) : Vec3 {
    let rule : LightGauss = new LightGauss(order);
    let v : Vec3 = viewAt(nv);
    let n : Vec3 = Vec3::unitY();
    let sv : f64 = sqrtD(1.0 - (nv as f64) * (nv as f64));
    let a2 : f64 = (p.alpha as f64) * (p.alpha as f64);
    let sx : LightSum = new LightSum();
    let sy : LightSum = new LightSum();
    let sz : LightSum = new LightSum();
    let band : DVec2 = LightDfgTable::horizonBand(nv as f64, p.alpha as f64);
    for (i of 0..order * 2) {
        // Nodes 0..order cover u in [0, low] (the whole circle above the horizon); the rest cover the
        // clipped band with the cosine substitution that removes its square-root ends.
        let seg : i32 = i / order;
        let node : i32 = i % order;
        let t : f64 = rule.at(node, 0.0, 1.0);
        let mut u : f64 = band.x * t;
        let mut du : f64 = band.x * rule.scaled(node, 0.0, 1.0);
        if (seg == 1) {
            u = band.x + (band.y - band.x) * 0.5 * (1.0 - cosD(PI_D * t));
            du = rule.scaled(node, 0.0, 1.0) * (band.y - band.x) * 0.5 * PI_D * sinD(PI_D * t);
        }
        let nh2 : f64 = (1.0 - u) / (1.0 + (a2 - 1.0) * u);
        let nh : f64 = sqrtD(nh2);
        let sh : f64 = sqrtD(1.0 - nh2);
        let reach : f64 = 2.0 * nh * sv * sh;
        let mut phi0 : f64 = PI_D;
        if (seg == 1) {
            if (reach > 0.000000000001) {
                phi0 = acosD(clampD(nv as f64 * (1.0 - 2.0 * nh2) / reach, -1.0, 1.0));
            } else {
                phi0 = 0.0;
            }
        }
        for (k of 0..order) {
            let phi : f64 = rule.at(k, 0.0, phi0);
            let h : Vec3 = Vec3::make((sh * cosD(phi)) as f32, nh as f32, (sh * sinD(phi)) as f32);
            let vh : f32 = v.dot(h);
            let l : Vec3 = h.scale(2.0 * vh).minus(v);
            let nl : f32 = n.dot(l);
            if (nl > 0.0) {
                let f : Vec3 = lightBrdf(p, n, v, l).specular;
                let d : f64 = lightGgxDD(nh, p.alpha as f64);
                let w : f64 = du
                    * rule.scaled(
                        k,
                        0.0,
                        phi0
                    )
                    * 2.0
                    * 4.0
                    * (nl as f64)
                    * (vh as f64)
                    / (2.0 * PI_D * d * nh);
                sx.add((f.x as f64) * w);
                sy.add((f.y as f64) * w);
                sz.add((f.z as f64) * w);
            }
        }
    }
    return Vec3::make(sx.total() as f32, sy.total() as f32, sz.total() as f32);
}

// The albedo of the shaded diffuse lobe by quadrature over l (cosine-weighted measure t dt dphi, smooth).
fn shadedDiffuse(p : LightPrepared, nv : f32, order : i32) : Vec3 {
    let rule : LightGauss = new LightGauss(order);
    let v : Vec3 = viewAt(nv);
    let n : Vec3 = Vec3::unitY();
    let sx : LightSum = new LightSum();
    let sy : LightSum = new LightSum();
    let sz : LightSum = new LightSum();
    for (i of 0..order) {
        let t : f64 = rule.at(i, 0.0, 1.0);
        let st : f64 = sqrtD(1.0 - t * t);
        for (k of 0..order) {
            let phi : f64 = rule.at(k, 0.0, 2.0 * PI_D);
            let l : Vec3 = Vec3::make((st * cosD(phi)) as f32, t as f32, (st * sinD(phi)) as f32);
            let f : Vec3 = lightBrdf(p, n, v, l).diffuse;
            let w : f64 = rule.scaled(i, 0.0, 1.0) * rule.scaled(k, 0.0, 2.0 * PI_D) * t;
            sx.add((f.x as f64) * w);
            sy.add((f.y as f64) * w);
            sz.add((f.z as f64) * w);
        }
    }
    return Vec3::make(sx.total() as f32, sy.total() as f32, sz.total() as f32);
}

// Brute force over l: a midpoint rule in (cos theta_l, phi), a different domain and method from the table.
fn bruteAlbedo(nv : f64, alpha : f64, n : i32) : f64 {
    let sv : f64 = sqrtD(1.0 - nv * nv);
    let sum : LightSum = new LightSum();
    for (i of 0..n) {
        let t : f64 = ((i as f64) + 0.5) / (n as f64);
        let st : f64 = sqrtD(1.0 - t * t);
        for (k of 0..n) {
            let phi : f64 = 2.0 * PI_D * ((k as f64) + 0.5) / (n as f64);
            let lx : f64 = st * cosD(phi);
            let lz : f64 = st * sinD(phi);
            let hx : f64 = lx + sv;
            let hy : f64 = t + nv;
            let hz : f64 = lz;
            let hl : f64 = sqrtD(hx * hx + hy * hy + hz * hz);
            let nh : f64 = hy / hl;
            sum.add(lightGgxDD(nh, alpha) * lightSmithVD(t, nv, alpha) * t);
        }
    }
    return sum.total() * 2.0 * PI_D / ((n as f64) * (n as f64));
}

/** Checks of the BRDF. */
pub class LightBrdfSuite {
    /** Runs every check of this suite. */
    pub static fn run(c : Checks) : void {
        LightBrdfSuite::terms(c);
        LightBrdfSuite::twins(c);
        LightBrdfSuite::fresnel(c);
        let table : LightDfgTable = new LightDfgTable(32, 96);
        LightBrdfSuite::tableBounds(c, table);
        LightBrdfSuite::tableConvergence(c, table);
        LightBrdfSuite::tableBrute(c);
        LightBrdfSuite::tableLookup(c, table);
        LightBrdfSuite::furnace(c, table);
        LightBrdfSuite::energy(c, table);
        LightBrdfSuite::reciprocity(c, table);
    }

    // D normalisation: its integral over the half-vector hemisphere is one for every alpha.
    static fn terms(c : Checks) : void {
        // integral D (n.h) dwh = 2 pi integral_0^1 D(t) t dt, panels refined towards t = 1 where the spike
        // is.
        let rule : LightGauss = new LightGauss(64);
        let edges : f64[] = new f64[8];
        let mut e : f64[] = edges;
        e[0] = 0.0;
        e[1] = 0.5;
        e[2] = 0.9;
        e[3] = 0.99;
        e[4] = 0.999;
        e[5] = 0.9999;
        e[6] = 0.99999;
        e[7] = 1.0;
        let worstNorm : LightWorst = new LightWorst();
        let alphas : f64[] = new f64[6];
        let mut al : f64[] = alphas;
        al[0] = 0.045;
        al[1] = 0.1;
        al[2] = 0.25;
        al[3] = 0.5;
        al[4] = 0.8;
        al[5] = 1.0;
        for (ai of 0..6) {
            let alpha : f64 = al[ai as i64];
            let sum : LightSum = new LightSum();
            for (seg of 0..7) {
                for (i of 0..64) {
                    let t : f64 = rule.at(i, e[seg as i64], e[(seg + 1) as i64]);
                    sum.add(rule.scaled(
                        i,
                        e[seg as i64],
                        e[(seg + 1) as i64]
                    )
                        * lightGgxDD(t, alpha)
                        * t);
                }
            }
            worstNorm.note(sum.total() * 2.0 * PI_D - 1.0, "alpha ${alpha}");
        }
        worstNorm.within(
            c,
            "GGX normalisation: 2 pi integral D (n.h) = 1, alpha 0.045..1",
            LIGHT_TOL
        );
    }

    // Symmetry of V and the f32/f64 twins, over a seeded sweep.
    static fn twins(c : Checks) : void {
        let rng : Pcg32 = new Pcg32(31, 1);
        let sym : LightWorst = new LightWorst();
        let twinD : LightWorst = new LightWorst();
        let twinV : LightWorst = new LightWorst();
        let twinF : LightWorst = new LightWorst();
        for (k of 0..4000) {
            let a : f32 = rng.rangeF32(LIGHT_ALPHA_MIN, 1.0);
            let x : f32 = rng.rangeF32(0.0001, 1.0);
            let y : f32 = rng.rangeF32(0.0001, 1.0);
            sym.note(
                lightRel(lightSmithV(x, y, a) as f64, lightSmithV(y, x, a) as f64, LIGHT_TOL_ULP),
                "V sym ${x}"
            );
            twinD.note(
                lightRel(lightGgxD(x, a) as f64, lightGgxDD(x as f64, a as f64), LIGHT_TOL),
                "D x ${x} a ${a}"
            );
            twinV.note(
                lightRel(
                    lightSmithV(x, y, a) as f64,
                    lightSmithVD(x as f64, y as f64, a as f64),
                    LIGHT_TOL
                ),
                "V ${x}"
            );
            twinF.note(
                lightRel(lightFresnelWeight(x) as f64, lightFresnelWeightD(x as f64), LIGHT_TOL),
                "F ${x}"
            );
        }
        sym.within(c, "V(n.l, n.v) = V(n.v, n.l), relative", LIGHT_TOL);
        twinD.within(c, "D f32 vs f64, relative, 4000 draws", 0.000004);
        twinV.within(c, "V f32 vs f64, relative, 4000 draws", 0.000004);
        twinF.within(c, "Fresnel weight f32 vs f64, relative, 4000 draws", 0.000004);
    }

    // Fresnel limits and monotonicity, and the alpha floor.
    static fn fresnel(c : Checks) : void {
        let f0 : Vec3 = Vec3::make(0.04, 0.5, 0.9);
        let grazing : Vec3 = lightFresnel(f0, 0.0);
        c.that(
            "Fresnel -> 1 at grazing ${lightText(grazing)}",
            grazing.approxEq(Vec3::splat(1.0), 0.0)
        );
        c.that("Fresnel = F0 at normal incidence", lightFresnel(f0, 1.0).approxEq(f0, 0.0));
        let mut ok : bool = true;
        let mut prev : Vec3 = lightFresnel(f0, 1.0);
        let mut vh : f32 = 1.0;
        while (vh > 0.0) {
            let f : Vec3 = lightFresnel(f0, vh);
            if (f.x < prev.x || f.y < prev.y || f.z < prev.z) {
                ok = false;
            }
            prev = f;
            vh = vh - (0.01 as f32);
        }
        c.that("Fresnel increases monotonically from normal to grazing", ok);
        c.near("alpha is floored", lightAlpha(0.0) as f64, LIGHT_ALPHA_MIN as f64, 0.0);
        c.near(
            "alpha is roughness squared above the floor",
            lightAlpha(0.8) as f64,
            0.64,
            LIGHT_TOL_ULP
        );
    }

    // The table: nonnegative, at most 1, and white at the sharpest lobe keeps its energy.
    static fn tableBounds(c : Checks, table : LightDfgTable) : void {
        let n : i32 = table.size();
        let mut minE : f64 = 1.0;
        let mut maxE : f64 = 0.0;
        let mut bad : i32 = 0;
        for (j of 0..n) {
            for (i of 0..n) {
                let e : LightDfg = table.node(i, j);
                let sum : f64 = (e.a + e.b) as f64;
                if (e.a < 0.0 || e.b < 0.0 || sum > 1.0) {
                    bad = bad + 1;
                }
                if (sum > maxE) {
                    maxE = sum;
                }
                if (sum < minE) {
                    minE = sum;
                }
            }
        }
        c.sameInt("table entries are nonnegative with A + B <= 1 (violations)", bad as i64, 0);
        println("  measured table E range over 32x32 nodes: ${minE} .. ${maxE}");
        c.that(
            "white at the sharpest lobe keeps almost all energy (1 - eps)",
            table.node(n - 1, 0).a + table.node(n - 1, 0).b > 0.97
        );
    }

    // The table is converged: order 96 against order 220 at every third node.
    static fn tableConvergence(c : Checks, table : LightDfgTable) : void {
        let n : i32 = table.size();
        let conv : LightWorst = new LightWorst();
        for (j of 0..n) {
            for (i of 0..n) {
                if ((i + j) % 3 == 0) {
                    let r : f64 = (j as f64) / ((n - 1) as f64);
                    let fine : LightDfg = LightDfgTable::integrate(
                        LightDfgTable::cosineAt(i, n),
                        LightDfgTable::alphaOf(r),
                        220
                    );
                    let e : LightDfg = table.node(i, j);
                    conv.note((e.a - fine.a) as f64, "A node ${i},${j}");
                    conv.note((e.b - fine.b) as f64, "B node ${i},${j}");
                }
            }
        }
        conv.within(
            c,
            "table order 96 vs order 220 at 1/3 of the nodes (A and B), worst at the grazing floor",
            LIGHT_TOL_COARSE
        );
    }

    // Brute force over l at moderate alpha: A + B for F = 1.
    static fn tableBrute(c : Checks) : void {
        let brute : LightWorst = new LightWorst();
        let mut nvs : f64[] = new f64[4];
        nvs[0] = 0.2;
        nvs[1] = 0.5;
        nvs[2] = 0.8;
        nvs[3] = 1.0;
        let mut alphas : f64[] = new f64[3];
        alphas[0] = 0.09;
        alphas[1] = 0.3;
        alphas[2] = 1.0;
        for (a of 0..3) {
            for (m of 0..4) {
                let nv : f64 = nvs[m as i64];
                let alpha : f64 = alphas[a as i64];
                let direct : f64 = bruteAlbedo(nv, alpha, 1500);
                let pair : LightDfg = LightDfgTable::integrate(nv, alpha, 48);
                brute.note(
                    direct - ((pair.a + pair.b) as f64),
                    "nv ${nv} alpha ${alpha}"
                );
            }
        }
        brute.within(
            c,
            "half-vector quadrature vs brute-force midpoint over l, alpha 0.09..1",
            0.002
        );
    }

    // Lookup between nodes against direct quadrature.
    static fn tableLookup(c : Checks, table : LightDfgTable) : void {
        let n : i32 = table.size();
        let rng : Pcg32 = new Pcg32(5, 77);
        let look : LightWorst = new LightWorst();
        for (k of 0..60) {
            let nv : f32 = rng.rangeF32(0.05, 1.0);
            let r : f32 = rng.rangeF32(0.0, 1.0);
            let got : LightDfg = table.lookup(nv, r);
            let want : LightDfg = LightDfgTable::integrate(
                nv as f64,
                LightDfgTable::alphaOf(r as f64),
                48
            );
            look.note(
                (got.a + got.b - want.a - want.b) as f64,
                "nv ${nv} r ${r}"
            );
        }
        look.within(c, "bilinear lookup vs direct quadrature of E, 60 off-grid points", 0.004);
        let corner : LightDfg = table.lookup(1.0, 1.0);
        c.that("lookup at the last node returns the node", corner.a == table.node(n - 1, n - 1).a);
    }

    // White furnace: albedo 1, uniform environment L = 1 => Lo = 1, through the real shading code.
    static fn furnace(c : Checks, table : LightDfgTable) : void {
        let worst : LightWorst = new LightWorst();
        let worstMetal : LightWorst = new LightWorst();
        let n : i32 = table.size();
        for (j of 0..n) {
            if (j % 5 == 0) {
                for (i of 1..n) {
                    if (i % 4 == 0) {
                        let r : f32 = (j as f32) / ((n - 1) as f32);
                        let nv : f32 = LightDfgTable::cosineAt(i, n) as f32;
                        let white : LightMaterial = LightMaterial {
                            baseColor: Vec3::splat(1.0),
                            metallic: 0.0,
                            roughness: r,
                        };
                        let p : LightPrepared = lightPrepare(white, table.node(i, j));
                        let total : Vec3 = shadedSpecular(p, nv, 48).plus(shadedDiffuse(p, nv, 24));
                        worst.note((total.x - 1.0) as f64, "dielectric nv ${nv} r ${r}");
                        worst.note((total.z - 1.0) as f64, "dielectric nv ${nv} r ${r}");
                        let metal : LightMaterial = LightMaterial {
                            baseColor: Vec3::splat(1.0),
                            metallic: 1.0,
                            roughness: r,
                        };
                        let pm : LightPrepared = lightPrepare(metal, table.node(i, j));
                        let tm : Vec3 = shadedSpecular(pm, nv, 48).plus(shadedDiffuse(pm, nv, 24));
                        worstMetal.note((tm.y - 1.0) as f64, "metal nv ${nv} r ${r}");
                    }
                }
            }
        }
        worst.within(
            c,
            "white furnace, white dielectric: Lo = 1 on table nodes (every 5th row, 4th column)",
            0.001
        );
        worstMetal.within(
            c,
            "white furnace, metal with F0 = 1: Lo = 1 (multiple scattering restores the lost energy)",
            0.001
        );
        // Without compensation the same metal loses energy: the compensation is doing the work.
        let metal : LightMaterial = LightMaterial {
            baseColor: Vec3::splat(1.0),
            metallic: 1.0,
            roughness: 1.0,
        };
        let mut raw : LightPrepared = lightPrepare(metal, table.node(16, 31));
        raw.compensation = Vec3::splat(1.0);
        let lost : Vec3 = shadedSpecular(raw, LightDfgTable::cosineAt(16, 32) as f32, 48);
        c.that(
            "uncompensated rough metal loses at least 10% in the furnace (so the test can fail)",
            lost.y < 0.9
        );
    }

    // Energy <= 1 for random materials and views, per channel; Burley bound; compensation sanity.
    static fn energy(c : Checks, table : LightDfgTable) : void {
        let rng : Pcg32 = new Pcg32(99, 4);
        let worst : LightWorst = new LightWorst();
        let burley : LightWorst = new LightWorst();
        let mut over : f64 = -1.0;
        let mut burleyOver : f64 = -1.0;
        for (k of 0..24) {
            let nv : f32 = rng.rangeF32(0.1, 1.0);
            let r : f32 = rng.rangeF32(0.0, 1.0);
            let m : LightMaterial = LightMaterial {
                baseColor: Vec3::make(rng.nextF32(), rng.nextF32(), rng.nextF32()),
                metallic: rng.nextF32(),
                roughness: r,
            };
            let p : LightPrepared = lightPrepare(m, table.lookup(nv, r));
            let total : Vec3 = shadedSpecular(p, nv, 32).plus(shadedDiffuse(p, nv, 16));
            let top : f64 = total.maxComponent() as f64;
            if (top > over || over < 0.0) {
                over = top;
            }
            worst.note(top, "k ${k}");
            let mut b : LightMaterial = m;
            b.diffuseModel = LightDiffuseModel::Burley;
            b.baseColor = Vec3::splat(1.0);
            b.metallic = 0.0;
            let pb : LightPrepared = lightPrepare(b, table.lookup(nv, r));
            let d : Vec3 = shadedDiffuse(pb, nv, 16);
            let lam : LightMaterial = LightMaterial {
                baseColor: Vec3::splat(1.0),
                metallic: 0.0,
                roughness: r,
            };
            let pl : LightPrepared = lightPrepare(lam, table.lookup(nv, r));
            let dl : Vec3 = shadedDiffuse(pl, nv, 16);
            burley.note((d.x / dl.x) as f64 - 1.0, "r ${r} nv ${nv}");
            if ((d.x / dl.x) as f64 > burleyOver) {
                burleyOver = (d.x / dl.x) as f64;
            }
        }
        println("  measured max total albedo of 24 random materials (must be <= 1): ${over}");
        c.that(
            "directional albedo of diffuse + specular is <= 1 + 1e-3 for 24 random materials/views",
            over <= 1.001
        );
        println("  measured Burley albedo relative to Lambert: max ratio ${burleyOver}");
        c.that(
            "normalised Burley never exceeds Lambert's albedo by more than 5%",
            burleyOver <= 1.05
        );
        // Compensation: 1 for F0 = 0, > 1 for a rough metal.
        let rough : LightMaterial = LightMaterial {
            baseColor: Vec3::splat(1.0),
            metallic: 1.0,
            roughness: 1.0,
        };
        let comp : LightPrepared = lightPrepare(rough, table.node(16, 31));
        c.that("rough white metal is boosted by multiple scattering", comp.compensation.x > 1.05);
        let black : LightMaterial = LightMaterial {
            baseColor: Vec3::zero(),
            metallic: 1.0,
            roughness: 1.0,
        };
        c.near(
            "F0 = 0 gets no compensation",
            lightPrepare(black, table.node(16, 31)).compensation.x as f64,
            1.0,
            0.0
        );
        let smooth : LightPrepared = lightPrepare(rough, table.node(16, 0));
        c.that("the sharpest lobe needs little compensation", smooth.compensation.x < 1.05);
    }

    // Reciprocity of the specular lobe (and Lambert) at random directions.
    static fn reciprocity(c : Checks, table : LightDfgTable) : void {
        let rng : Pcg32 = new Pcg32(8, 8);
        let worst : LightWorst = new LightWorst();
        let n : Vec3 = Vec3::unitY();
        for (k of 0..3000) {
            let r : f32 = rng.rangeF32(0.0, 1.0);
            let m : LightMaterial = LightMaterial {
                baseColor: Vec3::make(rng.nextF32(), rng.nextF32(), rng.nextF32()),
                metallic: rng.nextF32(),
                roughness: r,
            };
            // The compensation depends on the view only, so reciprocity is checked on one prepared material
            // (the lobe D V F is symmetric; the view-dependent weights are constants of the pair here).
            let p : LightPrepared = lightPrepare(m, table.lookup(0.5, r));
            let l : Vec3 = Vec3::make(
                rng.rangeF32(-1.0, 1.0),
                rng.rangeF32(0.05, 1.0),
                rng.rangeF32(-1.0, 1.0)
            ).normalized();
            let v : Vec3 = Vec3::make(
                rng.rangeF32(-1.0, 1.0),
                rng.rangeF32(0.05, 1.0),
                rng.rangeF32(-1.0, 1.0)
            ).normalized();
            let a : LightBrdfTerms = lightBrdf(p, n, v, l);
            let b : LightBrdfTerms = lightBrdf(p, n, l, v);
            worst.note(
                lightRel(a.specular.y as f64, b.specular.y as f64, LIGHT_TOL_COARSE),
                "k ${k}"
            );
            worst.note(
                lightRel(a.diffuse.y as f64, b.diffuse.y as f64, LIGHT_TOL_COARSE),
                "k ${k}"
            );
        }
        worst.within(
            c,
            "reciprocity f(l,v) = f(v,l) for the specular lobe and Lambert, 3000 draws, relative",
            LIGHT_TOL_LOOSE
        );
        let below : LightBrdfTerms = lightBrdf(
            lightPrepare(LightMaterial {}, LightDfg { a: 0.5, b: 0.1 }),
            n,
            Vec3::unitY(),
            Vec3::make(0.0, -1.0, 0.0)
        );
        c.near(
            "light below the horizon gives no BRDF",
            below.specular.x as f64 + below.diffuse.x as f64,
            0.0,
            0.0
        );
    }
}

// regress_support — the fingerprint the regression suites fold every output into: FNV-1a 64 over exact bits.
//
// The regression suites pin what a kernel computes, not what it should compute: an optimisation that keeps the
// engine's results changes none of their numbers, and one that moves a single bit of a single output changes a
// fingerprint. Axle has no reinterpreting cast for one float, so the bits of an f32 are read through a lane of
// `i32x8.reinterpret`, as dusk's measure code does; an f64 is folded as the three f32 that sum to it exactly (high,
// middle and low parts), which keep all its 53 bits for every value the suites hash.
//
// To update a golden pin: a failing check prints `got` and `want`; paste the new value only after deciding that the
// change of picture is intended.

use ludax::Vec3;

const RG_FNV_BASIS : i64 = -3750763034362895579;
const RG_FNV_PRIME : i64 = 1099511628211;

/** A running FNV-1a 64 fingerprint of whole numbers and the exact bits of reals. */
pub class RegressHash {
    h     : i64 = RG_FNV_BASIS;
    lane  : f32[];
    words : i32[];

    /** An empty fingerprint. */
    constructor() {
        self.lane = new f32[8];
        self.words = new i32[8];
    }

    /** Folds the whole number `v`. */
    pub fn int(mut self, v : i64) : void {
        self.h = (self.h ^ v) * RG_FNV_PRIME;
    }

    /** Folds the 32 bits of `v`. */
    pub fn real(mut self, v : f32) : void {
        self.lane[0] = v;
        i32x8.reinterpret(f32x8.load(self.lane, 0)).store(self.words, 0);
        self.h = (self.h ^ (self.words[0] as i64)) * RG_FNV_PRIME;
    }

    /** Folds the 53 bits of `v` as the three f32 parts that sum to it. */
    pub fn wide(mut self, v : f64) : void {
        let high : f32 = v as f32;
        let rest : f64 = v - (high as f64);
        let middle : f32 = rest as f32;
        let low : f32 = (rest - (middle as f64)) as f32;
        self.real(high);
        self.real(middle);
        self.real(low);
    }

    /** Folds the three components of `v`. */
    pub fn vec(mut self, v : Vec3) : void {
        self.real(v.x);
        self.real(v.y);
        self.real(v.z);
    }

    /** Folds the first `n` reals of `values`. */
    pub fn reals(mut self, values : f32[], n : i64) : void {
        for (i of 0..n) {
            self.real(values[i]);
        }
    }

    /** Folds the first `n` whole numbers of `values`. */
    pub fn ints(mut self, values : i32[], n : i64) : void {
        for (i of 0..n) {
            self.int(values[i] as i64);
        }
    }

    /** The fingerprint so far. */
    pub fn value(self) : i64 {
        return self.h;
    }

    /** The 32 bits of `v`, as a whole number: an exact spot check of one output. */
    pub static fn bits(v : f32) : i64 {
        let mut lane : f32[] = new f32[8];
        let words : i32[] = new i32[8];
        lane[0] = v;
        i32x8.reinterpret(f32x8.load(lane, 0)).store(words, 0);
        return words[0] as i64;
    }
}

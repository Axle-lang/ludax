// voxlight_dda — the ray walk against a brute-force reference.
//
// The reference tests every cell of the ray's bounding box with the slab method (a different computation:
// it divides per cell instead of accumulating steps), keeps the cells the ray spends positive length in,
// and sorts them by entry distance. The walker must produce exactly that list.

use ludax::{Checks, Pcg32, VoxelDda, voxFloor};

// The distances at which the ray enters and leaves cell (x, y, z) (slab method); out.0 > out.1 when it misses.
class BruteCell {
    /** Entry distance of the ray into the cell. */
    pub tIn : f64 = 0.0;

    /** Exit distance of the ray from the cell; below `tIn` when it misses. */
    pub tOut : f64 = 0.0;

    constructor() {}

    // One axis of the slab test: narrows [tIn, tOut] to where `o + t * d` is inside [lo, lo + 1].
    fn axis(mut self, o : f64, d : f64, lo : i32) : void {
        if (d == 0.0) {
            if (o < lo as f64 || o > (lo + 1) as f64) {
                self.tIn = 1.0;
                self.tOut = 0.0;
            }
            return;
        }
        let a : f64 = (lo as f64 - o) / d;
        let b : f64 = ((lo + 1) as f64 - o) / d;
        let mut near : f64 = a;
        let mut far : f64 = b;
        if (a > b) {
            near = b;
            far = a;
        }
        if (near > self.tIn) {
            self.tIn = near;
        }
        if (far < self.tOut) {
            self.tOut = far;
        }
    }

    /** Resets the walk to the ray from `o` along `d`, for the cell at `x, y, z`. */
    pub fn cell(
        mut self,
        ox : f64,
        oy : f64,
        oz : f64,
        dx : f64,
        dy : f64,
        dz : f64,
        x : i32,
        y : i32,
        z : i32
    ) : void {
        self.tIn = 0.0;
        self.tOut = 1000000.0;
        self.axis(ox, dx, x);
        self.axis(oy, dy, y);
        self.axis(oz, dz, z);
    }
}

/** The DDA checks: the walker must visit exactly the cells the brute-force list names. */
pub class VoxLightDdaSuite {
    // Compares the walker with the brute-force list for one ray over distance `reach`. Returns the number of
    // disagreements.
    static fn compare(
        ox : f64,
        oy : f64,
        oz : f64,
        dx : f64,
        dy : f64,
        dz : f64,
        reach : f64
    ) : i32 {
        let mut bad : i32 = 0;
        // Brute force: collect (tIn, x, y, z) of every cell the segment crosses.
        let lox : i32 = voxFloor(ox + dx * reach);
        let loy : i32 = voxFloor(oy + dy * reach);
        let loz : i32 = voxFloor(oz + dz * reach);
        let mut x0 : i32 = voxFloor(ox);
        let mut x1 : i32 = lox;
        if (x1 < x0) {
            x0 = lox;
            x1 = voxFloor(ox);
        }
        let mut y0 : i32 = voxFloor(oy);
        let mut y1 : i32 = loy;
        if (y1 < y0) {
            y0 = loy;
            y1 = voxFloor(oy);
        }
        let mut z0 : i32 = voxFloor(oz);
        let mut z1 : i32 = loz;
        if (z1 < z0) {
            z0 = loz;
            z1 = voxFloor(oz);
        }
        let cap : i32 = (x1 - x0 + 1) * (y1 - y0 + 1) * (z1 - z0 + 1);
        let mut ts : f64[] = malloc<f64>(cap as i64);
        let mut cs : i32[] = malloc<i32>(cap as i64 * 3);
        let mut n : i32 = 0;
        let probe : BruteCell = new BruteCell();
        for (z of z0..z1 + 1) {
            for (y of y0..y1 + 1) {
                for (x of x0..x1 + 1) {
                    probe.cell(ox, oy, oz, dx, dy, dz, x, y, z);
                    if (probe.tOut - probe.tIn > 0.000000001 && probe.tIn < reach) {
                        // Insertion sort by entry distance.
                        let mut at : i32 = n;
                        while (at > 0 && ts[at - 1] > probe.tIn) {
                            ts[at] = ts[at - 1];
                            cs[at * 3] = cs[(at - 1) * 3];
                            cs[at * 3 + 1] = cs[(at - 1) * 3 + 1];
                            cs[at * 3 + 2] = cs[(at - 1) * 3 + 2];
                            at = at - 1;
                        }
                        ts[at] = probe.tIn;
                        cs[at * 3] = x;
                        cs[at * 3 + 1] = y;
                        cs[at * 3 + 2] = z;
                        n = n + 1;
                    }
                }
            }
        }
        let walk : VoxelDda = new VoxelDda();
        walk.start(ox, oy, oz, dx, dy, dz);
        let mut seen : i32 = 0;
        while (walk.entryT() < reach) {
            if (seen >= n) {
                bad = bad + 1;
                break;
            }
            let dt : f64 = walk.entryT() - ts[seen];
            if (walk.x() != cs[seen * 3] || walk.y() != cs[seen * 3 + 1]
                || walk.z() != cs[seen * 3 + 2]) {
                bad = bad + 1;
            }
            if (dt > 0.000001 || dt < -0.000001) {
                bad = bad + 1;
            }
            seen = seen + 1;
            walk.advance();
        }
        if (seen != n) {
            bad = bad + 1;
        }
        return bad;
    }

    /** Runs every check. */
    pub static fn run(c : Checks) : void {
        let rng : Pcg32 = new Pcg32(7, 3);
        let mut bad : i32 = 0;
        let mut rays : i32 = 0;
        for (i of 0..3000) {
            let ox : f64 = (rng.nextF64() - 0.5) * 40.0;
            let oy : f64 = (rng.nextF64() - 0.5) * 40.0;
            let oz : f64 = (rng.nextF64() - 0.5) * 40.0;
            let mut dx : f64 = rng.nextF64() - 0.5;
            let mut dy : f64 = rng.nextF64() - 0.5;
            let mut dz : f64 = rng.nextF64() - 0.5;
            // Every eighth ray has a zero component: the axis-parallel case.
            if (i % 8 == 1) {
                dy = 0.0;
            }
            if (i % 8 == 2) {
                dx = 0.0;
                dz = 0.0;
                dy = dy + 0.1;
            }
            let len : f64 = (dx * dx + dy * dy + dz * dz).sqrt();
            if (len < 0.01) {
                continue;
            }
            bad = bad + VoxLightDdaSuite::compare(ox, oy, oz, dx / len, dy / len, dz / len, 30.0);
            rays = rays + 1;
        }
        c.sameInt("3000 random rays walk exactly the brute-force cells (disagreements)", bad, 0);
        c.that("enough rays were compared", rays > 2900);

        // The tie rule: through a corner, x then y.
        let corner : VoxelDda = new VoxelDda();
        let h : f64 = 0.70710678118654752;
        corner.start(0.5, 0.5, 0.5, h, h, 0.0);
        corner.advance();
        c.that("corner pass visits (1,0,0) first", corner.x() == 1 && corner.y() == 0);
        corner.advance();
        c.that("then (1,1,0)", corner.x() == 1 && corner.y() == 1);

        // Negative directions and negative coordinates.
        let neg : VoxelDda = new VoxelDda();
        neg.start(-0.5, -0.5, -0.5, -1.0, 0.0, 0.0);
        neg.advance();
        c.sameInt("walking to -x from (-1,-1,-1) lands on x=-2", neg.x(), -2);
        c.sameInt("entered through the +x face", neg.entryFace(), 0);
        c.near("entry distance", neg.entryT(), 0.5, 0.000000001);
    }
}

// runtime_settings — checks for typed settings, the text format and the command line.
//
// Declared limits must hold whatever the source of a value; the text format must round-trip; and malformed
// input must be reported at the right line and column without losing the lines that were fine.

use ludax::ArgList;
use ludax::Checks;
use ludax::ParseReport;
use ludax::Settings;
use ludax::SettingsText;
use ludax::TextScan;
use ludax::TextWords;
use ludax::SETTING_INT;
use ludax::SETTING_TEXT;

fn setMake() : Settings {
    let s : Settings = new Settings();
    s.defineInt("graphics.width", 1280, 320, 7680);
    s.defineInt("graphics.height", 720, 200, 4320);
    s.defineBool("graphics.vsync", true);
    s.defineReal("audio.master", 0.8, 0.0, 1.0);
    s.defineText("player.name", "Anon", 16);
    s.defineInt("seed", 42, 0, 1000000);
    return s;
}

/** The settings checks. */
pub class RuntimeSettingsSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        setDeclare(c);
        setValidate(c);
        setVersion(c);
        setText(c);
        setMalformed(c);
        setArgs(c);
        setScan(c);
    }
}

fn setDeclare(c : Checks) : void {
    let s : Settings = setMake();
    c.sameInt("settings: six settings declared", s.count(), 6);
    c.sameInt("settings: int default", s.getInt("graphics.width", -1), 1280);
    c.that("settings: bool default", s.getBool("graphics.vsync", false));
    c.near("settings: real default", s.getReal("audio.master", -1.0), 0.8, 0.0);
    c.that("settings: text default", s.getText("player.name", "?") == "Anon");
    c.sameInt("settings: kind of an int", s.kindOf("seed"), SETTING_INT);
    c.sameInt("settings: kind of a text", s.kindOf("player.name"), SETTING_TEXT);
    c.sameInt("settings: kind of nothing", s.kindOf("nothing"), -1);
    c.that("settings: a repeated key is refused", !s.defineInt("seed", 1, 0, 2));
    c.that("settings: a default outside the range is refused", !s.defineInt("x.y", 5, 0, 2));
    c.that("settings: an empty range is refused", !s.defineInt("x.z", 1, 3, 2));
    c.that("settings: a key with a space is refused", !s.defineBool("bad key", true));
    c.that("settings: a key ending in a dot is refused", !s.defineBool("bad.", true));
    c.that("settings: a key with an empty part is refused", !s.defineBool("a..b", true));
    c.that("settings: a quote in a default text is refused", !s.defineText("t.q", "a\"b", 8));
    c.that(
        "settings: a default text over its limit is refused",
        !s.defineText("t.long", "abcdef", 3)
    );
    c.sameInt("settings: nothing refused was declared", s.count(), 6);
    c.sameInt("settings: sections in order of first declaration", s.sectionCount(), 4);
    c.that(
        "settings: section names",
        s.sectionName(0) == "graphics" && s.sectionName(1) == "audio"
            && s.sectionName(2) == "player"
            && s.sectionName(3) == ""
    );
    c.that("settings: a missing key reads as the fallback", s.getInt("nope", 77) == 77);
    c.that("settings: the wrong type reads as the fallback", s.getInt("graphics.vsync", 5) == 5);
}

fn setValidate(c : Checks) : void {
    let s : Settings = setMake();
    c.that("settings: an in-range int is accepted", s.setInt("graphics.width", 1920));
    c.sameInt("settings: and stored", s.getInt("graphics.width", 0), 1920);
    c.that("settings: below the range is refused", !s.setInt("graphics.width", 100));
    c.that("settings: above the range is refused", !s.setInt("graphics.width", 99999));
    c.sameInt("settings: a refused value changes nothing", s.getInt("graphics.width", 0), 1920);
    c.that(
        "settings: the range ends are inclusive",
        s.setInt("graphics.width", 320) && s.setInt("graphics.width", 7680)
    );
    c.that("settings: setting an undeclared key is refused", !s.setInt("nope", 1));
    c.that(
        "settings: setting the wrong type is refused",
        !s.setInt("graphics.vsync", 1) && !s.setBool("seed", true)
    );
    c.that("settings: a real in range", s.setReal("audio.master", 0.25));
    c.that("settings: a real above the range is refused", !s.setReal("audio.master", 1.5));
    c.that(
        "settings: a real range includes the ends",
        s.setReal("audio.master", 1.0) && s.setReal("audio.master", 0.0)
    );
    c.that("settings: text within the limit", s.setText("player.name", "Bartholomew"));
    c.that(
        "settings: text over the limit is refused",
        !s.setText("player.name", "A name that is far too long")
    );
    c.that("settings: text with a quote is refused", !s.setText("player.name", "a\"b"));
    c.that("settings: the old text stays", s.getText("player.name", "") == "Bartholomew");
    c.that(
        "settings: isDefault is false after a change",
        !s.isDefault("player.name") && !s.isDefault("audio.master")
    );
    c.that("settings: isDefault is true for an untouched key", s.isDefault("seed"));
    c.that(
        "settings: reset restores the default",
        s.reset("player.name") && s.getText("player.name", "") == "Anon"
            && s.isDefault("player.name")
    );
    c.that("settings: reset of an unknown key is false", !s.reset("zzz"));
    s.resetAll();
    c.that("settings: resetAll", s.isDefault("graphics.width") && s.isDefault("audio.master"));
}

fn setVersion(c : Checks) : void {
    let s : Settings = setMake();
    let v0 : i64 = s.version();
    c.that("settings: a new set is unchanged", !s.changedSince(v0));
    s.setInt("seed", 42);
    c.that("settings: setting the same value is not a change", !s.changedSince(v0));
    s.setInt("seed", 7);
    c.that("settings: a new value is a change", s.changedSince(v0));
    c.sameInt("settings: the version counts changes", s.version(), v0 + 1);
    let v1 : i64 = s.version();
    s.setInt("seed", 5000000);
    c.that("settings: a refused value is not a change", !s.changedSince(v1));
    s.setBool("graphics.vsync", false);
    s.setText("player.name", "Zed");
    s.setReal("audio.master", 0.1);
    c.sameInt("settings: every kind counts", s.version(), v1 + 3);
    let v2 : i64 = s.version();
    s.reset("seed");
    c.sameInt("settings: a reset that changes counts", s.version(), v2 + 1);
    s.reset("seed");
    c.sameInt("settings: a reset that changes nothing does not", s.version(), v2 + 1);
}

fn setText(c : Checks) : void {
    let s : Settings = setMake();
    let text : string = "# graphics\n[graphics]\nwidth = 1920   # wide\nheight=1080\nvsync = off\n\n[audio]\nmaster = 0.35\n[player]\nname = \"Ada Lovelace\"\n[]\n";
    let r : ParseReport = SettingsText::read(s, text);
    c.sameInt("settings text: only the empty section header is a problem", r.count(), 1);
    c.sameInt("settings text: that problem is on line 11", r.lineAt(0), 11);
    c.sameInt("settings text: int with a trailing comment", s.getInt("graphics.width", 0), 1920);
    c.sameInt("settings text: no spaces around =", s.getInt("graphics.height", 0), 1080);
    c.that("settings text: off is false", !s.getBool("graphics.vsync", true));
    c.near("settings text: real", s.getReal("audio.master", 0.0), 0.35, 0.0);
    c.that(
        "settings text: quoted text keeps its space",
        s.getText("player.name", "") == "Ada Lovelace"
    );

    let out : string = SettingsText::write(s);
    let expected : string = "seed = 42\n\n[graphics]\nwidth = 1920\nheight = 1080\nvsync = false\n\n[audio]\nmaster = 0.35\n\n[player]\nname = \"Ada Lovelace\"\n";
    c.that(
        "settings text: the writer prints the unnamed section first, then the others in declaration order",
        out == expected
    );

    let again : Settings = setMake();
    let r2 : ParseReport = SettingsText::read(again, out);
    c.that("settings text: what was written reads without a problem", r2.ok());
    c.that("settings text: and writes the same text", SettingsText::write(again) == out);
    c.sameInt("settings text: and gives the same values", again.getInt("graphics.width", 0), 1920);

    let defaults : Settings = setMake();
    c.that(
        "settings text: default settings round-trip",
        SettingsText::write(defaults) == SettingsText::write(roundTrip(defaults))
    );

    let w : Settings = setMake();
    SettingsText::read(w, "seed = 1\nseed = 2\n");
    c.sameInt("settings text: a later line wins", w.getInt("seed", 0), 2);
    let hash : Settings = setMake();
    SettingsText::read(hash, "player.name = \"a # b\"  # real comment\n");
    c.that(
        "settings text: a # inside quotes is not a comment",
        hash.getText("player.name", "") == "a # b"
    );
    let dotted : Settings = setMake();
    SettingsText::read(dotted, "graphics.width = 640\n");
    c.sameInt(
        "settings text: a dotted key outside a section",
        dotted.getInt("graphics.width", 0),
        640
    );
    let win : Settings = setMake();
    let rw : ParseReport = SettingsText::read(win, "[graphics]\r\nwidth = 800\r\n");
    c.that(
        "settings text: Windows line endings",
        rw.ok() && win.getInt("graphics.width", 0) == 800
    );
    let empty : ParseReport = SettingsText::read(setMake(), "");
    c.that("settings text: an empty file is fine", empty.ok());
}

fn roundTrip(s : Settings) : Settings {
    let t : Settings = setMake();
    SettingsText::read(t, SettingsText::write(s));
    return t;
}

fn setMalformed(c : Checks) : void {
    let s : Settings = setMake();
    let bad : string = "[graphics]\r\nwidth 100\r\n= 5\r\nwidth =\r\nwidth = abc\r\nwidth = 99999999\r\nvsync = maybe\r\nnope = 1\r\nname = \"open\r\n[bad name]\r\n[graphics\r\nwidth = 640\r\n";
    let r : ParseReport = SettingsText::read(s, bad);
    c.sameInt("settings bad: every broken line is reported", r.count(), 10);
    c.that("settings bad: missing = on line 2", r.lineAt(0) == 2 && r.columnAt(0) == 10);
    c.that("settings bad: missing name on line 3", r.lineAt(1) == 3 && r.columnAt(1) == 1);
    c.that(
        "settings bad: missing value on line 4, column after =",
        r.lineAt(2) == 4 && r.columnAt(2) == 8
    );
    c.that(
        "settings bad: a word is no int, column of the value",
        r.lineAt(3) == 5 && r.columnAt(3) == 9
    );
    c.that(
        "settings bad: out of range, reported with the range",
        r.lineAt(4) == 6 && r.messageAt(4) == "'graphics.width' must be between 320 and 7680"
    );
    c.that("settings bad: not a bool", r.lineAt(5) == 7);
    c.that("settings bad: unknown key, column of the key", r.lineAt(6) == 8 && r.columnAt(6) == 1);
    c.that(
        "settings bad: unterminated quote, column of the quote",
        r.lineAt(7) == 9 && r.columnAt(7) == 8
    );
    c.that("settings bad: a bad section name", r.lineAt(8) == 10 && r.columnAt(8) == 2);
    c.that("settings bad: an unclosed section header", r.lineAt(9) == 11 && r.columnAt(9) == 10);
    c.that(
        "settings bad: describe reads well",
        r.describe(0) == "line 2, column 10: expected 'key = value'"
    );
    c.that("settings bad: hasLine", r.hasLine(2) && !r.hasLine(12) && !r.hasLine(1));
    c.sameInt(
        "settings bad: a good line after the bad ones still applies",
        s.getInt("graphics.width", 0),
        640
    );
    c.that("settings bad: the refused bool kept its default", s.getBool("graphics.vsync", false));
    c.sameInt("settings bad: no change was counted for the refused values", s.version(), 1);
}

fn setArgs(c : Checks) : void {
    let s : Settings = setMake();
    c.that(
        "settings args: key=value",
        SettingsText::applyArg(s, "--graphics.vsync=false") == ""
            && !s.getBool("graphics.vsync", true)
    );
    c.that(
        "settings args: int",
        SettingsText::applyArg(s, "--graphics.width=2560") == ""
            && s.getInt("graphics.width", 0) == 2560
    );
    c.that(
        "settings args: a bare switch turns it on",
        SettingsText::applyArg(s, "--graphics.vsync") == "" && s.getBool("graphics.vsync", false)
    );
    c.that(
        "settings args: a bare non-switch needs a value",
        SettingsText::applyArg(s, "--seed") != ""
    );
    c.that(
        "settings args: an unknown key is reported",
        SettingsText::applyArg(s, "--nope=1") == "unknown setting 'nope'"
    );
    c.that(
        "settings args: an out-of-range value is reported",
        SettingsText::applyArg(s, "--seed=-4") != ""
    );
    c.that(
        "settings args: not a --option is reported",
        SettingsText::applyArg(s, "seed=4") != "" && SettingsText::applyArg(s, "-seed=4") != ""
    );
    c.sameInt("settings args: refused values change nothing", s.getInt("seed", 0), 42);
    c.that(
        "settings args: text with = inside",
        SettingsText::applyArg(s, "--player.name=a=b") == ""
            && s.getText("player.name", "") == "a=b"
    );
    let list : ArgList = new ArgList();
    list.add("--seed=9");
    list.add("--bogus=1");
    list.add("--audio.master=0.5");
    let r : ParseReport = SettingsText::applyArgs(s, list);
    c.sameInt("settings args: a list reports one problem", r.count(), 1);
    c.sameInt("settings args: at its argument number", r.lineAt(0), 2);
    c.that(
        "settings args: the others applied",
        s.getInt("seed", 0) == 9 && s.getReal("audio.master", 0.0) == 0.5
    );
    c.sameInt("settings args: the list reads back", list.count(), 3);
}

fn setScan(c : Checks) : void {
    c.that(
        "scan: ints",
        TextScan::isInt("42") && TextScan::isInt("-7") && !TextScan::isInt("")
            && !TextScan::isInt("-")
            && !TextScan::isInt("4x")
            && !TextScan::isInt("1.5")
    );
    c.sameInt("scan: toInt", TextScan::toInt("-1234"), -1234);
    c.sameInt(
        "scan: toInt of a huge number is refused",
        TextScan::toInt("99999999999999999999"),
        0
    );
    c.that(
        "scan: decimals",
        TextScan::isDecimal("1.5") && TextScan::isDecimal(".5") && TextScan::isDecimal("-2")
            && TextScan::isDecimal("1e3")
            && TextScan::isDecimal("2.5E-2")
    );
    c.that(
        "scan: not decimals",
        !TextScan::isDecimal("") && !TextScan::isDecimal(".") && !TextScan::isDecimal("e5")
            && !TextScan::isDecimal("1e")
            && !TextScan::isDecimal("1.2.3")
            && !TextScan::isDecimal("--1")
    );
    c.near("scan: toDecimal", TextScan::toDecimal("-12.375"), -12.375, 0.0);
    c.near("scan: toDecimal exponent", TextScan::toDecimal("2.5e-2"), 0.025, 0.0000000000000001);
    c.near("scan: toDecimal 0.1 is the nearest double", TextScan::toDecimal("0.1"), 0.1, 0.0);
    c.near("scan: toDecimal large", TextScan::toDecimal("123456.789"), 123456.789, 0.0000000001);
    let w : TextWords = TextScan::words("stage  \"two words\" 7 # tail");
    c.sameInt("scan: words", w.count(), 3);
    c.that("scan: a quoted word keeps its spaces", w.text(1) == "two words" && w.text(2) == "7");
    c.sameInt("scan: word columns are 1-based", w.column(2), 20);
    c.sameInt(
        "scan: an unterminated quote is flagged at its column",
        TextScan::words("a \"b c").broken,
        3
    );
    c.sameInt("scan: lineCount", TextScan::lineCount("a\nb\nc"), 3);
    c.sameInt("scan: lineCount with a final newline", TextScan::lineCount("a\nb\n"), 2);
    c.that(
        "scan: lineAt",
        TextScan::lineAt("ab\ncd\r\nef", 1) == "cd" && TextScan::lineAt("ab\ncd", 5) == ""
    );
}

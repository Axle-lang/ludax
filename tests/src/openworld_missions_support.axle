// openworld_missions_support — the mission book and text the mission suites share.
//
// `misText` and `misBuilt` describe the same book, once as text and once built through the API, so the
// definition suite can show the two agree and the play suite can start from either.

use ludax::MissionBook;
use ludax::MissionText;

/** One second in nanoseconds. */
pub const MIS_S : i64 = 1000000000;

/** Three missions in the text format: a chain of requirements, stages, failures and rewards. */
pub fn misText() : string {
    return "# test missions\nmission intro \"Welcome\"\n  stage go\n    reach 100 100 10\n  reward xp 50\nend\n\n"
        + "mission deliver \"Deliver the crate\"\n  requires intro\n  stage pickup\n    collect crate 2\n    reach 500 0 20 optional\n"
        + "  stage drive\n    escort courier 1000 0 30\n    timer 2.5\n  stage clear\n    kill wolf 3\n    flag gate\n"
        + "  fail timeout 100\n  fail flag alarm\n  fail death mule\n  reward gold 250\n  reward xp 100\nend\n\n"
        + "mission bonus \"Bonus\" auto\n  requires deliver\n  stage one\n    timer 1\n  reward gold 5\nend\n";
}

/** The same missions as `misText`, built through the builder calls. */
pub fn misBuilt() : MissionBook {
    let b : MissionBook = new MissionBook();
    b.beginMission("intro", "Welcome", false);
    b.beginStage("go");
    b.reach(100.0, 100.0, 10.0);
    b.reward("xp", 50);
    b.beginMission("deliver", "Deliver the crate", false);
    b.requires("intro");
    b.beginStage("pickup");
    b.collect("crate", 2);
    b.reach(500.0, 0.0, 20.0);
    b.markOptional();
    b.beginStage("drive");
    b.escort("courier", 1000.0, 0.0, 30.0);
    b.timer(2.5);
    b.beginStage("clear");
    b.kill("wolf", 3);
    b.flag("gate");
    b.failAfter(100.0);
    b.failOnFlag("alarm");
    b.failOnDeath("mule");
    b.reward("gold", 250);
    b.reward("xp", 100);
    b.beginMission("bonus", "Bonus", true);
    b.requires("deliver");
    b.beginStage("one");
    b.timer(1.0);
    b.reward("gold", 5);
    return b;
}

/** The book parsed from `misText`. */
pub fn misParsed() : MissionBook {
    let b : MissionBook = new MissionBook();
    MissionText::parse(b, misText());
    return b;
}

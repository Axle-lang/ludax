// voxlight_edit — the incremental edit against a rebuild from scratch, symmetry, and the sky light.
//
// The field is a pure function of the blocks (see flood), so after any sequence of edits it must equal the
// field of a rebuild, key for key. The random test makes that claim sixty times over a scene with every kind
// of block; a flood whose removal pass is wrong fails it at once.

use ludax::{Checks, Pcg32, VoxLightCurve};

use crate::voxlight_support::{VoxIds, VoxLightRig, voxDiffer};

/** Checks incremental edits against a rebuild, the field's symmetry and the sky term. */
pub class VoxLightEditSuite {
    static fn pick(r : Pcg32) : i32 {
        let roll : u32 = r.nextBelow(20);
        if (roll < 9) {
            return VoxIds::air();
        }
        if (roll < 13) {
            return VoxIds::stone();
        }
        if (roll < 14) {
            return VoxIds::lamp();
        }
        if (roll < 15) {
            return VoxIds::warmLamp();
        }
        if (roll < 16) {
            return VoxIds::dimLamp();
        }
        if (roll < 18) {
            return VoxIds::redGlass();
        }
        return VoxIds::leaves();
    }

    static fn randomEdits(c : Checks) : void {
        let rig : VoxLightRig = new VoxLightRig(2, 2, 2, 24);
        let r : Pcg32 = new Pcg32(99, 5);
        for (z of 0..32) {
            for (x of 0..32) {
                let h : i32 = 4 + r.range(0, 9);
                for (y of 0..h) {
                    rig.set(x, y, z, VoxIds::grass());
                }
            }
        }
        for (i of 0..40) {
            rig.set(r.range(0, 32), r.range(5, 32), r.range(0, 32), VoxLightEditSuite::pick(r));
        }
        rig.flood.rebuild();
        let n : i64 = rig.grid.slotCount() as i64 * 4096 * 4;
        let mut bad : i32 = 0;
        for (step of 0..80) {
            let x : i32 = r.range(0, 32);
            let y : i32 = r.range(0, 32);
            let z : i32 = r.range(0, 32);
            let pickedId : i32 = VoxLightEditSuite::pick(r);
            let oldId : i32 = rig.grid.blockAt(x, y, z);
            rig.put(x, y, z, pickedId);
            let incremental : i32[] = rig.snapshot();
            rig.flood.rebuild();
            let rebuilt : i32[] = rig.snapshot();
            if (voxDiffer(incremental, rebuilt, n) != 0) {
                bad = bad + 1;
                if (bad < 4) {
                    let per : i64 = n / 4;
                    println("placed ${pickedId} over ${oldId}");
                    for (lz of 0..32) {
                        for (ly of 0..32) {
                            for (lx of 0..32) {
                                let bb : i32 = rig.grid.blockAt(lx, ly, lz);
                                if (bb == 2 || bb == 5 || bb == 8) {
                                    println(" lamp ${bb} at ${lx},${ly},${lz}");
                                }
                            }
                        }
                    }
                    println("edit ${step} at ${x},${y},${z}");
                    for (i of 0..n) {
                        if (incremental[i] != rebuilt[i]) {
                            let pl : i64 = i / per;
                            let id : i64 = i % per;
                            let px : i32 = rig.grid.cellX(id as i32);
                            let py : i32 = rig.grid.cellY(id as i32);
                            let pz : i32 = rig.grid.cellZ(id as i32);
                            let block : i32 = rig.grid.blockOfId(id as i32);
                            println("  plane ${pl} cell ${px},${py},${pz} inc ${incremental[i]} reb ${rebuilt[i]} block ${block}");
                            break;
                        }
                    }
                }
            }
        }
        c.sameInt(
            "80 random edits: incremental field == rebuilt field (edits that differed)",
            bad,
            0
        );
    }

    // Mirror the scene in x and z and swap x with z: the field must follow.
    static fn symmetry(c : Checks) : void {
        let rig : VoxLightRig = new VoxLightRig(2, 2, 2, 16);
        let r : Pcg32 = new Pcg32(5, 1);
        for (i of 0..30) {
            let a : i32 = r.range(0, 12);
            let b : i32 = r.range(0, 12);
            let y : i32 = r.range(10, 22);
            let id : i32 = VoxLightEditSuite::pick(r);
            if (id == VoxIds::lamp() || id == VoxIds::warmLamp() || id == VoxIds::dimLamp()) {
                continue;
            }
            for (sx of 0..2) {
                for (sz of 0..2) {
                    let dx : i32 = a * (1 - 2 * sx);
                    let dz : i32 = b * (1 - 2 * sz);
                    rig.set(16 + dx, y, 16 + dz, id);
                    rig.set(16 + dz, y, 16 + dx, id);
                }
            }
        }
        rig.set(16, 16, 16, VoxIds::lamp());
        rig.flood.rebuild();
        let mut off : i32 = 0;
        let mut lit : i32 = 0;
        for (z of 1..16) {
            for (y of 0..32) {
                for (x of 1..16) {
                    for (ch of 0..3) {
                        let v : i32 = rig.level(16 + x, y, 16 + z, ch);
                        if (rig.level(16 - x, y, 16 + z, ch) != v) {
                            off = off + 1;
                        }
                        if (rig.level(16 + x, y, 16 - z, ch) != v) {
                            off = off + 1;
                        }
                        if (rig.level(16 - x, y, 16 - z, ch) != v) {
                            off = off + 1;
                        }
                        if (rig.level(16 + z, y, 16 + x, ch) != v) {
                            off = off + 1;
                        }
                    }
                    if (rig.level(16 + x, y, 16 + z, 0) > 0) {
                        lit = lit + 1;
                    }
                }
            }
        }
        c.sameInt("the field of a symmetric scene is symmetric (mismatching cells)", off, 0);
        c.that("and the test looked at a lit scene", lit > 500);
    }

    static fn sky(c : Checks) : void {
        // Open sky: every cell of an empty world is at full sky light.
        let open : VoxLightRig = new VoxLightRig(2, 2, 2, 16);
        open.flood.rebuild();
        c.sameInt("open sky is 255 at the bottom", open.sky(7, 0, 9), 255);
        c.sameInt("and at the top", open.sky(7, 31, 9), 255);

        // A roof over everything: dark below, bright above.
        let roofed : VoxLightRig = new VoxLightRig(2, 2, 2, 16);
        roofed.fill(0, 20, 0, 32, 21, 32, VoxIds::stone());
        roofed.flood.rebuild();
        let mut under : i32 = 0;
        for (z of 0..32) {
            for (x of 0..32) {
                for (y of 0..20) {
                    under = under + roofed.sky(x, y, z);
                }
            }
        }
        c.sameInt("a roof over the whole world leaves no sky light beneath it", under, 0);
        c.sameInt("above the roof it is full", roofed.sky(5, 21, 5), 255);

        // Half a roof: the light creeps in under the edge, one step per cell.
        let half : VoxLightRig = new VoxLightRig(2, 2, 2, 16);
        half.fill(0, 20, 0, 16, 21, 32, VoxIds::stone());
        half.flood.rebuild();
        let mut ok : bool = true;
        for (k of 1..16) {
            if (half.sky(16 - k, 10, 9) != 255 - 16 * k) {
                ok = false;
            }
        }
        c.that("under an overhang the light falls by one step per cell", ok);

        // Leaves above multiply the column by their transmittance (165/255 each).
        let leafy : VoxLightRig = new VoxLightRig(2, 2, 2, 16);
        leafy.fill(0, 22, 0, 32, 24, 32, VoxIds::leaves());
        leafy.flood.rebuild();
        let one : i32 = (255 * 165 + 127) / 255;
        let two : i32 = (one * 165 + 127) / 255;
        c.sameInt("below two layers of leaves", leafy.sky(3, 10, 3), two);
        c.sameInt("inside the upper leaf layer", leafy.sky(3, 23, 3), one);
        c.sameInt("above the canopy", leafy.sky(3, 24, 3), 255);

        // Editing: put a roof piece, then remove it; the field returns to what it was.
        let n : i64 = open.grid.slotCount() as i64 * 4096 * 4;
        let before : i32[] = open.snapshot();
        open.put(10, 25, 10, VoxIds::stone());
        c.sameInt(
            "a single block casts a column of shade below it",
            open.sky(10, 5, 10) < 255 ? 1 : 0,
            1
        );
        open.put(10, 25, 10, VoxIds::air());
        c.sameInt("removing it restores the sky field", voxDiffer(before, open.snapshot(), n), 0);
    }

    /** Runs every check. */
    pub static fn run(c : Checks) : void {
        VoxLightEditSuite::randomEdits(c);
        VoxLightEditSuite::symmetry(c);
        VoxLightEditSuite::sky(c);
    }
}

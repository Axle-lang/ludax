// world_shape — checks for the small solid parts a cell may hold: a ray meets the nearest box face with its normal,
// passes beside a box, runs parallel to its faces, starts inside it; volumes and diffuse openness add as they should.

use ludax::{Checks, ShapeBank, ShapeHit, Vec3};

/** Checks `ShapeBank`: ray tests against boxes, volumes and the light a shaped cell lets through. */
pub class WorldShapeSuite {
    /** Runs every check of the suite. */
    pub static fn run(mut c : Checks) : void {
        let bank : ShapeBank = new ShapeBank(4);
        // Block 1: a torch, a stick and a head. Block 2: a full cube made of one box. Block 3: no shape.
        bank.box(1, 7, 0, 7, 9, 10, 9);
        bank.box(1, 6, 10, 6, 10, 13, 10);
        bank.box(2, 0, 0, 0, 16, 16, 16);
        bank.seal();
        c.that("world shape: a block with boxes is shaped", bank.shaped(1) && bank.shaped(2));
        c.that("world shape: a block without is not", !bank.shaped(3) && !bank.shaped(0));

        // From the west, at the stick's height, toward +x through cell (5, 2, 7): the stick's west face, x = 5 + 7/16.
        let o : Vec3 = Vec3::make(4.0, 2.25, 7.5);
        let east : Vec3 = Vec3::make(1.0, 0.0, 0.0);
        let stick : ShapeHit = bank.intersect(1, 5, 2, 7, o, east, 1.0);
        c.that("world shape: a ray meets the stick", stick.hit);
        c.near("world shape: ... at its west face", stick.t as f64, 1.4375, 0.00001);
        c.that(
            "world shape: ... whose normal faces the ray",
            stick.nx == -1 && stick.ny == 0 && stick.nz == 0
        );

        // At the head's height the head's wider face comes first.
        let head : ShapeHit = bank.intersect(1, 5, 2, 7, Vec3::make(4.0, 2.75, 7.5), east, 1.0);
        c.near("world shape: higher up, the head's wider face", head.t as f64, 1.375, 0.00001);

        // Beside the stick (z = 7.2, outside 7/16..9/16) and below the head the ray goes through the cell.
        let beside : ShapeHit = bank.intersect(1, 5, 2, 7, Vec3::make(4.0, 2.25, 7.2), east, 1.0);
        c.that("world shape: a ray beside the stick passes", !beside.hit);

        // Straight down onto the head, parallel to x and z: the top face, normal up.
        let down : ShapeHit = bank.intersect(
            1,
            5,
            2,
            7,
            Vec3::make(5.5, 4.0, 7.5),
            Vec3::make(0.0, -1.0, 0.0),
            1.0
        );
        c.that("world shape: a ray parallel to two axes meets the top", down.hit && down.ny == 1);
        c.near("world shape: ... at y = 2 + 13/16", (4.0 - down.t) as f64, 2.8125, 0.00001);

        // A ray that starts inside the stick meets it where it entered the cell.
        let inside : ShapeHit = bank.intersect(1, 5, 2, 7, Vec3::make(5.5, 2.25, 7.5), east, 0.0);
        c.that(
            "world shape: a ray starting inside a box stops at once",
            inside.hit && inside.t == 0.0
        );

        c.near(
            "world shape: the torch fills 2·10·2 + 4·3·4 of 16³",
            bank.volumeOf(1) as f64,
            88.0 / 4096.0,
            0.000001
        );
        c.near("world shape: a full cube fills its cell", bank.volumeOf(2) as f64, 1.0, 0.000001);
        c.near(
            "world shape: ... and lets no diffuse light through",
            bank.openOf(2) as f64,
            0.0,
            0.000001
        );
        let torchOpen : f64 = bank.openOf(1) as f64;
        c.that(
            "world shape: a torch lets most diffuse light through (${torchOpen})",
            torchOpen > 0.85 && torchOpen < 1.0
        );
    }
}

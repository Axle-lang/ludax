// math_trig — the deterministic trigonometry against the C library, within the documented tolerances.
//
// The sweeps reach the ranges a game actually uses and the branches the reduction has to survive: angles far
// outside one turn, tangents near the poles, inverse functions at their clamping edges. A check names the worst
// error it saw, so a regression shows how far past the budget it went, and the bit-stable results pin the
// determinism the simulation depends on.

use ludax::{Checks, TAU_D, absD};
use ludax::{sin, cos, tan, atan2, acos, asin, sqrt, atan2Quick, asinQuick};
use ludax::{sinD, cosD, tanD, atanD, atan2D, acosD, asinD, sqrtD};

use crate::math_support::{MATH_TOL_D};

const TRIG_ANGLE_STEPS : i32 = 40000;

// The largest gap between `got` and `want` seen so far.
fn trigWorse(seen : f64, got : f64, want : f64) : f64 {
    let gap : f64 = absD(got - want);
    if (gap > seen) {
        return gap;
    }
    return seen;
}

// The C library has no atan2 method in Axle: the reference is its atan with the quadrant fixed by hand
// (x is never zero in the sweeps that use it).
fn trigReferenceAtan2(y : f64, x : f64) : f64 {
    let a : f64 = (y / x).atan();
    if (x > 0.0) {
        return a;
    }
    if (y >= 0.0) {
        return a + TAU_D / 2.0;
    }
    return a - TAU_D / 2.0;
}

fn trigSweepAngles(c : Checks) : void {
    let mut sinErr : f64 = 0.0;
    let mut cosErr : f64 = 0.0;
    let mut tanErr : f64 = 0.0;
    let mut sinErr32 : f64 = 0.0;
    let mut cosErr32 : f64 = 0.0;
    let mut i : i32 = 0;
    while (i < TRIG_ANGLE_STEPS) {
        // From -1000 to 1000 radians in steps that never repeat a quadrant position.
        let x : f64 = (i - TRIG_ANGLE_STEPS / 2) as f64 * 0.0500137;
        sinErr = trigWorse(sinErr, sinD(x), x.sin());
        cosErr = trigWorse(cosErr, cosD(x), x.cos());
        let t : f64 = x.tan();
        if (absD(t) < 1000.0) {
            // The error relative to `1 + |t|`, so a large tangent does not dominate the worst case.
            let ratio : f64 = absD(tanD(x) - t) / (1.0 + absD(t));
            if (ratio > tanErr) {
                tanErr = ratio;
            }
        }
        let x32 : f32 = x as f32;
        sinErr32 = trigWorse(sinErr32, sin(x32) as f64, (x32 as f64).sin());
        cosErr32 = trigWorse(cosErr32, cos(x32) as f64, (x32 as f64).cos());
        i = i + 1;
    }
    c.that(
        "sinD within 1e-15 of libm over +-1000 rad, worst ${sinErr}",
        sinErr < MATH_TOL_D
    );
    c.that(
        "cosD within 1e-15 of libm over +-1000 rad, worst ${cosErr}",
        cosErr < MATH_TOL_D
    );
    c.that("tanD within 1e-13 relative of libm, worst ${tanErr}", tanErr < 0.0000000000001);
    c.that("sin f32 within 1.3e-7 of libm, worst ${sinErr32}", sinErr32 < 0.00000013);
    c.that("cos f32 within 1.3e-7 of libm, worst ${cosErr32}", cosErr32 < 0.00000013);
}

fn trigSweepInverses(c : Checks) : void {
    let mut atanErr : f64 = 0.0;
    let mut atan2Err : f64 = 0.0;
    let mut acosErr : f64 = 0.0;
    let mut asinErr : f64 = 0.0;
    let mut atan2Err32 : f64 = 0.0;
    let mut i : i32 = 0;
    while (i < 20000) {
        let u : f64 = (i - 10000) as f64 / 10000.0;
        asinErr = trigWorse(asinErr, asinD(u), u.asin());
        acosErr = trigWorse(acosErr, acosD(u), u.acos());
        let big : f64 = u * u * u * 300.0;
        atanErr = trigWorse(atanErr, atanD(big), big.atan());
        let y : f64 = u * 7.0 + 0.013;
        let x : f64 = (10000 - i) as f64 / 3000.0 + 0.0007;
        atan2Err = trigWorse(atan2Err, atan2D(y, x), trigReferenceAtan2(y, x));
        let y32 : f32 = y as f32;
        let x32 : f32 = x as f32;
        atan2Err32 = trigWorse(
            atan2Err32,
            atan2(y32, x32) as f64,
            trigReferenceAtan2(y32 as f64, x32 as f64)
        );
        i = i + 1;
    }
    c.that("asinD within 1e-15, worst ${asinErr}", asinErr < MATH_TOL_D);
    c.that("acosD within 1e-15, worst ${acosErr}", acosErr < MATH_TOL_D);
    c.that("atanD within 1e-15, worst ${atanErr}", atanErr < MATH_TOL_D);
    c.that("atan2D within 1e-15, worst ${atan2Err}", atan2Err < MATH_TOL_D);
    c.that("atan2 f32 within 1.3e-7, worst ${atan2Err32}", atan2Err32 < 0.00000013);
    c.near("trig: acos(0.5) in f32 is pi/3", acos(0.5) as f64, 1.0471975511965976, 0.00000013);
    c.near("trig: asin(0.5) in f32 is pi/6", asin(0.5) as f64, 0.5235987755982988, 0.00000013);
}

fn trigEdgeCases(c : Checks) : void {
    c.near("trig: sinD(0) is 0", sinD(0.0), 0.0, 0.0);
    c.near("trig: cosD(0) is 1", cosD(0.0), 1.0, 0.0);
    c.near("trig: sinD(pi/2) is 1", sinD(TAU_D / 4.0), 1.0, MATH_TOL_D);
    c.near("trig: cosD(pi) is -1", cosD(TAU_D / 2.0), -1.0, MATH_TOL_D);
    c.that("sin of a huge angle stays in range", absD(sinD(1000000000000.0)) <= 1.0);
    c.that("sin of a huge angle is finite", sinD(1000000000000000000000000000000.0).isFinite());
    c.that(
        "cos of a huge angle is in range",
        absD(cosD(-1000000000000000000000000000000.0)) <= 1.0
    );
    c.near("atan2 at the origin is 0", atan2D(0.0, 0.0), 0.0, 0.0);
    c.near("atan2 on +Y", atan2D(1.0, 0.0), TAU_D / 4.0, MATH_TOL_D);
    c.near("atan2 on -Y", atan2D(-1.0, 0.0), -TAU_D / 4.0, MATH_TOL_D);
    c.near("atan2 on -X", atan2D(0.0, -1.0), TAU_D / 2.0, MATH_TOL_D);
    c.near("acos above 1 is clamped", acosD(1.5), 0.0, 0.0);
    c.near("acos below -1 is clamped", acosD(-1.5), TAU_D / 2.0, 0.0);
    c.near("asin above 1 is clamped", asinD(2.0), TAU_D / 4.0, 0.0);
    c.near("trig: sqrtD(2) equals the square root of 2", sqrtD(2.0), 2.0.sqrt(), 0.0);
    c.near("sqrt of a negative is 0, not NaN", sqrtD(-4.0), 0.0, 0.0);
    c.near(
        "trig: sqrt(2) in f32 is the nearest float to the root",
        sqrt(2.0) as f64,
        1.4142135381698608,
        0.0
    );
    c.near("trig: sqrt of a negative in f32 is 0", sqrt(-1.0) as f64, 0.0, 0.0);
    c.that("tanD stays finite at the pole", tanD(TAU_D / 4.0).isFinite());
    c.near("trig: tan(pi/4) in f32 is 1", tan(0.7853982) as f64, 1.0, 0.000001);
    c.near("trig: sinD(-x) equals -sinD(x)", sinD(-0.7), -sinD(0.7), 0.0);
}

fn trigDeterminism(c : Checks) : void {
    // The bit pattern of a fixed result is part of the contract: the same everywhere, always.
    c.that("trig: sinD(1) is bit-stable", sinD(1.0) == 0.8414709848078965);
    c.that("trig: cosD(1) is bit-stable", cosD(1.0) == 0.5403023058681398);
    c.that("atan2D(1,2) is bit-stable", atan2D(1.0, 2.0) == 0.4636476090008061);
}

// The quick inverses against the exact ones, all around the circle and across the whole of asin's domain.
fn trigQuick(c : Checks) : void {
    let mut worst : f64 = 0.0;
    let mut worstSin : f64 = 0.0;
    let mut i : i32 = 0;
    while (i < 40000) {
        let turn : f64 = (i as f64) / 40000.0 * 6.283185307179586;
        let r : f64 = 0.001 + (i % 97) as f64;
        let y : f32 = (sinD(turn) * r) as f32;
        let x : f32 = (cosD(turn) * r) as f32;
        worst = trigWorse(worst, atan2Quick(y, x) as f64, atan2D(y as f64, x as f64));
        let u : f32 = ((i - 20000) as f64 / 20000.0) as f32;
        worstSin = trigWorse(worstSin, asinQuick(u) as f64, asinD(u as f64));
        i = i + 1;
    }
    c.that("atan2Quick within 2e-5 radian of atan2, worst ${worst}", worst < 0.00002);
    c.that("asinQuick within 2e-5 radian of asin, worst ${worstSin}", worstSin < 0.00002);
    c.that("atan2Quick of the origin is 0", atan2Quick(0.0, 0.0) == 0.0);
    c.that("asinQuick clamps outside -1..1", asinQuick(2.0) > 1.5707 && asinQuick(-2.0) < -1.5707);
}

/** The trig suite. */
pub class MathTrigSuite {
    /** Runs the trigonometry checks. */
    pub static fn run(c : Checks) : void {
        trigSweepAngles(c);
        trigSweepInverses(c);
        trigEdgeCases(c);
        trigDeterminism(c);
        trigQuick(c);
    }
}

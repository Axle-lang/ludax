// data_name_table — checks for NameTable: string and byte-range lookups, growth, high bytes.
//
// The table is built once and read by many threads, so the checks are about the two things a reader relies
// on: an index never changes once handed out (10 000 names across every rehash, two builds in the same order
// agree), and a lookup by byte range finds exactly what a lookup by string finds, including names with bytes
// above 127 and names that are prefixes of each other. A `measured:` line gives lookups per second.

use ludax::{ByteBuf, Checks, NameTable, nowNanos};

use crate::generic_support::gsText;

/** The NameTable checks. */
pub class NameTableSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        nameEmptyChecks(c);
        nameGrowthChecks(c);
        nameBytesChecks(c);
        nameMeasure(c);
    }

    /** Prints the `measured:` line alone. */
    pub static fn measure(c : Checks) : void {
        nameMeasure(c);
    }
}

fn nameEmptyChecks(c : Checks) : void {
    let table : NameTable = new NameTable();
    c.sameInt("names: a new table has no names", table.count(), 0);
    c.sameInt("names: find in an empty table answers -1", table.find("stone"), -1);
    c.that(
        "names: has is false for every index of an empty table",
        !table.has(0) && !table.has(-1)
    );
    c.that(
        "names: nameOr answers the fallback for an absent index",
        table.nameOr(0, "none") == "none"
    );

    c.sameInt("names: the first name is index 0", table.add("stone"), 0);
    c.sameInt("names: the second is index 1", table.add("dirt"), 1);
    c.sameInt("names: adding a known name answers its index", table.add("stone"), 0);
    c.sameInt("names: ... without growing the table", table.count(), 2);
    c.sameInt("names: find answers the index", table.find("dirt"), 1);
    c.sameInt("names: a prefix of a name is not the name", table.find("ston"), -1);
    c.sameInt("names: an extension of a name is not the name", table.find("stones"), -1);
    c.that("names: name answers the text", table.name(0) == "stone" && table.name(1) == "dirt");
    c.that("names: has is true inside and false outside", table.has(1) && !table.has(2));
    c.that("names: nameOr answers the name for a present index", table.nameOr(1, "none") == "dirt");

    c.sameInt("names: the empty name is a name", table.add(""), 2);
    c.sameInt("names: ... and is found again", table.find(""), 2);
    c.that("names: ... with an empty text", table.name(2) == "");
}

fn nameGrowthChecks(c : Checks) : void {
    let table : NameTable = new NameTable();
    let other : NameTable = new NameTable();
    let mut wrongIndex : i32 = 0;
    for (i of 0..10000) {
        let id : i32 = table.add("name_${i}");
        if (id != i) {
            wrongIndex = wrongIndex + 1;
        }
        other.add("name_${i}");
    }
    c.sameInt("names: 10 000 names get consecutive indices across the rehashes", wrongIndex, 0);
    c.sameInt("names: ... and are all counted", table.count(), 10000);

    let mut lost : i32 = 0;
    let mut disagree : i32 = 0;
    for (i of 0..10000) {
        let name : string = "name_${i}";
        if (table.find(name) != i) {
            lost = lost + 1;
        }
        if (table.find(name) != other.find(name)) {
            disagree = disagree + 1;
        }
    }
    c.sameInt("names: every name is found after all the growth", lost, 0);
    c.sameInt("names: two tables built in the same order agree on every index", disagree, 0);
    c.sameInt("names: an absent name is not found", table.find("name_10000"), -1);
    c.that(
        "names: name(i) round trips for the first, a middle and the last",
        table.name(0) == "name_0" && table.name(5000) == "name_5000"
            && table.name(9999) == "name_9999"
    );

    // Long names grow the byte storage.
    let longTable : NameTable = new NameTable();
    let mut longLost : i32 = 0;
    for (i of 0..200) {
        let text : string = "${i}_" + "x" + "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz";
        longTable.add(text);
    }
    for (i of 0..200) {
        let text : string = "${i}_" + "x" + "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz";
        if (longTable.find(text) != i) {
            longLost = longLost + 1;
        }
    }
    c.sameInt("names: long names are all found after the storage grew", longLost, 0);
}

fn nameBytesChecks(c : Checks) : void {
    let table : NameTable = new NameTable();
    table.add("minecraft:stone");
    table.add("minecraft:stone_bricks");
    table.add("stone");

    // A buffer with several names back to back.
    let buffer : ByteBuf = new ByteBuf(16);
    buffer.pushText("xx");
    buffer.pushText("minecraft:stone_bricks");
    buffer.pushText("zzstone");
    c.sameInt("names: a name found inside a larger buffer", table.findBytes(buffer, 2, 24), 1);
    c.sameInt(
        "names: a shorter range of the same bytes finds the other name",
        table.findBytes(buffer, 2, 17),
        0
    );
    c.sameInt("names: the last range finds its name", table.findBytes(buffer, 26, 31), 2);
    c.sameInt("names: an empty range is not a name here", table.findBytes(buffer, 5, 5), -1);
    c.sameInt(
        "names: a range reaching past the buffer answers -1",
        table.findBytes(buffer, 20, 99),
        -1
    );
    c.sameInt("names: a negative start answers -1", table.findBytes(buffer, -1, 3), -1);
    c.sameInt("names: a reversed range answers -1", table.findBytes(buffer, 9, 3), -1);

    // Bytes above 127 hash and compare as unsigned values.
    let high : ByteBuf = new ByteBuf(16);
    high.push(195);
    high.push(169);
    high.push(255);
    high.push(0);
    high.push(128);
    let id : i32 = table.addBytes(high, 0, 5);
    c.sameInt("names: a name of high and zero bytes is added", id, 3);
    c.sameInt("names: ... and found by range", table.findBytes(high, 0, 5), id);
    c.sameInt("names: ... and is not its prefix", table.findBytes(high, 0, 4), -1);
    c.sameInt("names: addBytes of a known range answers its index", table.addBytes(high, 0, 5), id);
    c.sameInt("names: addBytes of a bad range adds nothing", table.addBytes(high, 3, 99), -1);
    c.sameInt("names: ... and the count is unchanged", table.count(), 4);
    let accented : ByteBuf = new ByteBuf(16);
    accented.push(195);
    accented.push(169);
    c.sameInt(
        "names: a name that is a prefix of another is distinct",
        table.addBytes(accented, 0, 2),
        4
    );

    // A range lookup agrees with a string lookup for every name of a text-like set.
    let texts : NameTable = new NameTable();
    let source : ByteBuf = gsText(5000, 3);
    let mut starts : i32[] = new i32[1000];
    let mut ends : i32[] = new i32[1000];
    let mut words : i32 = 0;
    let mut at : i32 = 0;
    while (at < source.len() && words < 1000) {
        let mut end : i32 = at;
        while (end < source.len() && source.get(end) != 32) {
            end = end + 1;
        }
        starts[words] = at;
        ends[words] = end;
        words = words + 1;
        at = end + 1;
    }
    for (w of 0..words) {
        texts.addBytes(source, starts[w], ends[w]);
    }
    let mut mismatched : i32 = 0;
    for (w of 0..words) {
        let viaBytes : i32 = texts.findBytes(source, starts[w], ends[w]);
        let viaString : i32 = texts.find(texts.name(viaBytes));
        if (viaBytes < 0 || viaBytes != viaString) {
            mismatched = mismatched + 1;
        }
    }
    c.sameInt("names: lookup by range equals lookup by string for ${words} words", mismatched, 0);
}

fn nameMeasure(c : Checks) : void {
    let table : NameTable = new NameTable();
    let probe : ByteBuf = new ByteBuf(16);
    let mut offsets : i32[] = new i32[10001];
    for (i of 0..10000) {
        offsets[i] = probe.len();
        probe.pushText("minecraft:block_${i}");
        table.add("minecraft:block_${i}");
    }
    offsets[10000] = probe.len();

    let mut best : i64 = (1 as i64) << 60;
    let mut found : i64 = 0;
    for (run of 0..9) {
        let t0 : i64 = nowNanos();
        for (round of 0..20) {
            for (i of 0..10000) {
                found = found + (table.findBytes(probe, offsets[i], offsets[i + 1]) as i64);
            }
        }
        let dt : i64 = nowNanos() - t0;
        if (dt < best) {
            best = dt;
        }
    }
    c.that("names: the measured lookups find their names (${found})", found > 0);
    let rate : i64 = 20 * 10000 * 1000 / (best + 1);
    println("measured: NameTable findBytes of 10000 names of 17 bytes: ${rate} Mlookups/s (best of 9)");
}

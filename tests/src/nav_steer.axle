// nav_steer — steering behaviours, path following and the neighbour grid.
//
// The behaviours are measured on trajectories rather than on single calls: arrive must settle without
// overshooting, a crowd under separation alone must spread, and look-ahead must carry an agent round a corner.
// The neighbour grid is compared with an independent radius test, so a missing, duplicated or unrepeatable
// neighbour fails even when the crowd still moves.

use ludax::{Checks, Pcg32, Vec2, SteerAgent, PathFollow, Steering, NeighborGrid};

use crate::nav_mesh::{NAV_TOL, NAV_TOL_COARSE};

fn navSteerAgent(x : f32, y : f32) : SteerAgent {
    return SteerAgent { pos: Vec2::make(x, y), maxSpeed: 4.0, maxAccel: 20.0 };
}

fn navSteerTestSeekArrive(c : Checks) : void {
    let a : SteerAgent = navSteerAgent(0.0, 0.0);
    let acc : Vec2 = Steering::seek(a, Vec2::make(10.0, 0.0));
    c.near("seek accelerates at the limit", acc.x as f64, 20.0, NAV_TOL);
    c.near("straight at the target", acc.y as f64, 0.0, NAV_TOL);
    let still : Vec2 = Steering::seek(a, Vec2::make(0.0, 0.0));
    c.that("seek at its own position asks for nothing", still.length() < 0.0001);
    let mut moving : SteerAgent = navSteerAgent(0.0, 0.0);
    moving.vel = Vec2::make(4.0, 0.0);
    c.that(
        "already at full speed towards the target: no more acceleration",
        Steering::seek(moving, Vec2::make(10.0, 0.0)).length() < 0.0001
    );

    // Arrive: start from rest 12 units from the target; it must settle on it without overshooting.
    let dt : f32 = 0.02;
    let target : Vec2 = Vec2::make(12.0, 0.0);
    let mut ag : SteerAgent = navSteerAgent(0.0, 0.0);
    let mut farthest : f32 = 0.0;
    for (i of 0..600) {
        ag = Steering::step(ag, Steering::arrive(ag, target, 4.0), dt);
        if (ag.pos.x > farthest) {
            farthest = ag.pos.x;
        }
    }
    c.that("arrive stops on the target", ag.pos.distance(target) < 0.05);
    c.that("with no speed left", ag.vel.length() < 0.05);
    c.that("and never went past it by more than a hair", farthest < 12.05);
    // Seek, by contrast, does not slow down.
    let mut rush : SteerAgent = navSteerAgent(0.0, 0.0);
    let mut peak : f32 = 0.0;
    for (i of 0..200) {
        rush = Steering::step(rush, Steering::seek(rush, target), dt);
        if (rush.vel.length() > peak) {
            peak = rush.vel.length();
        }
    }
    c.near("seek keeps its top speed", peak as f64, 4.0, NAV_TOL_COARSE);
    c.that("and the speed limit holds", peak <= 4.0001);
    let slow : Vec2 = Steering::arrive(navSteerAgent(11.0, 0.0), target, 4.0);
    c.that("inside the slow radius arrive asks for less than the limit", slow.length() < 20.0);
}

fn navSteerTestSeparation(c : Checks) : void {
    let a : SteerAgent = navSteerAgent(0.0, 0.0);
    let mut nx : f32[] = new f32[4];
    let mut ny : f32[] = new f32[4];
    nx[0] = 0.0;
    ny[0] = 0.0;
    nx[1] = 0.5;
    ny[1] = 0.0;
    nx[2] = 5.0;
    ny[2] = 0.0;
    let push : Vec2 = Steering::separation(a, nx, ny, 3, 0, 1.0);
    c.that("pushed away from the close neighbour (to -x)", push.x < -0.1);
    c.near(
        "separation from a neighbour on the x axis has no sideways push",
        push.y as f64,
        0.0,
        NAV_TOL
    );
    c.near(
        "half way into the range pushes half as hard as the limit",
        push.x as f64,
        -10.0,
        NAV_TOL
    );
    let far : Vec2 = Steering::separation(a, nx, ny, 3, 0, 0.4);
    c.that("a neighbour beyond the range is ignored", far.length() < 0.0001);
    let b : SteerAgent = navSteerAgent(0.5, 0.0);
    let back : Vec2 = Steering::separation(b, nx, ny, 3, 1, 1.0);
    c.near("the neighbour is pushed the opposite way, equally hard", back.x as f64, 10.0, NAV_TOL);

    // Two agents on the same spot are pushed apart, in opposite directions.
    nx[1] = 0.0;
    let p0 : Vec2 = Steering::separation(a, nx, ny, 2, 0, 1.0);
    let p1 : Vec2 = Steering::separation(a, nx, ny, 2, 1, 1.0);
    c.that("coincident agents go opposite ways", p0.x * p1.x < 0.0);

    // A crowd squeezed into a small patch spreads out under separation alone.
    let rng : Pcg32 = new Pcg32(5, 1);
    let n : i32 = 24;
    let mut xs : f32[] = new f32[n as i64];
    let mut ys : f32[] = new f32[n as i64];
    let mut crowd : SteerAgent[] = new SteerAgent[n as i64];
    for (i of 0..n) {
        xs[i] = rng.rangeF32(4.2, 5.8);
        ys[i] = rng.rangeF32(4.2, 5.8);
        crowd[i] = navSteerAgent(xs[i], ys[i]);
    }
    let closest0 : f32 = navSteerClosest(xs, ys, n);
    let grid : NeighborGrid = new NeighborGrid(0.0, 0.0, 10.0, 10.0, 1.0);
    let mut found : bool = true;
    let near : i32[] = new i32[64];
    for (round of 0..300) {
        grid.rebuild(xs, ys, n);
        let mut accels : Vec2[] = new Vec2[n as i64];
        for (i of 0..n) {
            let m : i32 = grid.gather(xs[i], ys[i], 1.0, near, 64);
            let mut nbx : f32[] = new f32[(m + 1) as i64];
            let mut nby : f32[] = new f32[(m + 1) as i64];
            let mut self_at : i32 = -1;
            for (k of 0..m) {
                nbx[k] = xs[near[k]];
                nby[k] = ys[near[k]];
                if (near[k] == i) {
                    self_at = k;
                }
            }
            if (self_at < 0) {
                found = false;
            }
            accels[i] = Steering::separation(crowd[i], nbx, nby, m, self_at, 1.0);
        }
        for (i of 0..n) {
            crowd[i] = Steering::step(crowd[i], accels[i], 0.05);
            xs[i] = crowd[i].pos.x;
            ys[i] = crowd[i].pos.y;
        }
    }
    c.that("the grid always returns the agent itself among its neighbours", found);
    let closest1 : f32 = navSteerClosest(xs, ys, n);
    c.that(
        "the crowd has spread: the closest pair is farther apart than at the start",
        closest1 > closest0 * 3.0
    );
    c.that("and no two stand on top of each other", closest1 > 0.15);
}

fn navSteerClosest(xs : f32[], ys : f32[], n : i32) : f32 {
    let mut best : f32 = 1000000.0;
    for (i of 0..n) {
        for (j of (i + 1)..n) {
            let dx : f32 = xs[i] - xs[j];
            let dy : f32 = ys[i] - ys[j];
            let d : f32 = (dx * dx + dy * dy).sqrt();
            if (d < best) {
                best = d;
            }
        }
    }
    return best;
}

fn navSteerTestGrid(c : Checks) : void {
    let rng : Pcg32 = new Pcg32(77, 2);
    let n : i32 = 200;
    let mut xs : f32[] = new f32[n as i64];
    let mut ys : f32[] = new f32[n as i64];
    for (i of 0..n) {
        xs[i] = rng.rangeF32(-2.0, 32.0);
        ys[i] = rng.rangeF32(-2.0, 22.0);
    }
    let grid : NeighborGrid = new NeighborGrid(0.0, 0.0, 30.0, 20.0, 2.0);
    grid.rebuild(xs, ys, n);
    c.sameInt("the grid holds every agent", grid.count() as i64, n as i64);
    let out : i32[] = new i32[n as i64];
    let mut complete : bool = true;
    let mut sorted : bool = true;
    let mut pruned : i32 = 0;
    for (q of 0..40) {
        let x : f32 = rng.rangeF32(0.0, 30.0);
        let y : f32 = rng.rangeF32(0.0, 20.0);
        let m : i32 = grid.gather(x, y, 1.5, out, n);
        // Every agent truly within the radius must be among the gathered ones.
        for (i of 0..n) {
            let dx : f32 = xs[i] - x;
            let dy : f32 = ys[i] - y;
            if (dx * dx + dy * dy <= 2.25) {
                let mut has : bool = false;
                for (k of 0..m) {
                    if (out[k] == i) {
                        has = true;
                    }
                }
                if (!has) {
                    complete = false;
                }
            }
        }
        if (m < n) {
            pruned = pruned + 1;
        }
        let again : i32 = grid.gather(x, y, 1.5, out, n);
        if (again != m) {
            sorted = false;
        }
    }
    c.that(
        "a gather finds every agent inside the radius (agents outside the area included)",
        complete
    );
    c.that("and a gather is repeatable", sorted);
    c.that("and skips most of the others", pruned == 40);
    c.sameInt("a capacity limits the answer", grid.gather(15.0, 10.0, 100.0, out, 7) as i64, 7);
}

fn navSteerTestFollow(c : Checks) : void {
    // An L-shaped path: east 10, then north 10.
    let mut pts : f32[] = new f32[6];
    pts[0] = 0.0;
    pts[1] = 0.0;
    pts[2] = 10.0;
    pts[3] = 0.0;
    pts[4] = 10.0;
    pts[5] = 10.0;
    let a : SteerAgent = navSteerAgent(0.0, 0.0);
    let f0 : PathFollow = Steering::followPath(a, pts, 3, 0, 3.0, 0.5);
    c.near("look-ahead target on the first leg (x)", f0.target.x as f64, 3.0, NAV_TOL);
    c.near("look-ahead target on the first leg (y)", f0.target.y as f64, 0.0, NAV_TOL);
    c.that("not done at the start", !f0.done && f0.segment == 0);
    c.near(
        "remaining is the straight distance to the end",
        f0.remaining as f64,
        14.1421356,
        NAV_TOL_COARSE
    );
    let f1 : PathFollow = Steering::followPath(navSteerAgent(9.5, 0.2), pts, 3, 0, 3.0, 0.5);
    c.near(
        "round the corner: the target is on the second leg (x)",
        f1.target.x as f64,
        10.0,
        NAV_TOL
    );
    c.near(
        "its height is the 0.5 left of the first leg removed from the look-ahead",
        f1.target.y as f64,
        2.5,
        NAV_TOL
    );
    c.sameInt("still on the first segment", f1.segment as i64, 0);
    let f2 : PathFollow = Steering::followPath(navSteerAgent(10.2, 1.0), pts, 3, 0, 3.0, 0.5);
    c.sameInt("past the corner the segment advances", f2.segment as i64, 1);
    c.near("and the target is ahead on the second leg", f2.target.y as f64, 4.0, NAV_TOL);
    let f3 : PathFollow = Steering::followPath(navSteerAgent(10.0, 9.8), pts, 3, 1, 3.0, 0.5);
    c.that("the target never goes beyond the last corner", f3.target.y < 10.0001);
    c.that("and the agent is done within the reach radius", f3.done);
    let f4 : PathFollow = Steering::followPath(navSteerAgent(1.0, 1.0), pts, 3, 5, 3.0, 0.5);
    c.sameInt("a stale segment index is clamped", f4.segment as i64, 1);
    c.that("an empty path is done at once", Steering::followPath(a, pts, 0, 0, 3.0, 0.5).done);

    // Drive an agent round the L with path following and arrive; it ends on the last corner.
    let mut ag : SteerAgent = navSteerAgent(0.0, 0.0);
    let mut seg : i32 = 0;
    let mut steps : i32 = 0;
    let mut finished : bool = false;
    let mut monotonic : bool = true;
    while (steps < 3000 && !finished) {
        let f : PathFollow = Steering::followPath(ag, pts, 3, seg, 2.0, 0.3);
        if (f.segment < seg) {
            monotonic = false;
        }
        seg = f.segment;
        if (f.done) {
            finished = true;
        } else {
            ag = Steering::step(ag, Steering::arrive(ag, f.target, 1.0), 0.02);
        }
        steps = steps + 1;
    }
    c.that("an agent steered along the path reaches its end", finished);
    c.that("the segment index never goes back", monotonic);
    c.that("in a sensible time (20 units at speed 4 take about 5 s = 250 steps)", steps < 600);
    c.that("and finishes near the last corner", ag.pos.distance(Vec2::make(10.0, 10.0)) <= 0.3);
}

fn navSteerTestDeterminism(c : Checks) : void {
    let mut a : SteerAgent = navSteerAgent(0.0, 0.0);
    let mut b : SteerAgent = navSteerAgent(0.0, 0.0);
    let target : Vec2 = Vec2::make(7.0, 3.0);
    for (i of 0..200) {
        a = Steering::step(a, Steering::arrive(a, target, 2.0), 0.016);
        b = Steering::step(b, Steering::arrive(b, target, 2.0), 0.016);
    }
    c.that(
        "the same steps give bit-identical motion",
        a.pos.x == b.pos.x && a.pos.y == b.pos.y && a.vel.x == b.vel.x
    );
    let capped : SteerAgent = Steering::step(navSteerAgent(0.0, 0.0), Vec2::make(1000.0, 0.0), 1.0);
    c.near(
        "one huge acceleration still respects the speed limit",
        capped.vel.length() as f64,
        4.0,
        NAV_TOL
    );
}

/** The steering and neighbour grid suite. */
pub class NavSteerSuite {
    /** Runs the steering checks. */
    pub static fn run(c : Checks) : void {
        navSteerTestSeekArrive(c);
        navSteerTestSeparation(c);
        navSteerTestGrid(c);
        navSteerTestFollow(c);
        navSteerTestDeterminism(c);
    }
}

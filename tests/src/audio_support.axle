// audio_support — the clips and scenes the audio engine suites share.
//
// Every clip has known samples (a constant level, a sine), so a check can name the output it expects; the scene
// is fixed so two suites that render it compare the same sound.

use ludax::AudioClip;
use ludax::AudioEngine;
use ludax::AudioInterpolation;
use ludax::AudioPlay;
use ludax::TAU;
use ludax::Vec3;
use ludax::WavCodec;
use ludax::WavFile;
use ludax::hashFnv1a64Bytes;
use ludax::sin;

/** The sample rate every test clip and engine runs at. */
pub const AUD_RATE : i32 = 8000;

/** cos(pi/4): the gain a centred mono sound gets on each side. */
pub const AUD_CENTRE : f64 = 0.7071067811865476;

/** cos(pi/4) again: the gain of each track at the midpoint of an equal-power crossfade. */
pub const AUD_EQUAL_POWER : f64 = 0.7071067811865476;

/** The tolerance for a sample or gain at an exact point of a waveform: f32 rounding only. */
pub const AUD_TOL : f64 = 0.000001;

/** The tolerance for a value that passed a smoothing or interpolating stage, which costs a digit more. */
pub const AUD_TOL_LOOSE : f64 = 0.00001;

/** The tolerance for a normalised peak or a filter level read after it settled. */
pub const AUD_TOL_PEAK : f64 = 0.0001;

/** A mono clip of `n` frames holding the constant level `v`. */
pub fn audioTDc(n : i32, v : f32) : AudioClip {
    let mut c : AudioClip = new AudioClip(AUD_RATE, 1, n);
    for (i of 0..n) {
        c.samples[i as i64] = v;
    }
    return c;
}

/** A sine of `hz` at the test rate, amplitude 0.5. */
pub fn audioTSine(n : i32, hz : f32) : AudioClip {
    let mut c : AudioClip = new AudioClip(AUD_RATE, 1, n);
    for (i of 0..n) {
        c.samples[i as i64] = sin(TAU * hz * (i as f32) / (AUD_RATE as f32)) * (0.5 as f32);
    }
    return c;
}

/** Renders `frames` stereo frames from `e` into a fresh buffer. */
pub fn audioTRender(e : AudioEngine, frames : i32) : f32[] {
    let buf : f32[] = new f32[(frames * 2 + 2) as i64];
    e.render(buf, frames);
    return buf;
}

/** How many of the first `frames` left-channel samples are not zero. */
pub fn audioTCount(buf : f32[], frames : i32) : i32 {
    let mut n : i32 = 0;
    for (i of 0..frames) {
        if (buf[(i * 2) as i64] != 0.0) {
            n = n + 1;
        }
    }
    return n;
}

/** The FNV-1a hash of `frames` frames of `e` as a 16-bit WAV, for comparing whole renders. */
pub fn audioTHash(e : AudioEngine, frames : i32) : i64 {
    let clip : AudioClip = e.renderClip(frames);
    let f : WavFile = WavCodec::encode16(clip);
    return hashFnv1a64Bytes(f.bytes, f.size);
}

/** A scene with several moving and looping sounds, the same every time. */
pub fn audioTScene() : AudioEngine {
    let e : AudioEngine = new AudioEngine(AUD_RATE, 8);
    let a : i32 = e.addClip(audioTSine(800, 440.0));
    let b : i32 = e.addClip(audioTSine(1000, 97.0));
    let mut p : AudioPlay = AudioPlay::forClip(a);
    p.looping = true;
    p.spatial = true;
    p.interp = AudioInterpolation::Cubic;
    p.emitter.position = Vec3 { x: 5.0, y: 0.0, z: -3.0 };
    p.emitter.velocity = Vec3 { x: -2.0, y: 0.0, z: 1.0 };
    e.play(p);
    let mut q : AudioPlay = AudioPlay::forClip(b);
    q.pitch = 1.3;
    q.looping = true;
    q.pan = -0.4;
    e.play(q);
    return e;
}

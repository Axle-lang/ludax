// audio_engine — the software mixer with numbers: pan law, attenuation, Doppler, pitch, loops, limiter, stealing.
//
// The engine is fed clips whose samples are known, so every check can name the output it expects: a DC level
// for gains, a sine for pitch and interpolation, a ramp for loop points. The mixer is deterministic by
// contract, so determinism is checked on a whole scene through a WAV hash rather than on a single voice; the
// limiter, stealing, buses and music each have a check that the effect exists and one that it changes only
// what it should.

use ludax::{
    Checks, Vec3, sin, TAU, fnv1a64Bytes, AudioClip, AudioEngine, AudioPlay, AudioInterp,
    AudioListener
};
use ludax::{
    AudioEmitter, AudioAttenuation, AudioSpatial, AudioSpatialResult, MusicTrack, WavCodec, WavFile
};
use ludax::{AUDIO_BUS_SFX, AUDIO_BUS_MUSIC, AUDIO_BUS_MASTER};

const AUD_RATE : i32 = 8000;
// cos(pi/4): the gain a centred mono sound gets on each side.
const AUD_CENTRE : f64 = 0.7071067811865476;
// cos(pi/4) again: the gain of each track at the midpoint of an equal-power crossfade.
const AUD_EQUAL_POWER : f64 = 0.7071067811865476;

fn audioTDc(n : i32, v : f32) : AudioClip {
    let mut c : AudioClip = new AudioClip(AUD_RATE, 1, n);
    for (i of 0..n) {
        c.samples[i as i64] = v;
    }
    return c;
}

// A sine of `hz` at the test rate, amplitude 0.5.
fn audioTSine(n : i32, hz : f32) : AudioClip {
    let mut c : AudioClip = new AudioClip(AUD_RATE, 1, n);
    for (i of 0..n) {
        c.samples[i as i64] = sin(TAU * hz * (i as f32) / (AUD_RATE as f32)) * (0.5 as f32);
    }
    return c;
}

fn audioTRender(e : AudioEngine, frames : i32) : f32[] {
    let mut buf : f32[] = malloc<f32>((frames * 2 + 2) as i64);
    e.render(buf, frames);
    return buf;
}

fn audioTCount(buf : f32[], frames : i32) : i32 {
    let mut n : i32 = 0;
    for (i of 0..frames) {
        if (buf[(i * 2) as i64] != 0.0) {
            n = n + 1;
        }
    }
    return n;
}

fn audioTAbs(x : f64) : f64 {
    if (x < 0.0) {
        return -x;
    }
    return x;
}

fn audioTHash(e : AudioEngine, frames : i32) : i64 {
    let clip : AudioClip = e.renderClip(frames);
    let f : WavFile = WavCodec::encode16(clip);
    return fnv1a64Bytes(f.bytes, f.size);
}

// A scene with several moving and looping sounds, the same every time.
fn audioTScene() : AudioEngine {
    let mut e : AudioEngine = new AudioEngine(AUD_RATE, 8);
    let a : i32 = e.addClip(audioTSine(800, 440.0));
    let b : i32 = e.addClip(audioTSine(1000, 97.0));
    let mut p : AudioPlay = AudioPlay::forClip(a);
    p.looping = true;
    p.spatial = true;
    p.interp = AudioInterp::Cubic;
    p.emitter.position = Vec3 { x: 5.0, y: 0.0, z: -3.0 };
    p.emitter.velocity = Vec3 { x: -2.0, y: 0.0, z: 1.0 };
    e.play(p);
    let mut q : AudioPlay = AudioPlay::forClip(b);
    q.pitch = 1.3;
    q.looping = true;
    q.pan = -0.4;
    e.play(q);
    return e;
}

/** The audio engine checks, one static function per topic. */
pub class AudioEngineSuite {
    static fn panLaw(c : Checks) : void {
        let mut worst : f64 = 0.0;
        for (i of 0..=40) {
            let pan : f32 = ((i - 20) as f32) / (20.0 as f32);
            let g : Vec3 = AudioSpatial::panGains(pan);
            let power : f64 = (g.x as f64) * (g.x as f64) + (g.y as f64) * (g.y as f64);
            let d : f64 = audioTAbs(power - 1.0);
            if (d > worst) {
                worst = d;
            }
        }
        c.that(
            "pan law: L^2 + R^2 = 1 at 41 positions (worst error ${worst})",
            worst < 0.000001
        );
        let left : Vec3 = AudioSpatial::panGains(-1.0);
        c.near("hard left: L = 1", left.x as f64, 1.0, 0.000001);
        c.near("hard left: R = 0", left.y as f64, 0.0, 0.000001);
        let mid : Vec3 = AudioSpatial::panGains(0.0);
        c.near("centre: L = cos 45 deg", mid.x as f64, AUD_CENTRE, 0.000001);
        c.near("centre: R = sin 45 deg", mid.y as f64, AUD_CENTRE, 0.000001);
        let right : Vec3 = AudioSpatial::panGains(1.0);
        c.near("hard right: R = 1", right.y as f64, 1.0, 0.000001);
        c.near(
            "pan beyond the range is clamped",
            AudioSpatial::panGains(5.0).y as f64,
            1.0,
            0.000001
        );
    }

    static fn attenuation(c : Checks) : void {
        let eps : f64 = 0.00001;
        c.near(
            "inverse at min distance",
            AudioAttenuation::Inverse.gain(1.0, 1.0, 11.0, 1.0) as f64,
            1.0,
            eps
        );
        c.near(
            "inverse inside min distance",
            AudioAttenuation::Inverse.gain(0.2, 1.0, 11.0, 1.0) as f64,
            1.0,
            eps
        );
        c.near(
            "inverse at d=3: 1/3",
            AudioAttenuation::Inverse.gain(3.0, 1.0, 11.0, 1.0) as f64,
            1.0 / 3.0,
            eps
        );
        c.near(
            "inverse at max: 1/11",
            AudioAttenuation::Inverse.gain(11.0, 1.0, 11.0, 1.0) as f64,
            1.0 / 11.0,
            eps
        );
        c.near(
            "inverse beyond max stays at the max value",
            AudioAttenuation::Inverse.gain(500.0, 1.0, 11.0, 1.0) as f64,
            1.0 / 11.0,
            eps
        );
        c.near(
            "inverse with rolloff 2 at d=3: 1/5",
            AudioAttenuation::Inverse.gain(3.0, 1.0, 11.0, 2.0) as f64,
            0.2,
            eps
        );

        c.near(
            "linear at min distance",
            AudioAttenuation::Linear.gain(1.0, 1.0, 11.0, 1.0) as f64,
            1.0,
            eps
        );
        c.near(
            "linear halfway",
            AudioAttenuation::Linear.gain(6.0, 1.0, 11.0, 1.0) as f64,
            0.5,
            eps
        );
        c.near(
            "linear at max is silent",
            AudioAttenuation::Linear.gain(11.0, 1.0, 11.0, 1.0) as f64,
            0.0,
            eps
        );
        c.near(
            "linear rolloff 0.5 at max",
            AudioAttenuation::Linear.gain(11.0, 1.0, 11.0, 0.5) as f64,
            0.5,
            eps
        );
        c.near(
            "linear beyond max",
            AudioAttenuation::Linear.gain(99.0, 1.0, 11.0, 1.0) as f64,
            0.0,
            eps
        );

        c.near(
            "exponential at min distance",
            AudioAttenuation::Exponential.gain(2.0, 2.0, 40.0, 1.0) as f64,
            1.0,
            eps
        );
        c.near(
            "exponential d=4, min 2, rolloff 1: 1/2",
            AudioAttenuation::Exponential.gain(4.0, 2.0, 40.0, 1.0) as f64,
            0.5,
            eps
        );
        c.near(
            "exponential d=8, min 2, rolloff 2: 1/16",
            AudioAttenuation::Exponential.gain(8.0, 2.0, 40.0, 2.0) as f64,
            0.0625,
            eps
        );
        c.near(
            "exponential at max: (20)^-1",
            AudioAttenuation::Exponential.gain(40.0, 2.0, 40.0, 1.0) as f64,
            0.05,
            eps
        );
        c.near(
            "exponential beyond max",
            AudioAttenuation::Exponential.gain(4000.0, 2.0, 40.0, 1.0) as f64,
            0.05,
            eps
        );

        c.near(
            "no attenuation",
            AudioAttenuation::None.gain(1000.0, 1.0, 11.0, 1.0) as f64,
            1.0,
            eps
        );
    }

    static fn doppler(c : Checks) : void {
        let eps : f64 = 0.00001;
        c.near(
            "source approaching at 34.3 m/s: 343 / 308.7",
            AudioSpatial::dopplerRatio(0.0, -34.3, 343.0) as f64,
            343.0 / 308.7,
            eps
        );
        c.near(
            "source receding at 34.3 m/s: 343 / 377.3",
            AudioSpatial::dopplerRatio(0.0, 34.3, 343.0) as f64,
            343.0 / 377.3,
            eps
        );
        c.near(
            "listener approaching at 34.3 m/s: 377.3 / 343",
            AudioSpatial::dopplerRatio(34.3, 0.0, 343.0) as f64,
            1.1,
            eps
        );
        c.near("no motion, no shift", AudioSpatial::dopplerRatio(0.0, 0.0, 343.0) as f64, 1.0, eps);
        c.that(
            "a supersonic source stays finite",
            AudioSpatial::dopplerRatio(0.0, -1000.0, 343.0) < 20.0
        );

        // Through solve(): the emitter ahead of the listener, flying toward it.
        let l : AudioListener = AudioListener {};
        let mut e : AudioEmitter = AudioEmitter {};
        e.position = Vec3 { x: 0.0, y: 0.0, z: -100.0 };
        e.velocity = Vec3 { x: 0.0, y: 0.0, z: 34.3 };
        let r : AudioSpatialResult = AudioSpatial::solve(l, e);
        c.near("solve: approaching emitter ratio", r.doppler as f64, 343.0 / 308.7, 0.0001);
        e.doppler = 0.0;
        c.near(
            "solve: doppler factor 0 disables the shift",
            AudioSpatial::solve(l, e).doppler as f64,
            1.0,
            eps
        );

        let mut side : AudioEmitter = AudioEmitter {};
        side.position = Vec3 { x: 10.0, y: 0.0, z: 0.0 };
        c.near(
            "an emitter on the right pans right",
            AudioSpatial::solve(l, side).pan as f64,
            1.0,
            eps
        );
        side.position = Vec3 { x: -10.0, y: 0.0, z: 0.0 };
        c.near(
            "an emitter on the left pans left",
            AudioSpatial::solve(l, side).pan as f64,
            -1.0,
            eps
        );
        side.position = Vec3 { x: 0.0, y: 0.0, z: -10.0 };
        c.near("an emitter ahead is centred", AudioSpatial::solve(l, side).pan as f64, 0.0, eps);
        side.position = Vec3 { x: 3.0, y: 0.0, z: 4.0 };
        c.near(
            "an emitter behind-right: sine of the azimuth",
            AudioSpatial::solve(l, side).pan as f64,
            0.6,
            eps
        );
    }

    static fn pitch(c : Checks) : void {
        let mut e : AudioEngine = new AudioEngine(AUD_RATE, 4);
        let id : i32 = e.addClip(audioTDc(1000, 0.5));
        let h1 : i32 = e.play(AudioPlay::forClip(id));
        let buf : f32[] = audioTRender(e, 1500);
        c.sameInt("pitch 1: 1000 frames of sound", audioTCount(buf, 1500), 1000);
        c.near("a centred mono sound is 0.5 * cos 45", buf[100] as f64, 0.5 * AUD_CENTRE, 0.000001);
        c.that("the voice ended", !e.isPlaying(h1));

        let mut fast : AudioPlay = AudioPlay::forClip(id);
        fast.pitch = 2.0;
        let h2 : i32 = e.play(fast);
        let buf2 : f32[] = audioTRender(e, 1500);
        let n2 : i32 = audioTCount(buf2, 1500);
        c.that("pitch 2 halves the length (${n2} frames)", n2 >= 499 && n2 <= 501);
        c.that("pitch 2 voice is finished", !e.isPlaying(h2));
        let mut slow : AudioPlay = AudioPlay::forClip(id);
        slow.pitch = 0.5;
        e.play(slow);
        let n3 : i32 = audioTCount(audioTRender(e, 3000), 3000);
        c.that("pitch 0.5 doubles the length (${n3} frames)", n3 >= 1999 && n3 <= 2001);
    }

    static fn loops(c : Checks) : void {
        // A sine of exactly one period looping whole: the output is an unbroken sine.
        let mut e2 : AudioEngine = new AudioEngine(AUD_RATE, 4);
        let s : i32 = e2.addClip(audioTSine(80, 100.0));
        let mut lp : AudioPlay = AudioPlay::forClip(s);
        lp.looping = true;
        e2.play(lp);
        let sb : f32[] = audioTRender(e2, 400);
        let mut worst : f64 = 0.0;
        for (i of 0..400) {
            let want : f64 = 0.5 * AUD_CENTRE
                * (sin(TAU * 100.0 * (i as f32) / (AUD_RATE as f32)) as f64);
            let d : f64 = audioTAbs(sb[(i * 2) as i64] as f64 - want);
            if (d > worst) {
                worst = d;
            }
        }
        c.that(
            "looping a whole period is seamless (worst error ${worst})",
            worst < 0.0001
        );

        // Loop points inside a ramp: frames 0..150 play once, then 50..150 repeat.
        let mut ramp : AudioClip = new AudioClip(AUD_RATE, 1, 200);
        for (i of 0..200) {
            ramp.samples[i as i64] = ((i + 1) as f32) / (256.0 as f32);
        }
        let mut e3 : AudioEngine = new AudioEngine(AUD_RATE, 4);
        let r : i32 = e3.addClip(ramp);
        let mut rp : AudioPlay = AudioPlay::forClip(r);
        rp.looping = true;
        rp.loopStart = 50;
        rp.loopEnd = 150;
        e3.play(rp);
        let rb : f32[] = audioTRender(e3, 400);
        let mut ok : bool = true;
        for (i of 0..400) {
            let mut idx : i32 = i;
            if (i >= 150) {
                idx = 50 + (i - 150) % 100;
            }
            let want : f64 = ((idx + 1) as f64) / 256.0 * AUD_CENTRE;
            if (audioTAbs(rb[(i * 2) as i64] as f64 - want) > 0.00001) {
                ok = false;
            }
        }
        c.that("loop points: intro once, then the region repeats exactly", ok);
    }

    static fn interpolation(c : Checks) : void {
        // Cubic interpolation tracks a pitch-shifted sine better than linear.
        let mut errs : f64 = 0.0;
        let mut errc : f64 = 0.0;
        for (mode of 0..2) {
            let mut ep : AudioEngine = new AudioEngine(AUD_RATE, 2);
            let sid : i32 = ep.addClip(audioTSine(2000, 900.0));
            let mut pp : AudioPlay = AudioPlay::forClip(sid);
            pp.pitch = 1.37;
            if (mode == 1) {
                pp.interp = AudioInterp::Cubic;
            }
            ep.play(pp);
            let pb : f32[] = audioTRender(ep, 1000);
            let mut total : f64 = 0.0;
            for (i of 10..990) {
                let t : f32 = (i as f32) * (1.37 as f32);
                let want : f64 = 0.5 * AUD_CENTRE
                    * (sin(TAU * 900.0 * t / (AUD_RATE as f32)) as f64);
                let d : f64 = pb[(i * 2) as i64] as f64 - want;
                total = total + d * d;
            }
            if (mode == 0) {
                errs = total;
            } else {
                errc = total;
            }
        }
        c.that(
            "cubic is closer to the true sine than linear (${errc} < ${errs})",
            errc < errs * 0.2
        );
    }

    static fn limiter(c : Checks) : void {
        c.near("limiter passes small signals", AudioEngine::softLimit(0.5) as f64, 0.5, 0.0);
        c.near("limiter is odd", AudioEngine::softLimit(-0.5) as f64, -0.5, 0.0);
        c.near(
            "limiter bends above the knee: 0.9 -> 0.8 + 0.2 * (0.5/1.5)",
            AudioEngine::softLimit(0.9) as f64,
            0.8 + 0.2 * (0.5 / 1.5),
            0.000001
        );
        c.that(
            "limiter output never exceeds 1 for huge input",
            AudioEngine::softLimit(1000000.0) <= 1.0 && AudioEngine::softLimit(-1000000.0) >= -1.0
        );
        let mut mono : bool = true;
        let mut prev : f32 = 0.0;
        for (i of 0..400) {
            let y : f32 = AudioEngine::softLimit((i as f32) * (0.05 as f32));
            if (y < prev || y > 1.0) {
                mono = false;
            }
            prev = y;
        }
        c.that("limiter is monotonic and bounded on 0..20", mono);

        // Ten full-scale sounds on top of each other.
        let mut e : AudioEngine = new AudioEngine(AUD_RATE, 16);
        let id : i32 = e.addClip(audioTDc(2000, 1.0));
        let neg : i32 = e.addClip(audioTDc(2000, -1.0));
        for (i of 0..10) {
            let mut p : AudioPlay = AudioPlay::forClip(id);
            p.pan = ((i - 5) as f32) / (5.0 as f32);
            p.gain = 3.0;
            e.play(p);
        }
        let mut q : AudioPlay = AudioPlay::forClip(neg);
        q.gain = 40.0;
        q.pan = 1.0;
        e.play(q);
        let buf : f32[] = audioTRender(e, 2000);
        let mut peak : f32 = 0.0;
        let mut ok : bool = true;
        for (i of 0..4000) {
            let v : f32 = buf[i as i64];
            let a : f32 = v * v;
            if (a > peak) {
                peak = a;
            }
            if (v > 1.0 || v < -1.0) {
                ok = false;
            }
        }
        c.that("overloaded master stays within +-1 (peak^2 ${peak})", ok);
        c.that("overloaded master is loud, not silent", peak > 0.5);
    }

    static fn stealing(c : Checks) : void {
        let mut e : AudioEngine = new AudioEngine(AUD_RATE, 2);
        let id : i32 = e.addClip(audioTDc(100000, 0.1));
        let mut lo : AudioPlay = AudioPlay::forClip(id);
        lo.priority = 1;
        let mut hi : AudioPlay = AudioPlay::forClip(id);
        hi.priority = 5;
        let mut mid : AudioPlay = AudioPlay::forClip(id);
        mid.priority = 3;
        let a : i32 = e.play(hi);
        let b : i32 = e.play(lo);
        c.sameInt("two voices are in use", e.activeVoices(), 2);
        let d : i32 = e.play(mid);
        c.that(
            "the lowest priority voice was stolen",
            d > 0 && !e.isPlaying(b) && e.isPlaying(a) && e.isPlaying(d)
        );
        c.sameInt("one steal counted", e.stolenCount(), 1);
        c.sameInt("a stale handle is not a voice", e.activeVoices(), 2);
        let mut weak : AudioPlay = AudioPlay::forClip(id);
        weak.priority = 0;
        c.sameInt("a sound less important than every voice is refused", e.play(weak), -1);
        c.sameInt("the refusal is counted", e.refusedCount(), 1);
        c.that("a refusal stole nothing", e.isPlaying(a) && e.isPlaying(d));

        // Equal priority: the oldest goes.
        let mut e2 : AudioEngine = new AudioEngine(AUD_RATE, 3);
        let cid : i32 = e2.addClip(audioTDc(100000, 0.1));
        let mut p : AudioPlay = AudioPlay::forClip(cid);
        p.priority = 2;
        let h1 : i32 = e2.play(p);
        let h2 : i32 = e2.play(p);
        let h3 : i32 = e2.play(p);
        let h4 : i32 = e2.play(p);
        c.that(
            "equal priority: the oldest voice is stolen",
            !e2.isPlaying(h1) && e2.isPlaying(h2) && e2.isPlaying(h3) && e2.isPlaying(h4)
        );
        let h5 : i32 = e2.play(p);
        c.that(
            "then the next oldest",
            !e2.isPlaying(h2) && e2.isPlaying(h3) && e2.isPlaying(h4) && e2.isPlaying(h5)
        );

        // A finished voice frees its slot without any stealing.
        let mut e3 : AudioEngine = new AudioEngine(AUD_RATE, 1);
        let sid : i32 = e3.addClip(audioTDc(100, 0.1));
        e3.play(AudioPlay::forClip(sid));
        audioTRender(e3, 200);
        c.sameInt("a finished sound leaves the pool", e3.activeVoices(), 0);
        c.that(
            "so a new sound needs no steal",
            e3.play(AudioPlay::forClip(sid)) > 0 && e3.stolenCount() == 0
        );
    }

    static fn controls(c : Checks) : void {
        let mut e : AudioEngine = new AudioEngine(AUD_RATE, 8);
        let id : i32 = e.addClip(audioTDc(100000, 1.0));
        // Fade in: linear over 1000 frames, so halfway is half.
        let mut p : AudioPlay = AudioPlay::forClip(id);
        p.fadeIn = 0.125;
        p.gain = 0.1;
        let h : i32 = e.play(p);
        let buf : f32[] = audioTRender(e, 2000);
        c.near("fade in starts silent", buf[0] as f64, 0.0, 0.0000001);
        c.near(
            "fade in is half way at half time",
            buf[1000] as f64,
            0.5 * 0.1 * AUD_CENTRE,
            0.0002
        );
        c.near("fade in reaches full level", buf[3000] as f64, 0.1 * AUD_CENTRE, 0.000001);

        // Fade out.
        e.stop(h, 0.0625);
        let fb : f32[] = audioTRender(e, 1000);
        c.that("fade-out ends the voice", !e.isPlaying(h));
        c.near("fade out starts at full level", fb[0] as f64, 0.1 * AUD_CENTRE, 0.0002);
        c.near("fade out half way", fb[500] as f64, 0.5 * 0.1 * AUD_CENTRE, 0.0003);
        c.near("fade out is silent after its end", fb[1200] as f64, 0.0, 0.0);

        // Pause holds the position.
        let mut r : AudioClip = new AudioClip(AUD_RATE, 1, 100);
        for (i of 0..100) {
            r.samples[i as i64] = ((i + 1) as f32) / (128.0 as f32);
        }
        let rid : i32 = e.addClip(r);
        let rh : i32 = e.play(AudioPlay::forClip(rid));
        audioTRender(e, 10);
        e.pause(rh, true);
        let pb : f32[] = audioTRender(e, 20);
        c.near("a paused voice is silent", pb[10] as f64, 0.0, 0.0);
        c.that("a paused voice keeps its slot", e.isPlaying(rh));
        e.pause(rh, false);
        let rb : f32[] = audioTRender(e, 5);
        c.near("resuming continues at frame 10", rb[0] as f64, 11.0 / 128.0 * AUD_CENTRE, 0.00001);

        // Stopping with no fade ends the sound at once.
        e.stop(rh, 0.0);
        c.that("stop(0) frees the voice immediately", !e.isPlaying(rh));
        c.near(
            "engine time follows the frames rendered",
            e.time(),
            (2000.0 + 1000.0 + 10.0 + 20.0 + 5.0) / 8000.0,
            0.0000001
        );
    }

    static fn buses(c : Checks) : void {
        let mut e : AudioEngine = new AudioEngine(AUD_RATE, 8);
        let id : i32 = e.addClip(audioTDc(100000, 0.4));
        let mut p : AudioPlay = AudioPlay::forClip(id);
        p.bus = AUDIO_BUS_SFX;
        let h0 : i32 = e.play(p);
        let full : f64 = audioTRender(e, 10)[5] as f64;
        c.near("sfx at unity", full, 0.4 * AUD_CENTRE, 0.000001);
        e.setBusGain(AUDIO_BUS_SFX, 0.5);
        let half : f64 = audioTRender(e, 300)[598] as f64;
        c.near("sfx bus gain 0.5 halves the level", half, 0.2 * AUD_CENTRE, 0.000001);
        let sub : i32 = e.addBus(AUDIO_BUS_SFX);
        e.setBusGain(sub, 0.5);
        let mut q : AudioPlay = AudioPlay::forClip(id);
        q.bus = sub;
        e.stop(h0, 0.0);
        let hs : i32 = e.play(q);
        c.that("a child bus got an id", sub > 4 && hs > 0);
        let quarter : f64 = audioTRender(e, 600)[1198] as f64;
        c.near(
            "child bus multiplies with its parent: 0.5 * 0.5",
            quarter,
            0.4 * AUD_CENTRE * 0.25,
            0.00002
        );
        e.setBusMuted(AUDIO_BUS_SFX, true);
        let silent : f32[] = audioTRender(e, 200);
        c.near("muting a bus mutes its children too", silent[300] as f64, 0.0, 0.0);
        e.setBusMuted(AUDIO_BUS_SFX, false);
        e.setBusGain(AUDIO_BUS_MASTER, 0.5);
        e.setBusGain(AUDIO_BUS_SFX, 1.0);
        e.setBusGain(sub, 1.0);
        let m : f32[] = audioTRender(e, 600);
        c.near("master gain scales everything", m[1000] as f64, 0.5 * (0.4 * AUD_CENTRE), 0.0002);
        c.sameInt("an unknown parent is refused", e.addBus(99), -1);
        c.that("music bus exists", AUDIO_BUS_MUSIC == 2);
    }

    static fn spatialMixing(c : Checks) : void {
        // Distance attenuation and panning reach the output.
        let mut e : AudioEngine = new AudioEngine(AUD_RATE, 4);
        let id : i32 = e.addClip(audioTDc(100000, 0.8));
        let mut p : AudioPlay = AudioPlay::forClip(id);
        p.spatial = true;
        p.emitter.position = Vec3 { x: 4.0, y: 0.0, z: 0.0 };
        p.emitter.minDistance = 1.0;
        p.emitter.maxDistance = 100.0;
        e.play(p);
        let buf : f32[] = audioTRender(e, 600);
        // d = 4: inverse gain 1/4; fully right.
        c.near(
            "right emitter: right channel = 0.8 * 1/4 (damping aside)",
            buf[2 * 599 + 1] as f64,
            0.8 * 0.25,
            0.01
        );
        c.near("right emitter: left channel is silent", buf[2 * 599] as f64, 0.0, 0.0001);

        // Distance low-pass: an alternating +1/-1 signal (Nyquist) is nearly removed at max distance.
        let mut alt : AudioClip = new AudioClip(AUD_RATE, 1, 4000);
        for (i of 0..4000) {
            alt.samples[i as i64] = (i % 2) as f32 * (2.0 as f32) - (1.0 as f32);
        }
        let mut peaks : f64 = 0.0;
        let mut peakn : f64 = 0.0;
        for (mode of 0..2) {
            let mut en : AudioEngine = new AudioEngine(AUD_RATE, 2);
            let aid : i32 = en.addClip(alt.copy());
            let mut ap : AudioPlay = AudioPlay::forClip(aid);
            ap.spatial = true;
            ap.emitter.model = AudioAttenuation::None;
            ap.emitter.position = Vec3 { x: 0.0, y: 0.0, z: -1.0 };
            if (mode == 1) {
                ap.emitter.position = Vec3 { x: 0.0, y: 0.0, z: -50.0 };
            }
            en.play(ap);
            let ab : f32[] = audioTRender(en, 2000);
            let mut m : f64 = 0.0;
            for (i of 1000..2000) {
                let v : f64 = audioTAbs(ab[(i * 2) as i64] as f64);
                if (v > m) {
                    m = v;
                }
            }
            if (mode == 0) {
                peakn = m;
            } else {
                peaks = m;
            }
        }
        c.near("near sound keeps its high frequencies", peakn, AUD_CENTRE, 0.001);
        c.that(
            "far sound loses them (${peaks} vs ${peakn})",
            peaks < peakn * 0.2
        );
    }

    static fn music(c : Checks) : void {
        let mut e : AudioEngine = new AudioEngine(AUD_RATE, 4);
        let a : i32 = e.addClip(audioTDc(4000, 0.2));
        let b : i32 = e.addClip(audioTDc(4000, 0.4));
        let ha : i32 = e.playMusic(MusicTrack::forClip(a), 0.0);
        let buf : f32[] = audioTRender(e, 500);
        c.near("music plays at its level", buf[600] as f64, 0.2 * AUD_CENTRE, 0.00001);
        c.that("music loops past the end of its clip", e.isPlaying(ha));
        audioTRender(e, 8000);
        c.that("music still plays after two clip lengths", e.isPlaying(ha));

        // Crossfade over 1000 frames.
        let hb : i32 = e.playMusic(MusicTrack::forClip(b), 0.125);
        let cf : f32[] = audioTRender(e, 1200);
        c.near("crossfade start: still the old track", cf[0] as f64, 0.2 * AUD_CENTRE, 0.0002);
        c.near(
            "crossfade midpoint: equal-power mix of both",
            cf[1000] as f64,
            (0.2 * AUD_EQUAL_POWER + 0.4 * AUD_EQUAL_POWER) * AUD_CENTRE,
            0.001
        );
        c.near("crossfade end: only the new track", cf[2 * 1100] as f64, 0.4 * AUD_CENTRE, 0.00001);
        c.that("the old track was released", !e.isPlaying(ha));
        c.that("the new track plays", e.isPlaying(hb));
        let mut smooth : bool = true;
        for (i of 1..1000) {
            let d : f64 = audioTAbs(cf[(i * 2) as i64] as f64 - cf[((i - 1) * 2) as i64] as f64);
            if (d > 0.002) {
                smooth = false;
            }
        }
        c.that("no jump anywhere in the crossfade", smooth);
        e.stopMusic(0.0);
        c.that("stopMusic with no fade ends it", !e.isPlaying(hb));
    }

    static fn determinism(c : Checks) : void {
        let h1 : i64 = audioTHash(audioTScene(), 3000);
        let h2 : i64 = audioTHash(audioTScene(), 3000);
        c.that("rendering the same scene twice gives identical bytes", h1 == h2);
        let mut other : AudioEngine = audioTScene();
        other.setListener(AudioListener { position: Vec3 { x: 1.0, y: 0.0, z: 0.0 } });
        c.that("a different listener gives different bytes", audioTHash(other, 3000) != h1);

        // The offline path survives a WAV round trip.
        let mut e2 : AudioEngine = audioTScene();
        let clip : AudioClip = e2.renderClip(1000);
        let f : WavFile = WavCodec::encodeFloat(clip);
        let back : AudioClip = WavCodec::decode(f.bytes, f.size).clip();
        c.sameInt("rendered clip is stereo", back.channels, 2);
        c.that(
            "float WAV of the render is bit exact",
            back.samples[777] == clip.samples[777] && back.samples[1999] == clip.samples[1999]
        );
    }

    /** Runs every audio engine check. */
    pub static fn run(c : Checks) : void {
        AudioEngineSuite::panLaw(c);
        AudioEngineSuite::attenuation(c);
        AudioEngineSuite::doppler(c);
        AudioEngineSuite::pitch(c);
        AudioEngineSuite::loops(c);
        AudioEngineSuite::interpolation(c);
        AudioEngineSuite::limiter(c);
        AudioEngineSuite::stealing(c);
        AudioEngineSuite::controls(c);
        AudioEngineSuite::buses(c);
        AudioEngineSuite::spatialMixing(c);
        AudioEngineSuite::music(c);
        AudioEngineSuite::determinism(c);
    }
}

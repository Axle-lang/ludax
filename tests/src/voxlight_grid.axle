// voxlight_grid — the voxel grid's chunk arithmetic and neighbour walk.
//
// A coordinate outside the chunk origin must land in the chunk that owns it, and a neighbour across a chunk
// boundary must read the block written on the other side. Both are easy to get wrong at x < 0.

use ludax::{Checks, VoxelGrid, BlockLight, BlockLightTable, voxChunkOf};

/** Checks of the voxel grid: chunk identity, read-back and the cross-chunk neighbour. */
pub class VoxLightGridSuite {
    /** Runs every check. */
    pub static fn run(c : Checks) : void {
        let g : VoxelGrid = new VoxelGrid();
        g.setBlock(-1, 0, 0, 3);
        c.sameInt("negative coord chunk", voxChunkOf(-1), -1);
        c.sameInt("read back", g.blockAt(-1, 0, 0), 3);
        c.sameInt("slots", g.slotCount(), 1);
        g.setBlock(0, 0, 0, 5);
        let a : i32 = g.cellId(-1, 0, 0);
        c.sameInt("neighbour +x crosses chunk", g.blockOfId(g.neighbour(a, 0)), 5);
        c.sameInt("world x", g.cellX(a), -1);
    }
}

// math_mat — Mat3 and Mat4: algebra, inverses, projections and the camera matrix.
//
// The projection checks work in clip space after the perspective divide, where the answer is a small exact
// ratio rather than a matrix entry, so the tolerance says what the mapping promises. Every construction that
// can be handed bad numbers (a zero aspect, equal near and far planes, a look with up parallel to the view)
// is required to answer the identity or a rigid transform instead of trapping; that is the contract a camera
// built from game data leans on.

use ludax::{Checks, Vec3, Vec4, Mat3, Mat4, PI, HALF_PI, toRadians};

use crate::math_support::{nearVec3, nearVec4, nearMat3, nearMat4, nearF};

// A matrix with no special structure: a perspective camera looking at something off-centre.
fn matGeneral() : Mat4 {
    let view : Mat4 = Mat4::lookAt(
        Vec3::make(3.0, 2.0, 8.0),
        Vec3::make(0.5, 0.0, -1.0),
        Vec3::unitY()
    );
    let proj : Mat4 = Mat4::perspective(toRadians(60.0), 1.6, 0.5, 100.0);
    return proj.mul(view).mul(Mat4::translation(Vec3::make(1.0, -2.0, 0.5)));
}

// A point in view space, projected and divided.
fn matProject(m : Mat4, p : Vec3) : Vec3 {
    return m.projectPoint(p);
}

fn matTestAlgebra(c : Checks) : void {
    let id : Mat4 = Mat4::identity();
    let m : Mat4 = matGeneral();
    nearMat4(c, "identity times m is m", id.mul(m), m, 0.0);
    nearMat4(c, "m times identity is m", m.mul(id), m, 0.0);
    nearMat4(
        c,
        "inverse of a general matrix times it is the identity",
        m.inverse().mul(m),
        id,
        0.0001
    );
    nearMat4(c, "it times its inverse is the identity too", m.mul(m.inverse()), id, 0.0001);
    nearMat4(c, "inverse of the identity", id.inverse(), id, 0.0);
    nearMat4(c, "transposed twice is the original", m.transposed().transposed(), m, 0.0);
    let a : Mat4 = Mat4::rotationX(0.7).mul(Mat4::translation(Vec3::make(1.0, 2.0, 3.0)));
    let b : Mat4 = Mat4::scaling(Vec3::make(2.0, 1.0, 0.5)).mul(Mat4::rotationY(-0.3));
    nearMat4(
        c,
        "(ab)^T = b^T a^T",
        a.mul(b).transposed(),
        b.transposed().mul(a.transposed()),
        0.00001
    );
    nearF(c, "determinant of the identity", id.determinant(), 1.0, 0.0);
    nearF(
        c,
        "determinant of a scaling",
        Mat4::scaling(Vec3::make(2.0, 3.0, 4.0)).determinant(),
        24.0,
        0.00001
    );
    nearF(c, "determinant of a rotation", Mat4::rotationZ(1.1).determinant(), 1.0, 0.00001);
    nearF(
        c,
        "determinant of a translation",
        Mat4::translation(Vec3::make(5.0, 6.0, 7.0)).determinant(),
        1.0,
        0.0
    );
    let mut into : Mat4 = id;
    into.setMul(a, b);
    nearMat4(c, "setMul equals mul", into, a.mul(b), 0.0);
    into.setMul(into, into);
    nearMat4(c, "setMul is safe when it aliases its output", into, a.mul(b).mul(a.mul(b)), 0.00001);
}

fn matTestAffine(c : Checks) : void {
    let t : Mat4 = Mat4::translation(Vec3::make(1.0, 2.0, 3.0));
    let p : Vec3 = Vec3::make(1.0, 1.0, 1.0);
    nearVec3(c, "translation moves a point", t.transformPoint(p), Vec3::make(2.0, 3.0, 4.0), 0.0);
    nearVec3(c, "translation does not move a vector", t.transformVector(p), p, 0.0);
    nearVec3(
        c,
        "rotationZ turns X into Y",
        Mat4::rotationZ(HALF_PI).transformVector(Vec3::unitX()),
        Vec3::unitY(),
        0.00001
    );
    nearVec3(
        c,
        "rotationX turns Y into Z",
        Mat4::rotationX(HALF_PI).transformVector(Vec3::unitY()),
        Vec3::unitZ(),
        0.00001
    );
    nearVec3(
        c,
        "rotationY turns Z into X",
        Mat4::rotationY(HALF_PI).transformVector(Vec3::unitZ()),
        Vec3::unitX(),
        0.00001
    );
    nearVec3(
        c,
        "scaling",
        Mat4::scaling(Vec3::make(2.0, 3.0, 4.0)).transformPoint(p),
        Vec3::make(2.0, 3.0, 4.0),
        0.0
    );
    let rotate : Mat4 = Mat4::rotationZ(HALF_PI);
    nearVec3(
        c,
        "translation after rotation: the right operand acts first",
        t.mul(rotate).transformPoint(Vec3::unitX()),
        Vec3::make(1.0, 3.0, 3.0),
        0.00001
    );
    nearVec3(
        c,
        "rotation after translation",
        rotate.mul(t).transformPoint(Vec3::unitX()),
        Vec3::make(-2.0, 2.0, 3.0),
        0.00001
    );
    nearVec3(c, "translationPart", t.translationPart(), Vec3::make(1.0, 2.0, 3.0), 0.0);
    let trs : Mat4 = t.mul(Mat4::rotationY(0.8)).mul(Mat4::scaling(Vec3::make(2.0, 0.5, 3.0)));
    nearMat4(
        c,
        "inverseAffine times m is the identity",
        trs.inverseAffine().mul(trs),
        Mat4::identity(),
        0.00001
    );
    nearMat4(
        c,
        "inverseAffine agrees with the general inverse",
        trs.inverseAffine(),
        trs.inverse(),
        0.00001
    );
    let q : Vec3 = Vec3::make(0.3, -4.0, 2.0);
    nearVec3(
        c,
        "inverseAffine undoes transformPoint",
        trs.inverseAffine().transformPoint(trs.transformPoint(q)),
        q,
        0.0001
    );
    let v4 : Vec4 = trs.transformVec4(Vec4::fromVec3(q, 1.0));
    nearVec3(
        c,
        "transformVec4 with w=1 matches transformPoint",
        v4.xyz(),
        trs.transformPoint(q),
        0.00001
    );
    nearF(c, "transformVec4 keeps w=1 for an affine map", v4.w, 1.0, 0.0);
    nearF(
        c,
        "transformVec4 with w=0 ignores translation",
        trs.transformVec4(Vec4::fromVec3(q, 0.0)).w,
        0.0,
        0.0
    );
    nearMat4(
        c,
        "fromMat3 of a rotation matches rotationY",
        Mat4::fromMat3(Mat3::rotationY(0.4)),
        Mat4::rotationY(0.4),
        0.0
    );
    nearMat3(
        c,
        "upper3x3 of a rotation",
        Mat4::rotationX(0.9).upper3x3(),
        Mat3::rotationX(0.9),
        0.0
    );
}

fn matTestDegenerate(c : Checks) : void {
    let flat : Mat4 = Mat4::scaling(Vec3::make(1.0, 0.0, 1.0));
    c.that("a flattening matrix is not invertible", !flat.isInvertible());
    nearMat4(
        c,
        "inverse of a singular matrix is the identity, not a trap",
        flat.inverse(),
        Mat4::identity(),
        0.0
    );
    nearMat4(c, "inverseAffine of a singular matrix", flat.inverseAffine(), Mat4::identity(), 0.0);
    c.that("a rotation is invertible", Mat4::rotationX(1.0).isInvertible());
    nearMat4(
        c,
        "perspective with a zero aspect",
        Mat4::perspective(1.0, 0.0, 0.1, 10.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "perspective with equal planes",
        Mat4::perspective(1.0, 1.0, 5.0, 5.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "perspective with far before near",
        Mat4::perspective(1.0, 1.0, 5.0, 1.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "perspective with a zero field of view",
        Mat4::perspective(0.0, 1.0, 0.1, 10.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "perspective with a half-turn field of view",
        Mat4::perspective(PI, 1.0, 0.1, 10.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "perspective with a negative near plane",
        Mat4::perspective(1.0, 1.0, -1.0, 10.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "reversed perspective with a zero aspect",
        Mat4::perspectiveReversed(1.0, 0.0, 0.1, 10.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "infinite perspective with near 0",
        Mat4::perspectiveInfiniteReversed(1.0, 1.0, 0.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "ortho with an empty width",
        Mat4::ortho(1.0, 1.0, -1.0, 1.0, 0.0, 1.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "ortho with equal planes",
        Mat4::ortho(-1.0, 1.0, -1.0, 1.0, 2.0, 2.0),
        Mat4::identity(),
        0.0
    );
    nearMat4(
        c,
        "reversed ortho with an empty height",
        Mat4::orthoReversed(-1.0, 1.0, 3.0, 3.0, 0.0, 1.0),
        Mat4::identity(),
        0.0
    );
    let origin : Vec3 = Vec3::make(0.0, 5.0, 0.0);
    let straightDown : Mat4 = Mat4::lookAt(origin, Vec3::zero(), Vec3::unitY());
    nearVec3(
        c,
        "lookAt with up parallel to the view: eye goes to the origin",
        straightDown.transformPoint(origin),
        Vec3::zero(),
        0.00001
    );
    nearVec3(
        c,
        "lookAt with up parallel to the view: target is straight ahead",
        straightDown.transformPoint(Vec3::zero()),
        Vec3::make(0.0, 0.0, -5.0),
        0.00001
    );
    nearF(
        c,
        "lookAt with up parallel is still a rotation",
        straightDown.determinant(),
        1.0,
        0.00001
    );
    let same : Vec3 = Vec3::make(1.0, 2.0, 3.0);
    nearMat4(
        c,
        "lookAt with eye equal to target is only the translation",
        Mat4::lookAt(same, same, Vec3::unitY()),
        Mat4::translation(same.negated()),
        0.0
    );
    let clip : Vec3 = Mat4::perspective(1.0, 1.0, 0.1, 10.0).projectPoint(Vec3::make(
        1.0,
        2.0,
        0.0
    ));
    nearVec3(
        c,
        "projecting a point on the camera plane gives zero, not a trap",
        clip,
        Vec3::zero(),
        0.0
    );
}

fn matTestCamera(c : Checks) : void {
    let view : Mat4 = Mat4::lookAt(Vec3::make(0.0, 0.0, 5.0), Vec3::zero(), Vec3::unitY());
    nearVec3(
        c,
        "lookAt: the eye is the view origin",
        view.transformPoint(Vec3::make(0.0, 0.0, 5.0)),
        Vec3::zero(),
        0.0
    );
    nearVec3(
        c,
        "lookAt: the target is straight ahead on -Z",
        view.transformPoint(Vec3::zero()),
        Vec3::make(0.0, 0.0, -5.0),
        0.0
    );
    let east : Mat4 = Mat4::lookAt(Vec3::zero(), Vec3::unitX(), Vec3::unitY());
    nearVec3(
        c,
        "lookAt east: ahead is -Z",
        east.transformPoint(Vec3::make(1.0, 0.0, 0.0)),
        Vec3::make(0.0, 0.0, -1.0),
        0.00001
    );
    nearVec3(
        c,
        "lookAt east: up stays up",
        east.transformPoint(Vec3::make(0.0, 1.0, 0.0)),
        Vec3::make(0.0, 1.0, 0.0),
        0.00001
    );
    nearVec3(
        c,
        "lookAt east: the camera's right is +Z world",
        east.transformPoint(Vec3::make(0.0, 0.0, 1.0)),
        Vec3::make(1.0, 0.0, 0.0),
        0.00001
    );
    nearF(c, "lookAt is a rigid transform", view.determinant(), 1.0, 0.00001);
}

fn matTestProjections(c : Checks) : void {
    // fov 90 degrees, aspect 2, planes 1 and 10: at the near plane the view reaches x = +-2, y = +-1.
    let p : Mat4 = Mat4::perspective(HALF_PI, 2.0, 1.0, 10.0);
    nearVec3(
        c,
        "perspective: the near plane centre is depth 0",
        matProject(p, Vec3::make(0.0, 0.0, -1.0)),
        Vec3::zero(),
        0.00001
    );
    nearVec3(
        c,
        "perspective: the far plane centre is depth 1",
        matProject(p, Vec3::make(0.0, 0.0, -10.0)),
        Vec3::make(0.0, 0.0, 1.0),
        0.00001
    );
    nearVec3(
        c,
        "perspective: right-top of the near plane is (+1, -1) with Y down",
        matProject(p, Vec3::make(2.0, 1.0, -1.0)),
        Vec3::make(1.0, -1.0, 0.0),
        0.00001
    );
    nearVec3(
        c,
        "perspective: left-bottom of the far plane",
        matProject(p, Vec3::make(-20.0, -10.0, -10.0)),
        Vec3::make(-1.0, 1.0, 1.0),
        0.0001
    );
    nearF(
        c,
        "perspective: depth increases with distance",
        matProject(p, Vec3::make(0.0, 0.0, -5.0)).z - matProject(p, Vec3::make(0.0, 0.0, -3.0)).z,
        0.148148,
        0.00001
    );
    let r : Mat4 = Mat4::perspectiveReversed(HALF_PI, 2.0, 1.0, 10.0);
    nearVec3(
        c,
        "reversed: the near plane is depth 1",
        matProject(r, Vec3::make(0.0, 0.0, -1.0)),
        Vec3::make(0.0, 0.0, 1.0),
        0.00001
    );
    nearVec3(
        c,
        "reversed: the far plane is depth 0",
        matProject(r, Vec3::make(0.0, 0.0, -10.0)),
        Vec3::zero(),
        0.0001
    );
    nearVec3(
        c,
        "reversed: x and y match the standard projection",
        matProject(r, Vec3::make(2.0, 1.0, -1.0)),
        Vec3::make(1.0, -1.0, 1.0),
        0.00001
    );
    let inf : Mat4 = Mat4::perspectiveInfiniteReversed(HALF_PI, 2.0, 1.0);
    nearVec3(
        c,
        "infinite reversed: the near plane is depth 1",
        matProject(inf, Vec3::make(0.0, 0.0, -1.0)),
        Vec3::make(0.0, 0.0, 1.0),
        0.00001
    );
    nearF(
        c,
        "infinite reversed: a far point is nearly 0",
        matProject(inf, Vec3::make(0.0, 0.0, -1000000.0)).z,
        0.0,
        0.000002
    );
    c.that(
        "infinite reversed: depth stays positive",
        matProject(inf, Vec3::make(0.0, 0.0, -1000.0)).z > 0.0
    );
    let o : Mat4 = Mat4::ortho(-2.0, 2.0, -1.0, 1.0, 1.0, 5.0);
    nearVec3(
        c,
        "ortho: right-top-near is (+1, -1, 0)",
        matProject(o, Vec3::make(2.0, 1.0, -1.0)),
        Vec3::make(1.0, -1.0, 0.0),
        0.00001
    );
    nearVec3(
        c,
        "ortho: left-bottom-far is (-1, +1, 1)",
        matProject(o, Vec3::make(-2.0, -1.0, -5.0)),
        Vec3::make(-1.0, 1.0, 1.0),
        0.00001
    );
    nearVec3(
        c,
        "ortho: the middle is the middle",
        matProject(o, Vec3::make(0.0, 0.0, -3.0)),
        Vec3::make(0.0, 0.0, 0.5),
        0.00001
    );
    nearF(c, "ortho keeps w at 1", o.transformVec4(Vec4::make(1.0, 1.0, -2.0, 1.0)).w, 1.0, 0.0);
    let orr : Mat4 = Mat4::orthoReversed(-2.0, 2.0, -1.0, 1.0, 1.0, 5.0);
    nearVec3(
        c,
        "ortho reversed: near is 1",
        matProject(orr, Vec3::make(0.0, 0.0, -1.0)),
        Vec3::make(0.0, 0.0, 1.0),
        0.00001
    );
    nearVec3(
        c,
        "ortho reversed: far is 0",
        matProject(orr, Vec3::make(0.0, 0.0, -5.0)),
        Vec3::zero(),
        0.00001
    );
    nearMat4(
        c,
        "the inverse of a projection undoes it",
        p.inverse().mul(p),
        Mat4::identity(),
        0.0001
    );
    nearMat4(
        c,
        "the inverse of an ortho projection undoes it",
        o.inverse().mul(o),
        Mat4::identity(),
        0.0001
    );
}

fn matTestLayout(c : Checks) : void {
    let m : Mat4 = Mat4::translation(Vec3::make(7.0, 8.0, 9.0)).mul(Mat4::scaling(Vec3::make(
        2.0,
        3.0,
        4.0
    )));
    let mut out : f32[] = malloc<f32>(18);
    let mut i : i32 = 0;
    while (i < 18) {
        out[i] = -1.0;
        i = i + 1;
    }
    m.toColumnMajor(out, 1);
    nearF(c, "column-major: first column starts at the offset", out[1], 2.0, 0.0);
    nearF(c, "column-major: second column, second row", out[6], 3.0, 0.0);
    nearF(c, "column-major: the translation is the fourth column", out[13], 7.0, 0.0);
    nearF(c, "column-major: the translation, y", out[14], 8.0, 0.0);
    nearF(c, "column-major: the translation, z", out[15], 9.0, 0.0);
    nearF(c, "column-major: the last element is m33", out[16], 1.0, 0.0);
    nearF(c, "column-major: nothing is written before the offset", out[0], -1.0, 0.0);
    nearF(c, "column-major: nothing is written after the 16 elements", out[17], -1.0, 0.0);
}

fn matTestMat3(c : Checks) : void {
    let m : Mat3 = Mat3::rotationY(0.6).mul(Mat3::scaling(Vec3::make(2.0, 3.0, 0.5)));
    nearMat3(
        c,
        "Mat3 inverse times m is the identity",
        m.inverse().mul(m),
        Mat3::identity(),
        0.00001
    );
    nearF(
        c,
        "Mat3 determinant of a scaling",
        Mat3::scaling(Vec3::make(2.0, 3.0, 4.0)).determinant(),
        24.0,
        0.00001
    );
    nearF(c, "Mat3 determinant of a rotation", Mat3::rotationX(0.4).determinant(), 1.0, 0.00001);
    nearMat3(
        c,
        "Mat3 transposed of a rotation is its inverse",
        Mat3::rotationZ(0.9).transposed(),
        Mat3::rotationZ(0.9).inverse(),
        0.00001
    );
    nearVec3(
        c,
        "Mat3 rotationZ turns X into Y",
        Mat3::rotationZ(HALF_PI).transform(Vec3::unitX()),
        Vec3::unitY(),
        0.00001
    );
    nearMat3(
        c,
        "Mat3 fromColumns",
        Mat3::fromColumns(Vec3::unitY(), Vec3::unitZ(), Vec3::unitX()).mul(Mat3::fromColumns(
            Vec3::unitZ(),
            Vec3::unitX(),
            Vec3::unitY()
        )),
        Mat3::identity(),
        0.0
    );
    let singular : Mat3 = Mat3::scaling(Vec3::make(1.0, 0.0, 1.0));
    c.that("Mat3 singular is not invertible", !singular.isInvertible());
    nearMat3(
        c,
        "Mat3 inverse of a singular matrix is the identity",
        singular.inverse(),
        Mat3::identity(),
        0.0
    );
    // A surface with normal n and tangent t, stretched along x: the normal must use the inverse transpose.
    let stretch : Mat3 = Mat3::scaling(Vec3::make(2.0, 1.0, 1.0));
    let n : Vec3 = Vec3::make(1.0, 1.0, 0.0);
    let t : Vec3 = Vec3::make(1.0, -1.0, 0.0);
    nearF(
        c,
        "the normal matrix keeps normals perpendicular to the surface",
        stretch.normalMatrix().transform(n).dot(stretch.transform(t)),
        0.0,
        0.00001
    );
    c.that("the plain matrix would not", stretch.transform(n).dot(stretch.transform(t)) > 1.0);
    let q : Vec3 = Vec3::make(1.0, 2.0, 3.0);
    nearVec3(
        c,
        "the normal matrix of a rotation is the rotation",
        Mat3::rotationX(0.5).normalMatrix().transform(q),
        Mat3::rotationX(0.5).transform(q),
        0.00001
    );
}

/** The mat suite. */
pub class MathMatSuite {
    /** Runs the matrix checks. */
    pub static fn run(c : Checks) : void {
        matTestAlgebra(c);
        matTestAffine(c);
        matTestDegenerate(c);
        matTestCamera(c);
        matTestProjections(c);
        matTestLayout(c);
        matTestMat3(c);
    }
}

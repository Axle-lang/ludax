// lux_temporal — checks for the history guard: YCoCg round trips, and the clip of a history to its neighbourhood's
// colour box (inside it stays, outside it is pulled toward the mean onto the box, a point box gives the mean).

use ludax::{Checks, LUX_CLIP_GAMMA, LuxMoments, Vec3, luxFromYCoCg, luxToYCoCg};
use ludax::{LUX_MOTION_STRIDE, LuxUpscale, luxHaltonX, luxHaltonY, sin};

/** Checks the temporal history guard. */
pub class LuxTemporalSuite {
    /** Runs every check of the suite. */
    pub static fn run(mut c : Checks) : void {
        lxtRoundTrip(c);
        lxtClip(c);
        lxtUpscale(c);
        lxtStillWall(c);
        lxtLatest(c);
    }
}

fn lxtNear(a : Vec3, b : Vec3, tolerance : f32) : bool {
    let d : Vec3 = a.minus(b);
    return d.x.abs() <= tolerance && d.y.abs() <= tolerance && d.z.abs() <= tolerance;
}

fn lxtRoundTrip(mut c : Checks) : void {
    let colours : Vec3 = Vec3::make(0.9, 0.35, 0.05);
    let back : Vec3 = luxFromYCoCg(luxToYCoCg(colours));
    c.that(
        "lux temporal: YCoCg goes back to the same RGB",
        lxtNear(back, colours, 0.000001 as f32)
    );
    let grey : Vec3 = luxToYCoCg(Vec3::splat(0.5));
    c.that(
        "lux temporal: a grey has no colour in YCoCg",
        grey.y.abs() < (0.000001 as f32) && grey.z.abs() < (0.000001 as f32)
    );
}

fn lxtClip(mut c : Checks) : void {
    let none : LuxMoments = LuxMoments {};
    let h : Vec3 = Vec3::make(5.0, 0.0, 1.0);
    c.that(
        "lux temporal: with no neighbourhood the history is kept",
        lxtNear(none.clip(h, LUX_CLIP_GAMMA), h, 0.0 as f32)
    );

    let mut m : LuxMoments = LuxMoments {};
    m = m.plus(Vec3::make(0.4, 0.4, 0.4));
    m = m.plus(Vec3::make(0.6, 0.6, 0.6));
    m = m.plus(Vec3::make(0.5, 0.5, 0.5));
    let inside : Vec3 = Vec3::make(0.52, 0.52, 0.52);
    c.that(
        "lux temporal: a history inside the box is kept as it is",
        lxtNear(m.clip(inside, LUX_CLIP_GAMMA), inside, 0.000001 as f32)
    );

    let ghost : Vec3 = Vec3::make(3.0, 0.2, 0.2);
    let held : Vec3 = m.clip(ghost, LUX_CLIP_GAMMA);
    let hy : Vec3 = luxToYCoCg(held);
    c.that(
        "lux temporal: a ghost is pulled in: brightness back near the neighbourhood (${hy.x})",
        hy.x < (0.7 as f32)
    );
    c.that(
        "lux temporal: ... and its colour onto the grey box",
        hy.y.abs() < (0.0001 as f32) && hy.z.abs() < (0.0001 as f32)
    );

    let mut point : LuxMoments = LuxMoments {};
    point = point.plus(Vec3::make(0.2, 0.3, 0.4));
    point = point.plus(Vec3::make(0.2, 0.3, 0.4));
    c.that(
        "lux temporal: a box of no size gives its mean",
        lxtNear(
            point.clip(Vec3::make(1.0, 1.0, 1.0), LUX_CLIP_GAMMA),
            Vec3::make(0.2, 0.3, 0.4),
            0.00001 as f32
        )
    );
}

// The upscaler on a synthetic picture seen by a still camera: a flat colour stays exactly that colour, and a pattern
// finer than the computed picture can hold (vertical stripes of 5 output pixels, under 2 computed pixels) is rebuilt
// from 32 jittered frames closer to the truth than one frame scaled up bilinearly.
fn lxtUpscale(mut c : Checks) : void {
    let w : i32 = 32;
    let h : i32 = 16;
    let scale : i32 = 3;
    let ow : i32 = w * scale;
    let oh : i32 = h * scale;
    let up : LuxUpscale = new LuxUpscale();
    up.fit(ow, oh);
    let mut low : f32[] = new f32[(w * h * 3) as i64];
    let mut motion : f32[] = new f32[((w * h) as i64) * (LUX_MOTION_STRIDE as i64)];

    for (frame of 0..16) {
        let jx : f32 = luxHaltonX(frame);
        let jy : f32 = luxHaltonY(frame);
        lxtStill(motion, w, h, jx, jy);
        for (i of 0..(w * h * 3)) {
            low[i] = 0.5;
        }
        up.rows(low, motion, w, h, jx, jy, 0, oh);
        up.swap();
    }
    let flat : f32[] = up.output();
    let mut off : i32 = 0;
    for (i of 0..(ow * oh * 3)) {
        let d : f32 = flat[i] - (0.5 as f32);
        if (d > (0.00001 as f32) || d < (-0.00001 as f32)) {
            off = off + 1;
        }
    }
    c.sameInt("lux upscale: a flat colour stays that colour (values off)", off, 0);

    let fine : LuxUpscale = new LuxUpscale();
    fine.fit(ow, oh);
    let mut once : f64 = 0.0;
    for (frame of 0..32) {
        let jx : f32 = luxHaltonX(frame % 16);
        let jy : f32 = luxHaltonY(frame % 16);
        lxtStill(motion, w, h, jx, jy);
        for (j of 0..h) {
            for (i of 0..w) {
                // The truth at the sample's own place, in output pixels.
                let x : f32 = ((i as f32) + (0.5 as f32) + jx) * (scale as f32);
                let v : f32 = lxtStripes(x);
                let at : i64 = ((j * w + i) * 3) as i64;
                low[at] = v;
                low[at + 1] = v;
                low[at + 2] = v;
            }
        }
        if (frame == 0) {
            once = lxtBilinearError(low, w, h, scale);
        }
        fine.rows(low, motion, w, h, jx, jy, 0, oh);
        fine.swap();
    }
    let rebuilt : f32[] = fine.output();
    let mut err : f64 = 0.0;
    for (y of 0..oh) {
        for (x of 0..ow) {
            let d : f64 = (rebuilt[((y * ow + x) * 3) as i64]
                - lxtStripes((x as f32) + (0.5 as f32))) as f64;
            err = err + d * d;
        }
    }
    err = err / ((ow * oh) as f64);
    c.that(
        "lux upscale: stripes finer than the computed picture are rebuilt (${err} against ${once} for bilinear)",
        err < once * 0.7
    );
}

// The motion of a still camera: every sample was where it is, at a distance of 10.
fn lxtStill(mut motion : f32[], w : i32, h : i32, jx : f32, jy : f32) : void {
    for (j of 0..h) {
        for (i of 0..w) {
            let m : i64 = ((j * w + i) as i64) * (LUX_MOTION_STRIDE as i64);
            motion[m] = ((i as f32) + (0.5 as f32) + jx) / (w as f32);
            motion[m + 1] = ((j as f32) + (0.5 as f32) + jy) / (h as f32);
            motion[m + 2] = 10.0;
            motion[m + 3] = 10.0;
            motion[m + 4] = 48.0;
        }
    }
}

// A still view of a wall seen edge on: every frame's samples land a sub-pixel apart, and on such a wall that moves their
// distance by far more than the depth test's tolerance (here 10 m on even frames, 40 m on odd ones). The camera has not
// moved, so nothing was revealed and the history must be kept: the output settles. When the distance was asked of a
// still sample, the history was thrown away every frame and the output followed each frame's samples: a still view's
// walls and silhouettes would blink.
fn lxtStillWall(mut c : Checks) : void {
    let w : i32 = 32;
    let h : i32 = 16;
    let ow : i32 = w * 2;
    let oh : i32 = h * 2;
    let n : i64 = (ow as i64) * oh * 3;
    let up : LuxUpscale = new LuxUpscale();
    up.fit(ow, oh);
    let mut low : f32[] = new f32[(w * h * 3) as i64];
    let mut motion : f32[] = new f32[((w * h) as i64) * (LUX_MOTION_STRIDE as i64)];
    let mut before : f32[] = new f32[n];
    for (frame of 0..40) {
        let jx : f32 = luxHaltonX(frame);
        let jy : f32 = luxHaltonY(frame);
        lxtStill(motion, w, h, jx, jy);
        // A checker that swaps every frame, so each 3 x 3 box spans both values and the clamp keeps the history.
        let far : f32 = frame % 2 == 0 ? (10.0 as f32) : (40.0 as f32);
        for (j of 0..h) {
            for (i of 0..w) {
                let k : i64 = ((j * w + i) as i64);
                motion[k * (LUX_MOTION_STRIDE as i64) + 2] = far;
                motion[k * (LUX_MOTION_STRIDE as i64) + 3] = far;
                let v : f32 = (i + j + frame) % 2 == 0 ? (0.8 as f32) : (0.2 as f32);
                low[k * 3] = v;
                low[k * 3 + 1] = v;
                low[k * 3 + 2] = v;
            }
        }
        let shown : f32[] = up.output();
        for (i of 0..n) {
            before[i] = shown[i];
        }
        up.rows(low, motion, w, h, jx, jy, 0, oh);
        up.swap();
    }
    let after : f32[] = up.output();
    let mut change : f64 = 0.0;
    for (i of 0..n) {
        change = change + ((after[i] - before[i]) as f64).abs();
    }
    change = change / (n as f64);
    c.that(
        "lux upscale: a still view keeps its history where the distance jumps (mean change ${change})",
        change < 0.05
    );
}

// Which buffer is which around `swap`: `rows` writes `output()`; after `swap` that picture is `latest()` (what is shown
// and what the next frame reads as its history), and `output()` is the other buffer, the next frame's to write. A
// program that showed `output()` after `swap` would show the frame before the last one.
fn lxtLatest(mut c : Checks) : void {
    let w : i32 = 16;
    let h : i32 = 16;
    let up : LuxUpscale = new LuxUpscale();
    up.fit(w, h);
    let mut low : f32[] = new f32[(w * h * 3) as i64];
    let mut motion : f32[] = new f32[((w * h) as i64) * (LUX_MOTION_STRIDE as i64)];
    lxtStill(motion, w, h, 0.0, 0.0);
    for (frame of 0..3) {
        let level : f32 = (0.25 as f32) * ((frame + 1) as f32);
        for (i of 0..(w * h * 3)) {
            low[i] = level;
        }
        up.rows(low, motion, w, h, 0.0, 0.0, 0, h);
        let written : f32[] = up.output();
        c.that(
            "lux upscale: rows wrote output() (frame ${frame}: ${written[0]})",
            written[0] > level - 0.001 && written[0] < level + 0.001
        );
        up.swap();
        let latest : f32[] = up.latest();
        c.that(
            "... and after swap, latest() is that picture (${latest[0]})",
            latest[0] > level - 0.001 && latest[0] < level + 0.001
        );
        let next : f32[] = up.output();
        c.that(
            "... while output() is now the other buffer (${next[0]}), not that picture",
            next[0] < level - 0.001 || next[0] > level + 0.001
        );
    }
}

// Vertical stripes of 5 output pixels.
fn lxtStripes(x : f32) : f32 {
    return (0.5 as f32) + (0.5 as f32) * sin(x * (1.2566371 as f32));
}

// The mean square error of one frame scaled up bilinearly, against the stripes.
fn lxtBilinearError(low : f32[], w : i32, h : i32, scale : i32) : f64 {
    let ow : i32 = w * scale;
    let mut err : f64 = 0.0;
    for (x of 0..ow) {
        let fx : f32 = ((x as f32) + (0.5 as f32)) / (scale as f32) - (0.5 as f32);
        let mut x0 : i32 = fx as i32;
        if (fx < 0.0) {
            x0 = 0;
        }
        let x1 : i32 = x0 + 1 < w ? x0 + 1 : w - 1;
        let t : f32 = fx - x0 as f32;
        let a : f32 = low[(x0 * 3) as i64];
        let b : f32 = low[(x1 * 3) as i64];
        let v : f32 = a + (b - a) * (t < 0.0 ? 0.0 as f32 : t);
        let d : f64 = (v - lxtStripes((x as f32) + (0.5 as f32))) as f64;
        err = err + d * d;
    }
    return err / (ow as f64);
}

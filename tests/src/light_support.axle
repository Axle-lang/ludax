// light_support — helpers shared by the lighting suites: error tracking, compensated sums, readable output.
//
// The lighting suites compare integrals of different sizes, so an absolute tolerance would mean different
// things in each. `LightWorst` keeps the largest error and its input, and `lightRel` makes the error relative
// with a floor so a zero still compares. `LightSum` is Neumaier-compensated because a plain running sum over
// tens of thousands of quadrature terms loses more than the budgets the suites set.

use ludax::{Checks, Vec3, absD};

/** Tracks the largest error seen by a sweep, and states it against a budget so the number is printed on a
 * miss. */
pub class LightWorst {
    worst : f64 = 0.0;
    at    : string = "";

    /** Records an error (its magnitude) measured at the input described by `where`. */
    pub fn note(mut self, error : f64, where : string) : void {
        let e : f64 = absD(error);
        if (e > self.worst) {
            self.worst = e;
            self.at = where;
        }
    }

    /** The largest error so far. */
    pub fn value(self) : f64 {
        return self.worst;
    }

    /** States that the largest error is within `budget`; the message carries the measurement and its input. */
    pub fn within(self, c : Checks, name : string, budget : f64) : void {
        let worst : f64 = self.worst;
        let at : string = self.at;

        println("  measured ${name}: ${worst} (budget ${budget})");
        c.that("${name} (max error ${worst} at ${at}, budget ${budget})", worst <= budget);
    }
}

/** Neumaier compensated summation: the sum of many terms without the drift of a plain loop. */
pub class LightSum {
    sum  : f64 = 0.0;
    comp : f64 = 0.0;

    /** Adds one term. */
    pub fn add(mut self, x : f64) : void {
        let t : f64 = self.sum + x;
        if (absD(self.sum) >= absD(x)) {
            self.comp = self.comp + ((self.sum - t) + x);
        } else {
            self.comp = self.comp + ((x - t) + self.sum);
        }
        self.sum = t;
    }

    /** The compensated total. */
    pub fn total(self) : f64 {
        return self.sum + self.comp;
    }
}

/** The relative difference |a-b| / max(|b|, floor): a scale-free error with a floor so zeros compare. */
pub fn lightRel(a : f64, b : f64, floor : f64) : f64 {
    let mut scale : f64 = absD(b);
    if (scale < floor) {
        scale = floor;
    }
    return absD(a - b) / scale;
}

/** The tolerance for an f32 result checked against its closed form: about one unit of the last place. */
pub const LIGHT_TOL_ULP : f64 = 0.0000001;

/** The tolerance for an f32 result a few operations from its closed form. */
pub const LIGHT_TOL : f64 = 0.000001;

/** The tolerance for an f32 result of a quadrature or a table lookup, which adds a digit of truncation. */
pub const LIGHT_TOL_LOOSE : f64 = 0.00001;

/** The tolerance for a lighting quantity compared against an independent numerical reference. */
pub const LIGHT_TOL_COARSE : f64 = 0.0001;

/** The text of a vector for failure messages. */
pub fn lightText(v : Vec3) : string {
    return "(${v.x}, ${v.y}, ${v.z})";
}

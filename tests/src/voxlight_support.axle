// voxlight_support — the scenes the voxlight suites build their worlds from.
//
// One block table and two rigs keep every suite on the same ids and the same 32-cell light curve, so a check can
// compare a streamed window with a rebuilt one without also differing in its inputs. The rigs hold no
// expectations of their own; they only spare each suite from repeating the same setup.

use ludax::{BlockLight, BlockLightTable, VoxelGrid, VoxLightCurve, VoxLightFlood, VoxLightWorld};

/** Block ids of the test table. */
pub class VoxIds {
    /** Empty cell, the default. */
    pub static fn air() : i32 {
        return 0;
    }

    /** Opaque stone. */
    pub static fn stone() : i32 {
        return 1;
    }

    /** A white lamp block. */
    pub static fn lamp() : i32 {
        return 2;
    }

    /** Glass that passes red and keeps most green and blue. */
    pub static fn redGlass() : i32 {
        return 3;
    }

    /** Foliage that stops most light. */
    pub static fn leaves() : i32 {
        return 4;
    }

    /** A lamp block with a warm colour. */
    pub static fn warmLamp() : i32 {
        return 5;
    }

    /** Grass ground. */
    pub static fn grass() : i32 {
        return 6;
    }

    /** A red wall, whose bounce tints a pit. */
    pub static fn redWall() : i32 {
        return 7;
    }

    /** A lamp block with a dimmer emission. */
    pub static fn dimLamp() : i32 {
        return 8;
    }

    /** A bright emitters-only block. */
    pub static fn glow() : i32 {
        return 9;
    }
}

/** The shared table: stone, a white lamp, red glass, leaves, a warm lamp, grass, a red wall, a dim lamp. */
pub fn voxTestTable() : BlockLightTable {
    let t : BlockLightTable = new BlockLightTable(16);
    t.define(1, BlockLight::solid(120, 120, 120));
    t.define(2, BlockLight::lamp(255, 255, 255));
    t.define(3, BlockLight::tinted(0, 200, 200));
    t.define(4, BlockLight::tinted(90, 90, 90));
    t.define(5, BlockLight::lamp(255, 128, 64));
    t.define(6, BlockLight::solid(60, 160, 50));
    t.define(7, BlockLight::solid(230, 40, 40));
    t.define(8, BlockLight::lamp(60, 60, 60));
    t.define(9, BlockLight::glow(255, 255, 255));
    return t;
}

/** A grid of `nx * ny * nz` empty chunks with a flood over it. */
pub class VoxLightRig {
    /** The chunks the rig edits. */
    pub grid : Shared<VoxelGrid>;

    /** The block table shared with `voxTestTable`. */
    pub table : Shared<BlockLightTable>;

    /** The 32-cell light curve the flood reads. */
    pub curve : Shared<VoxLightCurve>;

    /** The flood updated by `put`. */
    pub flood : VoxLightFlood;

    constructor(nx : i32, ny : i32, nz : i32, skyStep : i32) {
        let grid : Shared<VoxelGrid> = new shared VoxelGrid();
        let table : Shared<BlockLightTable> = new shared BlockLightTable(16);
        let curve : Shared<VoxLightCurve> = new shared VoxLightCurve(2.0, 32.0);
        for (z of 0..nz) {
            for (y of 0..ny) {
                for (x of 0..nx) {
                    grid.ensureChunk(x, y, z);
                }
            }
        }
        let stock : BlockLightTable = voxTestTable();
        for (i of 0..16) {
            table.define(i, stock.get(i));
        }
        self.grid = grid;
        self.table = table;
        self.curve = curve;
        self.flood = new VoxLightFlood(grid, table, curve, skyStep);
    }

    /** Places a block and updates the light incrementally. */
    pub fn put(mut self, x : i32, y : i32, z : i32, id : i32) : void {
        self.flood.setBlock(x, y, z, id);
    }

    /** Places a block without touching the light (for building a scene before `rebuild`). */
    pub fn set(mut self, x : i32, y : i32, z : i32, id : i32) : void {
        self.grid.setBlock(x, y, z, id);
    }

    /** Fills the box [x0, x1) x [y0, y1) x [z0, z1) with `id`, without touching the light. */
    pub fn fill(
        mut self,
        x0 : i32,
        y0 : i32,
        z0 : i32,
        x1 : i32,
        y1 : i32,
        z1 : i32,
        id : i32
    ) : void {
        for (z of z0..z1) {
            for (y of y0..y1) {
                for (x of x0..x1) {
                    self.grid.setBlock(x, y, z, id);
                }
            }
        }
    }

    /** Block-light level of channel `ch` at a world cell. */
    pub fn level(self, x : i32, y : i32, z : i32, ch : i32) : i32 {
        return self.flood.blockLevel(self.grid.cellId(x, y, z), ch);
    }

    /** Sky light level at a world cell. */
    pub fn sky(self, x : i32, y : i32, z : i32) : i32 {
        return self.flood.skyLevel(self.grid.cellId(x, y, z));
    }

    /** Every plane's keys, concatenated, as a snapshot to compare fields with. */
    pub fn snapshot(self) : i32[] {
        let n : i64 = self.grid.slotCount() as i64 * 4096;
        let mut out : i32[] = malloc<i32>(n * 4);
        for (p of 0..4) {
            for (id of 0..n) {
                out[p as i64 * n + id] = self.flood.valueAt(p, id as i32);
            }
        }
        return out;
    }
}

/** How many entries of two snapshots of `count` entries differ. */
pub fn voxDiffer(a : i32[], b : i32[], count : i64) : i32 {
    let mut diff : i32 = 0;
    for (i of 0..count) {
        if (a[i] != b[i]) {
            diff = diff + 1;
        }
    }
    return diff;
}

/** A `VoxLightWorld` over an empty box of chunks [x0, x0 + nx) x [0, ny) x [0, nz), with the test table. */
pub class VoxWorldRig {
    /** The baked world over `grid`. */
    pub world : VoxLightWorld;

    /** The chunks the rig fills. */
    pub grid : Shared<VoxelGrid>;

    constructor(x0 : i32, nx : i32, ny : i32, nz : i32, workers : i32) {
        let grid : Shared<VoxelGrid> = new shared VoxelGrid();
        let table : Shared<BlockLightTable> = new shared BlockLightTable(16);
        let curve : Shared<VoxLightCurve> = new shared VoxLightCurve(2.0, 32.0);
        for (z of 0..nz) {
            for (y of 0..ny) {
                for (x of x0..x0 + nx) {
                    grid.ensureChunk(x, y, z);
                }
            }
        }
        let stock : BlockLightTable = voxTestTable();
        for (i of 0..16) {
            table.define(i, stock.get(i));
        }
        self.grid = grid;
        self.world = new VoxLightWorld(grid, table, curve, 16, workers);
    }

    /** Fills the box [x0, x1) x [y0, y1) x [z0, z1) with `id`. */
    pub fn fill(
        mut self,
        x0 : i32,
        y0 : i32,
        z0 : i32,
        x1 : i32,
        y1 : i32,
        z1 : i32,
        id : i32
    ) : void {
        for (z of z0..z1) {
            for (y of y0..y1) {
                for (x of x0..x1) {
                    self.grid.setBlock(x, y, z, id);
                }
            }
        }
    }

    /** Sun visibility 0..255 stored for the shell cell (x, y, z); -1 when it is not in the shell. */
    pub fn sun(self, x : i32, y : i32, z : i32) : i32 {
        let ordinal : i32 = self.world.surface.ordinalOf(self.grid.cellId(x, y, z));
        if (ordinal < 0) {
            return -1;
        }
        return self.world.surface.sun(ordinal);
    }

    /** Sky access 0..255 stored for the shell cell (x, y, z); -1 when it is not in the shell. */
    pub fn access(self, x : i32, y : i32, z : i32) : i32 {
        let ordinal : i32 = self.world.surface.ordinalOf(self.grid.cellId(x, y, z));
        if (ordinal < 0) {
            return -1;
        }
        return self.world.surface.access(ordinal);
    }
}

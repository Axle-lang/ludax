// anim_track — keyframe tracks: step, linear, cubic, shortest-path rotations, clamping and time wrapping.
//
// Every interpolation mode is sampled at the points where its definition is exact: a key, a midpoint, a
// quarter of a cubic segment, the 180-degree ambiguity between two rotations. The 1000-key search and its
// uneven spacing exist because the segment lookup is the one part of a track whose bug is invisible on a
// two-key track; the same reason drives the check that a sample agrees with the line it lies on.

use ludax::{Checks, Vec3, Quat, Interp, TrackMath, Vec3Track, QuatTrack, HALF_PI, PI};

use crate::math_support::{nearVec3, sameQuat, nearF};

fn animF(v : f64) : f32 {
    return v as f32;
}

fn animTrackTestLinear(c : Checks) : void {
    let mut t : Vec3Track = new Vec3Track(Interp::Linear, 3);
    t.setKey(0, 0.0, Vec3::make(0.0, 0.0, 0.0));
    t.setKey(1, 1.0, Vec3::make(10.0, 0.0, 0.0));
    t.setKey(2, 3.0, Vec3::make(10.0, 4.0, 0.0));
    nearVec3(c, "linear at the first key", t.sample(0.0), Vec3::make(0.0, 0.0, 0.0), 0.0);
    nearVec3(
        c,
        "linear halfway through the first segment",
        t.sample(0.5),
        Vec3::make(5.0, 0.0, 0.0),
        0.00001
    );
    nearVec3(c, "linear on a key", t.sample(1.0), Vec3::make(10.0, 0.0, 0.0), 0.00001);
    nearVec3(
        c,
        "linear halfway through the long segment",
        t.sample(2.0),
        Vec3::make(10.0, 2.0, 0.0),
        0.00001
    );
    nearVec3(c, "clamps before the first key", t.sample(-4.0), Vec3::make(0.0, 0.0, 0.0), 0.0);
    nearVec3(c, "clamps after the last key", t.sample(99.0), Vec3::make(10.0, 4.0, 0.0), 0.0);
    nearF(c, "end time", t.endTime(), 3.0, 0.0);
    c.that("an empty track animates nothing", Vec3Track::none().isEmpty());
    nearVec3(c, "an empty track samples zero", Vec3Track::none().sample(1.0), Vec3::zero(), 0.0);
    let mut one : Vec3Track = new Vec3Track(Interp::Linear, 1);
    one.setKey(0, 2.0, Vec3::make(7.0, 8.0, 9.0));
    nearVec3(c, "a single key holds everywhere", one.sample(-1.0), Vec3::make(7.0, 8.0, 9.0), 0.0);
    nearVec3(c, "a single key holds after too", one.sample(5.0), Vec3::make(7.0, 8.0, 9.0), 0.0);
}

fn animTrackTestStep(c : Checks) : void {
    let mut t : Vec3Track = new Vec3Track(Interp::Step, 3);
    t.setKey(0, 0.0, Vec3::make(1.0, 0.0, 0.0));
    t.setKey(1, 1.0, Vec3::make(2.0, 0.0, 0.0));
    t.setKey(2, 2.0, Vec3::make(3.0, 0.0, 0.0));
    nearVec3(
        c,
        "step holds the first value up to the next key",
        t.sample(0.999),
        Vec3::make(1.0, 0.0, 0.0),
        0.0
    );
    nearVec3(c, "step jumps on the key", t.sample(1.0), Vec3::make(2.0, 0.0, 0.0), 0.0);
    nearVec3(c, "step holds the middle value", t.sample(1.5), Vec3::make(2.0, 0.0, 0.0), 0.0);
    nearVec3(c, "step ends on the last value", t.sample(2.0), Vec3::make(3.0, 0.0, 0.0), 0.0);
    let mut q : QuatTrack = new QuatTrack(Interp::Step, 2);
    q.setKey(0, 0.0, Quat::identity());
    q.setKey(1, 1.0, Quat::fromAxisAngle(Vec3::unitY(), HALF_PI));
    sameQuat(
        c,
        "a step rotation track holds the first key",
        q.sample(0.75),
        Quat::identity(),
        0.000001
    );
}

fn animTrackTestBinarySearch(c : Checks) : void {
    // 1000 keys of value 2t on unevenly spaced times: every sample must land in the right segment.
    let n : i32 = 1000;
    let mut t : Vec3Track = new Vec3Track(Interp::Linear, n);
    let mut time : f32 = 0.0;
    for (i of 0..n) {
        t.setKey(i, time, Vec3::make(time * animF(2.0), 0.0, 0.0));
        time = time + animF(0.01) + ((i % 7) as f32) * animF(0.003);
    }
    let mut worst : f32 = 0.0;
    for (k of 0..400) {
        let at : f32 = (k as f32) * animF(0.0437);
        let gap : f32 = t.sample(at).x - at * animF(2.0);
        if (at <= t.endTime() && gap * gap > worst) {
            worst = gap * gap;
        }
    }
    c.that(
        "a thousand uneven keys: samples agree with the line they lie on",
        worst < animF(0.000001)
    );
    let mut keys : f32[] = malloc<f32>(10);
    for (i of 0..10) {
        keys[i] = (i * i) as f32;
    }
    c.sameInt(
        "the segment search finds the segment of a time",
        TrackMath::segment(keys, 10, 30.0) as i64,
        5
    );
    c.sameInt(
        "the segment search takes the key itself as the segment start",
        TrackMath::segment(keys, 10, 36.0) as i64,
        6
    );
    c.sameInt(
        "the segment search never answers the last key",
        TrackMath::segment(keys, 10, 81.0) as i64,
        8
    );
}

fn animTrackTestRotation(c : Checks) : void {
    let mut q : QuatTrack = new QuatTrack(Interp::Linear, 2);
    q.setKey(0, 0.0, Quat::identity());
    q.setKey(1, 1.0, Quat::fromAxisAngle(Vec3::unitZ(), HALF_PI));
    let mid : Quat = q.sample(0.5);
    nearF(
        c,
        "a 90 degree track sampled at 0.5 is 45 degrees",
        mid.angle(),
        PI * animF(0.25),
        0.0001
    );
    nearVec3(c, "about the same axis", mid.axis(), Vec3::unitZ(), 0.0001);
    nearF(
        c,
        "constant angular speed: a quarter of the way is 22.5 degrees",
        q.sample(0.25).angle(),
        PI * animF(0.125),
        0.0001
    );
    sameQuat(c, "the first key exactly", q.sample(0.0), Quat::identity(), 0.0);
    sameQuat(
        c,
        "the last key exactly",
        q.sample(1.0),
        Quat::fromAxisAngle(Vec3::unitZ(), HALF_PI),
        0.000001
    );
    nearF(c, "every sample is a unit quaternion", q.sample(0.37).length(), 1.0, 0.00001);

    // 10 degrees to 350 degrees about Y: the short way passes through 0, not through 180.
    let mut s : QuatTrack = new QuatTrack(Interp::Linear, 2);
    s.setKey(0, 0.0, Quat::fromAxisAngle(Vec3::unitY(), animF(0.17453292)));
    s.setKey(1, 1.0, Quat::fromAxisAngle(Vec3::unitY(), animF(6.1086524)));
    sameQuat(
        c,
        "the shortest path between 10 and 350 degrees passes the identity",
        s.sample(0.5),
        Quat::identity(),
        0.0001
    );
}

fn animTrackTestCubic(c : Checks) : void {
    let zero : Vec3 = Vec3::zero();
    let mut t : Vec3Track = new Vec3Track(Interp::Cubic, 2);
    t.setCubicKey(0, 0.0, zero, Vec3::make(0.0, 0.0, 0.0), zero);
    t.setCubicKey(1, 1.0, zero, Vec3::make(8.0, 0.0, 0.0), zero);
    nearVec3(
        c,
        "cubic with zero tangents is the smoothstep midpoint",
        t.sample(0.5),
        Vec3::make(4.0, 0.0, 0.0),
        0.0001
    );
    nearVec3(
        c,
        "cubic eases in: a quarter of the time is less than a quarter of the way",
        t.sample(0.25),
        Vec3::make(animF(1.25), 0.0, 0.0),
        0.0001
    );
    nearVec3(c, "cubic hits the first key", t.sample(0.0), Vec3::make(0.0, 0.0, 0.0), 0.0);
    nearVec3(c, "cubic hits the last key", t.sample(1.0), Vec3::make(8.0, 0.0, 0.0), 0.0);

    // An out-tangent of 1 on the first key, an in-tangent of 1 on the second, equal values: s^3 - 2s^2 + s and
    // s^3 - s^2 at s = 0.5 are 0.125 and -0.125, so the two contributions cancel.
    let one : Vec3 = Vec3::make(1.0, 0.0, 0.0);
    let mut u : Vec3Track = new Vec3Track(Interp::Cubic, 2);
    u.setCubicKey(0, 0.0, zero, zero, one);
    u.setCubicKey(1, 1.0, zero, zero, zero);
    nearVec3(
        c,
        "the out-tangent pushes the curve forward (0.125 at the middle)",
        u.sample(0.5),
        Vec3::make(0.125, 0.0, 0.0),
        0.0001
    );
    let mut w : Vec3Track = new Vec3Track(Interp::Cubic, 2);
    w.setCubicKey(0, 0.0, zero, zero, zero);
    w.setCubicKey(1, 1.0, one, zero, zero);
    nearVec3(
        c,
        "the in-tangent pulls the end (-0.125 at the middle)",
        w.sample(0.5),
        Vec3::make(-0.125, 0.0, 0.0),
        0.0001
    );
    // Tangents are per second: a segment twice as long scales the tangent term twice.
    let mut v : Vec3Track = new Vec3Track(Interp::Cubic, 2);
    v.setCubicKey(0, 0.0, zero, zero, one);
    v.setCubicKey(1, 2.0, zero, zero, zero);
    nearVec3(
        c,
        "tangents scale with the segment length",
        v.sample(1.0),
        Vec3::make(0.25, 0.0, 0.0),
        0.0001
    );

    let mut r : QuatTrack = new QuatTrack(Interp::Cubic, 2);
    let zq : Quat = Quat { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
    r.setCubicKey(0, 0.0, zq, Quat::identity(), zq);
    r.setCubicKey(1, 1.0, zq, Quat::fromAxisAngle(Vec3::unitX(), HALF_PI), zq);
    nearF(
        c,
        "cubic rotation midpoint is 45 degrees",
        r.sample(0.5).angle(),
        PI * animF(0.25),
        0.001
    );
    nearF(c, "cubic rotation is a unit quaternion", r.sample(0.3).length(), 1.0, 0.00001);
    c.that("cubic interpolation reports itself", r.interpolation() == Interp::Cubic);
    c.sameInt(
        "interpolation codes round trip",
        Interp::fromCode(Interp::Cubic.code()).code() as i64,
        2
    );
}

fn animTrackTestTime(c : Checks) : void {
    nearF(c, "looping wraps past the end", TrackMath::wrapTime(2.5, 2.0, true), 0.5, 0.00001);
    nearF(c, "looping wraps a negative time", TrackMath::wrapTime(-0.5, 2.0, true), 1.5, 0.00001);
    nearF(c, "looping on the boundary starts over", TrackMath::wrapTime(4.0, 2.0, true), 0.0, 0.0);
    nearF(c, "a clamped clip stops at the end", TrackMath::wrapTime(7.0, 2.0, false), 2.0, 0.0);
    nearF(c, "a clamped clip stops at the start", TrackMath::wrapTime(-7.0, 2.0, false), 0.0, 0.0);
    nearF(c, "a clip of no length answers zero", TrackMath::wrapTime(3.0, 0.0, true), 0.0, 0.0);
}

/** The keyframe track suite. */
pub class AnimTrackSuite {
    /** Runs the keyframe track checks. */
    pub static fn run(c : Checks) : void {
        animTrackTestLinear(c);
        animTrackTestStep(c);
        animTrackTestBinarySearch(c);
        animTrackTestRotation(c);
        animTrackTestCubic(c);
        animTrackTestTime(c);
    }
}

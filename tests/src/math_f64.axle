// math_f64 — the f64 twins (DVec3, DMat4, DQuat, DTransform, DAabb, ...) and the bridge to f32.
//
// The twins are generated from the f32 originals, so these checks restate the same properties at the wider
// precision instead of discovering new ones; a geometry that must hold at both precisions is checked twice.
// The bridge checks pin the reason f64 is used for world positions: a millimetre survives at ten thousand
// kilometres only when the point is made relative to the camera before narrowing.

use ludax::{
    Checks, DVec2, DVec3, DVec4, DMat3, DMat4, DQuat, DTransform, DAabb, DSphere, DRay, DPlane,
    DRayHit
};
use ludax::{Vec3, Quat, Mat4, HALF_PI_D, PI_D};
use ludax::{
    rayAabbD, raySphereD, rayTriangleD, rayPlaneD, aabbOverlapD, sphereOverlapD, sphereAabbOverlapD
};
use ludax::{widenVec3, narrowVec3, relativeVec3, widenQuat, narrowQuat, narrowMat4, widenMat4};

use crate::math_support::{MATH_TOL_D, MATH_TOL_D_LOOSE};

fn d64Near(c : Checks, name : string, got : DVec3, want : DVec3, tol : f64) : void {
    c.that(
        "${name} (got ${got.x}, ${got.y}, ${got.z})",
        got.approxEq(want, tol)
    );
}

fn d64TestVectors(c : Checks) : void {
    let a : DVec3 = DVec3::make(1.0, 2.0, 3.0);
    let b : DVec3 = DVec3::make(-2.0, 0.5, 4.0);
    d64Near(c, "plus", a.plus(b), DVec3::make(-1.0, 2.5, 7.0), 0.0);
    d64Near(c, "minus", a.minus(b), DVec3::make(3.0, 1.5, -1.0), 0.0);
    d64Near(c, "scale", a.scale(2.0), DVec3::make(2.0, 4.0, 6.0), 0.0);
    d64Near(c, "x cross y is z", DVec3::unitX().cross(DVec3::unitY()), DVec3::unitZ(), 0.0);
    c.near("f64: DVec3 dot of two vectors is exact", a.dot(b), 11.0, 0.0);
    c.near(
        "f64: the length of (2, 3, 6) is exactly 7",
        DVec3::make(2.0, 3.0, 6.0).length(),
        7.0,
        0.0
    );
    d64Near(c, "normalized", a.normalized().scale(a.length()), a, MATH_TOL_D_LOOSE);
    d64Near(c, "normalized of zero", DVec3::zero().normalized(), DVec3::zero(), 0.0);
    d64Near(c, "lerp", a.lerp(b, 0.5), DVec3::make(-0.5, 1.25, 3.5), 0.0);
    d64Near(
        c,
        "reflect",
        DVec3::make(1.0, -1.0, 0.0).reflect(DVec3::unitY()),
        DVec3::make(1.0, 1.0, 0.0),
        0.0
    );
    d64Near(c, "abs", b.abs(), DVec3::make(2.0, 0.5, 4.0), 0.0);
    let m : DVec3 = a;
    m.addIn(b);
    m.mulAddIn(b, 2.0);
    d64Near(c, "in-place", m, a.plus(b).plus(b.scale(2.0)), 0.0);
    let v2 : DVec2 = DVec2::make(3.0, 4.0);
    c.near("f64: the DVec2 length of (3, 4) is 5", v2.length(), 5.0, 0.0);
    d64Near(
        c,
        "anyPerpendicular",
        a.anyPerpendicular().scale(a.anyPerpendicular().dot(a)),
        DVec3::zero(),
        MATH_TOL_D_LOOSE
    );
    let v4 : DVec4 = DVec4::fromVec3(a, 1.0);
    c.near("f64: a DVec4 dotted with itself is the sum of its squares", v4.dot(v4), 15.0, 0.0);
}

fn d64TestMatrices(c : Checks) : void {
    let view : DMat4 = DMat4::lookAt(
        DVec3::make(3.0, 2.0, 8.0),
        DVec3::make(0.5, 0.0, -1.0),
        DVec3::unitY()
    );
    let proj : DMat4 = DMat4::perspective(1.0, 1.6, 0.5, 100.0);
    let m : DMat4 = proj.mul(view).mul(DMat4::translation(DVec3::make(1.0, -2.0, 0.5)));
    c.that(
        "DMat4 inverse times m is the identity (to 1e-9)",
        m.inverse().mul(m).approxEq(DMat4::identity(), 0.000000001)
    );
    let trs : DMat4 = DMat4::translation(DVec3::make(1.0, 2.0, 3.0)).mul(DMat4::rotationY(0.8));
    c.that(
        "DMat4 inverseAffine",
        trs.inverseAffine().mul(trs).approxEq(DMat4::identity(), MATH_TOL_D_LOOSE)
    );
    d64Near(
        c,
        "DMat4 rotationZ",
        DMat4::rotationZ(HALF_PI_D).transformVector(DVec3::unitX()),
        DVec3::unitY(),
        MATH_TOL_D
    );
    let near : DVec3 = DMat4::perspective(HALF_PI_D, 1.0, 1.0, 10.0).projectPoint(DVec3::make(
        0.0,
        0.0,
        -10.0
    ));
    c.near("DMat4 far plane depth is 1", near.z, 1.0, MATH_TOL_D_LOOSE);
    let inf : DVec3 = DMat4::perspectiveInfiniteReversed(
        HALF_PI_D,
        1.0,
        1.0
    ).projectPoint(DVec3::make(0.0, 0.0, -1.0));
    c.near("DMat4 infinite reversed near depth is 1", inf.z, 1.0, MATH_TOL_D_LOOSE);
    c.near(
        "f64: a DMat3 rotation has determinant 1",
        DMat3::rotationX(0.3).determinant(),
        1.0,
        MATH_TOL_D
    );
    c.that(
        "DMat4 singular is not invertible",
        !DMat4::scaling(DVec3::make(1.0, 0.0, 1.0)).isInvertible()
    );
    c.that(
        "f64: a DMat4 orthographic projection has a nonzero determinant",
        DMat4::ortho(-1.0, 1.0, -1.0, 1.0, 0.0, 1.0).determinant() != 0.0
    );
    c.near(
        "DMat4 orthoReversed",
        DMat4::orthoReversed(-1.0, 1.0, -1.0, 1.0, 0.0, 2.0).projectPoint(DVec3::make(
            0.0,
            0.0,
            0.0
        )).z,
        1.0,
        0.0
    );
    c.near(
        "DMat4 perspectiveReversed",
        DMat4::perspectiveReversed(1.0, 1.0, 1.0, 10.0).projectPoint(DVec3::make(0.0, 0.0, -1.0)).z,
        1.0,
        MATH_TOL_D_LOOSE
    );
}

fn d64TestRotations(c : Checks) : void {
    let q : DQuat = DQuat::fromAxisAngle(DVec3::make(0.3, -1.0, 0.8), 2.2);
    let p : DVec3 = DVec3::make(1.0, -2.0, 0.5);
    d64Near(
        c,
        "DQuat rotate agrees with its matrix",
        q.toMat3().transform(p),
        q.rotate(p),
        MATH_TOL_D
    );
    c.that(
        "DQuat fromMat3 round trip",
        DQuat::fromMat3(q.toMat3()).sameRotation(q, MATH_TOL_D)
    );
    let r : DQuat = DQuat::fromAxisAngle(DVec3::unitY(), 0.2).slerp(
        DQuat::fromAxisAngle(DVec3::unitY(), 1.8),
        0.5
    );
    c.near("DQuat slerp midpoint angle", r.angle(), 1.0, 0.000000000000002);
    d64Near(
        c,
        "DQuat fromTo",
        DQuat::fromTo(DVec3::unitX(), DVec3::unitZ()).rotate(DVec3::unitX()),
        DVec3::unitZ(),
        MATH_TOL_D
    );
    let t : DTransform = DTransform::make(DVec3::make(1.0, 2.0, 3.0), q, DVec3::splat(2.0));
    d64Near(
        c,
        "DTransform inverse undoes",
        t.inverse().transformPoint(t.transformPoint(p)),
        p,
        MATH_TOL_D
    );
    c.that(
        "DTransform toMat4",
        t.toMat4().approxEq(t.toMat4().inverseAffine().inverseAffine(), MATH_TOL_D_LOOSE)
    );
    d64Near(
        c,
        "DTransform mul",
        t.mul(t).transformPoint(p),
        t.transformPoint(t.transformPoint(p)),
        MATH_TOL_D_LOOSE
    );
    c.near(
        "f64: halfway between two DTransforms the scale is the midpoint",
        t.lerp(DTransform::identity(), 0.5).scale.x,
        1.5,
        0.0
    );
}

fn d64TestGeometry(c : Checks) : void {
    let box : DAabb = DAabb::make(DVec3::splat(-1.0), DVec3::splat(1.0));
    let hit : DRayHit = rayAabbD(
        DRay::make(DVec3::make(0.0, 0.0, 5.0), DVec3::make(0.0, 0.0, -1.0)),
        box
    );
    c.that("f64: a ray at a box hits it", hit.hit);
    c.near("f64: the ray-box hit distance is 4", hit.t, 4.0, 0.0);
    c.that(
        "ray-aabb miss",
        !rayAabbD(DRay::make(DVec3::make(3.0, 0.0, 5.0), DVec3::make(0.0, 0.0, -1.0)), box).hit
    );
    let s : DSphere = DSphere::make(DVec3::zero(), 2.0);
    c.near(
        "ray-sphere t",
        raySphereD(DRay::make(DVec3::make(0.0, 0.0, 10.0), DVec3::make(0.0, 0.0, -1.0)), s).t,
        8.0,
        MATH_TOL_D
    );
    let tri : DRayHit = rayTriangleD(
        DRay::make(DVec3::make(0.5, 0.5, 3.0), DVec3::make(0.0, 0.0, -1.0)),
        DVec3::zero(),
        DVec3::make(2.0, 0.0, 0.0),
        DVec3::make(0.0, 2.0, 0.0),
        true
    );
    c.that("f64: a ray at a triangle hits it", tri.hit);
    c.near("f64: the ray-triangle hit has barycentric u of 0.25", tri.u, 0.25, 0.0);
    c.near(
        "ray-plane t",
        rayPlaneD(
            DRay::make(DVec3::make(0.0, 4.0, 0.0), DVec3::make(0.0, -2.0, 0.0)),
            DPlane::fromPointNormal(DVec3::zero(), DVec3::unitY())
        ).t,
        2.0,
        0.0
    );
    c.that(
        "f64: overlapping boxes are reported as overlapping",
        aabbOverlapD(box, DAabb::make(DVec3::splat(0.5), DVec3::splat(3.0)))
    );
    c.that(
        "f64: separated boxes are reported as not overlapping",
        !aabbOverlapD(box, DAabb::make(DVec3::splat(1.5), DVec3::splat(3.0)))
    );
    c.that(
        "f64: overlapping spheres are reported as overlapping",
        sphereOverlapD(s, DSphere::make(DVec3::make(3.0, 0.0, 0.0), 1.0))
    );
    c.that(
        "sphere-aabb overlap",
        sphereAabbOverlapD(DSphere::make(DVec3::make(2.0, 0.0, 0.0), 1.0), box)
    );
    c.that("f64: the empty box reports isEmpty", DAabb::empty().isEmpty());
    c.near("f64: a box of side 2 has volume 8", box.volume(), 8.0, 0.0);
    d64Near(
        c,
        "box transformed",
        box.transformed(DMat4::translation(DVec3::make(5.0, 0.0, 0.0))).center(),
        DVec3::make(5.0, 0.0, 0.0),
        0.0
    );
    d64Near(c, "bounding sphere", DSphere::enclosing(box).center, DVec3::zero(), 0.0);
    c.that(
        "plane from triangle",
        DPlane::fromTriangle(DVec3::zero(), DVec3::unitX(), DVec3::unitY()).normal.approxEq(
            DVec3::unitZ(),
            0.0
        )
    );
}

fn d64TestBridge(c : Checks) : void {
    // Ten thousand kilometres from the origin, a millimetre still exists in f64 but not in f32.
    let far : DVec3 = DVec3::make(10000000.001, 0.0, 0.0);
    let camera : DVec3 = DVec3::make(10000000.0, 0.0, 0.0);
    c.near("f64 keeps a millimetre at 10000 km", far.x - camera.x, 0.001, 0.0000001);
    c.that(
        "f64: narrowing the far point to f32 loses the offset from the camera",
        narrowVec3(far).x == narrowVec3(camera).x
    );
    c.near(
        "relative to the camera it survives narrowing",
        relativeVec3(far, camera).x as f64,
        0.001,
        0.000001
    );
    let v : Vec3 = Vec3::make(1.5, -2.25, 3.0);
    c.that("widen then narrow is exact", narrowVec3(widenVec3(v)).approxEq(v, 0.0));
    let q : Quat = Quat::fromAxisAngle(Vec3::unitY(), 0.7);
    c.that(
        "f64: a quaternion survives widening and narrowing",
        narrowQuat(widenQuat(q)).sameRotation(q, 0.000001)
    );
    c.near("widened quaternion is unit", widenQuat(q).length(), 1.0, 0.000001);
    let m : Mat4 = Mat4::rotationX(0.4).mul(Mat4::translation(Vec3::make(1.0, 2.0, 3.0)));
    c.that(
        "f64: a matrix survives widening and narrowing exactly",
        narrowMat4(widenMat4(m)).approxEq(m, 0.0)
    );
    c.near("f64: PI_D holds all digits of pi", PI_D, 3.141592653589793, 0.0);
}

/** The f64 suite. */
pub class MathF64Suite {
    /** Runs the f64 checks. */
    pub static fn run(c : Checks) : void {
        d64TestVectors(c);
        d64TestMatrices(c);
        d64TestRotations(c);
        d64TestGeometry(c);
        d64TestBridge(c);
    }
}

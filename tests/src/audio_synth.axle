// audio_synth — the synth toolkit: waveshapes, ADSR values at exact times, filter DC gain, echo, reverb, clips.
//
// The synth pieces are checked at the values their definitions name: a wave at 0, 1/4, 1/2 and 3/4 of a
// cycle, an envelope at each of its corners and after release, a delay at its echo times. Noise and the
// generated clips are checked through a seed, because repeatability is the property a game's sound depends
// on, while the filter and reverb are checked for the shape of their response rather than one sample.

use std::io::{FileInputStream};
use std::io::path::Path;

use ludax::{
    Checks, Pcg32, sin, TAU, AudioClip, AudioEngine, AudioPlay, AudioOffline, WavCodec, WavFile
};
use ludax::{SynthWave, SynthAdsr, SynthFilter, SynthDelay, SynthReverb, Synth};

use crate::audio_support::{AUD_TOL, AUD_TOL_LOOSE, AUD_TOL_PEAK};

// The number of sign changes in the first `n` frames of a mono clip.
fn synTCrossings(clip : AudioClip, n : i32) : i32 {
    let mut count : i32 = 0;
    for (i of 1..n) {
        if ((clip.samples[(i - 1) as i64] < 0.0) != (clip.samples[i as i64] < 0.0)) {
            count = count + 1;
        }
    }
    return count;
}

/** The synth checks, one static function per topic. */
pub class AudioSynthSuite {
    static fn waves(c : Checks) : void {
        let rng : Pcg32 = new Pcg32(1, 1);
        c.near("a sine at phase 0 is zero", SynthWave::Sine.sample(0.0, rng) as f64, 0.0, AUD_TOL);
        c.near("sine at a quarter turn", SynthWave::Sine.sample(0.25, rng) as f64, 1.0, AUD_TOL);
        c.near("sine at three quarters", SynthWave::Sine.sample(0.75, rng) as f64, -1.0, AUD_TOL);
        c.near(
            "the phase wraps: 1.25 is 0.25",
            SynthWave::Sine.sample(1.25, rng) as f64,
            1.0,
            AUD_TOL
        );
        c.near(
            "negative phases wrap: -0.75 is 0.25",
            SynthWave::Sine.sample(-0.75, rng) as f64,
            1.0,
            AUD_TOL
        );
        c.near(
            "a square in the first half-cycle is +1",
            SynthWave::Square.sample(0.1, rng) as f64,
            1.0,
            0.0
        );
        c.near(
            "a square in the second half-cycle is -1",
            SynthWave::Square.sample(0.6, rng) as f64,
            -1.0,
            0.0
        );
        c.near("a saw at phase 0 is -1", SynthWave::Saw.sample(0.0, rng) as f64, -1.0, AUD_TOL);
        c.near("a saw at phase 0.5 is zero", SynthWave::Saw.sample(0.5, rng) as f64, 0.0, AUD_TOL);
        c.near(
            "saw just before the wrap",
            SynthWave::Saw.sample(0.999, rng) as f64,
            0.998,
            AUD_TOL_LOOSE
        );
        c.near(
            "a triangle at phase 0 is zero",
            SynthWave::Triangle.sample(0.0, rng) as f64,
            0.0,
            AUD_TOL
        );
        c.near(
            "triangle at a quarter",
            SynthWave::Triangle.sample(0.25, rng) as f64,
            1.0,
            AUD_TOL
        );
        c.near("triangle at a half", SynthWave::Triangle.sample(0.5, rng) as f64, 0.0, AUD_TOL);
        c.near(
            "triangle at three quarters",
            SynthWave::Triangle.sample(0.75, rng) as f64,
            -1.0,
            AUD_TOL
        );

        let a : Pcg32 = new Pcg32(7, 2);
        let b : Pcg32 = new Pcg32(7, 2);
        let mut same : bool = true;
        let mut inRange : bool = true;
        let mut sum : f64 = 0.0;
        for (i of 0..4000) {
            let x : f32 = SynthWave::Noise.sample(0.0, a);
            let y : f32 = SynthWave::Noise.sample(0.0, b);
            if (x != y) {
                same = false;
            }
            if (x < -1.0 || x >= 1.0) {
                inRange = false;
            }
            sum = sum + x as f64;
        }
        c.that("noise from one seed is repeatable", same);
        c.that("noise stays in -1..1", inRange);
        let mean : f64 = sum / 4000.0;
        c.that("noise is centred (mean ${mean})", mean > -0.05 && mean < 0.05);
    }

    static fn envelope(c : Checks) : void {
        let env : SynthAdsr = SynthAdsr::make(0.1, 0.2, 0.5, 0.4);
        let eps : f64 = AUD_TOL;
        c.near("an adsr envelope starts at level zero", env.level(0.0, 1.0) as f64, 0.0, eps);
        c.near("adsr halfway up the attack", env.level(0.05, 1.0) as f64, 0.5, eps);
        c.near("adsr at the attack peak", env.level(0.1, 1.0) as f64, 1.0, eps);
        c.near("adsr halfway down the decay", env.level(0.2, 1.0) as f64, 0.75, eps);
        c.near("adsr at the end of the decay", env.level(0.3, 1.0) as f64, 0.5, eps);
        c.near(
            "an adsr holds the sustain level 0.5 until release",
            env.level(0.8, 1.0) as f64,
            0.5,
            eps
        );
        c.near("adsr at release time", env.level(1.0, 1.0) as f64, 0.5, eps);
        c.near("adsr halfway through the release", env.level(1.2, 1.0) as f64, 0.25, eps);
        c.near("adsr at the end of the release", env.level(1.4, 1.0) as f64, 0.0, eps);
        c.near("adsr after the release", env.level(5.0, 1.0) as f64, 0.0, eps);
        // Released during the attack: the release starts from where the level was (0.5 at t=0.05).
        c.near("adsr released mid-attack, halfway down", env.level(0.25, 0.05) as f64, 0.25, eps);
        c.near(
            "a one-second note with a 0.4 s release lasts 1.4 s",
            env.length(1.0) as f64,
            1.4,
            eps
        );
        let instant : SynthAdsr = SynthAdsr::make(0.0, 0.0, 1.0, 0.0);
        c.near("an instant envelope is a gate", instant.level(0.5, 1.0) as f64, 1.0, eps);
        c.near("and closes at the gate", instant.level(1.5, 1.0) as f64, 0.0, eps);
    }

    static fn filters(c : Checks) : void {
        let lp : SynthFilter = new SynthFilter(1000.0, 44100, false);
        let mut y : f32 = 0.0;
        for (i of 0..5000) {
            y = lp.process(1.0);
        }
        c.near("low-pass has unity gain at DC", y as f64, 1.0, AUD_TOL_PEAK);
        let hp : SynthFilter = new SynthFilter(1000.0, 44100, true);
        let mut z : f32 = 0.0;
        for (i of 0..5000) {
            z = hp.process(1.0);
        }
        c.near(
            "a high-pass filter settles to zero on a constant input",
            z as f64,
            0.0,
            AUD_TOL_PEAK
        );
        let first : SynthFilter = new SynthFilter(1000.0, 44100, true);
        c.near("high-pass passes the first step", first.process(1.0) as f64, 1.0 - 0.12486, 0.01);

        // A tone far above the cutoff is attenuated by about cutoff / frequency.
        let lp2 : SynthFilter = new SynthFilter(500.0, 44100, false);
        let mut peak : f32 = 0.0;
        for (i of 0..4410) {
            let v : f32 = lp2.process(sin(TAU * 10000.0 * (i as f32) / (44100.0 as f32)));
            if (i > 2000 && v > peak) {
                peak = v;
            }
        }
        c.that("low-pass at 500 Hz attenuates 10 kHz by more than 10x (peak ${peak})", peak < 0.1);
        let lp3 : SynthFilter = new SynthFilter(5000.0, 44100, false);
        let mut p3 : f32 = 0.0;
        for (i of 0..4410) {
            let v : f32 = lp3.process(sin(TAU * 100.0 * (i as f32) / (44100.0 as f32)));
            if (i > 2000 && v > p3) {
                p3 = v;
            }
        }
        c.that("low-pass at 5 kHz passes 100 Hz nearly intact (peak ${p3})", p3 > 0.97);
    }

    static fn effects(c : Checks) : void {
        let d : SynthDelay = new SynthDelay(100, 0.5, 1.0);
        let mut out : f32[] = new f32[401 as i64];
        for (i of 0..401) {
            let mut x : f32 = 0.0;
            if (i == 0) {
                x = 1.0;
            }
            out[i as i64] = d.process(x);
        }
        c.near("delay passes the dry impulse", out[0] as f64, 1.0, AUD_TOL);
        c.near("first echo at the delay time", out[100] as f64, 1.0, AUD_TOL);
        c.near("second echo is scaled by the feedback", out[200] as f64, 0.5, AUD_TOL);
        c.near(
            "the third echo is scaled by the feedback twice (0.25)",
            out[300] as f64,
            0.25,
            AUD_TOL
        );
        c.near("the output is silent between echoes", out[150] as f64, 0.0, AUD_TOL);

        // Reverb: an impulse makes a tail that is finite, non-trivial and dies away.
        let r : SynthReverb = new SynthReverb(44100, 0.8, 0.3, 1.0);
        let mut early : f64 = 0.0;
        let mut late : f64 = 0.0;
        let mut finite : bool = true;
        for (i of 0..88200) {
            let mut x : f32 = 0.0;
            if (i == 0) {
                x = 1.0;
            }
            let v : f32 = r.process(x);
            if (!(v == v) || v > 100.0 || v < -100.0) {
                finite = false;
            }
            let e : f64 = (v as f64) * (v as f64);
            if (i >= 1 && i < 22050) {
                early = early + e;
            }
            if (i >= 66150) {
                late = late + e;
            }
        }
        c.that("reverb output stays finite", finite);
        c.that("reverb makes a tail (energy ${early})", early > 0.0000001);
        c.that("and the tail decays (late ${late} < early)", late < early * 0.5);
    }

    static fn clips(c : Checks) : void {
        let env : SynthAdsr = SynthAdsr::make(0.0, 0.0, 1.0, 0.0);
        let t : AudioClip = Synth::tone(SynthWave::Sine, 441.0, 0.5, env, 44100, 1);
        c.sameInt("tone length is gate + release", t.frames, 22050);
        // 441 Hz for 0.5 s is 220.5 cycles: 441 sign changes.
        let cross : i32 = synTCrossings(t, t.frames);
        c.that(
            "tone has the right pitch (${cross} crossings, want 441)",
            cross >= 440 && cross <= 442
        );

        let sq1 : AudioClip = Synth::tone(SynthWave::Noise, 100.0, 0.1, env, 8000, 5);
        let sq2 : AudioClip = Synth::tone(SynthWave::Noise, 100.0, 0.1, env, 8000, 5);
        let sq3 : AudioClip = Synth::tone(SynthWave::Noise, 100.0, 0.1, env, 8000, 6);
        c.that(
            "a seeded noise clip is repeatable",
            sq1.samples[300] == sq2.samples[300] && sq1.samples[700] == sq2.samples[700]
        );
        c.that("another seed gives another clip", sq1.samples[300] != sq3.samples[300]);

        let bell : AudioClip = Synth::bell(440.0, 1.0, 22050);
        c.near("bell peak is normalised to 0.8", bell.peak() as f64, 0.8, AUD_TOL_PEAK);
        c.near("the bell starts silent", bell.samples[0] as f64, 0.0, AUD_TOL);
        let head : AudioClip = bell.slice(0, 4410);
        let tail : AudioClip = bell.slice(17640, 4410);
        c.that(
            "bell rings out: the tail is much quieter than the head",
            tail.peak() < head.peak() * 0.15
        );

        let burst : AudioClip = Synth::noiseBurst(0.5, 2000.0, 22050, 4);
        c.near("the noise burst peaks at 0.8", burst.peak() as f64, 0.8, AUD_TOL_PEAK);
        c.that(
            "noise burst decays",
            burst.slice(9000, 2000).peak() < burst.slice(0, 2000).peak() * 0.3
        );

        // A pad loops without a click: the step from the last frame to the first is no bigger than a step inside.
        let pad : AudioClip = Synth::pad(110.0, 2.0, 22050);
        c.near("the pad peaks at 0.5", pad.peak() as f64, 0.5, AUD_TOL_PEAK);
        let mut biggest : f64 = 0.0;
        for (i of 1..pad.frames) {
            let d : f64 = (pad.samples[i as i64] - pad.samples[(i - 1) as i64]) as f64;
            let a : f64 = d * d;
            if (a > biggest) {
                biggest = a;
            }
        }
        let wrap : f64 = (pad.samples[0] - pad.samples[(pad.frames - 1) as i64]) as f64;
        let wrapStep : f64 = wrap * wrap;
        c.that(
            "pad wraps seamlessly (wrap step^2 ${wrapStep} <= max step^2 ${biggest})",
            wrapStep <= biggest
        );

        let dest : AudioClip = new AudioClip(8000, 1, 100);
        let src : AudioClip = Synth::tone(SynthWave::Square, 100.0, 0.0125, env, 8000, 1);
        Synth::mixInto(dest, src, 50, 0.5);
        c.near("mixInto leaves earlier frames alone", dest.samples[10] as f64, 0.0, 0.0);
        c.near("mixInto adds at the offset", dest.samples[50] as f64, 0.5, AUD_TOL);
        c.near(
            "and the last frame holds source frame 49 (a falling half of the square)",
            dest.samples[99] as f64,
            -0.5,
            AUD_TOL
        );

        let verb : AudioClip = Synth::withReverb(t.slice(0, 2000), 0.8, 0.3, 0.5, 0.5);
        c.sameInt("reverb lengthens by the tail", verb.frames, 2000 + 22050);
        c.that("the tail rings after the input stopped", verb.slice(2500, 2000).peak() > 0.0001);
    }

    static fn offline(c : Checks) : void {
        let e : AudioEngine = new AudioEngine(22050, 4);
        let id : i32 = e.addClip(Synth::bell(660.0, 0.5, 22050));
        e.play(AudioPlay::forClip(id));
        let clip : AudioClip = e.renderClip(11025);
        let path : string = ".ludax-audio-test.wav";
        c.that(
            "saving a clip reports success with an empty error",
            AudioOffline::save(path, clip, false) == ""
        );
        let want : WavFile = WavCodec::encode16(clip);
        let got : i8[] = new i8[(want.size + 1) as i64];
        let mut same : bool = false;
        try {
            let input = new FileInputStream(path);
            let n : i64 = input.readBytes(got, 0, want.size as i64);
            input.close();
            same = n == want.size as i64;
            for (i of 0..want.size) {
                if (got[i as i64] != want.bytes[i as i64]) {
                    same = false;
                }
            }
        } catch e2 : IOException {
            same = false;
        }
        c.that("the file holds exactly the encoded render", same);
        c.that(
            "and decodes to a stereo clip",
            WavCodec::decode(got, want.size).isOk()
                && WavCodec::decode(got, want.size).clip().channels == 2
        );
        try {
            Path::from(path).delete();
        } catch e3 : IOException {
            same = false;
        }
        c.that(
            "an unwritable path is reported, not fatal",
            AudioOffline::save("no-such-dir/x/y.wav", clip, false) != ""
        );
    }

    /** Runs every synth check. */
    pub static fn run(c : Checks) : void {
        AudioSynthSuite::waves(c);
        AudioSynthSuite::envelope(c);
        AudioSynthSuite::filters(c);
        AudioSynthSuite::effects(c);
        AudioSynthSuite::clips(c);
        AudioSynthSuite::offline(c);
    }
}

// generic_support — byte-buffer builders shared by the suites of the generic core and data modules.
//
// The suites of `NameTable`, `PackedCells`, `PalettedPool`, `NbtReader`, `Lz4`, `FastInflater`, `RegionFile`
// and `ZipReader` need the same few inputs: bytes that compress well, bytes that do not, a raw deflate or
// gzip stream built from our own `Deflater`, and a comparison of two buffers. They are here once, with a `gs`
// prefix because top-level names are global to the package.

use ludax::{ByteBuf, Deflater, Pcg32};

/** Compressible bytes: runs and a short repeating pattern, `n` of them, the same for the same `seed`. */
pub fn gsPatterned(n : i32, seed : i32) : ByteBuf {
    let out : ByteBuf = new ByteBuf(n + 16);
    for (i of 0..n) {
        out.push(((i / 7) % 13) + seed + ((i / 1000) & 3));
    }
    return out;
}

/**
 * Text-like bytes: words of a 200-word vocabulary picked at random, so matches are short and literals
 * frequent.
 */
pub fn gsText(n : i32, seed : i32) : ByteBuf {
    let r : Pcg32 = new Pcg32(seed as u64, 5);
    let words : ByteBuf = new ByteBuf(2048);
    let mut starts : i32[] = new i32[201];
    for (w of 0..200) {
        starts[w] = words.len();
        let length : i32 = 3 + (r.nextBelow(8) as i32);
        for (k of 0..length) {
            words.push(97 + (r.nextBelow(26) as i32));
        }
    }
    starts[200] = words.len();
    let out : ByteBuf = new ByteBuf(n + 16);
    while (out.len() < n) {
        let w : i32 = r.nextBelow(200) as i32;
        out.pushRange(words, starts[w], starts[w + 1]);
        out.push(32);
    }
    out.truncate(n);
    return out;
}

/** Bytes a compressor cannot shrink: `n` draws of a seeded generator. */
pub fn gsNoise(n : i32, seed : i32) : ByteBuf {
    let r : Pcg32 = new Pcg32(seed as u64, 3);
    let out : ByteBuf = new ByteBuf(n + 16);
    for (i of 0..n) {
        out.push(r.nextBelow(256) as i32);
    }
    return out;
}

/** True when two buffers hold the same bytes. */
pub fn gsSame(a : ByteBuf, b : ByteBuf) : bool {
    if (a.len() != b.len()) {
        return false;
    }
    for (i of 0..a.len()) {
        if (a.get(i) != b.get(i)) {
            return false;
        }
    }
    return true;
}

/** A buffer of the given bytes. */
pub fn gsBytes(values : i32[], count : i32) : ByteBuf {
    let out : ByteBuf = new ByteBuf(count + 16);
    for (i of 0..count) {
        out.push(values[i]);
    }
    return out;
}

/** The raw deflate stream of `src`: our zlib stream without its 2-byte header and 4-byte Adler trailer. */
pub fn gsRawDeflate(src : ByteBuf) : ByteBuf {
    let z : ByteBuf = new Deflater().zlib(src, 0, src.len());
    let out : ByteBuf = new ByteBuf(z.len());
    out.pushRange(z, 2, z.len() - 4);
    return out;
}

/**
 * A gzip member holding `src` (no name or comment; the CRC field is zero because no reader here checks it).
 */
pub fn gsGzip(src : ByteBuf) : ByteBuf {
    let body : ByteBuf = gsRawDeflate(src);
    let out : ByteBuf = new ByteBuf(body.len() + 32);
    out.push(31);
    out.push(139);
    out.push(8);
    out.push(0);
    out.pushLe32(0);
    out.push(0);
    out.push(255);
    out.pushRange(body, 0, body.len());
    out.pushLe32(0);
    out.pushLe32(src.len());
    return out;
}

/** `count` bytes of `src` from the start: a truncated copy. */
pub fn gsPrefix(src : ByteBuf, count : i32) : ByteBuf {
    let out : ByteBuf = new ByteBuf(count + 16);
    out.pushRange(src, 0, count);
    return out;
}

fn gsNibble(ch : i32) : i32 {
    if (ch >= 97) {
        return ch - 87;
    }
    return ch - 48;
}

/** A buffer from lowercase hexadecimal text. */
pub fn gsHex(text : string) : ByteBuf {
    let out : ByteBuf = new ByteBuf(text.byteLength / 2 + 16);
    let mut i : i32 = 0;
    while (i + 1 < text.byteLength) {
        out.push(gsNibble(text.charAt(i) as i32) * 16 + gsNibble(text.charAt(i + 1) as i32));
        i = i + 2;
    }
    return out;
}

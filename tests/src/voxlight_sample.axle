// voxlight_sample — the read seam: corner and point sampling, and the ambient-occlusion rule.
//
// A corner is the mean of the cells in front of it and must not take light through a crease; a point is the
// trilinear blend of the cells around it with solids left out. Both are checked directly and then along a walk,
// where the blend must never jump — a single direct call can hide a discontinuity between neighbouring points.

use ludax::{Checks, VoxCorner, VoxelLightSample, voxAo};

use crate::voxlight_support::{VoxIds, VoxWorldRig};

/** Checks corner, cell and point sampling and the ambient-occlusion rule. */
pub class VoxLightSampleSuite {
    static fn ao(c : Checks) : void {
        c.sameInt("ambient occlusion: an open corner has level 0", voxAo(false, false, false), 0);
        c.sameInt(
            "ambient occlusion: one occluding side gives level 1",
            voxAo(true, false, false),
            1
        );
        c.sameInt(
            "ambient occlusion: the other side alone gives level 1",
            voxAo(false, true, false),
            1
        );
        c.sameInt(
            "ambient occlusion: only the diagonal gives level 1",
            voxAo(false, false, true),
            1
        );
        c.sameInt(
            "ambient occlusion: a side plus the diagonal gives level 2",
            voxAo(true, false, true),
            2
        );
        c.sameInt("both sides close the corner", voxAo(true, true, false), 3);
        c.sameInt("both sides and the diagonal too", voxAo(true, true, true), 3);

        let rig : VoxWorldRig = new VoxWorldRig(0, 1, 1, 1, 1);
        rig.fill(0, 0, 0, 16, 4, 16, VoxIds::stone());
        rig.fill(10, 4, 10, 11, 9, 11, VoxIds::stone());
        // The top face (face 2) of the floor block at (9, 3, 10): corners are (z-/z+) by bit 0, (x-/x+) by bit 1.
        c.sameInt(
            "floor corner away from the wall",
            rig.world.aoCorner(VoxCorner { x: 9, y: 3, z: 10, face: 2, corner: 0 }),
            0
        );
        c.sameInt(
            "floor corner next to the wall (z-)",
            rig.world.aoCorner(VoxCorner { x: 9, y: 3, z: 10, face: 2, corner: 2 }),
            1
        );
        c.sameInt(
            "floor corner next to the wall (z+)",
            rig.world.aoCorner(VoxCorner { x: 9, y: 3, z: 10, face: 2, corner: 3 }),
            1
        );
        rig.fill(9, 4, 11, 10, 5, 12, VoxIds::stone());
        c.sameInt(
            "a second wall makes the crease",
            rig.world.aoCorner(VoxCorner { x: 9, y: 3, z: 10, face: 2, corner: 3 }),
            3
        );
        c.sameInt(
            "a corner on the far side is untouched",
            rig.world.aoCorner(VoxCorner { x: 9, y: 3, z: 10, face: 2, corner: 0 }),
            0
        );
        rig.world.close();
    }

    static fn near(c : Checks, name : string, got : f32, want : f32) : void {
        c.near(name, got as f64, want as f64, 0.00001);
    }

    static fn corners(c : Checks) : void {
        let rig : VoxWorldRig = new VoxWorldRig(0, 1, 1, 1, 1);
        rig.fill(0, 0, 0, 16, 8, 16, VoxIds::stone());
        rig.fill(4, 10, 4, 5, 11, 5, VoxIds::glow());
        rig.world.rebuildLight();
        let w = rig.world;
        // The top face of the block (5, 7, 5), corner 0: the four cells (5,8,5) (5,8,4) (4,8,5) (4,8,4).
        let mut sum : f32 = 0.0;
        sum = sum + w.cellSample(5, 8, 5).blockLight.x;
        sum = sum + w.cellSample(5, 8, 4).blockLight.x;
        sum = sum + w.cellSample(4, 8, 5).blockLight.x;
        sum = sum + w.cellSample(4, 8, 4).blockLight.x;
        VoxLightSampleSuite::near(
            c,
            "corner is the mean of the four cells in front",
            w.cornerSample(VoxCorner { x: 5, y: 7, z: 5, face: 2, corner: 0 }).blockLight.x,
            sum / (4.0 as f32)
        );
        c.that(
            "the sampled corner light is above zero, so the mean was compared on a lit scene",
            sum > (0.1 as f32)
        );

        // A crease: the diagonal cell is lit by a lamp but both cells beside it are solid. It must not leak in.
        let leak : VoxWorldRig = new VoxWorldRig(0, 1, 1, 1, 1);
        leak.fill(0, 0, 0, 16, 4, 16, VoxIds::stone());
        leak.fill(10, 4, 10, 11, 5, 11, VoxIds::stone());
        leak.fill(9, 4, 11, 10, 5, 12, VoxIds::stone());
        leak.fill(10, 4, 11, 11, 5, 12, VoxIds::glow());
        leak.world.rebuildLight();
        let front : VoxelLightSample = leak.world.cellSample(9, 4, 10);
        let corner : VoxelLightSample = leak.world.cornerSample(VoxCorner {
            x: 9,
            y: 3,
            z: 10,
            face: 2,
            corner: 3,
        });
        c.that(
            "the lamp in the diagonal cell does light its own cell",
            leak.world.cellSample(10, 4, 11).blockLight.x > (0.9 as f32)
        );
        VoxLightSampleSuite::near(
            c,
            "a creased corner takes only the front cell's light",
            corner.blockLight.x,
            front.blockLight.x
        );
        leak.world.close();
        rig.world.close();
    }

    static fn points(c : Checks) : void {
        let rig : VoxWorldRig = new VoxWorldRig(0, 1, 1, 1, 1);
        rig.fill(0, 0, 0, 16, 4, 16, VoxIds::stone());
        rig.fill(8, 6, 8, 9, 7, 9, VoxIds::glow());
        rig.world.rebuildLight();
        rig.world.bakeAll(false);
        let w = rig.world;
        let a : VoxelLightSample = w.cellSample(5, 6, 8);
        let b : VoxelLightSample = w.cellSample(6, 6, 8);
        VoxLightSampleSuite::near(
            c,
            "a point at a cell's centre is that cell",
            w.pointSample(5.5, 6.5, 8.5).blockLight.x,
            a.blockLight.x
        );
        VoxLightSampleSuite::near(
            c,
            "halfway between two cells is their mean",
            w.pointSample(6.0, 6.5, 8.5).blockLight.x,
            (a.blockLight.x + b.blockLight.x) / (2.0 as f32)
        );
        VoxLightSampleSuite::near(
            c,
            "a quarter of the way is the 3:1 blend",
            w.pointSample(5.75, 6.5, 8.5).blockLight.x,
            a.blockLight.x * (0.75 as f32) + b.blockLight.x * (0.25 as f32)
        );
        // Beside the floor: a point half a cell above the floor's top face blends with solid cells below, which
        // are left out, so it reads as the air cells alone.
        let air : VoxelLightSample = w.cellSample(5, 4, 5);
        VoxLightSampleSuite::near(
            c,
            "solid neighbours do not darken a point",
            w.pointSample(5.5, 4.0, 5.5).blockLight.x,
            air.blockLight.x
        );
        VoxLightSampleSuite::near(
            c,
            "nor the sky term",
            w.pointSample(5.5, 4.0, 5.5).skyLight,
            air.skyLight
        );
        let inside : VoxelLightSample = w.pointSample(5.5, 1.5, 5.5);
        c.that(
            "inside solid it reads dark",
            inside.blockLight.x == (0.0 as f32) && inside.sunVisibility == (0.0 as f32)
        );
        let nowhere : VoxelLightSample = w.cellSample(1000, 5, 5);
        c.that(
            "a chunk that does not exist reads as open air",
            nowhere.skyAccess == (1.0 as f32) && nowhere.blockLight.x == (0.0 as f32)
        );
        // Smooth: a walk across a row never jumps.
        let mut worst : f32 = 0.0;
        let mut last : f32 = w.pointSample(1.0, 6.5, 8.5).blockLight.x;
        for (i of 1..140) {
            let x : f64 = 1.0 + i as f64 * 0.1;
            let v : f32 = w.pointSample(x, 6.5, 8.5).blockLight.x;
            let mut d : f32 = v - last;
            if (d < (0.0 as f32)) {
                d = (0.0 as f32) - d;
            }
            if (d > worst) {
                worst = d;
            }
            last = v;
        }
        c.that(
            "light along a line moves by less than 0.1 per tenth of a cell (worst ${worst})",
            worst < (0.1 as f32)
        );
        rig.world.close();
    }

    /** Runs every check. */
    pub static fn run(c : Checks) : void {
        VoxLightSampleSuite::ao(c);
        VoxLightSampleSuite::corners(c);
        VoxLightSampleSuite::points(c);
    }
}

// regress_temporal — golden fingerprints of the time-domain stages: the eight-lane helpers, the Halton jitter, the
// YCoCg moments and their clip, and the upscaler run over frames of a moving synthetic picture.
//
// The upscaler sees a picture that slides under a panning camera, with a band that was hidden the frame before
// (no previous distance), a patch whose surface jumped in depth (its history refused), and water pixels with a short
// cap; at a whole and at a fractional output scale. The output of every frame is folded.

use ludax::{Checks, LUX_CLIP_GAMMA, LUX_MOTION_STRIDE, LuxMoments, LuxUpscale, Pcg32, Vec3};
use ludax::{
    luxClamp8, luxExp2Neg8, luxExpNeg8, luxFromYCoCg, luxHaltonX, luxHaltonY, luxMax8, luxMin8,
    luxMix8
};
use ludax::{luxSplat, luxToYCoCg, sin};

use crate::regress_support::RegressHash;

const RGT_EXP : i64 = -5313952557861280212;
const RGT_EXP2 : i64 = -124686978540823705;
const RGT_LANES : i64 = -2202830829248616393;
const RGT_EXP_AT : i64 = 1056850030;
const RGT_HALTON : i64 = -127319032365713412;
const RGT_HALTON_AT : i64 = 1049508068;
const RGT_YCOCG : i64 = -3366113913944681682;
const RGT_CLIP : i64 = 2295016500707227715;
// The upscaler pins cover the edge: a history whose place is on the picture's last row or column, or a hair off the
// first, is read with its edge repeated instead of being refused (`lux_steady` checks the ripple of the outer ring).
const RGT_UPSCALE_3 : i64 = 8467064288469139169;
const RGT_UPSCALE_FRACTION : i64 = 4694007867324997422;
const RGT_UPSCALE_AT : i64 = 1020787502;

/** Golden fingerprints of `render/lux/simd` and `render/lux/temporal`. */
pub class RegressTemporalSuite {
    /** Runs every check of the suite. */
    pub static fn run(mut c : Checks) : void {
        rgtSimd(c);
        rgtJitter(c);
        rgtClip(c);
        rgtUpscale(c);
    }
}

// e^-x and 2^-y in lanes over the whole range a transmittance takes and past it; min, max, mix and clamp.
fn rgtSimd(mut c : Checks) : void {
    let mut input : f32[] = new f32[8];
    let out : f32[] = new f32[8];
    let exp : RegressHash = new RegressHash();
    for (k of 0..1500) {
        for (j of 0..8) {
            input[j] = -((k * 8 + j) as f32) * (0.0091 as f32) + (0.5 as f32);
        }
        luxExpNeg8(f32x8.load(input, 0)).store(out, 0);
        exp.reals(out, 8);
    }
    c.sameInt("regress simd: luxExpNeg8 from 0.5 down to -109 [RGT_EXP]", exp.value(), RGT_EXP);

    let exp2 : RegressHash = new RegressHash();
    for (k of 0..1000) {
        for (j of 0..8) {
            input[j] = -((k * 8 + j) as f32) * (0.0213 as f32) + (1.0 as f32);
        }
        luxExp2Neg8(f32x8.load(input, 0)).store(out, 0);
        exp2.reals(out, 8);
    }
    c.sameInt("regress simd: luxExp2Neg8 from 1 down to -169 [RGT_EXP2]", exp2.value(), RGT_EXP2);

    let lanes : RegressHash = new RegressHash();
    let mut other : f32[] = new f32[8];
    let mut third : f32[] = new f32[8];
    let rng : Pcg32 = new Pcg32(3, 3);
    let lo : f32 = -0.5;
    let hi : f32 = 1.5;
    for (k of 0..500) {
        for (j of 0..8) {
            input[j] = rng.rangeF32(-3.0, 3.0);
            other[j] = rng.rangeF32(-3.0, 3.0);
            third[j] = rng.nextF32();
        }
        let a : f32x8 = f32x8.load(input, 0);
        let b : f32x8 = f32x8.load(other, 0);
        luxMin8(a, b).store(out, 0);
        lanes.reals(out, 8);
        luxMax8(a, b).store(out, 0);
        lanes.reals(out, 8);
        luxMix8(a, b, f32x8.load(third, 0)).store(out, 0);
        lanes.reals(out, 8);
        luxClamp8(a, luxSplat(lo), luxSplat(hi)).store(out, 0);
        lanes.reals(out, 8);
    }
    c.sameInt(
        "regress simd: luxMin8, luxMax8, luxMix8, luxClamp8 [RGT_LANES]",
        lanes.value(),
        RGT_LANES
    );

    let tau : f32 = 0.7;
    luxExpNeg8(luxSplat(-tau)).store(out, 0);
    c.sameInt(
        "regress simd: luxExpNeg8(-0.7) bits [RGT_EXP_AT]",
        RegressHash::bits(out[0]),
        RGT_EXP_AT
    );
}

fn rgtJitter(mut c : Checks) : void {
    let h : RegressHash = new RegressHash();
    for (n of 0..512) {
        h.real(luxHaltonX(n));
        h.real(luxHaltonY(n));
    }
    c.sameInt(
        "regress temporal: luxHaltonX and luxHaltonY, 512 points [RGT_HALTON]",
        h.value(),
        RGT_HALTON
    );
    c.sameInt(
        "regress temporal: luxHaltonY(4) bits [RGT_HALTON_AT]",
        RegressHash::bits(luxHaltonY(4)),
        RGT_HALTON_AT
    );
}

fn rgtColour(mut rng : Pcg32, scale : f32) : Vec3 {
    return Vec3::make(rng.nextF32() * scale, rng.nextF32() * scale, rng.nextF32() * scale);
}

// YCoCg both ways, and 600 neighbourhoods of 1 to 9 samples clipping a history at two widths.
fn rgtClip(mut c : Checks) : void {
    let rng : Pcg32 = new Pcg32(1999, 5);
    let ycocg : RegressHash = new RegressHash();
    for (k of 0..500) {
        let rgb : Vec3 = rgtColour(rng, 4.0);
        let y : Vec3 = luxToYCoCg(rgb);
        ycocg.vec(y);
        ycocg.vec(luxFromYCoCg(y));
    }
    c.sameInt(
        "regress temporal: luxToYCoCg and luxFromYCoCg [RGT_YCOCG]",
        ycocg.value(),
        RGT_YCOCG
    );

    let clip : RegressHash = new RegressHash();
    let narrow : f32 = 0.75;
    for (k of 0..600) {
        let mut m : LuxMoments = LuxMoments {};
        let base : Vec3 = rgtColour(rng, 2.0);
        for (s of 0..(k % 9 + 1)) {
            m = m.plus(base.plus(rgtColour(rng, 0.3)));
        }
        let history : Vec3 = k % 5 == 0 ? base : rgtColour(rng, 5.0);
        clip.vec(m.sum);
        clip.vec(m.squares);
        clip.real(m.count);
        clip.vec(m.clip(history, LUX_CLIP_GAMMA));
        clip.vec(m.clip(history, narrow));
    }
    c.sameInt("regress temporal: LuxMoments.plus and clip [RGT_CLIP]", clip.value(), RGT_CLIP);
}

// The synthetic radiance at computed pixel (i, j) of frame `frame`: stripes and a ramp sliding with the pan.
fn rgtPicture(mut low : f32[], w : i32, h : i32, frame : i32, jx : f32, jy : f32) : void {
    for (j of 0..h) {
        for (i of 0..w) {
            let x : f32 = (i as f32) + (0.5 as f32) + jx + (frame as f32) * (0.6 as f32);
            let y : f32 = (j as f32) + (0.5 as f32) + jy;
            let at : i64 = ((j * w + i) * 3) as i64;
            low[at] = (0.5 as f32) + (0.5 as f32) * sin(x * (0.9 as f32));
            low[at + 1] = y / (h as f32) * (2.0 as f32);
            low[at + 2] = (i + j) % 7 == 0 ? 6.0 as f32 : 0.2 as f32;
        }
    }
}

// The motion of a camera panning 0.6 computed pixels a frame: a hidden band, a jump in depth, water with a short cap.
fn rgtMotion(mut motion : f32[], w : i32, h : i32, frame : i32, jx : f32, jy : f32) : void {
    for (j of 0..h) {
        for (i of 0..w) {
            let m : i64 = ((j * w + i) as i64) * (LUX_MOTION_STRIDE as i64);
            motion[m] = ((i as f32) + (0.5 as f32) + jx + (0.6 as f32)) / (w as f32);
            motion[m + 1] = ((j as f32) + (0.5 as f32) + jy) / (h as f32);
            let mut was : f32 = (10.0 as f32) + (j as f32) * (0.25 as f32);
            let mut now : f32 = was;
            if (i >= w - 3) {
                was = -1.0;
            }
            if (frame % 4 == 2 && i >= 8 && i < 14 && j >= 4 && j < 9) {
                now = 3.0;
            }
            motion[m + 2] = was;
            motion[m + 3] = now;
            motion[m + 4] = j >= h - 4 ? 4.0 as f32 : 48.0 as f32;
        }
    }
}

// Twelve frames through an upscaler to `ow` by `oh`, each frame's output folded.
fn rgtUpscaleRun(w : i32, h : i32, ow : i32, oh : i32) : RegressHash {
    let up : LuxUpscale = new LuxUpscale();
    up.fit(ow, oh);
    let low : f32[] = new f32[(w * h * 3) as i64];
    let motion : f32[] = new f32[((w * h) as i64) * (LUX_MOTION_STRIDE as i64)];
    let fold : RegressHash = new RegressHash();
    for (frame of 0..12) {
        let jx : f32 = luxHaltonX(frame % 8);
        let jy : f32 = luxHaltonY(frame % 8);
        rgtPicture(low, w, h, frame, jx, jy);
        rgtMotion(motion, w, h, frame, jx, jy);
        up.rows(low, motion, w, h, jx, jy, 0, oh);
        fold.reals(up.output(), (ow * oh * 3) as i64);
        up.swap();
    }
    return fold;
}

fn rgtUpscale(mut c : Checks) : void {
    let three : RegressHash = rgtUpscaleRun(32, 16, 96, 48);
    c.sameInt(
        "regress temporal: LuxUpscale 32 x 16 to 96 x 48 over 12 moving frames [RGT_UPSCALE_3]",
        three.value(),
        RGT_UPSCALE_3
    );
    let fraction : RegressHash = rgtUpscaleRun(32, 16, 80, 40);
    c.sameInt(
        "regress temporal: LuxUpscale 32 x 16 to 80 x 40 over 12 moving frames [RGT_UPSCALE_FRACTION]",
        fraction.value(),
        RGT_UPSCALE_FRACTION
    );

    let up : LuxUpscale = new LuxUpscale();
    up.fit(64, 32);
    let low : f32[] = new f32[32 * 16 * 3];
    let motion : f32[] = new f32[32 * 16 * (LUX_MOTION_STRIDE as i64)];
    rgtPicture(low, 32, 16, 0, 0.0, 0.0);
    rgtMotion(motion, 32, 16, 0, 0.0, 0.0);
    up.rows(low, motion, 32, 16, 0.0, 0.0, 0, 32);
    c.sameInt(
        "regress temporal: the first frame's red at output (10, 5) bits [RGT_UPSCALE_AT]",
        RegressHash::bits(up.output()[(5 * 64 + 10) * 3]),
        RGT_UPSCALE_AT
    );
}

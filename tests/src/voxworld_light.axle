// voxworld_light — the light bridge and block interaction: edits flow through the journal into the flood.
//
// The claim to check is the one the light library makes about itself, now across the bridge: the light after a
// series of edits, fed through the journal, equals the light of a window built from scratch on the edited world,
// cell for cell and channel for channel, and so does the baked sun and sky term. The edits are made the way a
// game makes them: by casting a ray at the ground and breaking or placing against what it hit.

use ludax::{
    Checks, VoxWorld, VoxStreamer, VoxLightBridge, VoxInteract, VoxHit, VoxelLightSample, VoxelGrid,
    VoxLightWorld, VW_STONE, VW_LAMP, VW_AIR
};

/** Checks the light bridge and block interaction across a streamed window. */
pub class VoxWorldLightSuite {
    // Counts the cells of the window of `a` whose block light or sky light differs from `b`'s; -1 when the windows differ in shape.
    static fn flooded(a : VoxLightBridge, b : VoxLightBridge, cx : i32, cz : i32, r : i32) : i32 {
        let la : VoxLightWorld = a.light();
        let lb : VoxLightWorld = b.light();
        let mut bad : i32 = 0;
        let mut seen : i32 = 0;
        for (z of ((cz - r) * 16)..((cz + r + 1) * 16)) {
            for (y of 0..128) {
                for (x of ((cx - r) * 16)..((cx + r + 1) * 16)) {
                    let ia : i32 = la.grid.cellId(x, y, z);
                    let ib : i32 = lb.grid.cellId(x, y, z);
                    if (ia < 0 || ib < 0) {
                        return -1;
                    }
                    seen = seen + 1;
                    let mut same : bool = la.grid.blockOfId(ia) == lb.grid.blockOfId(ib)
                        && la.flood.skyLevel(ia) == lb.flood.skyLevel(ib);
                    for (ch of 0..3) {
                        if (la.flood.blockLevel(ia, ch) != lb.flood.blockLevel(ib, ch)) {
                            same = false;
                        }
                    }
                    if (!same) {
                        bad = bad + 1;
                    }
                }
            }
        }
        if (seen == 0) {
            return -1;
        }
        return bad;
    }

    static fn baked(a : VoxLightBridge, b : VoxLightBridge, x0 : i32, z0 : i32) : i32 {
        let mut bad : i32 = 0;
        for (dz of -6..7) {
            for (dx of -6..7) {
                for (y of 30..110) {
                    let sa : VoxelLightSample = a.sample(x0 + dx, y, z0 + dz);
                    let sb : VoxelLightSample = b.sample(x0 + dx, y, z0 + dz);
                    if (sa.sunVisibility != sb.sunVisibility || sa.skyAccess != sb.skyAccess
                        || sa.skyLight != sb.skyLight
                        || sa.blockLight.x != sb.blockLight.x
                        || sa.blockLight.y != sb.blockLight.y
                        || sa.blockLight.z != sb.blockLight.z) {
                        bad = bad + 1;
                    }
                }
            }
        }
        return bad;
    }

    /** Runs every check. */
    pub static fn run(c : Checks) : void {
        let w : VoxWorld = new VoxWorld(8, 44, 1);
        let s : VoxStreamer = new VoxStreamer(3, 1);
        s.update(w, 8.0, 8.0, 1000000, 1000000, false);
        let bridge : VoxLightBridge = new VoxLightBridge(1, 24, 1);
        bridge.rebuild(w, 0, 0);
        c.sameInt("the first build counts", bridge.rebuilds(), 1);

        // Open ground is lit by the sky; underground is dark.
        let top : i32 = w.terrain.heightAt(8, 8);
        let aboveGround : VoxelLightSample = bridge.sample(8, top + 3, 8);
        c.that("open air above the ground gets sky light", aboveGround.skyLight > 0.9);
        let deep : VoxelLightSample = bridge.sample(8, 3, 8);
        c.that("rock far below gets none", deep.skyLight < 0.01 && deep.blockLight.x < 0.01);

        // Edits made the way a game makes them.
        let touch : VoxInteract = new VoxInteract();
        let down : VoxHit = touch.cast(w, 6.5, 127.5, 6.5, 0.0, -1.0, 0.0, 200.0);
        c.that("a ray cast straight down finds the ground", down.hit);
        c.that(
            "it hits at or above the ground height (trees may stand there)",
            down.y >= w.terrain.heightAt(6, 6)
        );
        c.sameInt("it entered through the top face", down.face, 2);
        c.sameInt("placement goes in the cell above", down.frontY, down.y + 1);
        let before : i32 = w.journal.end();
        c.that("a lamp is placed on the ground", touch.placeBlock(w, down, VW_LAMP));
        c.sameInt(
            "the lamp is in the world",
            w.blockAt(down.frontX, down.frontY, down.frontZ),
            VW_LAMP
        );
        let again : VoxHit = touch.cast(w, 6.5, 127.5, 6.5, 0.0, -1.0, 0.0, 200.0);
        c.sameInt("the next ray hits the lamp", again.block, VW_LAMP);
        let beside : VoxHit = touch.cast(w, 10.5, 127.5, 12.5, 0.0, -1.0, 0.0, 200.0);
        c.that("ground beside is hit", beside.hit);
        c.that("a block is broken", touch.breakBlock(w, beside));
        c.sameInt("it is air afterwards", w.blockAt(beside.x, beside.y, beside.z), VW_AIR);
        let roofed : VoxHit = touch.cast(w, 3.5, 127.5, 3.5, 0.0, -1.0, 0.0, 200.0);
        touch.placeBlock(w, roofed, VW_STONE);
        touch.placeBlock(w, touch.cast(w, 3.5, 127.5, 3.5, 0.0, -1.0, 0.0, 200.0), VW_STONE);
        let made : i32 = w.journal.end() - before;
        c.that("every edit is in the journal", made >= 4);
        let miss : VoxHit = touch.cast(w, 0.5, 127.5, 0.5, 0.0, 1.0, 0.0, 50.0);
        c.that("a ray into the sky misses", !miss.hit);

        let applied : i32 = bridge.sync(w);
        c.sameInt("every edit was fed to the incremental flood", applied, made);
        c.sameInt("without rebuilding the window", bridge.rebuilds(), 1);
        let glow : VoxelLightSample = bridge.sample(down.frontX + 1, down.frontY, down.frontZ);
        c.that("the lamp lights its neighbour", glow.blockLight.x > 0.2);

        // Against a window built from scratch on the edited world.
        let fresh : VoxLightBridge = new VoxLightBridge(1, 24, 1);
        fresh.rebuild(w, 0, 0);
        let diff : i32 = VoxWorldLightSuite::flooded(bridge, fresh, 0, 0, 1);
        c.sameInt("incremental light equals light built from scratch, in every cell", diff, 0);
        bridge.bake(false);
        fresh.bake(false);
        c.sameInt(
            "and so does the baked sun and sky term",
            VoxWorldLightSuite::baked(bridge, fresh, down.x, down.z),
            0
        );

        // An edit outside the window is not the window's business; sliding rebuilds.
        w.setBlock(300, 90, 300, VW_STONE);
        c.sameInt("an edit outside the window is ignored", bridge.sync(w), 0);
        c.that("the focus near the middle does not move the window", !bridge.recentre(w, 0, 0, 0));
        let moved : bool = bridge.recentre(w, 3, 0, 0);
        c.that("a window moves when the focus leaves it", moved);
        c.sameInt("the window is centred on the focus", bridge.centreChunkX(), 3);
        c.that("sliding costs a rebuild", bridge.rebuilds() >= 2);

        // More of the window arriving rebuilds it.
        let w2 : VoxWorld = new VoxWorld(8, 44, 1);
        let s2 : VoxStreamer = new VoxStreamer(1, 0);
        s2.update(w2, 8.0, 8.0, 1000000, 1000000, false);
        let b2 : VoxLightBridge = new VoxLightBridge(2, 24, 1);
        b2.rebuild(w2, 0, 0);
        let n0 : i32 = b2.rebuilds();
        let s3 : VoxStreamer = new VoxStreamer(2, 0);
        s3.update(w2, 8.0, 8.0, 1000000, 1000000, false);
        b2.sync(w2);
        c.sameInt("chunks that arrived later rebuild the window", b2.rebuilds(), n0 + 1);
        b2.close();
        w2.close();

        bridge.close();
        fresh.close();
        w.close();
    }
}

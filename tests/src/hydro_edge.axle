// hydro_edge — checks of the edges of the world: open sides, inflows beside banks, cliffs on coarse grids.
//
// Water that flies out through an open side is counted as outflow and does not heap up at the edge cell; an
// inflow never wets a bank above its own water; a cliff whose drop is spread over two or three cells (a cliff
// resampled onto a grid) still launches a curtain, while a gentle ramp of the same height does not.

use ludax::Checks;
use ludax::HYDRO_SIDE_EAST;
use ludax::HydroLedger;
use ludax::HydroParams;
use ludax::HydroWorld;

/** The checks of the edges. */
pub class HydroEdgeSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        hydroEdgeOpenSide(c);
        hydroEdgeBank(c);
        hydroEdgeCliff(c);
    }
}

/** Columns of the 8 m rows used here. */
const HYDRO_EDGE_WIDTH : i32 = 64;
const HYDRO_EDGE_ROWS : i32 = 8;

// A plateau at `top` metres up to column `from`, then `steps` columns that fall by `each` metres apiece, then
// the plain at 0.
fn hydroEdgeBed(top : f32, from : i32, steps : i32, each : f32) : f32[] {
    let mut bed : f32[] = new f32[(HYDRO_EDGE_WIDTH * HYDRO_EDGE_ROWS) as i64];
    for (z of 0..HYDRO_EDGE_ROWS) {
        for (x of 0..HYDRO_EDGE_WIDTH) {
            let mut h : f32 = 0.0;
            if (x < from) {
                h = top;
            } else if (x < from + steps) {
                h = top - each * ((x - from + 1) as f32);
            }
            bed[(z * HYDRO_EDGE_WIDTH + x) as i64] = h;
        }
    }
    return bed;
}

fn hydroEdgeWorld(bed : f32[], open : bool, inflow : f32) : HydroWorld {
    let mut p : HydroParams = HydroParams::standard();
    p.manning = 0.03;
    let w : HydroWorld = new HydroWorld(HYDRO_EDGE_WIDTH, HYDRO_EDGE_ROWS, 1.0, p);
    w.setBed(bed, HYDRO_EDGE_WIDTH, HYDRO_EDGE_ROWS, 1.0);
    if (open) {
        w.setOutflowBoundary(HYDRO_SIDE_EAST);
    }
    w.addInflow(3.5, 4.0, inflow);
    return w;
}

// A curtain thrown off a cliff next to an open east side: the drops that fly past the edge leave the world
// (booked as outflow, the books close) and none hangs about beyond it.
fn hydroEdgeOpenSide(c : Checks) : void {
    let w : HydroWorld = hydroEdgeWorld(hydroEdgeBed(12.0, 58, 1, 12.0), true, 8.0);
    let mut beyond : i32 = 0;
    for (k of 0..2000) {
        w.step(0.02);
        let pos : f32[] = w.particlePositions();
        for (i of 0..w.particleCount()) {
            if (pos[(i * 3) as i64] > 66.0) {
                beyond = beyond + 1;
            }
        }
    }
    let l : HydroLedger = w.ledger();
    let r : f64 = l.residual();
    println("  measured open side: outflow ${l.outflow} of ${l.inflow} m3, residual ${r}, particles beyond the edge ${beyond}");
    c.that("water leaves through the open side (${l.outflow})", l.outflow > 0.0);
    c.that("books close with an open side (${r})", r < l.inflow * 0.0001 && -r < l.inflow * 0.0001);
    c.that("no particle lingers past the open side (${beyond})", beyond == 0);
    w.close();
}

// A channel between banks: the inflow pours into the channel cells of its block and never onto a bank.
fn hydroEdgeBank(c : Checks) : void {
    let mut bed : f32[] = hydroEdgeBed(0.0, 0, 0, 0.0);
    for (z of 0..HYDRO_EDGE_ROWS) {
        for (x of 0..HYDRO_EDGE_WIDTH) {
            if (z != 4) {
                bed[(z * HYDRO_EDGE_WIDTH + x) as i64] = 5.0;
            }
        }
    }
    let w : HydroWorld = hydroEdgeWorld(bed, true, 2.0);
    for (k of 0..600) {
        w.step(0.1);
    }
    let mut wet : f32 = 0.0;
    for (z of 0..HYDRO_EDGE_ROWS) {
        for (x of 0..HYDRO_EDGE_WIDTH) {
            if (z != 4 && w.depthOfCell(x, z) > wet) {
                wet = w.depthOfCell(x, z);
            }
        }
    }
    let l : HydroLedger = w.ledger();
    let r : f64 = l.residual();
    c.that("an inflow never wets a bank (${wet} m)", wet == 0.0);
    c.that(
        "the channel carries the water on (${w.depthOfCell(30, 4)} m)",
        w.depthOfCell(30, 4) > 0.0
    );
    c.that("bank books close (${r})", r < 0.01 && -r < 0.01);
    w.close();
}

// A cliff of 12 m in one cell, in three cells of 4 m, and a ramp of 12 m over 20 cells: the first two launch a
// curtain, the ramp is a chute.
fn hydroEdgeCliff(c : Checks) : void {
    let lips : i32 = 0;
    let mut peaks : f32[] = new f32[3];
    for (shape of 0..3) {
        let mut bed : f32[] = hydroEdgeBed(12.0, 30, 1, 12.0);
        if (shape == 1) {
            bed = hydroEdgeBed(12.0, 30, 3, 4.0);
        }
        if (shape == 2) {
            bed = hydroEdgeBed(12.0, 20, 20, 0.6);
        }
        let w : HydroWorld = hydroEdgeWorld(bed, true, 8.0);
        let mut peak : i32 = 0;
        for (k of 0..1500) {
            w.step(0.02);
            if (w.particleCount() > peak) {
                peak = w.particleCount();
            }
        }
        peaks[shape as i64] = peak as f32;
        let l : HydroLedger = w.ledger();
        let r : f64 = l.residual();
        println("  measured cliff ${shape}: ${w.lipCount()} lips, ${peak} particles at most, residual ${r}");
        c.that(
            "cliff ${shape}: books close (${r})",
            r < l.inflow * 0.0001 && -r < l.inflow * 0.0001
        );
        if (shape == 2) {
            c.that("a gentle ramp is no lip (${w.lipCount()})", w.lipCount() == 0);
        } else {
            c.that("cliff ${shape} is found (${w.lipCount()} lips)", w.lipCount() > 0);
        }
        w.close();
    }
    c.that("a cliff in one cell throws a curtain (${peaks[0]})", peaks[0] > 500.0);
    c.that("a cliff in three cells throws a curtain too (${peaks[1]})", peaks[1] > 500.0);
    c.that("a ramp throws none (${peaks[2]})", peaks[2] < 1.0);
}

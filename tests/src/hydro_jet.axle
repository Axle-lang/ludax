// hydro_jet — checks of the jets: a vent throws water up, the water lands in the pool and stays.
//
// A vent of exit speed v rises to v^2 / (2 g) above its exit (a little less for air drag), takes the water it
// throws out of the pool it stands in (so the books close with no new term) and gives it back when it lands;
// four times the gravity quarters the height; a pulsed vent is on for its duty share of the time; one worker
// and eight leave the same particles.

use ludax::Checks;
use ludax::HydroLedger;
use ludax::HydroParams;
use ludax::HydroVentParams;
use ludax::HydroWorld;

/** The checks of the jets. */
pub class HydroJetSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        hydroJetHeight(c);
        hydroJetBooks(c);
        hydroJetPulse(c);
        hydroJetThreads(c);
    }
}

/** Exit speed of the default jet, m/s. */
const HYDRO_JET_SPEED : f32 = 15.0;

/** Depth of the pool the jets stand in, m. */
const HYDRO_JET_POOL : f32 = 1.0;

// A pool of 40 x 40 m with a vent in the middle, under `gravity` and `threads`.
fn hydroJetWorld(gravity : f32, threads : i32, external : bool) : HydroWorld {
    let mut p : HydroParams = HydroParams::standard();
    p.gravity = gravity;
    p.threads = threads;
    let w : HydroWorld = new HydroWorld(40, 40, 1.0, p);
    w.fillRect(HYDRO_JET_POOL, 0, 0, 39, 39);
    let mut v : HydroVentParams = HydroVentParams {};
    v.speed = HYDRO_JET_SPEED;
    v.discharge = 0.5;
    v.fromGrid = !external;
    w.addVent(20.0, 20.0, v);
    return w;
}

fn hydroJetTop(w : HydroWorld) : f32 {
    let pos : f32[] = w.particlePositions();
    let mut top : f32 = 0.0;
    for (i of 0..w.particleCount()) {
        let y : f32 = pos[(i * 3 + 1) as i64];
        if (y > top) {
            top = y;
        }
    }
    return top;
}

// The jet reaches v^2 / (2 g) above its exit, at two gravities; its discharge is the stated one.
fn hydroJetHeight(c : Checks) : void {
    let mut tops : f32[] = new f32[2];
    for (pass of 0..2) {
        let mut g : f32 = 9.81;
        if (pass == 1) {
            g = 39.24;
        }
        let w : HydroWorld = hydroJetWorld(g, 1, false);
        let before : f64 = w.volume();
        let mut top : f32 = 0.0;
        let mut taken : f64 = 0.0;
        for (k of 0..400) {
            w.step(0.01);
            if (k == 99) {
                taken = before - w.volume();
            }
        }
        for (k of 0..600) {
            w.step(0.01);
            let t : f32 = hydroJetTop(w);
            if (t > top) {
                top = t;
            }
        }
        tops[pass as i64] = top - HYDRO_JET_POOL - (0.1 as f32);
        if (pass == 0) {
            c.that(
                "the jet draws its discharge from the pool (${taken} m3 in the first second, 0.5 asked)",
                taken > 0.46 && taken < 0.54
            );
        }
        w.close();
    }
    let predicted0 : f32 = HYDRO_JET_SPEED * HYDRO_JET_SPEED / (19.62 as f32);
    let predicted1 : f32 = HYDRO_JET_SPEED * HYDRO_JET_SPEED / (78.48 as f32);
    let ratio : f32 = tops[0] / tops[1];
    println("  measured jet: apex ${tops[0]} m (v^2/2g = ${predicted0}), at 4g ${tops[1]} m (${predicted1}), ratio ${ratio}");
    c.that(
        "the jet rises to v^2/2g within 15% (${tops[0]} vs ${predicted0})",
        tops[0] > 0.85 * predicted0 && tops[0] < 1.05 * predicted0
    );
    c.that(
        "at four times the gravity too (${tops[1]} vs ${predicted1})",
        tops[1] > 0.85 * predicted1 && tops[1] < 1.05 * predicted1
    );
    c.that(
        "four times the gravity quarters the height (ratio ${ratio})",
        ratio > 3.4 && ratio < 4.6
    );
}

// The books close with a pool-fed vent and with an external one; after the vent stops everything lands back.
fn hydroJetBooks(c : Checks) : void {
    for (pass of 0..2) {
        let external : bool = pass == 1;
        let w : HydroWorld = hydroJetWorld(9.81, 1, external);
        let before : f64 = w.volume();
        let mut peak : i32 = 0;
        for (k of 0..1500) {
            w.step(0.01);
            if (w.particleCount() > peak) {
                peak = w.particleCount();
            }
        }
        let l : HydroLedger = w.ledger();
        let r : f64 = l.residual();
        c.that("jet books close, external ${external} (${r})", r < 0.001 && -r < 0.001);
        c.that("the jet is bounded (${peak} particles)", peak < 100000);

        w.setVentPower(0, 0.0);
        for (k of 0..2000) {
            w.step(0.01);
        }
        let after : f64 = w.volume();
        let mut expect : f64 = before;
        if (external) {
            expect = before + w.ledger().inflow;
        }
        println("  measured jet landing, external ${external}: ${peak} particles at most, pool ${before} -> ${after} m3, airborne ${w.airborneVolume()}");
        c.that(
            "the water lands back and stays (${after} of ${expect})",
            after > expect * 0.999 && after < expect * 1.001
        );
        c.that("nothing is left in the air", w.airborneVolume() < 0.001);
        c.that("the pool is still wet where the jet stood", w.depthOfCell(20, 20) > 0.5);
        w.close();
    }
}

// A pulsed vent throws its duty share of the time.
fn hydroJetPulse(c : Checks) : void {
    let p : HydroParams = HydroParams::standard();
    let w : HydroWorld = new HydroWorld(40, 40, 1.0, p);
    w.fillRect(HYDRO_JET_POOL, 0, 0, 39, 39);
    let mut v : HydroVentParams = HydroVentParams {};
    v.discharge = 0.4;
    v.pulsePeriod = 1.0;
    v.pulseDuty = 0.25;
    v.fromGrid = false;
    w.addVent(20.0, 20.0, v);
    for (k of 0..1000) {
        w.step(0.01);
    }
    let thrown : f64 = w.ledger().inflow;
    println("  measured pulsed jet: ${thrown} m3 in 10 s at 0.4 m3/s and a quarter duty (expect 1.0)");
    c.that("a pulsed vent throws its duty share (${thrown})", thrown > 0.9 && thrown < 1.1);
    w.close();
}

// One worker and eight give the same particles, bit for bit, with a tilted pulsed jet.
fn hydroJetThreads(c : Checks) : void {
    let a : HydroWorld = hydroJetWorld(9.81, 1, false);
    let b : HydroWorld = hydroJetWorld(9.81, 8, false);
    let mut t : HydroVentParams = HydroVentParams {};
    t.tilt = 0.5;
    t.azimuth = 1.0;
    t.pulsePeriod = 0.7;
    t.discharge = 0.3;
    a.addVent(10.0, 10.0, t);
    b.addVent(10.0, 10.0, t);
    for (k of 0..500) {
        a.step(0.01);
        b.step(0.01);
    }
    let mut same : bool = a.particleCount() == b.particleCount();
    let pa : f32[] = a.particlePositions();
    let pb : f32[] = b.particlePositions();
    for (i of 0..(a.particleCount() * 3)) {
        if (pa[i as i64] != pb[i as i64]) {
            same = false;
        }
    }
    c.that("jets with 1 and 8 workers are bit-identical (${a.particleCount()} particles)", same);
    a.close();
    b.close();
}

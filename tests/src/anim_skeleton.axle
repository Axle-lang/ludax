// anim_skeleton — bones, bind pose, poses and skinning matrices.
//
// The chain is three bones straight up, so a model-space transform and a skinning matrix are readable as
// geometry: the tip is two units above the root until the middle bone turns, after which it is one unit left.
// The suite checks the two independent routes to that answer — the matrix and the `Transform` — agree, and
// that a stretched root does not disturb the identity a bind pose must produce.

use ludax::{Checks, Vec3, Quat, Mat4, Transform, Skeleton, Pose, HALF_PI};

use crate::math_support::{nearVec3, nearMat4};

/** A chain of three bones going up the Y axis, one unit apart: root, mid, tip. */
pub fn animChainSkeleton() : Skeleton {
    let mut s : Skeleton = new Skeleton(8);
    s.addBone("root", -1, Transform::identity());
    s.addBone("mid", 0, Transform::fromTranslation(Vec3::make(0.0, 1.0, 0.0)));
    s.addBone("tip", 1, Transform::fromTranslation(Vec3::make(0.0, 1.0, 0.0)));
    return s;
}

fn animSkeletonTestBones(c : Checks) : void {
    let mut s : Skeleton = animChainSkeleton();
    c.sameInt("three bones", s.boneCount() as i64, 3);
    c.sameInt("the parent of mid", s.parent(1) as i64, 0);
    c.sameInt("a root has no parent", s.parent(0) as i64, -1);
    c.that("bone names read back", s.name(2) == "tip");
    c.sameInt("find by name", s.find("mid") as i64, 1);
    c.sameInt("an unknown name is -1", s.find("elbow") as i64, -1);
    c.sameInt(
        "a bone cannot have a later bone as parent",
        s.addBone("late", 7, Transform::identity()) as i64,
        -1
    );
    c.sameInt("a bone name is unique", s.addBone("mid", 0, Transform::identity()) as i64, -1);
    c.sameInt("rejected bones are not added", s.boneCount() as i64, 3);
    c.that("the subtree test", s.isInSubtree(2, 0) && s.isInSubtree(2, 1) && !s.isInSubtree(1, 2));
    let mut tiny : Skeleton = new Skeleton(1);
    c.sameInt("the first bone fits", tiny.addBone("a", -1, Transform::identity()) as i64, 0);
    c.sameInt(
        "a full skeleton refuses more",
        tiny.addBone("b", 0, Transform::identity()) as i64,
        -1
    );
}

fn animSkeletonTestBind(c : Checks) : void {
    let s : Skeleton = animChainSkeleton();
    let mut pose : Pose = Pose::bindOf(s);
    pose.update(s);
    nearVec3(
        c,
        "tip in the bind pose is two units up",
        pose.modelMatrix(2).translationPart(),
        Vec3::make(0.0, 2.0, 0.0),
        0.00001
    );
    nearMat4(
        c,
        "inverse bind of the tip undoes its bind placement",
        s.inverseBindOf(2).mul(s.bindModelOf(2)),
        Mat4::identity(),
        0.00001
    );
    nearMat4(
        c,
        "the skinning matrix of the bind pose is the identity (root)",
        pose.skinMatrix(0),
        Mat4::identity(),
        0.00001
    );
    nearMat4(
        c,
        "the skinning matrix of the bind pose is the identity (mid)",
        pose.skinMatrix(1),
        Mat4::identity(),
        0.00001
    );
    nearMat4(
        c,
        "the skinning matrix of the bind pose is the identity (tip)",
        pose.skinMatrix(2),
        Mat4::identity(),
        0.00001
    );
}

fn animSkeletonTestPose(c : Checks) : void {
    let s : Skeleton = animChainSkeleton();
    let mut pose : Pose = Pose::bindOf(s);
    // Quarter turn of the mid bone about Z: the tip, one unit above it, swings to the left, to (-1, 1, 0).
    pose.setRotation(1, Quat::fromAxisAngle(Vec3::unitZ(), HALF_PI));
    pose.update(s);
    nearVec3(
        c,
        "the tip swings with its parent",
        pose.modelMatrix(2).translationPart(),
        Vec3::make(-1.0, 1.0, 0.0),
        0.00001
    );
    nearVec3(
        c,
        "the Transform route agrees",
        pose.modelTransform(s, 2).translation,
        Vec3::make(-1.0, 1.0, 0.0),
        0.00001
    );
    nearVec3(
        c,
        "the root does not move",
        pose.modelMatrix(0).translationPart(),
        Vec3::zero(),
        0.00001
    );
    // The skinning matrix carries a bind-pose point of the tip bone (0, 2, 0) to where the tip is now.
    nearVec3(
        c,
        "skinning matrix of the tip moves its bind position",
        pose.skinMatrix(2).transformPoint(Vec3::make(0.0, 2.0, 0.0)),
        Vec3::make(-1.0, 1.0, 0.0),
        0.00001
    );
    nearVec3(
        c,
        "a point on the root is untouched",
        pose.skinMatrix(0).transformPoint(Vec3::make(0.3, 0.2, 0.1)),
        Vec3::make(0.3, 0.2, 0.1),
        0.00001
    );

    let mut copy : Pose = new Pose(3);
    copy.copyFrom(pose);
    nearVec3(
        c,
        "copyFrom copies the locals",
        copy.get(1).rotation.rotate(Vec3::unitY()),
        Vec3::make(-1.0, 0.0, 0.0),
        0.00001
    );
    copy.resetToBind(s);
    nearVec3(
        c,
        "resetToBind restores the bind pose",
        copy.get(1).rotation.rotate(Vec3::unitY()),
        Vec3::unitY(),
        0.00001
    );
}

fn animSkeletonTestScale(c : Checks) : void {
    // A root stretched along X carries a child that sits one unit along X to two units: matrices stay exact.
    let mut s : Skeleton = new Skeleton(2);
    s.addBone(
        "root",
        -1,
        Transform::make(Vec3::zero(), Quat::identity(), Vec3::make(2.0, 1.0, 1.0))
    );
    s.addBone("arm", 0, Transform::fromTranslation(Vec3::make(1.0, 0.0, 0.0)));
    let mut pose : Pose = Pose::bindOf(s);
    pose.update(s);
    nearVec3(
        c,
        "child of a stretched root",
        pose.modelMatrix(1).translationPart(),
        Vec3::make(2.0, 0.0, 0.0),
        0.00001
    );
    nearMat4(
        c,
        "skinning matrix of the bind pose is still the identity",
        pose.skinMatrix(1),
        Mat4::identity(),
        0.00001
    );
}

/** The skeleton and pose suite. */
pub class AnimSkeletonSuite {
    /** Runs the skeleton checks. */
    pub static fn run(c : Checks) : void {
        animSkeletonTestBones(c);
        animSkeletonTestBind(c);
        animSkeletonTestPose(c);
        animSkeletonTestScale(c);
    }
}

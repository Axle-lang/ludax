// model_support — the glTF documents and buffers the importer suites build.
//
// JSON in the sources is written with single quotes for readability and converted here; binary buffers are made
// with the float coding `model` verifies against bit patterns. The helpers hold no expectations of their own.

use ludax::Base64;
use ludax::ByteBuf;
use ludax::Checks;
use ludax::DataText;
use ludax::GltfImporter;
use ludax::Ieee;
use ludax::ModelAsset;
use ludax::Vec3;
use ludax::Vfs;

/** The tolerance for a decoded normalised integer: its exact value rounded once to f32. */
pub const MDL_TOL_NORM : f64 = 0.0000001;

/** The tolerance for an imported transform or a sampled animation value, a few f32 operations from exact. */
pub const MDL_TOL : f64 = 0.000001;

/** The tolerance for a transform composed along a node chain. */
pub const MDL_TOL_LOOSE : f64 = 0.00001;

/** The tolerance for a measured extent or volume of generated geometry. */
pub const MDL_TOL_COARSE : f64 = 0.0001;

/** JSON with ' for the double quote (the test sources stay readable). */
pub fn mdlJson(s : string) : string {
    let b : ByteBuf = DataText::toBytes(s);
    for (i of 0..b.len()) {
        if (b.get(i) == 39) {
            b.set(i, 34);
        }
    }
    return DataText::fromBytes(b, 0, b.len());
}

/** Appends `x` to `b` as a little-endian IEEE 754 single. */
pub fn mdlFloat(b : ByteBuf, x : f32) : void {
    b.pushLe32(Ieee::bitsOf(x));
}

/** Appends three positions to `b` as nine floats. */
pub fn mdlVec3s(b : ByteBuf, p0 : Vec3, p1 : Vec3, p2 : Vec3) : void {
    mdlFloat(b, p0.x);
    mdlFloat(b, p0.y);
    mdlFloat(b, p0.z);
    mdlFloat(b, p1.x);
    mdlFloat(b, p1.y);
    mdlFloat(b, p1.z);
    mdlFloat(b, p2.x);
    mdlFloat(b, p2.y);
    mdlFloat(b, p2.z);
}

/** A data URI holding the bytes of `b` in base64. */
pub fn mdlUri(b : ByteBuf) : string {
    return "data:application/octet-stream;base64,${Base64::encode(b)}";
}

/** A document with one buffer made of `b`, followed by `rest` (the other root members, no leading comma). */
pub fn mdlDoc(b : ByteBuf, rest : string) : string {
    let uri : string = mdlUri(b);
    return mdlJson("{'asset':{'version':'2.0'},'buffers':[{'byteLength':${b.len()},'uri':'${uri}'}],${rest}}");
}

/** The model the importer makes of the document `text`, with no files to load from. */
pub fn mdlImport(text : string) : ModelAsset {
    let vfs : Vfs = new Vfs();
    return GltfImporter::fromBytes(DataText::toBytes(text), vfs, "");
}

/** Checks that `got` is within `tol` of `want`. */
pub fn mdlNear(c : Checks, name : string, got : f32, want : f64, tol : f64) : void {
    c.near(name, got as f64, want, tol);
}

/** Three positions as a buffer view + accessor 0 at the start of a buffer: the smallest valid geometry. */
pub fn mdlTriBuffer() : ByteBuf {
    let b : ByteBuf = new ByteBuf(64);
    mdlVec3s(b, Vec3::make(0.0, 0.0, 0.0), Vec3::make(1.0, 0.0, 0.0), Vec3::make(0.0, 1.0, 0.0));
    return b;
}

/** The root members that make a one-triangle scene from `mdlTriBuffer`, with `extraNodes` added to the node. */
pub fn mdlTriRest(extraNodes : string) : string {
    return "'bufferViews':[{'buffer':0,'byteLength':36}],'accessors':[{'bufferView':0,'componentType':5126,'count':3,'type':'VEC3'}],'meshes':[{'primitives':[{'attributes':{'POSITION':0}}]}],'nodes':[{'mesh':0"
        + extraNodes
        + "}],'scenes':[{'nodes':[0]}]";
}

/** Checks that importing `text` is refused with a message. */
pub fn mdlFails(c : Checks, name : string, text : string) : void {
    let m : ModelAsset = mdlImport(text);
    c.that("model: rejects ${name} (${m.error()})", !m.ok() && m.error().byteLength > 0);
}

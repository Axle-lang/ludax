// math_frustum — the view frustum and its containment verdicts.
//
// The same verdicts are required of a standard, a reversed-depth and an infinite-far projection, because the
// depth convention changes how the near and far planes are extracted from the matrix and a box straddling a
// plane is where a frustum test is wrong by one.

use ludax::Aabb;
use ludax::Checks;
use ludax::Containment;
use ludax::Frustum;
use ludax::HALF_PI;
use ludax::Mat4;
use ludax::Sphere;
use ludax::Vec3;

/** The frustum checks. */
pub class MathFrustumSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        geomTestFrustum(c);
    }
}

// The three projection kinds the frustum checks sweep.
enum GeomCameraKind {
    Standard,
    Reversed,
    Infinite,
}

// A camera at the origin looking down -Z, 90 degrees tall, square.
fn geomCamera(kind : GeomCameraKind) : Frustum {
    let view : Mat4 = Mat4::lookAt(Vec3::zero(), Vec3::make(0.0, 0.0, -1.0), Vec3::unitY());
    let proj : Mat4 = match kind {
        GeomCameraKind::Standard => Mat4::perspective(HALF_PI, 1.0, 1.0, 100.0),
        GeomCameraKind::Reversed => Mat4::perspectiveReversed(HALF_PI, 1.0, 1.0, 100.0),
        GeomCameraKind::Infinite => Mat4::perspectiveInfiniteReversed(HALF_PI, 1.0, 1.0),
    };
    return Frustum::fromViewProjection(proj.mul(view));
}

fn geomVerdicts(c : Checks, kind : GeomCameraKind, label : string) : void {
    let f : Frustum = geomCamera(kind);
    let small : Vec3 = Vec3::splat(0.5);
    let ahead : Aabb = Aabb::fromCenterHalfSize(Vec3::make(0.0, 0.0, -20.0), small);
    c.that("${label}: a box ahead is inside", f.testAabb(ahead) == Containment::Inside);
    c.that(
        "${label}: a box behind the camera is outside",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::make(0.0, 0.0, 20.0), small))
            == Containment::Outside
    );
    c.that(
        "${label}: a box far to the left is outside",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::make(-60.0, 0.0, -20.0), small))
            == Containment::Outside
    );
    c.that(
        "${label}: a box far to the right is outside",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::make(60.0, 0.0, -20.0), small))
            == Containment::Outside
    );
    c.that(
        "${label}: a box far above is outside",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::make(0.0, 60.0, -20.0), small))
            == Containment::Outside
    );
    c.that(
        "${label}: a box far below is outside",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::make(0.0, -60.0, -20.0), small))
            == Containment::Outside
    );
    c.that(
        "${label}: a box straddling the left edge intersects",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::make(-20.0, 0.0, -20.0), small))
            == Containment::Intersecting
    );
    c.that(
        "${label}: a box straddling the near plane intersects",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::make(0.0, 0.0, -1.0), small))
            == Containment::Intersecting
    );
    c.that(
        "${label}: a box in front of the near plane is outside",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::make(0.0, 0.0, -0.4), Vec3::splat(0.1)))
            == Containment::Outside
    );
    c.that(
        "${label}: a huge box around the camera intersects",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::zero(), Vec3::splat(1000.0)))
            == Containment::Intersecting
    );
    c.that(
        "${label}: a ball ahead is inside",
        f.testSphere(Sphere::make(Vec3::make(0.0, 0.0, -20.0), 1.0)) == Containment::Inside
    );
    c.that(
        "${label}: a ball behind is outside",
        f.testSphere(Sphere::make(Vec3::make(0.0, 0.0, 20.0), 1.0)) == Containment::Outside
    );
    c.that(
        "${label}: a ball far to the right is outside",
        f.testSphere(Sphere::make(Vec3::make(80.0, 0.0, -20.0), 1.0)) == Containment::Outside
    );
    c.that(
        "${label}: a ball on the top edge intersects",
        f.testSphere(Sphere::make(Vec3::make(0.0, 20.0, -20.0), 1.0)) == Containment::Intersecting
    );
    c.that(
        "${label}: a ball enclosing the camera intersects",
        f.testSphere(Sphere::make(Vec3::zero(), 500.0)) == Containment::Intersecting
    );
    c.that("${label}: a box ahead intersects the frustum", f.intersectsAabb(ahead));
    c.that(
        "${label}: intersectsAabb behind",
        !f.intersectsAabb(Aabb::fromCenterHalfSize(Vec3::make(0.0, 0.0, 20.0), small))
    );
    c.that(
        "${label}: intersectsSphere ahead",
        f.intersectsSphere(Sphere::make(Vec3::make(0.0, 0.0, -50.0), 1.0))
    );
    c.that("${label}: a point ahead is contained", f.containsPoint(Vec3::make(1.0, -1.0, -10.0)));
    c.that(
        "${label}: a point behind is not contained",
        !f.containsPoint(Vec3::make(0.0, 0.0, 10.0))
    );
    c.that(
        "${label}: containsPoint outside the side",
        !f.containsPoint(Vec3::make(11.0, 0.0, -10.0))
    );
}

fn geomTestFrustum(c : Checks) : void {
    geomVerdicts(c, GeomCameraKind::Standard, "standard");
    geomVerdicts(c, GeomCameraKind::Reversed, "reversed");
    let f : Frustum = geomCamera(GeomCameraKind::Standard);
    c.that(
        "standard: a box beyond the far plane is outside",
        f.testAabb(Aabb::fromCenterHalfSize(Vec3::make(0.0, 0.0, -150.0), Vec3::splat(0.5)))
            == Containment::Outside
    );
    c.that(
        "standard: a point beyond the far plane is outside",
        !f.containsPoint(Vec3::make(0.0, 0.0, -101.0))
    );
    let infinite : Frustum = geomCamera(GeomCameraKind::Infinite);
    c.that(
        "infinite: a box ahead is inside",
        infinite.testAabb(Aabb::fromCenterHalfSize(Vec3::make(0.0, 0.0, -20.0), Vec3::splat(0.5)))
            == Containment::Inside
    );
    c.that(
        "infinite: a box behind is outside",
        !infinite.intersectsAabb(Aabb::fromCenterHalfSize(
            Vec3::make(0.0, 0.0, 20.0),
            Vec3::splat(0.5)
        ))
    );
    c.that(
        "infinite: a far box is still visible",
        infinite.containsPoint(Vec3::make(0.0, 0.0, -1000000.0))
    );
    c.that(
        "infinite: a box beside is outside",
        !infinite.intersectsAabb(Aabb::fromCenterHalfSize(
            Vec3::make(5000.0, 0.0, -20.0),
            Vec3::splat(0.5)
        ))
    );
    let ortho : Frustum = Frustum::fromViewProjection(Mat4::ortho(-2.0, 2.0, -1.0, 1.0, 1.0, 5.0));
    c.that("ortho: a point in the box is inside", ortho.containsPoint(Vec3::make(1.5, 0.5, -3.0)));
    c.that(
        "ortho: a point beyond the width is outside",
        !ortho.containsPoint(Vec3::make(2.5, 0.5, -3.0))
    );
    c.that(
        "ortho: a point beyond the far plane is outside",
        !ortho.containsPoint(Vec3::make(0.0, 0.0, -5.5))
    );
    c.that(
        "ortho: a point before the near plane is outside",
        !ortho.containsPoint(Vec3::make(0.0, 0.0, -0.5))
    );
    let moved : Frustum = Frustum::fromViewProjection(Mat4::perspective(
        HALF_PI,
        1.0,
        1.0,
        100.0
    ).mul(Mat4::lookAt(Vec3::make(100.0, 0.0, 0.0), Vec3::make(100.0, 0.0, -1.0), Vec3::unitY())));
    c.that(
        "a moved camera sees what is ahead of it",
        moved.containsPoint(Vec3::make(100.0, 0.0, -10.0))
    );
    c.that(
        "a moved camera does not see the old view",
        !moved.containsPoint(Vec3::make(0.0, 0.0, -10.0))
    );
    c.that(
        "a degenerate view-projection (identity) is a unit clip box",
        Frustum::fromViewProjection(Mat4::identity()).containsPoint(Vec3::make(0.5, -0.5, 0.5))
    );
    c.that(
        "and excludes outside it",
        !Frustum::fromViewProjection(Mat4::identity()).containsPoint(Vec3::make(1.5, 0.0, 0.5))
    );
}

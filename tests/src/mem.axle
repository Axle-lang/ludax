// mem — checks for Arena.
//
// A bump allocator has three things to get right: offsets honour their alignment, a request that does not fit
// fails cleanly without moving the cursor, and rewinding gives the memory back (zeroed, so stale data cannot
// leak into the next user). Out-of-block accesses abort by contract and are not exercised here.

use ludax::Arena;
use ludax::Checks;

/** The mem checks. Helpers are prefixed because top-level names are global to the package. */
pub class MemSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        memAllocationChecks(c);
        memRewindChecks(c);
        memAccessorChecks(c);
    }
}

fn memAllocationChecks(c : Checks) : void {
    let a : Arena = new Arena(256);
    c.sameInt("arena: capacity", a.capacity(), 256);
    c.sameInt("arena: starts unused", a.used(), 0);
    c.sameInt("arena: first allocation at 0", a.alloc(3, 1), 0);
    c.sameInt("arena: used counts bytes", a.used(), 3);
    c.sameInt("arena: 8-byte alignment pads", a.alloc(8, 8), 8);
    c.sameInt("arena: used includes padding", a.used(), 16);
    c.sameInt("arena: 16-byte alignment", a.alloc(1, 16), 16);
    c.sameInt("arena: packs after a byte", a.alloc(4, 1), 17);
    c.sameInt("arena: remaining", a.remaining(), 256 - 21);

    let before : i64 = a.used();
    c.sameInt("arena: a request that does not fit returns -1", a.alloc(1000, 1), -1);
    c.sameInt("arena: a failed request leaves the cursor", a.used(), before);
    c.sameInt("arena: a smaller request still fits afterwards", a.alloc(10, 1), 21);
    c.sameInt("arena: exactly filling the block", a.alloc(a.remaining(), 1), 31);
    c.sameInt("arena: a full arena refuses one more byte", a.alloc(1, 1), -1);
    c.sameInt("arena: a zero-size request on a full arena is fine", a.alloc(0, 1), 256);

    let typed : Arena = new Arena(1024);
    typed.alloc(1, 1);
    c.sameInt("arena: allocI32 aligns to 4", typed.allocI32(3), 4);
    c.sameInt("arena: allocF32 follows", typed.allocF32(2), 16);
    c.sameInt("arena: allocI64 aligns to 8", typed.allocI64(1), 24);
    c.sameInt("arena: allocF64", typed.allocF64(2), 32);
    c.sameInt("arena: used after the typed allocations", typed.used(), 48);

    let tiny : Arena = new Arena(0);
    c.sameInt("arena: a zero-byte request still makes a block", tiny.capacity(), 1);
}

fn memRewindChecks(c : Checks) : void {
    let a : Arena = new Arena(128);
    let first : i64 = a.allocI32(4);
    a.setI32(first, 11);
    let mark : i64 = a.mark();
    let scratch : i64 = a.allocI64(4);
    a.setI64(scratch, 99);
    a.setI64(scratch + 24, 77);
    c.sameInt("arena: scratch sits after the mark", scratch, mark);
    a.rewindTo(mark);
    c.sameInt("arena: rewind restores the cursor", a.used(), mark);
    c.sameInt("arena: memory before the mark is untouched", a.getI32(first), 11);
    let again : i64 = a.allocI64(4);
    c.sameInt("arena: the rewound region is handed out again", again, scratch);
    c.sameInt(
        "arena: reset leaves earlier data alone, later data stays until reset",
        a.getI64(again),
        99
    );

    a.reset();
    c.sameInt("arena: reset empties", a.used(), 0);
    let fresh : i64 = a.allocI64(4);
    c.sameInt("arena: reset zeroes the block (start)", a.getI64(fresh), 0);
    c.sameInt("arena: reset zeroes the block (end)", a.getI64(fresh + 24), 0);
    c.sameInt("arena: reset zeroes what rewind left", a.getI32(first), 0);
}

fn memAccessorChecks(c : Checks) : void {
    let a : Arena = new Arena(64);
    let ints : i64 = a.allocI32(4);
    for (i of 0..4) {
        a.setI32(ints + i as i64 * 4, i * 1000 - 1500);
    }
    let mut ok : bool = true;
    for (i of 0..4) {
        if (a.getI32(ints + i as i64 * 4) != i * 1000 - 1500) {
            ok = false;
        }
    }
    c.that("arena: i32 round trip, negative values included", ok);

    let big : i64 = a.allocI64(1);
    a.setI64(big, 9007199254740993);
    c.sameInt("arena: i64 round trip beyond 2^53", a.getI64(big), 9007199254740993);

    let floats : i64 = a.allocF32(2);
    a.setF32(floats, 1.5 as f32);
    a.setF32(floats + 4, -0.25 as f32);
    c.near("arena: f32 round trip", a.getF32(floats) as f64, 1.5, 0.0);
    c.near("arena: f32 round trip, negative", a.getF32(floats + 4) as f64, -0.25, 0.0);

    let doubles : i64 = a.allocF64(1);
    a.setF64(doubles, 0.1);
    c.near("arena: f64 round trip", a.getF64(doubles), 0.1, 0.0);
    a.setI32(ints, 7);
    c.sameInt("arena: neighbours are not disturbed", a.getI32(ints + 4), -500);
}

// rng — the Pcg32 generator: published vectors, determinism, ranges, shuffling.
//
// The generator is pinned to the numbers published with PCG and to an independent implementation of the same
// algorithm, so a change in the arithmetic fails here before it changes a world. The statistical checks use
// fixed seeds and wide margins: they catch a broken range or a biased draw, not ordinary sampling noise.

use ludax::{Checks, Pcg32};

// The whole i32 span, written this way because -2147483648 has no positive literal.
// The language requires a top-level constant to be a literal, so the extremes are written out.
const RNG_I32_MIN : i32 = -2147483648;
const RNG_I32_MAX : i32 = 2147483647;

/** The rng checks, one static function per topic. */
pub class RngSuite {
    // The demo program of the PCG paper, seed 42 and sequence 54.
    static fn referenceVectors(c : Checks) : void {
        let g : Pcg32 = new Pcg32(42, 54);
        c.sameInt("pcg32 reference output 0", g.nextU32() as i64, 0xa15c02b7);
        c.sameInt("pcg32 reference output 1", g.nextU32() as i64, 0x7b47f409);
        c.sameInt("pcg32 reference output 2", g.nextU32() as i64, 0xba1d3330);
        c.sameInt("pcg32 reference output 3", g.nextU32() as i64, 0x83d2f293);
        c.sameInt("pcg32 reference output 4", g.nextU32() as i64, 0xbfa4784b);
        c.sameInt("pcg32 reference output 5", g.nextU32() as i64, 0xcbed606e);

        // Other seeds, taken from an independent implementation of the same algorithm.
        let h : Pcg32 = new Pcg32(1, 1);
        c.sameInt("pcg32 seed 1 stream 1, first", h.nextU32() as i64, 3380776849);
        c.sameInt("pcg32 seed 1 stream 1, second", h.nextU32() as i64, 361947764);
        c.sameInt("pcg32 seed 1 stream 1, third", h.nextU32() as i64, 3223725655);

        let wide : Pcg32 = new Pcg32(42, 54);
        c.that(
            "nextU64 joins two draws, first in the high half",
            wide.nextU64() == 11627171325034361865
        );
    }

    static fn determinism(c : Checks) : void {
        let a : Pcg32 = new Pcg32(99, 3);
        let b : Pcg32 = new Pcg32(99, 3);
        let mut same : bool = true;
        for (i of 0..1000) {
            if (a.nextU32() != b.nextU32()) {
                same = false;
            }
        }
        c.that("equal seed and stream give equal sequences", same);

        let other : Pcg32 = new Pcg32(99, 4);
        let first : Pcg32 = new Pcg32(99, 3);
        let mut differs : bool = false;
        for (i of 0..8) {
            if (other.nextU32() != first.nextU32()) {
                differs = true;
            }
        }
        c.that("another stream gives another sequence", differs);

        let zero : Pcg32 = new Pcg32(0, 0);
        c.that("seed 0 stream 0 still produces output", zero.nextU32() != zero.nextU32());
    }

    static fn floats(c : Checks) : void {
        let g : Pcg32 = new Pcg32(7, 3);
        // 14383911 / 2^24, the third check below: exactly the top 24 bits of the first output.
        c.near(
            "nextF32 is the top 24 bits over 2^24",
            g.nextF32() as f64,
            14383911.0 / 16777216.0,
            0.0
        );

        let mut lowest : f32 = 1.0;
        let mut highest : f32 = 0.0;
        let mut sum : f64 = 0.0;
        for (i of 0..20000) {
            let x : f32 = g.nextF32();
            if (x < lowest) {
                lowest = x;
            }
            if (x > highest) {
                highest = x;
            }
            sum = sum + x as f64;
        }
        c.that("nextF32 stays in [0, 1)", lowest >= 0.0 && highest < 1.0);
        c.near("nextF32 averages one half", sum / 20000.0, 0.5, 0.01);

        let mut inRange : bool = true;
        for (i of 0..1000) {
            let d : f64 = g.nextF64();
            if (d < 0.0 || d >= 1.0) {
                inRange = false;
            }
            let r : f32 = g.rangeF32(-2.0 as f32, 3.0 as f32);
            if (r < -2.0 || r >= 3.0) {
                inRange = false;
            }
        }
        c.that("nextF64 and rangeF32 stay in range", inRange);
    }

    static fn ranges(c : Checks) : void {
        let g : Pcg32 = new Pcg32(2024, 9);
        // Reference values from an independent implementation: range(10, 100) x 8, then nextBelow(6) x 5.
        let want : i32[] = [36, 94, 82, 10, 60, 48, 90, 70];
        let mut matches : bool = true;
        for (i of 0..8) {
            if (g.range(10, 100) != want[i]) {
                matches = false;
            }
        }
        c.that("range(10, 100) follows the reference sequence", matches);
        c.sameInt("nextBelow(6), first", g.nextBelow(6) as i64, 1);
        c.sameInt("nextBelow(6), second", g.nextBelow(6) as i64, 2);

        let h : Pcg32 = new Pcg32(1, 1);
        let mut lowSeen : bool = false;
        let mut highSeen : bool = false;
        let mut inside : bool = true;
        for (i of 0..5000) {
            let v : i32 = h.range(-3, 4);
            if (v < -3 || v >= 4) {
                inside = false;
            }
            if (v == -3) {
                lowSeen = true;
            }
            if (v == 3) {
                highSeen = true;
            }
        }
        c.that("range(-3, 4) stays inside and reaches both ends", inside && lowSeen && highSeen);

        c.sameInt("empty range answers lo", h.range(5, 5), 5);
        c.sameInt("inverted range answers lo", h.range(9, 2), 9);
        c.sameInt("nextBelow(0) answers 0", h.nextBelow(0) as i64, 0);
        c.sameInt("nextBelow(1) answers 0", h.nextBelow(1) as i64, 0);
        c.sameInt("range of width 1", h.range(7, 8), 7);

        // The widest range an i32 pair allows: the width is 2^32 - 1 and must not overflow.
        let mut wide : bool = true;
        for (i of 0..100) {
            let v : i32 = h.range(RNG_I32_MIN, RNG_I32_MAX);
            if (v >= RNG_I32_MAX) {
                wide = false;
            }
        }
        c.that("range over the whole i32 span", wide);
    }

    static fn unbiased(c : Checks) : void {
        // 6 dice faces, 60000 rolls: each face within 5% of 10000 if the draw is uniform.
        let g : Pcg32 = new Pcg32(31337, 1);
        let mut counts : i32[] = malloc<i32>(6);
        for (i of 0..6) {
            counts[i] = 0;
        }
        for (i of 0..60000) {
            let face : i32 = g.nextBelow(6) as i32;
            counts[face] = counts[face] + 1;
        }
        let mut even : bool = true;
        for (i of 0..6) {
            if (counts[i] < 9500 || counts[i] > 10500) {
                even = false;
            }
        }
        c.that("nextBelow(6) is uniform over 60000 rolls", even);

        let coin : Pcg32 = new Pcg32(5, 5);
        let mut heads : i32 = 0;
        for (i of 0..10000) {
            if (coin.nextBool()) {
                heads = heads + 1;
            }
        }
        c.that("nextBool is fair", heads > 4700 && heads < 5300);
    }

    static fn shuffling(c : Checks) : void {
        let g : Pcg32 = new Pcg32(5, 5);
        let mut items : i32[] = malloc<i32>(8);
        for (i of 0..8) {
            items[i] = i;
        }
        g.shuffle(items, 8);
        let want : i32[] = [3, 2, 7, 0, 1, 6, 5, 4];
        let mut same : bool = true;
        for (i of 0..8) {
            if (items[i] != want[i]) {
                same = false;
            }
        }
        c.that("shuffle follows the reference Fisher-Yates", same);

        let order : i32[] = new Pcg32(11, 2).permutation(100);
        let mut seen : i32[] = malloc<i32>(100);
        for (i of 0..100) {
            seen[i] = 0;
        }
        for (i of 0..100) {
            seen[order[i]] = seen[order[i]] + 1;
        }
        let mut each : bool = true;
        for (i of 0..100) {
            if (seen[i] != 1) {
                each = false;
            }
        }
        c.that("permutation holds each index exactly once", each);

        let mut partial : i32[] = malloc<i32>(5);
        for (i of 0..5) {
            partial[i] = i;
        }
        new Pcg32(1, 1).shuffle(partial, 3);
        c.that("shuffle leaves entries past count alone", partial[3] == 3 && partial[4] == 4);

        let none : i32[] = new Pcg32(1, 1).permutation(0);
        c.sameInt("permutation of nothing is empty", none.length, 0);
        let one : i32[] = new Pcg32(1, 1).permutation(1);
        c.sameInt("permutation of one is that one", one[0], 0);
    }

    /** Runs the generator checks. */
    pub static fn run(c : Checks) : void {
        RngSuite::referenceVectors(c);
        RngSuite::determinism(c);
        RngSuite::floats(c);
        RngSuite::ranges(c);
        RngSuite::unbiased(c);
        RngSuite::shuffling(c);
    }
}

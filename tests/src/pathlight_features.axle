// pathlight_features — checks for the feature list: what `waves,reflection`, `-reflection`, `all` and `none` keep,
// the order of the names, a name that is not a feature, and what the mask does to the settings.

use ludax::{
    Checks, LUMEN_FEATURES_ALL, LUMEN_FEATURE_NAMES, LumenFeature, LumenFeatureChoice,
    LumenSettings, lumenFeaturesParse
};

/** Checks the feature list and its effect on the renderer's settings. */
pub class PathlightFeaturesSuite {
    /** Runs every check of the suite. */
    pub static fn run(mut c : Checks) : void {
        plfLists(c);
        plfProblems(c);
        plfSettings(c);
    }
}

fn plfKept(list : string) : i32 {
    let choice : LumenFeatureChoice = lumenFeaturesParse(list);
    return choice.kept;
}

fn plfLists(mut c : Checks) : void {
    let waves : i32 = LumenFeature::Waves.bit();
    let reflection : i32 = LumenFeature::Reflection.bit();
    c.sameInt("features: an empty list keeps everything", plfKept(""), LUMEN_FEATURES_ALL);
    c.sameInt("... and so does `all`", plfKept("all"), LUMEN_FEATURES_ALL);
    c.sameInt("... `none` keeps nothing", plfKept("none"), 0);
    c.sameInt("... names alone keep only those", plfKept("waves,reflection"), waves | reflection);
    c.sameInt(
        "... a minus drops one from everything",
        plfKept("-reflection"),
        LUMEN_FEATURES_ALL - reflection
    );
    c.sameInt(
        "... several minuses drop several",
        plfKept("-reflection,-waves"),
        LUMEN_FEATURES_ALL - reflection - waves
    );
    c.sameInt(
        "... a name after `all` and a minus: `all,-waves`",
        plfKept("all,-waves"),
        LUMEN_FEATURES_ALL - waves
    );
    c.sameInt("... `none` then a name keeps that name", plfKept("none,waves"), waves);
    c.sameInt("... a name then its minus keeps nothing of it", plfKept("waves,-waves"), 0);
    c.sameInt(
        "... empty items between commas are ignored",
        plfKept(",waves,,reflection,"),
        waves | reflection
    );
    let mut seen : i32 = 0;
    seen = seen | LumenFeature::Lamps.bit() | LumenFeature::Bounce.bit()
        | LumenFeature::Shafts.bit();
    seen = seen | LumenFeature::Bloom.bit() | LumenFeature::Fog.bit() | waves | reflection;
    seen = seen | LumenFeature::Transmission.bit();
    seen = seen | LumenFeature::Sun.bit() | LumenFeature::Sky.bit() | LumenFeature::Flood.bit();
    seen = seen | LumenFeature::Emission.bit();
    c.sameInt(
        "... the twelve features have twelve different bits that make up `all`",
        seen,
        LUMEN_FEATURES_ALL
    );
}

fn plfProblems(mut c : Checks) : void {
    let bad : LumenFeatureChoice = lumenFeaturesParse("waves,foo");
    c.that("features: a name that is not a feature is a problem", bad.problem.length > 0);
    c.that(
        "... that names it and lists the features",
        bad.problem == "unknown feature foo; the features are ${LUMEN_FEATURE_NAMES}"
    );
    let badMinus : LumenFeatureChoice = lumenFeaturesParse("-foo");
    c.that("... also after a minus", badMinus.problem.length > 0);
    let fine : LumenFeatureChoice = lumenFeaturesParse("waves");
    c.that("... and a good list has none", fine.problem.length == 0);
}

fn plfSettings(mut c : Checks) : void {
    let s : LumenSettings = new LumenSettings();
    s.keepOnlyIn(LUMEN_FEATURES_ALL);
    c.that(
        "features: keeping everything changes nothing",
        s.lamps && s.bounce && s.godRays && s.waves && s.reflection && s.transmission
            && s.bloom > 0.0
            && s.fog > 0.0
    );
    s.keepOnlyIn(LUMEN_FEATURES_ALL - LumenFeature::Reflection.bit() - LumenFeature::Bloom.bit());
    c.that("... dropping the reflection switches it off", !s.reflection);
    c.that("... and the bloom to zero", s.bloom == 0.0);
    c.that(
        "... the others stay",
        s.lamps && s.bounce && s.godRays && s.waves && s.transmission && s.fog > 0.0
    );
    s.keepOnlyIn(0);
    c.that(
        "... keeping nothing switches all of them off",
        !s.lamps && !s.bounce && !s.godRays && !s.waves && !s.reflection && !s.transmission
            && s.fog == 0.0
    );
}

// main — the checks program: one main that runs every suite in order.
//
// The suites are registered here rather than discovered, so the order is visible in one place and a suite that
// is dropped shows up as a missing call. The three checks before the suites prove the harness itself can pass;
// the exit status is the number of misses, so 0 means every suite held.

use ludax::Checks;

use crate::anim_blend::AnimBlendSuite;
use crate::anim_clip::AnimClipSuite;
use crate::anim_skeleton::AnimSkeletonSuite;
use crate::anim_solve::AnimSolveSuite;
use crate::anim_track::AnimTrackSuite;
use crate::assetdb::AssetDbSuite;
use crate::audio_engine::AudioEngineSuite;
use crate::audio_synth::AudioSynthSuite;
use crate::bbmodel::BbModelSuite;
use crate::collections::CollectionsSuite;
use crate::data::DataSuite;
use crate::id::IdSuite;
use crate::jobs::JobsSuite;
use crate::json::JsonSuite;
use crate::kinetic_dynamics::KineticDynamicsSuite;
use crate::kinetic_joints::KineticJointsSuite;
use crate::kinetic_shapes::KineticShapesSuite;
use crate::kinetic_world::KineticWorldSuite;
use crate::light_brdf::LightBrdfSuite;
use crate::light_color::LightColorSuite;
use crate::light_explain::LightExplainSuite;
use crate::light_irradiance::LightIrradianceSuite;
use crate::light_sh::LightShSuite;
use crate::light_sky::LightSkySuite;
use crate::light_units::LightUnitsSuite;
use crate::light_vndf::LightVndfSuite;
use crate::log::LogSuite;
use crate::math_f64::MathF64Suite;
use crate::math_geom::MathGeomSuite;
use crate::math_mat::MathMatSuite;
use crate::math_quat::MathQuatSuite;
use crate::math_scalar::MathScalarSuite;
use crate::math_trig::MathTrigSuite;
use crate::math_vec::MathVecSuite;
use crate::mem::MemSuite;
use crate::model::ModelSuite;
use crate::nav_grid::NavGridSuite;
use crate::nav_mesh::NavMeshSuite;
use crate::nav_steer::NavSteerSuite;
use crate::openworld::OpenworldSuite;
use crate::profile::ProfileSuite;
use crate::render_cmd::RenderCmdSuite;
use crate::render_cpu::RenderCpuSuite;
use crate::render_cpu_light::RenderCpuLightSuite;
use crate::render_graph::RenderGraphSuite;
use crate::render_scene::RenderSceneSuite;
use crate::rng::RngSuite;
use crate::runtime::RuntimeSuite;
use crate::time::TimeSuite;
use crate::vfs::VfsSuite;
use crate::voxlight_bake::VoxLightBakeSuite;
use crate::voxlight_dda::VoxLightDdaSuite;
use crate::voxlight_edit::VoxLightEditSuite;
use crate::voxlight_emitter::VoxLightEmitterSuite;
use crate::voxlight_flood::VoxLightFloodSuite;
use crate::voxlight_grid::VoxLightGridSuite;
use crate::voxlight_sample::VoxLightSampleSuite;
use crate::voxworld_chunk::VoxWorldChunkSuite;
use crate::voxworld_gen::VoxWorldGenSuite;
use crate::voxworld_light::VoxWorldLightSuite;
use crate::voxworld_mesh::VoxWorldMeshSuite;
use crate::voxworld_save::VoxWorldSaveSuite;
use crate::voxworld_stream::VoxWorldStreamSuite;
use crate::wav::WavSuite;
use crate::world::WorldSuite;
use crate::world_json::WorldJsonSuite;

fn main() : i32 {
    let mut c : Checks = new Checks();
    c.that("the harness passes a true check", true);
    c.sameInt("whole numbers compare", 3, 3);
    c.near("reals compare within a tolerance", 0.1 + 0.2, 0.3, 0.000000000001);
    CollectionsSuite::run(c);
    MemSuite::run(c);
    IdSuite::run(c);
    MathScalarSuite::run(c);
    MathTrigSuite::run(c);
    MathVecSuite::run(c);
    MathMatSuite::run(c);
    MathQuatSuite::run(c);
    MathGeomSuite::run(c);
    MathF64Suite::run(c);
    RngSuite::run(c);
    TimeSuite::run(c);
    LogSuite::run(c);
    JobsSuite::run(c);
    ProfileSuite::run(c);
    LightUnitsSuite::run(c);
    LightIrradianceSuite::run(c);

    LightBrdfSuite::run(c);
    LightVndfSuite::run(c);
    LightColorSuite::run(c);
    LightShSuite::run(c);
    LightExplainSuite::run(c);
    LightSkySuite::run(c);
    RenderSceneSuite::run(c);
    RenderCmdSuite::run(c);
    RenderGraphSuite::run(c);
    RenderCpuSuite::run(c);
    RenderCpuLightSuite::run(c);
    AnimSkeletonSuite::run(c);
    AnimClipSuite::run(c);
    AnimBlendSuite::run(c);
    AnimSolveSuite::run(c);
    NavGridSuite::run(c);
    NavMeshSuite::run(c);
    NavSteerSuite::run(c);
    KineticShapesSuite::run(c);
    KineticDynamicsSuite::run(c);
    KineticJointsSuite::run(c);
    KineticWorldSuite::run(c);
    RuntimeSuite::run(c);
    OpenworldSuite::run(c);
    VoxLightGridSuite::run(c);
    VoxLightDdaSuite::run(c);
    VoxLightFloodSuite::run(c);
    VoxLightEditSuite::run(c);
    VoxLightBakeSuite::run(c);
    VoxLightSampleSuite::run(c);
    VoxLightEmitterSuite::run(c);
    WavSuite::run(c);
    AudioEngineSuite::run(c);
    AudioSynthSuite::run(c);
    VoxWorldChunkSuite::run(c);
    VoxWorldGenSuite::run(c);
    VoxWorldStreamSuite::run(c);
    VoxWorldSaveSuite::run(c);
    VoxWorldMeshSuite::run(c);
    VoxWorldLightSuite::run(c);
    println("checks: ${c.count()}, failed: ${c.misses()}");
    return c.misses();
}

// nav_mesh — navigation meshes: polygons, portals, location, A* over portals and the funnel algorithm.
//
// Hand-built polygons pin winding, containment and the funnel's choice of corner; random grids then compare a
// mesh path with a breadth-first search on the grid it came from. A path must exist exactly where the grid is
// connected, stay over walkable cells, keep its ends exact and never exceed the polyline through the doorways.

use ludax::{Checks, Pcg32, GridMap, NavMesh, NavMeshGrid, NavPath, Vec2};

use crate::nav_grid::{navBfsSteps, navRandomMap};

/** Adds an axis-aligned rectangle to `mesh` with its own four vertices. */
fn navMeshRect(mesh : NavMesh, x0 : f32, y0 : f32, x1 : f32, y1 : f32) : i32 {
    let mut corners : i32[] = malloc<i32>(4);
    corners[0] = mesh.addVertex(x0, y0);
    corners[1] = mesh.addVertex(x1, y0);
    corners[2] = mesh.addVertex(x1, y1);
    corners[3] = mesh.addVertex(x0, y1);
    return mesh.addPolygon(corners, 4);
}

/** An L of three squares sharing whole edges: A (0..2, 0..2), B (2..4, 0..2) and C (2..4, 2..4). */
fn navMeshL() : NavMesh {
    let mut mesh : NavMesh = new NavMesh();
    let v0 : i32 = mesh.addVertex(0.0, 0.0);
    let v1 : i32 = mesh.addVertex(2.0, 0.0);
    let v2 : i32 = mesh.addVertex(4.0, 0.0);
    let v3 : i32 = mesh.addVertex(0.0, 2.0);
    let v4 : i32 = mesh.addVertex(2.0, 2.0);
    let v5 : i32 = mesh.addVertex(4.0, 2.0);
    let v6 : i32 = mesh.addVertex(2.0, 4.0);
    let v7 : i32 = mesh.addVertex(4.0, 4.0);
    let mut a : i32[] = malloc<i32>(4);
    a[0] = v0;
    a[1] = v1;
    a[2] = v4;
    a[3] = v3;
    mesh.addPolygon(a, 4);
    a[0] = v1;
    a[1] = v2;
    a[2] = v5;
    a[3] = v4;
    mesh.addPolygon(a, 4);
    a[0] = v4;
    a[1] = v5;
    a[2] = v7;
    a[3] = v6;
    mesh.addPolygon(a, 4);
    mesh.build();
    return mesh;
}

fn navMeshTestBuild(c : Checks) : void {
    let mesh : NavMesh = navMeshL();
    c.sameInt("three polygons", mesh.polygonCount() as i64, 3);
    c.sameInt("two shared edges make four directed portals", mesh.portalCount() as i64, 4);
    c.sameInt("the end square has one doorway", mesh.neighbourCount(0) as i64, 1);
    c.sameInt("the middle square has two", mesh.neighbourCount(1) as i64, 2);

    let mut m : NavMesh = new NavMesh();
    let a : i32 = m.addVertex(0.0, 0.0);
    let b : i32 = m.addVertex(4.0, 0.0);
    let d : i32 = m.addVertex(4.0, 4.0);
    let e : i32 = m.addVertex(0.0, 4.0);
    let mid : i32 = m.addVertex(2.0, 1.0);
    let mut sq : i32[] = malloc<i32>(4);
    sq[0] = a;
    sq[1] = e;
    sq[2] = d;
    sq[3] = b;
    c.sameInt("a clockwise polygon is accepted (and reversed)", m.addPolygon(sq, 4) as i64, 0);
    c.that("and then contains its inside", m.contains(0, 2.0, 2.0));
    let mut dent : i32[] = malloc<i32>(5);
    dent[0] = a;
    dent[1] = mid;
    dent[2] = b;
    dent[3] = d;
    dent[4] = e;
    c.sameInt("a concave polygon is refused", m.addPolygon(dent, 5) as i64, -1);
    let mut line : i32[] = malloc<i32>(3);
    line[0] = a;
    line[1] = mid;
    line[2] = b;
    c.sameInt("a triangle is a polygon too", m.addPolygon(line, 3) as i64, 1);
    let mut flat : i32[] = malloc<i32>(3);
    flat[0] = a;
    flat[1] = b;
    flat[2] = a;
    c.sameInt("a degenerate polygon is refused", m.addPolygon(flat, 3) as i64, -1);
    c.sameInt("fewer than three corners is refused", m.addPolygon(flat, 2) as i64, -1);
    flat[2] = 99;
    c.sameInt("an unknown vertex is refused", m.addPolygon(flat, 3) as i64, -1);
    c.that("an unbuilt mesh finds no path", !m.findPath(1.0, 1.0, 3.0, 3.0).found());
    m.build();
    c.that("a built mesh takes no more polygons", m.addPolygon(sq, 4) == -1);
}

fn navMeshTestLocate(c : Checks) : void {
    let mesh : NavMesh = navMeshL();
    c.sameInt("a point in the first square", mesh.locate(1.0, 1.0) as i64, 0);
    c.sameInt("a point in the top square", mesh.locate(3.0, 3.0) as i64, 2);
    c.sameInt(
        "a point on a shared edge goes to the lowest polygon",
        mesh.locate(2.0, 1.0) as i64,
        0
    );
    c.sameInt("a point on the border counts as inside", mesh.locate(0.0, 0.0) as i64, 0);
    c.sameInt("a point off the mesh", mesh.locate(1.0, 3.0) as i64, -1);
    c.sameInt("far off", mesh.locate(-50.0, 9.0) as i64, -1);
    c.that("contains agrees", mesh.contains(2, 3.9, 3.9) && !mesh.contains(2, 1.9, 3.0));
}

fn navMeshTestFunnel(c : Checks) : void {
    let mesh : NavMesh = navMeshL();
    let p : NavPath = mesh.findPath(0.5, 0.2, 2.5, 3.8);
    c.that("the L is crossed", p.found());
    c.sameInt("start, the inner corner, goal", p.len() as i64, 3);
    c.that(
        "the bend is the corner (2, 2)",
        p.xAt(1) > 1.9999 && p.xAt(1) < 2.0001 && p.yAt(1) > 1.9999 && p.yAt(1) < 2.0001
    );
    c.near("its length", p.length() as f64, 4.2113, 0.001);
    c.sameInt("three polygons crossed", p.polygonsCrossed() as i64, 3);
    c.that(
        "the path is no longer than the line through the doorway midpoints",
        p.length() <= p.corridorLength() + 0.0001
    );

    let straight : NavPath = mesh.findPath(0.5, 0.5, 3.5, 0.5);
    c.sameInt("a straight run needs no bend", straight.len() as i64, 2);
    c.near("and is as long as the distance", straight.length() as f64, 3.0, 0.0001);

    let inside : NavPath = mesh.findPath(0.5, 0.5, 1.5, 1.5);
    c.sameInt("within one polygon: straight", inside.len() as i64, 2);
    c.that("found", inside.found());

    c.that("off the mesh: no path", !mesh.findPath(1.0, 3.0, 3.0, 0.5).found());
    c.that("to off the mesh: no path", !mesh.findPath(0.5, 0.5, -1.0, -1.0).found());

    // The goal behind the corner the other way round mirrors the same bend.
    let back : NavPath = mesh.findPath(2.5, 3.8, 0.5, 0.2);
    c.near("the reverse trip is as long", back.length() as f64, p.length() as f64, 0.0001);

    // Two islands: no route between them.
    let mut two : NavMesh = new NavMesh();
    navMeshRect(two, 0.0, 0.0, 1.0, 1.0);
    navMeshRect(two, 5.0, 5.0, 6.0, 6.0);
    two.build();
    c.that("disconnected polygons: no path", !two.findPath(0.5, 0.5, 5.5, 5.5).found());
}

fn navMeshTestPortals(c : Checks) : void {
    // Two rooms of different height joined by a door narrower than either: the doorway is the overlap only.
    let mut mesh : NavMesh = new NavMesh();
    let left : i32 = navMeshRect(mesh, 0.0, 0.0, 4.0, 4.0);
    let right : i32 = navMeshRect(mesh, 4.0, 1.0, 8.0, 3.0);
    c.that(
        "two rooms that touch along part of a side share no vertex edge",
        mesh.portalCount() == 0
    );
    c.that(
        "a manual doorway is accepted",
        mesh.addPortal(left, right, Vec2::make(4.0, 1.0), Vec2::make(4.0, 3.0))
    );
    c.that(
        "a doorway to an unknown polygon is refused",
        !mesh.addPortal(left, 9, Vec2::make(4.0, 1.0), Vec2::make(4.0, 3.0))
    );
    c.that(
        "and one of no width",
        !mesh.addPortal(left, right, Vec2::make(4.0, 1.0), Vec2::make(4.0, 1.0))
    );
    mesh.build();
    c.sameInt("both directions exist", mesh.portalCount() as i64, 2);
    let p : NavPath = mesh.findPath(0.5, 3.8, 7.5, 3.0);
    c.that("the path goes through the door", p.found() && p.len() == 3);
    c.that(
        "bending at the door's near end (4, 3)",
        p.xAt(1) > 3.999 && p.xAt(1) < 4.001 && p.yAt(1) > 2.999 && p.yAt(1) < 3.001
    );
}

fn navMeshPointOk(map : GridMap, cell : f32, x : f32, y : f32) : bool {
    let eps : f32 = 0.002;
    let mut k : i32 = 0;
    while (k < 9) {
        let ox : f32 = ((k % 3) - 1) as f32 * eps;
        let oy : f32 = ((k / 3) - 1) as f32 * eps;
        let cx : i32 = ((x + ox) / cell) as i32;
        let cy : i32 = ((y + oy) / cell) as i32;
        if (x + ox >= 0.0 && y + oy >= 0.0 && map.isWalkable(cx, cy)) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

fn navMeshTestFromGrid(c : Checks) : void {
    let mut rng : Pcg32 = new Pcg32(4242, 11);
    let mut connected : bool = true;
    let mut shorter : bool = true;
    let mut inside : bool = true;
    let mut atLeastStraight : bool = true;
    let mut same : bool = true;
    let mut ends : bool = true;
    let mut found : i32 = 0;
    let mut missing : i32 = 0;
    let cell : f32 = 2.0;
    let half : f32 = 0.5;
    let samples : f32 = 24.0;
    for (m of 0..25) {
        let map : GridMap = navRandomMap(rng, 24, 18, 12 + (m % 4) * 7);
        let mesh : NavMesh = NavMeshGrid::build(map, cell);
        for (q of 0..8) {
            let sx : i32 = rng.range(0, 24);
            let sy : i32 = rng.range(0, 18);
            let gx : i32 = rng.range(0, 24);
            let gy : i32 = rng.range(0, 18);
            if (!map.isWalkable(sx, sy) || !map.isWalkable(gx, gy)) {
                continue;
            }
            let px : f32 = (sx as f32 + half) * cell;
            let py : f32 = (sy as f32 + half) * cell;
            let qx : f32 = (gx as f32 + half) * cell;
            let qy : f32 = (gy as f32 + half) * cell;
            let path : NavPath = mesh.findPath(px, py, qx, qy);
            let reachable : bool = navBfsSteps(map, sx, sy, gx, gy) >= 0;
            if (path.found() != reachable) {
                connected = false;
            }
            if (!path.found()) {
                missing = missing + 1;
                continue;
            }
            found = found + 1;
            if (path.length() > path.corridorLength() + 0.001) {
                shorter = false;
            }
            let dx : f32 = qx - px;
            let dy : f32 = qy - py;
            if (path.length() + 0.001 < (dx * dx + dy * dy).sqrt()) {
                atLeastStraight = false;
            }
            if (path.xAt(0) != px || path.yAt(0) != py || path.xAt(path.len() - 1) != qx
                || path.yAt(path.len() - 1) != qy) {
                ends = false;
            }
            for (i of 1..path.len()) {
                for (k of 0..24) {
                    let t : f32 = ((k as f32) + half) / samples;
                    let x : f32 = path.xAt(i - 1) + (path.xAt(i) - path.xAt(i - 1)) * t;
                    let y : f32 = path.yAt(i - 1) + (path.yAt(i) - path.yAt(i - 1)) * t;
                    if (!navMeshPointOk(map, cell, x, y)) {
                        inside = false;
                    }
                }
            }
            let again : NavPath = mesh.findPath(px, py, qx, qy);
            if (again.len() != path.len()) {
                same = false;
            } else {
                for (i of 0..path.len()) {
                    if (again.xAt(i) != path.xAt(i) || again.yAt(i) != path.yAt(i)) {
                        same = false;
                    }
                }
            }
        }
    }
    c.that("a path exists exactly where the grid says the cells are connected", connected);
    c.that(
        "the funnel path is never longer than the polyline through the doorway midpoints",
        shorter
    );
    c.that("and never shorter than the straight line", atLeastStraight);
    c.that("every segment of every path stays on walkable cells", inside);
    c.that("paths begin and end exactly at the asked points", ends);
    c.that("the same query gives identical paths", same);
    c.that("the sample had many paths and some walled-off pairs", found > 80 && missing > 3);

    let open : GridMap = new GridMap(10, 10);
    let big : NavMesh = NavMeshGrid::build(open, 1.0);
    c.sameInt("an open room is one polygon", big.polygonCount() as i64, 1);
    let line : NavPath = big.findPath(0.5, 0.5, 9.5, 9.5);
    c.that("and the path across it is one straight segment", line.len() == 2);
    let mut walled : GridMap = new GridMap(10, 10);
    for (y of 0..10) {
        walled.setBlocked(5, y, true);
    }
    c.that(
        "a wall cutting the room in two: no path",
        !NavMeshGrid::build(walled, 1.0).findPath(1.5, 1.5, 8.5, 1.5).found()
    );
    walled.setBlocked(5, 4, false);
    let gap : NavPath = NavMeshGrid::build(walled, 1.0).findPath(1.5, 1.5, 8.5, 1.5);
    c.that("with a door it is found and passes through the door cell", gap.found());
    let mut viaDoor : bool = false;
    for (i of 0..gap.len()) {
        if (gap.xAt(i) >= 4.999 && gap.xAt(i) <= 6.001 && gap.yAt(i) >= 3.999
            && gap.yAt(i) <= 5.001) {
            viaDoor = true;
        }
    }
    c.that("a corner of the path sits at the door", viaDoor);
}

/** The navigation mesh suite. */
pub class NavMeshSuite {
    /** Runs the navigation mesh checks. */
    pub static fn run(c : Checks) : void {
        navMeshTestBuild(c);
        navMeshTestLocate(c);
        navMeshTestFunnel(c);
        navMeshTestPortals(c);
        navMeshTestFromGrid(c);
    }
}

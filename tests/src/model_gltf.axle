// model_gltf — checks for the glTF importer's geometry, nodes and accessors.
//
// The importer is checked against documents built in the test: small glTF files, and one buffer produced by an
// outside tool. Numbers read back are compared exactly where they can be exact. Skins and animation are in
// `model_gltf_anim`; containers, files and damage are in `model_gltf_files`.

use ludax::ByteBuf;
use ludax::Checks;
use ludax::Mat4;
use ludax::Mesh;
use ludax::ModelAsset;
use ludax::ModelMaterial;
use ludax::ModelNode;
use ludax::Vec3;

use crate::model_support::{
    MDL_TOL, MDL_TOL_COARSE, MDL_TOL_LOOSE, MDL_TOL_NORM, mdlDoc, mdlImport, mdlJson, mdlNear,
    mdlTriBuffer, mdlVec3s
};

/** The glTF geometry and structure checks. */
pub class ModelGltfSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        mdlTriangleChecks(c);
        mdlNodeChecks(c);
        mdlAccessorChecks(c);
        mdlPrimitiveModeChecks(c);
    }
}

// The 44-byte buffer of an outside tool: three u16 indices, two bytes of padding, three float positions.
fn mdlOutsideUri() : string {
    return "data:application/octet-stream;base64,AAABAAIAAAAAAAAAAAAAAAAAAAAAAIA/AAAAAAAAAAAAAAAAAACAPwAAAAA=";
}

fn mdlTriangleChecks(c : Checks) : void {
    let text : string = mdlJson("{'asset':{'version':'2.0','generator':'outside'},'scene':0,'scenes':[{'nodes':[0]}],'nodes':[{'mesh':0,'name':'tri','translation':[1,2,3],'rotation':[0,0,0.70710678,0.70710678],'scale':[2,2,2]}],'meshes':[{'name':'m','primitives':[{'attributes':{'POSITION':1},'indices':0,'material':0}]}],'materials':[{'name':'red','pbrMetallicRoughness':{'baseColorFactor':[0.5,0.25,0.125,1.0],'metallicFactor':0.25,'roughnessFactor':0.5},'emissiveFactor':[0.125,0.25,0.5]}],'buffers':[{'byteLength':44,'uri':'"
        + mdlOutsideUri()
        + "'}],'bufferViews':[{'buffer':0,'byteOffset':0,'byteLength':6,'target':34963},{'buffer':0,'byteOffset':8,'byteLength':36,'target':34962}],'accessors':[{'bufferView':0,'componentType':5123,'count':3,'type':'SCALAR'},{'bufferView':1,'componentType':5126,'count':3,'type':'VEC3'}]}");
    let m : ModelAsset = mdlImport(text);
    c.that("gltf: the triangle imports (${m.error()})", m.ok() && m.error() == "");
    c.that(
        "gltf: counts",
        m.meshCount() == 1 && m.nodeCount() == 1 && m.materialCount() == 1 && m.skinCount() == 0
            && m.clipCount() == 0
            && m.rootCount() == 1
            && m.root(0) == 0
    );
    c.that(
        "gltf: names",
        m.mesh(0).name == "m" && m.node(0).name == "tri" && m.material(0).name == "red"
            && m.name == "outside"
    );
    let mesh : Mesh = m.mesh(0).primitive(0);
    c.that(
        "gltf: one primitive of three vertices and a triangle",
        m.mesh(0).primitiveCount() == 1 && mesh.vertexCount() == 3 && mesh.triangleCount() == 1
            && mesh.check() == ""
    );
    c.that(
        "gltf: positions are exact",
        mesh.position(0).x == 0.0 && mesh.position(1).x == 1.0 && mesh.position(1).y == 0.0
            && mesh.position(2).y == 1.0
            && mesh.position(2).z == 0.0
    );
    c.that(
        "gltf: the triangle's indices read back as 0, 1, 2",
        mesh.index(0) == 0 && mesh.index(1) == 1 && mesh.index(2) == 2
    );
    c.that(
        "gltf: missing normals are computed",
        mesh.hasNormals() && mesh.normal(0).z == 1.0 && !mesh.hasUvs() && !mesh.hasSkin()
    );
    c.sameInt("gltf: the primitive uses material 0", m.mesh(0).material(0), 0);
    let mat : ModelMaterial = m.material(0);
    c.that(
        "gltf: base colour factor",
        mat.baseColor.x == 0.5 && mat.baseColor.y == 0.25 && mat.baseColor.z == 0.125
            && mat.baseColor.w == 1.0
    );
    c.that(
        "gltf: the material's metallic and roughness factors are 0.25 and 0.5",
        mat.metallic == 0.25 && mat.roughness == 0.5
    );
    c.that(
        "gltf: emissive",
        mat.emissive.x == 0.125 && mat.emissive.y == 0.25 && mat.emissive.z == 0.5
            && mat.baseColorTexture == -1
    );
    let node : ModelNode = m.node(0);
    c.that(
        "gltf: translation and scale",
        node.local.translation.x == 1.0 && node.local.translation.y == 2.0
            && node.local.translation.z == 3.0
            && node.local.scale.x == 2.0
            && !node.hasMatrix
    );
    mdlNear(c, "gltf: rotation z", node.local.rotation.z, 0.70710678, MDL_TOL);
    mdlNear(c, "gltf: rotation w", node.local.rotation.w, 0.70710678, MDL_TOL);
    c.that(
        "gltf: a clean file has no warnings and no external files",
        m.warnings() == "" && m.externalFiles() == ""
    );
    // Defaults of a material: white, fully metallic and rough.
    let plain : ModelMaterial = new ModelMaterial("p");
    c.that(
        "gltf: material defaults are the glTF ones",
        plain.baseColor.x == 1.0 && plain.metallic == 1.0 && plain.roughness == 1.0
            && plain.emissive.x == 0.0
    );
    // A default scene is chosen when the file names none, and unnamed things have empty names.
    let bare : ModelAsset = mdlImport(mdlDoc(
        mdlTriBuffer(),
        "'bufferViews':[{'buffer':0,'byteLength':36}],'accessors':[{'bufferView':0,'componentType':5126,'count':3,'type':'VEC3'}],'meshes':[{'primitives':[{'attributes':{'POSITION':0}}]}],'nodes':[{'mesh':0},{'mesh':0}]"
    ));
    c.that(
        "gltf: without scenes every parentless node is a root",
        bare.ok() && bare.rootCount() == 2 && bare.mesh(0).material(0) == -1
            && bare.mesh(0).name == ""
    );
}

fn mdlNodeChecks(c : Checks) : void {
    let buf : ByteBuf = mdlTriBuffer();
    let head : string = "'bufferViews':[{'buffer':0,'byteLength':36}],'accessors':[{'bufferView':0,'componentType':5126,'count':3,'type':'VEC3'}],'meshes':[{'primitives':[{'attributes':{'POSITION':0}}]}],";
    // The child is listed before its parent.
    let tree : ModelAsset = mdlImport(mdlDoc(
        buf,
        head
            + "'nodes':[{'name':'leaf','mesh':0,'translation':[0,0,1]},{'name':'mid','children':[0],'translation':[0,2,0]},{'name':'top','children':[1],'translation':[3,0,0]}],'scenes':[{'nodes':[2]}]"
    ));
    c.that(
        "gltf: a tree imports",
        tree.ok() && tree.nodeCount() == 3 && tree.rootCount() == 1 && tree.root(0) == 2
    );
    c.that(
        "gltf: parents and children",
        tree.node(0).parent == 1 && tree.node(1).parent == 2 && tree.node(2).parent == -1
            && tree.node(2).children.len() == 1
            && tree.node(2).children.get(0) == 1
    );
    let w : Mat4 = tree.worldMatrix(0);
    c.that(
        "gltf: the world matrix multiplies up the tree",
        w.m03 == 3.0 && w.m13 == 2.0 && w.m23 == 1.0
    );
    // A matrix node: translation plus a 90 degree turn about Z and a scale of 2 (column-major).
    let mat : ModelAsset = mdlImport(mdlDoc(
        buf,
        head + "'nodes':[{'mesh':0,'matrix':[0,2,0,0, -2,0,0,0, 0,0,2,0, 5,6,7,1]}]"
    ));
    c.that(
        "gltf: a node given as a matrix imports as a matrix node",
        mat.ok() && mat.node(0).hasMatrix
    );
    c.that(
        "gltf: the matrix is kept column-major",
        mat.node(0).matrix.m10 == 2.0 && mat.node(0).matrix.m01 == -2.0
            && mat.node(0).matrix.m03 == 5.0
    );
    let n : ModelNode = mat.node(0);
    c.that(
        "gltf: it is decomposed into translation",
        n.local.translation.x == 5.0 && n.local.translation.y == 6.0 && n.local.translation.z == 7.0
    );
    mdlNear(c, "gltf: and scale", n.local.scale.x, 2.0, MDL_TOL_LOOSE);
    mdlNear(c, "gltf: and scale z", n.local.scale.z, 2.0, MDL_TOL_LOOSE);
    mdlNear(c, "gltf: and a quarter turn about Z", n.local.rotation.z, 0.70710678, MDL_TOL_LOOSE);
    let moved : Vec3 = n.local.transformPoint(Vec3 { x: 1.0, y: 0.0, z: 0.0 });
    mdlNear(
        c,
        "gltf: the decomposition maps (1,0,0) like the matrix does (x)",
        moved.x,
        5.0,
        MDL_TOL_COARSE
    );
    mdlNear(c, "gltf: (y)", moved.y, 8.0, MDL_TOL_COARSE);
    // Unnormalised and zero quaternions.
    let q : ModelAsset = mdlImport(mdlDoc(
        buf,
        head + "'nodes':[{'rotation':[0,0,0,4]},{'rotation':[0,0,0,0]}]"
    ));
    c.that(
        "gltf: rotations are normalised and a zero one becomes the identity",
        q.ok() && q.node(0).local.rotation.w == 1.0 && q.node(1).local.rotation.w == 1.0
    );
}

fn mdlAccessorChecks(c : Checks) : void {
    // Interleaved positions and normals, stride 24; normalised signed 16-bit texture coordinates after them.
    let b : ByteBuf = new ByteBuf(64);
    mdlVec3s(b, Vec3::make(0.0, 0.0, 0.0), Vec3::make(0.0, 0.0, 1.0), Vec3::make(1.0, 0.0, 0.0));
    mdlVec3s(b, Vec3::make(0.0, 0.0, 1.0), Vec3::make(0.0, 1.0, 0.0), Vec3::make(0.0, 0.0, 1.0));
    // 36 + 36 = 72 bytes of vertex data; then six 16-bit values.
    b.push(0x00);
    b.push(0x80);
    b.push(0xFF);
    b.push(0x7F);
    b.push(0x00);
    b.push(0x00);
    b.push(0x00);
    b.push(0x00);
    b.push(0x00);
    b.push(0x40);
    b.push(0x00);
    b.push(0xC0);
    let doc : string = "'bufferViews':[{'buffer':0,'byteOffset':0,'byteLength':72,'byteStride':24},{'buffer':0,'byteOffset':72,'byteLength':12}],'accessors':[{'bufferView':0,'componentType':5126,'count':3,'type':'VEC3'},{'bufferView':0,'byteOffset':12,'componentType':5126,'count':3,'type':'VEC3'},{'bufferView':1,'componentType':5122,'normalized':true,'count':3,'type':'VEC2'}],'meshes':[{'primitives':[{'attributes':{'POSITION':0,'NORMAL':1,'TEXCOORD_0':2}}]}],'nodes':[{'mesh':0}]";
    let m : ModelAsset = mdlImport(mdlDoc(b, doc));
    c.that("gltf: strided accessors import (${m.error()})", m.ok());
    let mesh : Mesh = m.mesh(0).primitive(0);
    c.that(
        "gltf: strided positions",
        mesh.position(0).x == 0.0 && mesh.position(1).x == 1.0 && mesh.position(2).y == 1.0
            && mesh.position(2).z == 0.0
    );
    c.that(
        "gltf: strided normals follow the offset",
        mesh.normal(0).z == 1.0 && mesh.normal(1).x == 0.0 && mesh.normal(1).y == 0.0
            && mesh.normal(2).z == 1.0
            && mesh.normal(2).y == 0.0
    );
    c.that(
        "gltf: a normalised signed 16-bit value of -32768 is -1 (clamped)",
        mesh.uv(0).x == -1.0 && mesh.uv(0).y == 1.0
    );
    mdlNear(c, "gltf: a normalised value of 16384", mesh.uv(2).x, 16384.0 / 32767.0, MDL_TOL_NORM);
    mdlNear(
        c,
        "gltf: a normalised value of -16384",
        mesh.uv(2).y,
        -16384.0 / 32767.0,
        MDL_TOL_NORM
    );
    c.that("gltf: a UV of zero stays zero", mesh.uv(1).x == 0.0 && mesh.uv(1).y == 0.0);
    // Unsigned 8-bit normalised, unsigned 32-bit indices.
    let b2 : ByteBuf = new ByteBuf(64);
    mdlVec3s(b2, Vec3::make(0.0, 0.0, 0.0), Vec3::make(1.0, 0.0, 0.0), Vec3::make(0.0, 1.0, 0.0));
    b2.push(0);
    b2.push(255);
    b2.push(51);
    b2.push(0);
    b2.push(255);
    b2.push(0);
    b2.push(0);
    b2.push(0);
    b2.pushLe32(2);
    b2.pushLe32(1);
    b2.pushLe32(0);
    let doc2 : string = "'bufferViews':[{'buffer':0,'byteLength':36},{'buffer':0,'byteOffset':36,'byteLength':6},{'buffer':0,'byteOffset':44,'byteLength':12}],'accessors':[{'bufferView':0,'componentType':5126,'count':3,'type':'VEC3'},{'bufferView':1,'componentType':5121,'normalized':true,'count':3,'type':'VEC2'},{'bufferView':2,'componentType':5125,'count':3,'type':'SCALAR'}],'meshes':[{'primitives':[{'attributes':{'POSITION':0,'TEXCOORD_0':1},'indices':2}]}],'nodes':[{'mesh':0}]";
    let m2 : ModelAsset = mdlImport(mdlDoc(b2, doc2));
    c.that("gltf: u8 and u32 accessors import (${m2.error()})", m2.ok());
    let mesh2 : Mesh = m2.mesh(0).primitive(0);
    mdlNear(c, "gltf: a normalised u8 of 51 is 0.2", mesh2.uv(1).x, 0.2, MDL_TOL_NORM);
    c.that(
        "gltf: and 255 is 1",
        mesh2.uv(0).y == 1.0 && mesh2.uv(0).x == 0.0 && mesh2.uv(1).y == 0.0 && mesh2.uv(2).x == 1.0
    );
    c.that(
        "gltf: 32-bit indices read back as 2, 1, 0",
        mesh2.index(0) == 2 && mesh2.index(1) == 1 && mesh2.index(2) == 0
    );
}

fn mdlPrimitiveModeChecks(c : Checks) : void {
    let b : ByteBuf = new ByteBuf(64);
    mdlVec3s(b, Vec3::make(0.0, 0.0, 0.0), Vec3::make(1.0, 0.0, 0.0), Vec3::make(0.0, 1.0, 0.0));
    mdlVec3s(b, Vec3::make(1.0, 1.0, 0.0), Vec3::make(0.0, 0.0, 0.0), Vec3::make(0.0, 0.0, 0.0));
    let head : string = "'bufferViews':[{'buffer':0,'byteLength':72}],'accessors':[{'bufferView':0,'componentType':5126,'count':4,'type':'VEC3'}],'nodes':[{'mesh':0}],'meshes':[{'primitives':[{'attributes':{'POSITION':0},'mode':";
    let strip : ModelAsset = mdlImport(mdlDoc(b, head + "5}]}]"));
    c.that(
        "gltf: a triangle strip imports",
        strip.ok() && strip.mesh(0).primitive(0).triangleCount() == 2
    );
    let s : Mesh = strip.mesh(0).primitive(0);
    c.that(
        "gltf: strip triangles alternate their winding",
        s.index(0) == 0 && s.index(1) == 1 && s.index(2) == 2 && s.index(3) == 2 && s.index(4) == 1
            && s.index(5) == 3
    );
    let fan : ModelAsset = mdlImport(mdlDoc(b, head + "6}]}]"));
    let f : Mesh = fan.mesh(0).primitive(0);
    c.that(
        "gltf: a triangle fan imports",
        fan.ok() && f.triangleCount() == 2 && f.index(0) == 0 && f.index(1) == 1 && f.index(2) == 2
            && f.index(3) == 0
            && f.index(4) == 2
            && f.index(5) == 3
    );
    let points : ModelAsset = mdlImport(mdlDoc(b, head + "0}]}]"));
    c.that(
        "gltf: a point primitive is skipped with a warning",
        points.ok() && points.mesh(0).primitiveCount() == 0 && points.warnings().byteLength > 0
    );
    let tris : ModelAsset = mdlImport(mdlDoc(b, head + "4}]}]"));
    c.that("gltf: four vertices are not whole triangles", !tris.ok());
}

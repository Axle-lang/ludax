// math_support — shared assertions for the maths suites.
//
// The maths suites state one property per call, and a failure is only useful if it shows the value that came
// back, so these helpers build the message while the suite stays a list of assertions. They are package-level
// functions with an area prefix because the suites live in separate files.

use ludax::{Checks, Vec2, Vec3, Vec4, Mat3, Mat4, Quat};

/** The text of a vector, for failure messages. */
pub fn text3(v : Vec3) : string {
    return "(${v.x}, ${v.y}, ${v.z})";
}

/** States that two 2D vectors agree to within `tol` per component. */
pub fn nearVec2(c : Checks, name : string, got : Vec2, want : Vec2, tol : f32) : void {
    let text : string = "${name} (got ${got.x}, ${got.y}; want ${want.x}, ${want.y})";
    c.that(text, got.approxEq(want, tol));
}

/** States that two 3D vectors agree to within `tol` per component. */
pub fn nearVec3(c : Checks, name : string, got : Vec3, want : Vec3, tol : f32) : void {
    c.that("${name} (got ${text3(got)}, want ${text3(want)})", got.approxEq(want, tol));
}

/** States that two 4D vectors agree to within `tol` per component. */
pub fn nearVec4(c : Checks, name : string, got : Vec4, want : Vec4, tol : f32) : void {
    c.that(name, got.approxEq(want, tol));
}

/** States that two 3x3 matrices agree to within `tol` per field. */
pub fn nearMat3(c : Checks, name : string, got : Mat3, want : Mat3, tol : f32) : void {
    c.that(name, got.approxEq(want, tol));
}

/** States that two 4x4 matrices agree to within `tol` per field. */
pub fn nearMat4(c : Checks, name : string, got : Mat4, want : Mat4, tol : f32) : void {
    c.that(name, got.approxEq(want, tol));
}

/** States that two quaternions are the same rotation. */
pub fn sameQuat(c : Checks, name : string, got : Quat, want : Quat, tol : f32) : void {
    c.that(
        "${name} (got ${got.x}, ${got.y}, ${got.z}, ${got.w})",
        got.sameRotation(want, tol)
    );
}

/** States that two f32 numbers agree to within `tol`. */
pub fn nearF(c : Checks, name : string, got : f32, want : f32, tol : f32) : void {
    c.near(name, got as f64, want as f64, tol as f64);
}

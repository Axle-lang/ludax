// regress_noise — golden fingerprints of the noises and fields: the lattice hashes, value noise with its gradient, the
// field tape through every op at several footprints and clocks, and the path-lit picture's noises and cloud cover.
//
// Each fingerprint folds the exact bits of thousands of outputs from fixed inputs; a change of one bit anywhere
// changes it. A fingerprint that moves after an optimisation means the optimisation changed a result: find which
// input moved before updating the constant (its name is in the check).

use ludax::{
    Checks, LuxField, LuxFieldTape, LuxNoise, Pcg32, luxFieldGradU, luxFieldGradV, luxFieldValue
};
use ludax::{lnFbm2, lnFloor, lnHash, lnUnit, lnValue2, lumenCloudCover, lumenCloudCoverOver};
use ludax::{luxNoise2, luxNoiseCorner, luxNoiseFloor};

use crate::regress_support::RegressHash;

const RGN_CORNER : i64 = -5439211323028847308;
const RGN_NOISE2 : i64 = -5752386951743640166;
const RGN_CORNER_00 : i64 = 1063395496;
const RGN_NOISE2_AT : i64 = 1053002043;
const RGN_TAPE : i64 = -5257017923607520530;
const RGN_TAPE_LIP : i64 = 8481189130761956097;
const RGN_TAPE_AT : i64 = 1051103224;
const RGN_LNHASH : i64 = -4594812130247862057;
const RGN_LNFLOOR : i64 = 59020347429367455;
const RGN_LNVALUE : i64 = -7996240835194610879;
const RGN_LNFBM : i64 = -3588285340711713403;
const RGN_CLOUD : i64 = -1358605205758232922;
const RGN_CLOUD_OVER : i64 = 4715849106186853163;
const RGN_LNHASH_AT : i64 = 8288347;
const RGN_LNFBM_AT : i64 = 1057043288;

/** Golden fingerprints of `core/field` and of `render/pathlight/pathlight_noise`. */
pub class RegressNoiseSuite {
    /** Runs every check of the suite. */
    pub static fn run(mut c : Checks) : void {
        rgnCore(c);
        rgnTape(c);
        rgnPath(c);
    }
}

// The lattice corners and one octave of value noise with its exact gradient.
fn rgnCore(mut c : Checks) : void {
    let corners : RegressHash = new RegressHash();
    for (s of 0..4) {
        let seed : i32 = s == 3 ? -5 : s * 977;
        for (y of -40..40) {
            for (x of -40..40) {
                corners.real(luxNoiseCorner(x * 37, y * 11, seed));
            }
        }
    }
    c.sameInt(
        "regress noise: luxNoiseCorner over a lattice [RGN_CORNER]",
        corners.value(),
        RGN_CORNER
    );

    let rng : Pcg32 = new Pcg32(2026, 1);
    let out : f32[] = new f32[3];
    let noise : RegressHash = new RegressHash();
    for (k of 0..3000) {
        let u : f32 = rng.rangeF32(-300.0, 300.0);
        let v : f32 = k % 7 == 0 ? (lnFloor(u) as f32) : rng.rangeF32(-300.0, 300.0);
        luxNoise2(u, v, k % 5, out, 0);
        noise.real(out[0]);
        noise.real(out[1]);
        noise.real(out[2]);
        noise.int(luxNoiseFloor(v) as i64);
    }
    c.sameInt(
        "regress noise: luxNoise2 value and gradient [RGN_NOISE2]",
        noise.value(),
        RGN_NOISE2
    );

    c.sameInt(
        "regress noise: luxNoiseCorner(0, 0, 0) bits [RGN_CORNER_00]",
        RegressHash::bits(luxNoiseCorner(0, 0, 0)),
        RGN_CORNER_00
    );
    luxNoise2(0.25, 0.75, 3, out, 0);
    c.sameInt(
        "regress noise: luxNoise2(0.25, 0.75, 3) value bits [RGN_NOISE2_AT]",
        RegressHash::bits(out[0]),
        RGN_NOISE2_AT
    );
}

// The nodes 0 up to `n`, in order.
fn rgnAll(n : i32) : i32[] {
    let mut all : i32[] = new i32[n as i64];
    for (i of 0..n) {
        all[i] = i;
    }
    return all;
}

// A field through every op of the tape: scroll, scale, warp, pixelate, fbm, constant, add, mul, remap.
fn rgnFields(mut t : LuxFieldTape, mut values : LuxField[]) : void {
    let here : LuxField = t.here();
    let a : LuxField = t.fbm(t.scroll(here, 0.35, -0.2), LuxNoise {
        freq: 0.8,
        octaves: 3,
        gain: 0.55,
        seed: 11,
    });
    let b : LuxField = t.fbm(t.scroll(here, -0.25, 0.4), LuxNoise {
        freq: 1.1,
        octaves: 2,
        gain: 0.5,
        seed: 12,
    });
    let warped : LuxField = t.warp(t.scale(here, 2.5), a, b, 0.7);
    let blocky : LuxField = t.fbm(t.pixelate(t.scale(here, 0.5), 8.0), LuxNoise {
        freq: 1.5,
        octaves: 2,
        gain: 0.5,
        seed: 13,
    });
    let swirl : LuxField = t.fbm(warped, LuxNoise { freq: 1.3, octaves: 4, gain: 0.5, seed: 14 });
    let sum : LuxField = t.add(swirl, blocky);
    let part : LuxField = t.mul(a, t.constant(0.75));
    let both : LuxField = t.mul(sum, part);
    values[0] = a;
    values[1] = b;
    values[2] = blocky;
    values[3] = swirl;
    values[4] = sum;
    values[5] = part;
    values[6] = both;
    values[7] = t.remap(both, -0.5, 2.0);
    values[8] = t.remap(blocky, 0.2, 0.9);
}

// The tape's values and gradients at 250 points, four footprints and four clocks (one of them past 277 hours).
fn rgnTape(mut c : Checks) : void {
    let t : LuxFieldTape = new LuxFieldTape();
    let values : LuxField[] = new LuxField[9];
    rgnFields(t, values);
    let all : i32[] = rgnAll(t.count());
    let r : f32[] = t.registers();
    let h : RegressHash = new RegressHash();
    for (ti of 0..4) {
        let seconds : f64 = match ti {
            0 => 0.0,
            1 => 1.5,
            2 => 1000.25,
            _ => 1000000.3,
        };
        t.prepare(seconds);
        for (fi of 0..4) {
            let fp : f32 = match fi {
                0 => 0.0 as f32,
                1 => 0.01 as f32,
                2 => 0.2 as f32,
                _ => 3.0 as f32,
            };
            let rng : Pcg32 = new Pcg32(77, (ti * 4 + fi) as u64);
            for (k of 0..250) {
                let u : f32 = rng.rangeF32(-20.0, 20.0);
                let v : f32 = rng.rangeF32(-20.0, 20.0);
                t.evaluate(all, 0, t.count(), u, v, fp, r);
                for (q of 0..9) {
                    h.real(luxFieldValue(r, values[q]));
                    h.real(luxFieldGradU(r, values[q]));
                    h.real(luxFieldGradV(r, values[q]));
                }
            }
        }
    }
    c.sameInt(
        "regress noise: the tape through every op, footprints and clocks [RGN_TAPE]",
        h.value(),
        RGN_TAPE
    );

    let lips : RegressHash = new RegressHash();
    lips.int(t.count() as i64);
    for (q of 0..9) {
        lips.real(t.lipOf(values[q]));
    }
    c.sameInt(
        "regress noise: the tape's Lipschitz bounds [RGN_TAPE_LIP]",
        lips.value(),
        RGN_TAPE_LIP
    );
    c.that("regress noise: the composed tape is sound", t.valid());

    t.prepare(0.0);
    t.evaluate(all, 0, t.count(), 0.5, 0.5, 0.0, r);
    c.sameInt(
        "regress noise: the remapped product at (0.5, 0.5) bits [RGN_TAPE_AT]",
        RegressHash::bits(luxFieldValue(r, values[7])),
        RGN_TAPE_AT
    );
}

// The path-lit picture's noises: the 3D lattice hash, the floor, value noise, octaves, and the cloud deck's cover.
fn rgnPath(mut c : Checks) : void {
    let hashes : RegressHash = new RegressHash();
    for (z of -20..21) {
        for (y of -4..5) {
            for (x of -20..21) {
                hashes.int(lnHash(x * 13, y, z * 7, 3) as i64);
            }
        }
    }
    let rng : Pcg32 = new Pcg32(9, 4);
    for (k of 0..1000) {
        hashes.real(lnUnit(rng.range(-100000, 100000), k, -k, k % 3));
    }
    c.sameInt("regress noise: lnHash and lnUnit [RGN_LNHASH]", hashes.value(), RGN_LNHASH);

    let floors : RegressHash = new RegressHash();
    for (k of 0..1000) {
        let v : f32 = rng.rangeF32(-50.0, 50.0);
        floors.int(lnFloor(v) as i64);
        floors.int(lnFloor(lnFloor(v) as f32) as i64);
    }
    c.sameInt("regress noise: lnFloor [RGN_LNFLOOR]", floors.value(), RGN_LNFLOOR);

    let values : RegressHash = new RegressHash();
    for (k of 0..3000) {
        values.real(lnValue2(rng.rangeF32(-500.0, 500.0), rng.rangeF32(-500.0, 500.0), k % 4));
    }
    c.sameInt("regress noise: lnValue2 [RGN_LNVALUE]", values.value(), RGN_LNVALUE);

    let fbm : RegressHash = new RegressHash();
    for (octaves of 1..7) {
        for (k of 0..400) {
            fbm.real(lnFbm2(
                rng.rangeF32(-200.0, 200.0),
                rng.rangeF32(-200.0, 200.0),
                octaves,
                21 + k % 3
            ));
        }
    }
    c.sameInt("regress noise: lnFbm2 at one to six octaves [RGN_LNFBM]", fbm.value(), RGN_LNFBM);

    let cloud : RegressHash = new RegressHash();
    for (k of 0..1500) {
        let t : f32 = (k % 10) as f32 * (37.5 as f32);
        cloud.real(lumenCloudCover(
            rng.rangeF32(-3000.0, 3000.0),
            rng.rangeF32(-3000.0, 3000.0),
            t
        ));
    }
    c.sameInt("regress noise: lumenCloudCover [RGN_CLOUD]", cloud.value(), RGN_CLOUD);

    // The soft octaves (`lnFbm2Soft`) behind the cover seen with a footprint, from none to one wider than every octave.
    let over : RegressHash = new RegressHash();
    for (a of 0..6) {
        let across : f32 = match a {
            0 => 0.0 as f32,
            1 => 0.5 as f32,
            2 => 5.0 as f32,
            3 => 40.0 as f32,
            4 => 160.0 as f32,
            _ => 2000.0 as f32,
        };
        for (k of 0..300) {
            over.real(lumenCloudCoverOver(
                rng.rangeF32(-3000.0, 3000.0),
                rng.rangeF32(-3000.0, 3000.0),
                12.5,
                across
            ));
        }
    }
    c.sameInt(
        "regress noise: lumenCloudCoverOver (lnFbm2Soft) at six footprints [RGN_CLOUD_OVER]",
        over.value(),
        RGN_CLOUD_OVER
    );

    c.sameInt(
        "regress noise: lnHash(1, 2, 3, 4) [RGN_LNHASH_AT]",
        lnHash(1, 2, 3, 4) as i64,
        RGN_LNHASH_AT
    );
    c.sameInt(
        "regress noise: lnFbm2(10.3, -4.7, 5, 21) bits [RGN_LNFBM_AT]",
        RegressHash::bits(lnFbm2(10.3, -4.7, 5, 21)),
        RGN_LNFBM_AT
    );
}

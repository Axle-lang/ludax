// anim_solve — inverse kinematics, look-at and CPU skinning, against hand-computed numbers.
//
// The IK checks use the same three-bone chain as the skeleton suite, plus a four-bone straight chain for
// FABRIK, so a reach, a stretch, a pole direction and a length preservation each have an answer that can be
// verified without a reference solver. Skinning is checked on one vertex per weight case — one bone, two
// bones, unnormalised weights, no weight — because the blend and normalise rules are what a mesh relies on.

use ludax::{
    Checks, Vec3, Quat, Transform, Skeleton, Pose, IkResult, IkLimb, IkPole, TwoBoneIk, FabrikChain,
    LookAt, Skinning, HALF_PI
};

use crate::anim_skeleton::animChainSkeleton;
use crate::math_support::{MATH_TOL, MATH_TOL_LOOSE, nearVec3, nearF};

/** Bones of the straight FABRIK chain: the root and four links of length one. */
const ANIM_SOLVE_CHAIN_BONES : i32 = 5;

/** How close the end effector must come for FABRIK to report the target reached. */
const ANIM_SOLVE_REACH_TOL : f32 = 0.001;

/** The most rounds FABRIK may take in the checks; a reachable target needs far fewer. */
const ANIM_SOLVE_ROUNDS : i32 = 64;

// Solves the three-bone limb 0, 1, 2 towards `target` with no pole; answers whether it was reachable.
fn animSolveLimb(pose : Pose, s : Skeleton, target : Vec3) : bool {
    return TwoBoneIk::solve(pose, s, IkLimb::make(0, 1, 2), target, IkPole::none());
}

// Solves the same limb with the knee steered towards `pole`.
fn animSolveLimbPole(pose : Pose, s : Skeleton, target : Vec3, pole : Vec3) : bool {
    return TwoBoneIk::solve(pose, s, IkLimb::make(0, 1, 2), target, IkPole::towards(pole));
}

// Solves the straight chain towards `target` with the checks' tolerance and round limit.
fn animSolveFabrik(pose : Pose, s : Skeleton, chain : i32[], target : Vec3) : IkResult {
    return FabrikChain::solve(
        pose,
        s,
        chain,
        ANIM_SOLVE_CHAIN_BONES,
        target,
        ANIM_SOLVE_REACH_TOL,
        ANIM_SOLVE_ROUNDS
    );
}

// Turns bone 2, whose forward axis is +Z, to face `target` by `weight` of the way, at most `limit` radians.
fn animSolveLook(pose : Pose, s : Skeleton, target : Vec3, weight : f32, limit : f32) : f32 {
    return LookAt::apply(pose, s, 2, target, Vec3::unitZ(), weight, limit);
}

// The three floats of `buf` that start at vertex `v`, as a vector.
fn animSolveVertex(buf : f32[], v : i32) : Vec3 {
    return Vec3::make(buf[v * 3], buf[v * 3 + 1], buf[v * 3 + 2]);
}

fn animSolveTip(pose : Pose, s : Skeleton, bone : i32) : Vec3 {
    return pose.modelTransform(s, bone).translation;
}

fn animSolveTestTwoBone(c : Checks) : void {
    let s : Skeleton = animChainSkeleton();
    let pose : Pose = Pose::bindOf(s);
    let ok : bool = animSolveLimb(pose, s, Vec3::make(1.0, 1.0, 0.0));
    c.that("a reachable target is reported reachable", ok);
    nearVec3(
        c,
        "the tip reaches (1, 1, 0)",
        animSolveTip(pose, s, 2),
        Vec3::make(1.0, 1.0, 0.0),
        MATH_TOL_LOOSE
    );
    nearF(
        c,
        "the upper bone keeps its length",
        animSolveTip(pose, s, 1).length(),
        1.0,
        MATH_TOL_LOOSE
    );
    nearF(
        c,
        "the lower bone keeps its length",
        animSolveTip(pose, s, 2).distance(animSolveTip(pose, s, 1)),
        1.0,
        MATH_TOL_LOOSE
    );

    pose.resetToBind(s);
    animSolveLimb(pose, s, Vec3::make(0.5, 0.5, 1.2));
    nearVec3(
        c,
        "a target out of the plane is reached too",
        animSolveTip(pose, s, 2),
        Vec3::make(0.5, 0.5, 1.2),
        MATH_TOL_LOOSE
    );

    pose.resetToBind(s);
    let far : bool = animSolveLimb(pose, s, Vec3::make(0.0, 5.0, 0.0));
    c.that("an unreachable target is reported", !far);
    nearVec3(
        c,
        "full extension straight at a far target",
        animSolveTip(pose, s, 2),
        Vec3::make(0.0, 2.0, 0.0),
        MATH_TOL_LOOSE
    );
    pose.resetToBind(s);
    animSolveLimb(pose, s, Vec3::make(3.0, 4.0, 0.0));
    nearVec3(
        c,
        "the limb stretches along the direction of an unreachable target",
        animSolveTip(pose, s, 2),
        Vec3::make(1.2, 1.6, 0.0),
        MATH_TOL_LOOSE
    );
    nearF(
        c,
        "and is exactly as long as the limb",
        animSolveTip(pose, s, 2).length(),
        2.0,
        MATH_TOL_LOOSE
    );

    // The pole decides which way the knee points.
    pose.resetToBind(s);
    animSolveLimbPole(pose, s, Vec3::make(1.5, 0.0, 0.0), Vec3::make(0.0, 0.0, 5.0));
    nearVec3(
        c,
        "the tip still reaches",
        animSolveTip(pose, s, 2),
        Vec3::make(1.5, 0.0, 0.0),
        MATH_TOL_LOOSE
    );
    c.that("the knee points towards +Z", animSolveTip(pose, s, 1).z > 0.3);
    nearF(c, "and not sideways", animSolveTip(pose, s, 1).y, 0.0, MATH_TOL_LOOSE);
    pose.resetToBind(s);
    animSolveLimbPole(pose, s, Vec3::make(1.5, 0.0, 0.0), Vec3::make(0.0, 0.0, -5.0));
    c.that("with the pole at -Z the knee points towards -Z", animSolveTip(pose, s, 1).z < -0.3);
    nearVec3(
        c,
        "the tip reaches that way too",
        animSolveTip(pose, s, 2),
        Vec3::make(1.5, 0.0, 0.0),
        MATH_TOL_LOOSE
    );

    // A limb under a moved and turned parent, and a bent starting pose.
    let t : Skeleton = new Skeleton(8);
    t.addBone(
        "base",
        -1,
        Transform::make(
            Vec3::make(5.0, 0.0, 0.0),
            Quat::fromAxisAngle(Vec3::unitY(), 0.5),
            Vec3::make(1.0, 1.0, 1.0)
        )
    );
    t.addBone("root", 0, Transform::identity());
    t.addBone("mid", 1, Transform::fromTranslation(Vec3::make(0.0, 1.0, 0.0)));
    t.addBone("tip", 2, Transform::fromTranslation(Vec3::make(0.0, 1.0, 0.0)));
    let p2 : Pose = Pose::bindOf(t);
    p2.setRotation(2, Quat::fromAxisAngle(Vec3::unitX(), 1.0));
    TwoBoneIk::solve(p2, t, IkLimb::make(1, 2, 3), Vec3::make(5.5, 1.0, 0.5), IkPole::none());
    nearVec3(
        c,
        "under a rotated parent the tip reaches the model-space target",
        animSolveTip(p2, t, 3),
        Vec3::make(5.5, 1.0, 0.5),
        MATH_TOL_LOOSE
    );
    c.that(
        "bones that are not a chain are refused",
        !TwoBoneIk::solve(p2, t, IkLimb::make(1, 3, 2), Vec3::zero(), IkPole::none())
    );
}

fn animSolveTestFabrik(c : Checks) : void {
    let s : Skeleton = new Skeleton(8);
    s.addBone("b0", -1, Transform::identity());
    for (i of 1..ANIM_SOLVE_CHAIN_BONES) {
        s.addBone("b${i}", i - 1, Transform::fromTranslation(Vec3::make(0.0, 1.0, 0.0)));
    }
    let mut chain : i32[] = new i32[ANIM_SOLVE_CHAIN_BONES];
    for (i of 0..ANIM_SOLVE_CHAIN_BONES) {
        chain[i] = i;
    }
    let pose : Pose = Pose::bindOf(s);
    let r : IkResult = animSolveFabrik(pose, s, chain, Vec3::make(2.0, 2.0, 1.0));
    c.that("fabrik reaches a reachable target", r.reached);
    c.that("the solved end effector ends within the 0.001 tolerance", r.error <= 0.001);
    nearVec3(
        c,
        "the end is on the target",
        animSolveTip(pose, s, 4),
        Vec3::make(2.0, 2.0, 1.0),
        0.002
    );
    c.that("in a bounded number of rounds", r.iterations > 0 && r.iterations <= 64);
    nearVec3(c, "the root has not moved", animSolveTip(pose, s, 0), Vec3::zero(), 0.0);
    let mut lengthOk : bool = true;
    for (i of 1..ANIM_SOLVE_CHAIN_BONES) {
        let one : f32 = 1.0;
        let gap : f32 = animSolveTip(pose, s, i).distance(animSolveTip(pose, s, i - 1)) - one;
        if (gap > 0.0001 || gap < -0.0001) {
            lengthOk = false;
        }
    }
    c.that("every bone keeps its length", lengthOk);

    pose.resetToBind(s);
    let near : IkResult = animSolveFabrik(pose, s, chain, Vec3::make(0.0, 4.0, 0.0));
    c.sameInt("a chain already on target needs no rounds", near.iterations as i64, 0);
    c.that("a nearby target is reported as reached", near.reached);

    pose.resetToBind(s);
    let out : IkResult = animSolveFabrik(pose, s, chain, Vec3::make(10.0, 0.0, 0.0));
    c.that("a target beyond the chain is not reached", !out.reached);
    nearVec3(
        c,
        "the chain lies straight towards it",
        animSolveTip(pose, s, 4),
        Vec3::make(4.0, 0.0, 0.0),
        0.0005
    );

    pose.resetToBind(s);
    let few : IkResult = FabrikChain::solve(
        pose,
        s,
        chain,
        5,
        Vec3::make(3.0, 1.0, 0.0),
        0.0000001,
        2
    );
    c.that("the iteration limit is respected", few.iterations <= 2);
}

fn animSolveTestLookAt(c : Checks) : void {
    let s : Skeleton = animChainSkeleton();
    let pose : Pose = Pose::bindOf(s);
    // Bone 2 (the tip) faces +Z in its own space; ask it to face +X.
    let turned : f32 = animSolveLook(pose, s, Vec3::make(5.0, 2.0, 0.0), 1.0, 10.0);
    nearF(c, "a full look turns a quarter turn", turned, HALF_PI, MATH_TOL_LOOSE);
    let faces : Vec3 = pose.modelTransform(s, 2).rotation.rotate(Vec3::unitZ());
    nearVec3(c, "and the axis points at the target", faces, Vec3::unitX(), MATH_TOL_LOOSE);

    pose.resetToBind(s);
    let limited : f32 = animSolveLook(pose, s, Vec3::make(5.0, 2.0, 0.0), 1.0, 0.5);
    nearF(c, "a turn limit caps the turn", limited, 0.5, MATH_TOL_LOOSE);
    nearF(
        c,
        "and the bone really turned that far",
        pose.get(2).rotation.angle(),
        0.5,
        MATH_TOL_LOOSE
    );

    pose.resetToBind(s);
    let half : f32 = animSolveLook(pose, s, Vec3::make(5.0, 2.0, 0.0), 0.5, 10.0);
    nearF(c, "weight one half turns half as far", half, 0.785398163, MATH_TOL_LOOSE);

    pose.resetToBind(s);
    let none : f32 = animSolveLook(pose, s, Vec3::make(0.0, 2.0, 5.0), 1.0, 10.0);
    nearF(c, "already facing the target: no turn", none, 0.0, MATH_TOL_LOOSE);

    // A bone under a turned parent: the model-space aim must hold.
    pose.resetToBind(s);
    pose.setRotation(1, Quat::fromAxisAngle(Vec3::unitY(), 0.7));
    animSolveLook(pose, s, Vec3::make(-3.0, 3.0, 2.0), 1.0, 10.0);
    let there : Vec3 = pose.modelTransform(s, 2).rotation.rotate(Vec3::unitZ());
    let want : Vec3 = Vec3::make(-3.0, 3.0, 2.0)
        .minus(pose.modelTransform(s, 2).translation)
        .normalized();
    nearVec3(
        c,
        "under a turned parent the axis still points at the target",
        there,
        want,
        MATH_TOL_LOOSE
    );
}

fn animSolveTestSkinning(c : Checks) : void {
    let s : Skeleton = animChainSkeleton();
    let pose : Pose = Pose::bindOf(s);
    pose.setRotation(1, Quat::fromAxisAngle(Vec3::unitZ(), HALF_PI));
    pose.update(s);
    let n : i32 = 4;
    let mut joints : i32[] = new i32[16];
    let mut weights : f32[] = new f32[16];
    let mut pos : f32[] = new f32[12];
    let mut nor : f32[] = new f32[12];
    let outP : f32[] = new f32[12];
    let outN : f32[] = new f32[12];
    for (i of 0..16) {
        joints[i] = 0;
        weights[i] = 0.0;
    }
    // Vertex 0: all on the mid bone. Vertex 1: half root, half mid. Vertex 2: unnormalised halves. Vertex 3: no weight.
    joints[0] = 1;
    weights[0] = 1.0;
    joints[4] = 0;
    weights[4] = 0.5;
    joints[5] = 1;
    weights[5] = 0.5;
    joints[8] = 0;
    weights[8] = 0.25;
    joints[9] = 1;
    weights[9] = 0.25;
    for (v of 0..3) {
        pos[v * 3] = 0.0;
        pos[v * 3 + 1] = 2.0;
        pos[v * 3 + 2] = 0.0;
        nor[v * 3] = 1.0;
        nor[v * 3 + 1] = 0.0;
        nor[v * 3 + 2] = 0.0;
    }
    pos[9] = 0.5;
    pos[10] = 0.5;
    pos[11] = 0.5;
    nor[9] = 0.0;
    nor[10] = 0.0;
    nor[11] = 1.0;
    Skinning::skinPositions(pose.skinMatrices(), joints, weights, pos, outP, n);
    // The mid bone sits at (0,1,0); the point (0,2,0) is one unit above it and swings to (-1,1,0).
    nearVec3(
        c,
        "a vertex on the turned bone follows it",
        animSolveVertex(outP, 0),
        Vec3::make(-1.0, 1.0, 0.0),
        MATH_TOL
    );
    nearVec3(
        c,
        "weights 0.5 / 0.5 land halfway between",
        animSolveVertex(outP, 1),
        Vec3::make(-0.5, 1.5, 0.0),
        MATH_TOL
    );
    nearVec3(
        c,
        "weights are normalised by their sum",
        animSolveVertex(outP, 2),
        Vec3::make(-0.5, 1.5, 0.0),
        MATH_TOL
    );
    nearVec3(
        c,
        "a vertex with no weight stays",
        animSolveVertex(outP, 3),
        Vec3::make(0.5, 0.5, 0.5),
        0.0
    );
    Skinning::skinNormals(pose.skinMatrices(), joints, weights, nor, outN, n);
    nearVec3(
        c,
        "a normal on the turned bone is rotated",
        animSolveVertex(outN, 0),
        Vec3::make(0.0, 1.0, 0.0),
        MATH_TOL
    );
    nearVec3(
        c,
        "half-and-half normals blend and renormalise",
        animSolveVertex(outN, 1),
        Vec3::make(0.70710678, 0.70710678, 0.0),
        MATH_TOL
    );
    nearVec3(
        c,
        "a normal with no weight stays",
        animSolveVertex(outN, 3),
        Vec3::make(0.0, 0.0, 1.0),
        0.0
    );
}

/** The inverse kinematics, look-at and skinning suite. */
pub class AnimSolveSuite {
    /** Runs the solver and skinning checks. */
    pub static fn run(c : Checks) : void {
        animSolveTestTwoBone(c);
        animSolveTestFabrik(c);
        animSolveTestLookAt(c);
        animSolveTestSkinning(c);
    }
}

// math_quat — Quat and Transform: rotations, their agreement with matrices, interpolation and placement.
//
// A quaternion is only meaningful up to sign and a transform is a rotation plus a scale, so the checks compare
// rotations through `sameRotation` and matrices through their result on a point; an exact entry would reject
// the same rotation reached by another route. The interpolation checks walk the whole interval (both ends, the
// middle, a quarter, past the end) because slerp's sign choice and its near-equal shortcut are the parts games
// actually feel.

use ludax::{Checks, Vec3, Mat3, Mat4, Quat, Transform, PI, HALF_PI, TAU};

use crate::math_support::{
    MATH_TOL, MATH_TOL_COARSE, MATH_TOL_LOOSE, MATH_TOL_TIGHT, nearVec3, nearMat3, nearMat4,
    sameQuat, nearF
};

fn quatTestConstruction(c : Checks) : void {
    let q : Quat = Quat::fromAxisAngle(Vec3::unitY(), HALF_PI);
    nearVec3(
        c,
        "a quarter turn about Y sends Z to X",
        q.rotate(Vec3::unitZ()),
        Vec3::unitX(),
        MATH_TOL
    );
    nearVec3(c, "and X to -Z", q.rotate(Vec3::unitX()), Vec3::make(0.0, 0.0, -1.0), MATH_TOL);
    nearF(c, "angle", q.angle(), HALF_PI, MATH_TOL);
    nearVec3(c, "axis", q.axis(), Vec3::unitY(), MATH_TOL);
    nearF(c, "a unit rotation has length 1", q.length(), 1.0, MATH_TOL);
    sameQuat(
        c,
        "a zero axis gives the identity",
        Quat::fromAxisAngle(Vec3::zero(), 1.0),
        Quat::identity(),
        MATH_TOL_TIGHT
    );
    nearVec3(c, "the identity has axis X", Quat::identity().axis(), Vec3::unitX(), 0.0);
    nearF(c, "the identity has angle 0", Quat::identity().angle(), 0.0, 0.0);
    nearVec3(
        c,
        "an unnormalised axis is normalised",
        Quat::fromAxisAngle(Vec3::make(0.0, 5.0, 0.0), HALF_PI).rotate(Vec3::unitZ()),
        Vec3::unitX(),
        MATH_TOL
    );
    nearVec3(
        c,
        "rotate by the identity",
        Quat::identity().rotate(Vec3::make(1.0, 2.0, 3.0)),
        Vec3::make(1.0, 2.0, 3.0),
        0.0
    );
}

fn quatTestAlgebra(c : Checks) : void {
    let a : Quat = Quat::fromAxisAngle(Vec3::make(1.0, 2.0, 3.0), 0.9);
    let b : Quat = Quat::fromAxisAngle(Vec3::make(-1.0, 0.5, 0.2), -1.7);
    let p : Vec3 = Vec3::make(0.4, -1.2, 2.5);
    nearVec3(c, "a.mul(b) rotates by b first", a.mul(b).rotate(p), a.rotate(b.rotate(p)), MATH_TOL);
    sameQuat(
        c,
        "q times its conjugate is the identity",
        a.mul(a.conjugate()),
        Quat::identity(),
        MATH_TOL_TIGHT
    );
    sameQuat(
        c,
        "q times its inverse is the identity",
        a.mul(a.inverse()),
        Quat::identity(),
        MATH_TOL_TIGHT
    );
    let big : Quat = Quat { x: 0.0, y: 2.0, z: 0.0, w: 0.0 };
    nearF(c, "inverse of a non-unit quaternion", big.mul(big.inverse()).w, 1.0, MATH_TOL_TIGHT);
    sameQuat(
        c,
        "inverse of the zero quaternion is the identity",
        Quat { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }.inverse(),
        Quat::identity(),
        0.0
    );
    sameQuat(
        c,
        "normalized of the zero quaternion is the identity",
        Quat { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }.normalized(),
        Quat::identity(),
        0.0
    );
    nearF(
        c,
        "normalized restores length 1",
        Quat { x: 1.0, y: 2.0, z: 3.0, w: 4.0 }.normalized().length(),
        1.0,
        MATH_TOL_TIGHT
    );
    c.that(
        "q and -q are the same rotation",
        a.sameRotation(Quat { x: -a.x, y: -a.y, z: -a.z, w: -a.w }, MATH_TOL_TIGHT)
    );
    c.that("different rotations differ", !a.sameRotation(b, MATH_TOL_COARSE));
}

fn quatTestMatrices(c : Checks) : void {
    nearMat3(
        c,
        "toMat3 about X agrees with rotationX",
        Quat::fromAxisAngle(Vec3::unitX(), 0.7).toMat3(),
        Mat3::rotationX(0.7),
        MATH_TOL
    );
    nearMat3(
        c,
        "toMat3 about Y agrees with rotationY",
        Quat::fromAxisAngle(Vec3::unitY(), -1.3).toMat3(),
        Mat3::rotationY(-1.3),
        MATH_TOL
    );
    nearMat3(
        c,
        "toMat3 about Z agrees with rotationZ",
        Quat::fromAxisAngle(Vec3::unitZ(), 2.4).toMat3(),
        Mat3::rotationZ(2.4),
        MATH_TOL
    );
    nearMat4(
        c,
        "toMat4 agrees with Mat4 rotationY",
        Quat::fromAxisAngle(Vec3::unitY(), 0.5).toMat4(),
        Mat4::rotationY(0.5),
        MATH_TOL
    );
    let q : Quat = Quat::fromAxisAngle(Vec3::make(0.3, -1.0, 0.8), 2.2);
    let p : Vec3 = Vec3::make(1.0, -2.0, 0.5);
    nearVec3(
        c,
        "the matrix rotates like the quaternion",
        q.toMat3().transform(p),
        q.rotate(p),
        MATH_TOL
    );
    let r : Quat = Quat::fromAxisAngle(Vec3::make(1.0, 1.0, 0.0), -0.4);
    nearMat3(
        c,
        "the matrix of a product is the product of matrices",
        q.mul(r).toMat3(),
        q.toMat3().mul(r.toMat3()),
        MATH_TOL
    );
    // Round trips through a matrix, covering all four branches of the conversion (trace and each largest diagonal).
    let mut i : i32 = 0;
    while (i < 8) {
        let axis : Vec3 = Vec3::make((i + 1) as f32, (i * i - 3) as f32, (2 - i) as f32);
        let step : f32 = 0.4;
        let base : f32 = 0.3;
        let angle : f32 = (i as f32) * step + base;
        let original : Quat = Quat::fromAxisAngle(axis, angle);
        sameQuat(
            c,
            "fromMat3(toMat3(q)) round trip ${i}",
            Quat::fromMat3(original.toMat3()),
            original,
            MATH_TOL
        );
        i = i + 1;
    }
    sameQuat(
        c,
        "round trip of a half turn about X (x dominant)",
        Quat::fromMat3(Mat3::rotationX(PI)),
        Quat::fromAxisAngle(Vec3::unitX(), PI),
        MATH_TOL
    );
    sameQuat(
        c,
        "round trip of a half turn about Y (y dominant)",
        Quat::fromMat3(Mat3::rotationY(PI)),
        Quat::fromAxisAngle(Vec3::unitY(), PI),
        MATH_TOL
    );
    sameQuat(
        c,
        "round trip of a half turn about Z (z dominant)",
        Quat::fromMat3(Mat3::rotationZ(PI)),
        Quat::fromAxisAngle(Vec3::unitZ(), PI),
        MATH_TOL
    );
}

fn quatTestEuler(c : Checks) : void {
    let yaw : f32 = 0.5;
    let pitch : f32 = -0.3;
    let roll : f32 = 1.1;
    let expected : Mat3 = Mat3::rotationY(yaw)
        .mul(Mat3::rotationX(pitch))
        .mul(Mat3::rotationZ(roll));
    nearMat3(
        c,
        "fromEuler is Ry * Rx * Rz",
        Quat::fromEuler(yaw, pitch, roll).toMat3(),
        expected,
        MATH_TOL
    );
    nearVec3(
        c,
        "yaw alone turns left about +Y",
        Quat::fromEuler(HALF_PI, 0.0, 0.0).rotate(Vec3::make(0.0, 0.0, -1.0)),
        Vec3::make(-1.0, 0.0, 0.0),
        MATH_TOL
    );
    nearVec3(
        c,
        "pitch alone tips the nose up",
        Quat::fromEuler(0.0, HALF_PI, 0.0).rotate(Vec3::make(0.0, 0.0, -1.0)),
        Vec3::unitY(),
        MATH_TOL
    );
    nearF(c, "yaw recovers the heading", Quat::fromEuler(0.7, 0.2, 0.0).yaw(), 0.7, MATH_TOL);
    nearF(c, "yaw of the identity", Quat::identity().yaw(), 0.0, 0.0);
}

fn quatTestFromTo(c : Checks) : void {
    let a : Vec3 = Vec3::make(1.0, 2.0, -0.5);
    let b : Vec3 = Vec3::make(-3.0, 0.5, 2.0);
    nearVec3(
        c,
        "fromTo maps a onto b",
        Quat::fromTo(a, b).rotate(a.normalized()),
        b.normalized(),
        MATH_TOL
    );
    sameQuat(
        c,
        "fromTo of equal directions is the identity",
        Quat::fromTo(a, a.scale(4.0)),
        Quat::identity(),
        MATH_TOL
    );
    let flip : Quat = Quat::fromTo(Vec3::unitX(), Vec3::unitX().negated());
    nearVec3(
        c,
        "fromTo of opposite directions flips",
        flip.rotate(Vec3::unitX()),
        Vec3::unitX().negated(),
        MATH_TOL
    );
    nearF(c, "the flip is a unit rotation", flip.length(), 1.0, MATH_TOL);
    sameQuat(
        c,
        "fromTo with a zero direction is the identity",
        Quat::fromTo(Vec3::zero(), a),
        Quat::identity(),
        0.0
    );
}

fn quatTestInterpolation(c : Checks) : void {
    let a : Quat = Quat::fromAxisAngle(Vec3::unitY(), 0.2);
    let b : Quat = Quat::fromAxisAngle(Vec3::unitY(), 1.8);
    sameQuat(c, "slerp at 0 is the start", a.slerp(b, 0.0), a, MATH_TOL);
    sameQuat(c, "slerp at 1 is the end", a.slerp(b, 1.0), b, MATH_TOL);
    sameQuat(
        c,
        "slerp at 0.5 is the middle angle",
        a.slerp(b, 0.5),
        Quat::fromAxisAngle(Vec3::unitY(), 1.0),
        MATH_TOL
    );
    sameQuat(
        c,
        "slerp at 0.25 moves a quarter of the way",
        a.slerp(b, 0.25),
        Quat::fromAxisAngle(Vec3::unitY(), 0.6),
        MATH_TOL
    );
    nearF(c, "slerp stays unit length", a.slerp(b, 0.37).length(), 1.0, MATH_TOL);
    let negated : Quat = Quat { x: -b.x, y: -b.y, z: -b.z, w: -b.w };
    sameQuat(
        c,
        "slerp takes the short way to the negated end",
        a.slerp(negated, 0.5),
        Quat::fromAxisAngle(Vec3::unitY(), 1.0),
        MATH_TOL
    );
    sameQuat(
        c,
        "slerp of nearly equal rotations does not blow up",
        a.slerp(Quat::fromAxisAngle(Vec3::unitY(), 0.2001), 0.5),
        a,
        MATH_TOL_LOOSE
    );
    sameQuat(c, "slerp of identical rotations", a.slerp(a, 0.5), a, MATH_TOL);
    sameQuat(
        c,
        "nlerp at 0.5 of a short arc is near the slerp",
        a.nlerp(b, 0.5),
        a.slerp(b, 0.5),
        0.01
    );
    let half : Quat = Quat::identity().slerp(Quat::fromAxisAngle(Vec3::unitX(), TAU * 0.4), 0.5);
    nearF(c, "slerp passes through half the angle", half.angle(), TAU * 0.2, MATH_TOL_LOOSE);
}

fn quatTestTransform(c : Checks) : void {
    let t : Transform = Transform::make(
        Vec3::make(1.0, 2.0, 3.0),
        Quat::fromAxisAngle(Vec3::unitY(), 0.8),
        Vec3::splat(2.0)
    );
    let p : Vec3 = Vec3::make(0.5, -1.0, 2.0);
    nearVec3(
        c,
        "toMat4 transforms points like the transform",
        t.toMat4().transformPoint(p),
        t.transformPoint(p),
        MATH_TOL
    );
    nearVec3(
        c,
        "toMat4 transforms vectors like the transform",
        t.toMat4().transformVector(p),
        t.transformVector(p),
        MATH_TOL
    );
    nearVec3(c, "identity does nothing", Transform::identity().transformPoint(p), p, 0.0);
    nearMat4(c, "identity as a matrix", Transform::identity().toMat4(), Mat4::identity(), 0.0);
    nearVec3(
        c,
        "inverse undoes the transform",
        t.inverse().transformPoint(t.transformPoint(p)),
        p,
        MATH_TOL
    );
    nearMat4(
        c,
        "inverse as a matrix agrees with inverseAffine",
        t.inverse().toMat4(),
        t.toMat4().inverseAffine(),
        MATH_TOL
    );
    let parent : Transform = Transform::make(
        Vec3::make(-4.0, 0.0, 1.0),
        Quat::fromAxisAngle(Vec3::unitX(), -0.6),
        Vec3::splat(0.5)
    );
    nearMat4(
        c,
        "mul agrees with matrix multiplication",
        parent.mul(t).toMat4(),
        parent.toMat4().mul(t.toMat4()),
        MATH_TOL_LOOSE
    );
    nearVec3(
        c,
        "mul applies the child first",
        parent.mul(t).transformPoint(p),
        parent.transformPoint(t.transformPoint(p)),
        MATH_TOL_LOOSE
    );
    let flat : Transform = Transform::make(
        Vec3::make(1.0, 1.0, 1.0),
        Quat::identity(),
        Vec3::make(1.0, 0.0, 1.0)
    );
    nearVec3(
        c,
        "inverse with a zero scale does not trap",
        flat.inverse().scale,
        Vec3::make(1.0, 0.0, 1.0),
        0.0
    );
    nearVec3(
        c,
        "translation only",
        Transform::fromTranslation(Vec3::unitX()).transformPoint(Vec3::unitY()),
        Vec3::make(1.0, 1.0, 0.0),
        0.0
    );
    nearVec3(
        c,
        "rotation only",
        Transform::fromRotation(Quat::fromAxisAngle(
            Vec3::unitZ(),
            HALF_PI
        )).transformPoint(Vec3::unitX()),
        Vec3::unitY(),
        MATH_TOL
    );
    let other : Transform = Transform::make(
        Vec3::make(3.0, 2.0, 1.0),
        Quat::fromAxisAngle(Vec3::unitY(), 1.6),
        Vec3::splat(4.0)
    );
    nearVec3(c, "lerp at 0", t.lerp(other, 0.0).translation, t.translation, 0.0);
    nearVec3(c, "lerp at 1", t.lerp(other, 1.0).scale, other.scale, 0.0);
    let mid : Transform = t.lerp(other, 0.5);
    nearVec3(c, "lerp mid translation", mid.translation, Vec3::make(2.0, 2.0, 2.0), 0.0);
    nearVec3(c, "lerp mid scale", mid.scale, Vec3::splat(3.0), 0.0);
    nearF(c, "lerp mid rotation", mid.rotation.angle(), 1.2, MATH_TOL_LOOSE);
}

/** The quaternion and transform suite. */
pub class MathQuatSuite {
    /** Runs the quaternion and transform checks. */
    pub static fn run(c : Checks) : void {
        quatTestConstruction(c);
        quatTestAlgebra(c);
        quatTestMatrices(c);
        quatTestEuler(c);
        quatTestFromTo(c);
        quatTestInterpolation(c);
        quatTestTransform(c);
    }
}

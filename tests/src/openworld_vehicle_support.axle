// openworld_vehicle_support — the stepping helper the vehicle suites share.
//
// Both vehicle suites advance the model in fixed 60 Hz steps from a chosen state and input; keeping the loop
// here means a check compares vehicles, not two slightly different ways of stepping one.

use ludax::GroundHeight;
use ludax::VehicleInput;
use ludax::VehicleModel;
use ludax::VehicleParams;
use ludax::VehicleState;

/** One vehicle step: 60 a second. */
pub const VEHT_DT : f64 = 0.016666666666666666;

/** Full throttle, no brake, straight ahead. */
pub fn vehFull() : VehicleInput {
    return VehicleInput { throttle: 1.0, brake: 0.0, steer: 0.0, reverse: false, handbrake: false };
}

/** Steps `s0` for `steps` steps of `input` on ground `g`. */
pub fn vehRun(
    p : VehicleParams,
    s0 : VehicleState,
    input : VehicleInput,
    g : GroundHeight,
    steps : i32
) : VehicleState {
    let mut s : VehicleState = s0;
    for (i of 0..steps) {
        s = VehicleModel::step(p, s, input, g, VEHT_DT);
    }
    return s;
}

// sim_clock — checks for the fixed-tick clock of a particle effect: the warm-up of its first frame, the ticks of the time
// that passed, the cap on a long pause once particles live, and the restart when time goes back.

use ludax::{Checks, PtcClock, PtcTicks};

/** Checks `PtcClock`. */
pub class SimClockSuite {
    /** Runs every check of the suite. */
    pub static fn run(mut c : Checks) : void {
        let clock : PtcClock = new PtcClock();
        c.near("sim clock: a tick lasts 1/60 s", clock.dt() as f64, 1.0 / 60.0, 0.0000001);

        // The first frame lives the warm-up at once, ending at the time asked.
        let first : PtcTicks = clock.advance(10.0, 0);
        c.sameInt(
            "sim clock: the first call runs the warm-up ticks",
            first.to - first.from,
            clock.warm
        );
        c.sameInt("sim clock: ... ending at the tick of the time", first.to, 600);
        c.that("sim clock: ... without clearing", !first.clear);

        // Later calls run the ticks of the time that went by.
        let next : PtcTicks = clock.advance(10.5, 0);
        c.sameInt("sim clock: the next call starts where the last ended", next.from, 600);
        c.sameInt("sim clock: ... and runs the ticks of the elapsed time", next.to - next.from, 30);
        let same : PtcTicks = clock.advance(10.5, 0);
        c.sameInt("sim clock: no time, no ticks", same.to - same.from, 0);

        // With particles alive a long pause is capped; without, every tick runs.
        let capped : PtcTicks = clock.advance(20.0, 5);
        c.sameInt(
            "sim clock: a long pause with particles alive runs at most catchUp ticks",
            capped.to - capped.from,
            clock.catchUp
        );
        c.sameInt("sim clock: ... the latest ones", capped.to, 1200);
        let emptyPause : PtcTicks = clock.advance(30.0, 0);
        c.sameInt(
            "sim clock: the same pause with nothing alive runs them all",
            emptyPause.to - emptyPause.from,
            600
        );

        // Time going back starts the effect over.
        let back : PtcTicks = clock.advance(1.0, 5);
        c.that("sim clock: a time before the last asks to clear", back.clear);
        c.sameInt("sim clock: ... and stands at the earlier tick", back.to, 60);
        let after : PtcTicks = clock.advance(1.1, 5);
        c.that(
            "sim clock: ... after which it runs on without clearing",
            !after.clear && after.to - after.from == 6
        );
    }
}

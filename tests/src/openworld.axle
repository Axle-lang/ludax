// openworld — runs the suites of the openworld module.
//
// This file only orders the sub-suites; each of them owns its own world and its own checks. Keeping the order
// here rather than in `main` means the module's registration does not change when a sub-suite is added.

use ludax::Checks;

use crate::openworld_missions::OpenworldMissionSuite;
use crate::openworld_sky::OpenworldSkySuite;
use crate::openworld_stream::OpenworldStreamSuite;
use crate::openworld_vehicle::OpenworldVehicleSuite;

/** All openworld checks. */
pub class OpenworldSuite {
    /** Runs every check of the module. */
    pub static fn run(c : Checks) : void {
        OpenworldStreamSuite::run(c);
        OpenworldVehicleSuite::run(c);
        OpenworldMissionSuite::run(c);
        OpenworldSkySuite::run(c);
    }
}

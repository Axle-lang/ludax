// collections — checks for Vec, SparseSet, Slab, Ring, Heap, BitSet, Map and StringMap.
//
// Each section states what a container promises: growth keeps the elements, removal leaves the order the
// documentation names, a stale id is refused, and a failed query gives its fallback instead of aborting.
// Calls that abort by contract (an index out of range) cannot be exercised in-process, so the checks stay on
// the non-aborting side of each guard: `has`, `getOr`, `popOr`, and the booleans `remove`, `push`, `set`
// return.

use ludax::BitSet;
use ludax::Checks;
use ludax::EntityId;
use ludax::Heap;
use ludax::Map;
use ludax::Ring;
use ludax::Slab;
use ludax::SparseSet;
use ludax::StringMap;
use ludax::Vec;

struct CollPair {
    a : i32;
    b : f64;
}

// The 64-bit linear congruential generator the heap check uses for its 2000 keys: Knuth's MMIX constants.
const COLL_LCG_MUL : i64 = 6364136223846793005;
const COLL_LCG_ADD : i64 = 1442695040888963407;

/** The collections checks. Helpers are prefixed because top-level names are global to the package. */
pub class CollectionsSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        collVecChecks(c);
        collVecOfStructs(c);
        collSparseSetChecks(c);
        collSlabChecks(c);
        collRingChecks(c);
        collHeapChecks(c);
        collBitSetChecks(c);
        collMapChecks(c);
        collMapChurn(c);
        collStringMapChecks(c);
    }
}

fn collVecChecks(c : Checks) : void {
    let v : Vec<i64> = new Vec<i64>();
    c.that("vec: a new vec is empty with length zero", v.isEmpty() && v.len() == 0);
    for (i of 0..10000) {
        v.push(i as i64 * 3);
    }
    c.sameInt("vec: len after 10000 pushes", v.len() as i64, 10000);
    c.that("vec: capacity grew past len", v.capacity() >= 10000);
    let mut intact : bool = true;
    for (i of 0..10000) {
        if (v.get(i) != i as i64 * 3) {
            intact = false;
        }
    }
    c.that("vec: every element survived the growths", intact);

    v.set(5, 99);
    c.sameInt("vec: set then get returns the stored value", v.get(5), 99);
    c.sameInt("vec: last returns the final element", v.last(), 29997);
    c.sameInt("vec: pop returns the last", v.pop(), 29997);
    c.sameInt("vec: pop shrinks the length by one", v.len() as i64, 9999);

    c.that("vec: has accepts the first index", v.has(0));
    c.that("vec: has rejects an index equal to the length", !v.has(9999));
    c.that("vec: has rejects a negative index", !v.has(-1));
    c.sameInt("vec: getOr inside the range returns the element", v.getOr(1, -7), 3);
    c.sameInt("vec: getOr past the end", v.getOr(9999, -7), -7);
    c.sameInt("vec: getOr with a negative index returns the fallback", v.getOr(-1, -7), -7);

    let small : Vec<i32> = new Vec<i32>(4);
    for (i of 0..6) {
        small.push(i * 10);
    }
    c.sameInt("vec: swapRemove returns the removed", small.swapRemove(1) as i64, 10);
    c.sameInt("vec: swapRemove moves the last into the hole", small.get(1) as i64, 50);
    c.sameInt("vec: swapRemove shrinks the length by one", small.len() as i64, 5);
    c.sameInt("vec: swapRemove of the last", small.swapRemove(4) as i64, 40);
    c.sameInt("vec: removeAt returns the removed", small.removeAt(0) as i64, 0);
    c.sameInt("vec: removeAt keeps the order (first)", small.get(0) as i64, 50);
    c.sameInt("vec: removeAt keeps the order (second)", small.get(1) as i64, 20);
    c.sameInt("vec: removeAt keeps the order (third)", small.get(2) as i64, 30);
    small.swap(0, 2);
    c.sameInt(
        "vec: swap exchanges the first and third elements (first slot)",
        small.get(0) as i64,
        30
    );
    c.sameInt(
        "vec: swap exchanges the first and third elements (third slot)",
        small.get(2) as i64,
        50
    );

    small.truncate(100);
    c.sameInt("vec: truncate past len does nothing", small.len() as i64, 3);
    small.truncate(1);
    c.sameInt("vec: truncate to one leaves one element", small.len() as i64, 1);
    let room : i32 = small.capacity();
    small.clear();
    c.that("vec: clear leaves the vec empty", small.isEmpty());
    c.sameInt("vec: clear keeps the storage", small.capacity() as i64, room as i64);
    c.sameInt("vec: popOr on an empty vec returns the fallback", small.popOr(-1) as i64, -1);
    small.push(8);
    c.sameInt("vec: popOr on a one-element vec returns that element", small.popOr(-1) as i64, 8);

    let reserved : Vec<i32> = new Vec<i32>(0);
    c.that("vec: a zero capacity request still has room", reserved.capacity() >= 1);
    reserved.reserve(500);
    c.that("vec: reserve makes room for 500 elements", reserved.capacity() >= 500);
    let before : i32 = reserved.capacity();
    for (i of 0..500) {
        reserved.push(i);
    }
    c.sameInt("vec: no regrowth inside the reservation", reserved.capacity() as i64, before as i64);
}

fn collVecOfStructs(c : Checks) : void {
    let pairs : Vec<CollPair> = new Vec<CollPair>();
    for (i of 0..100) {
        pairs.push(CollPair { a: i, b: i as f64 * 0.5 });
    }
    c.sameInt("vec<struct>: a hundred pushes give length 100", pairs.len() as i64, 100);
    c.sameInt("vec<struct>: an int field survives storage", pairs.get(77).a as i64, 77);
    c.near("vec<struct>: a float field survives storage exactly", pairs.get(77).b, 38.5, 0.0);
    pairs.set(3, CollPair { a: -1, b: -2.0 });
    c.sameInt("vec<struct>: set replaces a whole struct", pairs.get(3).a as i64, -1);
    let popped : CollPair = pairs.pop();
    c.sameInt("vec<struct>: pop returns the last struct", popped.a as i64, 99);
    let fallback : CollPair = CollPair { a: 42, b: 0.0 };
    c.sameInt(
        "vec<struct>: getOr past the end returns the fallback struct",
        pairs.getOr(500, fallback).a as i64,
        42
    );
}

fn collSparseSetChecks(c : Checks) : void {
    let s : SparseSet<i64> = new SparseSet<i64>();
    c.that("sparse: a new set is empty", s.isEmpty());
    c.that("sparse: a key never inserted is absent", !s.has(5));
    c.that("sparse: negative key is absent, not an error", !s.has(-3));
    c.that("sparse: inserting a new key reports it as new", s.insert(5, 50));
    c.that("sparse: inserting an existing key reports a replacement", !s.insert(5, 55));
    c.sameInt("sparse: replace keeps one entry", s.len() as i64, 1);
    c.sameInt("sparse: the replaced value is the one read back", s.get(5), 55);
    s.insert(900, 9000);
    s.insert(2, 20);
    s.insert(31, 310);
    c.sameInt("sparse: dense order is insertion order (0)", s.keyAt(0) as i64, 5);
    c.sameInt("sparse: dense order is insertion order (1)", s.keyAt(1) as i64, 900);
    c.sameInt("sparse: dense order is insertion order (2)", s.keyAt(2) as i64, 2);
    c.sameInt("sparse: valueAt returns the value at a dense slot", s.valueAt(1), 9000);
    c.sameInt("sparse: denseIndex finds the dense slot of a key", s.denseIndex(2) as i64, 2);
    c.sameInt("sparse: denseIndex of an absent key is -1", s.denseIndex(3) as i64, -1);
    c.sameInt("sparse: getOr on an absent key returns the fallback", s.getOr(4, -9), -9);

    c.that("sparse: removing a present key reports true", s.remove(900));
    c.that("sparse: removing the same key again reports false", !s.remove(900));
    c.that("sparse: remove of a never-seen key", !s.remove(12345));
    c.sameInt("sparse: removal fills the hole with the last (key)", s.keyAt(1) as i64, 31);
    c.sameInt("sparse: removal fills the hole with the last (value)", s.valueAt(1), 310);
    c.sameInt("sparse: moved key still found", s.get(31), 310);
    c.sameInt("sparse: untouched key still found", s.get(2), 20);
    c.sameInt("sparse: removal leaves three entries", s.len() as i64, 3);
    s.setValueAt(0, 51);
    c.sameInt("sparse: setValueAt overwrites the value in a dense slot", s.get(5), 51);

    s.clear();
    c.that(
        "sparse: clear empties the set and forgets its keys",
        s.isEmpty() && !s.has(5) && !s.has(31)
    );
    c.that("sparse: the set accepts inserts after a clear", s.insert(31, 1) && s.get(31) == 1);

    let big : SparseSet<i64> = new SparseSet<i64>();
    for (k of 0..2000) {
        big.insert(k * 2, k as i64);
    }
    for (k of 0..1000) {
        big.remove(k * 4);
    }
    let mut ok : bool = big.len() == 1000;
    for (d of 0..big.len()) {
        let key : i32 = big.keyAt(d);
        if (big.denseIndex(key) != d || key % 4 != 2 || big.valueAt(d) != (key / 2) as i64) {
            ok = false;
        }
    }
    c.that("sparse: sparse and dense stay consistent through 1000 removals", ok);
}

fn collSlabChecks(c : Checks) : void {
    let slab : Slab<CollPair> = new Slab<CollPair>();
    let a : EntityId = slab.insert(CollPair { a: 1, b: 1.0 });
    let b : EntityId = slab.insert(CollPair { a: 2, b: 2.0 });
    let d : EntityId = slab.insert(CollPair { a: 3, b: 3.0 });
    c.sameInt("slab: the first insert takes slot 0", a.index as i64, 0);
    c.sameInt("slab: generations start at 1", a.generation as i64, 1);
    c.sameInt("slab: three inserts give length 3", slab.len() as i64, 3);
    c.sameInt("slab: get returns the value stored under an id", slab.get(b).a as i64, 2);
    c.that("slab: set a live id", slab.set(b, CollPair { a: 20, b: 2.0 }));
    c.sameInt("slab: set on a live id replaces its value", slab.get(b).a as i64, 20);

    c.that("slab: removing a live id succeeds", slab.remove(b));
    c.that("slab: removing again is refused", !slab.remove(b));
    c.that("slab: the stale id is not live", !slab.has(b));
    c.that("slab: set on a stale id is refused", !slab.set(b, CollPair { a: 0, b: 0.0 }));
    let nothing : CollPair = CollPair { a: -1, b: -1.0 };
    c.sameInt("slab: getOr on a stale id", slab.getOr(b, nothing).a as i64, -1);
    c.sameInt("slab: removing one of three leaves length 2", slab.len() as i64, 2);

    let e : EntityId = slab.insert(CollPair { a: 4, b: 4.0 });
    c.sameInt("slab: the freed slot is reused", e.index as i64, b.index as i64);
    c.sameInt("slab: its generation moved on", e.generation as i64, 2);
    c.that("slab: the old id stays stale after reuse", !slab.has(b));
    c.sameInt("slab: the old id does not read the new tenant", slab.getOr(b, nothing).a as i64, -1);
    c.sameInt("slab: the new id reads the new tenant", slab.get(e).a as i64, 4);
    c.that(
        "slab: ids of untouched entries stay live across slot reuse",
        slab.has(a) && slab.has(d)
    );
    c.that("slab: the none id is never live", !slab.has(EntityId::none()));
    c.that("slab: an id beyond the slots is not live", !slab.has(EntityId::make(99, 1)));

    slab.remove(a);
    slab.remove(d);
    let first : EntityId = slab.insert(CollPair { a: 5, b: 5.0 });
    let second : EntityId = slab.insert(CollPair { a: 6, b: 6.0 });
    c.sameInt("slab: most recently freed slot is reused first", first.index as i64, d.index as i64);
    c.sameInt("slab: then the earlier one", second.index as i64, a.index as i64);

    c.sameInt("slab: slotCount counts the three slots ever allocated", slab.slotCount() as i64, 3);
    let mut sum : i32 = 0;
    for (slot of 0..slab.slotCount()) {
        if (slab.isLiveAt(slot)) {
            sum = sum + slab.valueAt(slot).a;
        }
    }
    c.sameInt("slab: walking the slots sees the live values", sum as i64, 4 + 5 + 6);
    c.that("slab: idAt names the live value", slab.get(slab.idAt(0)).a == slab.valueAt(0).a);

    let many : Slab<i64> = new Slab<i64>();
    let ids : Vec<EntityId> = new Vec<EntityId>();
    for (i of 0..1000) {
        ids.push(many.insert(i as i64));
    }
    let mut readable : bool = true;
    for (i of 0..1000) {
        if (many.get(ids.get(i)) != i as i64) {
            readable = false;
        }
    }
    c.that("slab: 1000 values keep their ids across growth", readable);
}

fn collRingChecks(c : Checks) : void {
    let r : Ring<i32> = new Ring<i32>(4);
    c.that("ring: a new ring is empty and not full", r.isEmpty() && !r.isFull());
    c.sameInt("ring: capacity is the requested four", r.capacity() as i64, 4);
    c.sameInt("ring: popOr on an empty ring returns the fallback", r.popOr(-1) as i64, -1);
    for (i of 0..4) {
        c.that("ring: push succeeds while there is room", r.push(i));
    }
    c.that("ring: a ring filled to capacity reports full", r.isFull());
    c.that("ring: push is refused when full", !r.push(9));
    c.sameInt("ring: a refused push changes nothing", r.len() as i64, 4);
    c.sameInt("ring: get(0) is the oldest element", r.get(0) as i64, 0);
    c.sameInt("ring: get(3) is the newest element", r.get(3) as i64, 3);
    c.sameInt("ring: pop is first in, first out", r.pop() as i64, 0);
    c.that("ring: push after pop wraps", r.push(4));
    c.sameInt("ring: age order across the wrap (0)", r.get(0) as i64, 1);
    c.sameInt("ring: age order across the wrap (3)", r.get(3) as i64, 4);

    c.that("ring: overwrite reports the drop", r.pushOverwrite(5));
    c.sameInt("ring: overwrite dropped the oldest", r.get(0) as i64, 2);
    c.sameInt("ring: overwrite kept the length", r.len() as i64, 4);
    c.sameInt("ring: the overwriting push becomes the newest element", r.get(3) as i64, 5);

    let mut drained : i32 = 0;
    while (!r.isEmpty()) {
        drained = drained * 10 + r.pop();
    }
    c.sameInt("ring: popping drains the remaining elements oldest first", drained as i64, 2345);
    r.push(1);
    r.clear();
    c.that("ring: clear leaves the ring empty", r.isEmpty());
    c.that("ring: not full below capacity so overwrite drops nothing", !r.pushOverwrite(7));

    let one : Ring<i32> = new Ring<i32>(0);
    c.sameInt("ring: capacity floors at 1", one.capacity() as i64, 1);
    let mut cycles : i32 = 0;
    for (i of 0..50) {
        one.pushOverwrite(i);
        cycles = cycles + one.pop() - i;
    }
    c.sameInt("ring: a one-slot ring cycles", cycles as i64, 0);
}

fn collHeapChecks(c : Checks) : void {
    let h : Heap<i32> = new Heap<i32>();
    c.that("heap: a new heap is empty", h.isEmpty());
    c.sameInt("heap: popOr on an empty heap returns the fallback", h.popOr(-1) as i64, -1);
    h.push(50, 5);
    h.push(10, 1);
    h.push(30, 3);
    h.push(20, 2);
    h.push(40, 4);
    c.sameInt("heap: peekKey returns the lowest key", h.peekKey(), 10);
    c.sameInt("heap: peek returns the value under the lowest key", h.peek() as i64, 1);
    c.sameInt("heap: peek does not remove the element", h.len() as i64, 5);
    let mut order : i32 = 0;
    while (!h.isEmpty()) {
        order = order * 10 + h.pop();
    }
    c.sameInt("heap: pops by ascending key", order as i64, 12345);

    h.push(7, 100);
    h.push(7, 200);
    h.push(3, 50);
    h.push(7, 300);
    h.push(3, 60);
    c.sameInt("heap: the lowest key pops first", h.pop() as i64, 50);
    c.sameInt("heap: equal keys pop in push order (1)", h.pop() as i64, 60);
    c.sameInt("heap: equal keys pop in push order (2)", h.pop() as i64, 100);
    c.sameInt("heap: equal keys pop in push order (3)", h.pop() as i64, 200);
    c.sameInt("heap: equal keys pop in push order (4)", h.pop() as i64, 300);

    h.push(-5, 1);
    h.push(5, 2);
    c.sameInt("heap: negative keys sort first", h.pop() as i64, 1);
    h.clear();
    c.that("heap: clear leaves the heap empty", h.isEmpty());

    let maxFirst : Heap<i32> = new Heap<i32>();
    for (i of 0..5) {
        maxFirst.push(0 - i as i64, i);
    }
    c.sameInt("heap: negated keys make a max-heap", maxFirst.pop() as i64, 4);

    // 2000 pseudo-random keys must come out in sorted order, with duplicates in push order.
    let big : Heap<i32> = new Heap<i32>();
    let mut seed : i64 = 12345;
    for (i of 0..2000) {
        seed = (seed * COLL_LCG_MUL + COLL_LCG_ADD) >>> 1;
        big.push(seed % 97, i);
    }
    let mut sorted : bool = true;
    let mut lastKey : i64 = -1;
    let mut lastSerial : i32 = -1;
    while (!big.isEmpty()) {
        let key : i64 = big.peekKey();
        let serial : i32 = big.pop();
        if (key < lastKey || (key == lastKey && serial < lastSerial)) {
            sorted = false;
        }
        lastKey = key;
        lastSerial = serial;
    }
    c.that("heap: 2000 random pushes pop sorted and stable", sorted);
}

fn collBitSetChecks(c : Checks) : void {
    let s : BitSet = new BitSet();
    c.that("bitset: a new set is empty with count zero", s.isEmpty() && s.count() == 0);
    c.that("bitset: bits past the end read clear", !s.has(1000));
    c.that("bitset: a negative bit reads clear", !s.has(-1));
    s.set(0);
    s.set(63);
    s.set(64);
    s.set(1000);
    c.that(
        "bitset: set marks bits across word boundaries",
        s.has(0) && s.has(63) && s.has(64) && s.has(1000)
    );
    c.that(
        "bitset: bits next to set bits stay clear",
        !s.has(1) && !s.has(62) && !s.has(65) && !s.has(999)
    );
    c.sameInt("bitset: count is the four bits set", s.count() as i64, 4);
    c.sameInt("bitset: nextSet from 0 finds bit 0", s.nextSet(0) as i64, 0);
    c.sameInt("bitset: nextSet crosses a word edge", s.nextSet(1) as i64, 63);
    c.sameInt("bitset: nextSet starting on a set bit returns that bit", s.nextSet(64) as i64, 64);
    c.sameInt("bitset: nextSet skips empty words", s.nextSet(65) as i64, 1000);
    c.sameInt("bitset: nextSet past the last", s.nextSet(1001) as i64, -1);
    c.sameInt("bitset: nextSet beyond the storage", s.nextSet(100000) as i64, -1);
    s.unset(63);
    s.unset(5000);
    s.unset(-4);
    c.that("bitset: unset clears only the named bit", !s.has(63) && s.has(64));
    c.sameInt("bitset: count drops by one after unset", s.count() as i64, 3);

    let other : BitSet = new BitSet(10);
    other.set(64);
    other.set(7);
    s.intersectWith(other);
    c.sameInt("bitset: intersect keeps the common bit", s.count() as i64, 1);
    c.that("bitset: the surviving member after intersect is bit 64", s.has(64));
    s.unionWith(other);
    c.sameInt("bitset: union count is the two distinct members", s.count() as i64, 2);
    c.that("bitset: union contains both operands' members", s.has(7) && s.has(64));
    other.set(200);
    s.unionWith(other);
    c.that("bitset: union grows to fit", s.has(200));
    s.subtract(other);
    c.that("bitset: subtracting an equal set leaves it empty", s.isEmpty());

    s.set(130);
    s.clear();
    c.that("bitset: clear empties the set", s.isEmpty() && !s.has(130));

    let all : BitSet = new BitSet();
    for (i of 0..300) {
        all.set(i);
    }
    let mut walked : i32 = 0;
    let mut bit : i32 = all.nextSet(0);
    while (bit >= 0) {
        walked = walked + 1;
        bit = all.nextSet(bit + 1);
    }
    c.sameInt("bitset: walking with nextSet visits every member", walked as i64, 300);
}

fn collMapChecks(c : Checks) : void {
    let m : Map<i64, i32> = new Map<i64, i32>();
    c.that("map: a new map is empty with no first slot", m.isEmpty() && m.first() == -1);
    c.that("map: put of a new key reports it as new", m.put(30, 3));
    m.put(10, 1);
    m.put(20, 2);
    c.that("map: put of an existing key reports a replacement", !m.put(10, 11));
    c.sameInt("map: three distinct keys give length 3", m.len() as i64, 3);
    c.sameInt("map: get returns the replaced value", m.get(10) as i64, 11);
    c.sameInt("map: getOr on an absent key returns the fallback", m.getOr(99, -1) as i64, -1);
    c.that(
        "map: has is true for a present key and false for an absent one",
        m.has(20) && !m.has(21)
    );
    c.that(
        "map: negative and zero keys",
        m.put(0, 0) && m.put(-5, 5) && m.get(-5) == 5 && m.get(0) == 0
    );
    m.remove(0);
    m.remove(-5);

    let mut keys : i64 = 0;
    let mut slot : i32 = m.first();
    while (slot >= 0) {
        keys = keys * 100 + m.keyAt(slot);
        slot = m.next(slot);
    }
    c.sameInt("map: iterates in insertion order, a replaced key keeping its place", keys, 301020);

    c.that("map: removing a present key reports true", m.remove(30));
    c.that("map: removing the same key again reports false", !m.remove(30));
    c.that("map: removed key is gone", !m.has(30) && m.getOr(30, -1) == -1);
    c.that("map: put after remove is new", m.put(30, 33));
    slot = m.first();
    keys = 0;
    while (slot >= 0) {
        keys = keys * 100 + m.keyAt(slot);
        slot = m.next(slot);
    }
    c.sameInt("map: a re-put key moves to the end", keys, 102030);

    slot = m.find(20);
    m.setValueAt(slot, 222);
    c.sameInt("map: setValueAt overwrites the value in a slot", m.get(20) as i64, 222);
    c.sameInt("map: valueAt reads the value in a slot", m.valueAt(slot) as i64, 222);

    m.clear();
    c.that(
        "map: clear empties the map and forgets its keys",
        m.isEmpty() && !m.has(10) && m.first() == -1
    );
    c.that("map: the map accepts puts after a clear", m.put(1, 1) && m.get(1) == 1);

    let big : Map<i64, i64> = new Map<i64, i64>();
    for (i of 0..5000) {
        big.put(i as i64 * 7919, i as i64);
    }
    let mut found : bool = big.len() == 5000;
    for (i of 0..5000) {
        if (big.getOr(i as i64 * 7919, -1) != i as i64) {
            found = false;
        }
    }
    c.that("map: 5000 keys survive growth", found);
    let mut expect : i64 = 0;
    let mut inOrder : bool = true;
    let mut s : i32 = big.first();
    while (s >= 0) {
        if (big.valueAt(s) != expect) {
            inOrder = false;
        }
        expect = expect + 1;
        s = big.next(s);
    }
    c.that("map: iteration after growth is still insertion order", inOrder && expect == 5000);

    let narrow : Map<i32, f64> = new Map<i32, f64>();
    narrow.put(4, 4.5);
    narrow.put(-2, 2.5);
    c.that("map: i32 keys, f64 values", narrow.get(4) == 4.5 && narrow.get(-2) == 2.5);

    let pairs : Map<i64, CollPair> = new Map<i64, CollPair>();
    pairs.put(1, CollPair { a: 10, b: 0.5 });
    pairs.put(2, CollPair { a: 20, b: 1.5 });
    c.sameInt("map: struct values are stored and read back", pairs.get(2).a as i64, 20);
    c.near("map: struct values, f64 field", pairs.get(1).b, 0.5, 0.0);
}

// Removes and re-inserts so the entry array fills with holes and is compacted many times.
fn collMapChurn(c : Checks) : void {
    let m : Map<i64, i64> = new Map<i64, i64>();
    for (round of 0..200) {
        for (i of 0..30) {
            m.put((round * 100 + i) as i64, 1);
        }
        for (i of 0..30) {
            if (i % 3 != 0) {
                m.remove((round * 100 + i) as i64);
            }
        }
    }
    c.sameInt(
        "map churn: length is 2000 live entries after ten rounds of inserts and removals",
        m.len() as i64,
        200 * 10
    );
    let mut ordered : bool = true;
    let mut lastKey : i64 = -1;
    let mut n : i32 = 0;
    let mut s : i32 = m.first();
    while (s >= 0) {
        if (m.keyAt(s) <= lastKey) {
            ordered = false;
        }
        lastKey = m.keyAt(s);
        n = n + 1;
        s = m.next(s);
    }
    c.that("map churn: holes skipped, order kept through compaction", ordered && n == 2000);
    c.that("map churn: removed keys stay gone", !m.has(1) && !m.has(52) && m.has(0) && m.has(3));

    let fill : Map<i64, i64> = new Map<i64, i64>();
    for (i of 0..100) {
        fill.put(i as i64, 0);
        fill.remove(i as i64);
    }
    c.that("map churn: an always-empty map stays empty", fill.isEmpty() && fill.first() == -1);
}

fn collStringMapChecks(c : Checks) : void {
    let m : StringMap<i32> = new StringMap<i32>();
    for (i of 0..300) {
        let key : string = "entity_${i}_with_a_long_enough_name";
        m.put(key, i);
    }
    c.sameInt("string map: 300 puts give length 300", m.len() as i64, 300);
    let fresh : string = "entity_" + "123_with_a_long_enough_name";
    c.sameInt("string map: lookup by a fresh equal string", m.get(fresh) as i64, 123);
    c.that(
        "string map: near misses are absent",
        !m.has("entity_123") && !m.has("") && m.find("nope") == -1
    );
    c.that("string map: put reports new and replace", m.put("", 7) && !m.put("", 8));
    c.sameInt("string map: the empty string is a key", m.get("") as i64, 8);
    c.that(
        "string map: removing a present long key succeeds",
        m.remove("entity_5_with_a_long_enough_name")
    );
    c.that("string map: removed key is gone", !m.has("entity_5_with_a_long_enough_name"));
    c.that("string map: removing an unknown key", !m.remove("never seen"));
    c.sameInt(
        "string map: getOr absent",
        m.getOr("entity_5_with_a_long_enough_name", -1) as i64,
        -1
    );
    c.that(
        "string map: insertion order (key survives its loop variable)",
        m.keyAt(m.first()) == "entity_0_with_a_long_enough_name"
    );
    c.that("string map: put after remove goes last", m.put("entity_5_with_a_long_enough_name", 55));
    let mut last : i32 = m.first();
    let mut slot : i32 = last;
    while (slot >= 0) {
        last = slot;
        slot = m.next(slot);
    }
    c.that(
        "string map: a re-put key moves to the end",
        m.keyAt(last) == "entity_5_with_a_long_enough_name"
    );
    m.setValueAt(last, 56);
    c.sameInt(
        "string map: setValueAt overwrites the value in a slot",
        m.get("entity_5_with_a_long_enough_name") as i64,
        56
    );
    m.clear();
    c.that(
        "string map: clear empties the map and forgets its keys",
        m.isEmpty() && !m.has("") && m.first() == -1
    );
    c.that(
        "string map: the map accepts puts after a clear",
        m.put("again", 1) && m.get("again") == 1
    );
}

// math_geom — boxes, balls, planes, rays and the tests between them.
//
// Each shape is checked first on its own terms and then in the tests that combine two, because the interesting
// failures live at the boundaries: a ray grazing a face, a box that only touches another. The degenerate inputs
// (an empty box, a zero-direction ray, a zero-normal plane) state the contract a caller relies on, which is a
// definite answer rather than an abort. The frustum is in `math_frustum`.

use ludax::Aabb;
use ludax::Checks;
use ludax::HALF_PI;
use ludax::Mat4;
use ludax::Plane;
use ludax::Ray;
use ludax::RayHit;
use ludax::Sphere;
use ludax::Vec3;
use ludax::aabbOverlap;
use ludax::rayAabb;
use ludax::rayPlane;
use ludax::raySphere;
use ludax::rayTriangle;
use ludax::sphereAabbOverlap;
use ludax::sphereOverlap;

use crate::math_support::{MATH_TOL, MATH_TOL_LOOSE};

/** The geometry checks. */
pub class MathGeomSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        geomTestAabb(c);
        geomTestEmpty(c);
        geomTestTransformed(c);
        geomTestSphereAndPlane(c);
        geomTestRayAabb(c);
        geomTestRaySphere(c);
        geomTestRayTriangle(c);
        geomTestRayPlane(c);
        geomTestOverlaps(c);
    }
}

fn geomUnitBox() : Aabb {
    return Aabb::make(Vec3::make(-1.0, -1.0, -1.0), Vec3::make(1.0, 1.0, 1.0));
}

fn geomRay(origin : Vec3, direction : Vec3) : Ray {
    return Ray::make(origin, direction);
}

fn geomTestAabb(c : Checks) : void {
    let b : Aabb = Aabb::make(Vec3::make(0.0, 1.0, 2.0), Vec3::make(4.0, 3.0, 8.0));
    nearVec3(c, "center", b.center(), Vec3::make(2.0, 2.0, 5.0), 0.0);
    nearVec3(c, "halfSize", b.halfSize(), Vec3::make(2.0, 1.0, 3.0), 0.0);
    nearVec3(c, "size", b.size(), Vec3::make(4.0, 2.0, 6.0), 0.0);
    nearF(c, "volume", b.volume(), 48.0, 0.0);
    nearF(c, "surface area", b.surfaceArea(), 2.0 * (8.0 + 12.0 + 24.0), 0.0);
    nearVec3(c, "corner 0 is min", b.corner(0), b.min, 0.0);
    nearVec3(c, "corner 7 is max", b.corner(7), b.max, 0.0);
    nearVec3(c, "corner 5 has max x and z", b.corner(5), Vec3::make(4.0, 1.0, 8.0), 0.0);
    c.that("contains an inside point", b.contains(Vec3::make(1.0, 2.0, 3.0)));
    c.that("contains a point on the surface", b.contains(Vec3::make(4.0, 3.0, 8.0)));
    c.that("does not contain an outside point", !b.contains(Vec3::make(1.0, 2.0, 8.5)));
    nearVec3(
        c,
        "fromCenterHalfSize",
        Aabb::fromCenterHalfSize(Vec3::make(2.0, 2.0, 5.0), Vec3::make(2.0, 1.0, 3.0)).max,
        b.max,
        0.0
    );
    nearVec3(
        c,
        "closestPoint of an outside point",
        b.closestPoint(Vec3::make(9.0, 2.0, 0.0)),
        Vec3::make(4.0, 2.0, 2.0),
        0.0
    );
    nearVec3(
        c,
        "closestPoint of an inside point is itself",
        b.closestPoint(Vec3::make(1.0, 2.0, 3.0)),
        Vec3::make(1.0, 2.0, 3.0),
        0.0
    );
    nearVec3(c, "inflated", b.inflated(1.0).min, Vec3::make(-1.0, 0.0, 1.0), 0.0);
    c.that(
        "containsBox",
        b.containsBox(Aabb::make(Vec3::make(1.0, 1.5, 3.0), Vec3::make(2.0, 2.0, 4.0)))
    );
    c.that("a larger box is not contained", !b.containsBox(b.inflated(0.1)));
}

fn geomTestEmpty(c : Checks) : void {
    let e : Aabb = Aabb::empty();
    c.that("empty is empty", e.isEmpty());
    c.that("a real box is not empty", !geomUnitBox().isEmpty());
    c.that("empty contains nothing", !e.contains(Vec3::zero()));
    nearF(c, "empty has no volume", e.volume(), 0.0, 0.0);
    nearF(c, "empty has no surface", e.surfaceArea(), 0.0, 0.0);
    let one : Aabb = e.expandedToPoint(Vec3::make(1.0, 2.0, 3.0));
    nearVec3(
        c,
        "growing empty by a point gives that point (min)",
        one.min,
        Vec3::make(1.0, 2.0, 3.0),
        0.0
    );
    nearVec3(
        c,
        "growing empty by a point gives that point (max)",
        one.max,
        Vec3::make(1.0, 2.0, 3.0),
        0.0
    );
    c.that("a single point box contains its point", one.contains(Vec3::make(1.0, 2.0, 3.0)));
    nearVec3(
        c,
        "merging with empty changes nothing",
        geomUnitBox().merged(e).max,
        Vec3::make(1.0, 1.0, 1.0),
        0.0
    );
    let m : Aabb = geomUnitBox().merged(Aabb::make(
        Vec3::make(2.0, -3.0, 0.0),
        Vec3::make(5.0, 0.0, 0.5)
    ));
    nearVec3(c, "merged min", m.min, Vec3::make(-1.0, -3.0, -1.0), 0.0);
    nearVec3(c, "merged max", m.max, Vec3::make(5.0, 1.0, 1.0), 0.0);
    c.that("an empty box is not contained", !geomUnitBox().containsBox(e));
    c.that(
        "empty is never hit by a ray",
        !rayAabb(geomRay(Vec3::make(0.0, 0.0, 5.0), Vec3::make(0.0, 0.0, -1.0)), e).hit
    );
    c.that(
        "empty overlaps nothing",
        !aabbOverlap(e, geomUnitBox()) && !aabbOverlap(geomUnitBox(), e)
    );
    c.that(
        "a sphere does not overlap empty",
        !sphereAabbOverlap(Sphere::make(Vec3::zero(), 5.0), e)
    );
}

fn geomTestTransformed(c : Checks) : void {
    let b : Aabb = Aabb::make(Vec3::make(0.0, 0.0, 0.0), Vec3::make(2.0, 1.0, 1.0));
    let turned : Aabb = b.transformed(Mat4::rotationZ(HALF_PI));
    nearVec3(
        c,
        "a box turned a quarter turn about Z (min)",
        turned.min,
        Vec3::make(-1.0, 0.0, 0.0),
        MATH_TOL
    );
    nearVec3(
        c,
        "a box turned a quarter turn about Z (max)",
        turned.max,
        Vec3::make(0.0, 2.0, 1.0),
        MATH_TOL
    );
    let moved : Aabb = b.transformed(Mat4::translation(Vec3::make(5.0, 0.0, 0.0)));
    nearVec3(c, "a box moved", moved.min, Vec3::make(5.0, 0.0, 0.0), 0.0);
    let tilted : Aabb = geomUnitBox().transformed(Mat4::rotationY(0.785398));
    nearF(
        c,
        "a unit cube turned 45 degrees is sqrt(2) wide",
        tilted.max.x,
        1.41421,
        MATH_TOL_LOOSE
    );
    nearVec3(
        c,
        "a bounding sphere holds the corners",
        Sphere::enclosing(geomUnitBox()).center,
        Vec3::zero(),
        0.0
    );
    nearF(
        c,
        "its radius reaches the corners",
        Sphere::enclosing(geomUnitBox()).radius,
        1.7320508,
        MATH_TOL
    );
}

fn geomTestSphereAndPlane(c : Checks) : void {
    let s : Sphere = Sphere::make(Vec3::make(1.0, 0.0, 0.0), 2.0);
    c.that("sphere contains its centre", s.contains(s.center));
    c.that("sphere contains a surface point", s.contains(Vec3::make(3.0, 0.0, 0.0)));
    c.that("sphere excludes a far point", !s.contains(Vec3::make(3.1, 0.0, 0.0)));
    nearVec3(c, "sphere bounds", s.bounds().max, Vec3::make(3.0, 2.0, 2.0), 0.0);
    let floor : Plane = Plane::fromPointNormal(
        Vec3::make(0.0, 2.0, 0.0),
        Vec3::make(0.0, 5.0, 0.0)
    );
    nearF(
        c,
        "plane signed distance above",
        floor.signedDistance(Vec3::make(7.0, 5.0, 1.0)),
        3.0,
        0.0
    );
    nearF(
        c,
        "plane signed distance below",
        floor.signedDistance(Vec3::make(0.0, 0.0, 0.0)),
        -2.0,
        0.0
    );
    nearVec3(
        c,
        "plane closestPoint",
        floor.closestPoint(Vec3::make(7.0, 5.0, 1.0)),
        Vec3::make(7.0, 2.0, 1.0),
        0.0
    );
    nearF(
        c,
        "flipped plane negates distance",
        floor.flipped().signedDistance(Vec3::make(0.0, 5.0, 0.0)),
        -3.0,
        0.0
    );
    let tri : Plane = Plane::fromTriangle(Vec3::zero(), Vec3::unitX(), Vec3::unitY());
    nearVec3(c, "a counter-clockwise triangle faces +Z", tri.normal, Vec3::unitZ(), 0.0);
    let eq : Plane = Plane::fromEquation(0.0, 0.0, 4.0, -8.0);
    nearF(c, "fromEquation normalises", eq.d, -2.0, 0.0);
    let none : Plane = Plane::fromEquation(0.0, 0.0, 0.0, 3.0);
    c.that(
        "a zero-normal plane puts every point in front",
        none.signedDistance(Vec3::make(5.0, -9.0, 2.0)) > 0.0
    );
}

fn geomTestRayAabb(c : Checks) : void {
    let b : Aabb = geomUnitBox();
    let hit : RayHit = rayAabb(geomRay(Vec3::make(0.0, 0.0, 5.0), Vec3::make(0.0, 0.0, -1.0)), b);
    c.that("ray down -Z hits", hit.hit);
    nearF(c, "enters the +Z face", hit.t, 4.0, 0.0);
    nearF(
        c,
        "t scales with the direction length",
        rayAabb(geomRay(Vec3::make(0.0, 0.0, 5.0), Vec3::make(0.0, 0.0, -2.0)), b).t,
        2.0,
        0.0
    );
    c.that(
        "ray pointing away misses",
        !rayAabb(geomRay(Vec3::make(0.0, 0.0, 5.0), Vec3::make(0.0, 0.0, 1.0)), b).hit
    );
    c.that(
        "ray beside the box misses",
        !rayAabb(geomRay(Vec3::make(3.0, 0.0, 5.0), Vec3::make(0.0, 0.0, -1.0)), b).hit
    );
    c.that(
        "diagonal ray hits",
        rayAabb(geomRay(Vec3::make(-5.0, -5.0, -5.0), Vec3::make(1.0, 1.0, 1.0)), b).hit
    );
    nearF(
        c,
        "diagonal ray enters at the corner",
        rayAabb(geomRay(Vec3::make(-5.0, -5.0, -5.0), Vec3::make(1.0, 1.0, 1.0)), b).t,
        4.0,
        0.0
    );
    let inside : RayHit = rayAabb(geomRay(Vec3::make(0.0, 0.0, 0.0), Vec3::make(0.0, 1.0, 0.0)), b);
    c.that("ray from inside hits", inside.hit);
    nearF(c, "ray from inside reports t = 0", inside.t, 0.0, 0.0);
    let parallelIn : RayHit = rayAabb(
        geomRay(Vec3::make(-5.0, 0.5, 0.5), Vec3::make(1.0, 0.0, 0.0)),
        b
    );
    c.that("ray parallel to two slabs and inside them hits", parallelIn.hit);
    nearF(c, "parallel ray t", parallelIn.t, 4.0, 0.0);
    c.that(
        "ray parallel to a slab and outside it misses",
        !rayAabb(geomRay(Vec3::make(-5.0, 1.5, 0.0), Vec3::make(1.0, 0.0, 0.0)), b).hit
    );
    c.that(
        "ray grazing a face counts as a hit",
        rayAabb(geomRay(Vec3::make(-5.0, 1.0, 0.0), Vec3::make(1.0, 0.0, 0.0)), b).hit
    );
    c.that(
        "a zero direction inside hits at 0",
        rayAabb(geomRay(Vec3::make(0.0, 0.0, 0.0), Vec3::make(0.0, 0.0, 0.0)), b).hit
    );
    c.that(
        "a zero direction outside misses",
        !rayAabb(geomRay(Vec3::make(5.0, 0.0, 0.0), Vec3::make(0.0, 0.0, 0.0)), b).hit
    );
    c.that(
        "a ray starting past the box misses",
        !rayAabb(geomRay(Vec3::make(0.0, 0.0, -5.0), Vec3::make(0.0, 0.0, -1.0)), b).hit
    );
    let flat : Aabb = Aabb::make(Vec3::make(-1.0, 0.0, -1.0), Vec3::make(1.0, 0.0, 1.0));
    c.that(
        "a zero-thickness box is hit head-on",
        rayAabb(geomRay(Vec3::make(0.0, 3.0, 0.0), Vec3::make(0.0, -1.0, 0.0)), flat).hit
    );
}

fn geomTestRaySphere(c : Checks) : void {
    let s : Sphere = Sphere::make(Vec3::zero(), 2.0);
    let hit : RayHit = raySphere(
        geomRay(Vec3::make(0.0, 0.0, 10.0), Vec3::make(0.0, 0.0, -1.0)),
        s
    );
    c.that("ray hits the sphere", hit.hit);
    nearF(c, "first contact", hit.t, 8.0, MATH_TOL);
    nearF(
        c,
        "t scales with direction length",
        raySphere(geomRay(Vec3::make(0.0, 0.0, 10.0), Vec3::make(0.0, 0.0, -4.0)), s).t,
        2.0,
        MATH_TOL
    );
    c.that(
        "ray beside the sphere misses",
        !raySphere(geomRay(Vec3::make(2.5, 0.0, 10.0), Vec3::make(0.0, 0.0, -1.0)), s).hit
    );
    c.that(
        "ray pointing away misses",
        !raySphere(geomRay(Vec3::make(0.0, 0.0, 10.0), Vec3::make(0.0, 0.0, 1.0)), s).hit
    );
    c.that(
        "tangent ray hits",
        raySphere(geomRay(Vec3::make(2.0, 0.0, 10.0), Vec3::make(0.0, 0.0, -1.0)), s).hit
    );
    let inside : RayHit = raySphere(
        geomRay(Vec3::make(0.5, 0.0, 0.0), Vec3::make(1.0, 0.0, 0.0)),
        s
    );
    c.that("ray from inside hits", inside.hit);
    nearF(c, "ray from inside reports t = 0", inside.t, 0.0, 0.0);
    c.that(
        "a zero direction misses, not a trap",
        !raySphere(geomRay(Vec3::make(0.0, 0.0, 10.0), Vec3::make(0.0, 0.0, 0.0)), s).hit
    );
    c.that(
        "a zero-radius sphere is hit exactly through its centre",
        raySphere(
            geomRay(Vec3::make(0.0, 0.0, 10.0), Vec3::make(0.0, 0.0, -1.0)),
            Sphere::make(Vec3::zero(), 0.0)
        ).hit
    );
    let off : RayHit = raySphere(
        geomRay(Vec3::make(0.0, 1.0, 10.0), Vec3::make(0.0, 0.0, -1.0)),
        s
    );
    nearF(c, "off-centre contact", off.t, 10.0 - 1.7320508, MATH_TOL_LOOSE);
}

fn geomTestRayTriangle(c : Checks) : void {
    let a : Vec3 = Vec3::make(0.0, 0.0, 0.0);
    let b : Vec3 = Vec3::make(2.0, 0.0, 0.0);
    let d : Vec3 = Vec3::make(0.0, 2.0, 0.0);
    let hit : RayHit = rayTriangle(
        geomRay(Vec3::make(0.5, 0.5, 3.0), Vec3::make(0.0, 0.0, -1.0)),
        a,
        b,
        d,
        false
    );
    c.that("ray hits the triangle", hit.hit);
    nearF(c, "distance", hit.t, 3.0, MATH_TOL);
    nearF(c, "barycentric u (weight of the second vertex)", hit.u, 0.25, MATH_TOL);
    nearF(c, "barycentric v (weight of the third vertex)", hit.v, 0.25, MATH_TOL);
    c.that(
        "ray outside the triangle misses",
        !rayTriangle(
            geomRay(Vec3::make(1.5, 1.5, 3.0), Vec3::make(0.0, 0.0, -1.0)),
            a,
            b,
            d,
            false
        ).hit
    );
    c.that(
        "ray beyond an edge misses",
        !rayTriangle(
            geomRay(Vec3::make(-0.1, 0.5, 3.0), Vec3::make(0.0, 0.0, -1.0)),
            a,
            b,
            d,
            false
        ).hit
    );
    c.that(
        "ray parallel to the triangle misses",
        !rayTriangle(
            geomRay(Vec3::make(0.5, 0.5, 3.0), Vec3::make(1.0, 0.0, 0.0)),
            a,
            b,
            d,
            false
        ).hit
    );
    c.that(
        "ray pointing away misses",
        !rayTriangle(
            geomRay(Vec3::make(0.5, 0.5, 3.0), Vec3::make(0.0, 0.0, 1.0)),
            a,
            b,
            d,
            false
        ).hit
    );
    c.that(
        "the back face is hit without culling",
        rayTriangle(
            geomRay(Vec3::make(0.5, 0.5, -3.0), Vec3::make(0.0, 0.0, 1.0)),
            a,
            b,
            d,
            false
        ).hit
    );
    c.that(
        "the back face is missed with culling",
        !rayTriangle(
            geomRay(Vec3::make(0.5, 0.5, -3.0), Vec3::make(0.0, 0.0, 1.0)),
            a,
            b,
            d,
            true
        ).hit
    );
    c.that(
        "the front face is hit with culling",
        rayTriangle(
            geomRay(Vec3::make(0.5, 0.5, 3.0), Vec3::make(0.0, 0.0, -1.0)),
            a,
            b,
            d,
            true
        ).hit
    );
    c.that(
        "a degenerate triangle is never hit",
        !rayTriangle(
            geomRay(Vec3::make(0.5, 0.0, 3.0), Vec3::make(0.0, 0.0, -1.0)),
            a,
            b,
            Vec3::make(1.0, 0.0, 0.0),
            false
        ).hit
    );
    c.that(
        "a ray through a vertex hits",
        rayTriangle(
            geomRay(Vec3::make(0.0, 0.0, 3.0), Vec3::make(0.0, 0.0, -1.0)),
            a,
            b,
            d,
            false
        ).hit
    );
    c.that(
        "a ray through the hypotenuse hits",
        rayTriangle(
            geomRay(Vec3::make(1.0, 1.0, 3.0), Vec3::make(0.0, 0.0, -1.0)),
            a,
            b,
            d,
            false
        ).hit
    );
    nearVec3(
        c,
        "the contact point is recovered from u and v",
        a.plus(b.minus(a).scale(hit.u)).plus(d.minus(a).scale(hit.v)),
        Vec3::make(0.5, 0.5, 0.0),
        MATH_TOL
    );
}

fn geomTestRayPlane(c : Checks) : void {
    let floor : Plane = Plane::fromPointNormal(Vec3::zero(), Vec3::unitY());
    nearF(
        c,
        "ray hits the floor",
        rayPlane(geomRay(Vec3::make(0.0, 4.0, 0.0), Vec3::make(0.0, -2.0, 0.0)), floor).t,
        2.0,
        0.0
    );
    c.that(
        "ray parallel to the plane misses",
        !rayPlane(geomRay(Vec3::make(0.0, 4.0, 0.0), Vec3::make(1.0, 0.0, 0.0)), floor).hit
    );
    c.that(
        "ray pointing away from the plane misses",
        !rayPlane(geomRay(Vec3::make(0.0, 4.0, 0.0), Vec3::make(0.0, 1.0, 0.0)), floor).hit
    );
    c.that(
        "ray from below hits too",
        rayPlane(geomRay(Vec3::make(0.0, -4.0, 0.0), Vec3::make(0.0, 1.0, 0.0)), floor).hit
    );
    nearVec3(
        c,
        "Ray.at",
        geomRay(Vec3::make(1.0, 2.0, 3.0), Vec3::make(0.0, 0.0, -1.0)).at(2.0),
        Vec3::make(1.0, 2.0, 1.0),
        0.0
    );
    nearVec3(
        c,
        "Ray.between has a unit direction",
        Ray::between(Vec3::zero(), Vec3::make(0.0, 0.0, -9.0)).direction,
        Vec3::make(0.0, 0.0, -1.0),
        0.0
    );
}

fn geomTestOverlaps(c : Checks) : void {
    let a : Aabb = geomUnitBox();
    c.that(
        "boxes overlap",
        aabbOverlap(a, Aabb::make(Vec3::make(0.5, 0.5, 0.5), Vec3::make(3.0, 3.0, 3.0)))
    );
    c.that(
        "boxes that touch overlap",
        aabbOverlap(a, Aabb::make(Vec3::make(1.0, -1.0, -1.0), Vec3::make(2.0, 1.0, 1.0)))
    );
    c.that(
        "separated boxes do not",
        !aabbOverlap(a, Aabb::make(Vec3::make(1.01, -1.0, -1.0), Vec3::make(2.0, 1.0, 1.0)))
    );
    c.that(
        "separated on one axis only is separated",
        !aabbOverlap(a, Aabb::make(Vec3::make(-1.0, -1.0, 4.0), Vec3::make(1.0, 1.0, 5.0)))
    );
    c.that("a box overlaps itself", aabbOverlap(a, a));
    c.that(
        "a contained box overlaps",
        aabbOverlap(a, Aabb::make(Vec3::splat(-0.1), Vec3::splat(0.1)))
    );
    let s : Sphere = Sphere::make(Vec3::zero(), 1.0);
    c.that("spheres overlap", sphereOverlap(s, Sphere::make(Vec3::make(1.5, 0.0, 0.0), 1.0)));
    c.that(
        "spheres that touch overlap",
        sphereOverlap(s, Sphere::make(Vec3::make(2.0, 0.0, 0.0), 1.0))
    );
    c.that(
        "separated spheres do not",
        !sphereOverlap(s, Sphere::make(Vec3::make(2.1, 0.0, 0.0), 1.0))
    );
    c.that(
        "a sphere inside another overlaps",
        sphereOverlap(s, Sphere::make(Vec3::make(0.1, 0.0, 0.0), 0.2))
    );
    c.that(
        "sphere and box overlap",
        sphereAabbOverlap(Sphere::make(Vec3::make(2.0, 0.0, 0.0), 1.5), a)
    );
    c.that(
        "sphere and box that touch overlap",
        sphereAabbOverlap(Sphere::make(Vec3::make(2.0, 0.0, 0.0), 1.0), a)
    );
    c.that(
        "sphere near a corner but outside the box does not overlap",
        !sphereAabbOverlap(Sphere::make(Vec3::make(2.0, 2.0, 2.0), 1.5), a)
    );
    c.that(
        "sphere centred inside the box overlaps",
        sphereAabbOverlap(Sphere::make(Vec3::zero(), 0.1), a)
    );
}

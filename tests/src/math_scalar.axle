// math_scalar — the scalar constants and one-number helpers, f32 and f64.
//
// Each check names one function and its answer, so a failure points at the helper rather than the suite. The
// f64 twins are checked separately because they are generated from the f32 originals: a drift there would
// otherwise only show up later as a position in the world that no longer lands where it should.

use ludax::{Checks, PI, TAU, HALF_PI, DEG2RAD, RAD2DEG, EPSILON, PI_D, TAU_D, HUGE};
use ludax::{approxEq, approxEqWithin, toRadians, toDegrees, wrapAngle, isFinite};
use ludax::{
    min, max, abs, sign, clamp, saturate, lerp, inverseLerp, remap, smoothstep, smootherstep
};
use ludax::{
    minD, maxD, absD, signD, clampD, saturateD, lerpD, remapD, smoothstepD, approxEqD, wrapAngleD
};
use ludax::{toRadiansD, toDegreesD, inverseLerpD};

use crate::math_support::{MATH_TOL, MATH_TOL_TIGHT, nearF};

fn scalarConstants(c : Checks) : void {
    c.near(
        "scalar: PI is 3.14159265358979 to f32 precision",
        PI as f64,
        3.14159265358979,
        0.0000001
    );
    c.near("TAU is twice PI", TAU as f64, 2.0 * (PI as f64), 0.0);
    c.near("HALF_PI is half of PI", HALF_PI as f64, 0.5 * (PI as f64), 0.0);
    c.near("DEG2RAD * RAD2DEG is 1", (DEG2RAD * RAD2DEG) as f64, 1.0, MATH_TOL_TIGHT);
    c.that("EPSILON is small and positive", EPSILON > 0.0 && EPSILON < 0.0001);
    c.near("scalar: PI_D keeps all digits of pi", PI_D, 3.141592653589793, 0.0);
    c.near("scalar: TAU_D is 2 pi to full precision", TAU_D, 6.283185307179586, 0.0);
    c.that(
        "HUGE exceeds any coordinate and is finite",
        HUGE > 100000000000000000000.0 && isFinite(HUGE)
    );
}

fn scalarOrdering(c : Checks) : void {
    nearF(c, "min", min(2.0, 3.0), 2.0, 0.0);
    nearF(c, "max", max(2.0, 3.0), 3.0, 0.0);
    nearF(c, "abs of a negative", abs(-4.5), 4.5, 0.0);
    nearF(c, "sign positive", sign(9.0), 1.0, 0.0);
    nearF(c, "sign negative", sign(-0.001), -1.0, 0.0);
    nearF(c, "sign zero", sign(0.0), 0.0, 0.0);
    nearF(c, "clamp inside", clamp(0.5, 0.0, 1.0), 0.5, 0.0);
    nearF(c, "clamp below", clamp(-3.0, 0.0, 1.0), 0.0, 0.0);
    nearF(c, "clamp above", clamp(3.0, 0.0, 1.0), 1.0, 0.0);
    nearF(c, "saturate", saturate(1.7), 1.0, 0.0);
    nearF(c, "saturate below", saturate(-1.7), 0.0, 0.0);
}

fn scalarInterpolation(c : Checks) : void {
    nearF(c, "lerp start", lerp(2.0, 6.0, 0.0), 2.0, 0.0);
    nearF(c, "lerp end", lerp(2.0, 6.0, 1.0), 6.0, 0.0);
    nearF(c, "lerp middle", lerp(2.0, 6.0, 0.5), 4.0, 0.0);
    nearF(c, "lerp extrapolates", lerp(2.0, 6.0, 2.0), 10.0, 0.0);
    nearF(c, "inverseLerp", inverseLerp(2.0, 6.0, 3.0), 0.25, 0.0);
    nearF(
        c,
        "inverseLerp of an empty range is 0, not a trap",
        inverseLerp(3.0, 3.0, 5.0),
        0.0,
        0.0
    );
    nearF(c, "remap", remap(5.0, 0.0, 10.0, 100.0, 200.0), 150.0, 0.0);
    nearF(c, "remap reversed range", remap(2.0, 0.0, 10.0, 1.0, 0.0), 0.8, MATH_TOL_TIGHT);
    nearF(c, "remap with an empty input range", remap(2.0, 1.0, 1.0, 5.0, 9.0), 5.0, 0.0);
    nearF(c, "smoothstep below", smoothstep(0.0, 1.0, -1.0), 0.0, 0.0);
    nearF(c, "smoothstep above", smoothstep(0.0, 1.0, 2.0), 1.0, 0.0);
    nearF(c, "smoothstep middle", smoothstep(0.0, 1.0, 0.5), 0.5, 0.0);
    nearF(c, "smoothstep is flat at the start", smoothstep(0.0, 1.0, 0.01), 0.000298, 0.0000001);
    nearF(c, "smoothstep between other edges", smoothstep(10.0, 20.0, 15.0), 0.5, 0.0);
    nearF(c, "smoothstep with equal edges steps", smoothstep(1.0, 1.0, 1.5), 1.0, 0.0);
    nearF(c, "smoothstep with equal edges below", smoothstep(1.0, 1.0, 0.5), 0.0, 0.0);
    nearF(c, "smootherstep middle", smootherstep(0.0, 1.0, 0.5), 0.5, 0.0);
    nearF(c, "smootherstep end", smootherstep(0.0, 1.0, 1.0), 1.0, 0.0);
}

fn scalarComparison(c : Checks) : void {
    c.that("approxEq of equal numbers", approxEq(1.0, 1.0));
    c.that("approxEq of a tiny difference", approxEq(1.0, 1.0000005));
    c.that("approxEq rejects a real difference", !approxEq(1.0, 1.001));
    c.that("approxEq is relative for large numbers", approxEq(1000000.0, 1000000.5));
    c.that(
        "approxEqWithin uses the given tolerance",
        approxEqWithin(1.0, 1.4, 0.5) && !approxEqWithin(1.0, 1.6, 0.5)
    );
    nearF(c, "toRadians", toRadians(180.0), PI, MATH_TOL_TIGHT);
    nearF(c, "toDegrees", toDegrees(HALF_PI), 90.0, MATH_TOL);
    nearF(c, "wrapAngle leaves small angles", wrapAngle(1.0), 1.0, 0.0);
    nearF(c, "wrapAngle brings 2.5 pi back", wrapAngle(2.5 * PI), HALF_PI, MATH_TOL);
    nearF(c, "wrapAngle of a negative", wrapAngle(-1.5 * PI), HALF_PI, MATH_TOL);
}

fn scalarDoubles(c : Checks) : void {
    c.near("scalar: minD(2, 3) is 2", minD(2.0, 3.0), 2.0, 0.0);
    c.near("scalar: maxD(2, 3) is 3", maxD(2.0, 3.0), 3.0, 0.0);
    c.near("scalar: absD(-4.5) is 4.5", absD(-4.5), 4.5, 0.0);
    c.near("scalar: signD of a negative is -1", signD(-9.0), -1.0, 0.0);
    c.near("scalar: clampD(3, 0, 1) is 1", clampD(3.0, 0.0, 1.0), 1.0, 0.0);
    c.near("scalar: saturateD(-3) is 0", saturateD(-3.0), 0.0, 0.0);
    c.near("scalar: lerpD(2, 6, 0.25) is 3", lerpD(2.0, 6.0, 0.25), 3.0, 0.0);
    c.near("scalar: inverseLerpD over an empty range is 0", inverseLerpD(1.0, 1.0, 4.0), 0.0, 0.0);
    c.near(
        "scalar: remapD maps 5 in 0..10 to 150 in 100..200",
        remapD(5.0, 0.0, 10.0, 100.0, 200.0),
        150.0,
        0.0
    );
    c.near("scalar: smoothstepD at the midpoint is 0.5", smoothstepD(0.0, 1.0, 0.5), 0.5, 0.0);
    c.that(
        "scalar: approxEqD accepts a 1e-13 difference and refuses 1e-6",
        approxEqD(1.0, 1.0 + 0.0000000000001) && !approxEqD(1.0, 1.000001)
    );
    c.near(
        "scalar: toRadiansD(90) is a quarter turn",
        toRadiansD(90.0),
        TAU_D / 4.0,
        0.0000000000000005
    );
    c.near("scalar: toDegreesD(PI_D) is 180", toDegreesD(PI_D), 180.0, 0.0000000000001);
    c.near(
        "scalar: wrapAngleD(7) is 7 minus a full turn",
        wrapAngleD(7.0),
        7.0 - TAU_D,
        0.000000000000001
    );
    c.near(
        "wrapAngleD of a huge value does not overflow",
        wrapAngleD(1000000000000000000000000.0),
        0.0,
        0.0
    );
}

/** The scalar suite. */
pub class MathScalarSuite {
    /** Runs the scalar checks. */
    pub static fn run(c : Checks) : void {
        scalarConstants(c);
        scalarOrdering(c);
        scalarInterpolation(c);
        scalarComparison(c);
        scalarDoubles(c);
    }
}

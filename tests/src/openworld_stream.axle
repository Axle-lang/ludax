// openworld_stream — checks for the world partition and the cell streamer.
//
// The properties that matter: a cell's content is a function of the world seed and the cell alone; the number
// of active cells and entities stays bounded however far the player travels; every entity a cell spawned is
// gone when the cell goes (nothing leaks); the registry knows each entity's cell; and where the player ends up
// decides what is active, not the road taken.

use ludax::CellEntry;
use ludax::CellStreamer;
use ludax::Cells;
use ludax::Checks;
use ludax::DTransform;
use ludax::EntityId;
use ludax::FlatGround;
use ludax::Pcg32;
use ludax::RollingGround;
use ludax::Scene;
use ludax::StreamConfig;
use ludax::WorldPartition;

fn strMakeWorld(seed : i64) : WorldPartition {
    let w : WorldPartition = new WorldPartition(100.0, seed);
    w.defineTemplate("tree", 3);
    w.defineTemplate("rock", 1);
    w.defineTemplate("ghost", 0);
    w.setScatter(4);
    return w;
}

fn strConfig(hysteresis : f64, loads : i32, unloads : i32) : StreamConfig {
    return StreamConfig {
        loadRadius: 300.0,
        hysteresis: hysteresis,
        maxLoads: loads,
        maxUnloads: unloads,
    };
}

/** The partition and streaming checks. */
pub class OpenworldStreamSuite {
    /** Runs every check of the suite. */
    pub static fn run(c : Checks) : void {
        strCells(c);
        strPartition(c);
        strBasics(c);
        strLongTravel(c);
        strPaths(c);
        strHysteresis(c);
        strBudgets(c);
    }
}

fn strCells(c : Checks) : void {
    c.sameInt("cells: index of a positive position", Cells::index(250.0, 100.0), 2);
    c.sameInt("cells: index at a boundary", Cells::index(300.0, 100.0), 3);
    c.sameInt("cells: index just below zero is -1", Cells::index(0.0 - 0.001, 100.0), 0 - 1);
    c.sameInt("cells: index of -100 is -1", Cells::index(0.0 - 100.0, 100.0), 0 - 1);
    c.sameInt("cells: index of -100.5 is -2", Cells::index(0.0 - 100.5, 100.0), 0 - 2);
    let mut ok : bool = true;
    let mut xs : i32[] = malloc<i32>(8);
    xs[0] = 0;
    xs[1] = 1;
    xs[2] = -1;
    xs[3] = 123456;
    xs[4] = -123456;
    xs[5] = 1000000000;
    xs[6] = -1000000000;
    xs[7] = 2147483647;
    for (a of 0..8) {
        for (b of 0..8) {
            let k : i64 = Cells::key(xs[a], xs[b]);
            if (Cells::keyX(k) != xs[a] || Cells::keyZ(k) != xs[b]) {
                ok = false;
            }
        }
    }
    c.that("cells: a key decodes to the cell it came from, extremes and negatives included", ok);
    c.that(
        "cells: different cells have different keys",
        Cells::key(1, 2) != Cells::key(2, 1) && Cells::key(0, 0) != Cells::key(0, 1)
    );
    c.near(
        "cells: distance inside the cell is 0",
        Cells::distance(0, 0, 100.0, 50.0, 50.0),
        0.0,
        0.0
    );
    c.near("cells: distance to the side", Cells::distance(1, 0, 100.0, 50.0, 50.0), 50.0, 0.000001);
    c.near(
        "cells: distance to the corner",
        Cells::distance(1, 1, 100.0, 50.0, 50.0),
        70.71067811865476,
        0.000001
    );
    c.near(
        "cells: distance in negative space",
        Cells::distance(-1, 0, 100.0, 50.0, 50.0),
        50.0,
        0.000001
    );
}

fn strPartition(c : Checks) : void {
    let w : WorldPartition = strMakeWorld(5);
    c.sameInt("partition: templates", w.templateCount(), 3);
    c.sameInt(
        "partition: defining a template twice answers the same number",
        w.defineTemplate("rock", 9),
        1
    );
    c.that("partition: template names", w.templateName(0) == "tree");
    c.that("partition: an unknown template is refused", !w.add(7, 0.0, 0.0, 0.0, 0.0));
    c.that("partition: an authored entry is accepted", w.add(0, 150.0, 2.0, 250.0, 0.5));
    w.add(1, 160.0, 2.0, 260.0, 0.0);
    c.sameInt("partition: it is in cell (1, 2)", w.countIn(Cells::key(1, 2)), 2);
    c.sameInt("partition: another cell is empty", w.countIn(Cells::key(0, 0)), 0);
    let first : CellEntry = w.entry(w.firstIn(Cells::key(1, 2)));
    c.that(
        "partition: entries come back in the order they were added",
        first.template == 0 && first.x == 150.0
    );
    c.sameInt(
        "partition: the second follows",
        w.entry(w.nextIn(w.firstIn(Cells::key(1, 2)))).template,
        1
    );
    c.sameInt(
        "partition: and then the list ends",
        w.nextIn(w.nextIn(w.firstIn(Cells::key(1, 2)))),
        -1
    );
    let ground : FlatGround = new FlatGround(3.0);
    w.ensure(1, 2, ground);
    c.sameInt("partition: an authored cell is not scattered over", w.countIn(Cells::key(1, 2)), 2);
    w.ensure(0, 0, ground);
    c.sameInt("partition: an unauthored cell gets the scatter", w.countIn(Cells::key(0, 0)), 4);
    w.ensure(0, 0, ground);
    c.sameInt("partition: ensure twice does not scatter twice", w.countIn(Cells::key(0, 0)), 4);
    let mut inside : bool = true;
    let mut onGround : bool = true;
    let mut ghosts : bool = false;
    let mut i : i32 = w.firstIn(Cells::key(0, 0));
    while (i >= 0) {
        let e : CellEntry = w.entry(i);
        if (e.x < 0.0 || e.x >= 100.0 || e.z < 0.0 || e.z >= 100.0) {
            inside = false;
        }
        if (e.y != 3.0) {
            onGround = false;
        }
        if (e.template == 2) {
            ghosts = true;
        }
        i = w.nextIn(i);
    }
    c.that("partition: scattered entries lie inside their cell", inside);
    c.that("partition: and stand on the ground", onGround);
    c.that("partition: a template of weight 0 is never picked", !ghosts);

    // The scatter depends on the seed and the cell only, not on what was visited before.
    let a : WorldPartition = strMakeWorld(77);
    let b : WorldPartition = strMakeWorld(77);
    a.ensure(5, 5, ground);
    a.ensure(-3, 9, ground);
    b.ensure(-3, 9, ground);
    b.ensure(5, 5, ground);
    let ea : CellEntry = a.entry(a.firstIn(Cells::key(5, 5)));
    let eb : CellEntry = b.entry(b.firstIn(Cells::key(5, 5)));
    c.that(
        "partition: visiting cells in another order gives the same content",
        ea.x == eb.x && ea.z == eb.z && ea.template == eb.template
    );
    let other : WorldPartition = strMakeWorld(78);
    other.ensure(5, 5, ground);
    c.that(
        "partition: another seed gives other content",
        other.entry(other.firstIn(Cells::key(5, 5))).x != ea.x
    );

    // Weights: over many cells about three trees per rock.
    let many : WorldPartition = strMakeWorld(1);
    let mut trees : i32 = 0;
    let mut rocks : i32 = 0;
    for (cz of 0..40) {
        for (cx of 0..40) {
            many.ensure(cx, cz, ground);
            let mut k : i32 = many.firstIn(Cells::key(cx, cz));
            while (k >= 0) {
                if (many.entry(k).template == 0) {
                    trees = trees + 1;
                } else {
                    rocks = rocks + 1;
                }
                k = many.nextIn(k);
            }
        }
    }
    c.sameInt("partition: every cell was filled", trees + rocks, 40 * 40 * 4);
    let ratio : f64 = trees as f64 / rocks as f64;
    c.that("partition: trees outnumber rocks about three to one", ratio > 2.6 && ratio < 3.5);
}

fn strBasics(c : Checks) : void {
    let scene : Scene = new Scene();
    let player : EntityId = scene.add("player");
    let world : WorldPartition = strMakeWorld(9);
    let ground : RollingGround = new RollingGround(2.0, 150.0);
    let s : CellStreamer = new CellStreamer(strConfig(100.0, 1000, 1000));
    s.update(scene, world, ground, 50.0, 50.0);
    // Cells whose nearest edge is within 300 m of (50, 50) with 100 m cells.
    let mut expected : i32 = 0;
    for (cz of (0 - 10)..11) {
        for (cx of (0 - 10)..11) {
            if (Cells::distance(cx, cz, 100.0, 50.0, 50.0) <= 300.0) {
                expected = expected + 1;
            }
        }
    }
    c.sameInt(
        "stream: the first update activates exactly the cells within the radius",
        s.activeCount(),
        expected
    );
    c.sameInt("stream: every activated cell was filled", s.entityCount(), expected * 4);
    c.sameInt(
        "stream: the scene holds the player and the spawned entities",
        scene.count(),
        1 + expected * 4
    );
    c.sameInt("stream: lastLoaded", s.lastLoaded(), expected);
    c.sameInt("stream: nothing was unloaded", s.lastUnloaded(), 0);
    c.that("stream: the cell under the player is active", s.isActive(0, 0));
    c.that("stream: a far cell is not", !s.isActive(40, 40));
    s.update(scene, world, ground, 50.0, 50.0);
    c.sameInt("stream: updating in place changes nothing", s.lastLoaded() + s.lastUnloaded(), 0);

    let mut every : bool = true;
    let mut standing : bool = true;
    for (d of 0..s.entityCount()) {
        let id : EntityId = s.memberAt(d);
        let key : i64 = s.cellOf(scene, id);
        let t : DTransform = scene.localTransform(id);
        let x : f64 = t.translation.x;
        let z : f64 = t.translation.z;
        if (Cells::index(x, 100.0) != Cells::keyX(key)
            || Cells::index(z, 100.0) != Cells::keyZ(key)) {
            every = false;
        }
        if (absDiff(t.translation.y, ground.heightAt(x, z)) > 0.000001) {
            standing = false;
        }
    }
    c.that("stream: every spawned entity knows the cell it stands in", every);
    c.that("stream: spawned entities stand on the ground", standing);
    c.that("stream: the registry does not claim the player", !s.isMember(scene, player));
    c.sameInt(
        "stream: the registry gives the none cell to a stranger",
        s.cellOf(scene, player),
        -1
    );

    let one : EntityId = s.memberAt(0);
    scene.destroy(one);
    c.that("stream: a destroyed entity is no longer a member", !s.isMember(scene, one));

    s.clear(scene);
    c.sameInt("stream: clear despawns all cells", s.activeCount(), 0);
    c.sameInt("stream: and every entity", scene.count(), 1);
    c.that("stream: the player is untouched", scene.isAlive(player));
    c.sameInt("stream: spawn and despawn totals agree", s.totalSpawned(), s.totalRemoved() + 1);
}

fn absDiff(a : f64, b : f64) : f64 {
    if (a > b) {
        return a - b;
    }
    return b - a;
}

fn strLongTravel(c : Checks) : void {
    let scene : Scene = new Scene();
    scene.add("player");
    let world : WorldPartition = strMakeWorld(21);
    let ground : FlatGround = new FlatGround(0.0);
    let s : CellStreamer = new CellStreamer(strConfig(100.0, 16, 32));
    // A circle of radius 400 m has this many cells' worth of area at most; the active set is the cells within
    // 400 m of the player, so it can never exceed those that fit a disc of radius 400 + a cell diagonal.
    let r : f64 = 400.0 + 141.5;
    let bound : i32 = (3.1416 * r * r / 10000.0) as i32 + 1;
    let mut worst : i32 = 0;
    let mut leak : i32 = 0;
    let mut balanced : bool = true;
    let mut x : f64 = 0.0;
    let mut steps : i32 = 0;
    while (x < 100000.0) {
        s.update(scene, world, ground, x, 50.0);
        if (s.activeCount() > worst) {
            worst = s.activeCount();
        }
        if (steps % 500 == 0) {
            if (scene.count() != 1 + s.entityCount()) {
                leak = leak + 1;
            }
            if (s.totalSpawned() - s.totalRemoved() != s.entityCount() as i64) {
                balanced = false;
            }
        }
        x = x + 8.0;
        steps = steps + 1;
    }
    c.that("travel: 100 km on foot in 12500 updates", steps == 12500);
    c.that("travel: the active set stays within a disc's worth of cells", worst <= bound);
    c.that("travel: and is not trivially empty", worst > 20);
    c.that(
        "travel: peak entities are four per active cell at most",
        s.peakEntityCount() <= bound * 4
    );
    c.sameInt("travel: the scene never held an entity the streamer did not account for", leak, 0);
    c.that("travel: spawned minus removed always equals what is registered", balanced);
    c.that("travel: the start is long gone", !s.isActive(0, 0));
    c.that("travel: the cells around the end are active", s.isActive(999, 0));
    s.clear(scene);
    c.sameInt("travel: after clearing nothing is left but the player", scene.count(), 1);
    c.sameInt("travel: every spawn was matched by a removal", s.totalSpawned(), s.totalRemoved());
    c.that("travel: a lot of entities came and went", s.totalSpawned() > 5000);
}

// Plays a path of positions and lets the budgets drain at the end.
fn strPlay(
    world : WorldPartition,
    scene : Scene,
    s : CellStreamer,
    endX : f64,
    endZ : f64,
    wander : i32,
    seed : u64
) : void {
    let ground : FlatGround = new FlatGround(0.0);
    let r : Pcg32 = new Pcg32(seed, 4);
    let mut x : f64 = endX + 5000.0;
    let mut z : f64 = endZ - 3000.0;
    for (i of 0..wander) {
        x = x + (r.nextF64() - 0.5) * 900.0;
        z = z + (r.nextF64() - 0.5) * 900.0;
        s.update(scene, world, ground, x, z);
    }
    for (i of 0..40) {
        s.update(scene, world, ground, endX, endZ);
    }
}

fn strPaths(c : Checks) : void {
    // No hysteresis: the active set is a function of the final position alone.
    let sceneA : Scene = new Scene();
    let sceneB : Scene = new Scene();
    let worldA : WorldPartition = strMakeWorld(31);
    let worldB : WorldPartition = strMakeWorld(31);
    let a : CellStreamer = new CellStreamer(strConfig(0.0, 5, 7));
    let b : CellStreamer = new CellStreamer(strConfig(0.0, 5, 7));
    strPlay(worldA, sceneA, a, 1234.5, -987.25, 0, 1);
    strPlay(worldB, sceneB, b, 1234.5, -987.25, 60, 2);
    c.that(
        "paths: two routes to one place leave the same cells active",
        a.activeSetHash() == b.activeSetHash()
    );
    c.sameInt("paths: and the same number of entities", a.entityCount(), b.entityCount());
    c.that(
        "paths: and the same things in the same places",
        a.contentHash(sceneA) == b.contentHash(sceneB)
    );
    c.that("paths: but the routes really were different", a.totalSpawned() != b.totalSpawned());
    c.that(
        "paths: and nothing leaked on either",
        sceneA.count() == a.entityCount() && sceneB.count() == b.entityCount()
    );

    // A different end place differs.
    let sceneC : Scene = new Scene();
    let worldC : WorldPartition = strMakeWorld(31);
    let d : CellStreamer = new CellStreamer(strConfig(0.0, 5, 7));
    strPlay(worldC, sceneC, d, 1234.5, -587.25, 0, 1);
    c.that("paths: another destination is another set", d.activeSetHash() != a.activeSetHash());

    // With hysteresis the band between the radii depends on history, but the core and the limit do not.
    let sceneH : Scene = new Scene();
    let sceneK : Scene = new Scene();
    let worldH : WorldPartition = strMakeWorld(31);
    let worldK : WorldPartition = strMakeWorld(31);
    let h : CellStreamer = new CellStreamer(strConfig(100.0, 5, 7));
    let k : CellStreamer = new CellStreamer(strConfig(100.0, 5, 7));
    strPlay(worldH, sceneH, h, 1234.5, -987.25, 0, 1);
    strPlay(worldK, sceneK, k, 1234.5, -987.25, 60, 2);
    let mut coreBoth : bool = true;
    let mut withinLimit : bool = true;
    for (cz of (0 - 30)..(0 - 1)) {
        for (cx of (0 - 3)..30) {
            let dist : f64 = Cells::distance(cx, cz, 100.0, 1234.5, -987.25);
            if (dist <= 300.0 && (!h.isActive(cx, cz) || !k.isActive(cx, cz))) {
                coreBoth = false;
            }
            if (dist > 400.0 && (h.isActive(cx, cz) || k.isActive(cx, cz))) {
                withinLimit = false;
            }
        }
    }
    c.that(
        "paths: with hysteresis every cell in the load radius is active on both routes",
        coreBoth
    );
    c.that("paths: and none beyond the release radius is", withinLimit);
}

fn strHysteresis(c : Checks) : void {
    // The player paces across the edge of the load radius: 5 m either side of a boundary.
    let ground : FlatGround = new FlatGround(0.0);
    let sceneA : Scene = new Scene();
    let worldA : WorldPartition = strMakeWorld(41);
    let flicker : CellStreamer = new CellStreamer(strConfig(0.0, 100, 100));
    flicker.update(sceneA, worldA, ground, 100.0, 50.0);
    let base : i64 = flicker.totalSpawned();
    for (i of 0..20) {
        flicker.update(sceneA, worldA, ground, 105.0, 50.0);
        flicker.update(sceneA, worldA, ground, 95.0, 50.0);
    }
    c.that(
        "hysteresis: with none, pacing across the edge keeps respawning cells",
        flicker.totalSpawned() > base + 20
    );

    let sceneB : Scene = new Scene();
    let worldB : WorldPartition = strMakeWorld(41);
    let steady : CellStreamer = new CellStreamer(strConfig(50.0, 100, 100));
    steady.update(sceneB, worldB, ground, 100.0, 50.0);
    steady.update(sceneB, worldB, ground, 105.0, 50.0);
    steady.update(sceneB, worldB, ground, 95.0, 50.0);
    let settled : i64 = steady.totalSpawned();
    for (i of 0..20) {
        steady.update(sceneB, worldB, ground, 105.0, 50.0);
        steady.update(sceneB, worldB, ground, 95.0, 50.0);
    }
    c.sameInt(
        "hysteresis: with a margin, pacing spawns nothing more",
        steady.totalSpawned(),
        settled
    );
    c.sameInt("hysteresis: and removes nothing", steady.totalRemoved(), 0);
}

fn strBudgets(c : Checks) : void {
    let scene : Scene = new Scene();
    let world : WorldPartition = strMakeWorld(51);
    let ground : FlatGround = new FlatGround(0.0);
    let s : CellStreamer = new CellStreamer(strConfig(0.0, 3, 2));
    let mut most : i32 = 0;
    let mut updates : i32 = 0;
    s.update(scene, world, ground, 0.0, 0.0);
    while (s.lastLoaded() > 0 && updates < 100) {
        if (s.lastLoaded() > most) {
            most = s.lastLoaded();
        }
        s.update(scene, world, ground, 0.0, 0.0);
        updates = updates + 1;
    }
    c.sameInt("budget: no update loads more cells than the budget", most, 3);
    c.that("budget: the active set is built up over several updates", updates > 5);
    let total : i32 = s.activeCount();
    c.that(
        "budget: it ends with the same cells an unlimited streamer would have",
        total == strUnlimited()
    );
    // Jump far away: unloads are budgeted too, and the nearest cells arrive first.
    s.update(scene, world, ground, 9000.0, 0.0);
    c.sameInt("budget: a jump unloads at most the budget at once", s.lastUnloaded(), 2);
    c.that(
        "budget: the cells around the new place come in nearest first",
        s.isActive(90, 0) || s.isActive(89, 0)
    );
    for (i of 0..200) {
        s.update(scene, world, ground, 9000.0, 0.0);
    }
    c.that("budget: in the end the old place is gone", !s.isActive(0, 0));
    c.sameInt("budget: and the leaks are zero", scene.count(), s.entityCount());
}

fn strUnlimited() : i32 {
    let scene : Scene = new Scene();
    let world : WorldPartition = strMakeWorld(51);
    let ground : FlatGround = new FlatGround(0.0);
    let s : CellStreamer = new CellStreamer(strConfig(0.0, 10000, 10000));
    s.update(scene, world, ground, 0.0, 0.0);
    return s.activeCount();
}

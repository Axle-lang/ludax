// systems — what happens each tick: bodies move along their orbits, and close approaches are counted.
//
// Systems are free functions over the stores (data first). `orbitSystem` is a pure function of the time it is
// given, so a tick does not depend on the ones before it; `encounterSystem` rebuilds the spatial grid from where
// everything now is and counts pairs of bodies whose spheres touch (a body and its own parent do not count: a
// station always touches its moon).
//
// Both write into state the caller owns (`grid` and `found`), because allocating per tick would make the run
// depend on the allocator rather than on the clock.

use ludax::{ComponentStore, DAabb, DTransform, DVec3, EntityId, SpatialGrid, Vec, cosD, sinD};

use crate::sim::bodies::{Body, Orbit, Orrery};

/** Sets every orbiting entity's local position for the simulated time `t` seconds. */
pub fn orbitSystem(o : Orrery, t : f64) : void {
    let orbits : ComponentStore<Orbit> = o.orbits();
    for (d of 0..orbits.len()) {
        let e : EntityId = orbits.entityAt(d);
        if (!o.scene().isAlive(e)) {
            continue;
        }

        let orbit : Orbit = orbits.valueAt(d);
        let angle : f64 = orbit.phase + orbit.speed * t;
        let local : DTransform = DTransform::fromTranslation(DVec3::make(
            cosD(angle) * orbit.radius,
            0.0,
            sinD(angle) * orbit.radius
        ));
        o.scene().setLocal(e, local);
    }
}

/** How many pairs of bodies touch right now; `grid` and `found` are scratch that the caller keeps between ticks. */
pub fn encounterSystem(o : Orrery, grid : SpatialGrid, found : Vec<i64>) : i32 {
    let bodies : ComponentStore<Body> = o.bodies();
    orreryFillGrid(o, grid);

    let mut touching : i32 = 0;
    for (d of 0..bodies.len()) {
        let e : EntityId = bodies.entityAt(d);
        if (!o.scene().isAlive(e)) {
            continue;
        }

        let p : DVec3 = o.position(e);
        let s : f64 = bodies.valueAt(d).size;
        found.clear();
        grid.query(orreryBodyBox(p, s), found);

        for (k of 0..found.len()) {
            let other : EntityId = EntityId::fromBits(found.get(k));
            // Count each pair once, from the side with the smaller id, and skip a body and its parent.
            if (other.bits() <= e.bits()) {
                continue;
            }
            if (o.scene().parent(e).same(other) || o.scene().parent(other).same(e)) {
                continue;
            }

            let otherBody : Body = bodies.getOr(o.scene().entities(), other, bodies.valueAt(d));
            if (p.distance(o.position(other)) < s + otherBody.size) {
                touching = touching + 1;
            }
        }
    }
    return touching;
}

// The axis-aligned box around a body of size `s` at `p`; a sphere's collision bound.
fn orreryBodyBox(p : DVec3, s : f64) : DAabb {
    let lo : DVec3 = DVec3::make(p.x - s, p.y - s, p.z - s);
    let hi : DVec3 = DVec3::make(p.x + s, p.y + s, p.z + s);
    return DAabb::make(lo, hi);
}

// Inserts every living body's bounds into the grid.
fn orreryFillGrid(o : Orrery, grid : SpatialGrid) : void {
    let bodies : ComponentStore<Body> = o.bodies();
    grid.clear();
    for (d of 0..bodies.len()) {
        let e : EntityId = bodies.entityAt(d);
        if (!o.scene().isAlive(e)) {
            continue;
        }
        let p : DVec3 = o.position(e);
        grid.insert(e, orreryBodyBox(p, bodies.valueAt(d).size));
    }
}

// patterns — the pictures texlab starts from, drawn in code so the example needs no asset.
//
// Each is a 64 x 64 `Image` in sRGB, made from a seeded `Pcg32`: the same pixels on every run. Brick and moss
// have fine, high-contrast detail, which is what makes a texture shimmer when it is read without a mip chain.
//
// The numbers that describe a pattern's structure (brick size, checker cell, leaf count) are named; the
// shading constants inside them are not, because they are the pattern's look rather than a decision a reader
// could get wrong.

use ludax::{Image, Pcg32};

/** The side of every pattern, in pixels. */
pub const PATTERN_SIZE : i32 = 64;

// A brick is 16 by 8 pixels, so a row holds four of them and the pattern holds eight courses.
const PATTERN_BRICK_W : i32 = 16;
const PATTERN_BRICK_H : i32 = 8;
const PATTERN_BRICKS_PER_ROW : i32 = 4;
const PATTERN_COURSES : i32 = 8;

// One tint per brick of the pattern. The array is roomy rather than exact so a larger size does not need a
// different allocation.
const PATTERN_TINT_SLOTS : i32 = 64;

// How far a brick's tint and its grain may stray, in channel values.
const PATTERN_TINT_RANGE : i32 = 22;
const PATTERN_GRAIN : i32 = 10;

// The checker's cell is this many pixels across.
const PATTERN_CHECKER_CELL : i32 = 4;

// The moss's two wave frequencies, and how high the wave must be to show green.
const PATTERN_MOSS_X : f32 = 0.31;
const PATTERN_MOSS_Y : f32 = 0.27;
const PATTERN_MOSS_THRESHOLD : f32 = 0.15;

// The leaf field: how many discs, and the ranges their radius, shade and centre may take.
const PATTERN_LEAVES : i32 = 14;
const PATTERN_LEAF_MARGIN : i32 = 4;
const PATTERN_LEAF_RADIUS_MIN : i32 = 3;
const PATTERN_LEAF_RADIUS_MAX : i32 = 7;
const PATTERN_LEAF_SHADE : i32 = 60;

// The most a channel may hold.
const PATTERN_CHANNEL_MAX : i32 = 255;

// A channel value clamped into 0..255.
fn patternClamp(v : i32) : i32 {
    if (v < 0) {
        return 0;
    }
    if (v > PATTERN_CHANNEL_MAX) {
        return PATTERN_CHANNEL_MAX;
    }
    return v;
}

/** Red bricks in grey mortar: 16 x 8 pixel bricks laid in running bond, each a little different. */
pub fn patternBricks() : Image {
    let mut img : Image = new Image(PATTERN_SIZE, PATTERN_SIZE);
    let rng : Pcg32 = new Pcg32(1, 1);

    let mut tint : i32[] = malloc<i32>(PATTERN_TINT_SLOTS);
    for (i of 0..PATTERN_TINT_SLOTS) {
        tint[i] = rng.range(-PATTERN_TINT_RANGE, PATTERN_TINT_RANGE);
    }

    for (y of 0..PATTERN_SIZE) {
        for (x of 0..PATTERN_SIZE) {
            let course : i32 = y / PATTERN_BRICK_H;
            // Every other course is offset by half a brick: running bond.
            let shifted : i32 = x + (course % 2) * PATTERN_BRICK_W;
            let brick : i32 = (shifted / PATTERN_BRICK_W) % PATTERN_BRICKS_PER_ROW;
            let inMortar : bool = y % PATTERN_BRICK_H == 0 || shifted % PATTERN_BRICK_W == 0;
            let grain : i32 = rng.range(-PATTERN_GRAIN, PATTERN_GRAIN);

            if (inMortar) {
                let m : i32 = patternClamp(150 + grain);
                img.set(x, y, Image::pack(m, m, m - 6, PATTERN_CHANNEL_MAX));
                continue;
            }

            let t : i32 = tint[(course % PATTERN_COURSES) * PATTERN_BRICKS_PER_ROW + brick];
            img.set(
                x,
                y,
                Image::pack(
                    patternClamp(168 + t + grain),
                    patternClamp(66 + t / 2 + grain),
                    patternClamp(48 + grain),
                    PATTERN_CHANNEL_MAX
                )
            );
        }
    }
    return img;
}

/** Black and white squares of 4 pixels: the hardest case for a texture filter. */
pub fn patternChecker() : Image {
    let mut img : Image = new Image(PATTERN_SIZE, PATTERN_SIZE);
    for (y of 0..PATTERN_SIZE) {
        for (x of 0..PATTERN_SIZE) {
            let cell : i32 = x / PATTERN_CHECKER_CELL + y / PATTERN_CHECKER_CELL;
            if (cell % 2 == 0) {
                img.set(x, y, Image::pack(235, 235, 235, PATTERN_CHANNEL_MAX));
            } else {
                img.set(x, y, Image::pack(20, 20, 24, PATTERN_CHANNEL_MAX));
            }
        }
    }
    return img;
}

/** Mossy stone: blotches of green over grey, with speckle. */
pub fn patternMoss() : Image {
    let mut img : Image = new Image(PATTERN_SIZE, PATTERN_SIZE);
    let rng : Pcg32 = new Pcg32(3, 7);
    for (y of 0..PATTERN_SIZE) {
        for (x of 0..PATTERN_SIZE) {
            let wave : f32 = ((x as f32) * PATTERN_MOSS_X).sin() * ((y as f32) * PATTERN_MOSS_Y).cos();
            let speck : i32 = rng.range(-28, 28);
            if (wave > PATTERN_MOSS_THRESHOLD) {
                img.set(
                    x,
                    y,
                    Image::pack(
                        patternClamp(52 + speck / 2),
                        patternClamp(112 + speck),
                        patternClamp(44 + speck / 2),
                        PATTERN_CHANNEL_MAX
                    )
                );
                continue;
            }

            let g : i32 = patternClamp(118 + speck);
            img.set(x, y, Image::pack(g, g, patternClamp(g + 4), PATTERN_CHANNEL_MAX));
        }
    }
    return img;
}

/** A leaf cut-out: opaque green discs on transparent ground, to show that mips keep the cut-out's colour. */
pub fn patternLeaves() : Image {
    let mut img : Image = new Image(PATTERN_SIZE, PATTERN_SIZE);
    let rng : Pcg32 = new Pcg32(9, 2);
    for (k of 0..PATTERN_LEAVES) {
        let cx : i32 = rng.range(PATTERN_LEAF_MARGIN, PATTERN_SIZE - PATTERN_LEAF_MARGIN);
        let cy : i32 = rng.range(PATTERN_LEAF_MARGIN, PATTERN_SIZE - PATTERN_LEAF_MARGIN);
        let radius : i32 = rng.range(PATTERN_LEAF_RADIUS_MIN, PATTERN_LEAF_RADIUS_MAX);
        let shade : i32 = rng.range(0, PATTERN_LEAF_SHADE);

        for (y of (cy - radius)..(cy + radius + 1)) {
            for (x of (cx - radius)..(cx + radius + 1)) {
                let dx : i32 = x - cx;
                let dy : i32 = y - cy;
                if (dx * dx + dy * dy <= radius * radius) {
                    img.set(
                        x,
                        y,
                        Image::pack(30 + shade / 2, 120 + shade, 40, PATTERN_CHANNEL_MAX)
                    );
                }
            }
        }
    }
    return img;
}

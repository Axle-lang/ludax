// assetdb — the data layer end to end: a virtual file system, the asset database and the importers.
//
// A shipped archive and a memory patch are mounted as layers; the database loads a level and, through the
// dependencies declared for it, a glTF triangle (and its separate binary), a Blockbench crate with an embedded
// texture, a JSON configuration and a PNG, in dependency order. It prints a summary, checks every number
// against what the content was built from, then edits files and reloads them to show the version counter
// move only for what changed. The exit status is the number of checks that failed.
//
// The paths are listed in `summaryPaths` rather than discovered, because the point of the summary is the order
// the dependencies were installed in, which a directory listing does not preserve.

use ludax::{AssetDb, AssetId, AssetKind, DataText, Image, JsonDoc, JsonValue, ModelAsset, Vfs, VfsListing};

use crate::content::files::ContentFiles;
use crate::report::report::Report;

/** How many assets the content holds, and so how many rows the summary has. */
const ASSETDB_ASSETS : i32 = 6;

/** The width of the id column in the summary. */
const ASSETDB_ID_WIDTH : i32 = 10;

/** The width of the kind column in the summary. */
const ASSETDB_KIND_WIDTH : i32 = 6;

fn main() : i32 {
    let files : Vfs = new Vfs();
    let report : Report = new Report();
    let mounted : bool = ContentFiles::mountAll(files) && files.mountCount() == 2;
    report.expect("the archive and the memory patch mount", mounted);

    let db : AssetDb = new AssetDb(files);

    layers(report, db);
    let level : AssetId = loadLevel(report, db);
    summary(db);
    contents(report, db, level);
    failures(report, db);
    reloading(report, db);

    println("");
    println("assetdb: ${report.total()} checks, ${report.failures()} failed");
    return report.failures();
}

// The mounts as the file system reports them: who wins, and what a directory lists.
fn layers(report : Report, db : AssetDb) : void {
    report.section("layers");
    let files : Vfs = db.files();

    report.expect(
        "config/game.json is in both layers and the patch (mount 1) wins",
        files.sourceOf("config/game.json") == 1
    );
    report.expect(
        "textures/checker.png is only in the archive (mount 0)",
        files.sourceOf("textures/checker.png") == 0
    );
    report.expect(
        "a file nobody has is found nowhere",
        files.sourceOf("nothing/here.png") == -1 && !files.exists("../escape.png")
    );

    let listing : VfsListing = files.list("models");
    let modelsMerged : bool = listing.len() == 4 && listing.name(0) == "broken.gltf"
        && listing.name(1) == "crate.bbmodel"
        && listing.name(2) == "tri.bin"
        && listing.name(3) == "tri.gltf";
    report.expect("models/ lists its four files merged from both layers, sorted", modelsMerged);

    let root : VfsListing = files.list("");
    report.expect("the root lists its directories", root.len() == 4 && root.isDirectory(0));
}

// Registers what depends on what, then loads the level with all of it.
fn loadLevel(report : Report, db : AssetDb) : AssetId {
    report.section("loading");
    db.dependsOn("scenes/level.json", "models/tri.gltf");
    db.dependsOn("scenes/level.json", "models/crate.bbmodel");
    db.dependsOn("scenes/level.json", "textures/checker.png");
    db.dependsOn("scenes/level.json", "config/game.json");
    db.dependsOn("models/tri.gltf", "models/tri.bin");

    let level : AssetId = db.loadWithDependencies("scenes/level.json");
    report.expect("the level loads with its dependencies (${db.error()})", !level.isNone());
    report.expect(
        "six assets are known and each was installed once",
        db.count() == ASSETDB_ASSETS && db.installCount() == ASSETDB_ASSETS
    );

    let bin : AssetId = db.find("models/tri.bin");
    let tri : AssetId = db.find("models/tri.gltf");
    report.expect(
        "a dependency was loaded before the asset that needs it",
        db.version(bin) == 1 && db.version(tri) == 1
    );

    let canonical : AssetId = AssetDb::idFor("models/tri.gltf");
    report.expect(
        "ids come from the path and agree with the database",
        tri.same(canonical) && tri.same(AssetDb::idFor("./models//tri.gltf"))
    );
    return level;
}

// The kind of an asset, as a short word for the summary.
fn assetdbKindName(db : AssetDb, id : AssetId) : string {
    return db.kindOf(id).label();
}

// A table of what the database holds, one row per asset.
fn summary(db : AssetDb) : void {
    println("");
    println("  asset id    kind   v  path");
    for (i of 0..ASSETDB_ASSETS) {
        let path : string = assetdbSummaryPath(i);
        let id : AssetId = db.find(path);
        let raw : string = "${id.raw}";
        let kind : string = assetdbKindName(db, id);
        let left : string = assetdbPadLeft(raw, ASSETDB_ID_WIDTH);
        let right : string = assetdbPadRight(kind, ASSETDB_KIND_WIDTH);
        println("  ${left}  ${right} ${db.version(id)}  ${path}");
    }
}

// The paths of the summary, in the order the dependencies were installed.
fn assetdbSummaryPath(i : i32) : string {
    return match i {
        0 => "scenes/level.json",
        1 => "models/tri.gltf",
        2 => "models/tri.bin",
        3 => "models/crate.bbmodel",
        4 => "textures/checker.png",
        _ => "config/game.json",
    };
}

// Pads on the left so a right-aligned column of ids lines up.
fn assetdbPadLeft(s : string, width : i32) : string {
    let mut out : string = s;
    while (out.byteLength < width) {
        out = " " + out;
    }
    return out;
}

// Pads on the right so a left-aligned column of kinds lines up.
fn assetdbPadRight(s : string, width : i32) : string {
    let mut out : string = s;
    while (out.byteLength < width) {
        out = out + " ";
    }
    return out;
}

// What came out of each file.
fn contents(report : Report, db : AssetDb, level : AssetId) : void {
    report.section("contents");
    let doc : JsonDoc = db.json(level);
    report.expect(
        "the level names two props",
        doc.len(doc.field(doc.root(), "props")) == 2
            && doc.asString(doc.field(doc.root(), "name")) == "first level"
    );

    let tri : ModelAsset = db.model(db.find("models/tri.gltf"));
    report.expect(
        "the triangle: one mesh of 3 vertices and 1 triangle",
        tri.ok() && tri.meshCount() == 1 && tri.mesh(0).primitive(0).vertexCount() == 3
            && tri.mesh(0).primitive(0).triangleCount() == 1
    );
    report.expect(
        "the triangle's material is the orange one",
        tri.material(0).name == "orange" && tri.material(0).baseColor.y == 0.5
            && tri.material(0).roughness == (0.8 as f32)
    );
    report.expect("its binary was read from the separate file", tri.externalFiles() == "models/tri.bin\n");

    let box : ModelAsset = db.model(db.find("models/crate.bbmodel"));
    report.expect(
        "the crate: 24 vertices, 12 triangles, a 16 x 16 texture",
        box.ok() && box.mesh(0).primitive(0).vertexCount() == 24
            && box.mesh(0).primitive(0).triangleCount() == 12
            && box.texture(0).width() == 16
    );
    report.expect(
        "the crate is one unit across",
        box.mesh(0).primitive(0).bounds().max.x == 1.0 && box.mesh(0).primitive(0).bounds().max.y == 1.0
    );

    let ground : Image = db.image(db.find("textures/checker.png"));
    report.expect(
        "the ground is the archive's 8 x 8 checker",
        ground.width() == 8 && ground.get(0, 0) == Image::pack(240, 240, 240, 255)
            && ground.get(2, 0) == Image::pack(40, 40, 40, 255)
    );

    let config : JsonDoc = db.json(db.find("config/game.json"));
    let configNode : JsonValue = config.root();
    report.expect(
        "the configuration is the patch's: volume 0.5, four keys",
        config.numberOr(config.field(configNode, "volume"), 0.0) == 0.5
            && config.len(config.field(configNode, "keys")) == 4
    );
}

// Things that must fail cleanly.
fn failures(report : Report, db : AssetDb) : void {
    report.section("failures");
    report.expect(
        "a model whose buffer file is missing fails with a reason",
        db.load("models/broken.gltf").isNone() && db.error().startsWith("models/broken.gltf: ")
    );
    println("        ${db.error()}");

    report.expect("a file that does not exist fails", db.load("models/ghost.gltf").isNone());
    report.expect("a path above the root is refused", db.load("../outside.json").isNone());

    db.dependsOn("cycle/a.json", "cycle/b.json");
    db.dependsOn("cycle/b.json", "cycle/a.json");
    report.expect(
        "a dependency cycle is refused before anything is read",
        db.loadWithDependencies("cycle/a.json").isNone()
            && db.error().startsWith("dependency cycle: cycle/a.json -> cycle/b.json -> cycle/a.json")
    );
    println("        ${db.error()}");
}

// Edits files and reloads: only what changed moves its version.
fn reloading(report : Report, db : AssetDb) : void {
    report.section("reloading");
    let config : AssetId = db.find("config/game.json");
    let tri : AssetId = db.find("models/tri.gltf");
    let ground : AssetId = db.find("textures/checker.png");

    report.expect(
        "nothing changed yet: reloading everything changes nothing",
        db.reloadAll() == 0 && db.version(config) == 1
    );

    try {
        db.files().writeText("config/game.json", ContentFiles::gameConfig(0.25));
        db.files().writeText("models/tri.gltf", ContentFiles::triangleGltf(7));
    } catch e : IOException {
        report.expect("the files can be edited (${e.message})", false);
    }

    report.expect(
        "the configuration reloads and goes to version 2",
        db.reload("config/game.json") && db.version(config) == 2
    );
    let doc : JsonDoc = db.json(config);
    report.expect("with the new volume", doc.numberOr(doc.field(doc.root(), "volume"), 0.0) == 0.25);
    report.expect(
        "reloading it again finds the same bytes",
        !db.reload("config/game.json") && db.version(config) == 2
    );
    report.expect(
        "the edited model reloads too",
        db.reload("models/tri.gltf") && db.version(tri) == 2
            && db.model(tri).node(0).local.translation.x == 7.0
    );
    report.expect(
        "the untouched picture stays at version 1",
        !db.reload("textures/checker.png") && db.version(ground) == 1
    );

    try {
        db.files().writeText("config/game.json", "{ this is not json");
    } catch e : IOException {
        report.expect("the file can be broken (${e.message})", false);
    }
    let kept : JsonDoc = db.json(config);
    let keptNode : JsonValue = kept.root();
    report.expect(
        "a broken edit is refused and the last good configuration stays",
        !db.reload("config/game.json") && db.version(config) == 2
            && kept.numberOr(kept.field(keptNode, "volume"), 0.0) == 0.25
    );
    println("        ${db.error()}");

    report.expect("the whole run installed 8 values", db.installCount() == 8);
}

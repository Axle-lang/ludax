// scene — the six-second script: a siren flying past the listener, music with a crossfade, and a flurry of bells.
//
// The script is driven by frame count alone. The engine renders in chunks of `SCENE_CHUNK` frames; before each chunk the
// script starts whatever is due, moves the siren to where it is at the middle of the chunk, and gives the engine
// its velocity, which is what makes the Doppler shift. Nothing here reads a clock, so two runs are identical.

use ludax::AUDIO_BUS_AMBIENT;
use ludax::{Vec3, AudioEngine, AudioClip, AudioPlay, AudioEmitter, AudioAttenuation, AudioInterpolation};

use crate::sounds::kit::{Kit, KIT_RATE};

/** Frames rendered between two script updates. */
const SCENE_CHUNK : i32 = 256;

/** Length of the scene in seconds. */
pub const SCENE_SECONDS : i32 = 6;

/** Speed of the siren, metres per second. */
pub const SIREN_SPEED : f32 = 40.0;

/** Sideways distance at which the siren passes the listener, metres. */
pub const SIREN_OFFSET : f32 = 5.0;

/** Most sounds the engine mixes at once in this scene. */
pub const SCENE_VOICES : i32 = 6;

/** Stereo: the scene is mixed to a left and a right channel. */
const SCENE_CHANNELS : i32 = 2;

/** Spare floats after a chunk's samples in the mix buffer, so a rounding of the engine's never overruns it. */
const SCENE_BUFFER_SLACK : i32 = 2;

// The siren starts this far to the listener's left, metres.
const SIREN_START_X : f32 = -120.0;

// The siren's mix priority: the highest in the scene, so nothing steals it.
const SIREN_PRIORITY : i32 = 5;

// The siren is at full volume inside this distance, metres.
const SIREN_NEAR : f32 = 5.0;

// And silent beyond this one, metres.
const SIREN_FAR : f32 = 400.0;

/** The second music pad takes over this far into the scene, seconds. */
pub const MUSIC_SWAP_SECONDS : f32 = 3.0;

/** The crossfade between the two pads lasts this long, seconds. */
pub const MUSIC_CROSSFADE_SECONDS : f32 = 1.0;

// The first pad fades in over this long at the start, seconds.
const MUSIC_FADE_IN_SECONDS : f32 = 0.5;

/** The bell flurry arrives this far in, seconds. */
pub const BURST_SECONDS : f32 = 4.5;

// How many bells the flurry rings at once.
const BURST_BELLS : i32 = 8;

// How many notes the tune has.
const TUNE_LENGTH : i32 = 6;

// The flurry spreads its bells over this many pan positions.
const BURST_PANS : i32 = 4;

// Bells of the flurry in each priority class: the first four outrank the last four.
const BURST_BELLS_PER_CLASS : i32 = 4;

// The flurry's priority class of the first bells; later ones are one more.
const BURST_PRIORITY : i32 = 1;

// The flurry's bells are quieter than the tune's, so eight at once do not clip.
const BURST_GAIN : f32 = 0.5;

// The tune's bells outrank the flurry's.
const TUNE_PRIORITY : i32 = 2;

// The tune's gain.
const TUNE_GAIN : f32 = 0.7;

// The tune spreads over this many pan positions.
const TUNE_PANS : i32 = 3;

// Neighbouring pan positions are this far apart, from -1 (left) to 1 (right).
const PAN_SPACING : f32 = 0.5;

/** What happened during a render, for the checks to look at. */
pub class SceneStats {
    /** Sounds cut off to make room. */
    pub stolen : i32 = 0;

    /** Sounds refused because nothing was less important. */
    pub refused : i32 = 0;

    /** The most voices in use at any chunk boundary. */
    pub busiest : i32 = 0;

    /** True if the first music pad had ended by the time the second had been playing a full crossfade. */
    pub oldGone : bool = false;

    /** True if the second music pad was still playing at the end. */
    pub newLives : bool = false;
}

// One bell of the tune.
struct TuneBell {
    // When it rings, seconds into the scene.
    seconds : f32;

    // Which of the five bells, as a pentatonic degree.
    degree : i32;
}

// What the script has started so far, so each event happens once however many chunks pass.
class ChimeScript {
    // The first music pad's handle, or -1 before it plays.
    pub(file) padOne : i32 = -1;

    // The second music pad's handle, or -1 before the crossfade.
    pub(file) padTwo : i32 = -1;

    // How many notes of the tune have rung.
    tune : i32 = 0;

    // Whether the flurry has rung.
    burst : bool = false;

    // Whether the second pad has started.
    crossed : bool = false;

    constructor() {}

    // The single bell number `i` of the tune: when it rings, and which pentatonic degree.
    static fn tuneBell(i : i32) : TuneBell {
        return match i {
            0 => TuneBell { seconds: 0.5, degree: 0 },
            1 => TuneBell { seconds: 1.0, degree: 2 },
            2 => TuneBell { seconds: 1.6, degree: 3 },
            3 => TuneBell { seconds: 2.1, degree: 4 },
            4 => TuneBell { seconds: 2.6, degree: 2 },
            _ => TuneBell { seconds: 3.4, degree: 1 },
        };
    }

    // Rings the next bell of the tune.
    static fn ringTune(e : AudioEngine, kit : Kit, tune : i32) : void {
        let bell : TuneBell = ChimeScript::tuneBell(tune);
        let mut p : AudioPlay = AudioPlay::forClip(kit.bell(bell.degree));
        p.priority = TUNE_PRIORITY;
        p.pan = ((tune % TUNE_PANS) as f32 - (1.0 as f32)) * PAN_SPACING;
        p.gain = TUNE_GAIN;
        e.play(p);
    }

    // Eight bells in one instant: more than the pool can hold, so the least important are cut off.
    static fn ringBurst(e : AudioEngine, kit : Kit) : void {
        for (k of 0..BURST_BELLS) {
            let mut p : AudioPlay = AudioPlay::forClip(kit.bell(k));
            p.priority = BURST_PRIORITY + k / BURST_BELLS_PER_CLASS;
            p.pan = ((k % BURST_PANS) as f32 - (1.5 as f32)) * PAN_SPACING;
            p.gain = BURST_GAIN;
            e.play(p);
        }
    }

    // Starts whatever is due at `t` seconds into the scene.
    pub(file) fn startDue(mut self, e : AudioEngine, kit : Kit, t : f32) : void {
        if (!self.crossed && t >= MUSIC_SWAP_SECONDS) {
            self.crossed = true;
            self.padTwo = e.playMusic(Kit::track(kit.padB), MUSIC_CROSSFADE_SECONDS);
        }
        while (self.tune < TUNE_LENGTH && t >= ChimeScript::tuneBell(self.tune).seconds) {
            ChimeScript::ringTune(e, kit, self.tune);
            self.tune = self.tune + 1;
        }
        if (!self.burst && t >= BURST_SECONDS) {
            self.burst = true;
            ChimeScript::ringBurst(e, kit);
        }
    }
}

/** The script. */
pub class ChimeScene {
    /** Where the siren is `t` seconds in: it flies along x at SIREN_SPEED, starting 120 m to the left of the listener. */
    pub static fn sirenX(t : f32) : f32 {
        return SIREN_SPEED * t + SIREN_START_X;
    }

    /** Seconds into the scene at which the siren is level with the listener: where its x crosses zero. */
    pub static fn passSeconds() : f32 {
        return -SIREN_START_X / SIREN_SPEED;
    }

    // The siren as an emitter at time `t`.
    static fn sirenEmitter(t : f32) : AudioEmitter {
        let mut e : AudioEmitter = AudioEmitter {};
        e.position = Vec3 { x: ChimeScene::sirenX(t), y: 0.0, z: -SIREN_OFFSET };
        e.velocity = Vec3 { x: SIREN_SPEED, y: 0.0, z: 0.0 };
        e.minDistance = SIREN_NEAR;
        e.maxDistance = SIREN_FAR;
        e.model = AudioAttenuation::Inverse;
        return e;
    }

    // The looping, spatial siren, placed at the start of its path.
    static fn sirenPlay(kit : Kit) : AudioPlay {
        let mut siren : AudioPlay = AudioPlay::forClip(kit.siren);
        siren.looping = true;
        siren.spatial = true;
        siren.priority = SIREN_PRIORITY;
        siren.bus = AUDIO_BUS_AMBIENT;
        siren.interp = AudioInterpolation::Cubic;
        siren.emitter = ChimeScene::sirenEmitter(0.0);
        return siren;
    }

    /** Renders the scene as a stereo clip. With `sirenOnly` only the siren plays: the dry signal the Doppler check measures. */
    pub static fn render(sirenOnly : bool, mut stats : SceneStats) : AudioClip {
        let e : AudioEngine = new AudioEngine(KIT_RATE, SCENE_VOICES);
        let kit : Kit = Kit::load(e);
        let total : i32 = SCENE_SECONDS * KIT_RATE;
        let mut out : AudioClip = new AudioClip(KIT_RATE, SCENE_CHANNELS, total);
        let buf : f32[] = new f32[(SCENE_CHUNK * SCENE_CHANNELS + SCENE_BUFFER_SLACK) as i64];

        let sirenHandle : i32 = e.play(ChimeScene::sirenPlay(kit));
        let mut script : ChimeScript = new ChimeScript();
        if (!sirenOnly) {
            script.padOne = e.playMusic(Kit::track(kit.padA), MUSIC_FADE_IN_SECONDS);
        }

        let mut at : i32 = 0;
        while (at < total) {
            let mut n : i32 = total - at;
            if (n > SCENE_CHUNK) {
                n = SCENE_CHUNK;
            }
            let t : f32 = (at as f32) / (KIT_RATE as f32);
            if (!sirenOnly) {
                script.startDue(e, kit, t);
            }

            // The siren is placed at the middle of the chunk, so its velocity matches what is heard across it.
            let mid : f32 = t + ((n as f32) * (0.5 as f32)) / (KIT_RATE as f32);
            e.setEmitter(sirenHandle, ChimeScene::sirenEmitter(mid));
            e.render(buf, n);
            for (i of 0..n * SCENE_CHANNELS) {
                out.samples[(at * SCENE_CHANNELS + i) as i64] = buf[i as i64];
            }
            if (e.activeVoices() > stats.busiest) {
                stats.busiest = e.activeVoices();
            }
            at = at + n;
        }

        stats.stolen = e.stolenCount();
        stats.refused = e.refusedCount();
        stats.oldGone = script.padTwo > 0 && !e.isPlaying(script.padOne);
        stats.newLives = script.padTwo > 0 && e.isPlaying(script.padTwo);
        return out;
    }
}

// measure — reading numbers back out of rendered audio, independently of how the engine produced it.
//
// The Doppler check does not trust the engine's own formula: it counts the zero crossings of the rendered
// signal and compares them with what the physics predicts for the siren's actual path, summed frame by frame.
//
// A measurement is always over a `Window`, so a call site says *where* it looked without repeating two frame
// numbers next to each other; the two numbers mean nothing apart.

use ludax::{AudioClip, sqrtD};

use crate::scene::scene::{ChimeScene, SIREN_SPEED, SIREN_OFFSET};
use crate::sounds::kit::{KIT_RATE, KIT_SIREN_HZ};

/** The speed of sound in air, metres per second: what the Doppler shift is measured against. */
const MEASURE_SOUND_SPEED : f64 = 343.0;

/** A half-open run of frames `from..to` to measure over. */
pub struct Window {
    /** The first frame. */
    pub from : i32 = 0;

    /** One past the last frame. */
    pub to : i32 = 0;

    /** How long the window is, in seconds. */
    pub fn seconds(self) : f64 {
        return ((self.to - self.from) as f64) / (KIT_RATE as f64);
    }
}

/** Measurements on rendered clips. */
pub class Measure {
    /** Sign changes of left + right in `window`. */
    pub static fn crossings(clip : AudioClip, window : Window) : i32 {
        let mut count : i32 = 0;
        let mut prev : f32 = clip.get(window.from, 0) + clip.get(window.from, 1);
        for (i of window.from + 1..window.to) {
            let v : f32 = clip.get(i, 0) + clip.get(i, 1);
            if ((prev < 0.0) != (v < 0.0)) {
                count = count + 1;
            }
            prev = v;
        }
        return count;
    }

    /** The pitch ratio the physics gives at second `t`: the speed of sound over (that + the siren's speed along the line to the listener). */
    pub static fn predictedRatio(t : f64) : f64 {
        let x : f64 = ChimeScene::sirenX(t as f32) as f64;
        let d : f64 = sqrtD(x * x + (SIREN_OFFSET as f64) * (SIREN_OFFSET as f64));
        let along : f64 = (SIREN_SPEED as f64) * x / d;
        return MEASURE_SOUND_SPEED / (MEASURE_SOUND_SPEED + along);
    }

    /** Zero crossings the physics predicts in `window`: twice the integral of the frequency. */
    pub static fn predictedCrossings(window : Window) : f64 {
        let mut sum : f64 = 0.0;
        for (i of window.from..window.to) {
            let t : f64 = (i as f64 + 0.5) / (KIT_RATE as f64);
            sum = sum + 2.0 * (KIT_SIREN_HZ as f64) * Measure::predictedRatio(t) / (KIT_RATE as f64);
        }
        return sum;
    }

    /** The frequency (Hz) implied by `crossings` sign changes in `window`. */
    pub static fn frequency(crossings : i32, window : Window) : f64 {
        return (crossings as f64) / 2.0 / window.seconds();
    }
}

// kit — the clips of the scene, all made in code with the synth: two music pads, five bells and a siren tone.
//
// `Kit::load` builds every clip, hands each to the engine and remembers the ids. Nothing is read from disk, so the
// example needs no audio assets and the sounds are identical on every machine.

use ludax::{AudioEngine, AudioClip, Synth, SynthWave, SynthAdsr, MusicTrack};

/** Sample rate of every clip. */
pub const KIT_RATE : i32 = 44100;

/** Frequency of the siren the flyby plays, in Hz: exactly 500 cycles in its 0.5 s clip, so it loops with no seam. */
pub const KIT_SIREN_HZ : f32 = 1000.0;

// The pads are the chords of C major and F major, as the frequency of the root, Hz.
const KIT_PAD_A_HZ : f32 = 130.81;
const KIT_PAD_B_HZ : f32 = 174.61;

// The five bells ring the notes C5, D5, E5, G5 and A5, Hz: a major pentatonic, so any two sound well together.
const KIT_BELL_C5_HZ : f32 = 523.25;
const KIT_BELL_D5_HZ : f32 = 587.33;
const KIT_BELL_E5_HZ : f32 = 659.25;
const KIT_BELL_G5_HZ : f32 = 783.99;
const KIT_BELL_A5_HZ : f32 = 880.0;

// The siren's clip has one channel; the scene's engine spreads it in space.
const KIT_MONO : u64 = 1;

// Both music pads are this long, seconds, and loop whole.
const KIT_PAD_SECONDS : f32 = 4.0;

// The siren's clip is half a second: long enough to hold the tone, short enough to loop evenly.
const KIT_SIREN_SECONDS : f32 = 0.5;

// A bell rings for this long before its tail goes into the reverb, seconds.
const KIT_BELL_SECONDS : f32 = 1.2;

// How loud each family sits in the mix.
const KIT_PAD_GAIN : f32 = 0.6;
const KIT_SIREN_GAIN : f32 = 0.8;

// The bell's reverb: room size, damping, wet mix and the tail it adds.
const KIT_BELL_ROOM : f32 = 0.7;
const KIT_BELL_DAMP : f32 = 0.4;
const KIT_BELL_WET : f32 = 0.3;
const KIT_BELL_TAIL : f32 = 0.8;

/** Engine clip ids of everything the scene plays. */
pub struct Kit {
    /** First music pad (C major chord, 4 s loop). */
    pub padA : i32 = 0;

    /** Second music pad (F major chord, 4 s loop). */
    pub padB : i32 = 0;

    /** The flyby siren. */
    pub siren : i32 = 0;

    /** Bell on C5. */
    pub bell0 : i32 = 0;

    /** Bell on D5. */
    pub bell1 : i32 = 0;

    /** Bell on E5. */
    pub bell2 : i32 = 0;

    /** Bell on G5. */
    pub bell3 : i32 = 0;

    /** Bell on A5. */
    pub bell4 : i32 = 0;

    /** The bell clip for pentatonic degree `n` (0..4; others wrap). */
    pub fn bell(self, n : i32) : i32 {
        let k : i32 = n % 5;
        return match k {
            0 => self.bell0,
            1 => self.bell1,
            2 => self.bell2,
            3 => self.bell3,
            _ => self.bell4,
        };
    }

    /** Builds all clips and registers them with `e`. */
    pub static fn load(e : AudioEngine) : Kit {
        let mut k : Kit = Kit {};
        k.padA = e.addClip(Synth::pad(KIT_PAD_A_HZ, KIT_PAD_SECONDS, KIT_RATE));
        k.padB = e.addClip(Synth::pad(KIT_PAD_B_HZ, KIT_PAD_SECONDS, KIT_RATE));

        // A siren is one steady tone: no attack, no decay, no release.
        let gate : SynthAdsr = SynthAdsr::make(0.0, 0.0, 1.0, 0.0);
        k.siren = e.addClip(Kit::siren(gate));
        k.bell0 = e.addClip(Kit::ringing(KIT_BELL_C5_HZ));
        k.bell1 = e.addClip(Kit::ringing(KIT_BELL_D5_HZ));
        k.bell2 = e.addClip(Kit::ringing(KIT_BELL_E5_HZ));
        k.bell3 = e.addClip(Kit::ringing(KIT_BELL_G5_HZ));
        k.bell4 = e.addClip(Kit::ringing(KIT_BELL_A5_HZ));
        return k;
    }

    // A steady sine, half a second long: loop it for as long as the siren is needed.
    static fn siren(gate : SynthAdsr) : AudioClip {
        let tone : AudioClip = Synth::tone(
            SynthWave::Sine,
            KIT_SIREN_HZ,
            KIT_SIREN_SECONDS,
            gate,
            KIT_RATE,
            KIT_MONO
        );
        return tone.gained(KIT_SIREN_GAIN);
    }

    // A bell with a little room around it.
    static fn ringing(hz : f32) : AudioClip {
        let bell : AudioClip = Synth::bell(hz, KIT_BELL_SECONDS, KIT_RATE);
        return Synth::withReverb(bell, KIT_BELL_ROOM, KIT_BELL_DAMP, KIT_BELL_WET, KIT_BELL_TAIL);
    }

    /** A music track for pad `clip`: loops the whole 4 s clip. */
    pub static fn track(clip : i32) : MusicTrack {
        let mut t : MusicTrack = MusicTrack::forClip(clip);
        t.gain = KIT_PAD_GAIN;
        return t;
    }
}

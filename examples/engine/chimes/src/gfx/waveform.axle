// waveform — draws a stereo clip as two stacked waveforms with a time grid and the scene's landmarks.
//
// One pixel column covers a run of frames; the column shows the lowest and highest sample in that run. The left
// channel is the top half and the right channel the bottom half, so a sound passing from left to right is seen
// moving from one half to the other.
//
// The landmarks are the moments the script in `scene` acts at: the crossfade of the two pads, and the siren's
// closest pass and the bell flurry. They are named here because moving them without moving the script would be
// a lie in the picture, not merely a styling choice.

use ludax::AudioClip;

use crate::gfx::canvas::{Canvas, CanvasRect, Shade};
use crate::scene::scene::{BURST_SECONDS, ChimeScene, MUSIC_CROSSFADE_SECONDS, MUSIC_SWAP_SECONDS};

/** Picture width in pixels. */
pub const WAVE_WIDTH : i32 = 1200;

/** Picture height in pixels. */
pub const WAVE_HEIGHT : i32 = 400;

/** A waveform stops this many pixels short of its panel's edge, so a loud peak never touches its neighbour. */
const WAVE_PANEL_INSET : i32 = 4;

/** The background: a dark blue-grey, fully covering. */
const WAVE_BACKGROUND_RGB : i32 = 0x161820;
const WAVE_BACKGROUND_ALPHA : i32 = 255;

/** The zero line of each channel, a muted grey-blue. */
const WAVE_AXIS_RGB : i32 = 0x5A606E;
const WAVE_AXIS_ALPHA : i32 = 200;

/** The crossfade region behind both channels, a faint violet. */
const WAVE_FADE_RGB : i32 = 0x785AC8;
const WAVE_FADE_ALPHA : i32 = 50;

/** The one-second grid lines: white, barely there. */
const WAVE_GRID_RGB : i32 = 0xFFFFFF;
const WAVE_GRID_ALPHA : i32 = 28;

/** The left channel is a cool blue and the right a warm orange, so a sound passing over shows as a colour change. */
const WAVE_LEFT_RGB : i32 = 0x6EC8FF;
const WAVE_RIGHT_RGB : i32 = 0xFFAA6E;

/** Waveforms cover fully. */
const WAVE_SIGNAL_ALPHA : i32 = 255;

/** The siren's closest pass is marked yellow and the bell flurry red. */
const WAVE_PASS_RGB : i32 = 0xFFE65A;
const WAVE_BURST_RGB : i32 = 0xFF5A5A;
const WAVE_MARKER_ALPHA : i32 = 200;

/** One panel of the picture: which channel it shows, between which pixel rows, in which colour. */
struct WavePanel {
    /** The channel of the clip, 0 for left. */
    channel : i32;

    /** The panel's first pixel row. */
    top : i32;

    /** One past the panel's last pixel row. */
    bottom : i32;

    /** The colour of its waveform. */
    shade : Shade;
}

/** Draws waveform pictures. */
pub class Waveform {
    // The samples of the panel's channel as one bar per pixel column: lowest to highest in that column's frames.
    static fn panel(canvas : Canvas, clip : AudioClip, spec : WavePanel) : void {
        let mid : i32 = (spec.top + spec.bottom) / 2;
        let half : i32 = (spec.bottom - spec.top) / 2 - WAVE_PANEL_INSET;
        let axis : Shade = Shade::rgb(WAVE_AXIS_RGB, WAVE_AXIS_ALPHA);
        let line : CanvasRect = CanvasRect { x0: 0, y0: mid, x1: WAVE_WIDTH - 1, y1: mid };
        canvas.rect(line, axis);

        for (x of 0..WAVE_WIDTH) {
            let from : i32 = (x as i64 * clip.frames as i64 / WAVE_WIDTH as i64) as i32;
            let to : i32 = ((x + 1) as i64 * clip.frames as i64 / WAVE_WIDTH as i64) as i32;
            let mut lo : f32 = 0.0;
            let mut hi : f32 = 0.0;
            for (i of from..to) {
                let v : f32 = clip.samples[(i * clip.channels + spec.channel) as i64];
                if (v < lo) {
                    lo = v;
                }
                if (v > hi) {
                    hi = v;
                }
            }

            let y0 : i32 = mid - (hi * (half as f32)) as i32;
            let y1 : i32 = mid - (lo * (half as f32)) as i32;
            let bar : CanvasRect = CanvasRect { x0: x, y0: y0, x1: x, y1: y1 + 1 };
            canvas.rect(bar, spec.shade);
        }
    }

    // The pixel column of `seconds` in a clip `total` seconds long.
    static fn column(seconds : f32, total : f32) : i32 {
        return (seconds / total * (WAVE_WIDTH as f32)) as i32;
    }

    // A vertical line at `seconds`.
    static fn marker(canvas : Canvas, seconds : f32, total : f32, shade : Shade) : void {
        let x : i32 = Waveform::column(seconds, total);
        let line : CanvasRect = CanvasRect { x0: x, y0: 0, x1: x, y1: WAVE_HEIGHT - 1 };
        canvas.rect(line, shade);
    }

    // The crossfade of the two pads, tinted behind both channels.
    static fn drawFade(canvas : Canvas, total : f32) : void {
        let fade : Shade = Shade::rgb(WAVE_FADE_RGB, WAVE_FADE_ALPHA);
        let fadeFrom : i32 = Waveform::column(MUSIC_SWAP_SECONDS, total);
        let fadeTo : i32 = Waveform::column(MUSIC_SWAP_SECONDS + MUSIC_CROSSFADE_SECONDS, total);
        let region : CanvasRect = CanvasRect { x0: fadeFrom, y0: 0, x1: fadeTo, y1: WAVE_HEIGHT - 1 };
        canvas.rect(region, fade);
    }

    // A faint line at every whole second.
    static fn drawGrid(canvas : Canvas, total : f32) : void {
        let grid : Shade = Shade::rgb(WAVE_GRID_RGB, WAVE_GRID_ALPHA);
        let gridEnd : i32 = total as i32;
        for (s of 1..gridEnd) {
            Waveform::marker(canvas, s as f32, total, grid);
        }
    }

    /** The picture of `clip` (stereo): grid every second, the music crossfade tinted, the siren's closest pass and the bell burst marked. */
    pub static fn draw(clip : AudioClip) : Canvas {
        let background : Shade = Shade::rgb(WAVE_BACKGROUND_RGB, WAVE_BACKGROUND_ALPHA);
        let canvas : Canvas = new Canvas(WAVE_WIDTH, WAVE_HEIGHT, background);
        let total : f32 = clip.duration();
        Waveform::drawFade(canvas, total);
        Waveform::drawGrid(canvas, total);

        let middle : i32 = WAVE_HEIGHT / 2;
        let left : WavePanel = WavePanel {
            channel: 0,
            top: 0,
            bottom: middle,
            shade: Shade::rgb(WAVE_LEFT_RGB, WAVE_SIGNAL_ALPHA),
        };
        let right : WavePanel = WavePanel {
            channel: 1,
            top: middle,
            bottom: WAVE_HEIGHT,
            shade: Shade::rgb(WAVE_RIGHT_RGB, WAVE_SIGNAL_ALPHA),
        };
        Waveform::panel(canvas, clip, left);
        Waveform::panel(canvas, clip, right);

        let pass : Shade = Shade::rgb(WAVE_PASS_RGB, WAVE_MARKER_ALPHA);
        let burst : Shade = Shade::rgb(WAVE_BURST_RGB, WAVE_MARKER_ALPHA);
        Waveform::marker(canvas, ChimeScene::passSeconds(), total, pass);
        Waveform::marker(canvas, BURST_SECONDS, total, burst);
        return canvas;
    }
}

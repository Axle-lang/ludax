// verdict — counts the demo's checks and prints each one.
//
// The demo writes checks as they occur, wherever the measurement lives; this class owns the two counters and
// the one exit-status decision, so no call site has to remember to add to them.

/** Collects the outcome of the demo's checks. */
pub class Verdict {
    // How many checks did not hold.
    failed : i32 = 0;

    // How many checks ran.
    total : i32 = 0;

    /** States that `ok` holds; prints `ok` or `FAIL` before the sentence. */
    pub fn expect(mut self, what : string, ok : bool) : void {
        self.total = self.total + 1;
        if (ok) {
            println("  ok    ${what}");
            return;
        }

        self.failed = self.failed + 1;
        println("  FAIL  ${what}");
    }

    /** Prints the tally and answers the process exit status: the number of failures. */
    pub fn finish(self) : i32 {
        println("${self.total - self.failed} of ${self.total} checks passed");
        return self.failed;
    }
}

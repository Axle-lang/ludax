// scene — the demo world: a ramp, a pyramid of boxes, balls dropped around it and a swinging chain.
//
// Everything is built from a seed with an explicit Pcg32, so the same call always builds the same world. The
// scene keeps the handles it needs to look at afterwards: the pyramid boxes, the balls, the slider on the ramp
// and the chain with its joints. Units are metres; the picture is a side view, so everything lives near z = 0.
//
// The chain's pivot, link count and bob offset are public because the check in `main` measures the bob against
// the chain's reach: the number there must come from the same place the chain is built, not be copied.

use ludax::BodyDesc;
use ludax::DQuat;
use ludax::DVec3;
use ludax::EntityId;
use ludax::Pcg32;
use ludax::PhysicsSettings;
use ludax::PhysicsWorld;
use ludax::Shape;
use ludax::Vec;
use ludax::cosD;
use ludax::sinD;

/** The x of the chain's fixed pivot, metres. */
pub const SCENE_CHAIN_PIVOT_X : f64 = 8.0;

/** The y of the chain's fixed pivot, metres. */
pub const SCENE_CHAIN_PIVOT_Y : f64 = 7.5;

// How many capsule links hang from the pivot; the bob is not one of them.
const SCENE_CHAIN_LINKS : i32 = 4;

// How far past the last link's end the bob's centre hangs, metres.
const SCENE_CHAIN_BOB_OFFSET : f64 = 0.3;

// The chain is released this far from vertical, radians: 60 degrees.
const SCENE_CHAIN_RELEASE : f64 = 1.0471975511965976;

// The radius and half-length of one capsule link, metres.
const SCENE_LINK_RADIUS : f64 = 0.08;
const SCENE_LINK_HALF : f64 = 0.42;

// The bob's radius, metres.
const SCENE_BOB_RADIUS : f64 = 0.3;

// The ground plane's height and the side walls' distance from it, metres.
const SCENE_GROUND_Y : f64 = 0.0;
const SCENE_WALL_DEPTH : f64 = 1.2;
const SCENE_WALL_LEFT : f64 = -9.5;
const SCENE_WALL_RIGHT : f64 = -11.5;

// The ramp leans this far, radians (about 20 degrees), and both it and the slider have this friction.
const SCENE_RAMP_TILT : f64 = -0.35;
const SCENE_RAMP_FRICTION : f64 = 0.3;

// The plank: where its middle is, and its half extents along its length, its thickness and its depth, metres.
const SCENE_RAMP_X : f64 = -6.0;
const SCENE_RAMP_Y : f64 = 1.6;
const SCENE_PLANK_HALF_LENGTH : f64 = 2.5;
const SCENE_PLANK_HALF_THICK : f64 = 0.1;
const SCENE_PLANK_HALF_WIDTH : f64 = 1.0;

// The slider box: its half edge, its mass in kilograms, how far down the plank it starts (negative: toward the
// high end), and how far its centre sits above the plank's face (the half edge and 2 mm of clearance).
const SCENE_SLIDER_HALF : f64 = 0.3;
const SCENE_SLIDER_MASS : f64 = 2.0;
const SCENE_SLIDER_BACK : f64 = -1.8;
const SCENE_SLIDER_LIFT : f64 = 0.302;

// The two balls that roll down the plank: how many, the first one's place along it, the gap between them, how
// far their centres sit above its face, and their radius, mass, friction and bounce.
const SCENE_RAMP_BALLS : i32 = 2;
const SCENE_RAMP_BALL_START : f64 = -0.4;
const SCENE_RAMP_BALL_GAP : f64 = 0.9;
const SCENE_RAMP_BALL_LIFT : f64 = 0.26;
const SCENE_RAMP_BALL_RADIUS : f64 = 0.25;
const SCENE_RAMP_BALL_MASS : f64 = 1.0;
const SCENE_RAMP_BALL_FRICTION : f64 = 0.6;
const SCENE_RAMP_BALL_BOUNCE : f64 = 0.2;

// The pyramid's cell size and the gap that keeps its boxes from starting in contact, metres.
const SCENE_PYRAMID_SIDE : f64 = 0.5;
const SCENE_PYRAMID_GAP : f64 = 0.01;

// The pyramid: rows (the bottom one holds as many boxes), the x of its middle, the extra height between rows that
// keeps them apart, and each box's mass and friction.
const SCENE_PYRAMID_ROWS : i32 = 5;
const SCENE_PYRAMID_X : f64 = 4.0;
const SCENE_PYRAMID_ROW_GAP : f64 = 0.002;
const SCENE_PYRAMID_MASS : f64 = 1.0;
const SCENE_PYRAMID_FRICTION : f64 = 0.6;

// The dropped balls: how many, the stream of the generator that jitters them, the first one's x, the gap between
// them and how far each may stray (the jitter is centred), the first one's height and the climb per ball with the
// stray above it, the depth stray, and their radius, mass, bounce, friction and rolling start speed.
const SCENE_DROPS : i32 = 6;
const SCENE_DROP_STREAM : u64 = 3;
const SCENE_DROP_X : f64 = -1.5;
const SCENE_DROP_GAP : f64 = 0.7;
const SCENE_DROP_JITTER_X : f64 = 0.3;
const SCENE_DROP_Y : f64 = 4.0;
const SCENE_DROP_CLIMB : f64 = 0.9;
const SCENE_DROP_JITTER_Y : f64 = 0.5;
const SCENE_DROP_JITTER_Z : f64 = 0.1;
const SCENE_DROP_RADIUS : f64 = 0.22;
const SCENE_DROP_MASS : f64 = 0.8;
const SCENE_DROP_BOUNCE : f64 = 0.55;
const SCENE_DROP_FRICTION : f64 = 0.4;
const SCENE_DROP_ROLL_MIN : f64 = 0.5;
const SCENE_DROP_ROLL_SPREAD : f64 = 0.5;

// The chain's masses, kilograms: a link and the bob.
const SCENE_LINK_MASS : f64 = 0.5;
const SCENE_BOB_MASS : f64 = 3.0;

/** The demo world and the handles into it. */
pub class Scene {
    /** The simulation. */
    pub world : PhysicsWorld;

    /** The boxes of the pyramid, bottom row first. */
    pub pyramid : Vec<EntityId>;

    /** The balls dropped around the pyramid. */
    pub balls : Vec<EntityId>;

    /** The box that slides down the ramp. */
    pub slider : EntityId;

    /** The links of the chain, then its bob. */
    pub chain : Vec<EntityId>;

    /** The ball-socket joints of the chain, from the pivot down. */
    pub joints : Vec<i32>;

    /** The positions of the pyramid boxes when they were placed (x, y, z per box). */
    pub pyramidAt : Vec<f64>;

    /** The distance from the pivot to the middle of the bob at rest, metres. */
    pub static fn reach() : f64 {
        return (SCENE_CHAIN_LINKS as f64) + SCENE_CHAIN_BOB_OFFSET;
    }

    /** Builds the scene; `seed` varies the ball positions. */
    constructor(seed : u64) {
        self.world = new PhysicsWorld(PhysicsSettings {});
        self.pyramid = new Vec<EntityId>();
        self.balls = new Vec<EntityId>();
        self.chain = new Vec<EntityId>();
        self.joints = new Vec<i32>();
        self.pyramidAt = new Vec<f64>();
        self.slider = EntityId::none();

        self.buildBounds();
        self.buildRamp();
        self.buildPyramid();
        self.buildBalls(seed);
        self.buildChain();
    }

    // The ground and, because the side view must stay honest, four walls: nothing wanders off in depth or out of
    // the picture.
    fn buildBounds(mut self) : void {
        self.world.addBody(BodyDesc::fixed(Shape::plane(DVec3::unitY(), SCENE_GROUND_Y), DVec3::zero()));
        let back : DVec3 = DVec3::make(0.0, 0.0, -1.0);
        let front : DVec3 = DVec3::make(0.0, 0.0, 1.0);
        let left : DVec3 = DVec3::make(1.0, 0.0, 0.0);
        let right : DVec3 = DVec3::make(-1.0, 0.0, 0.0);
        self.world.addBody(BodyDesc::fixed(Shape::plane(back, 0.0 - SCENE_WALL_DEPTH), DVec3::zero()));
        self.world.addBody(BodyDesc::fixed(Shape::plane(front, 0.0 - SCENE_WALL_DEPTH), DVec3::zero()));
        self.world.addBody(BodyDesc::fixed(Shape::plane(left, SCENE_WALL_LEFT), DVec3::zero()));
        self.world.addBody(BodyDesc::fixed(Shape::plane(right, SCENE_WALL_RIGHT), DVec3::zero()));
    }

    // A tilted plank, low end to the right, with a box on it that slides (friction 0.3 < tan 20 degrees) and
    // two balls that roll.
    fn buildRamp(mut self) : void {
        let centre : DVec3 = DVec3::make(SCENE_RAMP_X, SCENE_RAMP_Y, 0.0);
        let plankHalf : DVec3 = DVec3::make(
            SCENE_PLANK_HALF_LENGTH,
            SCENE_PLANK_HALF_THICK,
            SCENE_PLANK_HALF_WIDTH
        );
        let mut plank : BodyDesc = BodyDesc::fixed(
            Shape::cuboid(plankHalf.x, plankHalf.y, plankHalf.z),
            centre
        );
        plank.rotation = DQuat::fromAxisAngle(DVec3::unitZ(), SCENE_RAMP_TILT);
        plank.friction = SCENE_RAMP_FRICTION;
        self.world.addBody(plank);

        // Points along the top face: u along the plank, n out of it.
        let u : DVec3 = DVec3::make(cosD(SCENE_RAMP_TILT), sinD(SCENE_RAMP_TILT), 0.0);
        let n : DVec3 = DVec3::make(0.0 - sinD(SCENE_RAMP_TILT), cosD(SCENE_RAMP_TILT), 0.0);
        let origin : DVec3 = centre.plus(n.scale(SCENE_PLANK_HALF_THICK));

        let sliderAt : DVec3 = origin.plus(u.scale(SCENE_SLIDER_BACK)).plus(n.scale(SCENE_SLIDER_LIFT));
        let sliderShape : Shape = Shape::cuboid(SCENE_SLIDER_HALF, SCENE_SLIDER_HALF, SCENE_SLIDER_HALF);
        let mut box : BodyDesc = BodyDesc::dynamic(sliderShape, sliderAt, SCENE_SLIDER_MASS);
        box.rotation = DQuat::fromAxisAngle(DVec3::unitZ(), SCENE_RAMP_TILT);
        box.friction = SCENE_RAMP_FRICTION;
        self.slider = self.world.addBody(box);

        for (i of 0..SCENE_RAMP_BALLS) {
            let along : f64 = SCENE_RAMP_BALL_START + SCENE_RAMP_BALL_GAP * (i as f64);
            let at : DVec3 = origin.plus(u.scale(along)).plus(n.scale(SCENE_RAMP_BALL_LIFT));
            let shape : Shape = Shape::sphere(SCENE_RAMP_BALL_RADIUS);
            let mut ball : BodyDesc = BodyDesc::dynamic(shape, at, SCENE_RAMP_BALL_MASS);
            ball.friction = SCENE_RAMP_BALL_FRICTION;
            ball.restitution = SCENE_RAMP_BALL_BOUNCE;
            self.balls.push(self.world.addBody(ball));
        }
    }

    // Five rows of boxes (5, 4, 3, 2, 1) centred on x = 4.
    fn buildPyramid(mut self) : void {
        let half : f64 = SCENE_PYRAMID_SIDE * 0.5;
        for (row of 0..SCENE_PYRAMID_ROWS) {
            let count : i32 = SCENE_PYRAMID_ROWS - row;
            for (k of 0..count) {
                let offset : f64 = (k as f64) - ((count - 1) as f64) * 0.5;
                let x : f64 = SCENE_PYRAMID_X + offset * (SCENE_PYRAMID_SIDE + SCENE_PYRAMID_GAP);
                let y : f64 = half + (row as f64) * (SCENE_PYRAMID_SIDE + SCENE_PYRAMID_ROW_GAP);
                let shape : Shape = Shape::cuboid(half, half, half);
                let mut d : BodyDesc = BodyDesc::dynamic(shape, DVec3::make(x, y, 0.0), SCENE_PYRAMID_MASS);
                d.friction = SCENE_PYRAMID_FRICTION;
                self.pyramid.push(self.world.addBody(d));
                self.pyramidAt.push(x);
                self.pyramidAt.push(y);
                self.pyramidAt.push(0.0);
            }
        }
    }

    // Balls dropped from different heights left of the pyramid, a few rolling toward it.
    fn buildBalls(mut self, seed : u64) : void {
        let rng : Pcg32 = new Pcg32(seed, SCENE_DROP_STREAM);
        for (i of 0..SCENE_DROPS) {
            // The generator is drawn in this order for every ball; a different order is a different world.
            let strayX : f64 = (rng.nextF64() - 0.5) * SCENE_DROP_JITTER_X;
            let strayY : f64 = rng.nextF64() * SCENE_DROP_JITTER_Y;
            let strayZ : f64 = (rng.nextF64() - 0.5) * SCENE_DROP_JITTER_Z;
            let roll : f64 = SCENE_DROP_ROLL_MIN + SCENE_DROP_ROLL_SPREAD * rng.nextF64();

            let x : f64 = SCENE_DROP_X + (i as f64) * SCENE_DROP_GAP + strayX;
            let y : f64 = SCENE_DROP_Y + (i as f64) * SCENE_DROP_CLIMB + strayY;
            let shape : Shape = Shape::sphere(SCENE_DROP_RADIUS);
            let mut d : BodyDesc = BodyDesc::dynamic(shape, DVec3::make(x, y, strayZ), SCENE_DROP_MASS);
            d.restitution = SCENE_DROP_BOUNCE;
            d.friction = SCENE_DROP_FRICTION;
            d.linearVelocity = DVec3::make(roll, 0.0, 0.0);
            self.balls.push(self.world.addBody(d));
        }
    }

    // Four capsule links and a heavy bob, hung from a fixed pivot and let go 60 degrees from the vertical.
    fn buildChain(mut self) : void {
        let pivot : DVec3 = DVec3::make(SCENE_CHAIN_PIVOT_X, SCENE_CHAIN_PIVOT_Y, 0.0);
        let dir : DVec3 = DVec3::make(
            0.0 - sinD(SCENE_CHAIN_RELEASE),
            0.0 - cosD(SCENE_CHAIN_RELEASE),
            0.0
        );

        let mut prev : EntityId = EntityId::none();
        for (i of 0..SCENE_CHAIN_LINKS) {
            let centre : DVec3 = pivot.plus(dir.scale((i as f64) + 0.5));
            let mut link : BodyDesc = BodyDesc::dynamic(
                Shape::capsule(SCENE_LINK_RADIUS, SCENE_LINK_HALF),
                centre,
                SCENE_LINK_MASS
            );
            link.rotation = DQuat::fromTo(DVec3::unitY(), dir);
            let id : EntityId = self.world.addBody(link);

            let anchor : DVec3 = pivot.plus(dir.scale(i as f64));
            self.joints.push(self.world.addBallSocket(prev, id, anchor));
            self.chain.push(id);
            prev = id;
        }

        let bobCentre : DVec3 = pivot.plus(dir.scale(Scene::reach()));
        let bobBody : BodyDesc = BodyDesc::dynamic(
            Shape::sphere(SCENE_BOB_RADIUS),
            bobCentre,
            SCENE_BOB_MASS
        );
        let bob : EntityId = self.world.addBody(bobBody);
        let anchor : DVec3 = pivot.plus(dir.scale(SCENE_CHAIN_LINKS as f64));
        self.joints.push(self.world.addBallSocket(prev, bob, anchor));
        self.chain.push(bob);
    }
}

// floor — a textured plane receding to the horizon, drawn three ways.
//
// Every pixel below the horizon looks at a point of an infinite floor; the texture is read there. How many
// texels one pixel covers grows with distance, and that number is what the three filters do with differently:
// `nearest` ignores it (the far floor sparkles and crawls), `bilinear` blends neighbours but only on the finest
// level (still aliased far away), `trilinear` picks the mip level the number asks for (calm and a little soft).
// The panels are drawn side by side from one camera so the difference is the only thing that differs.
//
// The camera is a `FloorView`, not a width, a height and a scroll passed in a row: every panel below uses the
// same view except for the texture and the filter, and repeating three numbers at each call invites a typo.

use ludax::{Image, Texture, Vec4, lightSrgbEncode8};

/** Which read each panel uses. */
pub enum FloorFilter : i8 {
    /** The nearest texel of the finest level. */
    Nearest = 0,
    /** Four texels of the finest level, blended. */
    Bilinear = 1,
    /** Two mip levels chosen by the pixel's footprint, each read bilinearly. */
    Trilinear = 2,
}

/** The camera and panel size a floor picture is drawn with. */
pub struct FloorView {
    /** Panel width in pixels. */
    pub width : i32 = 1;

    /** Panel height in pixels. */
    pub height : i32 = 1;

    /** How far the camera has travelled along the floor's v axis, world units. */
    pub scroll : f32 = 0.0;
}

// The camera: eye height above the floor, the horizon's fraction of the panel, and focal length as a fraction
// of the width. Fixed so every panel sees the same view.
const FLOOR_EYE : f32 = 0.6;
const FLOOR_HORIZON : f32 = 0.38;
const FLOOR_FOCAL : f32 = 0.85;

// The middle of a pixel, and the middle of the panel.
const FLOOR_CENTRE : f32 = 0.5;

// Haze reaches full strength at this distance, world units.
const FLOOR_FOG_DISTANCE : f32 = 40.0;

// The fog's colour, in linear light.
const FLOOR_FOG_R : f32 = 0.30;
const FLOOR_FOG_G : f32 = 0.45;
const FLOOR_FOG_B : f32 = 0.85;

// The sky gradient: its colour at the horizon and how much it adds by the top of the panel.
const FLOOR_SKY_R : i32 = 110;
const FLOOR_SKY_G : i32 = 150;
const FLOOR_SKY_B : i32 = 235;
const FLOOR_SKY_R_SPAN : f32 = 80.0;
const FLOOR_SKY_G_SPAN : f32 = 60.0;

// Every pixel of a panel is opaque.
const FLOOR_ALPHA : i32 = 255;

/** One panel of `tex` seen from `view`, read with `filter`. */
pub fn floorPanel(tex : Texture, view : FloorView, filter : FloorFilter) : Image {
    let img : Image = new Image(view.width, view.height);
    let horizon : f32 = (view.height as f32) * FLOOR_HORIZON;
    let focal : f32 = (view.width as f32) * FLOOR_FOCAL;
    let texW : f32 = tex.width(0) as f32;

    for (y of 0..view.height) {
        let dy : f32 = (y as f32) + FLOOR_CENTRE - horizon;

        for (x of 0..view.width) {
            if (dy <= FLOOR_CENTRE) {
                // The sky: a vertical gradient from the horizon up.
                let t : f32 = ((y as f32) / horizon).min((1.0 as f32));
                let r : i32 = FLOOR_SKY_R + (FLOOR_SKY_R_SPAN * t) as i32;
                let g : i32 = FLOOR_SKY_G + (FLOOR_SKY_G_SPAN * t) as i32;
                img.set(x, y, Image::pack(r, g, FLOOR_SKY_B, FLOOR_ALPHA));
                continue;
            }

            let z : f32 = FLOOR_EYE * focal / dy;
            let wx : f32 = ((x as f32) + FLOOR_CENTRE - (view.width as f32) * FLOOR_CENTRE) * z / focal;
            let v : f32 = z + view.scroll;

            // Texels one pixel covers across and along the floor; their mean stands in for anisotropic filtering.
            let across : f32 = texW * z / focal;
            let along : f32 = texW * z * z / (FLOOR_EYE * focal);
            let footprint : f32 = (across + along) * FLOOR_CENTRE;
            let c : Vec4 = floorRead(tex, wx, v, footprint, filter);

            // A little distance haze so the horizon melts into the sky.
            let fog : f32 = (z / FLOOR_FOG_DISTANCE).min((1.0 as f32));
            let clear : f32 = (1.0 as f32) - fog;
            let r : f32 = c.x * clear + FLOOR_FOG_R * fog;
            let g : f32 = c.y * clear + FLOOR_FOG_G * fog;
            let b : f32 = c.z * clear + FLOOR_FOG_B * fog;
            let red8 : i32 = lightSrgbEncode8(r);
            let green8 : i32 = lightSrgbEncode8(g);
            let blue8 : i32 = lightSrgbEncode8(b);
            img.set(x, y, Image::pack(red8, green8, blue8, FLOOR_ALPHA));
        }
    }
    return img;
}

// Reads `tex` through the chosen filter.
fn floorRead(tex : Texture, u : f32, v : f32, footprint : f32, filter : FloorFilter) : Vec4 {
    return match filter {
        FloorFilter::Nearest => tex.nearest(0, u, v),
        FloorFilter::Bilinear => tex.bilinear(0, u, v),
        FloorFilter::Trilinear => tex.trilinear(u, v, footprint),
    };
}

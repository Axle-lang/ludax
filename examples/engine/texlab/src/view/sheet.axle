// sheet — pictures laid out for looking at: a mip chain, and panels side by side.
//
// The sheets are contact prints, not textures: they exist so a person can open one PNG and see every level of
// a mip chain shrinking to a texel, or three filters side by side. Spacing and background are named because
// a layout is easy to nudge by a pixel and hard to notice afterwards.

use ludax::{Image, Texture};

/** The gap between pictures, in pixels. */
const SHEET_GAP : i32 = 4;

/** The margin around a sheet's contents, in pixels. */
const SHEET_MARGIN : i32 = 4;

/**
 * The sheet's background, so a transparent texel is visible as a colour rather than as nothing: 0xFF2E2828 as a
 * signed 32-bit word, because the language has no unsigned int literal.
 */
const SHEET_BACKGROUND : i32 = -13752280;

/** The black behind a row of panels, so the gap between them shows it: 0xFF000000 as a signed 32-bit word. */
const SHEET_ROW_BACKGROUND : i32 = -16777216;

/** The mip chain of `tex`, finest level first, each level shown at `scale` pixels per texel of the finest level's size. */
pub fn sheetMips(tex : Texture, scale : i32) : Image {
    let mut width : i32 = SHEET_MARGIN;
    for (l of 0..tex.levels()) {
        width = width + tex.width(l) * scale + SHEET_GAP;
    }
    let height : i32 = tex.height(0) * scale + SHEET_MARGIN * 2;

    let sheet : Image = new Image(width, height);
    sheet.fill(SHEET_BACKGROUND);

    let mut x : i32 = SHEET_MARGIN;
    for (l of 0..tex.levels()) {
        // Every level is drawn at its own size times `scale`, so the chain visibly shrinks to a single texel.
        let img : Image = tex.levelImage(l);
        let mut zoom : i32 = scale;
        if (zoom < 1) {
            zoom = 1;
        }

        for (py of 0..(img.height() * zoom)) {
            for (px of 0..(img.width() * zoom)) {
                sheet.set(x + px, SHEET_MARGIN + py, img.get(px / zoom, py / zoom));
            }
        }
        x = x + img.width() * zoom + SHEET_GAP;
    }
    return sheet;
}

/** The images side by side in a row, `SHEET_GAP` pixels apart. */
pub fn sheetRow(a : Image, b : Image, c : Image) : Image {
    let width : i32 = a.width() + b.width() + c.width() + SHEET_GAP * 2;
    let sheet : Image = new Image(width, a.height());
    sheet.fill(SHEET_ROW_BACKGROUND);

    sheet.blit(a, 0, 0);
    sheet.blit(b, a.width() + SHEET_GAP, 0);
    sheet.blit(c, a.width() + b.width() + SHEET_GAP * 2, 0);
    return sheet;
}

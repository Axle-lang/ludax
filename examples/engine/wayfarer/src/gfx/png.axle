// png — writes the canvas as a PNG file with the library's own encoder.
//
// The example draws into its own RGB `Canvas`; this copies it into a ludax `Image` and lets `PngCodec` (through
// `DataFiles`) encode it, so there is one PNG writer in the code base and not one per example.

use ludax::{DataFiles, Image};

use crate::gfx::canvas::Canvas;

/** Saves canvases as PNG. */
pub class PngFile {
    /** Writes `canvas` to `path`. */
    pub static fn write(canvas : Canvas, path : string) : void ! IOException {
        let img : Image = new Image(canvas.width(), canvas.height());
        for (y of 0..canvas.height()) {
            for (x of 0..canvas.width()) {
                img.set(
                    x,
                    y,
                    Image::pack(
                        canvas.channel(x, y, 0),
                        canvas.channel(x, y, 1),
                        canvas.channel(x, y, 2),
                        255
                    )
                );
            }
        }
        DataFiles::savePng(path, img);
    }
}

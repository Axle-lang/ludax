// canvas — a small RGB picture to draw the map on: rectangles, lines, discs.
//
// Bytes in a `malloc` array, three per pixel, row by row from the top. Drawing outside the picture is ignored,
// so callers never clip. Only what the example needs: it is not a graphics library. Colours travel as a value
// rather than as three more integers, because every drawing call ends in a colour and a transposed channel is
// invisible until the picture is written; the line walker keeps a guard so a degenerate segment cannot hang.

/** An opaque 8-bit colour, one channel each in 0..255. */
pub struct CanvasColor {
    /** Red. */
    pub r : i32 = 0;

    /** Green. */
    pub g : i32 = 0;

    /** Blue. */
    pub b : i32 = 0;

    /** The colour of the three channels. */
    pub static fn make(r : i32, g : i32, b : i32) : CanvasColor {
        return CanvasColor { r: r, g: g, b: b };
    }
}

/** A run between two pixels, both included. */
pub struct CanvasSegment {
    /** The start column. */
    pub x0 : i32 = 0;

    /** The start row. */
    pub y0 : i32 = 0;

    /** The end column. */
    pub x1 : i32 = 0;

    /** The end row. */
    pub y1 : i32 = 0;
}

/** A block of pixels: its top-left corner and its size. */
pub struct CanvasBox {
    /** The left column. */
    pub x : i32 = 0;

    /** The top row. */
    pub y : i32 = 0;

    /** The width in pixels. */
    pub w : i32 = 0;

    /** The height in pixels. */
    pub h : i32 = 0;
}

// Bytes per pixel, and the most steps a line may take before its walker gives up.
const CANVAS_BPP : i32 = 3;
const CANVAS_LINE_GUARD : i32 = 100000;

// The low 8 bits of a channel: the bytes are stored signed.
const CANVAS_CHANNEL_MASK : i32 = 255;

/** An RGB picture. */
pub class Canvas {
    w   : i32;
    h   : i32;
    rgb : i8[];

    /** A black picture of `width` x `height` pixels. */
    constructor(width : i32, height : i32) {
        self.w = width;
        self.h = height;
        self.rgb = new i8[(width * height * CANVAS_BPP) as i64];
        for (i of 0..(width * height * CANVAS_BPP)) {
            self.rgb[i] = 0;
        }
    }

    /** The width in pixels. */
    pub fn width(self) : i32 {
        return self.w;
    }

    /** The height in pixels. */
    pub fn height(self) : i32 {
        return self.h;
    }

    /** The colour channel `c` (0 red, 1 green, 2 blue) of pixel (`x`, `y`), 0..255. */
    pub fn channel(self, x : i32, y : i32, c : i32) : i32 {
        if (x < 0 || y < 0 || x >= self.w || y >= self.h) {
            return 0;
        }
        return (self.rgb[(y * self.w + x) * CANVAS_BPP + c] as i32) & CANVAS_CHANNEL_MASK;
    }

    /** Sets one pixel; outside the picture nothing happens. */
    pub fn set(mut self, x : i32, y : i32, color : CanvasColor) : void {
        if (x < 0 || y < 0 || x >= self.w || y >= self.h) {
            return;
        }
        let at : i32 = (y * self.w + x) * CANVAS_BPP;
        self.rgb[at] = (color.r & CANVAS_CHANNEL_MASK) as i8;
        self.rgb[at + 1] = (color.g & CANVAS_CHANNEL_MASK) as i8;
        self.rgb[at + 2] = (color.b & CANVAS_CHANNEL_MASK) as i8;
    }

    /** Fills the block of pixels. */
    pub fn fillRect(mut self, area : CanvasBox, color : CanvasColor) : void {
        for (py of area.y..(area.y + area.h)) {
            for (px of area.x..(area.x + area.w)) {
                self.set(px, py, color);
            }
        }
    }

    /** Draws the segment, `thick` pixels wide (1 or more). */
    pub fn line(mut self, seg : CanvasSegment, thick : i32, color : CanvasColor) : void {
        let x0 : i32 = seg.x0;
        let y0 : i32 = seg.y0;
        let x1 : i32 = seg.x1;
        let y1 : i32 = seg.y1;
        let mut dx : i32 = x1 - x0;
        if (dx < 0) {
            dx = -dx;
        }
        let mut dy : i32 = y1 - y0;
        if (dy < 0) {
            dy = -dy;
        }
        let mut sx : i32 = 1;
        if (x1 < x0) {
            sx = -1;
        }
        let mut sy : i32 = 1;
        if (y1 < y0) {
            sy = -1;
        }

        // Bresenham: step the axis with the larger error, and stop as soon as both ends meet.
        let mut err : i32 = dx - dy;
        let mut x : i32 = x0;
        let mut y : i32 = y0;
        let mut guard : i32 = 0;
        while (guard < CANVAS_LINE_GUARD) {
            self.disc(x, y, thick / 2, color);
            if (x == x1 && y == y1) {
                return;
            }
            let e2 : i32 = 2 * err;
            if (e2 > -dy) {
                err = err - dy;
                x = x + sx;
            }
            if (e2 < dx) {
                err = err + dx;
                y = y + sy;
            }
            guard = guard + 1;
        }
    }

    /** Fills a disc of the given radius in pixels (radius 0 is one pixel). */
    pub fn disc(mut self, cx : i32, cy : i32, radius : i32, color : CanvasColor) : void {
        for (py of (cy - radius)..(cy + radius + 1)) {
            for (px of (cx - radius)..(cx + radius + 1)) {
                let dx : i32 = px - cx;
                let dy : i32 = py - cy;
                if (dx * dx + dy * dy <= radius * radius + radius) {
                    self.set(px, py, color);
                }
            }
        }
    }

    /** The raw bytes of pixel row `y` start at this offset into `bytes()`. */
    pub fn rowOffset(self, y : i32) : i32 {
        return y * self.w * CANVAS_BPP;
    }

    /** The pixel bytes, three per pixel (borrowed: do not keep). */
    pub fn bytes(self) : i8[] {
        return self.rgb;
    }
}

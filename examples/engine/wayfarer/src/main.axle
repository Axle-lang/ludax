// wayfarer — path finding and animation on the Ludax engine, headless.
//
// Generates a dungeon, plans routes with A*, a flow field and a navigation mesh, walks eight agents (one an
// animated skeleton) along them with steering, checks the results against independent answers, and writes
// `wayfarer.png`, a top-down picture of it all. The whole demonstration is a pair of runs from the same seed,
// so the determinism check compares two complete simulations rather than two snapshots of one.
//
// The exit status is the number of failed checks, which makes a broken example fail a script. The PNG is read
// back after writing because an encoder that writes a plausible file with the wrong signature or size is a
// failure the picture itself cannot show.

use std::io::FileInputStream;

use ludax::Checks;

use crate::app::scenario::Scenario;
use crate::app::verify::Verify;
use crate::gfx::canvas::Canvas;
use crate::gfx::png::PngFile;
use crate::gfx::render::MapView;

// The map comes from this seed; another seed is another dungeon.
const WAY_SEED : u64 = 20260605;

// Steps allowed to each run. Both runs share it so a crowd that stalls cannot hang the example.
const WAY_STEP_BUDGET : i32 = 5000;

// Where the picture is written, and read back from.
const WAY_PNG : string = "wayfarer.png";

// A PNG starts with an 8-byte signature and the IHDR chunk; its width and height are big-endian at 16 and 20.
const PNG_HEAD_BYTES : i32 = 24;
const PNG_WIDTH_AT : i32 = 16;
const PNG_HEIGHT_AT : i32 = 20;
const PNG_BYTE : i32 = 255;
const PNG_SIG_0 : i32 = 137;
const PNG_SIG_P : i32 = 80;
const PNG_SIG_N : i32 = 78;
const PNG_SIG_G : i32 = 71;

fn main() : i32 {
    let c : Checks = new Checks();
    let scene : Scenario = new Scenario(WAY_SEED);
    scene.run(WAY_STEP_BUDGET);

    // The same seed again: any difference between the two runs is a determinism bug, not a different map.
    let again : Scenario = new Scenario(WAY_SEED);
    again.run(WAY_STEP_BUDGET);
    Verify::run(c, scene, again);

    try {
        let picture : Canvas = MapView::draw(scene);
        let width : i32 = picture.width();
        let height : i32 = picture.height();
        PngFile::write(picture, WAY_PNG);
        c.that(
            "the picture was written and reads back as a PNG of the right size",
            wayfarerCheckPng(WAY_PNG, width, height)
        );
        println("wrote ${WAY_PNG} (${width} x ${height})");
    } catch e : IOException {
        println("could not write ${WAY_PNG}: ${e.message}");
        c.that("the picture was written", false);
    }

    println("checks: ${c.count()}, failed: ${c.failures()}");
    return c.failures();
}

// Reads the file back and tests the signature and the size in the header chunk.
fn wayfarerCheckPng(path : string, w : i32, h : i32) : bool {
    let head : i8[] = new i8[PNG_HEAD_BYTES as i64];
    try {
        let input = new FileInputStream(path);
        let n : i64 = input.readBytes(head, 0, PNG_HEAD_BYTES);
        input.close();
        if (n < PNG_HEAD_BYTES) {
            return false;
        }
    } catch e : IOException {
        return false;
    }

    let sig : bool = (head[0] as i32 & PNG_BYTE) == PNG_SIG_0 && head[1] as i32 == PNG_SIG_P
        && head[2] as i32 == PNG_SIG_N
        && head[3] as i32 == PNG_SIG_G;
    let wide : i32 = wayfarerBigEndian(head, PNG_WIDTH_AT);
    let high : i32 = wayfarerBigEndian(head, PNG_HEIGHT_AT);
    return sig && wide == w && high == h;
}

// The big-endian 32-bit integer at `at`; PNG writes its sizes most significant byte first.
fn wayfarerBigEndian(bytes : i8[], at : i32) : i32 {
    return ((bytes[at] as i32 & PNG_BYTE) << 24) | ((bytes[at + 1] as i32 & PNG_BYTE) << 16)
        | ((bytes[at + 2] as i32 & PNG_BYTE) << 8)
        | (bytes[at + 3] as i32 & PNG_BYTE);
}

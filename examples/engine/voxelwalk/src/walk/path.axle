// path — the scripted camera: a long, gently winding flight east.
//
// Everything is a function of the step number, so the flight is the same on every run. The camera advances one
// chunk per step along x and weaves along z, so the focus crosses a chunk border on every step and the streamer
// has to keep up with a full column of new chunks each time.

use ludax::sinD;

/** Blocks flown per step: one chunk. */
const WALK_STRIDE : f64 = 16.0;

/** The weave reaches this far either side of the axis, blocks. */
const WALK_WEAVE : f64 = 150.0;

/** One full weave cycle takes this many blocks of flight. */
const WALK_WEAVE_PERIOD : f64 = 640.0;

/** Where the camera is. */
pub class WalkPath {
    /** Blocks flown per step. */
    pub static fn stride() : f64 {
        return WALK_STRIDE;
    }

    /** The camera's x after `step` steps. */
    pub static fn x(step : i32) : f64 {
        return step as f64 * WALK_STRIDE;
    }

    /** The camera's z after `step` steps: a weave that reaches `WALK_WEAVE` blocks either side of the axis. */
    pub static fn z(step : i32) : f64 {
        return WALK_WEAVE * sinD((step as f64) * WALK_STRIDE / WALK_WEAVE_PERIOD);
    }
}

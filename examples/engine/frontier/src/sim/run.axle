// run — plays the game under a pacing and answers what happened.
//
// `frontierPlay` builds a game, drives a `GameLoop` with a fake clock until the game says it is done (or a hard
// cap of simulated minutes is reached), and hands back the game for inspection together with the numbers of
// the loop: frames, steps, clamps. The recording, if any, is in the game afterwards.
//
// The step cap per frame is part of the test: a long frame that would otherwise run fifty steps runs at most
// twelve and drops the rest, which is what a real loop does when it cannot keep up. A replay must still land on
// the same tick because the tape, not the frame count, says what each step was.

use ludax::{GameLoop, InputTape, LoopConfig};

use crate::sim::game::FrontierGame;
use crate::sim::pacing::FrameClock;

// The longest run, in steps (ten simulated minutes), and the most steps one frame may run.
const PLAY_CAP : i64 = 36000;
const PLAY_MAX_STEPS_PER_FRAME : i32 = 12;

/** The numbers of one loop run. */
pub struct PlayStats {
    /** Frames the loop ran. */
    pub frames : i64;

    /** Simulation steps. */
    pub ticks : i64;

    /** The most steps any one frame ran. */
    pub mostSteps : i32;

    /** Frames the loop had to clamp. */
    pub clamped : i64;

    /** Real time the per-frame step cap dropped, in nanoseconds. */
    pub dropped : i64;
}

/** Plays one run of the game under pacing `pacing` until it is done. */
pub fn frontierPlay(game : FrontierGame, pacing : i32) : PlayStats {
    let mut cfg : LoopConfig = LoopConfig::standard();
    cfg.maxStepsPerFrame = PLAY_MAX_STEPS_PER_FRAME;
    let lp : GameLoop<FrontierGame> = new GameLoop<FrontierGame>(cfg);
    let clock : FrameClock = new FrameClock(pacing);
    let mut frames : i64 = 0;
    let mut most : i32 = 0;
    let mut running : bool = true;
    while (running && lp.ticks() < PLAY_CAP) {
        running = lp.frame(game, clock.next());
        frames = frames + 1;
        if (lp.stepsLastFrame() > most) {
            most = lp.stepsLastFrame();
        }
    }

    return PlayStats {
        frames: frames,
        ticks: lp.ticks(),
        mostSteps: most,
        clamped: lp.clampedFrames(),
        dropped: lp.droppedTime(),
    };
}

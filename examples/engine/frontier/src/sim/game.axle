// game — the frontier as a `GameModule`: what the main loop calls.
//
// The loop calls `input` once per frame, `simulate` once per fixed step and `render` once per frame. The
// frontier's input is sampled per step, not per frame (a replay has one snapshot per step), so `input` only
// counts frames. `simulate` is the scheduler at work: the systems are registered in one order, constraints say
// what must come before what, and `run` walks the order the constraints resolve to.
//
// The clock is a system rather than the loop: it advances the sky and the weather by a fixed tick, so the same
// tape under a different frame pacing reaches the same time of day. The stream system's budget is declared here
// so the account of work units is part of the game, not of the scheduler.

use ludax::{GameModule, InputTape, Scheduler};

use crate::sim::systems::{FrontierSystems, Sys};

// Work units the stream system may spend in a step before the scheduler reports it over budget.
const FRONTIER_STREAM_BUDGET : i32 = 300;

/** The frontier game. */
pub class FrontierGame : GameModule {
    /** The simulation. */
    pub sys : FrontierSystems;

    /** Orders and accounts for the systems. */
    pub sched : Scheduler;

    /** Frames whose `input` was called. */
    pub frames : i64 = 0;

    /** Frames drawn. */
    pub renders : i64 = 0;

    /** The interpolation factor of the last frame. */
    pub lastAlpha : f32 = 0.0;

    /** A game that records its input into `tape` (or, with `replay`, plays `tape` back). */
    constructor(own tape : InputTape, replay : bool) {
        self.sys = new FrontierSystems(tape, replay);
        self.sched = new Scheduler();

        // Registered in code order; the order they run in comes from these constraints.
        let input : Sys = Sys::Input;
        let vehicle : Sys = Sys::Vehicle;
        let stream : Sys = Sys::Stream;
        let missions : Sys = Sys::Missions;
        let clock : Sys = Sys::Clock;
        self.sched.add(input.label());
        self.sched.add(vehicle.label());
        self.sched.add(stream.label());
        self.sched.add(missions.label());
        self.sched.add(clock.label());
        self.sched.after(vehicle.label(), input.label());
        self.sched.after(stream.label(), vehicle.label());
        self.sched.after(missions.label(), stream.label());
        self.sched.before(clock.label(), input.label());
        self.sched.setBudget(self.sched.find(stream.label()), FRONTIER_STREAM_BUDGET);
        self.sched.resolve();
    }

    /** Counts a frame; the input is read per step by the input system, so `frame` is not needed here. */
    pub fn input(mut self, frame : i64) : void {
        self.frames = self.frames + 1;
    }

    /** One step: every enabled system once, in order. */
    pub fn simulate(mut self, tick : i64, dt : f32) : void {
        self.sys.ticks = tick;
        self.sched.run(self.sys, tick);
        // The systems saw this tick as their own number; the next step is the next number.
        self.sys.ticks = tick + 1;
    }

    /** Counts a drawn frame. */
    pub fn render(mut self, alpha : f32) : void {
        self.renders = self.renders + 1;
        self.lastAlpha = alpha;
    }

    /** True when the missions are done. */
    pub fn wantsQuit(self) : bool {
        return self.sys.done;
    }
}

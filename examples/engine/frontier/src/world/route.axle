// route — the places the story visits, and the mission that strings them together.
//
// Eight waypoints in order: the start, three depots where crates are picked up, an outpost where the car
// stops and unloads, two corners of the way back, and home. `missionText` writes the mission in the text format
// of `MissionText` from those same coordinates, so the map and the mission cannot disagree.
//
// The numbers in the mission (radii, timers, rewards) live here rather than in the text as literals, so a change
// to the route's shape and a change to its rules are both visible in one file.

// The waypoint count and the indices the mission names: the outpost it unloads at, and home.
const ROUTE_COUNT : i32 = 8;
const ROUTE_OUTPOST : i32 = 4;
const ROUTE_HOME : i32 = 7;

// The mission's numbers: how near counts as reached, the return timer, the whole-run timeout, and the rewards.
/** How many crates the first stage asks for: one per depot. */
pub const ROUTE_CRATES : i32 = 3;
const ROUTE_REACH_RADIUS : i32 = 30;
const ROUTE_RETURN_TIMER : i32 = 2;
const ROUTE_TIMEOUT : i32 = 400;

/** The gold the main mission pays. */
pub const ROUTE_GOLD : i32 = 500;
const ROUTE_DEBRIEF_TIMER : i32 = 1;

/** The standing the debrief pays. */
pub const ROUTE_STANDING : i32 = 1;

/** The main mission's name, as the mission text declares it and the board is asked about it. */
pub const ROUTE_MISSION_MAIN : string = "frontier_run";

/** The follow-up mission that starts itself when the main one is done. */
pub const ROUTE_MISSION_DEBRIEF : string = "debrief";

/** The flag the outpost's unloading posts. */
pub const ROUTE_FLAG_UNLOADED : string = "unloaded";

/** What a depot's crate is called when it is collected. */
pub const ROUTE_ITEM_CRATE : string = "crate";

/** The reward of the main mission, and the one of the debrief. */
pub const ROUTE_REWARD_GOLD : string = "gold";
pub const ROUTE_REWARD_STANDING : string = "standing";

// The waypoints, metres: the start, three depots on the way out, the outpost at the far end, two corners of the
// way back and home. Each is its x and z; the order is the order they are visited in.
const ROUTE_START_X : f64 = 100.0;
const ROUTE_START_Z : f64 = 100.0;
const ROUTE_DEPOT_A_X : f64 = 600.0;
const ROUTE_DEPOT_A_Z : f64 = 150.0;
const ROUTE_DEPOT_B_X : f64 = 1000.0;
const ROUTE_DEPOT_B_Z : f64 = 600.0;
const ROUTE_DEPOT_C_X : f64 = 1300.0;
const ROUTE_DEPOT_C_Z : f64 = 400.0;
const ROUTE_OUTPOST_X : f64 = 1700.0;
const ROUTE_OUTPOST_Z : f64 = 900.0;
const ROUTE_CORNER_A_X : f64 = 1500.0;
const ROUTE_CORNER_A_Z : f64 = 1400.0;
const ROUTE_CORNER_B_X : f64 = 800.0;
const ROUTE_CORNER_B_Z : f64 = 1500.0;
const ROUTE_HOME_X : f64 = 150.0;
const ROUTE_HOME_Z : f64 = 900.0;

/** What the driver does at a waypoint. */
pub enum StopKind : i8 {
    /** Drive through. */
    Pass = 0,

    /** A depot: drive through slowly; crates are collected within reach. */
    Depot = 1,

    /** Come to a halt and wait. */
    Halt = 2,

    /** The way home: the end of the route. */
    Home = 3,

    /** The kind with number `n`; anything else answers Pass. */
    pub static fn fromCode(n : i32) : StopKind {
        return match n {
            1 => StopKind::Depot,
            2 => StopKind::Halt,
            3 => StopKind::Home,
            _ => StopKind::Pass,
        };
    }
}

/** The route as a list of places. */
pub class Route {
    xs    : f64[];
    zs    : f64[];
    kinds : i32[];
    total : i32 = ROUTE_COUNT;

    /** The frontier's route. */
    constructor() {
        self.xs = new f64[ROUTE_COUNT as i64];
        self.zs = new f64[ROUTE_COUNT as i64];
        self.kinds = new i32[ROUTE_COUNT as i64];
        self.put(0, ROUTE_START_X, ROUTE_START_Z, StopKind::Pass);
        self.put(1, ROUTE_DEPOT_A_X, ROUTE_DEPOT_A_Z, StopKind::Depot);
        self.put(2, ROUTE_DEPOT_B_X, ROUTE_DEPOT_B_Z, StopKind::Depot);
        self.put(3, ROUTE_DEPOT_C_X, ROUTE_DEPOT_C_Z, StopKind::Depot);
        self.put(ROUTE_OUTPOST, ROUTE_OUTPOST_X, ROUTE_OUTPOST_Z, StopKind::Halt);
        self.put(5, ROUTE_CORNER_A_X, ROUTE_CORNER_A_Z, StopKind::Pass);
        self.put(6, ROUTE_CORNER_B_X, ROUTE_CORNER_B_Z, StopKind::Pass);
        self.put(ROUTE_HOME, ROUTE_HOME_X, ROUTE_HOME_Z, StopKind::Home);
    }

    fn put(mut self, i : i32, x : f64, z : f64, kind : StopKind) : void {
        self.xs[i] = x;
        self.zs[i] = z;
        self.kinds[i] = kind as i32;
    }

    /** How many waypoints. */
    pub fn count(self) : i32 {
        return self.total;
    }

    /** Waypoint `i`, x. */
    pub fn x(self, i : i32) : f64 {
        return self.xs[i];
    }

    /** Waypoint `i`, z. */
    pub fn z(self, i : i32) : f64 {
        return self.zs[i];
    }

    /** What the driver does at waypoint `i`. */
    pub fn kind(self, i : i32) : StopKind {
        return StopKind::fromCode(self.kinds[i]);
    }

    /** The mission, in the text format: collect three crates, unload at the outpost, come home and wait a moment. */
    pub fn missionText(self) : string {
        let outX : f64 = self.xs[ROUTE_OUTPOST];
        let outZ : f64 = self.zs[ROUTE_OUTPOST];
        let homeX : f64 = self.xs[ROUTE_HOME];
        let homeZ : f64 = self.zs[ROUTE_HOME];
        return "# The frontier run: three stages, then a debrief that starts itself.\n"
            + "mission ${ROUTE_MISSION_MAIN} \"Frontier run\"\n"
            + "  stage supplies\n"
            + "    collect ${ROUTE_ITEM_CRATE} ${ROUTE_CRATES}\n"
            + "  stage delivery\n"
            + "    reach ${outX} ${outZ} ${ROUTE_REACH_RADIUS}\n"
            + "    flag ${ROUTE_FLAG_UNLOADED}\n"
            + "  stage return\n"
            + "    reach ${homeX} ${homeZ} ${ROUTE_REACH_RADIUS}\n"
            + "    timer ${ROUTE_RETURN_TIMER}\n"
            + "  fail timeout ${ROUTE_TIMEOUT}\n"
            + "  reward ${ROUTE_REWARD_GOLD} ${ROUTE_GOLD}\n"
            + "end\n\n"
            + "mission ${ROUTE_MISSION_DEBRIEF} \"Debrief\" auto\n"
            + "  requires ${ROUTE_MISSION_MAIN}\n"
            + "  stage report\n"
            + "    timer ${ROUTE_DEBRIEF_TIMER}\n"
            + "  reward ${ROUTE_REWARD_STANDING} ${ROUTE_STANDING}\n"
            + "end\n";
    }
}

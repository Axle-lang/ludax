// report — the example's checks, printed one per line.
//
// Each line says what was checked and whether it held; the count of lines that did not is the exit status.
// The class owns only two counters, so a check can be written anywhere in the example and still be counted.

/** Prints and counts the checks of the run. */
pub class Report {
    // How many checks did not hold.
    bad : i32 = 0;

    // How many checks ran.
    all : i32 = 0;

    /** An empty report. */
    constructor() {}

    /** States that `ok` holds, printing the line either way. */
    pub fn expect(mut self, what : string, ok : bool) : void {
        self.all = self.all + 1;
        if (ok) {
            println("  ok    ${what}");
            return;
        }

        self.bad = self.bad + 1;
        println("  FAIL  ${what}");
    }

    /** Prints a heading for the checks that follow. */
    pub fn section(self, title : string) : void {
        println("");
        println(title);
    }

    /** How many checks did not hold. */
    pub fn failures(self) : i32 {
        return self.bad;
    }

    /** How many checks ran. */
    pub fn total(self) : i32 {
        return self.all;
    }
}

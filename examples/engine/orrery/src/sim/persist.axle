// persist — the orrery saved to JSON and read back.
//
// The scene (names, tree, transforms) is the library's: `SceneJson`. The orbits are this game's components, so
// the game writes them into the entity objects the library hands it and reads them back out the same way: no
// reflection, and the file says exactly what the game chose.

use ludax::{
    ComponentStore, EntityId, JsonDoc, JsonValue, Scene, SceneInspector, SceneJson, SceneLoad, SceneSave
};

use crate::sim::bodies::{Orbit, Orrery};

/** Spaces per level of the saved JSON; one keeps the file small and still readable. */
const ORRERY_JSON_INDENT : i32 = 1;

/** The radius read for an entity whose `orbit` has none; no orbit has a negative radius, so it never matches. */
const ORRERY_NO_RADIUS : f64 = -1.0;

/** The orrery as pretty JSON: every entity with its transform and, when it orbits, an `orbit` object. */
pub fn orreryToJson(o : Orrery) : string {
    let save : SceneSave = SceneJson::save(o.scene());
    let doc : JsonDoc = save.doc();
    for (i of 0..save.count()) {
        let e : EntityId = save.entityAt(i);
        if (!o.orbits().has(o.scene().entities(), e)) {
            continue;
        }

        let orbit : Orbit = o.orbits().get(e);
        let obj : JsonValue = doc.newObject();
        doc.set(obj, "radius", doc.newNumber(orbit.radius));
        doc.set(obj, "speed", doc.newNumber(orbit.speed));
        doc.set(obj, "phase", doc.newNumber(orbit.phase));
        doc.set(save.entityJson(i), "orbit", obj);
    }
    return save.pretty(ORRERY_JSON_INDENT);
}

/** True when `text` loads to the same scene as `o` with the same orbits on the same entities. */
pub fn orreryMatchesJson(o : Orrery, text : string) : bool {
    let load : SceneLoad = SceneJson::load(text);
    if (!load.ok()
        || SceneInspector::dumpStructure(load.scene()) != SceneInspector::dumpStructure(o.scene())) {
        return false;
    }
    let doc : JsonDoc = load.doc();
    let mut orbiting : i32 = 0;
    for (i of 0..load.count()) {
        let obj : JsonValue = doc.field(load.entityJson(i), "orbit");
        if (obj.isNone()) {
            continue;
        }

        orbiting = orbiting + 1;
        let name : string = load.scene().nameOf(load.entityAt(i));
        let original : Orbit = o.orbits().get(o.scene().find(name));
        if (doc.numberOr(doc.field(obj, "radius"), ORRERY_NO_RADIUS) != original.radius
            || doc.numberOr(doc.field(obj, "speed"), 0.0) != original.speed) {
            return false;
        }
    }
    return orbiting == o.orbits().len();
}

// bodies — the components of the orrery and the scene that holds them.
//
// A star, planets, moons, a station on a moon and a comet, all entities of one `Scene`. What makes a body a
// body is data in `ComponentStore`s: an `Orbit` says how it circles its parent, a `Body` says how big and what
// colour it is. Nothing here knows how they move: that is `systems`.
//
// Colours are packed with `Image::pack`, the same layout the picture uses, so the numbers a caller writes are
// the red, green and blue it will see rather than shifts this file would have to explain.

use ludax::{ComponentStore, DTransform, DVec3, EntityId, Image, Scene};

/** How many planets circle the star. */
const ORRERY_PLANETS : i32 = 5;

/** The index of the planet that has moons and whose loss takes a subtree with it: the third. */
const ORRERY_HOST_INDEX : i32 = 2;

/** Bits in one colour channel of a 0xRRGGBB value. */
const ORRERY_CHANNEL_BITS : i32 = 8;

/** The largest value of one colour channel. */
const ORRERY_CHANNEL_MAX : i32 = 255;

/** The star's sphere radius, in world units. */
const ORRERY_STAR_SIZE : f64 = 2.4;

/** The star's warm yellow. */
const ORRERY_STAR_RGB : i32 = 0xFFD65A;

/** The comet's distance from the star; it is the outermost body. */
const ORRERY_COMET_RADIUS : f64 = 36.0;

/** The comet's angular speed, radians per second. */
const ORRERY_COMET_SPEED : f64 = 0.35;

/** The comet's angle at time 0, radians. */
const ORRERY_COMET_PHASE : f64 = 0.4;

/** The comet's sphere radius. */
const ORRERY_COMET_SIZE : f64 = 0.5;

/** The comet's icy blue. */
const ORRERY_COMET_RGB : i32 = 0x78E6FF;

/** Distance of the first planet from the star; the others follow below. */
const ORRERY_PLANET1_RADIUS : f64 = 6.0;

/** Distance of the second planet. */
const ORRERY_PLANET2_RADIUS : f64 = 10.0;

/** Distance of the third planet, the host. */
const ORRERY_PLANET3_RADIUS : f64 = 15.0;

/** Distance of the fourth planet. */
const ORRERY_PLANET4_RADIUS : f64 = 22.0;

/** Distance of the fifth planet. */
const ORRERY_PLANET5_RADIUS : f64 = 30.0;

/** The innermost planet's angular speed; each further planet is slower by `ORRERY_PLANET_SLOWING`. */
const ORRERY_PLANET_SPEED : f64 = 0.9;

/** How much slower each planet in turn orbits: speed is divided by `1 + index * this`. */
const ORRERY_PLANET_SLOWING : f64 = 0.7;

/** Planets start this far apart in angle, radians, so they are not in a line. */
const ORRERY_PLANET_PHASE_STEP : f64 = 1.3;

/** The innermost planet's sphere radius. */
const ORRERY_PLANET_SIZE : f64 = 0.8;

/** Each further planet is this much bigger. */
const ORRERY_PLANET_SIZE_STEP : f64 = 0.25;

/** The red channel of the innermost planet, rising by `ORRERY_PLANET_RED_STEP` outwards. */
const ORRERY_PLANET_RED : i32 = 90;

/** How much redder each further planet is. */
const ORRERY_PLANET_RED_STEP : i32 = 30;

/** The green channel, the same for every planet. */
const ORRERY_PLANET_GREEN : i32 = 140;

/** The blue channel of the innermost planet, falling by `ORRERY_PLANET_BLUE_STEP` outwards. */
const ORRERY_PLANET_BLUE : i32 = 230;

/** How much less blue each further planet is. */
const ORRERY_PLANET_BLUE_STEP : i32 = 35;

/** The first moon's distance from its planet. */
const ORRERY_MOON_A_RADIUS : f64 = 2.6;

/** The first moon's angular speed. */
const ORRERY_MOON_A_SPEED : f64 = 2.4;

/** The first moon's sphere radius. */
const ORRERY_MOON_A_SIZE : f64 = 0.35;

/** The first moon's pale grey. */
const ORRERY_MOON_A_RGB : i32 = 0xC8C8CD;

/** The second moon's distance from its planet. */
const ORRERY_MOON_B_RADIUS : f64 = 3.8;

/** The second moon's angular speed; negative, so it circles the other way. */
const ORRERY_MOON_B_SPEED : f64 = -1.7;

/** The second moon's angle at time 0. */
const ORRERY_MOON_B_PHASE : f64 = 2.0;

/** The second moon's sphere radius. */
const ORRERY_MOON_B_SIZE : f64 = 0.28;

/** The second moon's rust brown. */
const ORRERY_MOON_B_RGB : i32 = 0xBE9678;

/** The station's distance from the first moon. */
const ORRERY_STATION_RADIUS : f64 = 0.9;

/** The station's angular speed; the fastest in the system. */
const ORRERY_STATION_SPEED : f64 = 5.0;

/** The station's angle at time 0. */
const ORRERY_STATION_PHASE : f64 = 0.5;

/** The station's sphere radius. */
const ORRERY_STATION_SIZE : f64 = 0.12;

/** The station is white. */
const ORRERY_STATION_RGB : i32 = 0xFFFFFF;

/** How an entity circles its parent about the vertical axis. */
pub struct Orbit {
    /** Distance from the parent, in world units. */
    pub radius : f64;

    /** Angular speed, radians per second; negative circles the other way. */
    pub speed : f64;

    /** Angle at time 0, radians. */
    pub phase : f64;
}

/** What a body looks like and how big it is for collisions. */
pub struct Body {
    /** Radius of its sphere, in world units. */
    pub size : f64;

    /** Colour as a packed `Image` pixel (0xAABBGGRR). */
    pub colour : i32;
}

/** The whole simulation state: the scene and the two kinds of component. */
pub class Orrery {
    scene  : Scene;
    orbits : ComponentStore<Orbit>;
    bodies : ComponentStore<Body>;
    host   : EntityId;

    /** Builds the system: a star, five planets, moons around the third, a station on its first moon, a comet. */
    constructor() {
        self.scene = new Scene();
        self.orbits = new ComponentStore<Orbit>();
        self.bodies = new ComponentStore<Body>();

        let star : EntityId = self.scene.add("star");
        self.body(star, ORRERY_STAR_SIZE, orreryColour(ORRERY_STAR_RGB));
        self.host = star;

        self.buildPlanets(star);
        self.buildMoons();

        let comet : EntityId = self.scene.add("comet");
        let cometOrbit : Orbit = Orbit {
            radius: ORRERY_COMET_RADIUS,
            speed: ORRERY_COMET_SPEED,
            phase: ORRERY_COMET_PHASE,
        };
        self.orbit(comet, cometOrbit);
        self.body(comet, ORRERY_COMET_SIZE, orreryColour(ORRERY_COMET_RGB));
    }

    // Five planets around the star; the third is the host whose subtree is lost later.
    fn buildPlanets(mut self, star : EntityId) : void {
        for (i of 0..ORRERY_PLANETS) {
            let number : i32 = i + 1;
            let name : string = "planet${number}";
            let p : EntityId = self.scene.addChild(star, name, DTransform::identity());
            let index : f64 = i as f64;
            let orbit : Orbit = Orbit {
                radius: orreryPlanetRadius(i),
                speed: ORRERY_PLANET_SPEED / (1.0 + index * ORRERY_PLANET_SLOWING),
                phase: index * ORRERY_PLANET_PHASE_STEP,
            };
            self.orbit(p, orbit);

            let red : i32 = ORRERY_PLANET_RED + i * ORRERY_PLANET_RED_STEP;
            let blue : i32 = ORRERY_PLANET_BLUE - i * ORRERY_PLANET_BLUE_STEP;
            let size : f64 = ORRERY_PLANET_SIZE + index * ORRERY_PLANET_SIZE_STEP;
            self.body(p, size, Image::pack(red, ORRERY_PLANET_GREEN, blue, ORRERY_CHANNEL_MAX));
            if (i == ORRERY_HOST_INDEX) {
                self.host = p;
            }
        }
    }

    // Two moons around the host planet and a station on the first.
    fn buildMoons(mut self) : void {
        let host : EntityId = self.host;
        let moonA : EntityId = self.scene.addChild(host, "moonA", DTransform::identity());
        let orbitA : Orbit = Orbit { radius: ORRERY_MOON_A_RADIUS, speed: ORRERY_MOON_A_SPEED, phase: 0.0 };
        self.orbit(moonA, orbitA);
        self.body(moonA, ORRERY_MOON_A_SIZE, orreryColour(ORRERY_MOON_A_RGB));

        let moonB : EntityId = self.scene.addChild(host, "moonB", DTransform::identity());
        let orbitB : Orbit = Orbit {
            radius: ORRERY_MOON_B_RADIUS,
            speed: ORRERY_MOON_B_SPEED,
            phase: ORRERY_MOON_B_PHASE,
        };
        self.orbit(moonB, orbitB);
        self.body(moonB, ORRERY_MOON_B_SIZE, orreryColour(ORRERY_MOON_B_RGB));

        let station : EntityId = self.scene.addChild(moonA, "station", DTransform::identity());
        let orbitS : Orbit = Orbit {
            radius: ORRERY_STATION_RADIUS,
            speed: ORRERY_STATION_SPEED,
            phase: ORRERY_STATION_PHASE,
        };
        self.orbit(station, orbitS);
        self.body(station, ORRERY_STATION_SIZE, orreryColour(ORRERY_STATION_RGB));
    }

    // Gives `e` an orbit and a body.
    fn orbit(mut self, e : EntityId, orbit : Orbit) : void {
        self.orbits.add(self.scene.entities(), e, orbit);
    }

    fn body(mut self, e : EntityId, size : f64, colour : i32) : void {
        self.bodies.add(self.scene.entities(), e, Body { size: size, colour: colour });
    }

    /** The scene, for the systems. */
    pub fn scene(self) : Scene {
        return self.scene;
    }

    /** The orbits. */
    pub fn orbits(self) : ComponentStore<Orbit> {
        return self.orbits;
    }

    /** The bodies. */
    pub fn bodies(self) : ComponentStore<Body> {
        return self.bodies;
    }

    /** The third planet, the one with moons, whose loss takes a whole subtree with it. */
    pub fn hostPlanet(self) : EntityId {
        return self.host;
    }

    /** Where `e` is in the world, after bringing the scene up to date. */
    pub fn position(mut self, e : EntityId) : DVec3 {
        return self.scene.worldTransform(e).translation;
    }
}

// The distance from the star of planet number `i`, counting from the innermost.
fn orreryPlanetRadius(i : i32) : f64 {
    return match i {
        0 => ORRERY_PLANET1_RADIUS,
        1 => ORRERY_PLANET2_RADIUS,
        2 => ORRERY_PLANET3_RADIUS,
        3 => ORRERY_PLANET4_RADIUS,
        _ => ORRERY_PLANET5_RADIUS,
    };
}

/** An opaque `Image` pixel from a 0xRRGGBB value, so colours read as the usual hex triplets. */
pub fn orreryColour(rgb : i32) : i32 {
    let red : i32 = (rgb >> (ORRERY_CHANNEL_BITS * 2)) & ORRERY_CHANNEL_MAX;
    let green : i32 = (rgb >> ORRERY_CHANNEL_BITS) & ORRERY_CHANNEL_MAX;
    let blue : i32 = rgb & ORRERY_CHANNEL_MAX;
    return Image::pack(red, green, blue, ORRERY_CHANNEL_MAX);
}

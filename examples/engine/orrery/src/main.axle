// orrery — entities, components, a scene tree and a fixed step, with no window.
//
// A star, five planets, moons, a station on a moon and a comet move through ten simulated seconds twice: once
// with a steady 60 frames a second and once with frames of random length. If the simulation is what it should
// be, both runs end in the same state, and the program says so with a checksum; if they differ it exits with a
// failure. The first run also draws every body's path seen from above into `orrery.png`.
//
// The steady run draws into a picture and the uneven one into a zero-sized image, which `orreryTrail` treats as
// "no picture": the two runs still simulate identically.

use ludax::{DataFiles, Image};

use crate::sim::bodies::{Orrery, orreryColour};
use crate::sim::persist::{orreryToJson, orreryMatchesJson};
use crate::sim::run::{orreryRun, OrreryResult, ORRERY_DOOM_TICK, ORRERY_STEADY};

/** The number of 60 Hz ticks played: ten seconds. */
const ORRERY_TICKS : i32 = 600;

/** The picture is square, this many pixels on a side. */
const ORRERY_CANVAS : i32 = 840;

/** The seed for the uneven frame lengths; any non-zero seed means "not the steady run". */
const ORRERY_UNEVEN_SEED : i32 = 7;

/** The deep blue-black of space behind the paths. */
const ORRERY_SPACE_RGB : i32 = 0x080A12;

/** The host planet, its two moons and the station on one of them. */
const ORRERY_LOST_WITH_HOST : i32 = 4;

fn main() : i32 ! IOException {
    let canvas : Image = new Image(ORRERY_CANVAS, ORRERY_CANVAS);
    canvas.fill(orreryColour(ORRERY_SPACE_RGB));
    let steady : OrreryResult = orreryRun(ORRERY_TICKS, ORRERY_STEADY, canvas);
    let uneven : OrreryResult = orreryRun(ORRERY_TICKS, ORRERY_UNEVEN_SEED, new Image(0, 0));

    println("orrery: steady frames:  ${steady.ticks} ticks in ${steady.frames} frames, ${steady.alive} alive, ${steady.encounters} touching pair-ticks, checksum ${steady.checksum}");
    println("orrery: uneven frames:  ${uneven.ticks} ticks in ${uneven.frames} frames, ${uneven.alive} alive, ${uneven.encounters} touching pair-ticks, checksum ${uneven.checksum}");
    println("orrery: destroying the host planet at tick ${ORRERY_DOOM_TICK} took ${steady.lost} entities with it (the planet, two moons and the station)");

    DataFiles::savePng("orrery.png", canvas);

    // The system as it is built, saved to JSON and read back: same tree, same transforms, same orbits.
    let fresh : Orrery = new Orrery();
    let json : string = orreryToJson(fresh);
    if (!orreryMatchesJson(fresh, json)) {
        println("orrery: FAIL the saved system does not load back as it was");
        return 1;
    }
    println("orrery: the system saved to ${json.byteLength} bytes of JSON loads back identical (scene and orbits)");
    println("orrery: wrote orrery.png");

    if (steady.checksum != uneven.checksum || steady.ticks != uneven.ticks
        || steady.encounters != uneven.encounters) {
        println("orrery: FAIL the two runs ended differently");
        return 1;
    }
    if (steady.lost != ORRERY_LOST_WITH_HOST) {
        println("orrery: FAIL the subtree was not destroyed as a whole");
        return 1;
    }
    println("orrery: the two runs agree exactly");
    return 0;
}

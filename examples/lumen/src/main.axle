// lumen — a voxel valley lit by the Ludax lighting library, traced on the CPU.
//
// A day cycle over a lake, a cabin with lanterns, a forest, a watch tower with a beacon and a crystal cave:
// physically based sky and sun, soft shadows from rays, coloured block light flooded through the voxels, a
// traced diffuse bounce, a lake that reflects and refracts, light shafts in a height fog, bloom and an eye
// that adapts. See `options.axle` for the flags and `README.md` for the controls.

use crate::app::headless::LumenHeadless;
use crate::app::options::{Cli, Options};
use crate::app::selftest::LumenSelfTest;
use crate::app::window::LumenApp;

fn main() : i32 {
    let o : Options = Cli::parse();
    if (o.problem.length > 0) {
        println(o.problem);
        println(Cli::usage());
        return 2;
    }
    if (o.help) {
        println(Cli::usage());
        return 0;
    }
    // The modes are exclusive and checked most specific first; only the fall-through opens a window.
    if (o.selftest) {
        return LumenSelfTest::run();
    }
    if (o.map.length > 0) {
        return LumenHeadless::map(o);
    }
    if (o.flicker) {
        return LumenHeadless::flicker(o);
    }
    if (o.bench) {
        return LumenHeadless::bench(o);
    }
    if (o.frame.length > 0) {
        return LumenHeadless::run(o);
    }
    return LumenApp::run(o);
}

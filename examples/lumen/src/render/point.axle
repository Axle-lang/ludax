// point — a struck surface turned into what shading needs: position, normals, albedo, roughness, emission.
//
// The texel under the ray gives an albedo, a height and a glow. The height of the texel and of its
// neighbours bends the normal the way a normal map would, so a flat cube face reads as stone, planks or
// shingles under a grazing sun. The geometric normal is kept apart: light never arrives from behind the face
// whatever the bumps say.

use ludax::{Vec2, Vec3};

use crate::world::scene::LumenHit;
use crate::world::texture::{LumenAtlas, LumenTexel, lumenTexelUv};

// How much of the texel's slope tilts the normal: enough to read the material under a grazing sun, not enough to
// turn a flat face into a furrowed one.
const PT_BUMP : f32 = 0.55;

/** The shading inputs of one surface point. */
pub struct LumenPoint {
    /** World position of the hit. */
    pub pos : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Geometric normal of the face, unit, toward the viewer's side. */
    pub ng : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Shading normal after the texel's relief. */
    pub n : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Linear albedo. */
    pub albedo : Vec3 = Vec3 { x: 0.5, y: 0.5, z: 0.5 };

    /** Perceptual roughness. */
    pub rough : f32 = 1.0;

    /** 0 dielectric, 1 metal. */
    pub metal : f32 = 0.0;

    /** Light the surface emits, scene radiance. */
    pub emissive : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** The block id. */
    pub block : i32 = 0;

    /** The surface layer bit, tested against the lamps' include and exclude masks. */
    pub layer : u32 = 1;
}

// The two directions along which the texel grid runs on face `face`, matching `lumenTexelAt`.
fn ptU(face : i32) : Vec3 {
    if (face == 0) {
        return Vec3::make(0.0, 0.0, -1.0);
    }
    if (face == 1) {
        return Vec3::make(0.0, 0.0, 1.0);
    }
    if (face == 5) {
        return Vec3::make(-1.0, 0.0, 0.0);
    }
    return Vec3::make(1.0, 0.0, 0.0);
}

fn ptV(face : i32) : Vec3 {
    if (face == 2 || face == 3) {
        return Vec3::make(0.0, 0.0, 1.0);
    }
    return Vec3::make(0.0, 1.0, 0.0);
}

fn ptClamp(v : i32) : i32 {
    if (v < 0) {
        return 0;
    }
    if (v > 15) {
        return 15;
    }
    return v;
}

/**
 * The point struck by `hit` for a ray from `o` along `d`, at animation time `time`, its texture read at mip level
 * `lod` (see `LumenAtlas::sample`).
 */
pub fn lumenPoint(
    pal : BlockPalette,
    atlas : LumenAtlas,
    hit : LumenHit,
    o : Vec3,
    d : Vec3,
    time : f32,
    lod : f32
) : LumenPoint {
    let ng : Vec3 = hit.normal();
    let b : i32 = hit.block;
    let p : Vec3 = o.plus(d.scale(hit.t));
    let uv : Vec2 = lumenTexelUv(hit.face, p.x - hit.x as f32, p.y - hit.y as f32, p.z - hit.z as f32);
    let here : LumenTexel = atlas.sample(pal, b, hit.face, uv.x, uv.y, time, lod);
    let slope : Vec2 = atlas.relief(pal, b, hit.face, ptClamp(uv.x as i32), ptClamp(uv.y as i32), time, lod);
    let n : Vec3 = ng
        .minus(ptU(hit.face).scale(slope.x * PT_BUMP))
        .minus(ptV(hit.face).scale(slope.y * PT_BUMP))
        .normalized();
    let emit : Vec3 = pal.emitOf(b);
    return LumenPoint {
        pos: p,
        ng: ng,
        n: n,
        albedo: here.albedo,
        rough: pal.roughOf(b),
        metal: pal.metalOf(b),
        emissive: emit.scale(here.glow),
        block: b,
        layer: pal.layerOf(b),
    };
}

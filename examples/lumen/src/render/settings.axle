// settings — the knobs of the picture, and the random numbers a pixel draws.
//
// Settings are plain fields the interface changes between frames. The generator is stateless in spirit: a
// pixel's stream is a function of its position and the frame number alone, so a render is the same whichever
// thread draws which row.

use ludax::{mixI64};

// 2^-53, which turns the 53 bits the hash keeps into a fraction in [0, 1).
const RNG_INV_53 : f64 = 0.00000000000000011102230246251565;

// One irrational step per dimension; `next` wraps after this many.
const RNG_STEPS : i32 = 12;

/** What the picture shows: the finished frame or one ingredient of it. */
pub enum LumenView : i8 {
    /** The lit, fogged, bloomed and tone-mapped picture. */
    Final,
    /** Albedo only. */
    Albedo,
    /** The shading normal as a colour. */
    Normal,
    /** Direct light only: sun, moon and lamps. */
    Direct,
    /** Indirect light only: sky, bounce and block light. */
    Indirect,
    /** Distance as brightness. */
    Depth,
    /** The flooded block light alone. */
    Flood,
    /** Sky access: the ambient occlusion. */
    Access,
    /** Radiance before exposure and tone mapping, clipped at 1. */
    Raw,
}

/** The view that follows `v` in the cycle the V key walks. */
pub fn lumenViewNext(v : LumenView) : LumenView {
    return match v {
        LumenView::Final => LumenView::Albedo,
        LumenView::Albedo => LumenView::Normal,
        LumenView::Normal => LumenView::Direct,
        LumenView::Direct => LumenView::Indirect,
        LumenView::Indirect => LumenView::Depth,
        LumenView::Depth => LumenView::Flood,
        LumenView::Flood => LumenView::Access,
        LumenView::Access => LumenView::Raw,
        LumenView::Raw => LumenView::Final,
    };
}

/** The name the overlay shows for `v`. */
pub fn lumenViewName(v : LumenView) : string {
    return match v {
        LumenView::Final => "final",
        LumenView::Albedo => "albedo",
        LumenView::Normal => "normal",
        LumenView::Direct => "direct",
        LumenView::Indirect => "indirect",
        LumenView::Depth => "depth",
        LumenView::Flood => "flood",
        LumenView::Access => "access",
        LumenView::Raw => "raw",
    };
}

/** The settings of the renderer. */
pub class LumenSettings {
    /** What to show. */
    pub view : LumenView = LumenView::Final;

    /** Angular radius of the sun for its shadows, radians: wider than the real 0.0047 for a visible penumbra. */
    pub sunSoftness : f32 = 0.03;

    /** Exposure compensation in stops added to the automatic exposure. */
    pub exposureBias : f32 = 0.0;

    /** Bloom strength, 0 off. */
    pub bloom : f32 = 0.32;

    /** Fog density scale, 0 off. */
    pub fog : f32 = 1.0;

    /** True: light shafts, a shadow ray per fog sample. */
    pub godRays : bool = true;

    /** True: one traced diffuse bounce per sample; false: the baked bounce tint only. */
    pub bounce : bool = true;

    /** True: lamps cast shadows and specular highlights as real point lights. */
    pub lamps : bool = true;

    /** True: the exposure follows the picture. */
    pub autoExposure : bool = true;

    /** Fixed exposure when `autoExposure` is off. */
    pub exposure : f32 = 0.6;

    /** True: the spatial filter smooths the pixels that have few samples so far. Off by default: the light is baked,
     * so there is no noise to remove, and the filter only softens the picture. */
    pub denoise : bool = false;

    /** How many frames a pixel's history may count when the picture holds still. */
    pub maxSamples : i32 = 32;
}

/**
 * The random numbers of one pixel. Dimension `d` of frame `f` is a Kronecker sequence: a per-pixel random offset
 * plus `f` times an irrational step, modulo one. Within a frame the pixels are independent; across frames each
 * pixel's samples cover the unit interval evenly, which is why the picture converges much faster than with fresh
 * random numbers each frame. Reseed it for each pixel.
 */
pub class LumenRng {
    px    : i32 = 0;
    py    : i32 = 0;
    frame : i64 = 0;
    dim   : i32 = 0;
    steps : f64[];

    /** A stream at its start. */
    constructor() {
        // The fractional parts of the square roots of the primes: unrelated irrationals, one per dimension.
        self.steps = malloc<f64>(RNG_STEPS as i64);
        self.steps[0] = 0.41421356237309503;
        self.steps[1] = 0.7320508075688772;
        self.steps[2] = 0.2360679774997898;
        self.steps[3] = 0.6457513110645907;
        self.steps[4] = 0.3166247903553998;
        self.steps[5] = 0.6055512754639892;
        self.steps[6] = 0.12310562561766059;
        self.steps[7] = 0.35889894354067353;
        self.steps[8] = 0.7958315233127191;
        self.steps[9] = 0.3851648071345041;
        self.steps[10] = 0.5677643628300219;
        self.steps[11] = 0.7442918417139628;
    }

    /** Starts the stream of pixel (x, y) in frame `frame`. */
    pub fn seed(mut self, x : i32, y : i32, frame : i32) : void {
        self.px = x;
        self.py = y;
        self.frame = frame as i64;
        self.dim = 0;
    }

    /** The next number, in [0, 1). */
    pub fn next(mut self) : f32 {
        let d : i32 = self.dim;
        self.dim = self.dim + 1;
        let offset : f64 = ((mixI64(((self.px as i64) << 32) ^ ((self.py as i64) << 8) ^ (d as i64))
            >>> 11) as f64)
            * RNG_INV_53;
        let v : f64 = offset + (self.frame as f64) * self.steps[(d % RNG_STEPS) as i64];
        let whole : i64 = v as i64;
        return (v - whole as f64) as f32;
    }
}

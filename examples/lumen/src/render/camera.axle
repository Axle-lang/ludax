// camera — a pinhole camera: a position, two angles and a field of view, turned into one ray per pixel.
//
// Yaw 0 looks along -z and grows toward +x; pitch is up from the horizon. `aim` rebuilds the basis once per
// frame so `ray` is a handful of multiplies.

use ludax::{Vec3, sin, cos, tan, clamp, TAU, HALF_PI};

// How far short of the poles the pitch stops, so the basis never degenerates looking straight up or down.
const CAM_LEVEL_EPS : f32 = 0.01;

// A point closer than this along the view axis is behind the eye for `project`.
const CAM_NEAR : f32 = 0.01;

/** The eye. */
pub class LumenCamera {
    /** World x of the eye. */
    pub x : f32;

    /** World y (height) of the eye. */
    pub y : f32;

    /** World z of the eye. */
    pub z : f32;

    /** Heading in radians, 0 looking along -z and growing toward +x. */
    pub yaw : f32;

    /** Elevation in radians, up from the horizon. */
    pub pitch : f32;

    /** Vertical field of view in radians. */
    pub fov : f32;
    fwd     : Vec3;
    right   : Vec3;
    up      : Vec3;
    halfH   : f32;
    aspect  : f32;

    /** A camera at (x, y, z) looking along `yaw` and `pitch` (radians) with a vertical field of view `fov`. */
    constructor(x : f32, y : f32, z : f32, yaw : f32, pitch : f32, fov : f32) {
        self.x = x;
        self.y = y;
        self.z = z;
        self.yaw = yaw;
        self.pitch = pitch;
        self.fov = fov;
        self.fwd = Vec3::unitZ();
        self.right = Vec3::unitX();
        self.up = Vec3::unitY();
        self.halfH = 1.0;
        self.aspect = 1.0;
        self.aim(1.0);
    }

    /** Recomputes the basis for a picture of the given width over height. */
    pub fn aim(mut self, aspect : f32) : void {
        self.pitch = clamp(self.pitch, -HALF_PI + CAM_LEVEL_EPS, HALF_PI - CAM_LEVEL_EPS);
        if (self.yaw > TAU) {
            self.yaw = self.yaw - TAU;
        }
        if (self.yaw < 0.0) {
            self.yaw = self.yaw + TAU;
        }
        let cp : f32 = cos(self.pitch);
        self.fwd = Vec3 { x: sin(self.yaw) * cp, y: sin(self.pitch), z: -cos(self.yaw) * cp };
        self.right = Vec3 { x: cos(self.yaw), y: 0.0, z: sin(self.yaw) };
        self.up = self.right.cross(self.fwd);
        self.halfH = tan(self.fov * (0.5 as f32));
        self.aspect = aspect;
    }

    /** Keeps the eye inside a world `extent` wide and `top` high, away from the edge. */
    pub fn keepInside(mut self, extent : f32, top : f32) : void {
        // One cell in from every edge, so a ray walker always starts inside the world.
        self.x = clamp(self.x, 1.0, extent - (1.0 as f32));
        self.z = clamp(self.z, 1.0, extent - (1.0 as f32));
        self.y = clamp(self.y, 1.0, top);
    }

    /** The unit direction of the forward axis. */
    pub fn forward(self) : Vec3 {
        return self.fwd;
    }

    /** The unit direction to the right. */
    pub fn rightward(self) : Vec3 {
        return self.right;
    }

    /** The eye position. */
    pub fn eye(self) : Vec3 {
        return Vec3 { x: self.x, y: self.y, z: self.z };
    }

    /** The unit direction through the point (u, v) of the picture, both 0..1 from the top left. */
    pub fn ray(self, u : f32, v : f32) : Vec3 {
        let a : f32 = ((2.0 as f32) * u - (1.0 as f32)) * self.aspect * self.halfH;
        let b : f32 = ((1.0 as f32) - (2.0 as f32) * v) * self.halfH;
        return self.fwd.plus(self.right.scale(a)).plus(self.up.scale(b)).normalized();
    }

    /**
     * Where the world point `p` falls in this camera's picture: (u, v) in 0..1 from the top left, and the distance
     * along the view axis in z. A point behind the eye answers a negative z.
     */
    pub fn project(self, p : Vec3) : Vec3 {
        let v : Vec3 = p.minus(self.eye());
        let depth : f32 = v.dot(self.fwd);
        if (depth < CAM_NEAR) {
            return Vec3 { x: 0.0, y: 0.0, z: -1.0 };
        }
        let a : f32 = v.dot(self.right) / (depth * self.aspect * self.halfH);
        let b : f32 = v.dot(self.up) / (depth * self.halfH);
        return Vec3 { x: (a + (1.0 as f32)) * (0.5 as f32), y: ((1.0 as f32) - b) * (0.5 as f32), z: depth };
    }

    /** True when two cameras see the same picture. */
    pub fn same(self, o : LumenCamera) : bool {
        return self.x == o.x && self.y == o.y && self.z == o.z && self.yaw == o.yaw && self.pitch == o.pitch
            && self.fov == o.fov;
    }

    /** Copies `o` into this camera. */
    pub fn copyFrom(mut self, o : LumenCamera) : void {
        self.x = o.x;
        self.y = o.y;
        self.z = o.z;
        self.yaw = o.yaw;
        self.pitch = o.pitch;
        self.fov = o.fov;
        self.fwd = o.fwd;
        self.right = o.right;
        self.up = o.up;
        self.halfH = o.halfH;
        self.aspect = o.aspect;
    }
}

// headless — the modes that finish without a window.
//
// A rendered picture, a benchmark, a flicker measurement and a map of the world. The picture modes drive the
// same `LumenSession` the window does, so a still frame and an interactive one cannot disagree; only the loop
// around it differs. `run` spends as many samples as asked, `bench` times the stages and throws the pixels
// away, `flicker` measures how much a still picture changes from frame to frame (the number the temporal and
// spatial filters exist to keep near zero) and `map` reads the flat world from above. None of them opens a
// window, so they work over ssh and in the test that compares thread counts.

use ludax::{JobPool, nowNanos, nanosToMillis, min};
use smalt::{Surface, Bmp, Color};

use crate::app::options::Options;
use crate::app::session::LumenSession;
use crate::render::settings::LumenView;

// Default render sizes when the command line asks for none.
const RUN_W : i32 = 960;
const RUN_H : i32 = 540;
const BENCH_W : i32 = 640;
const BENCH_H : i32 = 360;
const BENCH_SCALE : i32 = 2;

// A benchmark warms up, then measures this many frames with the camera still and as many with it moving.
const BENCH_WARMUP : i32 = 60;
const BENCH_FRAMES : i32 = 40;

// The seconds a headless display frame is told have passed: the exposure adapts at the same pace as in a window.
const HEADLESS_STEP : f32 = 0.016;

// The flicker measurement's picture size, frames and the share of them it reports.
const FLICKER_W : i32 = 640;
const FLICKER_H : i32 = 360;
const FLICKER_WARMUP : i32 = 30;
const FLICKER_FIRST : i32 = 50;
const FLICKER_FRAMES : i32 = 70;
const FLICKER_IMAGE : i32 = 69;
// `--view` packs the display view in the low two digits and the features to switch off above them.
const FLICKER_VIEW_MASK : i32 = 100;

// The map's session is tiny: it needs the world, not a picture.
const MAP_SESSION : i32 = 64;

// How much the map darkens with lake depth, and how much a step to the north-west shades a column.
const MAP_WATER_DEPTH : f32 = 0.12;
const MAP_SLOPE : f32 = 0.09;

/** The offline front end. */
pub class LumenHeadless {
    /** Renders `o.samples` passes of the chosen viewpoint into `o.frame`. */
    pub static fn run(o : Options) : i32 {
        let mut session : LumenSession = LumenHeadless::sessionFor(o, RUN_W, RUN_H, 0);
        session.goTo(LumenSession::shot(o.shot));
        LumenHeadless::place(o, session);

        let surface = new Surface(session.outW, session.outH);
        let mut done : i32 = 0;
        // The first pass is a preview; the rest are full samples.
        session.pass();
        while (done < o.samples) {
            if (o.drift) {
                session.cam.yaw = session.cam.yaw + (0.006 as f32);
                session.cam.x = session.cam.x + (0.04 as f32);
            }
            session.pass();
            done = done + 1;
        }
        session.show(surface.pixels(), 0.0, true);
        let ok : bool = Bmp::write(o.frame, surface.frame());
        println("rendered ${done} samples at ${session.frame.w}x${session.frame.h} into ${o.frame}");
        surface.close();
        session.close();
        if (ok) {
            return 0;
        }
        return 1;
    }

    // A session for the options' size and thread count, with `defW` by `defH` when none was asked.
    static fn sessionFor(o : Options, defW : i32, defH : i32, minScale : i32) : LumenSession {
        let mut w : i32 = o.width;
        let mut h : i32 = o.height;
        if (w == 0) {
            w = defW;
            h = defH;
        }
        let mut scale : i32 = o.scale;
        if (scale < minScale) {
            scale = minScale;
        }
        let mut workers : i32 = o.threads;
        if (workers < 1) {
            workers = JobPool::defaultWorkers();
        }
        return new LumenSession(workers, w, h, scale);
    }

    // Where and when to look: the command line's overrides, then lifting the eye out of any ground it landed in.
    static fn place(o : Options, mut session : LumenSession) : void {
        if (o.yaw >= 0.0) {
            session.cam.yaw = o.yaw as f32;
        }
        if (o.down >= 0.0) {
            session.cam.pitch = -(o.down as f32);
        }
        if (o.atX >= 0.0) {
            session.cam.x = o.atX as f32;
        }
        if (o.atZ >= 0.0) {
            session.cam.z = o.atZ as f32;
        }
        if (o.altitude >= 1.0) {
            session.cam.y = o.altitude as f32;
        }

        // A viewpoint moved with --x and --z may land in the ground: rise until the eye is in the open.
        while (session.env.scene.isSolid(session.cam.x as i32, session.cam.y as i32, session.cam.z as i32)
            && session.cam.y < (60.0 as f32)) {
            session.cam.y = session.cam.y + (1.0 as f32);
        }
        if (o.time >= 0.0) {
            session.setDay(o.time);
        }
        session.env.settings.view = LumenHeadless::view(o.view);
    }

    /**
     * Times the stages of a frame (trace, temporal blend, spatial filter, resolve) and the display stage, each
     * averaged over 40 frames after a warm-up, with the camera still so every pixel carries its history.
     */
    pub static fn bench(o : Options) : i32 {
        let mut workers : i32 = o.threads;
        if (workers < 1) {
            workers = JobPool::defaultWorkers();
        }
        let mut session : LumenSession = LumenHeadless::sessionFor(o, BENCH_W, BENCH_H, BENCH_SCALE);
        session.goTo(LumenSession::shot(o.shot));
        session.env.settings.view = LumenHeadless::view(o.view);
        let surface = new Surface(session.outW, session.outH);
        for (k of 0..BENCH_WARMUP) {
            session.pass();
            session.show(surface.pixels(), HEADLESS_STEP, false);
        }
        println("${session.frame.w}x${session.frame.h} shown at ${session.outW}x${session.outH}, ${workers} threads");
        for (phase of 0..2) {
            for (i of 0..4) {
                session.spent[i] = 0;
            }

            let t0 : i64 = nowNanos();
            for (k of 0..BENCH_FRAMES) {
                if (phase == 1) {
                    session.cam.yaw = session.cam.yaw + (0.012 as f32);
                    session.cam.x = session.cam.x + (0.05 as f32);
                }
                session.pass();
            }
            let t1 : i64 = nowNanos();
            for (k of 0..BENCH_FRAMES) {
                session.show(surface.pixels(), HEADLESS_STEP, false);
            }
            let t2 : i64 = nowNanos();

            let f : f64 = BENCH_FRAMES as f64;
            let frame : f64 = nanosToMillis(t1 - t0) / f;
            let display : f64 = nanosToMillis(t2 - t1) / f;
            let trace : f64 = nanosToMillis(session.spent[0]) / f;
            let temporal : f64 = nanosToMillis(session.spent[1]) / f;
            let filter : f64 = nanosToMillis(session.spent[2]) / f;
            let resolve : f64 = nanosToMillis(session.spent[3]) / f;
            let fps : f64 = 1000.0 / (frame + display);
            let mut name : string = "still ";
            if (phase == 1) {
                name = "moving";
            }
            println("${name}: trace ${trace} temporal ${temporal} filter ${filter} resolve ${resolve} display ${display} ms => ${fps} fps");
        }
        surface.close();
        session.close();
        return 0;
    }

    /**
     * How much the picture changes from one frame to the next with the camera still but the history kept short, as
     * it is while you move: the mean absolute difference of the displayed 8-bit values between successive frames,
     * over the whole picture and over its top and bottom halves. Static content should read near zero.
     */
    pub static fn flicker(o : Options) : i32 {
        let mut workers : i32 = o.threads;
        if (workers < 1) {
            workers = JobPool::defaultWorkers();
        }
        let mut session : LumenSession = new LumenSession(workers, FLICKER_W, FLICKER_H, 1);
        session.goTo(LumenSession::shot(o.shot));
        session.env.settings.view = LumenHeadless::view(o.view % FLICKER_VIEW_MASK);

        // The high digits of --view switch features off, so each one's contribution to the flicker is measurable.
        let mask : i32 = o.view / FLICKER_VIEW_MASK;
        if ((mask & 1) != 0) {
            session.env.settings.lamps = false;
        }
        if ((mask & 2) != 0) {
            session.env.settings.bounce = false;
        }
        if ((mask & 4) != 0) {
            session.env.settings.godRays = false;
        }
        if ((mask & 8) != 0) {
            session.env.settings.fog = 0.0;
        }
        if ((mask & 16) != 0) {
            session.env.settings.denoise = false;
        }

        let surface = new Surface(session.outW, session.outH);
        let n : i64 = (FLICKER_W as i64) * (FLICKER_H as i64);
        let mut last : i32[] = malloc<i32>(n);
        for (k of 0..FLICKER_FRAMES) {
            session.soft = true;
            session.pass();
            session.show(surface.pixels(), HEADLESS_STEP, k < FLICKER_WARMUP);

            if (k >= FLICKER_FIRST) {
                let px : i32[] = surface.pixels();
                let mut total : i64 = 0;
                let mut top : i64 = 0;
                for (i of 0..n) {
                    let d : i64 = ifPixelDiff(px[i], last[i]) as i64;
                    total = total + d;
                    if (i < n / 2) {
                        top = top + d;
                    }
                }

                if (k == FLICKER_IMAGE) {
                    let mut dp : i32[] = surface.pixels();
                    for (i of 0..n) {
                        let dd : i32 = ifPixelDiff(px[i], last[i]) * 12;
                        let q : i32 = if255(dd);
                        dp[i] = Color::packBytes(q, q, q);
                    }
                    Bmp::write("flicker.bmp", surface.frame());
                }

                let mean : f64 = (total as f64) / ((n * 3) as f64);
                let upper : f64 = (top as f64) / ((n * 3 / 2) as f64);
                println("frame ${k}: mean difference ${mean} of 255 (top half ${upper})");
            }

            let px2 : i32[] = surface.pixels();
            for (i of 0..n) {
                last[i] = px2[i];
            }
        }
        surface.close();
        session.close();
        return 0;
    }

    /**
     * A map of the world from above, one pixel a column: the colour of the top block, shaded by the slope to the
     * north-west so ridges and valleys read, with the water tinted by its depth. It shows the shape of the land.
     */
    pub static fn map(o : Options) : i32 {
        let mut workers : i32 = o.threads;
        if (workers < 1) {
            workers = JobPool::defaultWorkers();
        }
        let session : LumenSession = new LumenSession(workers, MAP_SESSION, MAP_SESSION, 1);
        let scene : LumenScene = session.env.scene;
        let n : i32 = scene.sx;
        let surface = new Surface(n, scene.sz);
        let mut px : i32[] = surface.pixels();
        for (z of 0..scene.sz) {
            for (x of 0..n) {
                let top : i32 = scene.columnTop(x, z);
                let b : i32 = scene.at(x, top, z);
                let mut c : Vec3 = scene.pal.albedoOf(b);
                if (b == LumenBlock::Water.id()) {
                    c = Vec3 { x: 0.02 as f32, y: 0.08 as f32, z: 0.2 as f32 };
                    let mut depth : i32 = 0;
                    while (top - depth > 0 && scene.at(x, top - depth, z) == LumenBlock::Water.id()) {
                        depth = depth + 1;
                    }
                    c = c.scale((1.0 as f32) / ((1.0 as f32) + (depth as f32) * MAP_WATER_DEPTH));
                }
                let nw : i32 = scene.columnTop(x - 1 + mapNonNegative(x), z - 1 + mapNonNegative(z));
                let shade : f32 = (1.0 as f32) + ((top - nw) as f32) * MAP_SLOPE;
                c = c.scale(shade);
                px[(z * n + x) as i64] = Color::packBytes(mapCode(c.x), mapCode(c.y), mapCode(c.z));
            }
        }
        let ok : bool = Bmp::write(o.map, surface.frame());
        println("wrote the map of ${n} x ${scene.sz} columns to ${o.map}");
        surface.close();
        session.close();
        if (ok) {
            return 0;
        }
        return 1;
    }

    /** The debug view a number stands for. */
    pub static fn view(n : i32) : LumenView {
        return match n {
            1 => LumenView::Albedo,
            2 => LumenView::Normal,
            3 => LumenView::Direct,
            4 => LumenView::Indirect,
            5 => LumenView::Depth,
            6 => LumenView::Flood,
            7 => LumenView::Access,
            8 => LumenView::Raw,
            _ => LumenView::Final,
        };
    }
}

fn abs32i(v : i32) : i32 {
    if (v < 0) {
        return -v;
    }
    return v;
}

// The sum of the absolute differences of two packed pixels' channels.
fn ifPixelDiff(a : i32, b : i32) : i32 {
    return abs32i(((a >> 16) & 255) - ((b >> 16) & 255)) + abs32i(((a >> 8) & 255) - ((b >> 8) & 255))
        + abs32i((a & 255) - (b & 255));
}

fn if255(v : i32) : i32 {
    if (v > 255) {
        return 255;
    }
    return v;
}

// 1 at the first index of the world, so `v - 1 + mapNonNegative(v)` stays in bounds; 0 elsewhere.
fn mapNonNegative(v : i32) : i32 {
    if (v == 0) {
        return 1;
    }
    return 0;
}

// A linear channel as a display code, through the sRGB curve.
fn mapCode(v : f32) : i32 {
    let c : i32 = (ludax::lightSrgbEncode(min(v, 1.0)) * (255.0 as f32)) as i32;
    if (c < 0) {
        return 0;
    }
    if (c > 255) {
        return 255;
    }
    return c;
}

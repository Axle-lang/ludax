// synth — building the game's sound effects as sample data, with no audio files.
//
// Each effect is a short run of 16-bit mono samples computed from simple oscillators, envelopes and a seeded
// noise source, then wrapped in a WAV header, which is the one thing smalt's `Clip` can load. The oscillators
// use ludax's own `sin`, so the samples are the same on every machine.

use ludax::{Pcg32, sin, TAU};

use crate::audio::cues::Cue;

/** Samples per second the effects are made at; smalt resamples to the device rate when loading. */
pub const SYNTH_RATE : i32 = 22050;

/** Peak amplitude of a finished effect, out of 32767. */
const PEAK : f32 = 14000.0;

/** The samples of the effect for `cue`, as signed 16-bit values widened to i32. */
pub fn render(cue : Cue) : i32[] {
    let seconds : f32 = lengthOf(cue);
    let count : i32 = (seconds * SYNTH_RATE as f32) as i32;
    let mut out : i32[] = malloc<i32>(count as i64);
    let noise = new Pcg32(77, cue as i32 as u64);
    let mut phase : f32 = (0.0 as f32);
    for (i of 0..count) {
        let t : f32 = i as f32 / SYNTH_RATE as f32;
        let along : f32 = t / seconds;
        let hz : f32 = pitchAt(cue, t, along);
        phase = phase + hz / SYNTH_RATE as f32;
        let tone : f32 = sin((phase - floorOf(phase)) * TAU);
        let hiss : f32 = noise.rangeF32(-(1.0 as f32), (1.0 as f32));
        let mixed : f32 = tone * toneShare(cue) + hiss * ((1.0 as f32) - toneShare(cue));
        out[i] = (mixed * envelope(cue, t, along) * PEAK) as i32;
    }
    return out;
}

// How long each effect lasts, in seconds.
fn lengthOf(cue : Cue) : f32 {
    return match cue {
        Cue::Build => 0.22,
        Cue::Upgrade => 0.36,
        Cue::Sell => 0.20,
        Cue::Deny => 0.16,
        Cue::ShootArrow => 0.10,
        Cue::ShootCannon => 0.32,
        Cue::ShootFrost => 0.18,
        Cue::Explode => 0.45,
        Cue::Kill => 0.14,
        Cue::Leak => 0.40,
        Cue::WaveStart => 0.60,
        Cue::WaveClear => 0.55,
        Cue::GameOver => 1.10,
        Cue::Click => 0.05,
    };
}

// The pitch at time `t` (`along` is the position in the effect, 0 to 1).
fn pitchAt(cue : Cue, t : f32, along : f32) : f32 {
    return match cue {
        Cue::Build => 330.0 + 330.0 * step(along, 0.45),
        Cue::Upgrade => 392.0 * (1.0 + 0.25 * step(along, 0.33) + 0.5 * step(along, 0.66)),
        Cue::Sell => 1320.0 - 500.0 * along,
        Cue::Deny => 110.0,
        Cue::ShootArrow => 900.0 - 500.0 * along,
        Cue::ShootCannon => 150.0 - 100.0 * along,
        Cue::ShootFrost => 1500.0 + 600.0 * sin(t * 90.0),
        Cue::Explode => 90.0 - 50.0 * along,
        Cue::Kill => 520.0 - 380.0 * along,
        Cue::Leak => 260.0 - 160.0 * along,
        Cue::WaveStart => 196.0 + 98.0 * step(along, 0.5),
        Cue::WaveClear => 392.0 * (1.0 + 0.25 * step(along, 0.3) + 0.5 * step(along, 0.6)),
        Cue::GameOver => 220.0 - 110.0 * along,
        Cue::Click => 1200.0,
    };
}

// 1 once `along` has passed `edge`, else 0.
fn step(along : f32, edge : f32) : f32 {
    if (along >= edge) {
        return 1.0;
    }
    return 0.0;
}

// How much of the sample is the tone (the rest is noise).
fn toneShare(cue : Cue) : f32 {
    return match cue {
        Cue::ShootArrow => 0.35,
        Cue::ShootCannon => 0.55,
        Cue::Explode => 0.2,
        Cue::Kill => 0.8,
        Cue::Deny => 0.85,
        _ => 1.0,
    };
}

// Loudness over the life of the effect: a short attack and a decay that suits the sound.
fn envelope(cue : Cue, t : f32, along : f32) : f32 {
    let attack : f32 = min1(t / (0.004 as f32));
    let decay : f32 = ((1.0 as f32) - along) * ((1.0 as f32) - along);
    if (cue == Cue::GameOver || cue == Cue::WaveStart || cue == Cue::WaveClear) {
        return attack * (1.0 - along);
    }
    return attack * decay;
}

fn min1(v : f32) : f32 {
    if (v > 1.0) {
        return 1.0;
    }
    return v;
}

fn floorOf(v : f32) : f32 {
    return (v as i32) as f32;
}

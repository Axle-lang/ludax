// sound — the audio device, the effects, and playing a cue.
//
// `Sfx` opens smalt's mixer, renders each effect with `synth`, writes it to a short-lived WAV file (the only
// way smalt can load a clip), loads it and deletes the file. Playing a cue is then one call. A machine with no
// audio device still gets an `Sfx`: its mixer reports closed and every play is a silent no-op, so the game
// never has to ask whether sound exists.

use std::io::{FileOutputStream, FileOpenMode};
use std::io::path::Path;

use smalt::{Clip, Mixer};

use crate::audio::cues::Cue;
use crate::audio::synth::{render, SYNTH_RATE};

/** Frames after a cue plays during which the same cue is dropped, so a volley is not a roar. */
const MIN_REPEAT_FRAMES : i32 = 2;

/** Marker meaning a cue has never played. */
const NEVER_PLAYED : i32 = -100;

/** Bytes in a canonical WAV header. */
const HEADER_BYTES : i32 = 44;

/** Format tag of uncompressed PCM in a WAV header. */
const WAV_FORMAT_PCM : i32 = 1;

/** Channels in every effect: mono, as the synthesiser makes them. */
const WAV_CHANNELS : i32 = 1;

/** Bytes in one 16-bit sample. */
const WAV_SAMPLE_BYTES : i32 = 2;

/** Bits in one sample of our effects. */
const WAV_BITS : i32 = 16;

/** The mixer and one clip per cue. */
pub class Sfx : Closeable {
    mixer : Mixer;
    clips : Clip[];
    last  : i32[];
    frame : i32 = 0;

    /** Opens the mixer and renders every effect. */
    constructor() {
        self.mixer = new Mixer();
        self.clips = malloc<Clip>(Cue::count() as i64);
        self.last = malloc<i32>(Cue::count() as i64);
        for (i of 0..Cue::count()) {
            self.clips[i] = loadClip(Cue::fromIndex(i));
            self.last[i] = NEVER_PLAYED;
        }
    }

    /** True when a sound device is open. */
    pub fn audible(self) : bool {
        return self.mixer.isOpen();
    }

    /** The mixer, for the pump thread. */
    pub fn mixerHandle(self) : Mixer {
        return self.mixer;
    }

    /** Asks the pump thread to finish; wait for it, then `close`. */
    pub fn stopPump(self) : void {
        self.mixer.requestStop();
    }

    /** Marks a new frame; a cue repeated within a couple of frames is dropped so a volley is not a roar. */
    pub fn nextFrame(mut self) : void {
        self.frame = self.frame + 1;
    }

    /** Plays the effect for `cue` at `gain` (0 to 1). */
    pub fn play(mut self, cue : Cue, gain : f64) : void {
        let i : i32 = cue as i32;
        if (self.frame - self.last[i] < MIN_REPEAT_FRAMES) {
            return;
        }
        self.last[i] = self.frame;
        self.mixer.play(self.clips[i], gain);
    }

    /** Stops the mixer and frees the clips. */
    pub fn close(self) : void {
        for (i of 0..Cue::count()) {
            self.clips[i].close();
        }
        self.mixer.close();
    }
}

/** Renders `cue`, writes it as a WAV file, loads it back as a clip and removes the file. */
pub fn loadClip(cue : Cue) : Clip {
    let samples : i32[] = render(cue);
    let index : i32 = cue as i32;
    let path : string = ".bastion-sfx-${index}.wav";
    try {
        writeWav(path, samples);
        let clip : Clip = Clip::load(path);
        Path::from(path).delete();
        return clip;
    } catch e : IOException {
        // No writable folder: the effect is silence rather than an error.
        return Clip::load(path);
    }
}

// A canonical 44-byte header and the samples, little-endian 16-bit mono.
fn writeWav(path : string, samples : i32[]) : void ! IOException {
    let count : i32 = samples.length as i32;
    let dataBytes : i32 = count * WAV_SAMPLE_BYTES;
    let mut bytes : i8[] = malloc<i8>((HEADER_BYTES + dataBytes) as i64);
    putText(bytes, 0, "RIFF");
    putLe32(bytes, 4, 36 + dataBytes);
    putText(bytes, 8, "WAVE");
    putText(bytes, 12, "fmt ");
    putLe32(bytes, 16, 16);
    putLe16(bytes, 20, WAV_FORMAT_PCM);
    putLe16(bytes, 22, WAV_CHANNELS);
    putLe32(bytes, 24, SYNTH_RATE);
    putLe32(bytes, 28, SYNTH_RATE * WAV_SAMPLE_BYTES);
    putLe16(bytes, 32, WAV_SAMPLE_BYTES);
    putLe16(bytes, 34, WAV_BITS);
    putText(bytes, 36, "data");
    putLe32(bytes, 40, dataBytes);
    for (i of 0..count) {
        putLe16(bytes, HEADER_BYTES + i * WAV_SAMPLE_BYTES, samples[i]);
    }
    let out = new FileOutputStream(path, FileOpenMode::WRITE);
    out.writeBytes(bytes, 0, HEADER_BYTES + dataBytes);
    out.close();
}

fn putText(bytes : i8[], at : i32, s : string) : void {
    for (i of 0..4) {
        bytes[(at + i) as i64] = s.charAt(i) as i8;
    }
}

fn putLe16(bytes : i8[], at : i32, v : i32) : void {
    bytes[at as i64] = (v & 255) as i8;
    bytes[(at + 1) as i64] = ((v >> 8) & 255) as i8;
}

fn putLe32(bytes : i8[], at : i32, v : i32) : void {
    putLe16(bytes, at, v & 65535);
    putLe16(bytes, at + 2, (v >> 16) & 65535);
}

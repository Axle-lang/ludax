// cues — the sounds the simulation asks for.
//
// The simulation must not touch the audio device (it has to run headless and replay exactly), so it only
// notes *what happened* as a `Cue`; the main loop drains the list once per frame and plays whatever is
// wanted. A cue is a plain number in a ludax `Vec<i32>`, which is why this is an enum with a value.

/** Something that happened that deserves a sound. */
pub enum Cue : i8 {
    /** A tower was built. */
    Build = 0,

    /** A tower was upgraded. */
    Upgrade = 1,

    /** A tower was sold. */
    Sell = 2,

    /** A command was refused. */
    Deny = 3,

    /** An arrow tower fired. */
    ShootArrow = 4,

    /** A cannon fired. */
    ShootCannon = 5,

    /** A frost tower fired. */
    ShootFrost = 6,

    /** A shell exploded. */
    Explode = 7,

    /** An enemy died. */
    Kill = 8,

    /** An enemy reached the base. */
    Leak = 9,

    /** A wave began. */
    WaveStart = 10,

    /** A wave was wiped out. */
    WaveClear = 11,

    /** The base fell. */
    GameOver = 12,

    /** A menu choice was made. */
    Click = 13,

    /** How many cues there are, for sizing tables. */
    pub static fn count() : i32 {
        return Cue::Click as i32 + 1;
    }

    /** The cue stored as `i` in the list. */
    pub static fn fromIndex(i : i32) : Cue {
        return match i {
            0 => Cue::Build,
            1 => Cue::Upgrade,
            2 => Cue::Sell,
            3 => Cue::Deny,
            4 => Cue::ShootArrow,
            5 => Cue::ShootCannon,
            6 => Cue::ShootFrost,
            7 => Cue::Explode,
            8 => Cue::Kill,
            9 => Cue::Leak,
            10 => Cue::WaveStart,
            11 => Cue::WaveClear,
            12 => Cue::GameOver,
            _ => Cue::Click,
        };
    }
}

// pick — turning the mouse pointer into a tile or a tower.
//
// The pointer becomes a ray through the view (`View::rayThrough`). Towers are tested first with ray-box
// tests against their bodies, nearest hit wins, so a click on a tall tower selects it even though the ground
// behind it is a different tile. Anything else is tested against the ground plane, and the point where the
// ray meets it names the tile.

use ludax::{Ray, Aabb, Vec3, RayHit, EntityId, rayAabb};

use crate::gfx::view::View;
use crate::sim::grid::Grid;
use crate::sim::units::Tower;
use crate::sim::world::World;

/** Half the footprint of a tower's pick box, in tiles. */
const PICK_HALF : f32 = 0.38;

/** Height of a tower's pick box, in tiles. */
const PICK_HEIGHT : f32 = 1.3;

/** Ray distance standing in for "not hit yet"; far beyond anything the camera draws. */
const PICK_NO_HIT : f32 = 1000000.0;

/** What the pointer is over. */
pub struct Pointing {
    /** The tile under the pointer, or -1 off the board. */
    pub tile : i32;

    /** The tower under the pointer, or the none id. */
    pub tower : EntityId;
}

/** The tile and tower under window pixel (`px`, `py`). */
pub fn pointAt(world : World, view : View, px : i32, py : i32) : Pointing {
    let ray : Ray = view.rayThrough(px, py);
    let mut bestTower : EntityId = EntityId::none();
    let mut bestT : f32 = PICK_NO_HIT;
    for (slot of 0..world.towers.slotCount()) {
        if (!world.towers.isLiveAt(slot)) {
            continue;
        }
        let tower : Tower = world.towers.valueAt(slot);
        let hit : RayHit = rayAabb(ray, towerBox(tower.tile));
        if (hit.hit && hit.t < bestT) {
            bestT = hit.t;
            bestTower = world.towers.idAt(slot);
        }
    }
    if (!bestTower.isNone()) {
        return Pointing { tile: world.towers.get(bestTower).tile, tower: bestTower };
    }
    return Pointing { tile: view.groundTile(px, py), tower: EntityId::none() };
}

// The box a click on the tower at `tile` must hit.
fn towerBox(tile : i32) : Aabb {
    let c = Grid::centerOf(tile);
    return Aabb::fromCenterHalfSize(
        Vec3::make(c.x, PICK_HEIGHT * 0.5, c.y),
        Vec3::make(PICK_HALF, PICK_HEIGHT * 0.5, PICK_HALF)
    );
}

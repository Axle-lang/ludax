// pen — drawing text and figures with smalt's baked faces.
//
// `Pen` holds the two faces (prose and headline figures) and a scratch block that numbers are formatted into,
// so a repaint draws gold and scores without allocating a string for each. Positions are the *top* of the
// text, which is what layout code thinks in; the pen converts to the baseline the faces want.

use smalt::{BitmapFont, Face, Scratch, Frame, Rect};

/** Bytes reserved for a formatted number, enough for a 64-bit figure with grouping. */
const SCRATCH_BYTES : i32 = 160;

/** Text drawing for the overlay. */
pub class Pen : Closeable {
    ui      : BitmapFont;
    big     : BitmapFont;
    scratch : Scratch;

    /** A pen with both baked faces. */
    constructor() {
        self.ui = BitmapFont::baked(Face::Ui);
        self.big = BitmapFont::baked(Face::Headline);
        self.scratch = new Scratch(SCRATCH_BYTES);
    }

    /** Draws `s` with its top at `y`; returns the x where the next character would go. */
    pub fn text(self, f : Frame, x : i32, y : i32, s : string, ink : i32) : i32 {
        return self.ui.draw(f, x, y + self.ui.ascent(), s, ink);
    }

    /** Draws `s` with a one-pixel shadow so it reads over the 3-D scene. */
    pub fn shadowed(self, f : Frame, x : i32, y : i32, s : string, ink : i32, shade : i32) : i32 {
        self.ui.draw(f, x + 1, y + 1 + self.ui.ascent(), s, shade);
        return self.ui.draw(f, x, y + self.ui.ascent(), s, ink);
    }

    /** Draws `s` centred on `cx`. */
    pub fn centred(self, f : Frame, cx : i32, y : i32, s : string, ink : i32) : i32 {
        return self.text(f, cx - self.ui.width(s) / 2, y, s, ink);
    }

    /** Draws `s` ending at `right`. */
    pub fn right(self, f : Frame, right : i32, y : i32, s : string, ink : i32) : i32 {
        return self.text(f, right - self.ui.width(s), y, s, ink);
    }

    /** Draws `s` at an integer `scale`, centred on `cx`, for titles. */
    pub fn banner(self, f : Frame, cx : i32, y : i32, s : string, scale : i32, ink : i32) : void {
        let x : i32 = cx - self.ui.widthScaled(s, scale) / 2;
        self.ui.drawScaled(f, x, self.ui.baselineFor(y, scale), s, scale, ink);
    }

    /** The width of `s` in pixels. */
    pub fn width(self, s : string) : i32 {
        return self.ui.width(s);
    }

    /** Draws a whole number in the big face with its top at `y`; returns the x after it. */
    pub fn figure(self, f : Frame, x : i32, y : i32, n : i64, ink : i32) : i32 {
        self.scratch.reset();
        self.scratch.grouped(n);
        return self.big.drawBytes(
            f,
            x,
            y + self.big.ascent(),
            self.scratch.at(),
            0,
            self.scratch.length(),
            ink
        );
    }

    /** Draws a whole number in the prose face; returns the x after it. */
    pub fn number(self, f : Frame, x : i32, y : i32, n : i64, ink : i32) : i32 {
        self.scratch.reset();
        self.scratch.decimal(n);
        return self.ui.drawBytes(
            f,
            x,
            y + self.ui.ascent(),
            self.scratch.at(),
            0,
            self.scratch.length(),
            ink
        );
    }

    /** Draws a label then a number then a suffix: `Wave 4 `. */
    pub fn labelled(self, f : Frame, x : i32, y : i32, label : string, n : i64, ink : i32) : i32 {
        let after : i32 = self.text(f, x, y, label, ink);
        return self.number(f, after, y, n, ink);
    }

    /** A tenths figure such as `3.5` from `tenths` = 35, in the prose face. */
    pub fn tenths(self, f : Frame, x : i32, y : i32, tenths : i64, ink : i32) : i32 {
        self.scratch.reset();
        self.scratch.tenths(tenths);
        return self.ui.drawBytes(
            f,
            x,
            y + self.ui.ascent(),
            self.scratch.at(),
            0,
            self.scratch.length(),
            ink
        );
    }

    /** A figure with two decimals such as `1.25` from `hundredths` = 125, in the prose face. */
    pub fn hundredths(self, f : Frame, x : i32, y : i32, hundredths : i64, ink : i32) : i32 {
        self.scratch.reset();
        self.scratch.hundredths(hundredths);
        return self.ui.drawBytes(
            f,
            x,
            y + self.ui.ascent(),
            self.scratch.at(),
            0,
            self.scratch.length(),
            ink
        );
    }

    /** Draws `s` centred in `r`. */
    pub fn inside(self, f : Frame, r : Rect, s : string, ink : i32) : void {
        self.ui.drawCentred(f, r, s, ink);
    }

    /** Releases the scratch block. */
    pub fn close(self) : void {
        self.scratch.close();
    }
}

// layout — where each piece of the interface sits in a window of a given size.
//
// Drawing and clicking both need the same rectangles, so they are computed once here from the window size and
// both ask this file. The top bar holds the figures, the bottom bar the build buttons and the wave call, and
// the selected tower's card floats at the right.

use smalt::Rect;

/** Height of the figures bar at the top. */
pub const BAR_H : i32 = 40;

/** Height of the build bar at the bottom. */
pub const DOCK_H : i32 = 64;

/** Width of one build button. */
const BUTTON_W : i32 = 150;

/** Width of the selected-tower card. */
const CARD_W : i32 = 196;

/** Height of the selected-tower card. */
const CARD_H : i32 = 158;

/** Distance from the window edge to the nearest interface element. */
const MARGIN : i32 = 12;

/** Space between two interface elements. */
const GAP : i32 = 8;

/** Width of the wave-call button. */
const CALL_W : i32 = 220;

/** Width of the card's upgrade and sell buttons. */
const CARD_BUTTON_W : i32 = 84;

/** Height of the card's buttons. */
const CARD_BUTTON_H : i32 = 34;

/** Inset of the card's content and buttons from its edge. */
const CARD_INSET : i32 = 10;

/** The rectangles of the interface for a `w` by `h` window. */
pub struct Layout {
    /** Figures bar. */
    pub top : Rect;

    /** Build bar. */
    pub dock : Rect;

    /** The three build buttons, left to right. */
    pub buildArrow : Rect;

    /** Second build button. */
    pub buildCannon : Rect;

    /** Third build button. */
    pub buildFrost : Rect;

    /** The "call next wave" button. */
    pub call : Rect;

    /** The selected tower's card. */
    pub card : Rect;

    /** The card's upgrade button. */
    pub upgrade : Rect;

    /** The card's sell button. */
    pub sell : Rect;

    /** The layout for a window of `w` by `h` pixels. */
    pub static fn forWindow(w : i32, h : i32) : Layout {
        let dockY : i32 = h - DOCK_H;
        let cardX : i32 = w - CARD_W - MARGIN;
        let cardY : i32 = BAR_H + MARGIN;
        let buttonY : i32 = dockY + GAP;
        let buttonH : i32 = DOCK_H - 2 * GAP;
        let cardButtonY : i32 = cardY + CARD_H - CARD_BUTTON_H - CARD_INSET;
        return Layout {
            top: Rect::make(0, 0, w, BAR_H),
            dock: Rect::make(0, dockY, w, DOCK_H),
            buildArrow: Rect::make(MARGIN, buttonY, BUTTON_W, buttonH),
            buildCannon: Rect::make(MARGIN + BUTTON_W + GAP, buttonY, BUTTON_W, buttonH),
            buildFrost: Rect::make(MARGIN + 2 * (BUTTON_W + GAP), buttonY, BUTTON_W, buttonH),
            call: Rect::make(w - CALL_W - MARGIN, buttonY, CALL_W, buttonH),
            card: Rect::make(cardX, cardY, CARD_W, CARD_H),
            upgrade: Rect::make(cardX + CARD_INSET, cardButtonY, CARD_BUTTON_W, CARD_BUTTON_H),
            sell: Rect::make(
                cardX + CARD_W - CARD_BUTTON_W - CARD_INSET,
                cardButtonY,
                CARD_BUTTON_W,
                CARD_BUTTON_H
            ),
        };
    }

    /** The build button for tower slot 0, 1 or 2. */
    pub fn buildButton(self, slot : i32) : Rect {
        return match slot {
            1 => self.buildCannon,
            2 => self.buildFrost,
            _ => self.buildArrow,
        };
    }

    /** True when (`x`, `y`) lies on a bar, so a click there is not a click on the map. */
    pub fn coversBars(self, x : i32, y : i32) : bool {
        return self.top.contains(x, y) || self.dock.contains(x, y);
    }
}

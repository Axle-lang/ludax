// palette — the interface colours, as packed 0xRRGGBB words.
//
// One place for every colour the overlay draws with, so the interface keeps one look and a change of theme is
// an edit here.

/** Panel background. */
pub const C_PANEL : i32 = 0x12171E;

/** Panel outline. */
pub const C_EDGE : i32 = 0x3A4656;

/** Main text. */
pub const C_TEXT : i32 = 0xECEFF4;

/** Secondary text. */
pub const C_DIM : i32 = 0x9AA7B6;

/** Gold amounts. */
pub const C_GOLD : i32 = 0xFFD24A;

/** Lives and danger. */
pub const C_RED : i32 = 0xFF5A5F;

/** Good news, valid placement. */
pub const C_GREEN : i32 = 0x6CDB72;

/** Accent for selection and buttons. */
pub const C_ACCENT : i32 = 0x4CC2FF;

/** Frost blue. */
pub const C_ICE : i32 = 0x9FE8FF;

/** The dark fill behind a health bar. */
pub const C_BAR_BACK : i32 = 0x20262E;

/** Shadow behind text on the playfield. */
pub const C_SHADOW : i32 = 0x05070A;

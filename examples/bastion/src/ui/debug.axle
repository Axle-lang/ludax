// debug — the F3 overlay: timings from the profiler, counters from every system, and the recent log.
//
// It answers "where did the frame go and what is the world doing" without a debugger: the profiler's
// costliest scopes of the last frame, the entity and path counters, how much the frustum culled, and the
// newest lines of the in-game log.

use ludax::{ProfileEntry, LogRecord};
use smalt::{Frame, Rect};

use crate::app::game::Game;
use crate::ui::hud::panel;
use crate::ui::palette::{C_TEXT, C_DIM, C_ACCENT, C_GOLD};
use crate::ui::pen::Pen;

/** Rows of profiler output shown. */
const PROFILE_ROWS : i32 = 8;

/** Log lines shown. */
const LOG_ROWS : i32 = 6;

/** Draws the overlay at the left of the window below the hints. */
pub fn drawDebug(
    f : Frame,
    pen : Pen,
    g : Game,
    fps : i32,
    drawn : i32,
    culled : i32,
    routeLen : i32
) : void {
    let r : Rect = Rect::make(12, 92, 370, 300);
    panel(f, r);
    let x : i32 = r.x + 12;
    let mut y : i32 = r.y + 10;
    pen.text(f, x, y, "F3  debug", C_ACCENT);
    y = y + 20;
    let mut end : i32 = pen.labelled(f, x, y, "fps ", fps as i64, C_TEXT);
    end = pen.labelled(f, end + 14, y, "tick ", g.world.tick as i64, C_TEXT);
    pen.labelled(f, end + 14, y, "seed ", g.world.seed as i64, C_TEXT);
    y = y + 18;
    end = pen.labelled(f, x, y, "enemies ", g.world.enemies.len() as i64, C_TEXT);
    end = pen.labelled(f, end + 14, y, "towers ", g.world.towers.len() as i64, C_TEXT);
    end = pen.labelled(f, end + 14, y, "shots ", g.world.shots.len() as i64, C_TEXT);
    pen.labelled(f, end + 14, y, "fx ", g.world.fx.len() as i64, C_TEXT);
    y = y + 18;
    end = pen.labelled(f, x, y, "route ", routeLen as i64, C_TEXT);
    end = pen.labelled(f, end + 14, y, "A* searches ", g.world.routes.searchCount() as i64, C_TEXT);
    pen.labelled(f, end + 14, y, "map v", g.world.routes.version() as i64, C_TEXT);
    y = y + 18;
    end = pen.labelled(f, x, y, "drawn ", drawn as i64, C_TEXT);
    pen.labelled(f, end + 14, y, "culled ", culled as i64, C_TEXT);
    y = y + 24;
    y = drawProfile(f, pen, g, x, y);
    drawLog(f, pen, g, x, y + 6);
}

// The costliest scopes of the last profiled frame, in microseconds and calls.
fn drawProfile(f : Frame, pen : Pen, g : Game, x : i32, top : i32) : i32 {
    let mut y : i32 = top;
    pen.text(f, x, y, "profile  (microseconds, calls)", C_GOLD);
    y = y + 18;
    let prof = g.probe.profiler;
    let rows : i32 = prof.entryCount();
    for (rank of 0..rows) {
        if (rank >= PROFILE_ROWS) {
            break;
        }
        let e : ProfileEntry = prof.entry(rank);
        pen.text(f, x, y, g.probe.names.name(e.scope), C_TEXT);
        pen.number(f, x + 190, y, e.inclusiveNanos / 1000, C_TEXT);
        pen.number(f, x + 262, y, e.calls as i64, C_DIM);
        y = y + 16;
    }
    return y;
}

// The newest log lines, oldest first.
fn drawLog(f : Frame, pen : Pen, g : Game, x : i32, top : i32) : void {
    let mut y : i32 = top;
    let sink = g.log.sink();
    let count : i32 = sink.count();
    let mut first : i32 = count - LOG_ROWS;
    if (first < 0) {
        first = 0;
    }
    for (i of first..count) {
        let rec : LogRecord = sink.at(i);
        pen.text(f, x, y, rec.message, C_DIM);
        y = y + 16;
    }
}

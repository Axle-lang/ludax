// state — what the player has selected and where the pointer is.
//
// Nothing here is simulation state: it never affects a replay. It records the current build choice, the
// selected tower, the tile under the pointer and the little message line, plus the toggles of the interface.

use ludax::EntityId;

use crate::sim::stats::TowerKind;

/** Which screen of the game is showing. */
pub enum Screen : i8 {
    /** The title, with the board turning slowly behind it. */
    Title = 0,

    /** A run in progress. */
    Playing = 1,

    /** A run, frozen. */
    Paused = 2,

    /** The base has fallen. */
    GameOver = 3,
}

/** Ticks a message stays on screen: frames, not simulation ticks, since it is interface only. */
const TOAST_FRAMES : i32 = 150;

/** The interface's own state. */
pub class UiState {
    /** True while a tower design is chosen for placing. */
    pub(crate) building : bool = false;

    /** The design chosen for placing. */
    pub(crate) kind : TowerKind = TowerKind::Arrow;

    /** The selected tower, or the none id. */
    pub(crate) selected : EntityId = EntityId::none();

    /** The tile under the pointer, -1 for none. */
    pub(crate) hoverTile : i32 = -1;

    /** The tower under the pointer, or the none id. */
    pub(crate) hoverTower : EntityId = EntityId::none();

    /** Pointer x in window pixels. */
    pub(crate) mouseX : i32 = 0;

    /** Pointer y in window pixels. */
    pub(crate) mouseY : i32 = 0;

    /** The message shown above the dock. */
    pub(crate) toast : string = "";

    /** Frames the message has left. */
    pub(crate) toastFrames : i32 = 0;

    /** True when the message is a refusal and shows in red. */
    pub(crate) toastBad : bool = false;

    /** True when the F3 overlay shows. */
    pub(crate) showDebug : bool = false;

    /** True when sound is muted. */
    pub(crate) muted : bool = false;

    /** True while the right button is held to orbit. */
    pub(crate) orbiting : bool = false;

    /** Pixels the pointer has moved since the right button went down, to tell a drag from a click. */
    pub(crate) dragged : i32 = 0;

    /** Forgets the selection and the build choice. */
    pub fn clearChoice(mut self) : void {
        self.building = false;
        self.selected = EntityId::none();
    }

    /** Shows `message` for a while; `bad` colours it as a refusal. */
    pub fn say(mut self, message : string, bad : bool) : void {
        // A copy: the message may be borrowed from a list that will not outlive the toast.
        self.toast = message + "";
        self.toastBad = bad;
        self.toastFrames = TOAST_FRAMES;
    }

    /** Counts the message down by one frame. */
    pub fn ageToast(mut self) : void {
        if (self.toastFrames > 0) {
            self.toastFrames = self.toastFrames - 1;
        }
    }
}

// screens — the title, pause and game-over overlays.
//
// Each dims what is behind it (the 3-D board keeps being drawn, so the title has a living backdrop) and puts
// a banner and a few lines on top. Text sizes use the integer scale of the baked face, which keeps its edges.

use smalt::{Frame, Rect};

use crate::app::game::Game;
use crate::ui::hud::panel;
use crate::ui::palette::{C_TEXT, C_DIM, C_GOLD, C_RED, C_ACCENT, C_GREEN};
use crate::ui::pen::Pen;

/** Frames in one blink cycle of a prompt, and frames of it that show. */
const PROMPT_BLINK_PERIOD : i32 = 80;
const PROMPT_BLINK_ON : i32 = 52;

/** The title: name, tagline, controls, the best score and the call to start. */
pub fn drawTitle(f : Frame, pen : Pen, g : Game) : void {
    f.shade(Rect::make(0, 0, g.width, g.height), 0x000000, 2, 5);
    let cx : i32 = g.width / 2;
    pen.banner(f, cx, 110, "BASTION", 7, C_ACCENT);
    pen.centred(f, cx, 190, "a tower defence on a tile grid, written in Axle", C_TEXT);
    let box : Rect = Rect::make(cx - 250, 232, 500, 188);
    panel(f, box);
    pen.text(f, box.x + 24, box.y + 16, "Build towers. Bend the route. Hold the keep.", C_GOLD);
    pen.text(f, box.x + 24, box.y + 48, "1 / 2 / 3  choose Arrow, Cannon, Frost, then click a tile", C_TEXT);
    pen.text(f, box.x + 24, box.y + 68, "click a tower to select it:  U upgrade   X sell", C_TEXT);
    pen.text(f, box.x + 24, box.y + 88, "Space  call the next wave early for a bonus", C_TEXT);
    pen.text(
        f,
        box.x + 24,
        box.y + 108,
        "WASD pan   Q/E turn   R/F tilt   wheel zoom   right-drag orbit",
        C_TEXT
    );
    pen.text(f, box.x + 24, box.y + 128, "P pause    F3 debug overlay    M mute    F12 screenshot", C_TEXT);
    pen.text(
        f,
        box.x + 24,
        box.y + 154,
        "Towers are walls: you may bend the route but never close it.",
        C_DIM
    );
    if (g.frames % PROMPT_BLINK_PERIOD < PROMPT_BLINK_ON) {
        pen.banner(f, cx, 440, "press ENTER to start", 2, C_GREEN);
    }
    if (g.best > 0) {
        let after : i32 = pen.text(f, cx - 60, 500, "best score  ", C_DIM);
        pen.number(f, after, 500, g.best as i64, C_GOLD);
    }
}

/** The pause card. */
pub fn drawPaused(f : Frame, pen : Pen, g : Game) : void {
    f.shade(Rect::make(0, 0, g.width, g.height), 0x000000, 1, 2);
    let cx : i32 = g.width / 2;
    pen.banner(f, cx, g.height / 2 - 70, "PAUSED", 6, C_TEXT);
    pen.centred(f, cx, g.height / 2 + 20, "P or ESC resume      T back to the title", C_DIM);
}

/** The end-of-run card: score, best, and how to go again. */
pub fn drawGameOver(f : Frame, pen : Pen, g : Game) : void {
    f.shade(Rect::make(0, 0, g.width, g.height), 0x300000, 3, 5);
    let cx : i32 = g.width / 2;
    pen.banner(f, cx, 120, "THE BASTION HAS FALLEN", 4, C_RED);
    let box : Rect = Rect::make(cx - 190, 220, 380, 150);
    panel(f, box);
    let mut x : i32 = pen.text(f, box.x + 28, box.y + 18, "score   ", C_DIM);
    pen.figure(f, x, box.y + 14, g.world.score as i64, C_GOLD);
    x = pen.text(f, box.x + 28, box.y + 54, "waves survived   ", C_DIM);
    pen.number(f, x, box.y + 54, (g.world.wave - 1) as i64, C_TEXT);
    x = pen.text(f, box.x + 28, box.y + 76, "enemies defeated   ", C_DIM);
    pen.number(f, x, box.y + 76, g.world.kills as i64, C_TEXT);
    x = pen.text(f, box.x + 28, box.y + 98, "best this session   ", C_DIM);
    pen.number(f, x, box.y + 98, g.best as i64, C_GOLD);
    if (g.frames % PROMPT_BLINK_PERIOD < PROMPT_BLINK_ON) {
        pen.banner(f, cx, 410, "ENTER  play again", 2, C_GREEN);
    }
    pen.centred(f, cx, 460, "T  title", C_DIM);
}

// main — the entry point: checks, a scripted smoke run, or the windowed game.
//
// One flag decides the mode, in this order: `--check` runs the self-checks, `--smoke-ticks` or `--shot` plays a
// scripted run without a window, and anything else opens the game. A failure to open the platform becomes a
// message and exit status 1, never a stack trace.

use smalt::PlatformError;

use crate::app::args::Args;
use crate::app::checks::runChecks;
use crate::app::session::runWindowed;
use crate::app::smoke::runSmoke;

fn main() : i32 {
    let args = Args::parse();
    if (args.check) {
        return runChecks();
    }
    if (args.smokeTicks > 0 || args.shotPath.length > 0) {
        return runSmoke(args);
    }
    try {
        return runWindowed(args);
    } catch e : PlatformError {
        println(e.message);
        return 1;
    }
}

// assets — the meshes and textures the scene is drawn from, made in code.
//
// There are no files to load: every mesh is one of smalt's primitives and every texture is painted here from
// a fixed-seed `Pcg32`, so a build is self-contained and looks the same on every machine. `Assets` owns them
// all for the life of the program; the scene borrows them each frame.

use ludax::Pcg32;
use smalt::{Mesh, Primitives, Texture, Color};

/** Texels along one side of a tile texture. */
const TEX_SIZE : i32 = 48;

/** Brightness of a speckle texel, in percent of the mixed colour. */
const SPECKLE_SHADE : i32 = 86;

/** Brightness of the darker border that makes a tile read as a grid, in percent. */
const EDGE_SHADE : i32 = 78;

/** Every mesh and texture the game draws with. */
pub class Assets {
    /** A one-by-one ground quad facing up. */
    pub tile : Mesh;

    /** A unit cube centred on the origin. */
    pub cube : Mesh;

    /** A sphere of radius one half. */
    pub ball : Mesh;

    /** A coarse sphere for small things (shots, sparks). */
    pub pebble : Mesh;

    /** A big quad for the land around the board. */
    pub land : Mesh;

    /** Short grass. */
    pub grass : Texture;

    /** Trodden earth, drawn under the enemies' current route. */
    pub dirt : Texture;

    /** Grey stone for rocks, tower bases and the keep. */
    pub stone : Texture;

    /** Planks. */
    pub wood : Texture;

    /** Leaves. */
    pub leaves : Texture;

    /** Meshes and textures, painted from a fixed seed. */
    constructor() {
        self.tile = Primitives::ground(1.0, 1.0);
        self.cube = Primitives::cube(1.0);
        self.ball = Primitives::sphere(0.5, 12, 8);
        self.pebble = Primitives::sphere(0.5, 6, 4);
        self.land = Primitives::ground(120.0, 60.0);
        let rng = new Pcg32(20241104, 9);
        self.grass = painted(rng, 0x4E8F3A, 0x7DBB56, 14, true);
        self.dirt = painted(rng, 0x9C7B4E, 0xC4A56E, 18, true);
        self.stone = painted(rng, 0x7A7F86, 0xA9AEB5, 22, false);
        self.wood = painted(rng, 0x6B4A2B, 0x8E6A3F, 16, false);
        self.leaves = painted(rng, 0x2F6B2C, 0x4F9A3D, 20, false);
    }
}

// A square texture of speckle between two colours, with an optional darker edge so tiles read as a grid.
fn painted(rng : Pcg32, dark : i32, light : i32, speckle : i32, edged : bool) : Texture {
    let t = new Texture(TEX_SIZE, TEX_SIZE);
    for (y of 0..TEX_SIZE) {
        for (x of 0..TEX_SIZE) {
            let mut c : i32 = Color::mix(dark, light, rng.range(0, 100), 100);
            if (rng.range(0, 100) < speckle) {
                c = Color::scale(c, SPECKLE_SHADE, 100);
            }
            if (edged && (x == 0 || y == 0 || x == TEX_SIZE - 1 || y == TEX_SIZE - 1)) {
                c = Color::scale(c, EDGE_SHADE, 100);
            }
            t.put(x, y, c);
        }
    }
    return t;
}

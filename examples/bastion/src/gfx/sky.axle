// sky — the time of day: where the light comes from, what colour it is, and the colour behind the board.
//
// A full day is `DAY_TICKS` simulation ticks, so the cycle is a function of the tick count and a replay shows
// the same lighting. The sun rides a half circle over the board; when it sinks the moon rises on the opposite
// side with a dim blue light. The result is a plain struct of numbers: the renderer turns them into smalt's
// light, material ambience and clear colour, and this file stays free of smalt types.

use ludax::{Vec3, sin, cos, lerp, smoothstep, saturate, max, TAU};

use crate::sim::config::DAY_TICKS;

/** The lighting of one moment. */
pub struct Sky {
    /** Direction the light travels (unit length). */
    pub direction : Vec3;

    /** Red of the light. */
    pub red : f32;

    /** Green of the light. */
    pub green : f32;

    /** Blue of the light. */
    pub blue : f32;

    /** How much of a surface's colour shows without light, 0 to 1. */
    pub ambient : f32;

    /** Red of the clear colour behind the board. */
    pub backRed : f32;

    /** Green of the clear colour. */
    pub backGreen : f32;

    /** Blue of the clear colour. */
    pub backBlue : f32;

    /** 0 in full day, 1 in the middle of the night; lamps and windows glow by it. */
    pub night : f32;
}

/** The fraction of the day, 0 to 1, at simulation tick `tick`; the game starts in the morning. */
pub fn dayPhase(tick : i32) : f32 {
    let into : i32 = (tick + DAY_TICKS / 8) % DAY_TICKS;
    return into as f32 / DAY_TICKS as f32;
}

/** The sky at simulation tick `tick`. */
pub fn skyAt(tick : i32) : Sky {
    let angle : f32 = dayPhase(tick) * TAU;
    let height : f32 = sin(angle);
    let day : f32 = smoothstep(-(0.18 as f32), (0.28 as f32), height);
    let dusk : f32 = (1.0 as f32) - smoothstep((0.0 as f32), (0.5 as f32), max(height, (0.0 as f32)));
    let sun : Vec3 = Vec3::make(cos(angle) * 0.9, height, 0.4).normalized();
    let moon : Vec3 = Vec3::make(-cos(angle) * 0.7, -height, 0.5).normalized();
    return Sky {
        direction: moon.lerp(sun, day).normalized().negated(),
        red: lerp(0.30, lerp(1.0, 1.0, dusk), day),
        green: lerp(0.38, lerp(0.96, 0.72, dusk), day),
        blue: lerp(0.62, lerp(0.88, 0.50, dusk), day),
        ambient: lerp(0.30, 0.38, day),
        backRed: lerp(0.03, lerp(0.42, 0.85, dusk * day), day),
        backGreen: lerp(0.04, lerp(0.62, 0.50, dusk * day), day),
        backBlue: lerp(0.10, lerp(0.88, 0.40, dusk * day), day),
        night: saturate(1.0 - day * 1.4),
    };
}

// rig — the orbit-and-pan camera.
//
// The camera orbits a target point on the ground: `yaw` turns it around the vertical axis, `pitch` tips it
// up from the horizon, `distance` pulls it back. Panning slides the target over the ground in the frame of
// the view (forward means "away from the camera"), and the target is held inside the map so the player cannot
// lose the board. All values are ludax `f32`; the smalt camera is told the resulting eye and target by the
// renderer, so this file never touches smalt types.

use ludax::{Vec3, sin, cos, clamp};

use crate::sim::config::{GRID_W, GRID_H};

/** Closest the camera may come to its target. */
const ZOOM_MIN : f32 = 5.0;

/** Farthest the camera may go from its target. */
const ZOOM_MAX : f32 = 26.0;

/** Lowest pitch, radians: nearly flat, looking across the board. */
const PITCH_MIN : f32 = 0.35;

/** Highest pitch, radians: nearly top-down. */
const PITCH_MAX : f32 = 1.45;

/** Pitch a new run starts at, radians. */
const RIG_START_PITCH : f32 = 0.95;

/** Distance a new run starts at, tiles. */
const RIG_START_DISTANCE : f32 = 17.0;

/** Where the orbiting camera looks and from where. */
pub class Rig {
    targetX  : f32 = 0.0;
    targetZ  : f32 = 0.0;
    yaw      : f32 = 0.0;
    pitch    : f32 = 0.0;
    distance : f32 = 0.0;

    /** A rig at the start of a run, looking at the middle of the board from the south. */
    constructor() {
        self.reset();
    }

    /** The rig as a new run starts: the whole board in view from the south. */
    pub fn reset(mut self) : void {
        self.targetX = GRID_W as f32 * (0.5 as f32);
        self.targetZ = GRID_H as f32 * (0.5 as f32);
        self.yaw = 0.0;
        self.pitch = RIG_START_PITCH;
        self.distance = RIG_START_DISTANCE;
    }

    /** Where the camera is. */
    pub fn eye(self) : Vec3 {
        let flat : f32 = cos(self.pitch) * self.distance;
        return Vec3::make(
            self.targetX + sin(self.yaw) * flat,
            sin(self.pitch) * self.distance,
            self.targetZ + cos(self.yaw) * flat
        );
    }

    /** The point the camera looks at, on the ground. */
    pub fn target(self) : Vec3 {
        return Vec3::make(self.targetX, 0.0, self.targetZ);
    }

    /** Slides the target by `forward` tiles away from the camera and `right` tiles to its right. */
    pub fn pan(mut self, forward : f32, right : f32) : void {
        let s : f32 = sin(self.yaw);
        let c : f32 = cos(self.yaw);
        self.targetX = self.targetX - s * forward + c * right;
        self.targetZ = self.targetZ - c * forward - s * right;
        self.targetX = clamp(self.targetX, 0.0, GRID_W as f32);
        self.targetZ = clamp(self.targetZ, 0.0, GRID_H as f32);
    }

    /** Turns the camera around its target by `dYaw` radians and tips it by `dPitch`. */
    pub fn orbit(mut self, dYaw : f32, dPitch : f32) : void {
        self.yaw = self.yaw + dYaw;
        self.pitch = clamp(self.pitch + dPitch, PITCH_MIN, PITCH_MAX);
    }

    /** Moves the camera closer (negative) or farther (positive) by `amount` tiles. */
    pub fn zoom(mut self, amount : f32) : void {
        self.distance = clamp(self.distance + amount, ZOOM_MIN, ZOOM_MAX);
    }

    /** The zoom distance, used to scale the pan speed so panning feels the same near and far. */
    pub fn reach(self) : f32 {
        return self.distance;
    }
}

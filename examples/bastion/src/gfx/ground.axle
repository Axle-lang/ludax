// ground — drawing the land: the lawn, the route, rocks, trees, the portal and the keep.
//
// Everything here is static for the length of a run apart from the route overlay, so it is mostly a loop over
// tiles with a frustum test in front of each draw. `Scenery` holds the trees, scattered outside the board from
// a seeded generator.

use ludax::{Pcg32, Vec, sin};
use smalt::SoftDevice;

use crate::gfx::assets::Assets;
use crate::gfx::look::{DrawStats, Lighting};
use crate::gfx::model::{boxAt, placed};
use crate::gfx::route::RouteOverlay;
use crate::gfx::view::View;
use crate::sim::config::{GRID_W, GRID_H};
use crate::sim::grid::Grid;
use crate::sim::world::World;

/** Trees to scatter around the board. */
const TREE_COUNT : i32 = 46;

/** Trees placed by a seed: positions and sizes around the board. */
pub class Scenery {
    /** World x of each tree. */
    pub(crate) xs : Vec<f32>;

    /** World z of each tree, paired with `xs` by index. */
    pub(crate) zs : Vec<f32>;

    /** Size multiplier of each tree, paired with `xs` by index. */
    pub(crate) sizes : Vec<f32>;

    /** Scatters trees for `seed`, never on the board itself. */
    constructor(seed : u64) {
        self.xs = new Vec<f32>();
        self.zs = new Vec<f32>();
        self.sizes = new Vec<f32>();
        let rng = new Pcg32(seed, 4);
        while (self.xs.len() < TREE_COUNT) {
            let x : f32 = rng.rangeF32(-(12.0 as f32), GRID_W as f32 + (12.0 as f32));
            let z : f32 = rng.rangeF32(-(10.0 as f32), GRID_H as f32 + (10.0 as f32));
            let onBoard : bool = x > -0.8 && x < GRID_W as f32 + 0.8 && z > -0.8 && z < GRID_H as f32 + 0.8;
            if (!onBoard) {
                self.xs.push(x);
                self.zs.push(z);
                self.sizes.push(rng.rangeF32(0.8, 1.5));
            }
        }
    }
}

/** Draws the lawn, the route marking, rocks, trees, portal and keep. */
pub fn drawGround(
    dev : SoftDevice,
    a : Assets,
    world : World,
    view : View,
    light : Lighting,
    stats : DrawStats,
    route : RouteOverlay,
    scenery : Scenery
) : void {
    let middle = boxAt(GRID_W as f32 * 0.5, -0.04, GRID_H as f32 * 0.5, 1.0, 1.0, 1.0);
    dev.drawMesh(a.land, middle, a.grass, light.skin(0x8FA98A));
    for (t of 0..Grid::tileCount()) {
        drawTile(dev, a, world, view, light, stats, route, t);
    }
    drawTrees(dev, a, view, light, stats, scenery);
    drawPortal(dev, a, view, light, stats);
    drawKeep(dev, a, view, light, stats);
}

// One lawn tile, the route in earth, and the rock if there is one.
fn drawTile(
    dev : SoftDevice,
    a : Assets,
    world : World,
    view : View,
    light : Lighting,
    stats : DrawStats,
    route : RouteOverlay,
    t : i32
) : void {
    let c = Grid::centerOf(t);
    if (!stats.visible(view.seesBox(c.x, 0.0, c.y, 0.5, 0.06, 0.5))) {
        return;
    }
    let mut tint : i32 = 0xFFFFFF;
    if ((Grid::colOf(t) + Grid::rowOf(t)) % 2 == 1) {
        tint = 0xE8E8E8;
    }
    let at = boxAt(c.x, 0.0, c.y, 1.0, 1.0, 1.0);
    if (route.covers(t)) {
        dev.drawMesh(a.tile, at, a.dirt, light.skin(tint));
    } else {
        dev.drawMesh(a.tile, at, a.grass, light.skin(tint));
    }
    if (world.grid.isRock(t)) {
        drawRock(dev, a, light, c.x, c.y, t);
    }
}

// A lumpy boulder whose shape depends on its tile, so neighbours differ.
fn drawRock(dev : SoftDevice, a : Assets, light : Lighting, x : f32, z : f32, t : i32) : void {
    let wide : f32 = (0.78 as f32) + (t % 5) as f32 * (0.04 as f32);
    let tall : f32 = (0.55 as f32) + (t % 3) as f32 * (0.1 as f32);
    dev.drawMesh(a.ball, placed(x, 0.22, z, t as f32, wide, tall, 0.7), a.stone, light.skin(0xC8C8D0));
    dev.drawMesh(a.ball, placed(x + 0.18, 0.12, z - 0.15, 1.0, 0.4, 0.3, 0.4), a.stone, light.skin(0xA8A8B0));
}

// Trunk and two blobs of foliage for each scattered tree.
fn drawTrees(
    dev : SoftDevice,
    a : Assets,
    view : View,
    light : Lighting,
    stats : DrawStats,
    s : Scenery
) : void {
    for (i of 0..s.xs.len()) {
        let x : f32 = s.xs.get(i);
        let z : f32 = s.zs.get(i);
        let k : f32 = s.sizes.get(i);
        if (!stats.visible(view.seesBox(x, k, z, 0.9 * k, 1.2 * k, 0.9 * k))) {
            continue;
        }
        dev.drawMesh(
            a.cube,
            boxAt(x, 0.35 * k, z, 0.25 * k, 0.7 * k, 0.25 * k),
            a.wood,
            light.skin(0xFFFFFF)
        );
        dev.drawMesh(
            a.ball,
            boxAt(x, 1.05 * k, z, 1.3 * k, 1.1 * k, 1.3 * k),
            a.leaves,
            light.skin(0xFFFFFF)
        );
        dev.drawMesh(a.ball, boxAt(x, 1.6 * k, z, 0.9 * k, 0.8 * k, 0.9 * k), a.leaves, light.skin(0xE0F0E0));
    }
}

// The purple gate the enemies come out of.
fn drawPortal(dev : SoftDevice, a : Assets, view : View, light : Lighting, stats : DrawStats) : void {
    let c = Grid::centerOf(Grid::spawnTile());
    if (!stats.visible(view.seesBox(c.x, 0.8, c.y, 0.7, 0.8, 0.7))) {
        return;
    }
    dev.drawMesh(a.cube, boxAt(c.x - 0.05, 0.7, c.y - 0.42, 0.22, 1.4, 0.22), a.stone, light.skin(0xFFFFFF));
    dev.drawMesh(a.cube, boxAt(c.x - 0.05, 0.7, c.y + 0.42, 0.22, 1.4, 0.22), a.stone, light.skin(0xFFFFFF));
    dev.drawMesh(a.cube, boxAt(c.x - 0.05, 1.45, c.y, 0.26, 0.2, 1.1), a.stone, light.skin(0xFFFFFF));
    let pulse : f32 = (0.85 as f32) + (0.15 as f32) * sin(light.clock * (0.12 as f32));
    let core = boxAt(c.x, 0.6, c.y, 0.5 * pulse, 0.95 * pulse, 0.7 * pulse);
    dev.drawMesh(a.ball, core, a.stone, light.glow(0xB04BFF, 1.0));
}

// The base the enemies are after: a stone keep with corner turrets and a flag.
fn drawKeep(dev : SoftDevice, a : Assets, view : View, light : Lighting, stats : DrawStats) : void {
    let c = Grid::centerOf(Grid::goalTile());
    if (!stats.visible(view.seesBox(c.x, 0.8, c.y, 0.8, 1.0, 0.8))) {
        return;
    }
    dev.drawMesh(a.cube, boxAt(c.x, 0.45, c.y, 0.8, 0.9, 0.8), a.stone, light.skin(0xE8E0D0));
    for (i of 0..4) {
        let dx : f32 = (0.38 as f32) * ((i % 2) as f32 * (2.0 as f32) - (1.0 as f32));
        let dz : f32 = (0.38 as f32) * ((i / 2) as f32 * (2.0 as f32) - (1.0 as f32));
        dev.drawMesh(a.cube, boxAt(c.x + dx, 0.6, c.y + dz, 0.26, 1.2, 0.26), a.stone, light.skin(0xD8D0C0));
        dev.drawMesh(a.cube, boxAt(c.x + dx, 1.28, c.y + dz, 0.34, 0.16, 0.34), a.wood, light.skin(0xC04030));
    }
    dev.drawMesh(a.cube, boxAt(c.x, 1.25, c.y, 0.05, 0.7, 0.05), a.wood, light.skin(0xFFFFFF));
    dev.drawMesh(a.cube, boxAt(c.x, 1.45, c.y + 0.17, 0.03, 0.26, 0.34), a.wood, light.paint(0x3A6BFF));
}

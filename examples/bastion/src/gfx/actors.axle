// actors — drawing the things that move or were built: towers, enemies, shots and effects.
//
// Each thing is a few boxes and balls placed from its simulation state; nothing here changes the state. A
// frustum test comes before every draw, so a camera zoomed on one corner does not pay for the rest. Facing
// angles are the simulation's `atan2(dz, dx)`; a turn of the model about the vertical axis by the negative of
// that angle points its local +x axis the same way.

use ludax::{sin, cos, abs, max, atan2};
use smalt::SoftDevice;

use crate::gfx::assets::Assets;
use crate::gfx::look::{DrawStats, Lighting};
use crate::gfx::model::{boxAt, placed};
use crate::gfx::view::View;
use crate::sim::grid::Grid;
use crate::sim::stats::{TowerKind, EnemyKind, enemyStats};
use crate::sim::units::{Tower, Enemy, Shot, Fx, FxKind};
use crate::sim::world::World;

/** Ticks after firing during which a tower's head is visibly pushed back. */
const RECOIL_TICKS : i32 = 8;

/** Tiles the head is pushed back at the moment of firing. */
const RECOIL_REACH : f32 = 0.1;

/** Pebbles that make a blast ring. */
const RING_PEBBLES : i32 = 14;

/** Radians between two pebbles: one fourteenth of a turn, written out so the picture is byte-identical to the original. */
const RING_STEP : f32 = 0.4488;

/** Draws every tower. */
pub fn drawTowers(
    dev : SoftDevice,
    a : Assets,
    world : World,
    view : View,
    light : Lighting,
    stats : DrawStats
) : void {
    for (slot of 0..world.towers.slotCount()) {
        if (!world.towers.isLiveAt(slot)) {
            continue;
        }
        let t : Tower = world.towers.valueAt(slot);
        let c = Grid::centerOf(t.tile);
        if (stats.visible(view.seesBox(c.x, 0.6, c.y, 0.5, 0.8, 0.5))) {
            drawTower(dev, a, light, t, c.x, c.y);
        }
    }
}

// The stone plinth, the level pips, and the kind's own body.
fn drawTower(dev : SoftDevice, a : Assets, light : Lighting, t : Tower, x : f32, z : f32) : void {
    dev.drawMesh(a.cube, boxAt(x, 0.09, z, 0.82, 0.18, 0.82), a.stone, light.skin(0xFFFFFF));
    for (i of 0..t.level) {
        let dx : f32 = ((i - 1) as f32) * (0.2 as f32);
        dev.drawMesh(
            a.cube,
            boxAt(x + dx, 0.2, z + 0.36, 0.1, 0.07, 0.07),
            a.stone,
            light.glow(0xFFD24A, 0.8)
        );
    }
    let since : f32 = max((0.0 as f32), (RECOIL_TICKS as f32) - t.sinceShot as f32);
    let recoil : f32 = since / (RECOIL_TICKS as f32) * RECOIL_REACH;
    match t.kind {
        TowerKind::Arrow => drawArrowTower(dev, a, light, t, x, z, recoil),
        TowerKind::Cannon => drawCannon(dev, a, light, t, x, z, recoil),
        TowerKind::Frost => drawFrostTower(dev, a, light, t, x, z),
    }
}

fn drawArrowTower(
    dev : SoftDevice,
    a : Assets,
    light : Lighting,
    t : Tower,
    x : f32,
    z : f32,
    recoil : f32
) : void {
    let height : f32 = (0.5 as f32) + (0.14 as f32) * t.level as f32;
    dev.drawMesh(a.cube, boxAt(x, 0.18 + height * 0.5, z, 0.34, height, 0.34), a.wood, light.skin(0xFFFFFF));
    let top : f32 = (0.18 as f32) + height;
    let yaw : f32 = (0.0 as f32) - t.aim;
    dev.drawMesh(a.cube, placed(x, top + 0.07, z, yaw, 0.5, 0.14, 0.5), a.wood, light.skin(0xD8C0A0));
    let reach : f32 = (0.2 as f32) - recoil;
    let bow = placed(x + cos(t.aim) * reach, top + 0.2, z + sin(t.aim) * reach, yaw, 0.08, 0.1, 0.62);
    dev.drawMesh(a.cube, bow, a.wood, light.skin(0xB89060));
    let tip = placed(x + cos(t.aim) * 0.3, top + 0.2, z + sin(t.aim) * 0.3, yaw, 0.36, 0.04, 0.04);
    dev.drawMesh(a.cube, tip, a.stone, light.skin(0xE0E0E0));
}

fn drawCannon(
    dev : SoftDevice,
    a : Assets,
    light : Lighting,
    t : Tower,
    x : f32,
    z : f32,
    recoil : f32
) : void {
    let yaw : f32 = (0.0 as f32) - t.aim;
    let size : f32 = (0.62 as f32) + (0.06 as f32) * t.level as f32;
    dev.drawMesh(a.ball, boxAt(x, 0.42, z, size, size * 0.8, size), a.stone, light.skin(0x707078));
    let reach : f32 = (0.26 as f32) - recoil;
    let barrel = placed(x + cos(t.aim) * reach, 0.56, z + sin(t.aim) * reach, yaw, 0.62, 0.22, 0.22);
    dev.drawMesh(a.cube, barrel, a.stone, light.skin(0x45454C));
    let muzzle = placed(
        x + cos(t.aim) * (reach + 0.3),
        0.56,
        z + sin(t.aim) * (reach + 0.3),
        yaw,
        0.1,
        0.28,
        0.28
    );
    dev.drawMesh(a.cube, muzzle, a.stone, light.skin(0x2E2E33));
}

fn drawFrostTower(dev : SoftDevice, a : Assets, light : Lighting, t : Tower, x : f32, z : f32) : void {
    dev.drawMesh(a.cube, boxAt(x, 0.35, z, 0.3, 0.34, 0.3), a.stone, light.skin(0x9ED8F0));
    let spin : f32 = light.clock * (0.04 as f32);
    let bob : f32 = (0.04 as f32) * sin(light.clock * (0.07 as f32));
    let height : f32 = (0.55 as f32) + (0.1 as f32) * t.level as f32;
    let crystal = placed(x, 0.78 + bob, z, spin, 0.32, height, 0.32);
    dev.drawMesh(a.cube, crystal, a.stone, light.glow(0x7FD8FF, 0.45 + 0.4 * light.night));
    let turned = placed(x, 0.78 + bob, z, spin + 0.785, 0.32, height, 0.32);
    dev.drawMesh(a.cube, turned, a.stone, light.glow(0xA8E8FF, 0.45 + 0.4 * light.night));
}

/** Draws every enemy. */
pub fn drawEnemies(
    dev : SoftDevice,
    a : Assets,
    world : World,
    view : View,
    light : Lighting,
    stats : DrawStats
) : void {
    for (slot of 0..world.enemies.slotCount()) {
        if (!world.enemies.isLiveAt(slot)) {
            continue;
        }
        let e : Enemy = world.enemies.valueAt(slot);
        let r : f32 = enemyStats(e.kind).radius;
        if (stats.visible(view.seesBox(e.pos.x, r * 1.5, e.pos.y, r * 1.6, r * 1.6, r * 1.6))) {
            let frozen : bool = world.slows.has(world.enemies.idAt(slot).index);
            drawEnemy(dev, a, light, e, frozen);
        }
    }
}

// A shadow blob, then the body for the kind. Frozen enemies turn icy blue.
fn drawEnemy(dev : SoftDevice, a : Assets, light : Lighting, e : Enemy, frozen : bool) : void {
    let r : f32 = enemyStats(e.kind).radius;
    let hop : f32 = abs(sin(e.age as f32 * (0.22 as f32))) * r * (0.35 as f32);
    let yaw : f32 = (0.0 as f32) - e.heading;
    dev.drawMesh(
        a.ball,
        boxAt(e.pos.x, 0.02, e.pos.y, r * 2.4, 0.02, r * 2.4),
        a.stone,
        light.paint(0x1E3016)
    );
    match e.kind {
        EnemyKind::Grunt => {
            let body = placed(e.pos.x, r + hop, e.pos.y, yaw, r * 2.1, r * 2.2, r * 2.0);
            dev.drawMesh(a.ball, body, a.stone, light.paint(pick(frozen, 0x7FB8E8, 0x66B84A)));
            let eye = placed(
                e.pos.x + cos(e.heading) * r * 0.7,
                r * 1.4 + hop,
                e.pos.y + sin(e.heading) * r * 0.7,
                yaw,
                r * 0.5,
                r * 0.5,
                r * 0.9
            );
            dev.drawMesh(a.cube, eye, a.stone, light.paint(0x20281A));
        },
        EnemyKind::Runner => {
            let body = placed(e.pos.x, r * 0.9 + hop, e.pos.y, yaw, r * 3.0, r * 1.7, r * 2.0);
            dev.drawMesh(a.ball, body, a.stone, light.paint(pick(frozen, 0x9ACBF0, 0xE8C23A)));
            let tail = placed(
                e.pos.x - cos(e.heading) * r * 1.4,
                r * 0.9 + hop,
                e.pos.y - sin(e.heading) * r * 1.4,
                yaw,
                r * 1.0,
                r * 0.4,
                r * 0.4
            );
            dev.drawMesh(a.cube, tail, a.stone, light.paint(0xB0902A));
        },
        EnemyKind::Brute => {
            let body = placed(e.pos.x, r * 1.0 + hop * 0.4, e.pos.y, yaw, r * 2.0, r * 1.9, r * 2.0);
            dev.drawMesh(a.cube, body, a.stone, light.paint(pick(frozen, 0x7A98C8, 0x8A4FB0)));
            let head = placed(e.pos.x, r * 2.1 + hop * 0.4, e.pos.y, yaw, r * 1.1, r * 1.1, r * 1.1);
            dev.drawMesh(a.ball, head, a.stone, light.paint(pick(frozen, 0xA8C0E0, 0xB07AD0)));
        },
        EnemyKind::Boss => {
            let body = placed(e.pos.x, r * 1.1 + hop * 0.3, e.pos.y, yaw, r * 2.3, r * 2.2, r * 2.3);
            dev.drawMesh(a.ball, body, a.stone, light.paint(pick(frozen, 0x8AA8D0, 0xB02A2A)));
            let hornL = placed(e.pos.x, r * 2.6, e.pos.y - r * 0.8, yaw, r * 0.3, r * 1.2, r * 0.3);
            let hornR = placed(e.pos.x, r * 2.6, e.pos.y + r * 0.8, yaw, r * 0.3, r * 1.2, r * 0.3);
            dev.drawMesh(a.cube, hornL, a.stone, light.paint(0xE8E0C8));
            dev.drawMesh(a.cube, hornR, a.stone, light.paint(0xE8E0C8));
            let glare = placed(
                e.pos.x + cos(e.heading) * r * 0.9,
                r * 1.5,
                e.pos.y + sin(e.heading) * r * 0.9,
                yaw,
                r * 0.4,
                r * 0.3,
                r * 1.2
            );
            dev.drawMesh(a.cube, glare, a.stone, light.glow(0xFFE060, 1.0));
        },
    }
}

// `ice` when frozen, otherwise `warm`.
fn pick(frozen : bool, ice : i32, warm : i32) : i32 {
    if (frozen) {
        return ice;
    }
    return warm;
}

/** Draws every projectile in flight. */
pub fn drawShots(
    dev : SoftDevice,
    a : Assets,
    world : World,
    view : View,
    light : Lighting,
    stats : DrawStats
) : void {
    for (d of 0..world.shots.len()) {
        let s : Shot = world.shots.valueAt(d);
        if (!stats.visible(view.seesBox(s.pos.x, s.height, s.pos.y, 0.3, 0.3, 0.3))) {
            continue;
        }
        let ahead = s.aimAt.minus(s.pos);
        let yaw : f32 = (0.0 as f32) - atan2(ahead.y, ahead.x);
        match s.kind {
            TowerKind::Arrow => {
                dev.drawMesh(
                    a.cube,
                    placed(s.pos.x, s.height, s.pos.y, yaw, 0.34, 0.04, 0.04),
                    a.stone,
                    light.paint(0xF0E8D0)
                );
            },
            TowerKind::Cannon => {
                dev.drawMesh(
                    a.ball,
                    boxAt(s.pos.x, s.height, s.pos.y, 0.26, 0.26, 0.26),
                    a.stone,
                    light.paint(0x202024)
                );
            },
            TowerKind::Frost => {
                dev.drawMesh(
                    a.ball,
                    boxAt(s.pos.x, s.height, s.pos.y, 0.2, 0.2, 0.2),
                    a.stone,
                    light.glow(0x9FE8FF, 1.0)
                );
            },
        }
    }
}

/** Draws the sparks, blast rings and leak puffs (the gold labels are drawn by the overlay). */
pub fn drawEffects(
    dev : SoftDevice,
    a : Assets,
    world : World,
    view : View,
    light : Lighting,
    stats : DrawStats
) : void {
    for (d of 0..world.fx.len()) {
        let f : Fx = world.fx.valueAt(d);
        if (!stats.visible(view.seesBox(f.pos.x, f.pos.y, f.pos.z, 1.6, 1.6, 1.6))) {
            continue;
        }
        let fraction : f32 = f.life as f32 / f.span as f32;
        match f.kind {
            FxKind::Spark => {
                let k : f32 = (0.06 as f32) + (0.05 as f32) * fraction;
                dev.drawMesh(
                    a.pebble,
                    boxAt(f.pos.x, f.pos.y, f.pos.z, k, k, k),
                    a.stone,
                    light.glow(0xFFC040, 1.0)
                );
            },
            FxKind::Ring => drawRing(dev, a, light, f, fraction),
            FxKind::Leak => {
                let k : f32 = (0.3 as f32) + (1.0 as f32) * ((1.0 as f32) - fraction);
                dev.drawMesh(
                    a.pebble,
                    boxAt(f.pos.x, f.pos.y, f.pos.z, k, k, k),
                    a.stone,
                    light.glow(0xFF3030, 1.0)
                );
            },
            FxKind::Coin => {},
        }
    }
}

// A ring of pebbles that grows to the blast radius and fades by shrinking.
fn drawRing(dev : SoftDevice, a : Assets, light : Lighting, f : Fx, fraction : f32) : void {
    let radius : f32 = f.value as f32 / (100.0 as f32) * ((1.0 as f32) - fraction * (0.6 as f32));
    let k : f32 = (0.05 as f32) + (0.1 as f32) * fraction;
    for (i of 0..RING_PEBBLES) {
        let angle : f32 = i as f32 * RING_STEP;
        let x : f32 = f.pos.x + cos(angle) * radius;
        let z : f32 = f.pos.z + sin(angle) * radius;
        dev.drawMesh(a.pebble, boxAt(x, 0.08, z, k, k * 0.5, k), a.stone, light.glow(0xFF9A30, 1.0));
    }
}

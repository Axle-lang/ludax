// look — the per-frame numbers the scene shares: the lighting it paints with and the cull counters.
//
// `Lighting` turns the sky's light into the ambient term every material gets and the glow of lamps at night,
// and carries a free-running clock for pulsing things. `DrawStats` counts what the frustum let through, which
// the F3 overlay shows; it is reset at the start of each frame.

use smalt::Material;

use crate::gfx::model::{skinned, flat, lamp};

/** What the materials of this frame need to know about the light. */
pub struct Lighting {
    /** Share of a surface's colour that shows without sunlight. */
    pub ambient : f32;

    /** 0 by day, 1 at the darkest of the night. */
    pub night : f32;

    /** Frames drawn so far, as a float, for animation that must not touch the simulation. */
    pub clock : f32;

    /** A textured material tinted by `tint`, lit by this light. */
    pub fn skin(self, tint : i32) : Material {
        return skinned(tint, self.ambient);
    }

    /** A flat-coloured material lit by this light. */
    pub fn paint(self, tint : i32) : Material {
        return flat(tint, self.ambient);
    }

    /** A flat material that glows by `amount` (0 to 1) regardless of the light. */
    pub fn glow(self, tint : i32, amount : f32) : Material {
        return lamp(tint, self.ambient, amount);
    }

    /** A flat material that glows only at night, as a lamp does. */
    pub fn lantern(self, tint : i32) : Material {
        return lamp(tint, self.ambient, self.night);
    }
}

/** Counts of what the frustum test kept and dropped in one frame. */
pub class DrawStats {
    /** Objects that passed the test and were drawn. */
    pub(crate) drawn : i32 = 0;

    /** Objects the test rejected. */
    pub(crate) culled : i32 = 0;

    /** Starts a new frame's count. */
    pub fn reset(mut self) : void {
        self.drawn = 0;
        self.culled = 0;
    }

    /** Counts one object that either passed (`seen`) or was dropped, and passes the answer through. */
    pub fn visible(mut self, seen : bool) : bool {
        if (seen) {
            self.drawn = self.drawn + 1;
        } else {
            self.culled = self.culled + 1;
        }
        return seen;
    }
}

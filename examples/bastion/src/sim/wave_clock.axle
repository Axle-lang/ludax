// wave_clock — the wave clock: countdown, spawning, and paying out a cleared wave.
//
// Between waves a countdown runs. When it reaches zero the next wave starts: the plan drawn earlier becomes
// the active one, the following wave is composed for the preview, and enemies are released one by one at the
// wave's pace. Once the last one is out the countdown for the next wave restarts, so a slow player can see
// waves overlap. When nothing is left alive after a wave, the player is paid for finishing it.

use crate::audio::cues::Cue;
use crate::sim::config::WAVE_GAP;
use crate::sim::grid::Grid;
use crate::sim::stats::{EnemyKind, enemyStats, scaledHealth};
use crate::sim::units::Enemy;
use crate::sim::waves::{composeWave, spawnGapBase};
use crate::sim::world::World;

/** Gold paid for clearing any wave. */
const WAVE_CLEAR_GOLD : i32 = 12;

/** Extra gold for each wave number, per wave cleared. */
const WAVE_CLEAR_GOLD_PER_WAVE : i32 = 3;

/** Score for each wave number, per wave cleared. */
const WAVE_CLEAR_SCORE_PER_WAVE : i32 = 30;

/** One tick of the wave clock. */
pub fn stepWaves(w : World) : void {
    if (w.spawning) {
        w.spawnTimer = w.spawnTimer - 1;
        if (w.spawnTimer <= 0) {
            releaseNext(w);
        }
    } else {
        w.countdown = w.countdown - 1;
        if (w.countdown <= 0) {
            startWave(w);
        }
    }
    if (w.clearPending && !w.spawning && w.enemies.len() == 0) {
        payForClearedWave(w);
    }
}

/** Starts the next wave right now, as the player's early call does. */
pub fn startWave(w : World) : void {
    w.wave = w.wave + 1;
    w.plan.clear();
    for (i of 0..w.upcoming.len()) {
        w.plan.push(w.upcoming.get(i));
    }
    composeWave(w.wave + 1, w.waveRng, w.upcoming);
    w.planCursor = 0;
    w.spawning = true;
    w.clearPending = true;
    w.spawnTimer = 1;
    w.raise(Cue::WaveStart);
}

// Puts the next enemy of the plan on the lane and schedules the one after it.
fn releaseNext(w : World) : void {
    let kind : EnemyKind = EnemyKind::fromIndex(w.plan.get(w.planCursor));
    let stats = enemyStats(kind);
    let tile : i32 = Grid::spawnTile();
    let health : i32 = scaledHealth(stats.health, w.wave);
    w.enemies.insert(Enemy::newborn(kind, tile, Grid::centerOf(tile), health));
    w.planCursor = w.planCursor + 1;
    if (w.planCursor >= w.plan.len()) {
        w.spawning = false;
        w.countdown = WAVE_GAP;
        return;
    }
    let base : i32 = spawnGapBase(w.wave);
    w.spawnTimer = base + w.waveRng.range(0, base / 2 + 1);
}

// The reward for a wave that nothing survived.
fn payForClearedWave(w : World) : void {
    w.clearPending = false;
    w.gold = w.gold + WAVE_CLEAR_GOLD + WAVE_CLEAR_GOLD_PER_WAVE * w.wave;
    w.score = w.score + WAVE_CLEAR_SCORE_PER_WAVE * w.wave;
    w.raise(Cue::WaveClear);
}

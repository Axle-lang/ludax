// checksum — one number that summarises the whole simulation state.
//
// The determinism check compares runs by this value. It folds in everything that matters: the clock, the
// purse, every enemy's kind, tile, hit points and position, every tower, every shot and effect, and the
// counters. Floating-point positions are rounded to thousandths of a tile first, so the hash does not depend
// on how a float is printed. The mix is ludax's `mixI64` and `combineHash`, applied in container order, which
// is the same on every run.

use ludax::{mixI64, combineHash};

use crate::sim::units::{Enemy, Tower, Shot, Fx};
use crate::sim::world::World;

/** Positions are folded in as thousandths of a tile, so the hash does not depend on float printing. */
const CHECKSUM_POSITION_SCALE : f32 = 1000.0;

/** The hash of `w`'s state. */
pub fn checksum(w : World) : i64 {
    let mut h : i64 = mixI64(w.seed as i64);
    h = combineHash(h, w.tick as i64);
    h = combineHash(h, w.gold as i64);
    h = combineHash(h, w.lives as i64);
    h = combineHash(h, w.score as i64);
    h = combineHash(h, w.kills as i64);
    h = combineHash(h, w.wave as i64);
    h = combineHash(h, w.countdown as i64);
    h = combineHash(h, w.cues.len() as i64);
    for (slot of 0..w.enemies.slotCount()) {
        if (w.enemies.isLiveAt(slot)) {
            h = combineHash(h, enemyHash(w.enemies.valueAt(slot)));
        }
    }
    for (slot of 0..w.towers.slotCount()) {
        if (w.towers.isLiveAt(slot)) {
            h = combineHash(h, towerHash(w.towers.valueAt(slot)));
        }
    }
    for (d of 0..w.shots.len()) {
        h = combineHash(h, shotHash(w.shots.valueAt(d)));
    }
    for (d of 0..w.fx.len()) {
        h = combineHash(h, fxHash(w.fx.valueAt(d)));
    }
    return h;
}

// A float as thousandths of a unit.
fn milli(v : f32) : i64 {
    return (v * CHECKSUM_POSITION_SCALE) as i64;
}

fn enemyHash(e : Enemy) : i64 {
    let mut h : i64 = combineHash(e.kind as i32 as i64, e.health as i64);
    h = combineHash(h, milli(e.pos.x));
    h = combineHash(h, milli(e.pos.y));
    h = combineHash(h, e.fromTile as i64);
    return combineHash(h, e.toTile as i64);
}

fn towerHash(t : Tower) : i64 {
    let h : i64 = combineHash(t.kind as i32 as i64, t.tile as i64);
    return combineHash(combineHash(h, t.level as i64), t.cooldown as i64);
}

fn shotHash(s : Shot) : i64 {
    let h : i64 = combineHash(milli(s.pos.x), milli(s.pos.y));
    return combineHash(h, s.damage as i64);
}

fn fxHash(f : Fx) : i64 {
    let h : i64 = combineHash(milli(f.pos.x), milli(f.pos.y));
    return combineHash(combineHash(h, milli(f.pos.z)), f.life as i64);
}

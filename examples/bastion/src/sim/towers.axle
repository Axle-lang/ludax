// towers — choosing a target and firing.
//
// Every tower counts its cooldown down, and when it is ready looks for the enemy in range that has walked
// farthest (the one closest to the base). A tower that finds one turns its head toward it, spends its
// cooldown and launches a homing shot. Ties go to the lower slot, so the choice never depends on anything but
// the state.

use ludax::{EntityId, Vec2, atan2};

use crate::audio::cues::Cue;
use crate::sim::config::SHOT_HEIGHT;
use crate::sim::grid::Grid;
use crate::sim::stats::{TowerKind, TowerStats, towerStats, enemyStats};
use crate::sim::units::{Tower, Shot, Enemy};
use crate::sim::world::World;

/** One tick for every tower. */
pub fn stepTowers(w : World) : void {
    for (slot of 0..w.towers.slotCount()) {
        if (w.towers.isLiveAt(slot)) {
            tick(w, w.towers.idAt(slot));
        }
    }
}

fn tick(w : World, id : EntityId) : void {
    let mut t : Tower = w.towers.get(id);
    t.sinceShot = t.sinceShot + 1;
    if (t.cooldown > 0) {
        t.cooldown = t.cooldown - 1;
        w.towers.set(id, t);
        return;
    }
    let stats : TowerStats = towerStats(t.kind, t.level);
    let centre : Vec2 = Grid::centerOf(t.tile);
    let target : EntityId = chooseTarget(w, centre, stats.range);
    if (target.isNone()) {
        w.towers.set(id, t);
        return;
    }
    let victim : Enemy = w.enemies.get(target);
    let toward : Vec2 = victim.pos.minus(centre);
    t.aim = atan2(toward.y, toward.x);
    t.cooldown = stats.cooldown;
    t.sinceShot = 0;
    w.towers.set(id, t);
    launch(w, t, stats, centre, target, victim.pos);
}

// The enemy in range that has walked farthest, or the none id.
fn chooseTarget(w : World, centre : Vec2, range : f32) : EntityId {
    let mut best : EntityId = EntityId::none();
    let mut bestWalked : f32 = -1.0;
    for (slot of 0..w.enemies.slotCount()) {
        if (!w.enemies.isLiveAt(slot)) {
            continue;
        }
        let e : Enemy = w.enemies.valueAt(slot);
        let reach : f32 = range + enemyStats(e.kind).radius;
        if (e.health > 0 && e.pos.distanceSquared(centre) <= reach * reach && e.walked > bestWalked) {
            bestWalked = e.walked;
            best = w.enemies.idAt(slot);
        }
    }
    return best;
}

// Creates the projectile and raises the sound for this tower design.
fn launch(w : World, t : Tower, stats : TowerStats, from : Vec2, target : EntityId, at : Vec2) : void {
    let key : EntityId = w.shotIds.create();
    w.shots.insert(key.index, Shot {
        kind: t.kind,
        pos: from,
        height: SHOT_HEIGHT,
        target: target,
        aimAt: at,
        startDistance: from.distance(at),
        damage: stats.damage,
        splash: stats.splash,
        slowPercent: stats.slowPercent,
        slowTicks: stats.slowTicks,
        speed: stats.shotSpeed,
    });
    w.raise(match t.kind {
        TowerKind::Arrow => Cue::ShootArrow,
        TowerKind::Cannon => Cue::ShootCannon,
        TowerKind::Frost => Cue::ShootFrost,
    });
}

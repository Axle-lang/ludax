// waves — composing a wave from a point budget with a seeded generator.
//
// A wave is a list of enemy kinds in spawn order plus the gap between spawns. The budget grows with the wave
// number; kinds unlock as waves go by (runners from wave 2, brutes from wave 4); every fifth wave ends with a
// boss. All choices come from the `Pcg32` handed in, so the same seed always composes the same waves, and the
// composition for wave n+1 can be drawn early to preview it without disturbing anything else.

use ludax::{Pcg32, Vec};

use crate::sim::config::MAX_WAVE_SIZE;
use crate::sim::stats::{EnemyKind, enemyStats};

/** First wave in which runners may appear. */
const WAVE_RUNNER_FROM : i32 = 2;

/** First wave in which brutes may appear. */
const WAVE_BRUTE_FROM : i32 = 4;

/** Every this many waves ends with a boss. */
const WAVE_BOSS_EVERY : i32 = 5;

/** Fastest spawn rhythm a wave may reach, in ticks between enemies. */
const MIN_SPAWN_GAP : i32 = 20;

/** The point budget a wave may spend. */
pub fn waveBudget(wave : i32) : i32 {
    return 12 + 8 * wave + wave * wave / 2;
}

/** Ticks between spawns in wave `wave`: waves arrive faster as they grow. */
pub fn spawnGapBase(wave : i32) : i32 {
    let mut gap : i32 = 54 - 2 * wave;
    if (gap < MIN_SPAWN_GAP) {
        gap = MIN_SPAWN_GAP;
    }
    return gap;
}

/** Writes the enemy kinds of wave `wave` into `out` (cleared first), in the order they appear. */
pub fn composeWave(wave : i32, rng : Pcg32, out : Vec<i32>) : void {
    out.clear();
    let mut budget : i32 = waveBudget(wave);
    if (wave % WAVE_BOSS_EVERY == 0) {
        budget = budget - enemyStats(EnemyKind::Boss).weight;
    }
    while (budget > 0 && out.len() < MAX_WAVE_SIZE) {
        let kind : EnemyKind = drawKind(wave, rng);
        let weight : i32 = enemyStats(kind).weight;
        if (weight > budget) {
            // Whatever is left buys grunts, so the budget is spent to the last point.
            if (budget < enemyStats(EnemyKind::Grunt).weight) {
                break;
            }
            out.push(EnemyKind::Grunt as i32);
            budget = budget - enemyStats(EnemyKind::Grunt).weight;
        } else {
            out.push(kind as i32);
            budget = budget - weight;
        }
    }
    if (wave % WAVE_BOSS_EVERY == 0) {
        out.push(EnemyKind::Boss as i32);
    }
}

// One weighted pick among the kinds unlocked at `wave`.
fn drawKind(wave : i32, rng : Pcg32) : EnemyKind {
    let roll : i32 = rng.range(0, 100);
    if (wave >= WAVE_BRUTE_FROM && roll < 14) {
        return EnemyKind::Brute;
    }
    if (wave >= WAVE_RUNNER_FROM && roll < 44) {
        return EnemyKind::Runner;
    }
    return EnemyKind::Grunt;
}

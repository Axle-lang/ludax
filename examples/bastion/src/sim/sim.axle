// sim — one tick of the simulation, in order.
//
// Waves release enemies, enemies walk, towers choose targets and fire, shots fly and land, the dead are paid
// out, effects age. The order is part of the rules: a shot fired this tick moves next tick, and a kill made
// this tick is paid before the next tower looks for a target.

use crate::app::probe::Probe;
use crate::sim::enemies::{stepEnemies, reapEnemies};
use crate::sim::fx::stepFx;
use crate::sim::shots::stepShots;
use crate::sim::towers::stepTowers;
use crate::sim::wave_clock::stepWaves;
use crate::sim::world::World;

/** Advances the run by one tick. Does nothing once the base has fallen. */
pub fn stepWorld(w : World) : void {
    if (w.lost) {
        return;
    }
    stepWaves(w);
    stepEnemies(w);
    stepTowers(w);
    stepShots(w);
    reapEnemies(w);
    stepFx(w);
    w.tick = w.tick + 1;
}

/** The same tick with each system timed by `probe` (a no-op cost while the profiler is off). */
pub fn stepWorldTimed(w : World, probe : Probe) : void {
    if (w.lost) {
        return;
    }
    let a : i32 = probe.profiler.begin(probe.waves);
    stepWaves(w);
    probe.profiler.end(a);
    let b : i32 = probe.profiler.begin(probe.enemies);
    stepEnemies(w);
    probe.profiler.end(b);
    let c : i32 = probe.profiler.begin(probe.towers);
    stepTowers(w);
    probe.profiler.end(c);
    let d : i32 = probe.profiler.begin(probe.shots);
    stepShots(w);
    reapEnemies(w);
    stepFx(w);
    probe.profiler.end(d);
    w.tick = w.tick + 1;
}

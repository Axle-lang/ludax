// grid — the tile map: which tiles are rock, which hold a tower, where the lane starts and ends.
//
// Tiles are numbered row by row (`z * GRID_W + x`) and everything else refers to them by that number. Two
// bit sets answer "can a walker enter this tile": `rocks` never change after the map is made, `blocked` is
// rocks plus towers and changes whenever the player builds or sells. Making a map is `mapgen.axle`'s job.

use ludax::{BitSet, Vec2};

use crate::sim::config::{GRID_W, GRID_H, LANE_ROW};

/** Offset from a tile's top-left corner to its middle, in world units. */
const TILE_CENTER : f32 = 0.5;

/** The tile map of one run. */
pub class Grid {
    rocks   : BitSet;
    blocked : BitSet;

    /** An open map with the lane's two ends marked and no rocks. */
    constructor() {
        self.rocks = new BitSet(GRID_W * GRID_H);
        self.blocked = new BitSet(GRID_W * GRID_H);
    }

    /** Number of tiles. */
    pub static fn tileCount() : i32 {
        return GRID_W * GRID_H;
    }

    /** The tile number of column `x`, row `z`. */
    pub static fn index(x : i32, z : i32) : i32 {
        return z * GRID_W + x;
    }

    /** Column of tile `t`. */
    pub static fn colOf(t : i32) : i32 {
        return t % GRID_W;
    }

    /** Row of tile `t`. */
    pub static fn rowOf(t : i32) : i32 {
        return t / GRID_W;
    }

    /** True when (`x`, `z`) lies on the map. */
    pub static fn inside(x : i32, z : i32) : bool {
        return x >= 0 && z >= 0 && x < GRID_W && z < GRID_H;
    }

    /** The tile where enemies appear. */
    pub static fn spawnTile() : i32 {
        return Grid::index(0, LANE_ROW);
    }

    /** The tile of the base, which enemies try to reach. */
    pub static fn goalTile() : i32 {
        return Grid::index(GRID_W - 1, LANE_ROW);
    }

    /** The world position (x, z) of the middle of tile `t`. */
    pub static fn centerOf(t : i32) : Vec2 {
        return Vec2::make(Grid::colOf(t) as f32 + TILE_CENTER, Grid::rowOf(t) as f32 + TILE_CENTER);
    }

    /** The tile under world position (`x`, `z`), or -1 off the map. */
    pub static fn tileAt(x : f32, z : f32) : i32 {
        if (x < 0.0 || z < 0.0) {
            return -1;
        }
        let col : i32 = x as i32;
        let row : i32 = z as i32;
        if (!Grid::inside(col, row)) {
            return -1;
        }
        return Grid::index(col, row);
    }

    /** True when walkers cannot enter tile `t` (rock or tower). */
    pub fn isBlocked(self, t : i32) : bool {
        return self.blocked.has(t);
    }

    /** True when tile `t` is a rock. */
    pub fn isRock(self, t : i32) : bool {
        return self.rocks.has(t);
    }

    /** The blocked set, for the pathfinder. */
    pub fn blockedSet(self) : BitSet {
        return self.blocked;
    }

    /** Marks or clears the tower block on tile `t`. */
    pub fn setTowerBlock(mut self, t : i32, on : bool) : void {
        if (on) {
            self.blocked.set(t);
        } else if (!self.rocks.has(t)) {
            self.blocked.unset(t);
        }
    }

    /** True when a tower may stand on `t`: on the map, not a rock, not the lane's two ends, nothing there. */
    pub fn isBuildable(self, t : i32) : bool {
        if (t < 0 || t >= Grid::tileCount()) {
            return false;
        }
        if (t == Grid::spawnTile() || t == Grid::goalTile()) {
            return false;
        }
        return !self.blocked.has(t);
    }

    /** Turns tile `t` into a rock. */
    pub fn placeRock(mut self, t : i32) : void {
        self.rocks.set(t);
        self.blocked.set(t);
    }

    /** Removes every rock (and every block with them). */
    pub fn clearRocks(mut self) : void {
        self.rocks.clearAll();
        self.blocked.clearAll();
    }

    /** True when a rock may lie on `t`: the lane's last two columns at either end stay clear of rocks. */
    pub static fn rockAllowed(t : i32) : bool {
        let x : i32 = Grid::colOf(t);
        let z : i32 = Grid::rowOf(t);
        if (x < 2 || x >= GRID_W - 2) {
            return z < LANE_ROW - 1 || z > LANE_ROW + 1;
        }
        return true;
    }
}

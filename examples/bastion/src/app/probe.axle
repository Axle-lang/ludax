// probe — the profiler and the names of the scopes the game times.
//
// The game brackets its frame stages and the simulation's systems with named scopes; the F3 overlay lists the
// costliest. Names are registered once here and carried as small integers, so timing a region costs a
// boolean test while the overlay is closed.

use ludax::{Profiler, ProfileNames};

/** Frames of history the profiler keeps. */
const PROBE_FRAMES : i32 = 4;

/** Samples one frame may record. */
const PROBE_SAMPLES : i32 = 256;

/** Most distinct scopes. */
const PROBE_SCOPES : i32 = 16;

/** The profiler and its scope names. */
pub class Probe {
    /** The profiler itself. */
    pub(crate) profiler : Profiler;

    /** The scope names. */
    pub(crate) names : ProfileNames;

    /** Scope: the whole frame body. */
    pub(crate) frame : i32 = 0;

    /** Scope: reading input. */
    pub(crate) input : i32 = 0;

    /** Scope: all simulation ticks of the frame. */
    pub(crate) sim : i32 = 0;

    /** Scope: wave spawning. */
    pub(crate) waves : i32 = 0;

    /** Scope: enemy movement and pathing. */
    pub(crate) enemies : i32 = 0;

    /** Scope: tower targeting. */
    pub(crate) towers : i32 = 0;

    /** Scope: shots and effects. */
    pub(crate) shots : i32 = 0;

    /** Scope: the 3-D pass. */
    pub(crate) scene : i32 = 0;

    /** Scope: the 2-D overlay. */
    pub(crate) overlay : i32 = 0;

    /** Scope: handing the frame to the window. */
    pub(crate) present : i32 = 0;

    /** A disabled profiler with every scope registered. */
    constructor() {
        self.profiler = new Profiler(PROBE_FRAMES, PROBE_SAMPLES, PROBE_SCOPES);
        self.names = new ProfileNames(PROBE_SCOPES);
        self.frame = self.names.id("frame");
        self.input = self.names.id("input");
        self.sim = self.names.id("sim");
        self.waves = self.names.id("sim.waves");
        self.enemies = self.names.id("sim.enemies+A*");
        self.towers = self.names.id("sim.towers");
        self.shots = self.names.id("sim.shots+fx");
        self.scene = self.names.id("draw.scene3d");
        self.overlay = self.names.id("draw.overlay");
        self.present = self.names.id("present");
    }
}

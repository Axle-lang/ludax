// pacing — the fake clock: how long each frame "took", chosen by us.
//
// The game loop never reads a clock; whoever drives it says how long the last frame lasted. Here a pacing is a
// sequence of frame lengths: pacing 0 is a steady 60 frames a second; any other number seeds an irregular one
// (2 to 45 ms, with a long hitch of 60 to 110 ms now and then, as a busy machine would give). The run must come
// out the same under all of them.
//
// The durations are integers of nanoseconds so the loop's fixed-step arithmetic sees exact values: a float
// millisecond converted back would leave bits that differ between pacings for no physical reason.

use ludax::Pcg32;

// The steady frame, and the irregular band: one frame in this many is a long hitch, drawn from its own range.
const PACING_STEADY_NS : i64 = 16666666;
const PACING_HITCH_ONE_IN : u32 = 40;
const PACING_HITCH_MIN_NS : i64 = 60000000;
const PACING_HITCH_SPAN_NS : u32 = 50000000;
const PACING_FRAME_MIN_NS : i64 = 2000000;
const PACING_FRAME_SPAN_NS : u32 = 43000000;

/** A source of frame durations. */
pub class FrameClock {
    kind : i32 = 0;
    rng  : Pcg32;

    /** Pacing `kind`: 0 steady, anything else a seed for irregular frames. */
    constructor(kind : i32) {
        self.kind = kind;
        self.rng = new Pcg32(kind as u64, 7);
    }

    /** The length of the next frame in nanoseconds. */
    pub fn next(mut self) : i64 {
        if (self.kind == 0) {
            return PACING_STEADY_NS;
        }
        if (self.rng.nextBelow(PACING_HITCH_ONE_IN) == 0) {
            return PACING_HITCH_MIN_NS + self.rng.nextBelow(PACING_HITCH_SPAN_NS) as i64;
        }
        return PACING_FRAME_MIN_NS + self.rng.nextBelow(PACING_FRAME_SPAN_NS) as i64;
    }
}

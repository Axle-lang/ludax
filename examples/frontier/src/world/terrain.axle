// terrain — the frontier's ground: rolling hills made of a few sine waves.
//
// The openworld module wants one thing from a terrain, `GroundHeight`: a height for any (x, z). This one is a
// closed formula (hills, a long swell and a slow tilt), so it needs no storage and is exactly the same
// everywhere, which is what a 100 km world wants from its ground. `sinD` is the engine's own, not libm's, so
// every machine agrees to the last bit.
//
// The three terms are deliberately at different scales: the swell gives thousand-metre country, the hills a
// local roll the car can feel, and the tilt keeps the far horizon from being a flat line.

use ludax::{GroundHeight, sinD, cosD};

// The long swell, the local hills, and the linear tilt that keeps one side of the map high.
const TERRAIN_SWELL_AMP : f64 = 5.0;
const TERRAIN_SWELL_X : f64 = 170.0;
const TERRAIN_SWELL_Z : f64 = 210.0;
const TERRAIN_HILL_AMP : f64 = 2.2;
const TERRAIN_HILL_X : f64 = 47.0;
const TERRAIN_HILL_Z : f64 = 61.0;
const TERRAIN_TILT_X : f64 = 0.004;
const TERRAIN_TILT_Z : f64 = 0.002;

/** Hills for the frontier. */
pub class FrontierTerrain : GroundHeight {
    /** The rolling country. */
    constructor() {}

    /** Height at (`x`, `z`) in metres, between about -9 and 14. */
    pub fn heightAt(self, x : f64, z : f64) : f64 {
        let swell : f64 = TERRAIN_SWELL_AMP * sinD(x / TERRAIN_SWELL_X) * cosD(z / TERRAIN_SWELL_Z);
        let hills : f64 = TERRAIN_HILL_AMP * sinD(x / TERRAIN_HILL_X + z / TERRAIN_HILL_Z);
        let tilt : f64 = TERRAIN_TILT_X * x - TERRAIN_TILT_Z * z;
        return swell + hills + tilt;
    }
}

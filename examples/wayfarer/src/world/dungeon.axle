// dungeon — a generated map of rooms joined by corridors, as a `GridMap`.
//
// Rooms are dropped at random places without overlapping (a wall's width apart), carved out of solid rock,
// and each is joined to the one before it by an L-shaped corridor two cells wide, so two agents can pass in
// one. A few rooms get a patch of mud (cost 4) that the path finder prefers to walk round. Everything comes from
// one `Pcg32` seed, so a seed is a map.
//
// Generation is rejection sampling with a cap rather than a guarantee: a width or height too small for its
// random window leaves the room unscheduled, and the loop stops after a fixed number of tries. That keeps a
// bad seed from hanging and makes the room count a lower bound the checks can rely on.

use ludax::{GridMap, Pcg32, Vec};

// How many rooms to try for each one wanted, and the range their sides are drawn from.
const DUNGEON_TRIES_PER_ROOM : i32 = 40;
const DUNGEON_MIN_W : i32 = 5;
const DUNGEON_MAX_W : i32 = 11;
const DUNGEON_MIN_H : i32 = 5;
const DUNGEON_MAX_H : i32 = 10;

// Cells kept free round the map, cells kept between two rooms (a wall each side), corridor width, and mud cost.
const DUNGEON_EDGE : i32 = 2;
const DUNGEON_GAP : i32 = 2;
const DUNGEON_CORRIDOR : i32 = 2;
const DUNGEON_MUD_COST : i32 = 4;

// One room in this many gets mud, over the top-left half of its cells.
const DUNGEON_MUD_ONE_IN : i32 = 3;

// The seed stream: a second dungeon from the same seed differs only when this does.
const DUNGEON_STREAM : u64 = 17;

/** A rectangle of cells: where a room is. */
pub struct Room {
    /** Column of the left cell. */
    pub x : i32 = 0;

    /** Row of the top cell. */
    pub y : i32 = 0;

    /** Width in cells. */
    pub w : i32 = 1;

    /** Height in cells. */
    pub h : i32 = 1;
}

/** The map, and the rooms it was made of. */
pub class Dungeon {
    grid  : GridMap;
    rooms : Vec<Room>;

    /** Generates a `width` x `height` dungeon of up to `roomCount` rooms from `seed`. */
    constructor(width : i32, height : i32, roomCount : i32, seed : u64) {
        self.grid = new GridMap(width, height);
        self.rooms = new Vec<Room>();
        for (y of 0..height) {
            for (x of 0..width) {
                self.grid.setBlocked(x, y, true);
            }
        }

        // Place rooms until enough fit or the tries run out.
        let mut rng : Pcg32 = new Pcg32(seed, DUNGEON_STREAM);
        let mut tries : i32 = 0;
        while (self.rooms.len() < roomCount && tries < roomCount * DUNGEON_TRIES_PER_ROOM) {
            tries = tries + 1;
            let w : i32 = rng.range(DUNGEON_MIN_W, DUNGEON_MAX_W);
            let h : i32 = rng.range(DUNGEON_MIN_H, DUNGEON_MAX_H);
            let x : i32 = rng.range(DUNGEON_EDGE, width - w - DUNGEON_EDGE);
            let y : i32 = rng.range(DUNGEON_EDGE, height - h - DUNGEON_EDGE);
            if (self.overlaps(x, y, w, h)) {
                continue;
            }
            self.rooms.push(Room { x: x, y: y, w: w, h: h });
            self.carve(x, y, w, h);
        }

        // Join each room to its predecessor; the random order makes the corridor an L one way or the other.
        for (i of 1..self.rooms.len()) {
            self.join(self.rooms.get(i - 1), self.rooms.get(i), rng.nextBool());
        }

        for (i of 0..self.rooms.len()) {
            if (rng.range(0, DUNGEON_MUD_ONE_IN) == 0) {
                let r : Room = self.rooms.get(i);
                self.mud(r.x + 1, r.y + 1, r.w / 2, r.h / 2);
            }
        }
    }

    /** The grid map. */
    pub fn map(self) : GridMap {
        return self.grid;
    }

    /** How many rooms were placed. */
    pub fn roomCount(self) : i32 {
        return self.rooms.len();
    }

    /** The room `i`. */
    pub fn room(self, i : i32) : Room {
        return self.rooms.get(i);
    }

    /** The column of the middle of room `i`. */
    pub fn centerX(self, i : i32) : i32 {
        let r : Room = self.rooms.get(i);
        return r.x + r.w / 2;
    }

    /** The row of the middle of room `i`. */
    pub fn centerY(self, i : i32) : i32 {
        let r : Room = self.rooms.get(i);
        return r.y + r.h / 2;
    }

    // True when the rectangle, grown by a wall's width, touches a room already placed.
    fn overlaps(self, x : i32, y : i32, w : i32, h : i32) : bool {
        for (i of 0..self.rooms.len()) {
            let r : Room = self.rooms.get(i);
            if (x < r.x + r.w + DUNGEON_GAP && x + w + DUNGEON_GAP > r.x && y < r.y + r.h + DUNGEON_GAP
                && y + h + DUNGEON_GAP > r.y) {
                return true;
            }
        }
        return false;
    }

    fn carve(mut self, x : i32, y : i32, w : i32, h : i32) : void {
        for (cy of y..(y + h)) {
            for (cx of x..(x + w)) {
                self.grid.setBlocked(cx, cy, false);
            }
        }
    }

    fn mud(mut self, x : i32, y : i32, w : i32, h : i32) : void {
        for (cy of y..(y + h)) {
            for (cx of x..(x + w)) {
                self.grid.setCost(cx, cy, DUNGEON_MUD_COST);
            }
        }
    }

    // A corridor from the middle of `a` to the middle of `b`: along the row first or along the column first.
    fn join(mut self, a : Room, b : Room, alongRow : bool) : void {
        let ax : i32 = a.x + a.w / 2;
        let ay : i32 = a.y + a.h / 2;
        let bx : i32 = b.x + b.w / 2;
        let by : i32 = b.y + b.h / 2;
        if (alongRow) {
            self.stripRow(ax, bx, ay);
            self.stripColumn(ay, by, bx);
        } else {
            self.stripColumn(ay, by, ax);
            self.stripRow(ax, bx, by);
        }
    }

    // A two-cell-wide horizontal strip from `fromX` to `toX` on row `y`.
    fn stripRow(mut self, fromX : i32, toX : i32, y : i32) : void {
        let mut lo : i32 = fromX;
        let mut hi : i32 = toX;
        if (toX < fromX) {
            lo = toX;
            hi = fromX;
        }
        for (x of lo..(hi + 1)) {
            for (w of 0..DUNGEON_CORRIDOR) {
                self.grid.setBlocked(x, y + w, false);
            }
        }
    }

    // A two-cell-wide vertical strip from `fromY` to `toY` in column `x`.
    fn stripColumn(mut self, fromY : i32, toY : i32, x : i32) : void {
        let mut lo : i32 = fromY;
        let mut hi : i32 = toY;
        if (toY < fromY) {
            lo = toY;
            hi = fromY;
        }
        for (y of lo..(hi + 1)) {
            for (w of 0..DUNGEON_CORRIDOR) {
                self.grid.setBlocked(x + w, y, false);
            }
        }
    }
}

// waveform — draws a stereo clip as two stacked waveforms with a time grid and the scene's landmarks.
//
// One pixel column covers a run of frames; the column shows the lowest and highest sample in that run. The left
// channel is the top half and the right channel the bottom half, so a sound passing from left to right is seen
// moving from one half to the other.
//
// The landmarks are the moments the script in `scene` acts at: the crossfade of the two pads, and the siren's
// closest pass and the bell flurry. They are named here because moving them without moving the script would be
// a lie in the picture, not merely a styling choice.

use ludax::AudioClip;

use crate::gfx::canvas::{Canvas, Shade};

/** Picture width in pixels. */
pub const WAVE_WIDTH : i32 = 1200;

/** Picture height in pixels. */
pub const WAVE_HEIGHT : i32 = 400;

/** A panel's waveform keeps this many pixels clear of its centre line, so peaks do not touch. */
const WAVE_PANEL_INSET : i32 = 4;

/** The colour of the crossfade region, behind both channels. */
const WAVE_FADE_FROM_SECONDS : f32 = 3.0;

/** The crossfade ends here, seconds. */
const WAVE_FADE_TO_SECONDS : f32 = 4.0;

/** The siren's closest pass, seconds. */
const WAVE_PASS_SECONDS : f32 = 3.0;

/** The bell flurry, seconds. */
const WAVE_BURST_SECONDS : f32 = 4.5;

/** Draws waveform pictures. */
pub class Waveform {
    // One panel of the picture: the samples of `channel` between pixel rows `top` and `bottom`.
    static fn panel(
        canvas : Canvas,
        clip : AudioClip,
        channel : i32,
        top : i32,
        bottom : i32,
        shade : Shade
    ) : void {
        let mid : i32 = (top + bottom) / 2;
        let half : i32 = (bottom - top) / 2 - WAVE_PANEL_INSET;
        let axis : Shade = Shade { r: 90, g: 96, b: 110, alpha: 200 };
        canvas.rect(0, mid, WAVE_WIDTH - 1, mid, axis);

        for (x of 0..WAVE_WIDTH) {
            let from : i32 = (x as i64 * clip.frames as i64 / WAVE_WIDTH as i64) as i32;
            let to : i32 = ((x + 1) as i64 * clip.frames as i64 / WAVE_WIDTH as i64) as i32;
            let mut lo : f32 = 0.0;
            let mut hi : f32 = 0.0;
            for (i of from..to) {
                let v : f32 = clip.samples[(i * clip.channels + channel) as i64];
                if (v < lo) {
                    lo = v;
                }
                if (v > hi) {
                    hi = v;
                }
            }

            let y0 : i32 = mid - (hi * (half as f32)) as i32;
            let y1 : i32 = mid - (lo * (half as f32)) as i32;
            canvas.rect(x, y0, x, y1 + 1, shade);
        }
    }

    // A vertical line at `seconds`.
    static fn marker(canvas : Canvas, seconds : f32, total : f32, shade : Shade) : void {
        let x : i32 = (seconds / total * (WAVE_WIDTH as f32)) as i32;
        canvas.rect(x, 0, x, WAVE_HEIGHT - 1, shade);
    }

    /** The picture of `clip` (stereo): grid every second, the music crossfade tinted, the siren's closest pass and the bell burst marked. */
    pub static fn draw(clip : AudioClip) : Canvas {
        let background : Shade = Shade { r: 22, g: 24, b: 32, alpha: 255 };
        let mut canvas : Canvas = new Canvas(WAVE_WIDTH, WAVE_HEIGHT, background);
        let total : f32 = clip.seconds();

        // The crossfade between the two pads, 3 s to 4 s.
        let fade : Shade = Shade { r: 120, g: 90, b: 200, alpha: 50 };
        let fadeFrom : i32 = (WAVE_FADE_FROM_SECONDS / total * (WAVE_WIDTH as f32)) as i32;
        let fadeTo : i32 = (WAVE_FADE_TO_SECONDS / total * (WAVE_WIDTH as f32)) as i32;
        canvas.rect(fadeFrom, 0, fadeTo, WAVE_HEIGHT - 1, fade);

        let grid : Shade = Shade { r: 255, g: 255, b: 255, alpha: 28 };
        let gridEnd : i32 = total as i32;
        for (s of 1..gridEnd) {
            Waveform::marker(canvas, s as f32, total, grid);
        }

        let left : Shade = Shade { r: 110, g: 200, b: 255, alpha: 255 };
        let right : Shade = Shade { r: 255, g: 170, b: 110, alpha: 255 };
        Waveform::panel(canvas, clip, 0, 0, WAVE_HEIGHT / 2, left);
        Waveform::panel(canvas, clip, 1, WAVE_HEIGHT / 2, WAVE_HEIGHT, right);

        let pass : Shade = Shade { r: 255, g: 230, b: 90, alpha: 200 };
        let burst : Shade = Shade { r: 255, g: 90, b: 90, alpha: 200 };
        Waveform::marker(canvas, WAVE_PASS_SECONDS, total, pass);
        Waveform::marker(canvas, WAVE_BURST_SECONDS, total, burst);
        return canvas;
    }
}

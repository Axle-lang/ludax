// canvas — an RGB pixel buffer with the few drawing operations the waveform picture needs, and a PNG writer.
//
// The PNG is written with stored (uncompressed) deflate blocks: no compressor is needed and every viewer reads
// it. The picture is small, so the size does not matter.
//
// A colour is a `Shade` rather than a run of four numbers, because `rect(…, 255, 255, 255, 28)` says nothing
// about which number is the opacity.

use ludax::{DataFiles, Image};

/** Bytes per pixel: red, green and blue, no alpha in the buffer. */
const CANVAS_CHANNELS : i32 = 3;

/** The largest channel value, 8 bits. */
const CANVAS_CHANNEL_MAX : i32 = 255;

/** Opacity is counted in this many steps, so `alpha = 0` keeps the old pixel and `alpha = 256` replaces it. */
const CANVAS_OPACITY_FULL : i32 = 256;

/** A colour and how strongly it covers what is already there. */
pub struct Shade {
    /** Red, 0 to 255. */
    pub r : i32 = 0;

    /** Green, 0 to 255. */
    pub g : i32 = 0;

    /** Blue, 0 to 255. */
    pub b : i32 = 0;

    /** Coverage out of 256; an opaque pixel is `CANVAS_OPACITY_FULL`. */
    pub alpha : i32 = 0;
}

/** A width x height image of 8-bit RGB pixels. */
pub class Canvas {
    /** Width in pixels. */
    pub width : i32 = 1;

    /** Height in pixels. */
    pub height : i32 = 1;

    pixels : i8[];

    /** A canvas filled with one colour. */
    constructor(w : i32, h : i32, shade : Shade) {
        self.width = w;
        self.height = h;
        let mut buf : i8[] = malloc<i8>((w * h * CANVAS_CHANNELS + 1) as i64);
        for (i of 0..w * h) {
            buf[(i * CANVAS_CHANNELS) as i64] = shade.r as i8;
            buf[(i * CANVAS_CHANNELS + 1) as i64] = shade.g as i8;
            buf[(i * CANVAS_CHANNELS + 2) as i64] = shade.b as i8;
        }
        self.pixels = buf;
    }

    /** Blends `shade` over the pixel at (x, y); off-canvas is ignored. */
    pub fn blend(mut self, x : i32, y : i32, shade : Shade) : void {
        if (x < 0 || y < 0 || x >= self.width || y >= self.height) {
            return;
        }

        let at : i32 = (y * self.width + x) * CANVAS_CHANNELS;
        let r : i32 = (self.pixels[at as i64] as i32) & CANVAS_CHANNEL_MAX;
        let g : i32 = (self.pixels[(at + 1) as i64] as i32) & CANVAS_CHANNEL_MAX;
        let b : i32 = (self.pixels[(at + 2) as i64] as i32) & CANVAS_CHANNEL_MAX;
        let keep : i32 = CANVAS_OPACITY_FULL - shade.alpha;

        self.pixels[at as i64] = ((r * keep + shade.r * shade.alpha) / CANVAS_OPACITY_FULL) as i8;
        self.pixels[(at + 1) as i64] = ((g * keep + shade.g * shade.alpha) / CANVAS_OPACITY_FULL) as i8;
        self.pixels[(at + 2) as i64] = ((b * keep + shade.b * shade.alpha) / CANVAS_OPACITY_FULL) as i8;
    }

    /** A filled rectangle (x0..x1, y0..y1 inclusive). */
    pub fn rect(mut self, x0 : i32, y0 : i32, x1 : i32, y1 : i32, shade : Shade) : void {
        for (y of y0..y1 + 1) {
            for (x of x0..x1 + 1) {
                self.blend(x, y, shade);
            }
        }
    }

    // ---- PNG ---------------------------------------------------------------------------------------------

    /** Writes the canvas as a PNG file with the library's encoder; returns "" on success, else a message. */
    pub fn savePng(self, path : string) : string {
        let mut img : Image = new Image(self.width, self.height);
        for (y of 0..self.height) {
            for (x of 0..self.width) {
                let at : i32 = (y * self.width + x) * CANVAS_CHANNELS;
                let r : i32 = (self.pixels[at] as i32) & CANVAS_CHANNEL_MAX;
                let g : i32 = (self.pixels[at + 1] as i32) & CANVAS_CHANNEL_MAX;
                let b : i32 = (self.pixels[at + 2] as i32) & CANVAS_CHANNEL_MAX;
                img.set(x, y, Image::pack(r, g, b, CANVAS_CHANNEL_MAX));
            }
        }

        try {
            DataFiles::savePng(path, img);
            return "";
        } catch e : IOException {
            return e.message;
        }
    }
}

// terrain_params — every number that shapes a HydroTerrain, with the default that reads as a real landscape.
//
// One world, one convention: one unit is one metre, x runs east along the width, z runs south along the depth, y
// (the height) is metres above the surface of the downstream lake (`outflowLevel`). The river flows toward +z:
// the mountains and the reservoir lie in the north (small z), the waterfall is a little past the first third of
// the depth, the meanders and the floodplain fill the south, and the downstream lake closes the south edge.
//
// A struct of plain numbers so a scene can write `TerrainParams { riverWidth: 40.0 }` and keep every other default.
// The defaults are chosen together: they make a 4 km square at 4 m a cell (a 1024 x 1024 grid), a 50 m
// waterfall, a 26 m wide river with a 1.6 sinuosity and peaks 480 m above the reservoir. Changing one number
// changes the picture but `isConsistentForWater` still holds for every sane combination: the generator derives
// the heights of the lake, the foot of the fall and the river from them rather than taking them separately.

/** What a landscape is made of. All lengths are metres, all slopes metres per metre. */
pub struct TerrainParams {
    /** Side of the square world, metres. Must be a multiple of `cellSize`. */
    pub worldSize : f32 = 4096.0;

    /** Side of a grid cell, metres. The fluid grid has one column per cell. */
    pub cellSize : f32 = 4.0;

    /** Height of the highest peaks above the surface of the reservoir, metres. */
    pub mountainHeight : f32 = 480.0;

    /** How knife-edged the ridges are, 0 (rounded hills) to 1 (arêtes). */
    pub ridgeSharpness : f32 = 0.65;

    /** Surface area of the reservoir, square metres. */
    pub lakeArea : f32 = 360000.0;

    /** Depth of the reservoir at its deepest, metres. */
    pub lakeDepth : f32 = 14.0;

    /** Height of the caprock escarpment (the waterfall), metres. */
    pub escarpmentHeight : f32 = 50.0;

    /** How vertical the face is, 0 (a gentle scarp) to 1 (a cliff one cell thick). */
    pub escarpmentSharpness : f32 = 0.92;

    /** Width of the notch the river leaves the lake through, metres. */
    pub lipNotchWidth : f32 = 36.0;

    /** Width of the river between its banks, metres. */
    pub riverWidth : f32 = 26.0;

    /** Depth of the river at the middle of a straight reach, metres. */
    pub riverDepth : f32 = 2.2;

    /** Arc length over valley length of the river, at least 1 (a straight river). */
    pub sinuosity : f32 = 1.6;

    /** Distance along the valley of one full meander, metres. */
    pub meanderWavelength : f32 = 780.0;

    /** Fall of the valley floor, metres per metre, below the waterfall (a few metres per kilometre). */
    pub riverSlope : f32 = 0.0022;

    /** Width of the flat floodplain the river wanders on, metres. */
    pub floodplainWidth : f32 = 640.0;

    /** Depth of the plunge pool below the river bed downstream of it, metres. */
    pub plungePoolDepth : f32 = 9.0;

    /** Radius of the plunge pool, metres. */
    pub plungePoolRadius : f32 = 42.0;

    /** Level of the downstream lake's surface, metres: the datum everything is measured from. */
    pub outflowLevel : f32 = 8.0;

    /** How much the hillsides are eroded, 0 (raw noise) to 1 (deep gullies). */
    pub erosionStrength : f32 = 0.5;
}

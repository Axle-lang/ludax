// hydro_parts — the plain records that describe the water of a HydroTerrain.
//
// The height grid says where the ground is; these say what the water does on it: where the river runs, how wide
// and deep it is, where the reservoir spills, where the escarpment's crest and lip are, where the pool at its
// foot lies, where a stream feeds the lake and where the water leaves the world. All are `struct`s of numbers in
// the terrain's own units (metres, y up), copied freely, so the fluid engine and the renderer can read them
// without knowing how they were made.

/** A place on the ground: where, and the height of the ground there. */
pub struct HydroSpot {
    /** East coordinate, metres. */
    pub x : f32 = 0.0;

    /** South coordinate, metres. */
    pub z : f32 = 0.0;

    /** Height of the ground, metres. */
    pub height : f32 = 0.0;
}

/** One point of the river's centreline. Consecutive points are about one cell apart and the river flows toward higher indices. */
pub struct RiverPoint {
    /** East coordinate of the centreline, metres. */
    pub x : f32 = 0.0;

    /** South coordinate of the centreline, metres. */
    pub z : f32 = 0.0;

    /** Distance along the river from its first point, metres. */
    pub arc : f32 = 0.0;

    /** Unit flow direction, east component. */
    pub dirX : f32 = 0.0;

    /** Unit flow direction, south component. */
    pub dirZ : f32 = 1.0;

    /** Signed curvature, 1/metres: positive when the river turns toward its left (the outside bank is on the right). */
    pub curvature : f32 = 0.0;

    /** Width between the banks, metres. */
    pub width : f32 = 0.0;

    /** Depth from the bank top down to the deepest bed of the section, metres. */
    pub depth : f32 = 0.0;

    /** Height of the bank tops (the floodplain surface beside the channel), metres. */
    pub bankHeight : f32 = 0.0;

    /** Height of the deepest bed of the section, metres. */
    pub bedHeight : f32 = 0.0;
}

/** The reservoir the river leaves. */
pub struct HydroLake {
    /** Height of the surface when full, which is the height of the lowest point of the rim, metres. */
    pub level : f32 = 0.0;

    /** The lowest point of the rim: the lip of the waterfall. */
    pub spill : HydroSpot = HydroSpot {};

    /** Middle of the basin. */
    pub center : HydroSpot = HydroSpot {};

    /** Number of cells of the basin below the level, connected to its middle. */
    pub cells : i32 = 0;

    /** Water held when full, cubic metres, measured by flood fill of the grid. */
    pub volume : f32 = 0.0;

    /** Surface area when full, square metres. */
    pub area : f32 = 0.0;
}

/** The caprock escarpment the river falls over. */
pub struct HydroEscarpment {
    /** Height of the crest at the lip, metres. */
    pub crestHeight : f32 = 0.0;

    /** Height of the ground at the foot of the face below the lip, metres. */
    pub footHeight : f32 = 0.0;

    /** The drop, crest minus foot, metres. */
    pub fall : f32 = 0.0;

    /** The lip: where the river leaves the crest. */
    pub lip : HydroSpot = HydroSpot {};

    /** Width of the notch at the lip, metres. */
    pub lipWidth : f32 = 0.0;

    /** Horizontal run of the face from crest to foot, metres: the sharper, the shorter. */
    pub faceRun : f32 = 0.0;
}

/** The pool the fall digs at its foot. */
pub struct HydroPool {
    /** Middle of the pool, with the height of its deepest bed. */
    pub center : HydroSpot = HydroSpot {};

    /** Radius at the rim, metres. */
    pub radius : f32 = 0.0;

    /** Height of the surface the pool holds (the bank level of the river's first reach), metres. */
    pub level : f32 = 0.0;

    /** Depth below `level` at the middle, metres. */
    pub depth : f32 = 0.0;
}

/** A stream that feeds the lake. */
pub struct HydroInflow {
    /** Where the stream reaches the lake shore, with the ground height there. */
    pub at : HydroSpot = HydroSpot {};

    /** Suggested discharge, cubic metres a second: what the river below carries in a steady state. */
    pub discharge : f32 = 0.0;
}

/** Where the water leaves the world: the downstream lake. */
pub struct HydroOutflow {
    /** Middle of the end of the river, at the south edge, with the height of the bed there. */
    pub at : HydroSpot = HydroSpot {};

    /** Height of the surface of the downstream lake, metres. */
    pub level : f32 = 0.0;

    /** First row (in cells) from which the river's bed is below `level`: the lake's shore at the river. */
    pub shoreRow : i32 = 0;
}

/** A side stream that joins the river across the floodplain. */
pub struct HydroTributary {
    /** Where its gully leaves the hills, with the ground height there. */
    pub mouth : HydroSpot = HydroSpot {};

    /** Where it joins the river, with the height of the bank there. */
    pub confluence : HydroSpot = HydroSpot {};

    /** Area of the hills it drains, square metres. */
    pub catchment : f32 = 0.0;

    /** Suggested discharge, cubic metres a second: the same runoff per area as the reservoir's streams. */
    pub discharge : f32 = 0.0;
}

/** A hollow that holds water on its own: an oxbow lake or a kettle. */
pub struct HydroPuddle {
    /** The deepest point. */
    pub at : HydroSpot = HydroSpot {};

    /** Height the hollow fills to before it spills, metres. */
    pub level : f32 = 0.0;

    /** Water held when full, cubic metres. */
    pub volume : f32 = 0.0;
}

/** What `isConsistentForWater` measured, and the first claim that failed. */
pub class HydroReport {
    /** True when every claim held. */
    pub passed : bool = true;

    /** The first claim that failed, or empty. */
    pub problem : string = "";

    /** Grid cells that are not finite numbers. */
    pub badCells : i32 = 0;

    /** River arc length over the straight distance between its ends. */
    pub sinuosity : f32 = 0.0;

    /** River arc length, metres. */
    pub riverLength : f32 = 0.0;

    /** Mean fall of the river bed per metre of channel. */
    pub riverSlope : f32 = 0.0;

    /** The largest rise of the bed from one river point to the next, metres (never positive when the river descends). */
    pub worstRise : f32 = 0.0;

    /** River points whose grid height is not below the bank by at least half the depth. */
    pub shallowPoints : i32 = 0;

    /** Height of the cliff measured on the grid, from the crest to the apron beside the pool, metres. */
    pub fall : f32 = 0.0;

    /** Spill level of the reservoir found by flood fill, metres. */
    pub spillLevel : f32 = 0.0;

    /** True when a flood fill a centimetre under the spill level does not escape. */
    pub lakeClosed : bool = false;

    /** True when a flood fill a decimetre above it does escape. */
    pub lakeSpills : bool = false;

    /** Water the reservoir holds when full, cubic metres. */
    pub lakeVolume : f32 = 0.0;

    /** Largest fall of the ground between two adjacent grid cells along the lip's line across the face, metres. */
    pub cellDrop : f32 = 0.0;

    /** Largest fall between two points a metre apart on the face, measured with `bedAt`, metres. */
    pub metreDrop : f32 = 0.0;

    /** Share of the whole drop that happens within four metres of horizontal run below the crest, 0 to 1. */
    pub faceShare : f32 = 0.0;

    /** Cells of the hills (not the lake, the floodplain or the border) with no lower neighbour: unintended basins. */
    pub pits : i32 = 0;
}

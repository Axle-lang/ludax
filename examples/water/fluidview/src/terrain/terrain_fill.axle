// terrain_fill — pit filling with proper drainage, so no unintended basin is left in the hills.
//
// Noise and erosion leave small closed hollows in the hillsides: cells with no lower neighbour, where a drop of rain
// would stop and a shallow-water solver would grow a puddle nobody asked for. This is the priority-flood of Barnes,
// Lehman and Mulla: start from the outlets (the border of the grid, and every cell the erosion leaves alone, which are
// the floodplain, the reservoir and its rim, and the cap rock) and grow inward always from the lowest cell, raising each
// newly reached cell to at least a hair above the cell it was reached from. What was a pit becomes a tilted flat that
// drains to its outlet; nothing is lowered, and cells that already drained are not touched.
//
// The queue is buckets of heights a few millimetres wide, so the whole pass is linear in the number of cells and its
// order is arithmetic (a bucket is a stack, cells are pushed in a fixed scan order): the same bytes on every machine.

// Height step of a bucket, metres, the number of buckets (the highest ground the fill handles is about 650 m above the
// lowest), and the tilt a filled flat gets per cell, metres.
const FILL_BUCKET : f32 = 0.0025;
const FILL_BUCKETS : i32 = 262144;
const FILL_TILT : f32 = 0.004;

/** The pit filler. */
pub class TerrainFill {
    /**
     * Fills the pits of `bed` (`width` columns, `depth` rows). Cells with `soft` under 0.05 and the border are outlets.
     * `heads` (`FILL_BUCKETS` entries) and `next` (one per cell) are scratch, `seen` (one per cell) is scratch too.
     */
    pub static fn run(
        bed : f32[],
        soft : f32[],
        width : i32,
        depth : i32,
        heads : i32[],
        next : i32[],
        seen : u8[]
    ) : void {
        let count : i64 = (width as i64) * (depth as i64);
        let mut base : f32 = bed[0];
        for (c of 0..count) {
            if (bed[c] < base) {
                base = bed[c];
            }
            seen[c] = 0;
        }
        for (k of 0..FILL_BUCKETS) {
            heads[k as i64] = -1;
        }
        for (c of 0..count) {
            let col : i32 = (c % (width as i64)) as i32;
            let row : i32 = (c / (width as i64)) as i32;
            let edge : bool = col == 0 || row == 0 || col == width - 1 || row == depth - 1;
            if (edge || soft[c] < 0.05 as f32) {
                TerrainFill::push(bed, base, c, heads, next, seen);
            }
        }

        let mut at : i32 = 0;
        while (at < FILL_BUCKETS) {
            let c : i64 = heads[at as i64] as i64;
            if (c < 0) {
                at = at + 1;
                continue;
            }
            heads[at as i64] = next[c];
            let col : i32 = (c % (width as i64)) as i32;
            let row : i32 = (c / (width as i64)) as i32;
            for (dz of -1..2) {
                for (dx of -1..2) {
                    let x : i32 = col + dx;
                    let z : i32 = row + dz;
                    if (x < 0 || z < 0 || x >= width || z >= depth) {
                        continue;
                    }
                    let n : i64 = (z as i64) * (width as i64) + (x as i64);
                    if (seen[n] != (0 as u8)) {
                        continue;
                    }
                    if (bed[n] < bed[c] + FILL_TILT) {
                        bed[n] = bed[c] + FILL_TILT;
                    }
                    TerrainFill::push(bed, base, n, heads, next, seen);
                }
            }
        }
    }

    // Queues cell `c` in the bucket of its height.
    static fn push(bed : f32[], base : f32, c : i64, heads : i32[], next : i32[], seen : u8[]) : void {
        seen[c] = 1;
        let mut key : i32 = ((bed[c] - base) / FILL_BUCKET) as i32;
        if (key < 0) {
            key = 0;
        }
        if (key >= FILL_BUCKETS) {
            key = FILL_BUCKETS - 1;
        }
        next[c] = heads[key as i64];
        heads[key as i64] = c as i32;
    }

    /**
     * Counts the cells with no lower neighbour that `soft` says may erode (hills), border excluded. Cells within reach of
     * the river (`along` not negative) are skipped: its channel is deliberately a trough, and the cells of a grid sampled across
     * it have small bumps that the water simply covers.
     */
    pub static fn pits(bed : f32[], soft : f32[], along : f32[], width : i32, depth : i32) : i32 {
        let mut count : i32 = 0;
        for (j of 1..(depth - 1)) {
            for (i of 1..(width - 1)) {
                let c : i64 = (j as i64) * (width as i64) + (i as i64);
                if (soft[c] < 0.05 as f32 || along[c] >= 0.0 as f32) {
                    continue;
                }
                let mut lower : bool = false;
                for (dz of -1..2) {
                    for (dx of -1..2) {
                        let n : i64 = ((j + dz) as i64) * (width as i64) + ((i + dx) as i64);
                        if (bed[n] < bed[c]) {
                            lower = true;
                        }
                    }
                }
                if (!lower) {
                    count = count + 1;
                }
            }
        }
        return count;
    }
}

// terrain_sample — the ground at any position and any resolution, for a scene that wants a finer water grid than the terrain's.
//
// The stored grid is the ground sampled at cell centres, and sampling a sampled grid again loses what a fine grid needs: a
// 4 m grid turns the vertical cap of the waterfall into a ramp four metres wide, and it carries the cell-scale bumps of a
// channel profile evaluated at centres. `bedAt` does not resample the grid; it rebuilds the ground from its parts.
//
//   - The plan's own ground (valley floor, the cliff's step and the reservoir's level above it, all closed formulas of
//     position) is evaluated at the point itself, so the cliff is as steep at a metre as at a kilometre.
//   - What the plan does not say (mountains, erosion, floodplain, terraces, scars, fans: smooth things) is the difference
//     between the stored `surface` and the plan's ground at the four cell centres around, interpolated bilinearly.
//   - The channel, the pool and the bar are cut into that by `TerrainChannel::carve`, analytically, from the river's points.
//
// At a cell centre the result is the stored `bed` to rounding, so the two grids agree wherever they are compared.

use crate::terrain::hydro_terrain::HydroTerrain;
use crate::terrain::terrain_channel::TerrainChannel;
use crate::terrain::terrain_plan::TerrainPlan;

/** Evaluation of the ground at arbitrary resolution. */
pub class TerrainSample {
    /** The ground height at (x, z): see the file header. A hand-made terrain with no generator answers `heightAt`. */
    pub static fn bedAt(t : HydroTerrain, x : f32, z : f32) : f32 {
        if (!t.analytic) {
            return t.heightAt(x, z);
        }
        let plan : TerrainPlan = t.plan;
        let mut gx : f32 = x / t.cellSize - 0.5 as f32;
        let mut gz : f32 = z / t.cellSize - 0.5 as f32;
        if (gx < 0.0 as f32) {
            gx = 0.0 as f32;
        }
        if (gz < 0.0 as f32) {
            gz = 0.0 as f32;
        }
        if (gx > ((t.width - 2) as f32)) {
            gx = (t.width - 2) as f32;
        }
        if (gz > ((t.depth - 2) as f32)) {
            gz = (t.depth - 2) as f32;
        }
        let i : i32 = gx as i32;
        let j : i32 = gz as i32;
        let fx : f32 = gx - (i as f32);
        let fz : f32 = gz - (j as f32);

        let a : f32 = TerrainSample::rest(t, plan, i, j);
        let b : f32 = TerrainSample::rest(t, plan, i + 1, j);
        let c : f32 = TerrainSample::rest(t, plan, i, j + 1);
        let d : f32 = TerrainSample::rest(t, plan, i + 1, j + 1);
        let top : f32 = a + (b - a) * fx;
        let bottom : f32 = c + (d - c) * fx;
        let surface : f32 = plan.base(x, z) + top + (bottom - top) * fz;
        return TerrainChannel::carve(
            plan,
            t.river,
            t.riverCount,
            surface,
            x,
            z,
            TerrainSample::hint(t, x, z)
        );
    }

    // What the stored surface holds beyond the plan's ground at cell (i, j).
    static fn rest(t : HydroTerrain, plan : TerrainPlan, i : i32, j : i32) : f32 {
        let x : f32 = ((i as f32) + 0.5 as f32) * t.cellSize;
        let z : f32 = ((j as f32) + 0.5 as f32) * t.cellSize;
        return t.surface[t.cell(i, j)] - plan.base(x, z);
    }

    // Any fractional river point index near (x, z): from the cell holding it or its neighbours, or -1.
    static fn hint(t : HydroTerrain, x : f32, z : f32) : f32 {
        let ci : i32 = t.clampColumn((x / t.cellSize) as i32);
        let cj : i32 = t.clampRow((z / t.cellSize) as i32);
        let here : f32 = t.riverAlong[t.cell(ci, cj)];
        if (here >= 0.0 as f32) {
            return here;
        }
        for (dz of -1..2) {
            for (dx of -1..2) {
                let at : f32 = t.riverAlong[t.cell(t.clampColumn(ci + dx), t.clampRow(cj + dz))];
                if (at >= 0.0 as f32) {
                    return at;
                }
            }
        }
        return -1.0 as f32;
    }
}

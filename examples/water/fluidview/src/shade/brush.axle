// brush — what a scene paints with: the painter, the camera and the fog, behind two calls.
//
// Terrain, water, streaks and particles all end the same way: project a face, light it, fade it toward the
// sky with distance, push it. The brush owns the last three steps so the callers say only what they are
// drawing. The light is one fixed sun, because a fluid demo is about the water's motion and a moving sun
// would move every highlight with it.

use ludax::{saturate, Vec3};
use smalt::Color;

use crate::stage::camera::{OrbitCam, ScreenQuad};
use crate::stage::painter::{Painter, PAINTER_ALPHA_DEN};
use crate::stage::screen::SC_CLEAR;

/** x of the fixed sun's direction, unit length. */
pub const BRUSH_SUN_X : f32 = 0.466;

/** y of the fixed sun's direction. */
pub const BRUSH_SUN_Y : f32 = 0.828;

/** z of the fixed sun's direction. */
pub const BRUSH_SUN_Z : f32 = 0.311;

/** Ambient share of the light; the rest is the lambert term. */
pub const BRUSH_AMBIENT : f32 = 0.38;

/** Distance fog: none up to `near`, complete at `far`, and never denser than `max` of the sky. */
pub struct Fog {
    /** View depth the fog starts at. */
    pub near : f32 = 55.0;

    /** View depth the fog is complete at. */
    pub far : f32 = 130.0;

    /** The most of the sky colour the fog ever mixes in, 0 to 1. */
    pub max : f32 = 0.65;
}

/** How one face is coloured: its albedo, the light falling on it and its opacity. */
pub struct Look {
    /** Albedo as a packed colour. */
    pub albedo : i32 = 0;

    /** Light multiplier: `brushLit` of the face's lambert term, or 1 for a face lit by its own shader. */
    pub lit : f64 = 1.0;

    /** Alpha numerator over `PAINTER_ALPHA_DEN`; the denominator itself is opaque. */
    pub alpha : i32 = 256;
}

/** The light a surface with lambert term `shade` (0 to 1) receives: ambient plus the sun's share. */
pub fn brushLit(shade : f32) : f64 {
    return (BRUSH_AMBIENT + ((1.0 as f32) - BRUSH_AMBIENT) * shade) as f64;
}

/** A linear colour as a packed display word, clamped per channel. */
pub fn brushPack(c : Color) : i32 {
    return c.packed();
}

/** A linear blend from `a` toward `b`, `t` clamped to 0..1. */
pub fn brushBlend(a : Color, b : Color, t : f32) : Color {
    let k : f64 = saturate(t) as f64;
    return a.scaled(1.0 - k).plus(b.scaled(k));
}

/** The painter, camera and fog of one frame. */
pub class Brush {
    /** The quad pool being filled. */
    pub painter : Painter;

    /** The camera the faces are projected through. */
    pub cam : OrbitCam;

    fog : Fog;

    /** A brush that owns its painter and camera; the stage reaches them through it. */
    constructor(own painter : Painter, own cam : OrbitCam, fog : Fog) {
        self.painter = painter;
        self.cam = cam;
        self.fog = fog;
    }

    /** Pushes a face given by its world corners, in order around its perimeter. */
    pub fn quad(mut self, a : Vec3, b : Vec3, c : Vec3, d : Vec3, look : Look) : void {
        let q : ScreenQuad = self.cam.projectQuad(a, b, c, d);
        if (!q.ok) {
            return;
        }
        self.painter.pushQuad(q, self.fogged(look, q.depth), look.alpha);
    }

    /** Pushes the unit tile of column (`x`, `z`) at height `y`: a terrain top or a flat water surface. */
    pub fn top(mut self, x : i32, z : i32, y : f32, look : Look) : void {
        let x0 : f32 = x as f32;
        let z0 : f32 = z as f32;
        let one : f32 = 1.0 as f32;
        let a : Vec3 = Vec3::make(x0, y, z0);
        let b : Vec3 = Vec3::make(x0 + one, y, z0);
        let c : Vec3 = Vec3::make(x0 + one, y, z0 + one);
        let d : Vec3 = Vec3::make(x0, y, z0 + one);
        self.quad(a, b, c, d, look);
    }

    /** The colour a face of `look` takes at view depth `depth`: lit, then faded toward the sky. */
    pub fn fogged(self, look : Look, depth : f32) : i32 {
        let lit : i32 = Color::scaleBy(look.albedo, look.lit);
        let span : f32 = self.fog.far - self.fog.near;
        let fog : f32 = saturate((depth - self.fog.near) / span) * self.fog.max;
        let n : i32 = (fog * (PAINTER_ALPHA_DEN as f32)) as i32;
        return Color::mix(lit, SC_CLEAR, n, PAINTER_ALPHA_DEN);
    }
}

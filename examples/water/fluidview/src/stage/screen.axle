// screen — the 640 x 360 internal picture and the 2x-scaled window it shows in.
//
// The demos render 3-D into a plain 640 x 360 word buffer — the painter writes it directly, no Frame, no
// device — then double every pixel into a 1280 x 720 `Surface`. The window and the BMP both show the same
// scaled picture, and the HUD is drawn after the upscale so its glyphs stay crisp at one-to-one. One size,
// one path: a headless frame and a windowed frame cannot disagree about what the picture looks like.

use smalt::{Frame, Surface, Window};

/** Internal render width, pixels. */
pub const SC_W : i32 = 640;

/** Internal render height, pixels. */
pub const SC_H : i32 = 360;

/** How many screen pixels one internal pixel spans, each way. */
pub const SC_SCALE : i32 = 2;

/** Displayed width — the window and every BMP (`SC_W * SC_SCALE`; consts must stay literal). */
pub const SC_OUT_W : i32 = 1280;

/** Displayed height — the window and every BMP (`SC_H * SC_SCALE`). */
pub const SC_OUT_H : i32 = 720;

/** The clear colour of the internal buffer: the sky the distance fog fades toward. */
pub const SC_CLEAR : i32 = 0x38414f;

/** The internal picture and its scaled surface, ready for a window or a BMP. */
pub class Screen {
    surface : Surface;
    buf     : i32[];

    /** A cleared internal buffer over a cleared scaled surface. */
    constructor() {
        self.surface = new Surface(SC_OUT_W, SC_OUT_H);
        self.buf = new i32[((SC_W * SC_H) as i64)];
        let n : i64 = (SC_W * SC_H) as i64;
        for (i of 0..n) {
            self.buf[i] = SC_CLEAR;
        }
    }

    /** The internal 640 x 360 buffer the painter fills; row-major, one word a pixel. */
    pub fn internal(self) : i32[] {
        return self.buf;
    }

    /** The scaled surface as a drawing frame, for the HUD and for `Bmp::write`. */
    pub fn frame(self) : Frame {
        return self.surface.frame();
    }

    /** Fills the internal buffer with the sky colour. */
    pub fn clear(mut self) : void {
        let n : i64 = (SC_W * SC_H) as i64;
        for (i of 0..n) {
            self.buf[i] = SC_CLEAR;
        }
    }

    /** Doubles every internal pixel into the scaled surface. */
    pub fn upscale(mut self) : void {
        let mut px : i32[] = self.surface.pixels();
        for (y of 0..SC_H) {
            let row : i32 = y * SC_W;
            let out0 : i32 = (y * 2) * SC_OUT_W;
            let out1 : i32 = out0 + SC_OUT_W;
            for (x of 0..SC_W) {
                let v : i32 = self.buf[(row + x) as i64];
                px[(out0 + x * 2) as i64] = v;
                px[(out0 + x * 2 + 1) as i64] = v;
                px[(out1 + x * 2) as i64] = v;
                px[(out1 + x * 2 + 1) as i64] = v;
            }
        }
    }

    /** Puts the scaled picture on the window. */
    pub fn present(mut self, win : Window) : void {
        self.surface.present(win);
    }

    /** Releases the scaled surface. */
    pub fn close(self) : void {
        self.surface.close();
    }
}

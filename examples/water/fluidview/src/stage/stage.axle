// stage — the picture a demo draws into: screen, painter, HUD and camera, in the one order every frame runs.
//
// The windowed session and the headless BMP writer both build their frame through a `Stage`, so a screenshot
// and a window cannot disagree about what the picture looks like. A frame is `begin`, the demo pushes its
// scene through `painter` and `cam`, `finish` rasterises and scales it, and the demo draws its HUD on
// `frame()` last, at full resolution.

use smalt::{Bmp, Frame};

use crate::shade::brush::{Brush, Fog};
use crate::stage::camera::{CamOrbit, OrbitCam};
use crate::stage::hud::Hud;
use crate::stage::painter::Painter;
use crate::stage::screen::{Screen, SC_H, SC_W};

/** The drawing surfaces of one demo. */
pub class Stage {
    /** The brush that owns the camera (which the window's controls move) and the quad pool. */
    pub brush : Brush;

    /** Text drawing for the HUD. */
    pub hud : Hud;

    screen : Screen;

    /** A stage whose camera starts at `orbit` and whose distance fog is `fog`. */
    constructor(orbit : CamOrbit, fog : Fog) {
        self.brush = new Brush(new Painter(), new OrbitCam(orbit), fog);
        self.hud = new Hud();
        self.screen = new Screen();
    }

    /** Clears the sky and the quad pool and rebuilds the camera basis. */
    pub fn begin(mut self) : void {
        self.screen.clear();
        self.brush.painter.reset();
        self.brush.cam.refresh(SC_W, SC_H);
    }

    /** Rasterises the pushed quads and doubles the result into the output frame. */
    pub fn finish(mut self) : void {
        self.brush.painter.flush(self.screen.internal(), SC_W, SC_H);
        self.screen.upscale();
    }

    /** The scaled output frame: what the HUD draws on and what is shown or saved. */
    pub fn frame(self) : Frame {
        return self.screen.frame();
    }

    /** The screen, for a window to present. */
    pub fn screen(self) : Screen {
        return self.screen;
    }

    /** Writes the current frame as a BMP and says so; false when the file could not be written. */
    pub fn write(self, path : string) : bool {
        let ok : bool = Bmp::write(path, self.screen.frame());
        if (ok) {
            println("wrote ${path}");
        }
        return ok;
    }

    /** Releases the surfaces and the HUD's formatting block. */
    pub fn close(self) : void {
        self.hud.close();
        self.screen.close();
    }
}

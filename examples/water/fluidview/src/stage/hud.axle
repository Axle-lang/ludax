// hud — text on the scaled frame: labels and formatted numbers.
//
// One baked smalt face plus a scratch block — the arrangement stardrift's typeface uses: numbers are
// formatted into bytes and drawn straight from them, so a HUD redrawn every frame allocates nothing. Every
// line goes down twice, once in the shadow ink one pixel down-right and once in its own ink, because the text
// sits on a 3-D scene whose brightness no single ink survives unshadowed. The layout of what a demo shows
// lives in that demo's readout; this class only knows how to put ink somewhere.

use smalt::{BitmapFont, Face, Frame, Mem, Scratch};

/** Bytes of the scratch block: far more than any HUD line needs. */
pub const HUD_SCRATCH_BYTES : i32 = 160;

/** Left edge of every HUD column, in display pixels. */
pub const HUD_MARGIN : i32 = 12;

/** Leading between HUD lines, display pixels. */
pub const HUD_LEADING : i32 = 16;

/** Scale of a headline. */
pub const HUD_TITLE_SCALE : i32 = 2;

/** Top edge of the controls line at the foot of the picture, display pixels. */
pub const HUD_FOOT : i32 = 340;

/** Left edge of the PAUSED badge, display pixels. */
pub const HUD_BADGE_X : i32 = 540;

/** Ink of the headline. */
pub const HUD_INK : i32 = 0xf2efe6;

/** Ink of the secondary lines. */
pub const HUD_DIM : i32 = 0x9aa4b4;

/** Ink of the numbers that matter: volumes and rates. */
pub const HUD_ACCENT : i32 = 0x7fd4ff;

/** Shadow ink under everything, one pixel down-right. */
pub const HUD_SHADOW : i32 = 0x10141c;

/** The controls every demo's window answers to. */
const HUD_CONTROLS : string = "arrows orbit   +/- zoom   drag orbit   P pause   F12 bmp   Esc quit";

/** Where and how a piece of text goes down: its left edge, top edge, pixel scale and ink. */
pub struct Pen {
    /** Left edge, display pixels. */
    pub x : i32 = 0;

    /** Top edge, display pixels. */
    pub top : i32 = 0;

    /** Whole-number pixel multiplier of the glyphs. */
    pub scale : i32 = 1;

    /** Ink, as a packed colour. */
    pub ink : i32 = 0;

    /** A one-scale pen at (`x`, `top`). */
    pub static fn at(x : i32, top : i32, ink : i32) : Pen {
        return Pen { x: x, top: top, scale: 1, ink: ink };
    }

    /** The same pen enlarged to `scale`. */
    pub fn scaled(self, scale : i32) : Pen {
        return Pen { x: self.x, top: self.top, scale: scale, ink: self.ink };
    }
}

/** Text drawing: one baked face and a scratch block for the numbers. */
pub class Hud {
    font    : BitmapFont;
    scratch : Scratch;

    /** The UI face and a formatting block. */
    constructor() {
        self.font = BitmapFont::baked(Face::Ui);
        self.scratch = new Scratch(HUD_SCRATCH_BYTES);
    }

    /** Releases the formatting block. */
    pub fn close(self) : void {
        self.scratch.close();
    }

    /** Draws `s` with the one-pixel shadow every HUD line wears. */
    pub fn text(self, f : Frame, pen : Pen, s : string) : void {
        self.font.drawScaled(
            f,
            pen.x + 1,
            self.font.baselineFor(pen.top + 1, pen.scale),
            s,
            pen.scale,
            HUD_SHADOW
        );
        self.font.drawScaled(f, pen.x, self.font.baselineFor(pen.top, pen.scale), s, pen.scale, pen.ink);
    }

    /** Draws `prefix` then a number with `decimals` places, e.g. `source 42.0`. */
    pub fn fixed(mut self, f : Frame, pen : Pen, prefix : string, v : f64, decimals : i32) : void {
        self.scratch.reset();
        self.scratch.literal(prefix);
        self.scratch.fixed(v, decimals);
        self.scratchText(f, pen);
    }

    /** Draws `prefix` then a whole number, thousands not grouped, e.g. `drops 214`. */
    pub fn whole(mut self, f : Frame, pen : Pen, prefix : string, v : i64) : void {
        self.scratch.reset();
        self.scratch.literal(prefix);
        self.scratch.decimal(v);
        self.scratchText(f, pen);
    }

    /** The controls line at the foot of the picture, and the PAUSED badge while `paused`. */
    pub fn chrome(self, f : Frame, paused : bool) : void {
        self.text(f, Pen::at(HUD_MARGIN, HUD_FOOT, HUD_INK), HUD_CONTROLS);
        if (paused) {
            self.text(f, Pen::at(HUD_BADGE_X, HUD_MARGIN, HUD_INK).scaled(HUD_TITLE_SCALE), "PAUSED");
        }
    }

    // Draws the scratch block's bytes pixel-multiplied by the pen's scale, in the shadow and then the ink.
    fn scratchText(self, f : Frame, pen : Pen) : void {
        self.scratchBytes(f, pen.x + 1, pen.top + 1, pen.scale, HUD_SHADOW);
        self.scratchBytes(f, pen.x, pen.top, pen.scale, pen.ink);
    }

    fn scratchBytes(self, f : Frame, x : i32, top : i32, scale : i32, ink : i32) : void {
        let baseline : i32 = self.font.baselineFor(top, scale);
        let mut pen : i32 = x;
        for (i of 0..self.scratch.length()) {
            let code : i32 = Mem::byteAt(self.scratch.at(), i as i64);
            pen = pen + self.font.glyphScaled(f, pen, baseline, code, scale, ink);
        }
    }
}

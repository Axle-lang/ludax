// options — the command line every fluid demo shares.
//
//   --frame FILE      simulate, write a BMP of the state, and exit (no window)
//   --ticks N         advance the simulation N ticks without a window; with --frame, N replaces the default
//   --check           run the demo's physics self-check headlessly; the exit status is the failure count
//   --help            print this
//
// The water renderer adds its own, all optional:
//
//   --samples N       samples per pixel of a --frame picture (default 16; the first is the pixel's centre)
//   --size WxH        render size, multiples of 16 (default 960x544)
//   --scale N         show the picture N times larger than it is rendered (default 1)
//   --threads N       worker threads (default: all but one); the picture does not depend on it
//   --prof            print the milliseconds each stage of the renderer took
//   --demo NAME       the analytic scene of the renderer's demo program: geyser or shore
//   --at SECONDS      the simulation second a picture of a --demo is taken at
//   --film N          write N frames (FILE_00.bmp ...) and a contact sheet (FILE_sheet.bmp) instead of one picture
//   --step SECONDS    simulated seconds between the frames of a film (default 0.4)
//   --yaw A --pitch A --dist D    the camera's orbit, radians and cells
//   --target X,Y,Z    the point the camera orbits
//   --daytime T       time of day 0..1 (0.25 sunrise, 0.5 noon, 0.75 sunset)
//   --exposure S      exposure compensation in stops
//   --bloom F         bloom strength
//   --gravity G       the water's gravity, cells a second squared (default 9.81)
//   --viscosity V     the water's viscosity (default 0)
//   --spray-size S    multiplies the drops' size
//   --foam F          multiplies the foam's coverage
//   --no-sky --no-terrain --no-surface --no-spray  --no-post    switch a renderer module off
//
// Without flags the window opens. Each demo owns what its default tick count means; this file only reads the
// arguments and names a mistake in them instead of guessing.

use std::lang::IndexOutOfBoundsException;
use std::sys::process::{argc, argAt};

// The ASCII codes the number readers look for.
const FV_CLI_ZERO : i32 = 48;
const FV_CLI_NINE : i32 = 57;
const FV_CLI_DOT : i32 = 46;
const FV_CLI_MINUS : i32 = 45;
const FV_CLI_X : i32 = 120;
const FV_CLI_COMMA : i32 = 44;

/** The value a numeric option has when the command line did not set it. */
pub const CLI_UNSET : f64 = -1000000.0;

/** What the command line asked for. */
pub class Options {
    /** File to write a picture to, or empty for none. */
    pub frame : string = "";

    /** Ticks to simulate headlessly, or 0 for the demo's own default. */
    pub ticks : i32 = 0;

    /** Run the demo's self-check. */
    pub check : bool = false;

    /** Print the usage. */
    pub help : bool = false;

    /** A mistake in the arguments, or empty. */
    pub problem : string = "";

    /** Samples per pixel of a --frame picture. */
    pub samples : i32 = 16;

    /** Render width, or 0 for the default. */
    pub width : i32 = 0;

    /** Render height, or 0 for the default. */
    pub height : i32 = 0;

    /** Display scale. */
    pub scale : i32 = 1;

    /** Worker threads, or 0 for the default. */
    pub threads : i32 = 0;

    /** Print the stage timings. */
    pub prof : bool = false;

    /** The analytic scene of the demo program, or empty. */
    pub demo : string = "";

    /** The simulation second of a demo picture, or `CLI_UNSET`. */
    pub at : f64 = CLI_UNSET;

    /** Camera yaw, pitch, distance and target overrides, each `CLI_UNSET` when not given. */
    pub yaw     : f64 = CLI_UNSET;
    pub pitch   : f64 = CLI_UNSET;
    pub dist    : f64 = CLI_UNSET;
    pub targetX : f64 = CLI_UNSET;
    pub targetY : f64 = CLI_UNSET;
    pub targetZ : f64 = CLI_UNSET;

    /** Look overrides, each `CLI_UNSET` when not given. */
    pub daytime   : f64 = CLI_UNSET;
    pub exposure  : f64 = CLI_UNSET;
    pub bloom     : f64 = CLI_UNSET;
    pub gravity   : f64 = CLI_UNSET;
    pub viscosity : f64 = CLI_UNSET;
    pub spraySize : f64 = CLI_UNSET;
    pub foam      : f64 = CLI_UNSET;

    /** Frames of a film (0 for a single picture) and the simulated seconds between them. */
    pub film : i32 = 0;
    pub step : f64 = CLI_UNSET;

    /** A pixel (probeX, probeY) whose mean radiance --prof prints, or -1. */
    pub probeX : i32 = -1;
    pub probeY : i32 = -1;

    /** The vista's camera path (wide, pool or river), the position on it from 0 to 1, and the drops it holds. */
    pub shot  : string = "wide";
    pub along : f64 = CLI_UNSET;
    pub drops : i32 = 0;

    /** Run the cascade closed: no inflow and no open side, so the water in the world is constant; and a volume in m3 to pour in once. */
    pub closed : bool = false;

    /** Flow markers to scatter over the lake at the start, and a camera given by hand: x, y, z metres, yaw and pitch radians. */
    pub markers : i32 = 0;

    /** Markers released in the notch just above the lip, to follow the fall. */
    pub floats : i32 = 0;

    /** Markers released in the river just below the pool, and in the lake well back from the lip. */
    pub floatsRiver : i32 = 0;
    pub floatsLake  : i32 = 0;
    pub camera      : bool = false;
    pub camX        : f64 = CLI_UNSET;
    pub camY        : f64 = CLI_UNSET;
    pub camZ        : f64 = CLI_UNSET;
    pub camYaw      : f64 = 0.0;
    pub camPitch    : f64 = 0.0;

    /** Dye the reservoir red, so the same water can be followed from the lake over the lip and down the river. */
    pub dye : bool = false;

    /** Draw the HUD (the books and the chart) on the pictures of a headless run. */
    pub hud  : bool = false;
    pub pour : f64 = CLI_UNSET;

    /** The scene's seed (the cascade's terrain) and the water grid's cell size in metres, or `CLI_UNSET`. */
    pub seed : i32 = 7;
    pub cell : f64 = CLI_UNSET;

    /** The vista's look overrides: the water's silt (0 clear to 1 muddy) and the shutter in seconds. */
    pub silt    : f64 = CLI_UNSET;
    pub shutter : f64 = CLI_UNSET;

    /** Render at one thread and at many and compare the pictures; the exit status says whether they agree. */
    pub checkThreads : bool = false;

    /** Write the long-time sheet: the scene at 5, 15, 30 and 60 seconds. */
    pub sheet : bool = false;

    /** The renderer modules the command line switched off. */
    pub noSky     : bool = false;
    pub noTerrain : bool = false;
    pub noSurface : bool = false;
    pub noSpray   : bool = false;
    pub noPost    : bool = false;
    pub noHaze    : bool = false;

    /** Options with every default. */
    constructor() {}

    /** True when the numeric option `v` was given. */
    pub static fn given(v : f64) : bool {
        return v > CLI_UNSET;
    }
}

/** Command-line parsing. */
pub class Cli {
    /** Reads the arguments of the running program. */
    pub static fn parse() : Options {
        let mut o : Options = new Options();
        let mut i : i32 = 1;
        while (i < argc() && o.problem.length == 0) {
            let arg : string = Cli::argument(i);
            if (arg == "--help" || arg == "-h") {
                o.help = true;
            } else if (arg == "--check") {
                o.check = true;
            } else if (arg == "--prof") {
                o.prof = true;
            } else if (Cli::isSwitch(arg)) {
                Cli::flag(o, arg);
            } else if (arg.length > 2 && arg.byteAt(0) == FV_CLI_MINUS && arg.byteAt(1) == FV_CLI_MINUS) {
                i = i + 1;
                if (i >= argc()) {
                    o.problem = "${arg} needs a value";
                } else {
                    Cli::withValue(o, arg, Cli::argument(i));
                }
            } else {
                o.problem = "unknown argument ${arg}";
            }
            i = i + 1;
        }
        return o;
    }

    // True for the `--no-...` switches.
    static fn isSwitch(arg : string) : bool {
        return arg == "--no-sky" || arg == "--no-terrain" || arg == "--no-surface" || arg == "--no-spray"
            || arg == "--closed"
            || arg == "--dye"
            || arg == "--hud"
            || arg == "--no-post"
            || arg == "--no-haze"
            || arg == "--check-threads"
            || arg == "--sheet";
    }

    static fn flag(o : Options, arg : string) : void {
        if (arg == "--no-sky") {
            o.noSky = true;
        } else if (arg == "--no-terrain") {
            o.noTerrain = true;
        } else if (arg == "--no-surface") {
            o.noSurface = true;
        } else if (arg == "--no-spray") {
            o.noSpray = true;
        } else if (arg == "--hud") {
            o.hud = true;
        } else if (arg == "--dye") {
            o.dye = true;
        } else if (arg == "--closed") {
            o.closed = true;
        } else if (arg == "--no-haze") {
            o.noHaze = true;
        } else if (arg == "--check-threads") {
            o.checkThreads = true;
        } else if (arg == "--sheet") {
            o.sheet = true;
        } else {
            o.noPost = true;
        }
    }

    /** The usage text for the demo called `name`. */
    pub static fn usage(name : string) : string {
        return "${name} [--frame FILE.bmp] [--ticks N] [--check] [--samples N] [--size WxH] [--scale N] [--threads N] [--prof]\n"
            + "  [--yaw A] [--pitch A] [--dist D] [--target X,Y,Z] [--daytime T] [--exposure S] [--bloom F]\n"
            + "  [--gravity G] [--viscosity V] [--spray-size S] [--foam F]\n"
            + "  [--no-sky] [--no-terrain] [--no-surface] [--no-spray] [] [--no-post]\n"
            + "  arrow keys orbit, +/- and the wheel zoom, drag orbits, P pause, F12 screenshot, Esc quit";
    }

    /**
     * `path` with `suffix` before its extension (`shot.bmp` and `_full` give `shot_full.bmp`), or appended
     * when it has none, so a pair of pictures sorts together.
     */
    pub static fn beside(path : string, suffix : string) : string {
        let mut dot : i32 = -1;
        for (i of 0..path.byteLength) {
            if (path.byteAt(i) == FV_CLI_DOT) {
                dot = i as i32;
            }
        }
        if (dot < 0) {
            return path + suffix;
        }
        try {
            return path.substring(0, dot) + suffix + path.substring(dot, path.byteLength as i32);
        } catch e : IndexOutOfBoundsException {
            return path + suffix;
        }
    }

    // One `--name value` pair.
    static fn withValue(o : Options, name : string, value : string) : void {
        if (name == "--frame") {
            o.frame = value;
        } else if (name == "--demo") {
            o.demo = value;
        } else if (name == "--shot") {
            o.shot = value;
        } else if (name == "--size") {
            Cli::size(o, value);
        } else if (name == "--probe") {
            Cli::probe(o, value);
        } else if (name == "--target") {
            Cli::target(o, value);
        } else if (name == "--camera") {
            Cli::camera(o, value);
        } else if (name == "--ticks" || name == "--samples" || name == "--scale" || name == "--threads"
            || name == "--film"
            || name == "--drops"
            || name == "--seed"
            || name == "--markers"
            || name == "--floats"
            || name == "--floats-river"
            || name == "--floats-lake") {
            Cli::whole(o, name, value);
        } else {
            Cli::decimalOption(o, name, value);
        }
    }

    static fn whole(o : Options, name : string, value : string) : void {
        let n : i32 = Cli::number(value);
        if (n < 0) {
            o.problem = "${name} needs a whole number, not ${value}";
        } else if (name == "--ticks") {
            o.ticks = n;
        } else if (name == "--samples") {
            o.samples = n;
        } else if (name == "--film") {
            o.film = n;
        } else if (name == "--drops") {
            o.drops = n;
        } else if (name == "--seed") {
            o.seed = n;
        } else if (name == "--markers") {
            o.markers = n;
        } else if (name == "--floats") {
            o.floats = n;
        } else if (name == "--floats-river") {
            o.floatsRiver = n;
        } else if (name == "--floats-lake") {
            o.floatsLake = n;
        } else if (name == "--scale") {
            o.scale = n;
        } else {
            o.threads = n;
        }
    }

    static fn decimalOption(o : Options, name : string, value : string) : void {
        let v : f64 = Cli::decimal(value);
        if (v <= CLI_UNSET) {
            o.problem = "${name} needs a number, not ${value}";
        } else if (name == "--at") {
            o.at = v;
        } else if (name == "--step") {
            o.step = v;
        } else if (name == "--u") {
            o.along = v;
        } else if (name == "--cell") {
            o.cell = v;
        } else if (name == "--pour") {
            o.pour = v;
        } else if (name == "--silt") {
            o.silt = v;
        } else if (name == "--shutter") {
            o.shutter = v;
        } else if (name == "--yaw") {
            o.yaw = v;
        } else if (name == "--pitch") {
            o.pitch = v;
        } else if (name == "--dist") {
            o.dist = v;
        } else if (name == "--daytime") {
            o.daytime = v;
        } else if (name == "--exposure") {
            o.exposure = v;
        } else if (name == "--bloom") {
            o.bloom = v;
        } else if (name == "--gravity") {
            o.gravity = v;
        } else if (name == "--viscosity") {
            o.viscosity = v;
        } else if (name == "--spray-size") {
            o.spraySize = v;
        } else if (name == "--foam") {
            o.foam = v;
        } else {
            o.problem = "unknown argument ${name}";
        }
    }

    // Reads WxH.
    static fn size(o : Options, value : string) : void {
        let mut at : i32 = -1;
        for (i of 0..value.byteLength) {
            if (value.byteAt(i) == FV_CLI_X) {
                at = i as i32;
            }
        }
        if (at < 1) {
            o.problem = "--size needs WxH, e.g. 960x544";
            return;
        }
        try {
            o.width = Cli::number(value.substring(0, at));
            o.height = Cli::number(value.substring(at + 1, value.byteLength as i32));
        } catch e : IndexOutOfBoundsException {
            o.problem = "--size needs WxH, e.g. 960x544";
            return;
        }
        if (o.width < 16 || o.height < 16 || o.width % 16 != 0 || o.height % 16 != 0) {
            o.problem = "--size needs WxH, both multiples of 16";
        }
    }

    // Reads X,Y.
    static fn probe(o : Options, value : string) : void {
        let mut comma : i32 = -1;
        for (i of 0..value.byteLength) {
            if (value.byteAt(i) == FV_CLI_COMMA) {
                comma = i as i32;
            }
        }
        if (comma < 1) {
            o.problem = "--probe needs X,Y";
            return;
        }
        try {
            o.probeX = Cli::number(value.substring(0, comma));
            o.probeY = Cli::number(value.substring(comma + 1, value.byteLength as i32));
        } catch e : IndexOutOfBoundsException {
            o.problem = "--probe needs X,Y";
        }
    }

    // Reads X,Y,Z,YAW,PITCH.
    static fn camera(o : Options, value : string) : void {
        let mut at : i32 = 0;
        let mut commas : i32 = 0;
        let mut parts : f64[] = new f64[5];
        for (i of 0..value.byteLength) {
            if (value.byteAt(i) == FV_CLI_COMMA) {
                if (commas >= 4) {
                    o.problem = "--camera needs X,Y,Z,YAW,PITCH";
                    return;
                }
                try {
                    parts[commas as i64] = Cli::decimal(value.substring(at, i as i32));
                } catch e : IndexOutOfBoundsException {
                    o.problem = "--camera needs X,Y,Z,YAW,PITCH";
                    return;
                }
                commas = commas + 1;
                at = (i as i32) + 1;
            }
        }
        if (commas != 4) {
            o.problem = "--camera needs X,Y,Z,YAW,PITCH";
            return;
        }
        try {
            parts[4] = Cli::decimal(value.substring(at, value.byteLength as i32));
        } catch e : IndexOutOfBoundsException {
            o.problem = "--camera needs X,Y,Z,YAW,PITCH";
            return;
        }
        o.camX = parts[0];
        o.camY = parts[1];
        o.camZ = parts[2];
        o.camYaw = parts[3];
        o.camPitch = parts[4];
        o.camera = true;
    }

    // Reads X,Y,Z.
    static fn target(o : Options, value : string) : void {
        let mut first : i32 = -1;
        let mut second : i32 = -1;
        for (i of 0..value.byteLength) {
            if (value.byteAt(i) == FV_CLI_COMMA) {
                if (first < 0) {
                    first = i as i32;
                } else {
                    second = i as i32;
                }
            }
        }
        if (first < 1 || second < 0) {
            o.problem = "--target needs X,Y,Z";
            return;
        }
        try {
            o.targetX = Cli::decimal(value.substring(0, first));
            o.targetY = Cli::decimal(value.substring(first + 1, second));
            o.targetZ = Cli::decimal(value.substring(second + 1, value.byteLength as i32));
        } catch e : IndexOutOfBoundsException {
            o.problem = "--target needs X,Y,Z";
        }
    }

    static fn argument(i : i32) : string {
        try {
            return argAt(i) + "";
        } catch e : IndexOutOfBoundsException {
            return "";
        }
    }

    // The non-negative whole number written in `s`, or -1.
    static fn number(s : string) : i32 {
        if (s.length == 0) {
            return -1;
        }
        let mut n : i32 = 0;
        for (i of 0..s.byteLength) {
            let d : i32 = s.byteAt(i);
            if (d < FV_CLI_ZERO || d > FV_CLI_NINE) {
                return -1;
            }
            n = n * 10 + (d - FV_CLI_ZERO);
        }
        return n;
    }

    // A decimal like 0.25 or -1.5, or `CLI_UNSET` when it is not one.
    static fn decimal(s : string) : f64 {
        if (s.length == 0) {
            return CLI_UNSET;
        }
        let negative : bool = s.byteAt(0) == FV_CLI_MINUS;
        let mut whole : f64 = 0.0;
        let mut frac : f64 = 0.0;
        let mut scale : f64 = 1.0;
        let mut seenDot : bool = false;
        let mut digits : i32 = 0;
        let mut begin : i32 = 0;
        if (negative) {
            begin = 1;
        }
        for (i of (begin as i64)..s.byteLength) {
            let d : i32 = s.byteAt(i);
            if (d == FV_CLI_DOT && !seenDot) {
                seenDot = true;
            } else if (d < FV_CLI_ZERO || d > FV_CLI_NINE) {
                return CLI_UNSET;
            } else if (seenDot) {
                scale = scale / 10.0;
                frac = frac + (d - FV_CLI_ZERO) as f64 * scale;
                digits = digits + 1;
            } else {
                whole = whole * 10.0 + (d - FV_CLI_ZERO) as f64;
                digits = digits + 1;
            }
        }
        if (digits == 0) {
            return CLI_UNSET;
        }
        if (negative) {
            return 0.0 - (whole + frac);
        }
        return whole + frac;
    }
}

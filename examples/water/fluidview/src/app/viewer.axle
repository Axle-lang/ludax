// viewer — the window every fluid demo runs in: events, orbit controls, frame pacing and the screenshot key.
//
// A demo's session is its own loop (`while view.pump()`: tick the simulation once, draw, present); what is the
// same for all of them lives here. One simulation tick runs per frame, so simulation time is ticks times the
// demo's `dt` and nothing reads a wall clock; a slow frame slows the demo rather than skipping a tick. The
// pacer's delta only moves the camera, which is the one thing that is allowed to depend on real time.

use smalt::{Clock, Event, EventKind, Events, FramePacer, MouseButton, Platform, PlatformError, Scancode};
use smalt::{Window, WindowDesc};

use crate::shade::brush::Fog;
use crate::stage::camera::CamOrbit;
use crate::stage::screen::{SC_OUT_H, SC_OUT_W};
use crate::stage::stage::Stage;

/** Frames a second the pacer aims at. */
const VIEW_FRAME_RATE : i32 = 60;

/** Radians of orbit a second of held arrow buys. */
const VIEW_TURN : f32 = 1.2;

/** Fraction of the orbit radius a second of +/- zoom moves. */
const VIEW_ZOOM : f32 = 0.8;

/** Radians of orbit one mouse pixel buys while dragging. */
const VIEW_MOUSE_TURN : f32 = 0.006;

/** Fraction of the orbit radius one wheel notch zooms. */
const VIEW_WHEEL_ZOOM : f32 = 0.1;

/** Shortest the orbit radius may get, view units. */
const VIEW_DIST_MIN : f32 = 14.0;

/** Farthest the orbit radius may get, view units. */
const VIEW_DIST_MAX : f32 = 150.0;

/** What a demo tells the viewer about its window. */
pub struct ViewerDesc {
    /** The window title. */
    pub title : string = "";

    /** The file F12 writes the current frame to. */
    pub shot : string = "";

    /** Where the camera starts. */
    pub orbit : CamOrbit = CamOrbit {};

    /** The distance fog of the scene. */
    pub fog : Fog = Fog {};
}

/** The toggles the event handler and the frame loop both see. */
class ViewerState {
    /** False once the player quits (Escape or the window's close button). */
    pub running : bool = true;

    /** True while P has the simulation held. */
    pub paused : bool = false;
}

/** An open window with its input, pacing and the stage the demo draws on. */
pub class Viewer {
    /** The picture surfaces; the demo draws on them and the viewer presents them. */
    pub stage : Stage;

    platform : Platform;
    win      : Window;
    clock    : Clock;
    events   : Events;
    pacer    : FramePacer;
    state    : ViewerState;
    shot     : string;

    /** Opens the window; the caller closes the viewer with `defer`. */
    constructor(d : ViewerDesc) ! PlatformError {
        self.platform = new Platform();
        self.win = self.platform.open(WindowDesc { title: d.title, w: SC_OUT_W, h: SC_OUT_H });
        self.clock = new Clock();
        self.events = new Events();
        self.pacer = new FramePacer(VIEW_FRAME_RATE);
        self.state = new ViewerState();
        self.stage = new Stage(d.orbit, d.fog);
        self.shot = d.shot;
    }

    /**
     * Waits for the next frame, drains the events and moves the camera by what is held. Answers false once
     * the window should close.
     */
    pub fn pump(mut self) : bool {
        let dt : f64 = self.pacer.tick(self.clock);
        self.events.pump(self.win, self.clock);
        while (self.events.hasNext()) {
            self.handle(self.events.next());
        }
        self.orbit(dt as f32);
        return self.state.running && self.win.isOpen();
    }

    /** Whether the player holds the simulation. */
    pub fn paused(self) : bool {
        return self.state.paused;
    }

    /** False while the window is minimised: nothing is worth drawing then. */
    pub fn visible(self) : bool {
        return !self.win.minimised();
    }

    /** Puts the stage's finished frame on the window. */
    pub fn present(self) : void {
        self.stage.screen().present(self.win);
    }

    /** Closes the stage, the input and the window, in the reverse of the order they opened. */
    pub fn close(self) : void {
        self.stage.close();
        self.events.close();
        self.clock.close();
        self.win.close();
        self.platform.close();
    }

    // One event: quit, pause, the screenshot. Held keys are read as state, not events.
    fn handle(mut self, e : Event) : void {
        if (e.kind == EventKind::Quit) {
            self.state.running = false;
            return;
        }
        if (e.kind != EventKind::KeyDown || e.repeat) {
            return;
        }
        if (e.scancode == Scancode::Escape) {
            self.state.running = false;
        } else if (e.scancode == Scancode::P) {
            self.state.paused = !self.state.paused;
        } else if (e.scancode == Scancode::F12) {
            self.stage.write(self.shot);
        }
    }

    // The held orbit controls: arrows turn, +/- and the wheel zoom, a held left button drags.
    fn orbit(mut self, dt : f32) : void {
        let one : f32 = 1.0;
        if (self.events.isKeyDown(Scancode::Left)) {
            self.stage.brush.cam.turn(-VIEW_TURN * dt, 0.0);
        }
        if (self.events.isKeyDown(Scancode::Right)) {
            self.stage.brush.cam.turn(VIEW_TURN * dt, 0.0);
        }
        if (self.events.isKeyDown(Scancode::Up)) {
            self.stage.brush.cam.turn(0.0, VIEW_TURN * dt);
        }
        if (self.events.isKeyDown(Scancode::Down)) {
            self.stage.brush.cam.turn(0.0, -VIEW_TURN * dt);
        }
        if (self.events.isKeyDown(Scancode::Equals)) {
            self.stage.brush.cam.zoom(one - VIEW_ZOOM * dt, VIEW_DIST_MIN, VIEW_DIST_MAX);
        }
        if (self.events.isKeyDown(Scancode::Minus)) {
            self.stage.brush.cam.zoom(one + VIEW_ZOOM * dt, VIEW_DIST_MIN, VIEW_DIST_MAX);
        }
        if (self.events.isButtonDown(MouseButton::Left)) {
            let dyaw : f32 = (self.events.mouseDX() as f32) * VIEW_MOUSE_TURN;
            let dpitch : f32 = (self.events.mouseDY() as f32) * VIEW_MOUSE_TURN;
            self.stage.brush.cam.turn(dyaw, dpitch);
        }
        let wheel : i32 = self.events.mouseWheel();
        if (wheel != 0) {
            let factor : f32 = one - (wheel as f32) * VIEW_WHEEL_ZOOM;
            self.stage.brush.cam.zoom(factor, VIEW_DIST_MIN, VIEW_DIST_MAX);
        }
    }
}

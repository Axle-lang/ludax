// water_run — what a demo does with the command line and a `WaterRenderer`: apply the options, draw, write.
//
// Every fluid demo and the renderer's own demo program end up with the same few steps: start from the scene's
// look and camera, let the command line override them (a physics value, a time of day, a switched-off module),
// render so many samples and put the picture in a BMP. They are here once so a headless picture and a window
// cannot disagree about what an option means, and so a scene author writes none of it.

use ludax::{JobPool, Vec3};
use smalt::{Bmp, Surface};

use crate::app::options::{Options};
use crate::stage::camera::CamOrbit;
use crate::water::look::WaterLook;
use crate::water::renderer::{WaterRenderer, RENDER_STAGES, RENDER_STAGE_NAMES};

/** Default render size when the command line gives none. */
pub const RUN_WIDTH : i32 = 960;
pub const RUN_HEIGHT : i32 = 544;

/** Reads the command line's overrides into looks and cameras, and draws and saves pictures. */
pub class WaterRun {
    /** `base` with every look the command line overrode applied. */
    pub static fn look(o : Options, base : WaterLook) : WaterLook {
        let mut l : WaterLook = base;
        if (Options::given(o.gravity)) {
            l.physics.gravity = o.gravity as f32;
        }
        if (Options::given(o.viscosity)) {
            l.physics.viscosity = o.viscosity as f32;
        }
        if (Options::given(o.daytime)) {
            l.sky.dayTime = o.daytime;
        }
        if (Options::given(o.exposure)) {
            l.post.exposureBias = o.exposure as f32;
        }
        if (Options::given(o.bloom)) {
            l.post.bloom = o.bloom as f32;
        }
        if (Options::given(o.spraySize)) {
            l.spray.sizeGain = o.spraySize as f32;
        }
        if (Options::given(o.foam)) {
            l.surface.foamCoverage = o.foam as f32;
        }
        l.modules.sky = l.modules.sky && !o.noSky;
        l.modules.terrain = l.modules.terrain && !o.noTerrain;
        l.modules.surface = l.modules.surface && !o.noSurface;
        l.modules.spray = l.modules.spray && !o.noSpray;
        l.modules.post = l.modules.post && !o.noPost;
        return l;
    }

    /** `base` with the camera the command line moved. */
    pub static fn orbit(o : Options, base : CamOrbit) : CamOrbit {
        let mut c : CamOrbit = base;
        if (Options::given(o.yaw)) {
            c.yaw = o.yaw as f32;
        }
        if (Options::given(o.pitch)) {
            c.pitch = o.pitch as f32;
        }
        if (Options::given(o.dist)) {
            c.dist = o.dist as f32;
        }
        let x : f32 = WaterRun::pick(o.targetX, base.target.x);
        let y : f32 = WaterRun::pick(o.targetY, base.target.y);
        let z : f32 = WaterRun::pick(o.targetZ, base.target.z);
        c.target = Vec3 { x: x, y: y, z: z };
        return c;
    }

    // The option's value when it was given, else `fallback`.
    static fn pick(v : f64, fallback : f32) : f32 {
        if (Options::given(v)) {
            return v as f32;
        }
        return fallback;
    }

    /** The render width the command line asks for. */
    pub static fn width(o : Options) : i32 {
        if (o.width > 0) {
            return o.width;
        }
        return RUN_WIDTH;
    }

    /** The render height the command line asks for. */
    pub static fn height(o : Options) : i32 {
        if (o.height > 0) {
            return o.height;
        }
        return RUN_HEIGHT;
    }

    /** The display scale the command line asks for, at least 1. */
    pub static fn scale(o : Options) : i32 {
        if (o.scale > 0) {
            return o.scale;
        }
        return 1;
    }

    /** The worker threads the command line asks for. */
    pub static fn threads(o : Options) : i32 {
        if (o.threads > 0) {
            return o.threads;
        }
        return JobPool::defaultWorkers();
    }

    /** Draws `samples` samples (at least one) of the scene from `orbit`, the first one restarting the picture. */
    pub static fn draw(r : WaterRenderer, orbit : CamOrbit, samples : i32) : void {
        r.render(orbit, true);
        for (i of 1..samples) {
            r.render(orbit, false);
        }
    }

    /** Writes the renderer's picture to a BMP; false when the file could not be written. */
    pub static fn save(r : WaterRenderer, path : string) : bool {
        let surface = new Surface(r.outWidth, r.outHeight);
        let mut px : i32[] = surface.pixels();
        let src : i32[] = r.pixels();
        for (i of 0..((r.outWidth as i64) * r.outHeight)) {
            px[i] = src[i];
        }
        let ok : bool = Bmp::write(path, surface.frame());
        surface.close();
        if (ok) {
            println("wrote ${path} (${r.samples} samples, ${r.outWidth}x${r.outHeight})");
        }
        return ok;
    }

    /** Prints the mean radiance around the probe pixel of the options, against the white level. */
    pub static fn probe(o : Options, r : WaterRenderer) : void {
        if (o.probeX < 0) {
            return;
        }
        let c : Vec3 = r.probe(o.probeX, o.probeY, 4);
        let white : f32 = r.whiteLevel();
        let ratio : f32 = ludax::min(ludax::min(c.x, c.y), c.z) / white;
        println("probe ${o.probeX},${o.probeY}: radiance ${c.x} ${c.y} ${c.z}; white ${white}; darkest channel / white ${ratio}");
    }

    /** Prints the milliseconds each stage of the last sample took. */
    pub static fn profile(r : WaterRenderer) : void {
        println("last sample, milliseconds: ${RENDER_STAGE_NAMES}");
        let mut line : string = "";
        for (i of 0..RENDER_STAGES) {
            let ms : f64 = r.spent[i as i64];
            line = "${line} ${ms}";
        }
        println(line);
        println("threads ${r.threads()}  ${r.describe()}");
    }
}

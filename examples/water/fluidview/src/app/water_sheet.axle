// water_sheet — a contact sheet: the frames of a film side by side, so motion can be judged from one picture.
//
// A still cannot show that water moves. `--film N` renders N frames a fixed number of simulated seconds apart and
// writes each as a numbered BMP; this class lays them out, each shrunk to half size by a box filter, in rows of
// `columns` tiles on one BMP, so a reader sees the dome, the rise of the column, its fall and the rings on the pool
// in one look. If consecutive tiles look the same, the water is not moving enough.

use smalt::{Bmp, Color, Surface};

use crate::water::renderer::WaterRenderer;

/** Tiles of a contact sheet are the frames shrunk by this factor along each axis. */
const SHEET_SHRINK : i32 = 2;

/** The contact sheet of a film. */
pub class ContactSheet {
    surface : Surface;
    columns : i32;
    tileW   : i32;
    tileH   : i32;
    width   : i32;

    /** A sheet for `count` frames of `frameW` by `frameH` pixels laid out `columns` to a row. */
    constructor(count : i32, columns : i32, frameW : i32, frameH : i32) {
        self.columns = columns;
        self.tileW = frameW / SHEET_SHRINK;
        self.tileH = frameH / SHEET_SHRINK;
        self.width = columns * self.tileW;
        let rows : i32 = (count + columns - 1) / columns;
        self.surface = new Surface(self.width, rows * self.tileH);
    }

    /** Puts the picture of `r` in tile `index`, shrunk. */
    pub fn add(mut self, index : i32, r : WaterRenderer) : void {
        self.addPixels(index, r.pixels(), r.outWidth);
    }

    /** Puts the picture `src` (rows `srcWidth` pixels wide) in tile `index`, shrunk. */
    pub fn addPixels(mut self, index : i32, src : i32[], srcWidth : i32) : void {
        let mut out : i32[] = self.surface.pixels();
        let x0 : i32 = (index % self.columns) * self.tileW;
        let y0 : i32 = (index / self.columns) * self.tileH;
        for (y of 0..self.tileH) {
            for (x of 0..self.tileW) {
                let a : i32 = src[(((y * SHEET_SHRINK) * srcWidth) + x * SHEET_SHRINK) as i64];
                let b : i32 = src[(((y * SHEET_SHRINK) * srcWidth) + x * SHEET_SHRINK + 1) as i64];
                let c : i32 = src[(((y * SHEET_SHRINK + 1) * srcWidth) + x * SHEET_SHRINK) as i64];
                let d : i32 = src[(((y * SHEET_SHRINK + 1) * srcWidth) + x * SHEET_SHRINK + 1) as i64];
                let red : i32 = (Color::red(a) + Color::red(b) + Color::red(c) + Color::red(d)) / 4;
                let green : i32 = (Color::green(a) + Color::green(b) + Color::green(c) + Color::green(d)) / 4;
                let blue : i32 = (Color::blue(a) + Color::blue(b) + Color::blue(c) + Color::blue(d)) / 4;
                out[(((y0 + y) * self.width) + x0 + x) as i64] = Color::packBytes(red, green, blue);
            }
        }
    }

    /** Writes the sheet to `path` and says so; false when the file could not be written. */
    pub fn save(self, path : string) : bool {
        let ok : bool = Bmp::write(path, self.surface.frame());
        if (ok) {
            println("wrote ${path}");
        }
        return ok;
    }

    /** Releases the sheet's surface. */
    pub fn close(self) : void {
        self.surface.close();
    }
}

// verdict — the report a demo's `--check` prints: each claim with the number that supports it.
//
// The demos are demonstrations before they are tests, so a bare pass is not enough: a reader wants to see
// that the volume balanced to 1e-12 or that the jet rose 19.6 cells against a predicted 20. `claim` prints the
// verdict with its figures on one line, and the count of failures becomes the exit status, so `tools/examples.sh`
// needs no parser.

/** What a demo's self-check has claimed so far. */
pub class Verdict {
    failed : i32 = 0;
    total  : i32 = 0;

    /** A report with nothing claimed yet. */
    constructor() {}

    /** States that `ok` holds; the line shows `detail`, the measured figures behind it. */
    pub fn claim(mut self, name : string, ok : bool, detail : string) : void {
        self.total = self.total + 1;
        if (ok) {
            println("  ok    ${name}: ${detail}");
            return;
        }
        self.failed = self.failed + 1;
        println("  FAIL  ${name}: ${detail}");
    }

    /** States that `got` is within `tolerance` of `want`. */
    pub fn near(mut self, name : string, got : f64, want : f64, tolerance : f64) : void {
        let mut gap : f64 = got - want;
        if (gap < 0.0) {
            gap = 0.0 - gap;
        }
        self.claim(name, gap <= tolerance, "${got} against ${want} (tolerance ${tolerance})");
    }

    /** How many claims failed: the exit status of the check. */
    pub fn failures(self) : i32 {
        return self.failed;
    }

    /** The closing line, `name: N checks, M failed`. */
    pub fn summary(self, name : string) : void {
        println("${name}: ${self.total} checks, ${self.failed} failed");
    }
}

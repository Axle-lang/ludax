// water_hud — the readouts every water scene shows next to its own: the physics it ran with and the renderer's cost.
//
// The physics the water was simulated with (gravity and viscosity) are what the picture is a picture of, so every
// scene's HUD carries them in the same place and the same words; a scene adds its own lines under them. The
// arrangement is this file's, how ink lands is the `Hud` class's.

use smalt::Frame;

use crate::stage::hud::{Hud, Pen, HUD_ACCENT, HUD_DIM, HUD_LEADING};
use crate::water::look::WaterPhysics;
use crate::water::renderer::WaterRenderer;

/** x of the second column of a two-column readout, display pixels. */
pub const WHUD_COLUMN : i32 = 170;

/** The standard physics and renderer readout. */
pub class WaterHud {
    /** Draws `gravity` and `viscosity` at the pen's place (left column) and (right column). */
    pub static fn physics(h : Hud, f : Frame, pen : Pen, p : WaterPhysics) : void {
        h.fixed(f, pen, "gravity ", p.gravity as f64, 2);
        let right : Pen = Pen::at(WHUD_COLUMN, pen.top, HUD_ACCENT);
        h.fixed(f, right, "viscosity ", p.viscosity as f64, 2);
    }

    /** Draws the number of samples of the picture and the cost of the last one, one line below `pen`. */
    pub static fn cost(h : Hud, f : Frame, pen : Pen, r : WaterRenderer) : void {
        let line : Pen = Pen::at(pen.x, pen.top + HUD_LEADING, HUD_DIM);
        h.whole(f, line, "samples ", r.samples as i64);
        h.fixed(f, Pen::at(WHUD_COLUMN, line.top, HUD_DIM), "ms ", r.spent[0], 1);
    }

    /** Draws the samples of the picture and the milliseconds of the last one, one line below `pen`. */
    pub static fn timing(h : Hud, f : Frame, pen : Pen, samples : i32, ms : f64) : void {
        let line : Pen = Pen::at(pen.x, pen.top + HUD_LEADING, HUD_DIM);
        h.whole(f, line, "samples ", samples as i64);
        h.fixed(f, Pen::at(WHUD_COLUMN, line.top, HUD_DIM), "ms ", ms, 1);
    }
}

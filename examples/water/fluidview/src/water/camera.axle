// camera — a pinhole camera for the ray marcher: an eye, a basis and a field of view, one ray per pixel.
//
// Scenes describe where to look as a `CamOrbit` (a target, a distance and two angles), the same value the
// windowed viewer turns with the arrow keys, so a scene author never builds a basis. `WaterCamera::orbit` turns
// that into the eye and the three axes once per frame; `ray` is then a few multiplies and `project` is its
// inverse, which the spray uses to land a world point on the picture. The conventions are those of
// the old painter's `OrbitCam`: yaw 0 puts the eye on the +x side of the target, pitch is the elevation of the
// eye above it, and the world's +y is up.

use ludax::{clamp, cos, sin, tan, Vec3};

use crate::stage::camera::CamOrbit;

/** Vertical field of view of a water view, radians. */
pub const WATER_FOV : f32 = 0.9;

/** The flattest and the steepest the eye may look from, radians above the horizon. */
pub const WATER_PITCH_MIN : f32 = 0.03;
pub const WATER_PITCH_MAX : f32 = 1.5;

// A point nearer than this along the view axis is behind the eye for `project`.
const WATER_NEAR : f32 = 0.05;

/** Where a world point falls in the picture: pixel position, distance along the view axis, and if it is in front. */
pub struct Landing {
    /** Pixel column, fractional. */
    pub x : f32 = 0.0;

    /** Pixel row, fractional, 0 at the top. */
    pub y : f32 = 0.0;

    /** Distance along the view axis. */
    pub depth : f32 = 0.0;

    /** False at or behind the near plane; the other fields mean nothing then. */
    pub ok : bool = false;
}

/** The eye of one picture. */
pub struct WaterCamera {
    /** World position of the eye. */
    pub eye : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Unit direction the camera looks along. */
    pub forward : Vec3 = Vec3 { x: 0.0, y: 0.0, z: -1.0 };

    /** Unit direction to the right of the picture. */
    pub right : Vec3 = Vec3 { x: 1.0, y: 0.0, z: 0.0 };

    /** Unit direction up the picture. */
    pub up : Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 };

    /** Tangent of half the vertical field of view. */
    pub halfHeight : f32 = 0.5;

    /** Picture width over height. */
    pub aspect : f32 = 1.0;

    /** Pixels in a picture row, so `project` can answer in pixels. */
    pub columns : f32 = 1.0;

    /** Pixels in a picture column. */
    pub rows : f32 = 1.0;

    /** The camera of an orbit around its target, for a picture `width` by `height` pixels. */
    pub static fn orbit(o : CamOrbit, width : i32, height : i32) : WaterCamera {
        let pitch : f32 = clamp(o.pitch, WATER_PITCH_MIN, WATER_PITCH_MAX);
        let cp : f32 = cos(pitch);
        let toEye : Vec3 = Vec3::make(cp * cos(o.yaw), sin(pitch), cp * sin(o.yaw));
        let forward : Vec3 = toEye.negated();
        let right : Vec3 = Vec3::make(toEye.z, 0.0, -toEye.x).normalized();
        return WaterCamera {
            eye: o.target.plus(toEye.scale(o.dist)),
            forward: forward,
            right: right,
            up: right.cross(forward),
            halfHeight: tan(WATER_FOV * (0.5 as f32)),
            aspect: (width as f32) / (height as f32),
            columns: width as f32,
            rows: height as f32,
        };
    }

    /** The unit direction through the point (`u`, `v`) of the picture in pixels, fractional, 0 at the top left. */
    pub fn ray(self, u : f32, v : f32) : Vec3 {
        let a : f32 = ((2.0 as f32) * u / self.columns - (1.0 as f32)) * self.aspect * self.halfHeight;
        let b : f32 = ((1.0 as f32) - (2.0 as f32) * v / self.rows) * self.halfHeight;
        return self.forward.plus(self.right.scale(a)).plus(self.up.scale(b)).normalized();
    }

    /** Where the world point `p` falls in the picture. */
    pub fn project(self, p : Vec3) : Landing {
        let d : Vec3 = p.minus(self.eye);
        let depth : f32 = d.dot(self.forward);
        if (depth < WATER_NEAR) {
            return Landing {};
        }
        let a : f32 = d.dot(self.right) / (depth * self.aspect * self.halfHeight);
        let b : f32 = d.dot(self.up) / (depth * self.halfHeight);
        return Landing {
            x: (a + (1.0 as f32)) * (0.5 as f32) * self.columns,
            y: ((1.0 as f32) - b) * (0.5 as f32) * self.rows,
            depth: depth,
            ok: true,
        };
    }

    /** How many pixels a length `size` spans at distance `depth` along the view axis. */
    pub fn pixelsAt(self, size : f32, depth : f32) : f32 {
        let d : f32 = ludax::max(depth, WATER_NEAR);
        return size * self.rows / ((2.0 as f32) * self.halfHeight * d);
    }

    /** The world length one pixel spans at distance `depth` along the view axis. */
    pub fn footprint(self, depth : f32) : f32 {
        return (2.0 as f32) * self.halfHeight * depth / self.rows;
    }
}

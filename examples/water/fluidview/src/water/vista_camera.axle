// vista_camera — where the vista's camera stands: a look-at camera and the three paths of the waterfall scene.
//
// A `WaterCamera` is an eye, a basis and a field of view; the vista needs one placed by two points rather than
// orbited around a target. The paths a scene flies are the scene's own (see the cascade example).

use ludax::{tan, Vec3};

use crate::water::camera::WaterCamera;

/** Vertical field of view of the vista, radians. */
pub const VISTA_FOV : f32 = 0.95;

/** Cameras of the vista. */
pub class VistaCamera {
    /** A camera at `eye` looking at `target`, for a picture `width` by `height`. */
    pub static fn lookAt(eye : Vec3, target : Vec3, width : i32, height : i32) : WaterCamera {
        let forward : Vec3 = target.minus(eye).normalized();
        let right : Vec3 = Vec3 { x: (0.0 as f32) - forward.z, y: (0.0 as f32), z: forward.x }.normalized();
        return WaterCamera {
            eye: eye,
            forward: forward,
            right: right,
            up: right.cross(forward),
            halfHeight: tan(VISTA_FOV * (0.5 as f32)),
            aspect: (width as f32) / (height as f32),
            columns: width as f32,
            rows: height as f32,
        };
    }
}

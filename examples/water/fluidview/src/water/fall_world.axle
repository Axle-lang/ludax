// fall_world — the analytic landscape of the waterfall demo: a mountain valley, a cliff, a plunge pool and a river.
//
// The vista renderer is judged on a landscape at mountain scale, and the engine's terrain generator may not be
// ready or may change, so the demo carries its own: every height, mask and water quantity is a closed formula of
// (x, z) in metres. The world is 3072 m square. A plateau at 121 m holds a lake (an ellipse in the north) that
// spills through a narrow channel over a 55 m cliff into a plunge pool; below the cliff a meandering river runs
// south across a floodplain at 66 m, falling half a percent, with riffles every 170 m and deep outer bends. The
// valley walls rise to several hundred metres with a ridged fractal. The bed and the water level are separate
// functions so the renderer's water window can sample the bed at one metre while the terrain samples it at one
// and a half: the two agree at the lattice points and differ by less than the detail between them.
//
// Nothing here touches an array: `FallBuild` (fall_build) fills the grids by calling these.

use ludax::{abs, clamp, max, min, saturate, sin, cos, smoothstep, sqrt, lerp, TAU};

use crate::water::noise::{waterFbm2, waterValue2};

/** The world's side, metres. */
pub const FW_SIZE : f32 = 3072.0;

/** The valley's centre line, x metres. */
pub const FW_CENTRE : f32 = 1536.0;

/** Where the cliff's lip lies along z, metres. */
pub const FW_LIP : f32 = 1040.0;

/** Height of the cliff, metres. */
pub const FW_CLIFF : f32 = 55.0;

/** Height of the floodplain at the foot of the cliff, metres. */
pub const FW_PLAIN : f32 = 66.0;

/** Height of the plateau, metres. */
pub const FW_PLATEAU : f32 = 121.0;

/** Water level of the lake and the spillway, metres. */
pub const FW_LAKE : f32 = 120.1;

/** The plunge pool's centre z and radius, metres. */
pub const FW_POOL_Z : f32 = 1074.0;
pub const FW_POOL_R : f32 = 40.0;

/** Depth of the pool at its centre, metres. */
pub const FW_POOL_DEPTH : f32 = 9.0;

// The lake: an ellipse on the plateau.
const FW_LAKE_X : f32 = 1536.0;
const FW_LAKE_Z : f32 = 560.0;
const FW_LAKE_RX : f32 = 440.0;
const FW_LAKE_RZ : f32 = 340.0;
const FW_LAKE_DEPTH : f32 = 26.0;

// The spillway between the lake and the lip: its start, half width and the dip of its bed under the plateau.
const FW_SPILL_Z : f32 = 880.0;
const FW_SPILL_HALF : f32 = 38.0;
const FW_SPILL_DIP : f32 = 3.2;

// The river: wavelength and growth of the meander, the half width, the riffle spacing, the depth range, the bank
// height over the water.
const FW_MEANDER : f32 = 900.0;
const FW_AMPLITUDE : f32 = 110.0;
const FW_HALF_WIDTH : f32 = 26.0;
const FW_RIFFLE : f32 = 170.0;
const FW_DEPTH_MIN : f32 = 0.95;
const FW_DEPTH_RANGE : f32 = 2.4;
const FW_BANK : f32 = 0.55;
const FW_FALL : f32 = 0.0052;

// The mountains: where the walls begin and are complete, their height range, the north and south ramps.
const FW_WALL_NEAR : f32 = 380.0;
const FW_WALL_FAR : f32 = 1250.0;
const FW_RANGE_LOW : f32 = 120.0;
const FW_RANGE_HIGH : f32 = 460.0;
const FW_NORTH : f32 = 320.0;
const FW_SOUTH : f32 = 380.0;

// Noise seeds and scales.
const FW_SEED_RIDGE : i32 = 211;
const FW_SEED_DETAIL : i32 = 223;
const FW_SEED_LIP : i32 = 229;
const FW_SEED_ROLL : i32 = 233;
const FW_SEED_PATCH : i32 = 239;

/** What the world says about the river at one place. */
pub struct FallRiver {
    /** Signed distance from the river's centre line, metres, positive east. */
    pub lateral : f32 = (0.0 as f32);

    /** The channel's half width here, metres. */
    pub half : f32 = (1.0 as f32);

    /** Position across the channel in half widths from the deepest line: 0 at it, 1 at the bank. */
    pub across : f32 = (0.0 as f32);

    /** Where in a riffle and pool cycle, 0 pool to 1 riffle crest. */
    pub riffle : f32 = (0.0 as f32);

    /** Unit direction of flow along x. */
    pub flowX : f32 = (0.0 as f32);

    /** Unit direction of flow along z. */
    pub flowZ : f32 = (1.0 as f32);
}

/** The landscape's formulas. */
pub class FallWorld {
    /** The meander's amplitude at `z`: none at the cliff, full from 1900 m south. */
    pub static fn amplitude(z : f32) : f32 {
        return FW_AMPLITUDE * smoothstep(FW_LIP + (60.0 as f32), FW_LIP + (860.0 as f32), z);
    }

    /** The river centre's x at `z`. */
    pub static fn centreX(z : f32) : f32 {
        return FW_CENTRE + FallWorld::amplitude(z) * sin(TAU * (z - FW_LIP) / FW_MEANDER + (0.4 as f32));
    }

    // The centre's slope dx/dz and its second derivative at `z`.
    static fn centreSlope(z : f32) : f32 {
        let k : f32 = TAU / FW_MEANDER;
        return FallWorld::amplitude(z) * k * cos(k * (z - FW_LIP) + (0.4 as f32));
    }

    static fn centreBend(z : f32) : f32 {
        let k : f32 = TAU / FW_MEANDER;
        return (0.0 as f32) - FallWorld::amplitude(z) * k * k * sin(k * (z - FW_LIP) + (0.4 as f32));
    }

    /** The floodplain's mean height at `z`, metres. */
    pub static fn plain(z : f32) : f32 {
        return FW_PLAIN - FW_FALL * max(z - FW_LIP, (0.0 as f32));
    }

    /** The river's water level at `z`, metres. */
    pub static fn level(z : f32) : f32 {
        return FallWorld::plain(z) - FW_BANK;
    }

    /** The river's geometry at (`x`, `z`). */
    pub static fn river(x : f32, z : f32) : FallRiver {
        let slope : f32 = FallWorld::centreSlope(z);
        let norm : f32 = sqrt((1.0 as f32) + slope * slope);
        let lateral : f32 = (x - FallWorld::centreX(z)) / norm;
        let half : f32 = FW_HALF_WIDTH + (5.0 as f32) * sin(TAU * z / (410.0 as f32) + (1.3 as f32));
        let bend : f32 = clamp(FallWorld::centreBend(z) / (0.0004 as f32), -(1.0 as f32), (1.0 as f32));
        let thalweg : f32 = (0.0 as f32) - bend * (0.32 as f32) * half;
        let riffle : f32 = (0.5 as f32) + (0.5 as f32) * sin(TAU * z / FW_RIFFLE);
        return FallRiver {
            lateral: lateral,
            half: half,
            across: (lateral - thalweg) / half,
            riffle: riffle,
            flowX: slope / norm,
            flowZ: (1.0 as f32) / norm,
        };
    }

    // The ridged fractal of the mountains, in 0..1.
    static fn ridged(x : f32, z : f32) : f32 {
        let mut sum : f32 = (0.0 as f32);
        let mut amp : f32 = (0.5 as f32);
        let mut fx : f32 = x * (0.0026 as f32);
        let mut fz : f32 = z * (0.0026 as f32);
        for (o of 0..4) {
            let v : f32 = waterValue2(fx, fz, FW_SEED_RIDGE + o * 17);
            let r : f32 = (1.0 as f32) - abs((2.0 as f32) * v - (1.0 as f32));
            sum = sum + amp * r * ((0.55 as f32) + (0.45 as f32) * r);
            amp = amp * (0.5 as f32);
            fx = fx * (2.03 as f32);
            fz = fz * (2.03 as f32);
        }
        return saturate(sum * (1.35 as f32));
    }

    // The lake ellipse's "inside" measure: 1 at the centre, 0 on the shore, negative outside.
    static fn lakeInside(x : f32, z : f32) : f32 {
        let a : f32 = (x - FW_LAKE_X) / FW_LAKE_RX;
        let b : f32 = (z - FW_LAKE_Z) / FW_LAKE_RZ;
        return (1.0 as f32) - a * a - b * b;
    }

    /** True when (`x`, `z`) is under the lake's flat water plane: inside the ellipse and below the lake level. */
    pub static fn inLake(x : f32, z : f32) : bool {
        return FallWorld::lakeInside(x, z) > (0.0 as f32) && z < FW_SPILL_Z + (20.0 as f32);
    }

    // The lip's z at x: irregular by several metres.
    static fn lipAt(x : f32) : f32 {
        return FW_LIP
            + (34.0 as f32) * (waterFbm2(x * (0.007 as f32), (7.0 as f32), 3, FW_SEED_LIP) - (0.5 as f32));
    }

    // How much of the plateau a point still stands on: 1 above the lip, 0 below the cliff's foot.
    static fn onPlateau(x : f32, z : f32) : f32 {
        let lip : f32 = FallWorld::lipAt(x);
        return (1.0 as f32) - smoothstep(lip, lip + (12.0 as f32), z);
    }

    /** The mountains' height over the valley floor at (`x`, `z`), metres. */
    static fn mountains(x : f32, z : f32, wall : f32) : f32 {
        let r : f32 = FallWorld::ridged(x, z);
        let range : f32 = FW_RANGE_LOW + FW_RANGE_HIGH * smoothstep((0.1 as f32), (0.95 as f32), r);
        let north : f32 = FW_NORTH * smoothstep((520.0 as f32), (0.0 as f32), z)
            * ((0.4 as f32) + (0.6 as f32) * r);
        let south : f32 = FW_SOUTH * smoothstep((2650.0 as f32), (3050.0 as f32), z)
            * ((0.5 as f32) + (0.5 as f32) * r);
        return wall * range + north + south;
    }

    /** The channel's carving under the plain at (`x`, `z`), metres: the river bed and the plunge pool. */
    pub static fn carve(x : f32, z : f32) : f32 {
        if (z < FW_LIP + (12.0 as f32)) {
            return (0.0 as f32);
        }
        let river : FallRiver = FallWorld::river(x, z);
        let depthHere : f32 = FW_DEPTH_MIN + FW_DEPTH_RANGE * river.riffle * sqrt(river.riffle);
        let u : f32 = river.across;
        let profile : f32 = max((0.0 as f32), (1.0 as f32) - u * u);
        let entry : f32 = smoothstep(FW_LIP + (20.0 as f32), FW_LIP + (120.0 as f32), z);
        let channel : f32 = depthHere * profile * sqrt(profile) * entry;
        let dx : f32 = x - FW_CENTRE;
        let dz : f32 = z - FW_POOL_Z;
        let r : f32 = sqrt(dx * dx + dz * dz) / FW_POOL_R;
        let pool : f32 = FW_POOL_DEPTH * max((0.0 as f32), (1.0 as f32) - r * r);
        return max(channel, pool);
    }

    /** The ground's height at (`x`, `z`), metres: the bed under any water. */
    pub static fn height(x : f32, z : f32) : f32 {
        let dv : f32 = abs(x - FW_CENTRE);
        let inside : f32 = FallWorld::lakeInside(x, z);
        let wall : f32 = smoothstep(FW_WALL_NEAR, FW_WALL_FAR, dv)
            * ((1.0 as f32) - smoothstep((0.0 as f32), (0.25 as f32), inside));
        let plateau : f32 = FallWorld::onPlateau(x, z);
        let river : FallRiver = FallWorld::river(x, z);
        let away : f32 = smoothstep((1.6 as f32), (3.2 as f32), abs(river.across));
        let roll : f32 = (1.4 as f32)
            * (waterFbm2(x * (0.016 as f32), z * (0.016 as f32), 3, FW_SEED_ROLL) - (0.5 as f32))
            * ((1.0 as f32) - wall)
            * away;
        let fine : f32 = (0.9 as f32)
            * (waterFbm2(x * (0.11 as f32), z * (0.11 as f32), 2, FW_SEED_DETAIL) - (0.5 as f32))
            * ((0.35 as f32) + wall)
            * away;
        let face : f32 = (22.0 as f32)
            * (waterFbm2(x * (0.035 as f32), z * (0.035 as f32), 3, FW_SEED_DETAIL + 9) - (0.5 as f32))
            * plateau
            * ((1.0 as f32) - plateau);
        let floor : f32 = FallWorld::plain(z) + FW_CLIFF * plateau + roll + face;
        let mut h : f32 = floor + FallWorld::mountains(x, z, wall) + fine;
        h = h - FW_LAKE_DEPTH * smoothstep((0.0 as f32), (0.45 as f32), inside);
        h = FallWorld::spillway(h, x, z);
        return h - FallWorld::carve(x, z);
    }

    // The bed of the channel that carries the lake over the lip.
    static fn spillway(h : f32, x : f32, z : f32) : f32 {
        let dx : f32 = abs(x - FW_CENTRE);
        let side : f32 = (1.0 as f32)
            - smoothstep(FW_SPILL_HALF * (0.7 as f32), FW_SPILL_HALF * (1.25 as f32), dx);
        let along : f32 = smoothstep(FW_SPILL_Z - (30.0 as f32), FW_SPILL_Z + (10.0 as f32), z)
            * ((1.0 as f32) - smoothstep(FW_LIP + (6.0 as f32), FW_LIP + (14.0 as f32), z));
        let t : f32 = dx / FW_SPILL_HALF;
        let bed : f32 = FW_PLATEAU - (1.0 as f32) - FW_SPILL_DIP * max((0.0 as f32), (1.0 as f32) - t * t);
        return lerp(h, bed, side * along);
    }

    /** Water level at (`x`, `z`) metres where the world has a moving body of water, else a negative number. */
    pub static fn waterLevel(x : f32, z : f32) : f32 {
        if (z > FW_SPILL_Z - (30.0 as f32) && z < FW_LIP + (14.0 as f32)) {
            if (abs(x - FW_CENTRE) < FW_SPILL_HALF * (1.2 as f32)) {
                return FW_LAKE - (0.0004 as f32) * (z - FW_SPILL_Z);
            }
            return -(1.0 as f32);
        }
        if (z < FW_LIP + (14.0 as f32)) {
            return -(1.0 as f32);
        }
        let river : FallRiver = FallWorld::river(x, z);
        let dx : f32 = x - FW_CENTRE;
        let dz : f32 = z - FW_POOL_Z;
        let inPool : bool = (dx * dx + dz * dz) < (FW_POOL_R * (1.2 as f32)) * (FW_POOL_R * (1.2 as f32));
        if (abs(river.across) < (1.3 as f32) || inPool) {
            return FallWorld::level(z);
        }
        return -(1.0 as f32);
    }

    /** The terrain's four masks at (`x`, `z`) given the height `h` and the slope (rise over run) there. */
    pub static fn rock(h : f32, slope : f32) : f32 {
        return saturate(smoothstep((0.85 as f32), (1.35 as f32), slope)
            + (0.5 as f32) * smoothstep((430.0 as f32), (640.0 as f32), h));
    }

    pub static fn forest(x : f32, z : f32, h : f32, slope : f32) : f32 {
        let river : FallRiver = FallWorld::river(x, z);
        let bank : f32 = smoothstep((2.4 as f32), (4.6 as f32), abs(river.across))
            + ((1.0 as f32) - smoothstep(FW_LIP, FW_LIP + (20.0 as f32), z));
        let patch : f32 = smoothstep(
            (0.26 as f32),
            (0.7 as f32),
            waterFbm2(x * (0.0065 as f32), z * (0.0065 as f32), 3, FW_SEED_PATCH)
        );
        let inside : f32 = FallWorld::lakeInside(x, z);
        let dry : f32 = smoothstep((0.0 as f32), (0.1 as f32), (0.0 as f32) - inside)
            + smoothstep((0.0 as f32), (0.2 as f32), (0.2 as f32) - abs(inside));
        let rooted : f32 = ((1.0 as f32) - smoothstep((0.6 as f32), (1.0 as f32), slope))
            * ((1.0 as f32) - smoothstep((380.0 as f32), (540.0 as f32), h));
        return saturate(min(bank, (1.0 as f32)) * patch * rooted * min(dry + (0.5 as f32), (1.0 as f32)));
    }

    /** The lake mask byte at (`x`, `z`): 255 under the lake's plane, else 0. */
    pub static fn lakeByte(x : f32, z : f32) : u8 {
        if (FallWorld::inLake(x, z)) {
            return 255 as u8;
        }
        return 0 as u8;
    }
}

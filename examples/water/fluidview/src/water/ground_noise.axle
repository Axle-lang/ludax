// ground_noise — the few noise shapes the ground materials are built from, beyond value noise.
//
// Value noise (`noise`) gives clouds of brightness; the ground also needs cells (pebbles, crowns, rock chips: a
// nearest feature point with its offset, so a dome can be tilted), a soft threshold that turns a mask plus noise
// into a ragged but continuous edge, and a triplanar slope so a micro-relief wraps a wall as well as a floor
// without stretching. All are pure functions of position and seed, so every thread draws the same bits.

use ludax::{abs, max, saturate, smoothstep, sqrt, Vec3};

use crate::water::noise::{waterFloor, waterHash, waterValue2Slope};

// How far a feature point may sit from the middle of its cell.
const GN_JITTER : f32 = 0.8;

/** The nearest feature point of a cellular lattice. */
pub struct GroundCell {
    /** Distance to the nearest point, in cells. */
    pub dist : f32 = (1.0 as f32);

    /** Distance to the second nearest, in cells: the gap between the two is the seam between cells. */
    pub second : f32 = (1.0 as f32);

    /** Offset from the pixel to the nearest point, in cells, in x and z. */
    pub dx : f32 = (0.0 as f32);
    pub dz : f32 = (0.0 as f32);

    /** A number in 0 to 1 that is the same for every pixel of the cell. */
    pub id : f32 = (0.0 as f32);
}

/** The cell of the lattice with unit spacing that holds (`x`, `z`), with its nearest two feature points. */
pub fn groundCells(x : f32, z : f32, seed : i32) : GroundCell {
    let ix : i32 = waterFloor(x);
    let iz : i32 = waterFloor(z);
    let fx : f32 = x - (ix as f32);
    let fz : f32 = z - (iz as f32);
    let mut best : f32 = (9.0 as f32);
    let mut next : f32 = (9.0 as f32);
    let mut bx : f32 = (0.0 as f32);
    let mut bz : f32 = (0.0 as f32);
    let mut id : f32 = (0.0 as f32);
    for (j of -1..2) {
        for (i of -1..2) {
            let off : f32 = ((1.0 as f32) - GN_JITTER) * (0.5 as f32);
            let px : f32 = (i as f32) + off + waterHash(ix + i, 1, iz + j, seed) * GN_JITTER - fx;
            let pz : f32 = (j as f32) + off + waterHash(ix + i, 2, iz + j, seed) * GN_JITTER - fz;
            let d : f32 = px * px + pz * pz;
            if (d < best) {
                next = best;
                best = d;
                bx = px;
                bz = pz;
                id = waterHash(ix + i, 3, iz + j, seed);
            } else if (d < next) {
                next = d;
            }
        }
    }
    return GroundCell { dist: sqrt(best), second: sqrt(next), dx: bx, dz: bz, id: id };
}

/**
 * A mask roughened by noise: `mask` plus `(noise - 0.5) * rag` pushed through a smooth step of the given width, so the
 * edge between where the mask is high and low wanders with the noise but is continuous, never a stair.
 */
pub fn groundRagged(mask : f32, noise : f32, rag : f32, width : f32) : f32 {
    let v : f32 = mask + (noise - (0.5 as f32)) * rag;
    return smoothstep((0.5 as f32) - width, (0.5 as f32) + width, v);
}

/** The triplanar weights of the unit normal `n`: how much each of the planes xz, xy, zy faces the pixel, summing to 1. */
pub fn groundPlanes(n : Vec3) : Vec3 {
    let a : f32 = abs(n.y);
    let b : f32 = abs(n.z);
    let c : f32 = abs(n.x);
    let wa : f32 = a * a * a * a;
    let wb : f32 = b * b * b * b;
    let wc : f32 = c * c * c * c;
    let sum : f32 = max(wa + wb + wc, (0.0001 as f32));
    return Vec3 { x: wa / sum, y: wb / sum, z: wc / sum };
}

/**
 * The slope in world axes (metres of height per metre, for a noise of height 1) of value noise of wavelength `wave`
 * metres, mapped onto the three planes by `weights` (from `groundPlanes`): a floor tilts in x and z, a wall in the
 * axes that lie in it. Multiply by the relief's height in metres.
 */
pub fn groundSlope3(p : Vec3, wave : f32, weights : Vec3, seed : i32) : Vec3 {
    let inv : f32 = (1.0 as f32) / wave;
    let mut g : Vec3 = Vec3::zero();
    if (weights.x > (0.01 as f32)) {
        let s : Vec3 = waterValue2Slope(p.x * inv, p.z * inv, seed);
        g = g.plus(Vec3 { x: s.y, y: (0.0 as f32), z: s.z }.scale(weights.x));
    }
    if (weights.y > (0.01 as f32)) {
        let s : Vec3 = waterValue2Slope(p.x * inv, p.y * inv * (1.4 as f32), seed + 5);
        g = g.plus(Vec3 { x: s.y, y: s.z * (1.4 as f32), z: (0.0 as f32) }.scale(weights.y));
    }
    if (weights.z > (0.01 as f32)) {
        let s : Vec3 = waterValue2Slope(p.z * inv, p.y * inv * (1.4 as f32), seed + 9);
        g = g.plus(Vec3 { x: (0.0 as f32), y: s.z * (1.4 as f32), z: s.y }.scale(weights.z));
    }
    return g.scale(inv);
}

/** A feature fade: 1 while the pixel `footprint` is under `lo` times the feature's `size`, 0 once it is over `hi` times. */
pub fn groundFade(size : f32, footprint : f32, lo : f32, hi : f32) : f32 {
    return saturate(((1.0 as f32) - smoothstep(size * lo, size * hi, footprint)));
}

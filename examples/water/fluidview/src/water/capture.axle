// capture — copies a `FluidWorld` into a `WaterScene`: the one place the renderer touches the engine.
//
// Everything else in the renderer reads the scene's own arrays, so the engine can change its storage without the
// picture code noticing; this file is the adapter. It samples every column at its centre (`x + 0.5`, `z + 0.5`,
// where the field's values sit), copies the particle layer (a particle's `life` is the fade from 1 to 0, the scene's
// `age` the progress from 0 to 1), and hands over the rules the water ran with, so the picture follows the gravity
// and viscosity of the simulation: the scene's look keeps every other setting the author made.

use ludax::{DVec2, FluidParticle, FluidParticleKind, FluidRules, FluidWorld, Vec3};

use crate::water::field::FieldColumn;
use crate::water::particles::{WaterDrop, WaterKind};
use crate::water::scene::WaterScene;

// Half a column: where a column's value sits.
const CAPTURE_CENTRE : f64 = 0.5;

/** Reads the engine into the renderer. */
pub class WaterCapture {
    /** Copies the columns, the particles, the time and the physics of `world` into `scene`; the sizes must match. */
    pub static fn world(scene : Shared<WaterScene>, world : FluidWorld) : void {
        let rules : FluidRules = world.settings();
        scene.look.physics.gravity = rules.gravity as f32;
        scene.look.physics.viscosity = rules.viscosity as f32;
        scene.time = (world.tickCount() as f64) * rules.dt;
        WaterCapture::columns(scene, world);
        WaterCapture::particles(scene, world);
    }

    // Every column's bed, depth, foam, turbulence and surface velocity.
    static fn columns(scene : Shared<WaterScene>, world : FluidWorld) : void {
        for (z of 0..world.depth()) {
            for (x of 0..world.width()) {
                let cx : f64 = (x as f64) + CAPTURE_CENTRE;
                let cz : f64 = (z as f64) + CAPTURE_CENTRE;
                let flow : DVec2 = world.surfaceVelocityAt(cx, cz);
                scene.field.put(x, z, FieldColumn {
                    bed: world.bedHeightAt(cx, cz) as f32,
                    depth: world.depthAt(cx, cz) as f32,
                    foam: world.foamAt(cx, cz),
                    turbulence: world.turbulenceAt(cx, cz),
                    vx: flow.x as f32,
                    vz: flow.y as f32,
                });
            }
        }
    }

    // The particle layer, in the engine's order.
    static fn particles(scene : Shared<WaterScene>, world : FluidWorld) : void {
        scene.particles.clear();
        for (k of 0..world.particleCount()) {
            let p : FluidParticle = world.particleAt(k);
            scene.particles.add(WaterDrop {
                position: Vec3 { x: p.position.x as f32, y: p.position.y as f32, z: p.position.z as f32 },
                velocity: Vec3 { x: p.velocity.x as f32, y: p.velocity.y as f32, z: p.velocity.z as f32 },
                radius: p.radius as f32,
                kind: WaterCapture::kind(p.kind),
                age: (1.0 as f32) - (p.life as f32),
            });
        }
    }

    // The renderer's name for an engine population.
    static fn kind(kind : FluidParticleKind) : WaterKind {
        return match kind {
            FluidParticleKind::Liquid => WaterKind::Liquid,
            FluidParticleKind::Spray => WaterKind::Spray,
        };
    }
}

// ground_site — what the material shaders are told of a point, and what each answers.
//
// The ground shader is a blend of material functions (rock, soil, grass, gravel...). They share one question and
// one answer so a material is a pure function that can be tested alone: the `GroundSite` is the place (position,
// the terrain's smooth normal and its steepness, how big a pixel is there, how damp it is) and the `GroundPatch` is
// a colour, the tilt that micro-relief gives the normal, and how shiny the surface is. The tilt is the slope of a
// height field in world axes: the shader subtracts its tangential part from the normal, so a tilt written for a wall
// (all in `y`) and one written for a floor (in `x` and `z`) blend as plain vectors.

use ludax::Vec3;

/** A point of the ground. */
pub struct GroundSite {
    /** World position, metres. */
    pub p : Vec3 = Vec3 { x: (0.0 as f32), y: (0.0 as f32), z: (0.0 as f32) };

    /** The terrain's smooth unit normal. */
    pub n : Vec3 = Vec3 { x: (0.0 as f32), y: (1.0 as f32), z: (0.0 as f32) };

    /** Rise over run of the terrain, 0 flat; large on a wall. */
    pub slope : f32 = (0.0 as f32);

    /** Size of a pixel at the point, metres: detail finer than this averages out. */
    pub footprint : f32 = (0.1 as f32);

    /** Wetness of the surface, 0 dry to 1 soaked. */
    pub damp : f32 = (0.0 as f32);

    /** Distance from the eye, metres: the trees are shapes nearer than the plant range and texture beyond. */
    pub distance : f32 = (1000000.0 as f32);

    /** False for a reflection or a second look, which skips the fine detail. */
    pub fine : bool = true;
}

/** What a material makes of a site. */
pub struct GroundPatch {
    /** Linear albedo. */
    pub albedo : Vec3 = Vec3 { x: (0.2 as f32), y: (0.2 as f32), z: (0.2 as f32) };

    /** Slope of the micro-relief in world axes. */
    pub tilt : Vec3 = Vec3 { x: (0.0 as f32), y: (0.0 as f32), z: (0.0 as f32) };

    /** How much the surface shines when wet or icy, 0 matt to 1. */
    pub gloss : f32 = (0.0 as f32);

    /** Occlusion of the surface by its own relief, 1 open to 0 closed. */
    pub open : f32 = (1.0 as f32);

    /** The share of the sun that reaches the surface through whatever stands over it (a canopy), 0 to 1. */
    pub sun : f32 = (1.0 as f32);
}

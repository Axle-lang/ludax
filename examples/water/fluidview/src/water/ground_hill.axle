// ground_hill — what a hillside is made of at the scale of gullies: ribs, rills and outcrops.
//
// The terrain's grid is four metres to a texel, so a mountain flank is a smooth ramp with no erosion on it. Two scales
// of noise are laid on it, tens of metres and a few: each brightens and darkens the ground and, through its slope,
// tilts the normal, so the ribs are lit and not merely painted. They are isotropic on purpose: a gully pattern that
// follows the fall line needs a coordinate along the slope, and the terrain's interpolated normal is not stable enough
// at world coordinates in the thousands to give one without swirls. The small scale averages out when a pixel
// outgrows it. Steeper flanks rib more, a flat floor not at all; bare rock shows where the noise ridges.

use ludax::{saturate, smoothstep, Vec3};

use crate::water::ground_noise::groundFade;
use crate::water::ground_site::GroundSite;
use crate::water::noise::{waterFbm2, waterValue2Slope};

// Seeds.
const GH_SEED_RIB : i32 = 801;
const GH_SEED_OUTCROP : i32 = 811;

// Metres across a big rib and a small rill.
const GH_RIB : f32 = 34.0;
const GH_RILL : f32 = 6.5;

// The ribbing comes in on slopes between these (rise over run).
const GH_LOW : f32 = 0.18;
const GH_HIGH : f32 = 0.55;

/** The ribbing of a hillside at a site. */
pub struct HillRibs {
    /** Brightness factor, around 1: dark in a gully, bright on a rib. */
    pub shade : f32 = (1.0 as f32);

    /** The tilt the ribs give the normal, in world axes. */
    pub tilt : Vec3 = Vec3 { x: (0.0 as f32), y: (0.0 as f32), z: (0.0 as f32) };

    /** How much rock stands out of the soil on the ribs, 0 to 1: outcrops. */
    pub outcrop : f32 = (0.0 as f32);
}

/** Gullies and ribs. */
pub class GroundHill {
    /** The ribbing at `site`. */
    pub static fn ribs(site : GroundSite) : HillRibs {
        let strength : f32 = smoothstep(GH_LOW, GH_HIGH, site.slope);
        if (strength <= (0.0 as f32)) {
            return HillRibs {};
        }
        let big : Vec3 = waterValue2Slope(site.p.x / GH_RIB, site.p.z / GH_RIB, GH_SEED_RIB);
        let mut shade : f32 = (big.x - (0.5 as f32)) * (0.9 as f32);
        let mut tilt : Vec3 = Vec3 { x: big.y, y: (0.0 as f32), z: big.z }.scale((6.0 as f32) / GH_RIB);
        let near : f32 = groundFade(GH_RILL, site.footprint, 0.3, 1.5);
        if (near > (0.0 as f32)) {
            let small : Vec3 = waterValue2Slope(site.p.x / GH_RILL, site.p.z / GH_RILL, GH_SEED_RIB + 5);
            shade = shade + (small.x - (0.5 as f32)) * (0.6 as f32) * near;
            tilt = tilt.plus(Vec3 { x: small.y, y: (0.0 as f32), z: small.z }.scale((1.2 as f32) / GH_RILL
                * near));
        }
        let bare : f32 = waterFbm2(site.p.x * (0.02 as f32), site.p.z * (0.02 as f32), 3, GH_SEED_OUTCROP);
        let ridge : f32 = smoothstep((0.0 as f32), (0.35 as f32), shade)
            * smoothstep((0.5 as f32), (0.7 as f32), bare);
        return HillRibs {
            shade: (1.0 as f32) + shade * strength,
            tilt: tilt.scale(strength),
            outcrop: saturate(ridge) * strength,
        };
    }
}

// scene — what a demo hands the renderer each frame: the water's field, the drops, the look and the time.
//
// A scene author owns one `WaterScene` for the life of a window. Every frame it fills `field` (through `capture`
// from a `FluidWorld`, or `put` column by column for a hand-made world) and `particles`, sets `time`, and gives the
// scene to `WaterRenderer::render`. The look is a plain value the author may change at any moment (a slider, a
// time of day); nothing is cached against it except the sky, which the renderer re-bakes when the time of day moves.

use crate::water::field::WaterField;
use crate::water::look::WaterLook;
use crate::water::particles::WaterParticles;

/** The most drops a scene holds unless it asks for more. */
pub const SCENE_DROPS : i32 = 400000;

/** Everything the renderer reads of one frame of the world. */
pub class WaterScene {
    /** The ground and the water over it, column by column. */
    pub field : Shared<WaterField>;

    /** The airborne particles. */
    pub particles : WaterParticles;

    /** How the frame is painted. */
    pub look : WaterLook = WaterLook {};

    /** Simulation seconds: ripples, foam and billows move with it, so a still sim gives a still picture. */
    pub time : f64 = 0.0;

    /** A scene over a world of `width` by `depth` columns that holds at most `drops` particles. */
    constructor(width : i32, depth : i32, drops : i32) {
        self.field = share new WaterField(width, depth);
        self.particles = new WaterParticles(drops);
    }
}

// skygrid — a latitude-longitude grid of sky radiance: the one picture the sky is looked up in.
//
// Three interleaved f32 channels per cell, azimuth along x (it wraps) and elevation along y (it is clamped). The
// sky bakes one grid when its time of day changes and blurs it into coarser grids; a row is written by one job
// only, so a job pool may bake different rows at the same time. This is lumen's grid, kept small: the water
// renderer needs the lookup and the blur and nothing else.

use ludax::{clamp, Vec2, Vec3};

use crate::water::noise::waterFloor;

/** A grid of RGB radiance, `w` cells around and `h` cells from the nadir to the zenith. */
pub class WaterSkyGrid {
    data : f32[];

    /** Cells around the horizon. */
    pub w : i32;

    /** Cells from the nadir to the zenith. */
    pub h : i32;

    /** An empty (all zero) grid of `w` x `h` cells. */
    constructor(w : i32, h : i32) {
        self.data = new f32[(w as i64) * h * 3];
        self.w = w;
        self.h = h;
        for (i of 0..((w as i64) * h * 3)) {
            self.data[i] = 0.0;
        }
    }

    fn channel(self, x : i32, y : i32) : i64 {
        return (((y * self.w) + x) * 3) as i64;
    }

    /** Stores the radiance `c` in the cell (`x`, `y`). */
    pub fn put(mut self, x : i32, y : i32, c : Vec3) : void {
        let at : i64 = self.channel(x, y);
        self.data[at] = c.x;
        self.data[at + 1] = c.y;
        self.data[at + 2] = c.z;
    }

    /** The radiance stored in the cell (`x`, `y`). */
    pub fn texel(self, x : i32, y : i32) : Vec3 {
        let at : i64 = self.channel(x, y);
        return Vec3 { x: self.data[at], y: self.data[at + 1], z: self.data[at + 2] };
    }

    /** The radiance at `place` as (u, v) in 0..1, read bilinearly: azimuth wraps, elevation is clamped. */
    pub fn look(self, place : Vec2) : Vec3 {
        let half : f32 = 0.5;
        let fx : f32 = place.x * (self.w as f32) - half;
        let fy : f32 = clamp(place.y * (self.h as f32) - half, 0.0, (self.h - 1) as f32);
        let x0 : i32 = waterFloor(fx);
        let y0 : i32 = waterFloor(fy);
        let tx : f32 = fx - x0 as f32;
        let ty : f32 = fy - y0 as f32;

        let xa : i32 = (x0 + self.w) % self.w;
        let xb : i32 = (x0 + 1 + self.w) % self.w;
        let mut y1 : i32 = y0 + 1;
        if (y1 >= self.h) {
            y1 = self.h - 1;
        }

        let a : Vec3 = self.texel(xa, y0).lerp(self.texel(xb, y0), tx);
        let b : Vec3 = self.texel(xa, y1).lerp(self.texel(xb, y1), tx);
        return a.lerp(b, ty);
    }

    /** Fills `coarse` with the mean of each block of this grid's cells; `coarse` must divide this grid evenly. */
    pub fn downsampleInto(self, coarse : WaterSkyGrid) : void {
        let blockW : i32 = self.w / coarse.w;
        let blockH : i32 = self.h / coarse.h;
        let share : f32 = (1.0 as f32) / ((blockW * blockH) as f32);
        for (j of 0..coarse.h) {
            for (i of 0..coarse.w) {
                let mut sum : Vec3 = Vec3::zero();
                for (v of 0..blockH) {
                    for (u of 0..blockW) {
                        sum = sum.plus(self.texel(i * blockW + u, j * blockH + v));
                    }
                }
                coarse.put(i, j, sum.scale(share));
            }
        }
    }
}

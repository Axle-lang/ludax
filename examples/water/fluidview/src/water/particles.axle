// particles — the drops of a frame as flat arrays: where they are, how they move, how big, which kind.
//
// The engine's particle layer is a list of structs; the renderer wants to walk it three times (sort by depth, bin
// into screen tiles, splat) and to split it by kind. So a frame copies it once into parallel f32 arrays of a
// fixed capacity: a particle beyond the capacity is counted and dropped rather than growing a buffer inside a
// frame, which keeps the frame's memory and cost bounded. Positions are f32 in the field's own cell coordinates
// (x and z are columns, y is height): the renderer works camera-relative in single precision.

use ludax::Vec3;

/** What a particle is, which decides how the renderer draws it. */
pub enum WaterKind : i8 {
    /** A coherent drop of water, the largest: drawn as a lit sphere with a bright rim. */
    Liquid,

    /** A fine droplet torn off a jet or a crest: drawn small, bright and streaked. */
    Spray,
}

/** One particle, as a scene author builds it. */
pub struct WaterDrop {
    /** Where it is, in cells (x and z columns, y height). */
    pub position : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** How it moves, cells a second. */
    pub velocity : Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    /** Its radius, cells. */
    pub radius : f32 = 0.05;

    /** Its kind. */
    pub kind : WaterKind = WaterKind::Spray;

    /** How far through its life it is, 0 born to 1 gone: drops fade as it grows. */
    pub age : f32 = 0.0;
}

/** The particles of one frame. */
pub class WaterParticles {
    /** How many particles are held. */
    pub count : i32 = 0;

    /** How many the capacity refused since the last `clear`. */
    pub refused : i32 = 0;

    /** The most particles held. */
    pub capacity : i32;

    positions  : f32[];
    velocities : f32[];
    sizes      : f32[];
    ages       : f32[];
    kinds      : i32[];

    /** An empty set that holds at most `capacity` particles. */
    constructor(capacity : i32) {
        self.capacity = capacity;
        self.positions = new f32[(capacity as i64) * 3];
        self.velocities = new f32[(capacity as i64) * 3];
        self.sizes = new f32[capacity as i64];
        self.ages = new f32[capacity as i64];
        self.kinds = new i32[capacity as i64];
    }

    /** Forgets every particle. */
    pub fn clear(mut self) : void {
        self.count = 0;
        self.refused = 0;
    }

    /** Adds a particle; it is counted in `refused` and dropped when the set is full. */
    pub fn add(mut self, item : WaterDrop) : void {
        if (self.count >= self.capacity) {
            self.refused = self.refused + 1;
            return;
        }
        let k : i64 = self.count as i64;
        self.positions[k * 3] = item.position.x;
        self.positions[k * 3 + 1] = item.position.y;
        self.positions[k * 3 + 2] = item.position.z;
        self.velocities[k * 3] = item.velocity.x;
        self.velocities[k * 3 + 1] = item.velocity.y;
        self.velocities[k * 3 + 2] = item.velocity.z;
        self.sizes[k] = item.radius;
        self.ages[k] = item.age;
        self.kinds[k] = particleCode(item.kind);
        self.count = self.count + 1;
    }

    /** The position of particle `k`. */
    pub fn positionAt(self, k : i32) : Vec3 {
        let i : i64 = (k as i64) * 3;
        return Vec3 { x: self.positions[i], y: self.positions[i + 1], z: self.positions[i + 2] };
    }

    /** The velocity of particle `k`. */
    pub fn velocityAt(self, k : i32) : Vec3 {
        let i : i64 = (k as i64) * 3;
        return Vec3 { x: self.velocities[i], y: self.velocities[i + 1], z: self.velocities[i + 2] };
    }

    /** The radius of particle `k`. */
    pub fn radiusAt(self, k : i32) : f32 {
        return self.sizes[k as i64];
    }

    /** How far through its life particle `k` is. */
    pub fn ageAt(self, k : i32) : f32 {
        return self.ages[k as i64];
    }

    /** The kind of particle `k`. */
    pub fn kindAt(self, k : i32) : WaterKind {
        return particleKind(self.kinds[k as i64]);
    }

    /** True when particle `k` is of kind `kind`. */
    pub fn isKind(self, k : i32, kind : WaterKind) : bool {
        return self.kinds[k as i64] == particleCode(kind);
    }
}

// The stored code of each kind: arrays hold plain integers, and these two are the one place that knows the mapping.
fn particleCode(kind : WaterKind) : i32 {
    return match kind {
        WaterKind::Liquid => 0,
        WaterKind::Spray => 1,
    };
}

fn particleKind(code : i32) : WaterKind {
    if (code == 0) {
        return WaterKind::Liquid;
    }
    return WaterKind::Spray;
}

// relief — the terrain the vista renderer looks at: heights, material masks and a baked sun and sky light.
//
// A `Relief` is the renderer's view of a landscape, whoever made it: a `HeightGrid` (metres, with its max-height
// pyramid), four `u8` material masks per texel (rock, forest, meadow, river bed) and two `u8` light maps baked
// for the sun of the frame, the soft sun visibility and the ambient occlusion. The light is baked per texel
// rather than marched per pixel because a pixel wants it smooth and cheap: one bilinear read of a byte map gives
// a soft shadow edge that has no stair-step, and the bake itself (a cone march over the heights toward the sun,
// and a horizon scan in eight directions) is paid once per time of day, in parallel by rows.
//
// Masks are sampled bilinearly, so a boundary between rock and forest is a smooth ramp the shader sharpens with
// noise; nothing here knows what the materials look like (`ground_shade` owns that). The generator that fills a
// `Relief` for the demo is `fall_world`; a landscape from the terrain package fills the same arrays.

use ludax::{max, min, saturate, sqrt, Vec3};

use crate::water::height_grid::HeightGrid;
use crate::water::noise::waterFloor;

/** Channels per texel of the material masks. */
pub const RELIEF_CHANNELS : i32 = 8;

/** Mask channel: bare rock. */
pub const RELIEF_ROCK : i32 = 0;

/** Mask channel: conifer forest density. */
pub const RELIEF_FOREST : i32 = 1;

/** Mask channel: meadow and grass. */
pub const RELIEF_MEADOW : i32 = 2;

/** Mask channel: river bed, sand and gravel. */
pub const RELIEF_BED : i32 = 3;

/** Mask channel: loose stone (scree and talus); it is part of the rock the terrain's classes call scree. */
pub const RELIEF_SCREE : i32 = 4;

/** Mask channel: ploughed or cropped farmland. */
pub const RELIEF_FIELD : i32 = 5;

/** Mask channel: mud, the part of the river bed that stays wet and fine. */
pub const RELIEF_MUD : i32 = 6;

/** Mask channel: how wet the ground is by the lie of the land (the terrain's wetness hint), 0 dry to 1 soaked. */
pub const RELIEF_WET : i32 = 7;

/** Rows of the light bake one pool job covers. */
pub const RELIEF_ROWS_PER_JOB : i32 = 4;

// The shadow march: the first step and its growth, metres, the most steps and the farthest reach.
const RELIEF_SHADOW_FIRST : f32 = 2.0;
const RELIEF_SHADOW_GROWTH : f32 = 1.07;
const RELIEF_SHADOW_STEPS : i32 = 72;
const RELIEF_SHADOW_REACH : f32 = 2600.0;

// Angular softness of the shadow edge, as the tangent of the angle the sun and the sky blur it by.
const RELIEF_SOFT : f32 = 0.045;

// A shadow step is skipped when the ray clears the pyramid's ceiling of the surrounding block (of 2^level texels) by
// the whole penumbra (times a margin against rounding): its visibility term would be exactly 1.
const RELIEF_SKIP_LEVEL : i32 = 0;
const RELIEF_SKIP_MARGIN : f32 = 1.001;

// How far above the surface the shadow ray starts, metres: keeps a texel from shadowing itself.
const RELIEF_LIFT : f32 = 0.6;

// The occlusion scan: directions, steps and the nearest and farthest sample, metres.
const RELIEF_AO_DIRECTIONS : i32 = 8;
const RELIEF_AO_STEPS : i32 = 6;
const RELIEF_AO_NEAR : f32 = 3.0;
const RELIEF_AO_GROWTH : f32 = 2.0;

// A ray flatter than this never meets the lake's plane.
const RELIEF_FLAT : f32 = 0.00001;

// The byte maps: 255 is lit or open.
const RELIEF_BYTE : f32 = 255.0;

// The eight scan directions, as cosine and sine of a multiple of an eighth of a turn.
const RELIEF_DIAGONAL : f32 = 0.70710678;

/** Everything the ground shader reads of the relief at one point, from one cell computation. */
pub struct ReliefSpot {
    /** The four material masks, each 0 to 1. */
    pub rock   : f32 = (0.0 as f32);
    pub forest : f32 = (0.0 as f32);
    pub meadow : f32 = (0.0 as f32);
    pub bed    : f32 = (0.0 as f32);

    /** Loose stone, farmland, mud and the lie-of-the-land wetness, each 0 to 1. */
    pub scree : f32 = (0.0 as f32);
    pub field : f32 = (0.0 as f32);
    pub mud   : f32 = (0.0 as f32);
    pub wet   : f32 = (0.0 as f32);

    /** Sun visibility and sky openness, each 0 to 1. */
    pub sun  : f32 = (0.0 as f32);
    pub open : f32 = (0.0 as f32);
}

/** The terrain. */
pub class Relief {
    /** The heights and their pyramid. */
    pub grid : Shared<HeightGrid>;

    /** Material masks, `RELIEF_CHANNELS` bytes a texel in the order of the channel constants. */
    pub masks : u8[];

    /** Soft sun visibility, 0 shadowed to 255 lit, one byte a texel; valid after `bakeLight`. */
    pub sunlight : u8[];

    /** The lake's mask, 0 or 255 a texel (the basin the flat lake plane may fill), and the plane's height, metres. */
    pub lake      : u8[];
    pub lakeLevel : f32 = -1000000.0;

    /** Sky visibility, 0 enclosed to 255 open, one byte a texel; valid after `bakeLight`. */
    pub openness : u8[];

    baked    : bool = false;
    bakedSun : Vec3 = Vec3 { x: (0.0 as f32), y: (1.0 as f32), z: (0.0 as f32) };

    /** A relief over a grid of `w` by `d` texels `cell` metres apart, its corner at (`originX`, `originZ`). */
    constructor(w : i32, d : i32, cell : f32, originX : f32, originZ : f32) {
        self.grid = share new HeightGrid(w, d, cell, originX, originZ);
        let n : i64 = (w as i64) * d;
        self.masks = new u8[n * (RELIEF_CHANNELS as i64)];
        self.lake = new u8[n];
        self.sunlight = new u8[n];
        self.openness = new u8[n];
        for (i of 0..n) {
            self.sunlight[i] = 255 as u8;
            self.openness[i] = 255 as u8;
        }
    }

    /** Writes the four masks of texel (`x`, `z`), each 0 to 1. */
    pub fn setMasks(mut self, x : i32, z : i32, rock : f32, forest : f32, meadow : f32, bed : f32) : void {
        let at : i64 = (((z * self.grid.w) + x) as i64) * (RELIEF_CHANNELS as i64);
        self.masks[at] = Relief::toByte(rock);
        self.masks[at + 1] = Relief::toByte(forest);
        self.masks[at + 2] = Relief::toByte(meadow);
        self.masks[at + 3] = Relief::toByte(bed);
    }

    /** Writes the four extra masks of texel (`x`, `z`): scree, field, mud and wetness, each 0 to 1. */
    pub fn setExtras(mut self, x : i32, z : i32, scree : f32, field : f32, mud : f32, wet : f32) : void {
        let at : i64 = (((z * self.grid.w) + x) as i64) * (RELIEF_CHANNELS as i64);
        self.masks[at + 4] = Relief::toByte(scree);
        self.masks[at + 5] = Relief::toByte(field);
        self.masks[at + 6] = Relief::toByte(mud);
        self.masks[at + 7] = Relief::toByte(wet);
    }

    // A value in 0..1 as a byte, rounded.
    static fn toByte(v : f32) : u8 {
        return (saturate(v) * RELIEF_BYTE + (0.5 as f32)) as u8;
    }

    // A byte of a map at a clamped texel.
    fn texel(self, map : u8[], channels : i32, x : i32, z : i32, channel : i32) : f32 {
        let cx : i32 = reliefClamp(x, self.grid.w);
        let cz : i32 = reliefClamp(z, self.grid.d);
        let at : i64 = (((cz * self.grid.w) + cx) as i64) * (channels as i64) + (channel as i64);
        return (map[at] as f32) * ((1.0 as f32) / RELIEF_BYTE);
    }

    // The bilinear value of channel `channel` of a byte map at (`x`, `z`) metres.
    fn bilinear(self, map : u8[], channels : i32, channel : i32, x : f32, z : f32) : f32 {
        let u : f32 = (x - self.grid.originX) / self.grid.cell;
        let v : f32 = (z - self.grid.originZ) / self.grid.cell;
        let iu : i32 = waterFloor(u);
        let iv : i32 = waterFloor(v);
        let fu : f32 = u - (iu as f32);
        let fv : f32 = v - (iv as f32);
        let mut a : f32 = (0.0 as f32);
        let mut b : f32 = (0.0 as f32);
        let mut c : f32 = (0.0 as f32);
        let mut e : f32 = (0.0 as f32);
        if (iu >= 0 && iv >= 0 && iu < self.grid.w - 1 && iv < self.grid.d - 1) {
            let step : i64 = channels as i64;
            let base : i64 = (((iv * self.grid.w) + iu) as i64) * step + (channel as i64);
            let row : i64 = (self.grid.w as i64) * step;
            let unit : f32 = (1.0 as f32) / RELIEF_BYTE;
            a = (map[base] as f32) * unit;
            b = (map[base + step] as f32) * unit;
            c = (map[base + row] as f32) * unit;
            e = (map[base + row + step] as f32) * unit;
        } else {
            a = self.texel(map, channels, iu, iv, channel);
            b = self.texel(map, channels, iu + 1, iv, channel);
            c = self.texel(map, channels, iu, iv + 1, channel);
            e = self.texel(map, channels, iu + 1, iv + 1, channel);
        }
        let top : f32 = a + (b - a) * fu;
        let bottom : f32 = c + (e - c) * fu;
        return top + (bottom - top) * fv;
    }

    // The bilinear blend of four corner values.
    static fn blend(a : f32, b : f32, c : f32, e : f32, fu : f32, fv : f32) : f32 {
        let top : f32 = a + (b - a) * fu;
        let bottom : f32 = c + (e - c) * fu;
        return top + (bottom - top) * fv;
    }

    // One channel of the masks at the cell whose first corner is at byte offset `base`, a row `row` bytes on.
    fn channel(self, base : i64, row : i64, fu : f32, fv : f32) : f32 {
        let unit : f32 = (1.0 as f32) / RELIEF_BYTE;
        let step : i64 = RELIEF_CHANNELS as i64;
        return Relief::blend(
            (self.masks[base] as f32) * unit,
            (self.masks[base + step] as f32) * unit,
            (self.masks[base + row] as f32) * unit,
            (self.masks[base + row + step] as f32) * unit,
            fu,
            fv
        );
    }

    // One byte of a one-channel map blended at the cell whose first corner is at `base`, a row `row` on.
    static fn plane(map : u8[], base : i64, row : i64, fu : f32, fv : f32) : f32 {
        let unit : f32 = (1.0 as f32) / RELIEF_BYTE;
        return Relief::blend(
            (map[base] as f32) * unit,
            (map[base + 1] as f32) * unit,
            (map[base + row] as f32) * unit,
            (map[base + row + 1] as f32) * unit,
            fu,
            fv
        );
    }

    /** The masks and the baked light at (`x`, `z`), the cell found once; the same numbers `maskAt`, `sunAt` and `openAt` give. */
    pub fn spotAt(self, x : f32, z : f32) : ReliefSpot {
        let u : f32 = (x - self.grid.originX) / self.grid.cell;
        let v : f32 = (z - self.grid.originZ) / self.grid.cell;
        let iu : i32 = waterFloor(u);
        let iv : i32 = waterFloor(v);
        if (iu < 0 || iv < 0 || iu >= self.grid.w - 1 || iv >= self.grid.d - 1) {
            return ReliefSpot {
                rock: self.maskAt(RELIEF_ROCK, x, z),
                forest: self.maskAt(RELIEF_FOREST, x, z),
                meadow: self.maskAt(RELIEF_MEADOW, x, z),
                bed: self.maskAt(RELIEF_BED, x, z),
                scree: self.maskAt(RELIEF_SCREE, x, z),
                field: self.maskAt(RELIEF_FIELD, x, z),
                mud: self.maskAt(RELIEF_MUD, x, z),
                wet: self.maskAt(RELIEF_WET, x, z),
                sun: self.sunAt(x, z),
                open: self.openAt(x, z),
            };
        }
        let fu : f32 = u - (iu as f32);
        let fv : f32 = v - (iv as f32);
        let texel : i64 = ((iv * self.grid.w) + iu) as i64;
        let wide : i64 = self.grid.w as i64;
        let base : i64 = texel * (RELIEF_CHANNELS as i64);
        let row : i64 = wide * (RELIEF_CHANNELS as i64);
        return ReliefSpot {
            rock: self.channel(base + (RELIEF_ROCK as i64), row, fu, fv),
            forest: self.channel(base + (RELIEF_FOREST as i64), row, fu, fv),
            meadow: self.channel(base + (RELIEF_MEADOW as i64), row, fu, fv),
            bed: self.channel(base + (RELIEF_BED as i64), row, fu, fv),
            scree: self.channel(base + (RELIEF_SCREE as i64), row, fu, fv),
            field: self.channel(base + (RELIEF_FIELD as i64), row, fu, fv),
            mud: self.channel(base + (RELIEF_MUD as i64), row, fu, fv),
            wet: self.channel(base + (RELIEF_WET as i64), row, fu, fv),
            sun: Relief::plane(self.sunlight, texel, wide, fu, fv),
            open: Relief::plane(self.openness, texel, wide, fu, fv),
        };
    }

    /** Mask `channel` (a `RELIEF_*` constant) at (`x`, `z`), 0 to 1. */
    pub fn maskAt(self, channel : i32, x : f32, z : f32) : f32 {
        return self.bilinear(self.masks, RELIEF_CHANNELS, channel, x, z);
    }

    /** The lake mask at (`x`, `z`), 0 to 1. */
    pub fn lakeAt(self, x : f32, z : f32) : f32 {
        return self.bilinear(self.lake, 1, 0, x, z);
    }

    /**
     * The distance along a ray (`eye`, unit `dir`) to the lake's flat water, or -1 when it misses the lake or the
     * ground (distance `ground`, negative for none) comes first. The lake is where the mask is above one half and the
     * ground lies under the plane.
     */
    pub fn lakeHit(self, eye : Vec3, dir : Vec3, ground : f32) : f32 {
        if (dir.y >= -RELIEF_FLAT || eye.y <= self.lakeLevel) {
            return -1.0;
        }
        let t : f32 = (self.lakeLevel - eye.y) / dir.y;
        if (ground >= 0.0 && t > ground) {
            return -1.0;
        }
        let p : Vec3 = eye.plus(dir.scale(t));
        if (self.lakeAt(p.x, p.z) > 0.5 && self.grid.heightAt(p.x, p.z) < self.lakeLevel) {
            return t;
        }
        return -1.0;
    }

    /** Sun visibility at (`x`, `z`), 0 shadowed to 1 lit. */
    pub fn sunAt(self, x : f32, z : f32) : f32 {
        return self.bilinear(self.sunlight, 1, 0, x, z);
    }

    /** Sky visibility at (`x`, `z`), 0 to 1. */
    pub fn openAt(self, x : f32, z : f32) : f32 {
        return self.bilinear(self.openness, 1, 0, x, z);
    }

    /** True when the baked light is not the light of the sun direction `sun`. */
    pub fn needsBake(self, sun : Vec3) : bool {
        return !self.baked || self.bakedSun.distanceSquared(sun) != (0.0 as f32);
    }

    /** Records that the whole map has been baked for `sun`, so a second renderer of the same sky does not redo it. */
    pub fn markBaked(mut self, sun : Vec3) : void {
        self.baked = true;
        self.bakedSun = sun;
    }

    /** Rows of the light bake. */
    pub fn lightRows(self) : i32 {
        return self.grid.d;
    }

    /** Bakes sun visibility and openness for texel rows `begin` up to `end`, for the unit direction `sun` to the sun. */
    pub fn bakeLight(mut self, sun : Vec3, begin : i32, end : i32) : void {
        for (z of begin..end) {
            for (x of 0..self.grid.w) {
                let px : f32 = self.grid.originX + (x as f32) * self.grid.cell;
                let pz : f32 = self.grid.originZ + (z as f32) * self.grid.cell;
                let h : f32 = self.grid.heights[((z * self.grid.w) + x) as i64];
                let at : i64 = ((z * self.grid.w) + x) as i64;
                self.sunlight[at] = Relief::toByte(self.sunVisibility(px, h + RELIEF_LIFT, pz, sun));
                self.openness[at] = Relief::toByte(self.skyVisibility(px, h, pz));
            }
        }
    }

    // How much of the sun's soft disc the terrain leaves open at the point, 0 to 1.
    fn sunVisibility(self, px : f32, py : f32, pz : f32, sun : Vec3) : f32 {
        if (sun.y <= (0.0 as f32)) {
            return (0.0 as f32);
        }
        let mut visible : f32 = (1.0 as f32);
        let mut t : f32 = RELIEF_SHADOW_FIRST;
        for (i of 0..RELIEF_SHADOW_STEPS) {
            if (t > RELIEF_SHADOW_REACH) {
                break;
            }
            let ry : f32 = py + sun.y * t;
            if (ry > self.grid.high) {
                break;
            }
            let sx : f32 = px + sun.x * t;
            let sz : f32 = pz + sun.z * t;
            if (ry - self.grid.ceilingAt(sx, sz, RELIEF_SKIP_LEVEL) >= t * RELIEF_SOFT * RELIEF_SKIP_MARGIN) {
                t = t * RELIEF_SHADOW_GROWTH;
                continue;
            }
            let h : f32 = self.grid.heightAt(sx, sz);
            let gap : f32 = (ry - h) / (t * RELIEF_SOFT);
            visible = min(visible, saturate((0.5 as f32) + (0.5 as f32) * gap));
            if (visible <= (0.0 as f32)) {
                return (0.0 as f32);
            }
            t = t * RELIEF_SHADOW_GROWTH;
        }
        return visible;
    }

    // The mean over eight directions of how little of the sky each horizon hides.
    fn skyVisibility(self, px : f32, py : f32, pz : f32) : f32 {
        let mut sum : f32 = (0.0 as f32);
        for (k of 0..RELIEF_AO_DIRECTIONS) {
            let dir : Vec3 = Relief::scanDirection(k);
            let mut slope : f32 = (0.0 as f32);
            let mut reach : f32 = RELIEF_AO_NEAR;
            for (s of 0..RELIEF_AO_STEPS) {
                let sx : f32 = px + dir.x * reach;
                let sz : f32 = pz + dir.z * reach;
                let h : f32 = self.grid.heightAt(sx, sz);
                slope = max(slope, (h - py) / reach);
                reach = reach * RELIEF_AO_GROWTH;
            }
            sum = sum + (1.0 as f32) - slope / sqrt((1.0 as f32) + slope * slope);
        }
        return sum / (RELIEF_AO_DIRECTIONS as f32);
    }

    // The k-th of the eight horizontal scan directions.
    static fn scanDirection(k : i32) : Vec3 {
        let c : f32 = RELIEF_DIAGONAL;
        return match k {
            0 => Vec3 { x: (1.0 as f32), y: (0.0 as f32), z: (0.0 as f32) },
            1 => Vec3 { x: c, y: (0.0 as f32), z: c },
            2 => Vec3 { x: (0.0 as f32), y: (0.0 as f32), z: (1.0 as f32) },
            3 => Vec3 { x: (0.0 as f32) - c, y: (0.0 as f32), z: c },
            4 => Vec3 { x: -(1.0 as f32), y: (0.0 as f32), z: (0.0 as f32) },
            5 => Vec3 { x: (0.0 as f32) - c, y: (0.0 as f32), z: (0.0 as f32) - c },
            6 => Vec3 { x: (0.0 as f32), y: (0.0 as f32), z: -(1.0 as f32) },
            _ => Vec3 { x: c, y: (0.0 as f32), z: (0.0 as f32) - c },
        };
    }
}

// An index clamped into 0..count-1.
fn reliefClamp(i : i32, count : i32) : i32 {
    if (i < 0) {
        return 0;
    }
    if (i >= count) {
        return count - 1;
    }
    return i;
}

// drop_store — the airborne drops of a frame, as flat arrays the renderer reads without copying a struct.
//
// The fluid engine hands its particles over as bulk arrays (positions and velocities three floats a particle, a
// radius, a kind byte), and a frame of a waterfall holds hundreds of thousands, so the renderer's drop store has
// the same shape and nothing else: `f32` positions in metres, `f32` velocities in metres a second, `f32` radii and
// `u8` kinds. It is allocated once at its capacity; a producer writes particle `k` through the arrays and sets
// `count`. The demo's analytic fall (`fall_drops`) writes it by chunks of drops on the job pool; an engine world
// would copy or alias its own arrays here.

/** A drop's kind: the bytes `kinds` holds. */
pub const DROP_LIQUID : u8 = 0;
pub const DROP_SPRAY : u8 = 1;
pub const DROP_FROTH : u8 = 2;

/** The drops. */
pub class DropStore {
    /** Particles in use. */
    pub count : i32 = 0;

    /** Particles the arrays hold. */
    pub capacity : i32;

    /** Metres added to every position: the origin of the grid whose local positions the arrays hold. */
    pub shiftX : f32 = 0.0;
    pub shiftZ : f32 = 0.0;

    /** Metres, x y z for each particle. */
    pub positions : f32[];

    /** Metres a second, x y z for each particle. */
    pub velocities : f32[];

    /** Metres. */
    pub radii : f32[];

    /** `DROP_LIQUID` or `DROP_SPRAY`, or `DROP_FROTH` (aerated water the crown draws; not drawn as a drop); any other byte is not drawn. */
    pub kinds : u8[];

    /** How much of a froth parcel is left, 1 fresh to 0 gone; 1 for the other kinds. */
    pub fade : f32[];

    /** A store that holds `capacity` drops. */
    constructor(capacity : i32) {
        self.capacity = capacity;
        self.positions = new f32[(capacity as i64) * 3];
        self.velocities = new f32[(capacity as i64) * 3];
        self.radii = new f32[capacity as i64];
        self.kinds = new u8[capacity as i64];
        self.fade = new f32[capacity as i64];
    }
}

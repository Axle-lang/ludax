// fall_drops — the demo's waterfall as drops: the curtain over the lip, and the plume where it lands.
//
// The engine's overfall model turns the discharge at a cliff lip into a falling curtain of particles; until that
// world drives the renderer, the demo writes the same kind of data from closed formulas. Every drop is a pure
// function of its index, the time and the gravity: a hash gives it a phase in its life, and its position is the
// ballistic arc from where it starts, so the picture is identical on every run and every thread count, and a lower
// gravity gives a slower, longer fall without any other change. The curtain starts as a sheet of large drops that
// share the lip's width in streams, thins and breaks into small fast streaks as it falls (the size follows a
// power-law distribution, many small and few large); the plume is thrown up where the curtain lands. Everything is water: liquid and spray drops. The writer fills the store by chunks of drops.

use ludax::{sqrt, JobPool, RangeKernel, Vec3, TAU};

use crate::water::drop_store::{DropStore, DROP_LIQUID, DROP_SPRAY};
use crate::water::fall_world::{FallWorld, FW_CENTRE, FW_LAKE, FW_LIP, FW_POOL_Z};
use crate::water::noise::{waterFloor, waterHash, waterLowI};

/** Drops one writing chunk covers. */
pub const FALLDROPS_CHUNK : i32 = 4096;

// The shares of the store: the curtain takes the rest after the plume.
const FALLDROPS_PLUME_SHARE : f32 = 0.3;

// The curtain: the lip's width, height of the water leaving it, the speed it leaves with and the sway.
const FALLDROPS_WIDTH : f32 = 66.0;
const FALLDROPS_LIP_Y : f32 = 119.9;
const FALLDROPS_OUT : f32 = 4.4;
const FALLDROPS_STREAM : f32 = 1.7;

// A drop's radius: the smallest, the power of the distribution, the largest, and the sheet's own drop size.
const FALLDROPS_R_MIN : f32 = 0.05;
const FALLDROPS_R_MAX : f32 = 0.42;
const FALLDROPS_SHEET : f32 = 0.34;

// The plume: where the curtain lands (z), the lifetime scale and the upward speeds.
const FALLDROPS_LAND_Z : f32 = 1057.0;
const FALLDROPS_PLUME_UP : f32 = 9.0;
const FALLDROPS_PLUME_UP_VAR : f32 = 18.0;
const FALLDROPS_PLUME_OUT : f32 = 8.5;

// Hash seeds.
const FALLDROPS_SEED : i32 = 601;

/** The analytic waterfall's drops. */
pub class FallDrops {
    /** Drops of the curtain and of the plume in the store. */
    pub curtain : i32;
    pub plume   : i32;

    /** A fall that fills `capacity` drops. */
    constructor(capacity : i32) {
        self.plume = (((capacity) as f32) * FALLDROPS_PLUME_SHARE) as i32;
        self.curtain = capacity - self.plume;
    }

    /** Drops in all. */
    pub fn total(self) : i32 {
        return self.curtain + self.plume;
    }

    /** Chunks of drops to write. */
    pub fn chunks(self) : i32 {
        return (self.total() + FALLDROPS_CHUNK - 1) / FALLDROPS_CHUNK;
    }

    /** Writes the drops of chunks `begin` up to `end` for second `time` under `gravity` into `store`. */
    pub fn fill(self, store : Shared<DropStore>, begin : i32, end : i32, time : f32, gravity : f32) : void {
        let last : i32 = waterLowI(end * FALLDROPS_CHUNK, self.total());
        for (i of (begin * FALLDROPS_CHUNK)..last) {
            if (i < self.curtain) {
                FallDrops::curtainDrop(store, i, time, gravity);
            } else {
                FallDrops::plumeDrop(store, i, time, gravity);
            }
        }
    }

    // A hash of the drop and a slot.
    static fn roll(i : i32, slot : i32) : f32 {
        return waterHash(i, slot, 0, FALLDROPS_SEED);
    }

    // A drop radius from the power-law distribution: many small, few large.
    static fn radiusOf(u : f32) : f32 {
        let r : f32 = FALLDROPS_R_MIN / sqrt(ludax::max(u, (0.0001 as f32)));
        return ludax::min(r, FALLDROPS_R_MAX);
    }

    static fn put(store : Shared<DropStore>, i : i32, p : Vec3, v : Vec3, r : f32, kind : u8) : void {
        let k : i64 = i as i64;
        store.positions[k * 3] = p.x;
        store.positions[k * 3 + 1] = p.y;
        store.positions[k * 3 + 2] = p.z;
        store.velocities[k * 3] = v.x;
        store.velocities[k * 3 + 1] = v.y;
        store.velocities[k * 3 + 2] = v.z;
        store.radii[k] = r;
        store.kinds[k] = kind;
    }

    // A drop of the curtain: leaves the lip in a stream and falls; the sheet thins and breaks as it goes.
    static fn curtainDrop(store : Shared<DropStore>, i : i32, time : f32, g : f32) : void {
        let height : f32 = FALLDROPS_LIP_Y - FallWorld::level(FALLDROPS_LAND_Z);
        let span : f32 = sqrt((2.0 as f32) * height / g);
        let cycle : f32 = time / span + FallDrops::roll(i, 0);
        let mut life : f32 = cycle - (cycle as i32 as f32);
        if (life < (0.22 as f32) && FallDrops::roll(i, 8) > (0.4 as f32)) {
            life = (0.22 as f32) + (0.78 as f32) * FallDrops::roll(i, 9);
        }
        let tau : f32 = life * span;
        let age : f32 = life;

        let tri : f32 = FallDrops::roll(i, 1) + FallDrops::roll(i, 2) - (1.0 as f32);
        let lateral : f32 = tri * FALLDROPS_WIDTH * (0.5 as f32);
        let mut id : i32 = waterFloor(lateral / FALLDROPS_STREAM);
        if (waterHash(id, 7, 0, FALLDROPS_SEED) < (0.22 as f32)) {
            id = id + 1;
        }
        let stream : f32 = ((id as f32) + (0.5 as f32)) * FALLDROPS_STREAM;
        let sx : f32 = lateral + (stream - lateral) * (0.85 as f32) * ((1.0 as f32) - age * (0.4 as f32));
        let out : f32 = FALLDROPS_OUT * ((0.85 as f32) + (0.3 as f32) * FallDrops::roll(i, 3));
        let thick : f32 = (FallDrops::roll(i, 4) - (0.5 as f32)) * ((0.5 as f32) + (2.2 as f32) * age);
        let sway : f32 = (FallDrops::roll(i, 5) - (0.5 as f32)) * (5.0 as f32) * age;

        let p : Vec3 = Vec3 {
            x: FW_CENTRE + sx + sway * (0.5 as f32),
            y: FALLDROPS_LIP_Y - (0.5 as f32) * g * tau * tau,
            z: FW_LIP + (3.0 as f32) + out * tau + thick,
        };
        let v : Vec3 = Vec3 { x: sway * (0.8 as f32), y: (0.0 as f32) - g * tau, z: out };
        let pareto : f32 = FallDrops::radiusOf(FallDrops::roll(i, 6));
        let broken : f32 = ludax::smoothstep((0.05 as f32), (0.55 as f32), age);
        let r : f32 = FALLDROPS_SHEET + (pareto - FALLDROPS_SHEET) * broken;
        let mut kind : u8 = DROP_LIQUID;
        if (r < (0.14 as f32)) {
            kind = DROP_SPRAY;
        }
        FallDrops::put(store, i, p, v, r, kind);
    }

    // A drop thrown up where the curtain lands, following its own ballistic arc from the pool's surface.
    static fn plumeDrop(store : Shared<DropStore>, i : i32, time : f32, g : f32) : void {
        let up : f32 = FALLDROPS_PLUME_UP + FALLDROPS_PLUME_UP_VAR * FallDrops::roll(i, 0);
        let flight : f32 = (2.0 as f32) * up / g;
        let cycle : f32 = time / flight + FallDrops::roll(i, 2);
        let life : f32 = cycle - (cycle as i32 as f32);
        let tau : f32 = life * flight;
        let angle : f32 = FallDrops::roll(i, 3) * TAU;
        let across : f32 = FallDrops::roll(i, 4) - (0.5 as f32);
        let speed : f32 = FALLDROPS_PLUME_OUT * FallDrops::roll(i, 5);
        let ox : f32 = FW_CENTRE + across * (44.0 as f32);
        let oz : f32 = FALLDROPS_LAND_Z + (FallDrops::roll(i, 7) - (0.5 as f32)) * (9.0 as f32);
        let level : f32 = FallWorld::level(FW_POOL_Z) + (0.3 as f32);
        let v : Vec3 = Vec3 { x: ludax::cos(angle) * speed, y: up - g * tau, z: ludax::sin(angle) * speed };
        let p : Vec3 = Vec3 {
            x: ox + ludax::cos(angle) * speed * tau,
            y: level + up * tau - (0.5 as f32) * g * tau * tau,
            z: oz + ludax::sin(angle) * speed * tau,
        };
        let r : f32 = FallDrops::radiusOf(FallDrops::roll(i, 6)) * (2.2 as f32);
        let mut kind : u8 = DROP_SPRAY;
        if (r > (0.2 as f32)) {
            kind = DROP_LIQUID;
        }
        FallDrops::put(store, i, p, v, r, kind);
    }
}

/** Writes the analytic fall into a store on a job pool: a fixed cut by chunks of drops, so any thread count agrees. */
pub class FallEmitter : RangeKernel {
    /** The fall's formulas. */
    pub fall : FallDrops;

    /** The store written. */
    pub store : Shared<DropStore>;

    time    : f32 = (0.0 as f32);
    gravity : f32 = (9.81 as f32);
    pool    : JobPool;

    /** An emitter of a fall that fills `store`, on `workers` threads. */
    constructor(store : Shared<DropStore>, workers : i32) {
        self.store = store;
        self.fall = new FallDrops(store.capacity);
        self.pool = new JobPool(workers, self);
    }

    /** Does chunks `begin` up to `end` of the writing. */
    pub fn runRange(mut self, begin : i32, end : i32) : void {
        self.fall.fill(self.store, begin, end, self.time, self.gravity);
    }

    /** Writes the drops of second `time` under `gravity` and sets the store's count. */
    pub fn emit(mut self, time : f32, gravity : f32) : void {
        self.time = time;
        self.gravity = gravity;
        self.store.count = self.fall.total();
        let chunks : i32 = self.fall.chunks();
        if (!self.pool.run(chunks, 1)) {
            self.runRange(0, chunks);
        }
    }

    /** Stops the worker threads. */
    pub fn close(mut self) : void {
        self.pool.shutdown();
    }
}

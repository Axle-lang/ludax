// vista_look — every number that decides how the vista renderer paints, grouped by the module that reads it.
//
// The vista renderer is a handful of modules (sky, ground, haze, water surface, drops, post) that do not know each
// other: each reads its own params struct from `VistaLook` and has its own switch in `VistaModules`, so a picture
// can be taken with any of them off. The sky, the physics and the display reuse the structs of the older
// renderer (`SkyLook`, `WaterPhysics`, `PostLook`). Units are metres and linear radiance; extinction is per metre.
// Defaults read as a clear mountain morning; a scene overrides only what it means to change.

use ludax::Vec3;

use crate::water::look::{PostLook, SkyLook, WaterPhysics};

/** Which modules draw. A module that is off costs nothing and leaves the picture as if it were not there. */
pub struct VistaModules {
    /** The sky, the clouds and the sun; off paints a flat colour. */
    pub sky : bool = true;

    /** The ground. Off leaves only sky and water over a flat plain. */
    pub ground : bool = true;

    /** Aerial perspective: the haze that thickens with distance. */
    pub haze : bool = true;

    /** The water surface of the river and the lake. Off leaves the bed uncovered. */
    pub surface : bool = true;

    /** The falling water and the spray. */
    pub spray : bool = true;

    /** Exposure, bloom and the tone curve. */
    pub post : bool = true;
}

/** The ground's materials and detail. Colours are linear albedo. */
pub struct GroundLook {
    /** The three rock tones of the strata: dark, grey, and warm tan. */
    pub rockDark : Vec3 = Vec3 { x: (0.16 as f32), y: (0.15 as f32), z: (0.145 as f32) };
    pub rockGrey : Vec3 = Vec3 { x: (0.30 as f32), y: (0.28 as f32), z: (0.26 as f32) };
    pub rockWarm : Vec3 = Vec3 { x: (0.42 as f32), y: (0.35 as f32), z: (0.27 as f32) };

    /** Loose stone on the slopes under the cliffs. */
    pub scree : Vec3 = Vec3 { x: 0.25, y: 0.23, z: 0.21 };

    /** Green and dry meadow. */
    pub grass    : Vec3 = Vec3 { x: (0.085 as f32), y: (0.15 as f32), z: (0.035 as f32) };
    pub dryGrass : Vec3 = Vec3 { x: (0.21 as f32), y: (0.19 as f32), z: (0.085 as f32) };

    /** Conifer and broadleaf crowns. */
    pub conifer   : Vec3 = Vec3 { x: (0.022 as f32), y: (0.045 as f32), z: (0.022 as f32) };
    pub broadleaf : Vec3 = Vec3 { x: (0.03 as f32), y: (0.055 as f32), z: (0.014 as f32) };

    /** The river's sand and gravel, and wet mud. */
    pub sand   : Vec3 = Vec3 { x: 0.36, y: 0.31, z: 0.23 };
    pub gravel : Vec3 = Vec3 { x: 0.24, y: 0.22, z: 0.19 };
    pub mud    : Vec3 = Vec3 { x: (0.11 as f32), y: (0.085 as f32), z: (0.06 as f32) };

    /** More rock tones: rust bands, the dark of water stains (a multiplier), and two lichens. */
    pub rockRust     : Vec3 = Vec3 { x: (0.30 as f32), y: (0.16 as f32), z: (0.09 as f32) };
    pub rockStain    : Vec3 = Vec3 { x: (0.55 as f32), y: (0.52 as f32), z: (0.5 as f32) };
    pub lichen       : Vec3 = Vec3 { x: (0.2 as f32), y: (0.23 as f32), z: (0.1 as f32) };
    pub lichenOrange : Vec3 = Vec3 { x: (0.42 as f32), y: (0.2 as f32), z: (0.04 as f32) };

    /** Moss, the forest floor of needles, and silt. */
    pub moss : Vec3 = Vec3 { x: (0.05 as f32), y: (0.1 as f32), z: (0.022 as f32) };
    pub duff : Vec3 = Vec3 { x: (0.085 as f32), y: (0.062 as f32), z: (0.04 as f32) };
    pub silt : Vec3 = Vec3 { x: (0.2 as f32), y: (0.16 as f32), z: (0.11 as f32) };

    /** Farmland: ploughed soil, young crop, ripe wheat, hay, and the hedge between fields. */
    pub plough : Vec3 = Vec3 { x: (0.14 as f32), y: (0.095 as f32), z: (0.065 as f32) };
    pub crop   : Vec3 = Vec3 { x: (0.07 as f32), y: (0.14 as f32), z: (0.035 as f32) };
    pub wheat  : Vec3 = Vec3 { x: (0.34 as f32), y: (0.25 as f32), z: (0.09 as f32) };
    pub hay    : Vec3 = Vec3 { x: (0.26 as f32), y: (0.22 as f32), z: (0.11 as f32) };
    pub hedge  : Vec3 = Vec3 { x: (0.03 as f32), y: (0.055 as f32), z: (0.018 as f32) };

    /** Meadow flowers. */
    pub flowerWhite  : Vec3 = Vec3 { x: (0.6 as f32), y: (0.6 as f32), z: (0.55 as f32) };
    pub flowerYellow : Vec3 = Vec3 { x: (0.55 as f32), y: (0.4 as f32), z: (0.04 as f32) };
    pub flowerViolet : Vec3 = Vec3 { x: (0.3 as f32), y: (0.12 as f32), z: (0.42 as f32) };

    /** The height, metres, up to which the lowland's broadleaf trees and farms reach; conifers take the slopes above. */
    pub plainHeight : f32 = (60.0 as f32);

    /** Snow on the high ground. */
    pub snow : Vec3 = Vec3 { x: (0.78 as f32), y: (0.80 as f32), z: (0.84 as f32) };

    /** Height in metres where snow begins to settle, and how much of the steep ground it still covers. */
    pub snowLine : f32 = (560.0 as f32);

    /** How much damp ground darkens, 0 to 1. */
    pub wetDarkening : f32 = (0.55 as f32);

    /** Strength of the fine normal detail, 0 to 1. */
    pub detail : f32 = (1.0 as f32);

    /** Spacing of the conifers, metres. */
    pub treeSpacing : f32 = (5.0 as f32);
}

/** The air between the eye and the ground. */
pub struct HazeLook {
    /** Extinction per metre at the ground, per channel: blue scatters most. */
    pub extinction : Vec3 = Vec3 { x: 0.00005, y: 0.00007, z: 0.00011 };

    /** The height, metres, over which the air thins to a third. */
    pub scaleHeight : f32 = (1800.0 as f32);

    /** How bright the scattered light is against the sky's horizon colour. */
    pub gain : f32 = (1.0 as f32);
}

/** The water's surface. */
pub struct WaterSurfaceLook {
    /** Absorption per metre of path, per channel: red goes first. The default is a clear green-blue river. */
    pub absorption : Vec3 = Vec3 { x: (0.42 as f32), y: (0.085 as f32), z: (0.055 as f32) };

    /** The colour of light scattered back out of the water body. */
    pub body : Vec3 = Vec3 { x: (0.02 as f32), y: (0.075 as f32), z: (0.07 as f32) };

    /** Absorption and body of the deep lake. */
    pub lakeAbsorption : Vec3 = Vec3 { x: (0.55 as f32), y: (0.11 as f32), z: (0.05 as f32) };
    pub lakeBody       : Vec3 = Vec3 { x: (0.004 as f32), y: (0.03 as f32), z: (0.07 as f32) };

    /** Roughness of the sun's glints (GGX alpha). */
    pub glintRoughness : f32 = (0.05 as f32);

    /** Strength of the ripples, 0 flat to 2 choppy. */
    pub ripples : f32 = (1.0 as f32);

    /** Brightness of foam. */
    pub foamBrightness : f32 = (1.0 as f32);

    /** How much foam a given amount shows: above 1 spreads it. */
    pub foamCoverage : f32 = (1.0 as f32);

    /** Width in metres of the foam line where the water meets the bank. */
    pub contactFoam : f32 = (0.25 as f32);

    /** The colour of the dye tracer where the scene carries one. */
    pub dye : Vec3 = Vec3 { x: 1.0, y: 0.1, z: 0.08 };

    /** Whether the reflection traces the terrain; off reflects the sky only. */
    pub reflectTerrain : bool = true;

    /** Strength of the caustic net on a shallow bed. */
    pub caustics : f32 = (1.0 as f32);

    /** Muddiness: 0 clear, 1 brown and opaque; mixes absorption and body toward silt. */
    pub silt : f32 = (0.0 as f32);

    /** Where the plunge pool's rings start (x, z), and their strength. */
    pub ringX : f32 = (1536.0 as f32);
    pub ringZ : f32 = (1074.0 as f32);
    pub rings : f32 = (1.0 as f32);
}

/** The falling water and the spray. */
pub struct DropLook {
    /** Multiplies every drop's radius: the engine's drops are bigger than real ones to be seen at all. */
    pub sizeGain : f32 = (1.0 as f32);

    /** The smallest a drop is drawn, pixels; below it the coverage fades instead of vanishing. */
    pub minPixels : f32 = (0.6 as f32);

    /** Seconds the shutter is open: drops streak along their velocity by this long. */
    pub shutter : f32 = (0.05 as f32);

    /** The opacity of a drop's core, 0 to 1. */
    pub opacity : f32 = (0.55 as f32);

    /** The heights, metres, of a fall's lip and foot: water turns white as it falls from the one to the other. Equal (the default) switches this off. */
    pub fallTop  : f32 = 0.0;
    pub fallFoot : f32 = 0.0;

    /** The least radius, metres, a liquid drop is drawn with: a curtain sampled on a lattice (the engine's `curtainSpacing`) is smoothed into a sheet when each sample covers its neighbours. 0 draws drops at their own size. */
    pub sheetRadius : f32 = 0.0;

    /** The opacity of one liquid drop of the sheet (a sheet of many overlapping drops needs far less than a lone one). */
    pub sheetOpacity : f32 = 0.0;

    /** The bluish-green tint of the thick part of the sheet. */
    pub thick : Vec3 = Vec3 { x: (0.42 as f32), y: (0.78 as f32), z: (0.82 as f32) };

    /** Anisotropy of the forward scattering toward the sun. */
    pub forward : f32 = (0.72 as f32);

    /** Brightness of the backlit sheet. */
    pub glow : f32 = (0.55 as f32);
}

/** The aerated crown where a fall lands (see `crown_volume`); a scene with no fall leaves it off. */
pub struct CrownLook {
    /** Whether the crown is drawn. */
    pub enabled : bool = false;

    /** The crown's centre on the ground, metres, and the height of the pool's surface. */
    pub x     : f32 = (0.0 as f32);
    pub z     : f32 = (0.0 as f32);
    pub level : f32 = (0.0 as f32);

    /** Half the width of the box the crown fills, metres. */
    pub reach : f32 = (26.0 as f32);

    /** Extinction per metre of the densest part, per unit of density. */
    pub sigma : f32 = (5.0 as f32);
}

/** Everything the vista renderer reads, one struct a scene builds. */
pub struct VistaLook {
    /** Which modules draw. */
    pub modules : VistaModules = VistaModules {};

    /** The physics the water ran with (shown in the HUD; ripples follow it). */
    pub physics : WaterPhysics = WaterPhysics {};

    /** Sky and sun; the cloud deck is high at mountain scale. */
    pub sky : SkyLook = SkyLook {
        dayTime: 0.33,
        cloudHeight: (2600.0 as f32),
        cloudCover: (0.4 as f32),
        cloudDrift: (8.0 as f32),
        gain: (1.8 as f32),
    };

    /** Ground. */
    pub ground : GroundLook = GroundLook {};

    /** Air. */
    pub haze : HazeLook = HazeLook {};

    /** Water surface. */
    pub surface : WaterSurfaceLook = WaterSurfaceLook {};

    /** The crown at the foot of a fall. */
    pub crown : CrownLook = CrownLook {};

    /** Drops. */
    pub drops : DropLook = DropLook {};

    /** Display. */
    pub post : PostLook = PostLook { exposureBias: -0.9 };
}

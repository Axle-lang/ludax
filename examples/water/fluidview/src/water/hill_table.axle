// hill_table — the lattice of the far hills' value noise, hashed once instead of once per march step.
//
// The plain beyond the water grid rolls in hills made of three octaves of value noise, and a ray grazing it asks
// for the height at every step of a 160-step march, each answer costing twelve integer hashes. The hashes are a
// pure function of the lattice point, so they are computed once into a table per octave and the noise reads four
// floats instead: the very same numbers, through `waterBlend2`, so a picture is bit for bit what it was. A point
// outside the table (a camera very far from the grid) falls back to hashing.

use crate::water::noise::{waterBlend2, waterFloor, waterHash, waterValue2};

// How far from the origin the tables reach, metres, and the lattice margin kept on each side.
const HILL_REACH : f32 = 4000.0;
const HILL_MARGIN : i32 = 3;

/** One octave's lattice. */
struct HillOctave {
    scale : f32;
    ratio : f32;
    seed  : i32;
    first : i32;
    count : i32;
}

/** The lattice of three octaves of value noise. */
pub class HillTable {
    one   : HillOctave;
    two   : HillOctave;
    three : HillOctave;
    cells : f32[];
    base  : i32[];

    /** Hashes the lattice of the three octaves of the noise at `scale`, times 1, `ratioB` and `ratioC`. */
    constructor(scale : f32, ratioB : f32, ratioC : f32, seed : i32) {
        self.one = HillTable::octave(scale, (1.0 as f32), seed);
        self.two = HillTable::octave(scale, ratioB, seed + 1);
        self.three = HillTable::octave(scale, ratioC, seed + 2);
        let sizeOne : i64 = (self.one.count as i64) * self.one.count;
        let sizeTwo : i64 = (self.two.count as i64) * self.two.count;
        let sizeThree : i64 = (self.three.count as i64) * self.three.count;
        self.cells = new f32[sizeOne + sizeTwo + sizeThree];
        self.base = new i32[3];
        self.base[0] = 0;
        self.base[1] = sizeOne as i32;
        self.base[2] = (sizeOne + sizeTwo) as i32;
        HillTable::fill(self.cells, self.base[0] as i64, self.one);
        HillTable::fill(self.cells, self.base[1] as i64, self.two);
        HillTable::fill(self.cells, self.base[2] as i64, self.three);
    }

    static fn octave(scale : f32, ratio : f32, seed : i32) : HillOctave {
        let reach : f32 = HILL_REACH * scale * ratio;
        let first : i32 = waterFloor((0.0 as f32) - reach) - HILL_MARGIN;
        let last : i32 = waterFloor(reach) + HILL_MARGIN;
        return HillOctave { scale: scale, ratio: ratio, seed: seed, first: first, count: last - first + 1 };
    }

    static fn fill(cells : f32[], base : i64, o : HillOctave) : void {
        for (j of 0..o.count) {
            for (i of 0..o.count) {
                cells[base + (j as i64) * (o.count as i64) + (i as i64)] = waterHash(
                    o.first + i,
                    0,
                    o.first + j,
                    o.seed
                );
            }
        }
    }

    /** The value noise of octave `which` (0, 1 or 2) at (`x`, `z`) metres, equal to `waterValue2` of the scaled point. */
    pub fn value(self, which : i32, x : f32, z : f32) : f32 {
        let o : HillOctave = self.octaveOf(which);
        let sx : f32 = x * o.scale * o.ratio;
        let sz : f32 = z * o.scale * o.ratio;
        let ix : i32 = waterFloor(sx);
        let iz : i32 = waterFloor(sz);
        let i : i32 = ix - o.first;
        let j : i32 = iz - o.first;
        if (i < 0 || j < 0 || i + 1 >= o.count || j + 1 >= o.count) {
            return waterValue2(sx, sz, o.seed);
        }
        let at : i64 = (self.base[which as i64] as i64) + (j as i64) * (o.count as i64) + (i as i64);
        let row : i64 = o.count as i64;
        return waterBlend2(
            sx - ix as f32,
            sz - iz as f32,
            self.cells[at],
            self.cells[at + 1],
            self.cells[at + row],
            self.cells[at + row + 1]
        );
    }

    fn octaveOf(self, which : i32) : HillOctave {
        if (which == 0) {
            return self.one;
        }
        if (which == 1) {
            return self.two;
        }
        return self.three;
    }
}

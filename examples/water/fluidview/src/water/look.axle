// look — every number that decides how the water renderer paints, grouped by the module that reads it.
//
// The renderer is five modules (sky, terrain, surface, spray, post) that do not know each other: each reads
// its own params struct from `WaterLook` and can be switched off on its own with a flag of `WaterModules`. A
// scene composes them by building a `WaterLook` and passing it to the renderer; every field has a default that
// reads as sunlit fresh water, so a scene overrides only what it means to change. The physics the water was
// simulated with (`WaterPhysics`) rides along because it is physically right for it to change the picture:
// ripples travel with the square root of gravity and are damped by viscosity.
//
// Units are the engine's: a cell is one unit of length, radiance is the sky's scene radiance, and extinction is
// per cell. Colours are linear.

use ludax::Vec3;

/** Reference gravity the ripple speed is scaled against, cells a second squared. */
pub const WATER_G_EARTH : f32 = 9.81;

/** Which modules draw. A module that is off costs nothing and leaves the picture as if it were not there. */
pub struct WaterModules {
    /** The baked sky, the sun's disc and the haze toward the horizon; off paints a flat sky colour. */
    pub sky : bool = true;

    /** The ray-marched ground; off leaves only the water over a flat plain. */
    pub terrain : bool = true;

    /** The water surface: reflection, refraction, foam. Off leaves the bed uncovered. */
    pub surface : bool = true;

    /** The liquid and spray drops. */
    pub spray : bool = true;

    /** Exposure, bloom and the tone curve; off writes the radiance clipped at 1. */
    pub post : bool = true;
}

/** The physics the water was simulated with, which the look follows where it is physically right. */
pub struct WaterPhysics {
    /** Gravity, cells a second squared: a lower one makes slower, longer ripples. */
    pub gravity : f32 = 9.81;

    /** Kinematic viscosity: a higher one damps the fine ripples and the lace of foam. */
    pub viscosity : f32 = 0.0;
}

/** The sky and the sun. */
pub struct SkyLook {
    /** Time of day in 0..1: 0.25 sunrise, 0.5 noon, 0.75 sunset. */
    pub dayTime : f64 = 0.40;

    /** How far the sun is tilted out of the east-west plane, which turns its azimuth. */
    pub tilt : f32 = 0.35;

    /** Multiplies the sky's radiance (and the ambient light it casts): the real sky is a seventh of the sunlit ground, which photographs dark. */
    pub gain : f32 = 1.8;

    /** The flat colour a picture without a sky shows. */
    pub flat : Vec3 = Vec3 { x: 0.2, y: 0.3, z: 0.5 };

    /** Distance, in cells, at which the air has taken about 63 percent of the view (aerial haze); 0 for none. */
    pub hazeDistance : f32 = 260.0;

    /** How bright the haze is against the sky near the horizon. */
    pub hazeGain : f32 = 1.0;

    /** Share of the sky the cumulus covers, 0 clear to 1 overcast. */
    pub cloudCover : f32 = 0.45;

    /** Height of the cloud deck above the eye, cells: lower clouds look larger and move faster across the sky. */
    pub cloudHeight : f32 = 700.0;

    /** Cells the clouds drift a second. */
    pub cloudDrift : f32 = 6.0;
}

/** The ground. */
pub struct TerrainLook {
    /** Pale mineral crust (sinter) of flat ground near water. */
    pub sinter : Vec3 = Vec3 { x: 0.62, y: 0.58, z: 0.50 };

    /** Dark rock of steep ground. */
    pub rock : Vec3 = Vec3 { x: 0.30, y: 0.26, z: 0.23 };

    /** Dry sand of gentle, low ground. */
    pub sand : Vec3 = Vec3 { x: 0.58, y: 0.49, z: 0.35 };

    /** Grass of flat, high ground. */
    pub grass : Vec3 = Vec3 { x: 0.14, y: 0.20, z: 0.07 };

    /** Height, in cells, below which sand shows and above which grass may grow. */
    pub sandTop : f32 = 0.8;

    /** Share of the ground, 0 to 1, that grass takes where it can grow. */
    pub grassAmount : f32 = 0.5;

    /** Slope (rise over run) from which rock replaces the flat materials entirely. */
    pub rockSlope : f32 = 0.9;

    /** How much damp ground darkens, 0 to 1. */
    pub wetDarkening : f32 = 0.5;

    /** Strength of the fine normal detail, 0 to 1. */
    pub detail : f32 = 1.0;

    /** Orange mineral crust and green algae that band the ground around water, as the terraces of a hot spring do. */
    pub rust  : Vec3 = Vec3 { x: 0.62, y: 0.30, z: 0.12 };
    pub algae : Vec3 = Vec3 { x: 0.20, y: 0.32, z: 0.09 };

    /** How strongly the ground around water is banded in those colours, 0 none to 1. */
    pub bandAmount : f32 = 0.0;

    /** Height of the flat plain beyond the grid, cells. */
    pub farGround : f32 = 0.0;

    /** Height of the hills that rise out of that plain far from the grid, cells; 0 for flat. */
    pub farHills : f32 = 0.0;
}

/** The water's surface. */
pub struct SurfaceLook {
    /** Absorption per cell of path, per channel: red goes first, which is why water is blue. */
    pub absorption : Vec3 = Vec3 { x: 0.60, y: 0.13, z: 0.07 };

    /** The colour of light scattered back out of the water body, before absorption by its own depth. */
    pub body : Vec3 = Vec3 { x: 0.012, y: 0.07, z: 0.09 };

    /** Roughness of the sun's glints (GGX alpha, 0.01 mirror to 0.3 satin). */
    pub glintRoughness : f32 = 0.045;

    /** Strength of the capillary ripples, 0 flat to 2 choppy. */
    pub ripples : f32 = 1.0;

    /** Brightness of foam against the sun-lit white. */
    pub foamBrightness : f32 = 1.0;

    /** How much foam shows for a given amount in the engine's field: above 1 spreads it. */
    pub foamCoverage : f32 = 1.0;

    /** Width in cells of the foam line where the water meets the ground. */
    pub contactFoam : f32 = 0.12;

    /** Brightness of the glow of light passing through thin crests. */
    pub subsurface : f32 = 1.0;

    /** Refractive index of water. */
    pub refractiveIndex : f32 = 1.333;

    /** Bounces of reflected rays that look for terrain; 0 reflects the sky only. */
    pub reflectedTerrain : bool = true;
}

/** The liquid and spray drops. */
pub struct SprayLook {
    /** Multiplies every drop's radius: the engine's drops are bigger than real ones to be seen at all. */
    pub sizeGain : f32 = 1.6;

    /** The smallest a drop is drawn, pixels; below it the drop fades instead of vanishing. */
    pub minPixels : f32 = 0.9;

    /** Seconds the camera's shutter is open: drops streak along their velocity by this long. */
    pub shutter : f32 = 0.06;

    /** The opacity of a drop's core, 0 to 1. */
    pub opacity : f32 = 0.5;

    /** Brightness of the sparkle of the sun on a drop. */
    pub sparkle : f32 = 1.0;

    /** Extinction per cell at the core of a lone drop's halo, for the shadow the column casts on its own drops. */
    pub shadowDensity : f32 = 0.006;
}

/** The display: from radiance to pixels. */
pub struct PostLook {
    /** Exposure as a power of two added to the automatic one. */
    pub exposureBias : f32 = 0.0;

    /** When above zero the exposure is this fixed value and the automatic metering is off (close pictures with a bright plume in view). */
    pub exposureLock : f32 = 0.0;

    /** Share of the light above white that blooms back. */
    pub bloom : f32 = 0.18;

    /** Darkening of the corners, 0 to 1. */
    pub vignette : f32 = 0.35;
}

/** Everything the renderer reads, one struct a scene builds. */
pub struct WaterLook {
    /** Which modules draw. */
    pub modules : WaterModules = WaterModules {};

    /** The physics the water ran with. */
    pub physics : WaterPhysics = WaterPhysics {};

    /** Sky and sun. */
    pub sky : SkyLook = SkyLook {};

    /** Ground. */
    pub terrain : TerrainLook = TerrainLook {};

    /** Water surface. */
    pub surface : SurfaceLook = SurfaceLook {};

    /** Drops. */
    pub spray : SprayLook = SprayLook {};

    /** Display. */
    pub post : PostLook = PostLook {};
}

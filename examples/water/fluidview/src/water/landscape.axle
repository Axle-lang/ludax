// landscape — what the vista renderer looks at: the terrain, the water window over it, and the sky above.
//
// A landscape is three shared pieces and the bookkeeping that lets several renderers draw the same one: the
// `Relief` (heights, material masks, baked light, the lake's mask and level), the `WaterWindow` the simulation
// fills every frame, and the sky, baked once per time of day and shared by every renderer of the landscape whatever
// its picture size (a window keeps one coarse and one fine renderer, and the sky must not be baked twice). Whoever
// builds the landscape (the cascade example, from a generated terrain) owns the filling; the renderer only reads.

use crate::water::marker_layer::MarkerLayer;
use crate::water::relief::Relief;
use crate::water::sky::WaterSky;
use crate::water::water_window::WaterWindow;

/** The terrain, the water and the sky of one scene. */
pub class WaterLandscape {
    /** The terrain. */
    pub relief : Shared<Relief>;

    /** The water window. */
    pub window : Shared<WaterWindow>;

    /** The sky: baked once and shared by every renderer of the landscape. */
    pub sky : Shared<WaterSky>;

    /** The flow markers: floats the simulation owns, drawn over every renderer's picture. */
    pub markers : Shared<MarkerLayer>;

    /** The time of day, tilt and gain the sky was last baked for (negative before the first bake). */
    pub skyDay  : f64 = -(1.0 as f32);
    pub skyTilt : f32 = -(1.0 as f32);
    pub skyGain : f32 = -(1.0 as f32);

    /** A landscape of `relief` and `window` under a fresh sky. */
    constructor(relief : Shared<Relief>, window : Shared<WaterWindow>) {
        self.relief = relief;
        self.window = window;
        self.sky = share new WaterSky();
        self.markers = share new MarkerLayer();
    }
}

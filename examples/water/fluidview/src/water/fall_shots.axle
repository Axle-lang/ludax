// fall_shots — where the camera stands in the analytic waterfall scene: a wide shot, a low shot and a river flight.
//
// A path is a pure function of a number in 0 to 1, so a film and a long-time sheet can ask for any moment and get
// the same picture on every run. The wide shot is a slow arc around the valley mouth facing the fall, the pool
// shot stands on the pool's south shore with the curtain filling the view, and the river shot follows the centre
// line downstream at the height of a low helicopter, looking ahead.

use ludax::{cos, sin, Vec3};

use crate::water::camera::WaterCamera;
use crate::water::fall_world::{FallWorld, FW_CENTRE, FW_LIP};
use crate::water::vista_camera::VistaCamera;

/** The camera paths of the analytic fall. */
pub enum VistaShot : i8 {
    /** The valley from the south-east, the fall in its mountain frame. */
    Wide,

    /** Low at the plunge pool, looking up at the curtain. */
    Pool,

    /** Along the river, downstream, over the meanders. */
    River,
}

/** Cameras of the analytic fall. */
pub class FallShots {
    /** The camera of `shot` at position `u` (0 to 1) along its path, for a picture `width` by `height`. */
    pub static fn shot(shot : VistaShot, u : f32, width : i32, height : i32) : WaterCamera {
        return match shot {
            VistaShot::Wide => FallShots::wide(u, width, height),
            VistaShot::Pool => FallShots::pool(u, width, height),
            VistaShot::River => FallShots::river(u, width, height),
        };
    }

    static fn wide(u : f32, width : i32, height : i32) : WaterCamera {
        let angle : f32 = (0.75 as f32) + (0.5 as f32) * u;
        let eye : Vec3 = Vec3 {
            x: FW_CENTRE + (500.0 as f32) * sin(angle),
            y: (150.0 as f32),
            z: FW_LIP + (640.0 as f32) * cos(angle),
        };
        let target : Vec3 = Vec3 { x: FW_CENTRE, y: (96.0 as f32), z: FW_LIP - (20.0 as f32) };
        return VistaCamera::lookAt(eye, target, width, height);
    }

    static fn pool(u : f32, width : i32, height : i32) : WaterCamera {
        let angle : f32 = (0.2 as f32) + (0.7 as f32) * u;
        let eye : Vec3 = Vec3 {
            x: FW_CENTRE + (110.0 as f32) * sin(angle),
            y: (84.0 as f32),
            z: FW_LIP + (150.0 as f32) + (40.0 as f32) * cos(angle),
        };
        let target : Vec3 = Vec3 { x: FW_CENTRE, y: (100.0 as f32), z: FW_LIP - (4.0 as f32) };
        return VistaCamera::lookAt(eye, target, width, height);
    }

    static fn river(u : f32, width : i32, height : i32) : WaterCamera {
        let z : f32 = FW_LIP + (140.0 as f32) + (1500.0 as f32) * u;
        let ahead : f32 = z + (110.0 as f32);
        let eye : Vec3 = Vec3 { x: FallWorld::centreX(z), y: FallWorld::level(z) + (14.0 as f32), z: z };
        let target : Vec3 = Vec3 {
            x: FallWorld::centreX(ahead),
            y: FallWorld::level(ahead) + (1.0 as f32),
            z: ahead,
        };
        return VistaCamera::lookAt(eye, target, width, height);
    }
}

// ground_shade — the colour of the terrain at a point: materials blended by weights, detail, light and wetness.
//
// The terrain's own material codes are priors, not paint. Per pixel the shader turns them into continuous weights by
// roughening each mask with noise (`groundRagged`: a smooth, wandering edge, never the outline of a terrain cell),
// overrules them with what the pixel can see for itself (a steep face is rock whatever the class says, a slope under a
// cliff is talus, ground near water is damp and mossy, high ground dries out and whitens into snow), and blends the
// material functions of `ground_rock` and `ground_soil` by those weights. Colour, micro-relief tilt, sheen and
// occlusion are blended together; the normal is the terrain's smooth one tilted by the blended micro-relief, and the
// light is the sun times the baked soft shadow plus the sky dome times the baked openness and the relief's own
// occlusion. Every detail fades into its average as the pixel footprint outgrows it, so nothing shimmers far off and
// nothing is blurred near. `shade` is the full look; `cheap` skips the detail, for the terrain seen in a reflection.

use ludax::{max, min, saturate, smoothstep, sqrt, Vec3, PI};

use crate::water::ground_canopy::GroundCanopy;
use crate::water::ground_hill::{GroundHill, HillRibs};
use crate::water::ground_noise::groundRagged;
use crate::water::ground_rock::GroundRock;
use crate::water::ground_site::{GroundPatch, GroundSite};
use crate::water::ground_soil::GroundSoil;
use crate::water::noise::{waterFbm2, waterFbm3, waterValue3};
use crate::water::plants::PLANT_RANGE;
use crate::water::relief::{Relief, ReliefSpot};
use crate::water::sky::WaterSky;
use crate::water::vista_look::GroundLook;
use crate::water::water_window::WaterWindow;

// Noise seeds.
const GROUND_SEED_WANDER : i32 = 701;
const GROUND_SEED_DRY : i32 = 709;
const GROUND_SEED_SNOW : i32 = 719;
const GROUND_SEED_MOSS : i32 = 727;
const GROUND_SEED_TINT : i32 = 733;

// A material weighing less than this is not evaluated.
const GROUND_MIN : f32 = 0.02;

// Slopes (rise over run) from which ground is rock whatever its class, and between which a hillside is talus.
const GROUND_ROCK_LOW : f32 = 0.78;
const GROUND_ROCK_HIGH : f32 = 1.18;
const GROUND_TALUS_LOW : f32 = 0.38;
const GROUND_TALUS_HIGH : f32 = 0.62;

// Trees do not stand on slopes steeper than this.
const GROUND_TREE_LOW : f32 = 0.32;
const GROUND_TREE_HIGH : f32 = 0.55;

// The meadow yellows above these heights, metres, and the snow settles above `snowLine` less this much on the north side.
const GROUND_DRY_LOW : f32 = 170.0;
const GROUND_DRY_HIGH : f32 = 460.0;
const GROUND_SNOW_NORTH : f32 = 90.0;
const GROUND_SNOW_BAND : f32 = 80.0;

/** What the shader needs to know of a point on the ground. */
pub struct VistaSpot {
    /** World position, metres. */
    pub point : Vec3 = Vec3 { x: (0.0 as f32), y: (0.0 as f32), z: (0.0 as f32) };

    /** Unit direction from the eye to the point. */
    pub view : Vec3 = Vec3 { x: (0.0 as f32), y: (0.0 as f32), z: -(1.0 as f32) };

    /** Size of a pixel at the point, metres. */
    pub footprint : f32 = (0.1 as f32);

    /** Simulation seconds. */
    pub time : f32 = (0.0 as f32);

    /** Distance from the eye, metres; the default is far, where trees are only a canopy texture. */
    pub distance : f32 = (1000000.0 as f32);
}

// The material weights at a point, summing to 1.
struct GroundWeights {
    rock   : f32 = (0.0 as f32);
    scree  : f32 = (0.0 as f32);
    forest : f32 = (0.0 as f32);
    gravel : f32 = (0.0 as f32);
    mud    : f32 = (0.0 as f32);
    field  : f32 = (0.0 as f32);
    meadow : f32 = (0.0 as f32);
}

/** The ground shader. */
pub class GroundShader {
    relief : Shared<Relief>;
    window : Shared<WaterWindow>;
    sky    : Shared<WaterSky>;

    /** The materials and detail. */
    pub look : GroundLook = GroundLook {};

    /** A shader over `relief`, wetted by `window`, lit by `sky`. */
    constructor(relief : Shared<Relief>, window : Shared<WaterWindow>, sky : Shared<WaterSky>) {
        self.relief = relief;
        self.window = window;
        self.sky = sky;
    }

    /** The radiance leaving the ground at `spot` toward the eye, before haze. */
    pub fn shade(self, spot : VistaSpot) : Vec3 {
        return self.colour(spot, true);
    }

    /** The same without the detail, for a reflection. */
    pub fn cheap(self, spot : VistaSpot) : Vec3 {
        return self.colour(spot, false);
    }

    fn colour(self, spot : VistaSpot, fine : bool) : Vec3 {
        let p : Vec3 = spot.point;
        let flat : Vec3 = self.relief.grid.normalAt(p.x, p.z);
        let cell : ReliefSpot = self.relief.spotAt(p.x, p.z);
        let moist : f32 = self.window.moistAt(p.x, p.z);
        let slope : f32 = sqrt(saturate((1.0 as f32) - flat.y * flat.y)) / max(flat.y, (0.05 as f32));
        let site : GroundSite = GroundSite {
            p: p,
            n: flat,
            slope: slope,
            footprint: spot.footprint,
            distance: spot.distance,
            damp: saturate(moist + cell.wet * (0.2 as f32)),
            fine: fine,
        };

        let mut ribs : HillRibs = HillRibs {};
        if (fine) {
            ribs = GroundHill::ribs(site);
        }
        let weights : GroundWeights = self.weights(site, cell, ribs.outcrop);
        let mut patch : GroundPatch = self.blend(site, cell, weights);
        patch.albedo = patch.albedo.scale(ribs.shade);
        patch.tilt = patch.tilt.plus(ribs.tilt);
        patch = self.overlays(site, cell, patch, weights);

        let tilt : Vec3 = patch.tilt.minus(flat.scale(patch.tilt.dot(flat)));
        let n : Vec3 = flat.minus(tilt).normalized();
        let direct : Vec3 = self.sky.direct(n).scale(cell.sun * patch.sun);
        let ambient : Vec3 = self.sky.ambient(n).scale(cell.open * patch.open);
        let lit : Vec3 = patch.albedo.times(direct.plus(ambient));
        return lit.plus(self.sheen(n, spot.view, patch.gloss, cell.sun));
    }

    // The sun's glint off a wet or icy surface: a tight lobe around the mirror direction, no libm.
    fn sheen(self, n : Vec3, view : Vec3, gloss : f32, sun : f32) : Vec3 {
        if (gloss <= (0.01 as f32)) {
            return Vec3::zero();
        }
        let half : Vec3 = self.sky.sunDir.minus(view).normalized();
        let mut lobe : f32 = max(n.dot(half), (0.0 as f32));
        for (i of 0..6) {
            lobe = lobe * lobe;
        }
        let lit : f32 = saturate(n.dot(self.sky.sunDir) * (4.0 as f32));
        return self.sky.sunIrr.scale(gloss * lobe * lit * sun * (0.6 as f32) / PI);
    }

    // The weights of the materials at a site, from the priors, the slope and the noise.
    fn weights(self, site : GroundSite, cell : ReliefSpot, outcrop : f32) : GroundWeights {
        let p : Vec3 = site.p;
        let wander : f32 = (0.7 as f32)
            * waterFbm2(p.x * (0.03 as f32), p.z * (0.03 as f32), 3, GROUND_SEED_WANDER)
            + (0.3 as f32) * waterFbm2(p.x * (0.17 as f32), p.z * (0.17 as f32), 2, GROUND_SEED_WANDER + 4);

        let steep : f32 = smoothstep(GROUND_ROCK_LOW, GROUND_ROCK_HIGH, site.slope);
        let rock : f32 = max(
            max(steep, groundRagged(cell.rock, wander, (0.9 as f32), (0.18 as f32))),
            outcrop * ((1.0 as f32) - cell.forest) * (0.8 as f32)
        );
        let free : f32 = (1.0 as f32) - rock;

        let talus : f32 = smoothstep(GROUND_TALUS_LOW, GROUND_TALUS_HIGH, site.slope)
            * ((1.0 as f32) - cell.forest);
        let screeShare : f32 = max(groundRagged(cell.scree, wander, (0.8 as f32), (0.2 as f32)), talus);
        let scree : f32 = free * screeShare;

        let treeSlope : f32 = (1.0 as f32) - smoothstep(GROUND_TREE_LOW, GROUND_TREE_HIGH, site.slope);
        let forestShare : f32 = groundRagged(cell.forest, wander, (0.7 as f32), (0.2 as f32)) * treeSlope;
        let forest : f32 = free * ((1.0 as f32) - screeShare) * forestShare;
        let rest : f32 = free * ((1.0 as f32) - screeShare) * ((1.0 as f32) - forestShare);

        let grassy : f32 = smoothstep((0.5 as f32), (0.75 as f32), wander) * ((1.0 as f32) - site.damp)
            * (0.7 as f32);
        let bed : f32 = rest * groundRagged(cell.bed, wander, (0.7 as f32), (0.2 as f32))
            * ((1.0 as f32) - grassy);
        let mudShare : f32 = saturate(cell.mud / max(cell.bed, (0.05 as f32)) + site.damp * (0.3 as f32));
        let field : f32 = (rest - bed) * groundRagged(cell.field, wander, (0.5 as f32), (0.25 as f32));
        return GroundWeights {
            rock: rock,
            scree: scree,
            forest: forest,
            gravel: bed * ((1.0 as f32) - mudShare),
            mud: bed * mudShare,
            field: field,
            meadow: rest - bed - field,
        };
    }

    // The patches of every material that has weight, blended.
    fn blend(self, site : GroundSite, cell : ReliefSpot, w : GroundWeights) : GroundPatch {
        let mut sum : GroundPatch = GroundPatch {
            albedo: Vec3::zero(),
            tilt: Vec3::zero(),
            gloss: (0.0 as f32),
            open: (0.0 as f32),
            sun: (0.0 as f32),
        };
        let mut total : f32 = (0.0 as f32);
        let dry : f32 = self.dryness(site, cell);
        if (w.rock > GROUND_MIN) {
            sum = GroundShader::add(sum, GroundRock::patch(site, self.look), w.rock);
            total = total + w.rock;
        }
        if (w.scree > GROUND_MIN) {
            sum = GroundShader::add(sum, GroundSoil::scree(site, self.look), w.scree);
            total = total + w.scree;
        }
        if (w.forest > GROUND_MIN) {
            sum = GroundShader::add(sum, self.forest(site, cell), w.forest);
            total = total + w.forest;
        }
        if (w.gravel > GROUND_MIN) {
            sum = GroundShader::add(sum, GroundSoil::gravel(site, self.look, site.damp), w.gravel);
            total = total + w.gravel;
        }
        if (w.mud > GROUND_MIN) {
            let shore : GroundPatch = GroundShader::mix(
                GroundSoil::gravel(site, self.look, site.damp),
                GroundSoil::mud(site, self.look),
                smoothstep((0.3 as f32), (0.8 as f32), site.damp)
            );
            sum = GroundShader::add(sum, shore, w.mud);
            total = total + w.mud;
        }
        if (w.field > GROUND_MIN) {
            sum = GroundShader::add(sum, GroundSoil::field(site, self.look), w.field);
            total = total + w.field;
        }
        if (w.meadow > GROUND_MIN) {
            let flowers : f32 = saturate((0.8 as f32) - dry) * (0.7 as f32);
            sum = GroundShader::add(sum, GroundSoil::grass(site, self.look, dry, flowers), w.meadow);
            total = total + w.meadow;
        }
        return GroundShader::add(
            GroundPatch {
                albedo: Vec3::zero(),
                tilt: Vec3::zero(),
                gloss: (0.0 as f32),
                open: (0.0 as f32),
                sun: (0.0 as f32),
            },
            sum,
            (1.0 as f32) / max(total, GROUND_MIN)
        );
    }

    // The forest: the floor under the stand, and the stand's crowns painted over it.
    fn forest(self, site : GroundSite, cell : ReliefSpot) : GroundPatch {
        let floor : GroundPatch = GroundSoil::duff(site, self.look);
        let broad : f32 = GroundCanopy::broadleaf(self.look, site.p.y, cell.wet);
        let canopy : GroundPatch = GroundCanopy::patch(site, self.look, (0.92 as f32), broad, floor);
        let far : f32 = smoothstep(PLANT_RANGE * (0.6 as f32), PLANT_RANGE, site.distance);
        return GroundShader::mix(GroundCanopy::shaded(floor), canopy, far);
    }

    // How yellow the grass is: high ground and ground far from water dry out; patches of noise vary it.
    fn dryness(self, site : GroundSite, cell : ReliefSpot) : f32 {
        let high : f32 = smoothstep(GROUND_DRY_LOW, GROUND_DRY_HIGH, site.p.y);
        let patchy : f32 = waterFbm2(site.p.x * (0.02 as f32), site.p.z * (0.02 as f32), 3, GROUND_SEED_DRY);
        return saturate(high * (0.8 as f32) + ((0.5 as f32) - cell.wet) * (0.5 as f32)
            + (patchy - (0.5 as f32)) * (0.6 as f32)
            - site.damp * (0.5 as f32));
    }

    // Moss near water, snow high up, and the wet darkening that every material gets near water.
    fn overlays(
        self,
        site : GroundSite,
        cell : ReliefSpot,
        patch : GroundPatch,
        w : GroundWeights
    ) : GroundPatch {
        let mut out : GroundPatch = patch;
        out.albedo = self.withMoss(site, cell, out.albedo, w);
        out = self.withSnow(site, out);
        let wet : f32 = saturate(site.damp) * ((1.0 as f32) - (0.3 as f32) * w.rock);
        out.albedo = out.albedo.lerp(
            out.albedo.times(self.look.mud).scale((6.0 as f32)),
            wet * self.look.wetDarkening
        );
        out.gloss = max(out.gloss, wet * (0.3 as f32));
        return out;
    }

    // Moss and a fringe of lusher growth where the ground is damp, on rock and soil alike, not on a wall.
    fn withMoss(self, site : GroundSite, cell : ReliefSpot, albedo : Vec3, w : GroundWeights) : Vec3 {
        let damp : f32 = max(site.damp, cell.wet * (0.6 as f32));
        if (damp <= (0.05 as f32) || w.gravel + w.mud > (0.9 as f32)) {
            return albedo;
        }
        let growth : f32 = waterFbm2(site.p.x * (0.35 as f32), site.p.z * (0.35 as f32), 3, GROUND_SEED_MOSS);
        let fringe : f32 = smoothstep((0.05 as f32), (0.3 as f32), damp)
            * ((1.0 as f32) - smoothstep((0.6 as f32), (0.95 as f32), site.damp))
            * smoothstep((0.3 as f32), (0.6 as f32), growth);
        let flat : f32 = (1.0 as f32) - smoothstep((0.6 as f32), (1.3 as f32), site.slope);
        return albedo.lerp(self.look.moss.scale((2.0 as f32) + growth), fringe * flat * (0.6 as f32));
    }

    // Snow: it settles above a line that is lower on north slopes, in ragged patches, on ground that is not too steep.
    fn withSnow(self, site : GroundSite, patch : GroundPatch) : GroundPatch {
        let p : Vec3 = site.p;
        if (p.y + GROUND_SNOW_NORTH + GROUND_SNOW_BAND <= self.look.snowLine) {
            return patch;
        }
        let ragged : f32 = waterFbm3(p.scale((0.03 as f32)), 3, GROUND_SEED_SNOW) - (0.5 as f32);
        let north : f32 = max((0.0 as f32) - site.n.z, (0.0 as f32));
        let line : f32 = self.look.snowLine - GROUND_SNOW_NORTH * north + ragged * (120.0 as f32);
        let cover : f32 = smoothstep(line, line + GROUND_SNOW_BAND, p.y);
        let holds : f32 = (1.0 as f32) - smoothstep((0.8 as f32), (1.5 as f32), site.slope);
        let share : f32 = cover * holds;
        if (share <= (0.0 as f32)) {
            return patch;
        }
        let sparkle : f32 = (0.92 as f32)
            + (0.16 as f32) * waterValue3(p.scale((6.0 as f32)), GROUND_SEED_SNOW + 5);
        let mut out : GroundPatch = patch;
        out.albedo = patch.albedo.lerp(self.look.snow.scale(sparkle), share);
        out.tilt = patch.tilt.scale((1.0 as f32) - share * (0.7 as f32));
        out.gloss = patch.gloss + share * (0.25 as f32);
        return out;
    }

    // `a` and `b` mixed by `t`.
    static fn mix(a : GroundPatch, b : GroundPatch, t : f32) : GroundPatch {
        return GroundPatch {
            albedo: a.albedo.lerp(b.albedo, t),
            tilt: a.tilt.lerp(b.tilt, t),
            gloss: a.gloss + (b.gloss - a.gloss) * t,
            open: a.open + (b.open - a.open) * t,
            sun: a.sun + (b.sun - a.sun) * t,
        };
    }

    // `a` plus `b` weighted by `w`.
    static fn add(a : GroundPatch, b : GroundPatch, w : f32) : GroundPatch {
        return GroundPatch {
            albedo: a.albedo.plus(b.albedo.scale(w)),
            tilt: a.tilt.plus(b.tilt.scale(w)),
            gloss: a.gloss + b.gloss * w,
            open: a.open + b.open * w,
            sun: a.sun + b.sun * w,
        };
    }
}

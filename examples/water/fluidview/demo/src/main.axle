// main — waterdemo, the renderer's own demo program: analytic water scenes, drawn headless or in a window.
//
// `--demo geyser|shore` picks an older analytic scene; without it, the waterfall vista (`--demo fall`) runs; `--at SECONDS` picks the moment for a picture; every
// option of the shared command line applies (see `fluidview`'s options). With `--frame FILE` it writes a picture
// and exits; without, it opens a window and advances the scene by one sixtieth of a second a frame.

use fluidview::{CamOrbit, FallRig, FallScene, FallShots, VistaRenderer, VistaRun};
use fluidview::{
    Cli, DemoKind, Hud, Options, Pen, ContactSheet, SCENE_DROPS, WaterDemo, WaterHud, WaterLook,
    WaterRenderer, WaterRun, WaterScene, WaterViewer, WaterViewerDesc, DEMO_GRID, HUD_ACCENT, HUD_MARGIN,
    HUD_TITLE_SCALE
};
use ludax::Vec3;
use ludax::Vec3;
use smalt::PlatformError;

/** Simulated seconds a default demo picture is taken at, and a window frame advances by. */
const DEMO_MOMENT : f32 = 3.6;
const DEMO_FILM_STEP : f32 = 0.4;
const DEMO_FRAME_LIMIT : f32 = 0.1;
const FILM_COLUMNS : i32 = 4;

fn kindOf(o : Options) : DemoKind {
    if (o.demo == "shore") {
        return DemoKind::Shore;
    }
    return DemoKind::Geyser;
}

fn main() : i32 {
    let o : Options = Cli::parse();
    if (o.problem.length > 0) {
        println(o.problem);
        println(Cli::usage("waterdemo"));
        return 2;
    }
    if (o.help) {
        println(Cli::usage("waterdemo"));
        return 0;
    }
    if (o.demo != "geyser" && o.demo != "shore") {
        if (o.frame.length > 0 || o.film > 0 || o.sheet || o.checkThreads) {
            return VistaRun::run(o);
        }
        return fallWindow(o);
    }
    let kind : DemoKind = kindOf(o);
    let mut scene : Shared<WaterScene> = share new WaterScene(DEMO_GRID, DEMO_GRID, SCENE_DROPS);
    scene.look = WaterRun::look(o, WaterDemo::look(kind, WaterLook {}));
    if (o.frame.length > 0) {
        return picture(o, kind, scene);
    }
    return window(o, kind, scene);
}

fn moment(o : Options) : f32 {
    if (Options::given(o.at)) {
        return o.at as f32;
    }
    return DEMO_MOMENT;
}

// N frames a fixed step apart, each a numbered BMP, and the contact sheet of them all.
fn film(o : Options, kind : DemoKind, scene : Shared<WaterScene>) : i32 {
    let r : WaterRenderer = new WaterRenderer(
        scene,
        WaterRun::width(o),
        WaterRun::height(o),
        WaterRun::scale(o),
        WaterRun::threads(o)
    );
    defer r.close();
    let sheet : ContactSheet = new ContactSheet(o.film, FILM_COLUMNS, r.outWidth, r.outHeight);
    defer sheet.close();
    let mut step : f32 = DEMO_FILM_STEP;
    if (Options::given(o.step)) {
        step = o.step as f32;
    }
    let orbit : CamOrbit = WaterRun::orbit(o, WaterDemo::orbit(kind));
    let mut ok : bool = true;
    for (i of 0..o.film) {
        WaterDemo::fill(scene, kind, moment(o) + (i as f32) * step);
        WaterRun::draw(r, orbit, o.samples);
        let name : string = Cli::beside(o.frame, "_${i}");
        ok = WaterRun::save(r, name) && ok;
        sheet.add(i, r);
    }
    ok = sheet.save(Cli::beside(o.frame, "_sheet")) && ok;
    if (ok) {
        return 0;
    }
    return 1;
}

fn picture(o : Options, kind : DemoKind, scene : Shared<WaterScene>) : i32 {
    if (o.film > 0) {
        return film(o, kind, scene);
    }
    WaterDemo::fill(scene, kind, moment(o));
    let r : WaterRenderer = new WaterRenderer(
        scene,
        WaterRun::width(o),
        WaterRun::height(o),
        WaterRun::scale(o),
        WaterRun::threads(o)
    );
    defer r.close();
    WaterRun::draw(r, WaterRun::orbit(o, WaterDemo::orbit(kind)), o.samples);
    if (o.prof) {
        WaterRun::profile(r);
    }
    WaterRun::probe(o, r);
    if (WaterRun::save(r, o.frame)) {
        return 0;
    }
    return 1;
}

fn window(o : Options, kind : DemoKind, scene : Shared<WaterScene>) : i32 {
    try {
        return play(o, kind, scene);
    } catch e : PlatformError {
        println(e.message);
        return 1;
    }
}

// A frame of the older scenes: while the water moves or the camera does, the picture is drawn at half size (a
// quarter of the pixels) and shown doubled; held still and paused, the full-size renderer refines it.
fn play(o : Options, kind : DemoKind, scene : Shared<WaterScene>) : i32 ! PlatformError {
    let full : WaterRenderer = new WaterRenderer(
        scene,
        WaterRun::width(o),
        WaterRun::height(o),
        WaterRun::scale(o),
        WaterRun::threads(o)
    );
    defer full.close();
    let half : WaterRenderer = new WaterRenderer(
        scene,
        WaterRun::width(o) / 2,
        WaterRun::height(o) / 2,
        WaterRun::scale(o) * 2,
        WaterRun::threads(o)
    );
    defer half.close();
    let view = new WaterViewer(
        WaterViewerDesc {
            title: "Water",
            shot: "water.bmp",
            orbit: WaterRun::orbit(o, WaterDemo::orbit(kind)),
        },
        full.outWidth,
        full.outHeight
    );
    defer view.close();

    let mut now : f32 = moment(o);
    while (view.pump()) {
        let ticking : bool = !view.paused();
        if (ticking) {
            now = now + ludax::min(view.seconds(), DEMO_FRAME_LIMIT);
            WaterDemo::fill(scene, kind, now);
        }
        if (view.visible()) {
            let moving : bool = ticking || view.moved();
            let mut r : WaterRenderer = full;
            if (moving) {
                r = half;
            }
            r.render(view.orbit, ticking);
            view.fill(r);
            let title : Pen = Pen::at(HUD_MARGIN, HUD_MARGIN, HUD_ACCENT);
            view.hud.text(view.frame(), title.scaled(HUD_TITLE_SCALE), "Water");
            WaterHud::physics(
                view.hud,
                view.frame(),
                Pen::at(HUD_MARGIN, 40, HUD_ACCENT),
                scene.look.physics
            );
            WaterHud::cost(view.hud, view.frame(), Pen::at(HUD_MARGIN, 40, HUD_ACCENT), r);
            view.present();
        }
    }
    return 0;
}

// The waterfall in a window: left and right move along the shot, P pauses; while the camera or the water moves
// the picture is drawn at half size from a lighter drop set, and a held, paused view refines at full size.
fn fallWindow(o : Options) : i32 {
    try {
        return fallPlay(o);
    } catch e : PlatformError {
        println(e.message);
        return 1;
    }
}

const FALL_MOVE : f32 = 0.12;
const FALL_FAST_DROPS : i32 = 150000;

fn fallPlay(o : Options) : i32 ! PlatformError {
    let land : Shared<FallScene> = VistaRun::landscape(o);
    let w : i32 = VistaRun::sizeOf(o);
    let h : i32 = VistaRun::full(o);
    let slow : FallRig = VistaRun::make(o, land, w, h, VistaRun::dropsOf(o));
    defer slow.close();
    let fast : FallRig = VistaRun::make(o, land, w / 2, h / 2, FALL_FAST_DROPS);
    defer fast.close();
    let view = new WaterViewer(
        WaterViewerDesc {
            title: "Waterfall",
            shot: "fall.bmp",
            orbit: CamOrbit {
                target: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
                dist: 10.0,
                yaw: VistaRun::start(o) / FALL_MOVE,
                pitch: 0.5,
            },
        },
        w,
        h
    );
    defer view.close();
    let mut now : f32 = VistaRun::moment(o);
    while (view.pump()) {
        let ticking : bool = !view.paused();
        if (ticking) {
            now = now + ludax::min(view.seconds(), DEMO_FRAME_LIMIT);
        }
        let u : f32 = ludax::clamp(view.orbit.yaw * FALL_MOVE, 0.0, 1.0);
        if (view.visible()) {
            if (ticking || view.moved()) {
                fast.e.emit(now, fast.r.look.physics.gravity);
                fast.r.render(FallShots::shot(VistaRun::shot(o), u, w / 2, h / 2), now, ticking);
                view.fillPixels(fast.r.pixels(), w / 2, h / 2, 2);
                fallHud(view, fast.r);
            } else {
                slow.e.emit(now, slow.r.look.physics.gravity);
                slow.r.render(FallShots::shot(VistaRun::shot(o), u, w, h), now, false);
                view.fillPixels(slow.r.pixels(), w, h, 1);
                fallHud(view, slow.r);
            }
            view.present();
        }
    }
    return 0;
}

fn fallHud(view : WaterViewer, r : VistaRenderer) : void {
    let title : Pen = Pen::at(HUD_MARGIN, HUD_MARGIN, HUD_ACCENT);
    view.hud.text(view.frame(), title.scaled(HUD_TITLE_SCALE), "Waterfall");
    WaterHud::physics(view.hud, view.frame(), Pen::at(HUD_MARGIN, 40, HUD_ACCENT), r.look.physics);
    WaterHud::timing(view.hud, view.frame(), Pen::at(HUD_MARGIN, 40, HUD_ACCENT), r.samples, r.spent[0]);
}

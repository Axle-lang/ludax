// options — the command line of terrain_preview: what to draw, and which landscape to make.
//
// Values are read by hand (digits, one dot, a leading minus) because the program wants a mistake named, not guessed.

use std::lang::IndexOutOfBoundsException;
use std::sys::process::{argc, argAt};

use fluidview::TerrainParams;

const OPT_ZERO : i32 = 48;
const OPT_NINE : i32 = 57;
const OPT_DOT : i32 = 46;
const OPT_MINUS : i32 = 45;

/** What the command line asked for. */
pub class TerrainOptions {
    /** Map file, or empty. */
    pub preview : string = "";

    /** Section file, or empty. */
    pub section : string = "";

    /** Close view of the fall, or empty. */
    pub fall : string = "";

    /** Perspective file, or empty. */
    pub view : string = "";

    /** Run the check. */
    pub check : bool = false;

    /** Print the usage. */
    pub help : bool = false;

    /** The seed. */
    pub seed : i32 = 7;

    /** Worker threads for generation. */
    pub threads : i32 = 4;

    /** Map pixel size in cells. */
    pub scale : i32 = 1;

    /** Camera yaw of the perspective view, radians (0 looks north from the south end). */
    pub yaw : f32 = 0.0;

    /** Camera pitch, radians, positive looks down. */
    pub pitch : f32 = 0.18;

    /** Camera height above the ground, metres. */
    pub height : f32 = 420.0;

    /** The landscape's parameters. */
    pub params : TerrainParams = TerrainParams {};

    /** The first mistake on the command line, or empty. */
    pub problem : string = "";

    /** The usage text. */
    pub static fn usage() : string {
        return "usage: terrain_preview [--preview F] [--section F] [--view F] [--fall F] [--check] [--seed N] [--size M] [--cell M] [--threads N] [--mountain H] [--sinuosity S] [--erosion E] [--scale N] [--yaw A] [--pitch A] [--height H]";
    }

    /** Reads the process arguments. */
    pub static fn parse() : TerrainOptions {
        let mut o : TerrainOptions = new TerrainOptions();
        let mut i : i32 = 1;
        while (i < argc() && o.problem.length == 0) {
            let arg : string = TerrainOptions::argument(i);
            if (arg == "--help") {
                o.help = true;
            } else if (arg == "--check") {
                o.check = true;
            } else {
                i = i + 1;
                if (i >= argc()) {
                    o.problem = "${arg} needs a value";
                } else {
                    TerrainOptions::assign(o, arg, TerrainOptions::argument(i));
                }
            }
            i = i + 1;
        }
        return o;
    }

    static fn assign(mut o : TerrainOptions, name : string, value : string) : void {
        let number : f32 = TerrainOptions::number(value);
        if (name == "--preview") {
            o.preview = value;
        } else if (name == "--section") {
            o.section = value;
        } else if (name == "--view") {
            o.view = value;
        } else if (name == "--fall") {
            o.fall = value;
        } else if (name == "--seed") {
            o.seed = number as i32;
        } else if (name == "--threads") {
            o.threads = number as i32;
        } else if (name == "--scale") {
            o.scale = number as i32;
        } else if (name == "--yaw") {
            o.yaw = number;
        } else if (name == "--pitch") {
            o.pitch = number;
        } else if (name == "--height") {
            o.height = number;
        } else if (name == "--size") {
            o.params.worldSize = number;
        } else if (name == "--cell") {
            o.params.cellSize = number;
        } else if (name == "--mountain") {
            o.params.mountainHeight = number;
        } else if (name == "--sinuosity") {
            o.params.sinuosity = number;
        } else if (name == "--erosion") {
            o.params.erosionStrength = number;
        } else {
            o.problem = "unknown option ${name}";
        }
    }

    static fn argument(i : i32) : string {
        try {
            return argAt(i) + "";
        } catch e : IndexOutOfBoundsException {
            return "";
        }
    }

    // The number written in `s` (0 when it is not one).
    static fn number(s : string) : f32 {
        let mut whole : f32 = 0.0;
        let mut scale : f32 = 0.0;
        let mut sign : f32 = 1.0;
        for (i of 0..s.byteLength) {
            let c : i32 = s.byteAt(i);
            if (c == OPT_MINUS) {
                sign = -1.0;
            } else if (c == OPT_DOT) {
                scale = 1.0;
            } else if (c >= OPT_ZERO && c <= OPT_NINE) {
                let digit : f32 = (c - OPT_ZERO) as f32;
                if (scale == 0.0 as f32) {
                    whole = whole * 10.0 as f32 + digit;
                } else {
                    scale = scale * 0.1 as f32;
                    whole = whole + digit * scale;
                }
            }
        }
        return whole * sign;
    }
}

// main — terrain_preview: generates a HydroTerrain and draws it, or checks it.
//
//   --preview FILE.bmp   hillshaded map from above, with the lake, river, crest, lip and pool marked
//   --section FILE.bmp   the bed profile along the river, the cut down the valley through the fall, a channel section
//   --view FILE.bmp      a perspective view of the valley from downstream (--yaw A --pitch A --height H move it)
//   --check              assert the terrain is consistent for water and print what was measured; exit status = failures
//
// Parameters: --seed N  --size METRES  --cell METRES  --threads N  --mountain H  --sinuosity S  --erosion E
//             --scale N (map pixels cover N by N cells)
// Without a picture or --check it prints the measurements and the time generation took.

use fluidview::{HydroTerrain, TerrainParams};
use ludax::{nanosToMillis, nowNanos};

use crate::check::TerrainCheck;
use crate::options::TerrainOptions;
use crate::section::Section;
use crate::topdown::TopDown;
use crate::view::{PerspectiveView, ViewShot};

fn main() : i32 {
    let o : TerrainOptions = TerrainOptions::parse();
    if (o.problem.length > 0) {
        println(o.problem);
        println(TerrainOptions::usage());
        return 2;
    }
    if (o.help) {
        println(TerrainOptions::usage());
        return 0;
    }

    let begin : i64 = nowNanos();
    let t : HydroTerrain = HydroTerrain::generate(o.seed, o.params, o.threads);
    let millis : f64 = nanosToMillis(nowNanos() - begin);
    println("generated ${t.width} x ${t.depth} cells of ${t.cellSize} m in ${millis} ms with ${o.threads} threads");

    let mut failures : i32 = 0;
    if (o.preview.length > 0 && !TopDown::save(t, o.preview, o.scale)) {
        failures = failures + 1;
    }
    if (o.section.length > 0 && !Section::save(t, o.section)) {
        failures = failures + 1;
    }
    if (o.view.length > 0
        && !PerspectiveView::save(t, o.view, ViewShot::valley(t, o.yaw, o.pitch, o.height))) {
        failures = failures + 1;
    }
    if (o.fall.length > 0 && !PerspectiveView::save(t, o.fall, ViewShot::fall(t, 150.0, 22.0, o.yaw))) {
        failures = failures + 1;
    }
    if (o.check) {
        failures = failures + TerrainCheck::run(o, t);
    }
    return failures;
}

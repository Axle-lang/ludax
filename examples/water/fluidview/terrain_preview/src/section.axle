// section — three cuts through a HydroTerrain, to judge its heights where a top view cannot.
//
//   top      the valley's own profile: height against the distance south, along the line through the lip, with the
//            reservoir's surface in blue, the mountains behind it, the cliff, the pool and the floodplain falling away
//   middle   the river's long profile, bank tops and bed against the distance along the channel, with the height of
//            the grid along the centreline in white: the bed must run down without a step
//   bottom   the channel's cross-section at its sharpest bend, the outside on the right: steep cutbank, shoaling bar
//
// Each panel is scaled to its own data; a tick marks every hundred metres across and every ten up (top, middle) or one
// metre (bottom). There is no lettering: the numbers are in the check's printout.

use fluidview::{HydroTerrain, RiverPoint};
use smalt::{Bmp, Surface};

use crate::shading::Tint;

const SECTION_WIDTH : i32 = 1400;
const SECTION_PANEL : i32 = 320;
const SECTION_GAP : i32 = 8;

// The top panel shows this share of the world's depth, from the north edge: the mountains, the lake and the fall.
const SECTION_VALLEY_SHARE : f32 = 0.5;

// The bottom panel shows this many metres each side of the centreline, and this many metres of height.
const SECTION_REACH : f32 = 60.0;
const SECTION_SPAN : f32 = 9.0;

/** The section pictures. */
pub class Section {
    /** Draws the three panels of `t` to `path`; false when the file cannot be written. */
    pub static fn save(t : HydroTerrain, path : string) : bool {
        let height : i32 = SECTION_PANEL * 3 + SECTION_GAP * 2;
        let surface : Surface = new Surface(SECTION_WIDTH, height);
        let mut pixels : i32[] = surface.pixels();
        let paper : i32 = Tint::rgb(24.0, 26.0, 32.0).pack();
        for (i of 0..((SECTION_WIDTH as i64) * (height as i64))) {
            pixels[i] = paper;
        }

        Section::valley(t, pixels, 0);
        Section::profile(t, pixels, SECTION_PANEL + SECTION_GAP);
        Section::bend(t, pixels, (SECTION_PANEL + SECTION_GAP) * 2);

        let ok : bool = Bmp::write(path, surface.frame());
        surface.close();
        return ok;
    }

    static fn put(pixels : i32[], x : i32, y : i32, top : i32, colour : i32) : void {
        if (x < 0 || x >= SECTION_WIDTH || y < top || y >= top + SECTION_PANEL) {
            return;
        }
        pixels[((y as i64) * (SECTION_WIDTH as i64)) + (x as i64)] = colour;
    }

    // Fills the column x of a panel from row `from` down to the panel's bottom.
    static fn fall(pixels : i32[], x : i32, from : i32, top : i32, colour : i32) : void {
        for (y of from..(top + SECTION_PANEL)) {
            Section::put(pixels, x, y, top, colour);
        }
    }

    // The row of height `v` in a panel whose heights run from `low` to `high`.
    static fn row(v : f32, low : f32, high : f32, top : i32) : i32 {
        let t : f32 = (v - low) / ludax::max(high - low, 0.001 as f32);
        return top + SECTION_PANEL - 4 - (t * ((SECTION_PANEL - 8) as f32)) as i32;
    }

    static fn valley(t : HydroTerrain, pixels : i32[], top : i32) : void {
        let x : f32 = t.escarpment.lip.x;
        let reach : f32 = t.worldDepth() * SECTION_VALLEY_SHARE;
        let mut low : f32 = t.heightAt(x, reach);
        let mut high : f32 = low;
        for (c of 0..SECTION_WIDTH) {
            let h : f32 = t.heightAt(x, ((c as f32) / (SECTION_WIDTH as f32)) * reach);
            low = ludax::min(low, h);
            high = ludax::max(high, h);
        }
        low = low - 5.0 as f32;
        high = high + 5.0 as f32;
        let sky : i32 = Tint::rgb(96.0, 140.0, 196.0).pack();
        let rock : i32 = Tint::rgb(118.0, 108.0, 96.0).pack();
        let water : i32 = Tint::rgb(30.0, 78.0, 140.0).pack();
        for (c of 0..SECTION_WIDTH) {
            let z : f32 = ((c as f32) / (SECTION_WIDTH as f32)) * reach;
            let h : f32 = t.heightAt(x, z);
            for (y of top..(top + SECTION_PANEL)) {
                Section::put(pixels, c, y, top, sky);
            }
            let mut level : f32 = h;
            if (t.isLakeAt(x, z)) {
                level = t.lake.level;
            } else if (h < t.params.outflowLevel) {
                level = t.params.outflowLevel;
            }
            Section::fall(pixels, c, Section::row(level, low, high, top), top, water);
            Section::fall(pixels, c, Section::row(h, low, high, top), top, rock);
        }
        Section::ticks(pixels, top, reach / 100.0 as f32);
    }

    static fn profile(t : HydroTerrain, pixels : i32[], top : i32) : void {
        let first : RiverPoint = t.river[0];
        let last : RiverPoint = t.river[(t.riverCount - 1) as i64];
        let low : f32 = last.bedHeight - 1.0 as f32;
        let high : f32 = first.bankHeight + 1.0 as f32;
        let bank : i32 = Tint::rgb(110.0, 170.0, 80.0).pack();
        let bed : i32 = Tint::rgb(180.0, 130.0, 80.0).pack();
        let grid : i32 = Tint::rgb(250.0, 250.0, 250.0).pack();
        let level : i32 = Tint::rgb(60.0, 120.0, 220.0).pack();
        for (c of 0..SECTION_WIDTH) {
            let at : f32 = ((c as f32) / (SECTION_WIDTH as f32)) * ((t.riverCount - 1) as f32);
            let i : i32 = at as i32;
            let p : RiverPoint = t.river[i as i64];
            Section::put(pixels, c, Section::row(p.bankHeight, low, high, top), top, bank);
            Section::put(pixels, c, Section::row(p.bedHeight, low, high, top), top, bed);
            Section::put(pixels, c, Section::row(t.heightAt(p.x, p.z), low, high, top), top, grid);
            Section::put(pixels, c, Section::row(t.outflow.level, low, high, top), top, level);
        }
        Section::ticks(pixels, top, last.arc / 100.0 as f32);
    }

    // The channel at the point of greatest curvature, looking downstream: the left bank on the left.
    static fn bend(t : HydroTerrain, pixels : i32[], top : i32) : void {
        let mut apex : i32 = 1;
        for (i of 1..(t.riverCount - 1)) {
            if (ludax::abs(t.river[i as i64].curvature) > ludax::abs(t.river[apex as i64].curvature)) {
                apex = i;
            }
        }
        let p : RiverPoint = t.river[apex as i64];
        let low : f32 = p.bankHeight - SECTION_SPAN;
        let high : f32 = p.bankHeight + SECTION_SPAN * 0.25 as f32;
        let ground : i32 = Tint::rgb(150.0, 120.0, 84.0).pack();
        let bank : i32 = Tint::rgb(110.0, 170.0, 80.0).pack();
        let mut mirror : f32 = 1.0 as f32;
        if (p.curvature > 0.0 as f32) {
            mirror = -1.0 as f32;
        }
        for (c of 0..SECTION_WIDTH) {
            let s : f32 = ((c as f32) / (SECTION_WIDTH as f32) * 2.0 as f32 - 1.0 as f32) * SECTION_REACH;
            // The left of the flow is (dirZ, -dirX); the picture is mirrored so the outside of the bend is always on the right.
            let x : f32 = p.x + p.dirZ * s * mirror;
            let z : f32 = p.z - p.dirX * s * mirror;
            Section::fall(pixels, c, Section::row(t.heightAt(x, z), low, high, top), top, ground);
            Section::put(pixels, c, Section::row(p.bankHeight, low, high, top), top, bank);
        }
        let metres : f32 = SECTION_SPAN * 1.25 as f32;
        Section::ticks(pixels, top, metres * 4.0 as f32);
    }

    // Marks along the bottom edge of a panel, `count` of them across.
    static fn ticks(pixels : i32[], top : i32, count : f32) : void {
        let colour : i32 = Tint::rgb(255.0, 255.0, 255.0).pack();
        let n : i32 = count as i32;
        for (k of 0..(n + 1)) {
            let x : i32 = ((k as f32) / ludax::max(count, 1.0 as f32) * (SECTION_WIDTH as f32)) as i32;
            Section::put(pixels, x, top + SECTION_PANEL - 1, top, colour);
            Section::put(pixels, x, top + SECTION_PANEL - 2, top, colour);
        }
    }
}

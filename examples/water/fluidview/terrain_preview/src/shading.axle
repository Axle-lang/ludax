// shading — the colour of a point of a HydroTerrain: hypsometric tint, material, hillshade and water.
//
// The previews share one answer to "what colour is this ground": the material the generator decided on, lit by a low
// sun from the north-west, with snow above the tree line, wet ground darkened and the water of the lake, the river
// bed and the end lake tinted by their depth. Colours are 0 to 255 per channel, packed with `Color::packBytes`.

use fluidview::{
    terrainFbm, terrainNoise, HydroTerrain, HYDRO_FIELD, HYDRO_FOREST, HYDRO_GRASS, HYDRO_GRAVEL, HYDRO_MUD,
    HYDRO_ROCK, HYDRO_SCREE
};
use ludax::{saturate, sqrt, Vec3};
use smalt::Color;

// Height above the datum from which the rock turns to snow, and the width of the transition, metres.
const SHADE_SNOW_FROM : f32 = 330.0;
const SHADE_SNOW_SPAN : f32 = 90.0;

/** One colour, as three floats in 0..255. */
pub struct Tint {
    /** Red. */
    pub r : f32 = 0.0;

    /** Green. */
    pub g : f32 = 0.0;

    /** Blue. */
    pub b : f32 = 0.0;

    /** A tint from its channels. */
    pub static fn rgb(r : f32, g : f32, b : f32) : Tint {
        return Tint { r: r, g: g, b: b };
    }

    /** This tint scaled by `k`. */
    pub fn scaled(self, k : f32) : Tint {
        return Tint { r: self.r * k, g: self.g * k, b: self.b * k };
    }

    /** `self` blended toward `other` by `t` in 0..1. */
    pub fn mixed(self, other : Tint, t : f32) : Tint {
        let u : f32 = 1.0 as f32 - t;
        return Tint { r: self.r * u + other.r * t, g: self.g * u + other.g * t, b: self.b * u + other.b * t };
    }

    /** Packed for a surface, each channel clamped. */
    pub fn pack(self) : i32 {
        return Color::packBytes(Tint::byte(self.r), Tint::byte(self.g), Tint::byte(self.b));
    }

    static fn byte(v : f32) : i32 {
        if (v < 0.0 as f32) {
            return 0;
        }
        if (v > 255.0 as f32) {
            return 255;
        }
        return v as i32;
    }
}

/** How a terrain is coloured. */
pub class Shading {
    /** The unit direction toward the sun. */
    pub static fn sun() : Vec3 {
        return Vec3::make(-0.55, 0.62, -0.55).normalized();
    }

    /** The colour of the material code `code`. */
    pub static fn material(code : u8) : Tint {
        if (code == HYDRO_ROCK) {
            return Tint::rgb(128.0, 122.0, 114.0);
        }
        if (code == HYDRO_SCREE) {
            return Tint::rgb(158.0, 146.0, 128.0);
        }
        if (code == HYDRO_GRASS) {
            return Tint::rgb(104.0, 132.0, 66.0);
        }
        if (code == HYDRO_FOREST) {
            return Tint::rgb(48.0, 84.0, 46.0);
        }
        if (code == HYDRO_GRAVEL) {
            return Tint::rgb(196.0, 180.0, 142.0);
        }
        if (code == HYDRO_MUD) {
            return Tint::rgb(92.0, 74.0, 56.0);
        }
        if (code == HYDRO_FIELD) {
            return Tint::rgb(170.0, 152.0, 84.0);
        }
        return Tint::rgb(255.0, 0.0, 255.0);
    }

    /** The lit colour of the ground at (x, z), without water. */
    pub static fn ground(t : HydroTerrain, x : f32, z : f32) : Tint {
        let height : f32 = t.heightAt(x, z) - t.params.outflowLevel;
        let mut tint : Tint = Shading::material(t.materialAt(x, z));
        let snow : f32 = saturate((height - SHADE_SNOW_FROM) / SHADE_SNOW_SPAN);
        let steep : f32 = saturate(1.4 as f32 - t.slopeAt(x, z) * 1.6 as f32);
        tint = tint.mixed(Tint::rgb(214.0, 218.0, 226.0), snow * steep);
        let wet : f32 = (t.wetnessAt(x, z) as f32) / 255.0 as f32;
        tint = tint.scaled(1.0 as f32 - 0.28 as f32 * wet);
        let grain : f32 = 0.86 as f32 + 0.14 as f32 * terrainFbm(x / 14.0 as f32, z / 14.0 as f32, 5, 3)
            + 0.10 as f32 * terrainNoise(x / 90.0 as f32, z / 90.0 as f32, 9);
        tint = tint.scaled(grain);
        let n : Vec3 = t.normalAt(x, z);
        let lit : f32 = saturate(n.dot(Shading::sun()));
        return tint.scaled(0.28 as f32 + 0.62 as f32 * lit);
    }

    /** The colour of the water over bed height `bed` under a surface at `level`: deeper is darker and bluer. */
    pub static fn water(bed : f32, level : f32, lit : f32) : Tint {
        let depth : f32 = saturate((level - bed) / 12.0 as f32);
        let shallow : Tint = Tint::rgb(96.0, 150.0, 160.0);
        let deep : Tint = Tint::rgb(18.0, 52.0, 96.0);
        return shallow.mixed(deep, sqrt(depth)).scaled(0.7 as f32 + 0.3 as f32 * lit);
    }
}

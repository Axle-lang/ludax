// topdown — the map of a HydroTerrain: hillshaded colour from above, with the water's features marked.
//
// One pixel is one cell (`scale` 1), or a block of `scale` by `scale` cells averaged away by sampling the middle one.
// The marks are what a reader checks against the numbers: the lake in blue, the river's centreline in red, the crest of
// the escarpment in orange, the lip in yellow, the plunge pool ringed in cyan, the inflows in magenta and the end of
// the river in white.

use fluidview::{HydroSpot, HydroTerrain, RiverPoint};
use smalt::{Bmp, Surface};

use crate::shading::{Shading, Tint};

/** The map pictures. */
pub class TopDown {
    /** Draws `t` to `path`, one pixel per `scale` cells; false when the file cannot be written. */
    pub static fn save(t : HydroTerrain, path : string, scale : i32) : bool {
        let w : i32 = t.width / scale;
        let h : i32 = t.depth / scale;
        let surface : Surface = new Surface(w, h);
        let mut pixels : i32[] = surface.pixels();

        for (py of 0..h) {
            for (px of 0..w) {
                let x : f32 = ((px as f32) + 0.5 as f32) * (scale as f32) * t.cellSize;
                let z : f32 = ((py as f32) + 0.5 as f32) * (scale as f32) * t.cellSize;
                pixels[((py as i64) * (w as i64)) + (px as i64)] = TopDown::colour(t, x, z).pack();
            }
        }
        TopDown::marks(t, pixels, w, h, scale);

        let ok : bool = Bmp::write(path, surface.frame());
        surface.close();
        return ok;
    }

    // Ground, or the water over it.
    static fn colour(t : HydroTerrain, x : f32, z : f32) : Tint {
        let ground : Tint = Shading::ground(t, x, z);
        let bed : f32 = t.heightAt(x, z);
        if (t.isLakeAt(x, z)) {
            return Shading::water(bed, t.lake.level, 0.9 as f32);
        }
        if (bed < t.params.outflowLevel) {
            return Shading::water(bed, t.params.outflowLevel, 0.9 as f32);
        }
        return ground;
    }

    static fn marks(t : HydroTerrain, pixels : i32[], w : i32, h : i32, scale : i32) : void {
        let red : i32 = Tint::rgb(235.0, 40.0, 40.0).pack();
        for (i of 0..t.riverCount) {
            let p : RiverPoint = t.river[i as i64];
            TopDown::dot(pixels, w, h, TopDown::pixel(t, p.x, scale), TopDown::pixel(t, p.z, scale), red, 0);
        }

        let orange : i32 = Tint::rgb(255.0, 150.0, 20.0).pack();
        for (i of 0..t.crestCount) {
            let s : HydroSpot = t.crest[i as i64];
            TopDown::dot(
                pixels,
                w,
                h,
                TopDown::pixel(t, s.x, scale),
                TopDown::pixel(t, s.z, scale),
                orange,
                0
            );
        }

        let cyan : i32 = Tint::rgb(40.0, 230.0, 235.0).pack();
        let c : HydroSpot = t.pool.center;
        let radius : i32 = (t.pool.radius / t.cellSize) as i32 / scale;
        TopDown::ring(
            pixels,
            w,
            h,
            TopDown::pixel(t, c.x, scale),
            TopDown::pixel(t, c.z, scale),
            radius,
            cyan
        );

        let yellow : i32 = Tint::rgb(255.0, 240.0, 40.0).pack();
        let lip : HydroSpot = t.escarpment.lip;
        TopDown::dot(
            pixels,
            w,
            h,
            TopDown::pixel(t, lip.x, scale),
            TopDown::pixel(t, lip.z, scale),
            yellow,
            4
        );

        let magenta : i32 = Tint::rgb(240.0, 60.0, 230.0).pack();
        for (i of 0..t.inflowCount) {
            let s : HydroSpot = t.inflows[i as i64].at;
            TopDown::dot(
                pixels,
                w,
                h,
                TopDown::pixel(t, s.x, scale),
                TopDown::pixel(t, s.z, scale),
                magenta,
                3
            );
        }

        let white : i32 = Tint::rgb(255.0, 255.0, 255.0).pack();
        let end : HydroSpot = t.outflow.at;
        TopDown::dot(
            pixels,
            w,
            h,
            TopDown::pixel(t, end.x, scale),
            TopDown::pixel(t, end.z, scale),
            white,
            3
        );
    }

    // The pixel column or row of world coordinate v.
    static fn pixel(t : HydroTerrain, v : f32, scale : i32) : i32 {
        return (v / (t.cellSize * (scale as f32))) as i32;
    }

    // A filled square of half size `half` around (cx, cy), clipped to the picture.
    static fn dot(pixels : i32[], w : i32, h : i32, cx : i32, cy : i32, colour : i32, half : i32) : void {
        for (dy of (0 - half)..(half + 1)) {
            for (dx of (0 - half)..(half + 1)) {
                let x : i32 = cx + dx;
                let y : i32 = cy + dy;
                if (x < 0 || y < 0 || x >= w || y >= h) {
                    continue;
                }
                pixels[((y as i64) * (w as i64)) + (x as i64)] = colour;
            }
        }
    }

    // A one-pixel circle of `radius` around (cx, cy).
    static fn ring(pixels : i32[], w : i32, h : i32, cx : i32, cy : i32, radius : i32, colour : i32) : void {
        let steps : i32 = radius * 8 + 16;
        for (k of 0..steps) {
            let a : f32 = (k as f32) * 6.2831853 as f32 / (steps as f32);
            let x : i32 = cx + ((ludax::cos(a) * (radius as f32)) as i32);
            let y : i32 = cy + ((ludax::sin(a) * (radius as f32)) as i32);
            TopDown::dot(pixels, w, h, x, y, colour, 0);
        }
    }
}

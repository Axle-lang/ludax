// cascade_books — where every cubic metre of the cascade is, read from the engine's state.
//
// "Everything transforms, nothing is created, nothing is lost": the demo's point. The volume in each compartment is
// summed from the engine's cell depths and its airborne volume, never kept by the scene:
//
//   reservoir   the cells of the terrain's lake mask
//   curtain     the water in the air (falling parcels and the volume waiting at the lips)
//   pool        the cells within a radius and a half of the plunge pool's centre
//   river       every other wet cell
//   left        the water that crossed the open side, counted by the engine
//   source      the water the inflows have put in, counted by the engine (a negative compartment)
//
// The compartments are the engine's grid plus its air, so their sum is the engine's own `grid + airborne`, and the
// balance `poured + inflow - left - (reservoir + curtain + pool + river + sunk + soaked)` is the books' residual. The
// water of the initial state (the lake's fill, the river's pre-fill, a `--pour`) is `poured`, so the balance is zero
// to float rounding from the first frame to the last. The sums run in f64 over f32 depths.

use fluidview::HydroSpot;
use ludax::HydroLedger;

use crate::cascade_volumes::CascadeBooks;
use crate::cascade_world::CascadeWorld;

/** The pool compartment's radius, in pool radii. */
const BOOKS_POOL : f32 = 1.5;

/** Reads the books. */
pub class CascadeLedger {
    /** The books of `scene` now. */
    pub static fn read(scene : CascadeWorld) : CascadeBooks {
        let mut b : CascadeBooks = CascadeBooks {};
        let area : f64 = (scene.plan.cell * scene.plan.cell) as f64;
        let pool : HydroSpot = scene.plan.pool;
        let reach : f32 = scene.terrain.pool.radius * BOOKS_POOL;
        for (j of 0..scene.plan.rows) {
            let dz : f32 = scene.plan.z0 + ((j as f32) + (0.5 as f32)) * scene.plan.cell - pool.z;
            for (i of 0..scene.plan.cols) {
                let depth : f32 = scene.world.depthOfCell(i, j);
                if (depth <= (0.0 as f32)) {
                    continue;
                }
                let dx : f32 = scene.plan.x0 + ((i as f32) + (0.5 as f32)) * scene.plan.cell - pool.x;
                let v : f64 = (depth as f64) * area;
                if (scene.lake[((j as i64) * (scene.plan.cols as i64)) + (i as i64)] != (0 as u8)) {
                    b.reservoir = b.reservoir + v;
                } else if (dx * dx + dz * dz < reach * reach) {
                    b.pool = b.pool + v;
                } else {
                    b.river = b.river + v;
                }
            }
        }
        let l : HydroLedger = scene.world.ledger();
        b.curtain = l.airborne;
        b.left = l.outflow;
        b.source = l.inflow;
        b.poured = l.poured;
        b.held = b.reservoir + b.curtain + b.pool + b.river;
        b.balance = l.poured + l.inflow - l.outflow - b.held - l.sunk - l.soaked;
        b.relative = ludax::absD(b.balance) / ludax::maxD(l.poured + l.inflow, 1.0);
        return b;
    }
}

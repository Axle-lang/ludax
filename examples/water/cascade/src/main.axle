// main — cascade: a Niagara-style waterfall into a plunge pool and a meandering river, simulated live and drawn by the vista renderer.
//
// The scene is the generated `HydroTerrain` (`--seed N`) with the `HydroWorld` engine's water on it: a reservoir
// that spills over a cliff into a pool, and a river that carries the water on across a floodplain. `--gravity` and
// `--viscosity` are the engine's own parameters. With `--frame FILE` it draws one picture and exits (`--shot
// wide|pool|river`, `--u` the position along the shot, `--at` simulated seconds, `--samples`, `--size`, `--film N
// --step S`, `--sheet`, `--check-threads`, `--prof`); with `--check` it verifies the physics and prints what it
// measured; with none of those it opens a window.

use fluidview::{Cli, Options};

use crate::cascade_check::CascadeCheck;
use crate::cascade_run::CascadeRun;
use crate::cascade_window::CascadeWindow;

fn main() : i32 {
    let o : Options = Cli::parse();
    if (o.problem.length > 0) {
        println(o.problem);
        println(Cli::usage("cascade"));
        return 2;
    }
    if (o.help) {
        println(Cli::usage("cascade"));
        return 0;
    }
    if (o.check) {
        return CascadeCheck::run(o);
    }
    if (o.frame.length > 0 || o.film > 0 || o.sheet || o.checkThreads) {
        return CascadeRun::run(o);
    }
    return CascadeWindow::run(o);
}

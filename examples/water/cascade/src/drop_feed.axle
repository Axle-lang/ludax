// drop_feed — the engine's airborne particles, copied into the renderer's drop store.
//
// The engine hands over its particles as flat arrays valid until the next step (positions and velocities three
// floats a particle, a radius, a kind byte), in metres from its grid's corner. The renderer's store has the same
// shape, so the copy is four straight loops and no conversion; the store's shift is the grid's world origin, which
// the projection adds. A copy rather than an alias because the store owns its arrays (an alias in a class field
// would be freed twice), and because a frame is drawn while the next step may already run. Kinds other than liquid
// and spray cannot occur any more; anything else would simply not be drawn.

use fluidview::{DropStore, WaterWindow};
use ludax::{HydroWorld, Vec2, HYDRO_AERATED};

/** Metres over the ground within which a particle soaks it: spray lofted higher than this has left the place it fell on. */
const DROP_SOAK_HEIGHT : f32 = 30.0;

/** Copies particles. */
pub class DropFeed {
    /** Sets `store` to the particles `world` holds now, at most the store's capacity; the grid's origin becomes its shift. */
    pub static fn copy(
        world : Shared<HydroWorld>,
        store : Shared<DropStore>,
        window : Shared<WaterWindow>
    ) : void {
        let mut n : i32 = world.particleCount();
        if (n > store.capacity) {
            n = store.capacity;
        }
        let origin : Vec2 = world.origin();
        store.shiftX = origin.x as f32;
        store.shiftZ = origin.y as f32;
        let flat : i64 = (n as i64) * 3;
        for (k of 0..flat) {
            store.positions[k] = world.particlePositions()[k];
            store.velocities[k] = world.particleVelocities()[k];
        }
        for (k of 0..(n as i64)) {
            store.radii[k] = world.particleRadii()[k];
            store.kinds[k] = world.particleKinds()[k];
            store.fade[k] = DropFeed::fade(world, k as i32);
        }
        store.count = n;
        DropFeed::wet(store, window, n);
    }

    // How much of particle `k` is left: froth fades over its life, the other kinds not at all.
    static fn fade(world : Shared<HydroWorld>, k : i32) : f32 {
        let life : f32 = world.particleLives()[k as i64];
        if (world.particleKinds()[k as i64] != HYDRO_AERATED || life <= (0.0 as f32)) {
            return (1.0 as f32);
        }
        return (1.0 as f32) - ludax::saturate(world.particleAges()[k as i64] / life);
    }

    // The ground under falling and flying water is wet: every particle soaks the window cell below it, so the cliff behind
    // a curtain and the banks it sprays are dark. The same value written twice is the same, so the order does not matter.
    static fn wet(store : Shared<DropStore>, window : Shared<WaterWindow>, n : i32) : void {
        for (k of 0..(n as i64)) {
            let i : i32 = ((store.positions[k * 3] as f32) / window.cell) as i32;
            let j : i32 = ((store.positions[k * 3 + 2] as f32) / window.cell) as i32;
            if (i >= 0 && j >= 0 && i < window.w && j < window.d) {
                window.setMoist(i, j, (1.0 as f32));
            }
        }
    }
}

// cascade_plan — where the water window lies over the generated terrain, and the places the scene cares about.
//
// The engine's grid is the water window: one rectangle of fine cells laid over the water the scene shows. It holds the
// whole reservoir (so the water that goes over the lip is the lake's own, and the lake level really falls when the
// inflow is cut), the cliff, the plunge pool and the river down to just before the downstream lake, and is as wide as
// the lake and the meanders plus a margin. The memory budget is the cell count times `PLAN_CELL_BYTES`: the engine's 90
// bytes a cell and the window's 18; a larger `--cell` keeps it in bounds. Sizes are metres.

use fluidview::{HydroSpot, HydroTerrain};
use ludax::{max, min};

/** Metres of margin the window keeps north of the lake's northern shore: the whole lake is in the grid. */
const PLAN_LAKE_MARGIN : f32 = 30.0;

/** Metres either side of the lip's middle the window keeps: the lip's notch and the spillway above it. */
const PLAN_LIP_HALF : f32 = 60.0;

/** Metres of margin around the meanders and the crest, and before the downstream lake. */
const PLAN_SIDE : f32 = 80.0;
const PLAN_END : f32 = 40.0;

/** Bytes a cell costs: the engine's 90 and the window's (bed 4, surface 4, velocity 4, foam, turbulence, moisture). */
pub const PLAN_CELL_BYTES : i64 = 108;

/** The window, and the places on the terrain the scene points at. */
pub struct CascadePlan {
    /** World position of the window's north-west corner, metres. */
    pub x0 : f32 = (0.0 as f32);
    pub z0 : f32 = (0.0 as f32);

    /** Cells across and along, and metres a cell. */
    pub cols : i32 = 1;
    pub rows : i32 = 1;
    pub cell : f32 = (1.5 as f32);

    /** The lip's middle, the plunge pool's middle, the spill, in world metres. */
    pub lip   : HydroSpot = HydroSpot {};
    pub pool  : HydroSpot = HydroSpot {};
    pub spill : HydroSpot = HydroSpot {};

    /** The total of the terrain's inflows into the lake, m3/s. */
    pub inflow : f32 = (0.0 as f32);

    /** Memory the window and the engine take, bytes. */
    pub bytes : i64 = 0;

    /** The plan of `terrain` for cells of `cell` metres. */
    pub static fn over(terrain : HydroTerrain, cell : f32) : CascadePlan {
        let mut lowX : f32 = (1000000.0 as f32);
        let mut highX : f32 = -(1000000.0 as f32);
        for (k of 0..terrain.riverCount) {
            lowX = min(lowX, terrain.river[k as i64].x);
            highX = max(highX, terrain.river[k as i64].x);
        }
        lowX = min(lowX, terrain.escarpment.lip.x - PLAN_LIP_HALF);
        highX = max(highX, terrain.escarpment.lip.x + PLAN_LIP_HALF);
        let spill : HydroSpot = terrain.lake.spill;
        let mut lakeZ : f32 = spill.z;
        for (j of 0..terrain.depth) {
            for (i of 0..terrain.width) {
                if (terrain.lakeMask[((j * terrain.width) + i) as i64] != (0 as u8)) {
                    let x : f32 = ((i as f32) + (0.5 as f32)) * terrain.cellSize;
                    let z : f32 = ((j as f32) + (0.5 as f32)) * terrain.cellSize;
                    lowX = min(lowX, x);
                    highX = max(highX, x);
                    lakeZ = min(lakeZ, z);
                }
            }
        }
        let x0 : f32 = max(lowX - PLAN_SIDE, (0.0 as f32));
        let z0 : f32 = max(lakeZ - PLAN_LAKE_MARGIN, (0.0 as f32));
        let x1 : f32 = min(highX + PLAN_SIDE, terrain.worldWidth());
        let z1 : f32 = min(terrain.outflow.at.z - PLAN_END, terrain.worldDepth());
        let cols : i32 = ((x1 - x0) / cell) as i32 + 1;
        let rows : i32 = ((z1 - z0) / cell) as i32 + 1;
        let mut inflow : f32 = (0.0 as f32);
        for (k of 0..terrain.inflowCount) {
            inflow = inflow + terrain.inflows[k as i64].discharge;
        }
        return CascadePlan {
            x0: x0,
            z0: z0,
            cols: cols,
            rows: rows,
            cell: cell,
            lip: terrain.escarpment.lip,
            pool: terrain.pool.center,
            spill: spill,
            inflow: inflow,
            bytes: (cols as i64) * (rows as i64) * PLAN_CELL_BYTES,
        };
    }
}

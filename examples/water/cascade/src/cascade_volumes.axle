// cascade_volumes — the numbers of the books: the volume of each compartment of the cascade and the balance.
//
// A plain record with no dependencies, so the chart that keeps the history and the ledger that reads the engine can both
// use it without importing each other or the world. See `cascade_books` for what each compartment is.

/** The volume of each compartment, m3, and the books' balance. */
pub struct CascadeBooks {
    /** Water in the reservoir cells. */
    pub reservoir : f64 = 0.0;

    /** Water in the air. */
    pub curtain : f64 = 0.0;

    /** Water in the plunge pool. */
    pub pool : f64 = 0.0;

    /** Water in the rest of the grid: the river and what is on the ground. */
    pub river : f64 = 0.0;

    /** Water that left through the open side so far. */
    pub left : f64 = 0.0;

    /** Water the inflows put in so far. */
    pub source : f64 = 0.0;

    /** Water that was poured in: the initial state and every `pour`. */
    pub poured : f64 = 0.0;

    /** What the grid and the air hold: reservoir + curtain + pool + river. */
    pub held : f64 = 0.0;

    /** `poured + source - left - held - sunk - soaked`: zero when the books close. */
    pub balance : f64 = 0.0;

    /** `|balance|` over `poured + source`. */
    pub relative : f64 = 0.0;
}

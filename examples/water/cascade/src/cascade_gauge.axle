// cascade_gauge — the flow meters of the cascade: discharge across a row of the water window, and the wet area.
//
// The engine's books say how much water went where in total; these say what is flowing through a place right now.
// A row's discharge is the sum over its cells of the discharge per metre along z times the cell width. The
// cell-centred discharge is within a few percent in a straight reach and the checks use rows in straight reaches
// (above the lip and below the pool); the engine's face meters are the exact ones where a bend matters. The wet area
// counts cells holding more than a film.

use fluidview::RiverPoint;
use ludax::Vec2;

use crate::cascade_world::CascadeWorld;

/** Metres of water a cell must hold to count as wet. */
const GAUGE_WET : f32 = 0.02;

/** Metres above the lip the spillway gauge reads, and below the pool the river gauge reads. */
const GAUGE_ABOVE_LIP : f32 = 10.0;
const GAUGE_BELOW_POOL : f32 = 30.0;

/** Metres either side of the lip's middle the lip gauge reads: the notch the lake spills through. */
const GAUGE_NOTCH : f32 = 45.0;

/** Metres either side of the channel a section reaches. */
const GAUGE_MARGIN : f32 = 4.0;

/** Flow meters. */
pub class CascadeGauge {
    /** The window column at world x `x`, clamped. */
    pub static fn columnAt(scene : CascadeWorld, x : f32) : i32 {
        let col : i32 = ((x - scene.plan.x0) / scene.plan.cell) as i32;
        if (col < 0) {
            return 0;
        }
        if (col >= scene.plan.cols) {
            return scene.plan.cols - 1;
        }
        return col;
    }

    /** The discharge, m3/s, across the window row `row` between the world x `from` and `to`, toward +z. */
    pub static fn across(scene : CascadeWorld, row : i32, from : f32, to : f32) : f32 {
        let mut total : f32 = (0.0 as f32);
        for (i of CascadeGauge::columnAt(scene, from)..(CascadeGauge::columnAt(scene, to) + 1)) {
            total = total + scene.world.dischargeZOfCell(i, row) * scene.plan.cell;
        }
        return total;
    }

    /** The row of the window at world z `z`, clamped. */
    pub static fn rowAt(scene : CascadeWorld, z : f32) : i32 {
        let row : i32 = ((z - scene.plan.z0) / scene.plan.cell) as i32;
        if (row < 0) {
            return 0;
        }
        if (row >= scene.plan.rows) {
            return scene.plan.rows - 1;
        }
        return row;
    }

    /** The discharge over the lip: across the spillway a few metres above it. */
    pub static fn lip(scene : CascadeWorld) : f32 {
        return CascadeGauge::across(
            scene,
            CascadeGauge::rowAt(scene, scene.plan.lip.z - GAUGE_ABOVE_LIP),
            scene.plan.lip.x - GAUGE_NOTCH,
            scene.plan.lip.x + GAUGE_NOTCH
        );
    }

    /**
     * The discharge of the river across the section perpendicular to its record `k`: the sum over samples a cell apart
     * of the depth times the speed along the river, over the bankfull width and a margin.
     */
    pub static fn section(scene : CascadeWorld, k : i32) : f32 {
        let p : RiverPoint = scene.terrain.river[k as i64];
        let half : f32 = p.width * (0.5 as f32) + GAUGE_MARGIN;
        let samples : i32 = ((2.0 as f32) * half / scene.plan.cell) as i32;
        let mut total : f32 = (0.0 as f32);
        for (s of 0..samples) {
            let t : f32 = (0.0 as f32) - half + ((s as f32) + (0.5 as f32)) * scene.plan.cell;
            let x : f32 = p.x + p.dirZ * t - scene.plan.x0;
            let z : f32 = p.z - p.dirX * t - scene.plan.z0;
            let v : Vec2 = scene.world.surfaceVelocityAt(x, z);
            total = total + scene.world.depthAt(x, z) * (v.x * p.dirX + v.y * p.dirZ) * scene.plan.cell;
        }
        return total;
    }

    /** The first river record this far south of the pool's middle, metres. */
    pub static fn recordBelowPool(scene : CascadeWorld, below : f32) : i32 {
        for (k of 0..scene.terrain.riverCount) {
            if (scene.terrain.river[k as i64].z >= scene.plan.pool.z + below) {
                return k;
            }
        }
        return scene.terrain.riverCount - 1;
    }

    /** The discharge of the river below the pool. */
    pub static fn river(scene : CascadeWorld) : f32 {
        return CascadeGauge::section(scene, CascadeGauge::recordBelowPool(scene, GAUGE_BELOW_POOL));
    }

    /** The number of wet cells of the window. */
    pub static fn wetCells(scene : CascadeWorld) : i32 {
        let mut count : i32 = 0;
        for (j of 0..scene.plan.rows) {
            for (i of 0..scene.plan.cols) {
                if (scene.world.depthOfCell(i, j) > GAUGE_WET) {
                    count = count + 1;
                }
            }
        }
        return count;
    }

    /** The wet area, m2. */
    pub static fn wetArea(scene : CascadeWorld) : f32 {
        return (CascadeGauge::wetCells(scene) as f32) * scene.plan.cell * scene.plan.cell;
    }
}

// cascade_shots — where the camera stands in the real scene: a wide shot, a low shot at the pool, a river flight.
//
// All three are pure functions of a number in 0 to 1 and of the generated terrain, so a film and a sheet of times can
// ask for any moment and get the same picture on every run. The wide shot is a slow arc on the floodplain's side
// facing the fall; the pool shot stands on the pool's south shore with the curtain filling the view; the river flight
// follows the river's records downstream a little above the water, looking a hundred metres ahead. Eyes are kept a
// minimum height above the ground so a camera never ends up inside a hill.

use fluidview::{HydroTerrain, RiverPoint, VistaCamera, WaterCamera};
use ludax::{cos, max, sin, Vec3};

use crate::cascade_plan::CascadePlan;

/** The camera paths. */
pub enum CascadeShot : i8 {
    /** The valley from the south, the fall in its mountain frame. */
    Wide,

    /** Low at the plunge pool, looking up at the curtain. */
    Pool,

    /** Along the river, downstream, over the meanders. */
    River,

    /** Close to the curtain, level with its middle. */
    Curtain,

    /** Close to the plunge pool's crown of spray, a little above the water. */
    Crown,
}

// The wide arc: its radius from the lip along z and x, height above the crest, and the angles it sweeps.
const SHOT_WIDE_Z : f32 = 620.0;
const SHOT_WIDE_X : f32 = 480.0;
const SHOT_WIDE_UP : f32 = 70.0;
const SHOT_WIDE_FROM : f32 = 0.7;
const SHOT_WIDE_SWEEP : f32 = 0.5;

// The pool shot: distance south of the pool and sideways, height above the water, the sweep of the angle.
const SHOT_POOL_Z : f32 = 120.0;
const SHOT_POOL_X : f32 = 70.0;
const SHOT_POOL_UP : f32 = 10.0;
const SHOT_POOL_FROM : f32 = 0.2;
const SHOT_POOL_SWEEP : f32 = 0.7;

// The flight: height above the water, how many river points ahead it looks, and the points it never starts the last of.
const SHOT_FLIGHT_UP : f32 = 15.0;
const SHOT_FLIGHT_AHEAD : i32 = 40;

// The close shots: metres south of the pool the curtain shot and the crown shot stand, the sideways swing, and the share of the fall's height they aim at.
const SHOT_CURTAIN_BACK : f32 = 70.0;
const SHOT_CROWN_BACK : f32 = 55.0;
const SHOT_CLOSE_SIDE : f32 = 80.0;
const SHOT_CLOSE_AIM : f32 = 0.45;

// The least height an eye keeps over the ground, metres.
const SHOT_CLEARANCE : f32 = 6.0;

/** Cameras of the real scene. */
pub class CascadeShots {
    /** The camera of `shot` at position `u` (0 to 1) along its path, for a picture `width` by `height`. */
    pub static fn at(
        shot : CascadeShot,
        u : f32,
        t : HydroTerrain,
        plan : CascadePlan,
        width : i32,
        height : i32
    ) : WaterCamera {
        return match shot {
            CascadeShot::Wide => CascadeShots::wide(u, t, plan, width, height),
            CascadeShot::Pool => CascadeShots::pool(u, t, plan, width, height),
            CascadeShot::River => CascadeShots::river(u, t, width, height),
            CascadeShot::Curtain => CascadeShots::close(
                u,
                t,
                plan,
                SHOT_CURTAIN_BACK,
                (0.5 as f32),
                width,
                height
            ),
            CascadeShot::Crown => CascadeShots::close(
                u,
                t,
                plan,
                SHOT_CROWN_BACK,
                (0.08 as f32),
                width,
                height
            ),
        };
    }

    // An eye at (`x`, `z`) at least `up` over the ground there, and over `floor`.
    static fn eye(t : HydroTerrain, x : f32, z : f32, up : f32, floor : f32) : Vec3 {
        return Vec3 {
            x: x,
            y: max(t.heightAt(x, z) + SHOT_CLEARANCE, max(floor, t.heightAt(x, z) + up)),
            z: z,
        };
    }

    // A close shot: `back` metres south of the lip's foot, at `share` of the fall's height above the foot, looking at the
    // foot of the curtain; `u` swings it a little to the side.
    static fn close(
        u : f32,
        t : HydroTerrain,
        plan : CascadePlan,
        back : f32,
        share : f32,
        width : i32,
        height : i32
    ) : WaterCamera {
        let x : f32 = plan.lip.x + SHOT_CLOSE_SIDE * (u - (0.5 as f32));
        let z : f32 = plan.pool.z + back;
        let eye : Vec3 = Vec3 {
            x: x,
            y: t.escarpment.footHeight + share * t.escarpment.fall + (4.0 as f32),
            z: z,
        };
        let target : Vec3 = Vec3 {
            x: plan.lip.x,
            y: t.escarpment.footHeight + SHOT_CLOSE_AIM * t.escarpment.fall,
            z: plan.lip.z + (10.0 as f32),
        };
        return VistaCamera::lookAt(eye, target, width, height);
    }

    static fn wide(u : f32, t : HydroTerrain, plan : CascadePlan, width : i32, height : i32) : WaterCamera {
        let angle : f32 = SHOT_WIDE_FROM + SHOT_WIDE_SWEEP * u;
        let x : f32 = plan.lip.x + SHOT_WIDE_X * (sin(angle) - (0.7 as f32));
        let z : f32 = plan.lip.z + SHOT_WIDE_Z * cos(angle);
        let eye : Vec3 = CascadeShots::eye(t, x, z, SHOT_WIDE_UP, t.escarpment.crestHeight + SHOT_WIDE_UP);
        let target : Vec3 = Vec3 {
            x: plan.lip.x,
            y: t.escarpment.footHeight + (0.55 as f32) * t.escarpment.fall,
            z: plan.lip.z,
        };
        return VistaCamera::lookAt(eye, target, width, height);
    }

    static fn pool(u : f32, t : HydroTerrain, plan : CascadePlan, width : i32, height : i32) : WaterCamera {
        let angle : f32 = SHOT_POOL_FROM + SHOT_POOL_SWEEP * u;
        let x : f32 = plan.pool.x + SHOT_POOL_X * (sin(angle) - (0.4 as f32));
        let z : f32 = plan.pool.z + SHOT_POOL_Z + (30.0 as f32) * cos(angle);
        let eye : Vec3 = CascadeShots::eye(t, x, z, SHOT_POOL_UP, t.pool.level + SHOT_POOL_UP);
        let target : Vec3 = Vec3 {
            x: plan.lip.x,
            y: t.escarpment.footHeight + (0.7 as f32) * t.escarpment.fall,
            z: plan.lip.z,
        };
        return VistaCamera::lookAt(eye, target, width, height);
    }

    static fn river(u : f32, t : HydroTerrain, width : i32, height : i32) : WaterCamera {
        let last : i32 = t.riverCount - 1 - SHOT_FLIGHT_AHEAD;
        let k : i32 = (u * (last as f32)) as i32;
        let here : RiverPoint = t.river[k as i64];
        let ahead : RiverPoint = t.river[(k + SHOT_FLIGHT_AHEAD) as i64];
        let eye : Vec3 = Vec3 { x: here.x, y: here.bedHeight + here.depth + SHOT_FLIGHT_UP, z: here.z };
        let target : Vec3 = Vec3 { x: ahead.x, y: ahead.bedHeight + ahead.depth + (1.0 as f32), z: ahead.z };
        return VistaCamera::lookAt(eye, target, width, height);
    }
}

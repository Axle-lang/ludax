// cascade_chart — the history of the books as a chart in which the total is a flat line.
//
// Each sample records how every compartment's volume has changed since the first one: reservoir, curtain, pool, river,
// the water that left the grid, and the water the inflows put in (counted negative, since it is a source). The six
// changes add up to the balance of the books, which is zero (the engine conserves mass), so the chart stacks the
// positive changes above the axis and the negative ones below it and draws the sum, a white line that stays on the
// axis however much water moves from one compartment to another. The vertical scale follows the largest change seen.
// The history is a ring of fixed length filled every `CHART_EVERY` simulated seconds; nothing allocates per frame.

use smalt::{Color, Frame, Rect};

use crate::cascade_volumes::CascadeBooks;

/** Series in the chart. */
pub const CHART_SERIES : i32 = 6;

/** Samples the history keeps, and the simulated seconds between two of them. */
pub const CHART_SAMPLES : i32 = 240;
pub const CHART_EVERY : f32 = 0.5;

/** Chart size, pixels. */
pub const CHART_WIDTH : i32 = 288;
pub const CHART_HEIGHT : i32 = 120;

/** The history. */
pub class BooksChart {
    // Changes since the first sample, CHART_SERIES floats a sample, in a ring.
    changes : f32[];
    first   : CascadeBooks = CascadeBooks {};
    seen    : bool = false;
    count   : i32 = 0;
    last    : f32 = -(1000000.0 as f32);

    /** An empty history. */
    constructor() {
        self.changes = new f32[(CHART_SAMPLES as i64) * (CHART_SERIES as i64)];
    }

    /** True when a sample is due at simulated second `time` (the first one always is). */
    pub fn due(self, time : f32) : bool {
        return !self.seen || time - self.last >= CHART_EVERY;
    }

    /** Records `books` at simulated second `time` if `CHART_EVERY` has passed since the last sample. */
    pub fn push(mut self, time : f32, books : CascadeBooks) : void {
        if (!self.seen) {
            self.first = books;
            self.seen = true;
        }
        if (time - self.last < CHART_EVERY) {
            return;
        }
        self.last = time;
        let slot : i64 = ((self.count % CHART_SAMPLES) as i64) * (CHART_SERIES as i64);
        self.changes[slot] = (books.reservoir - self.first.reservoir) as f32;
        self.changes[slot + 1] = (books.curtain - self.first.curtain) as f32;
        self.changes[slot + 2] = (books.pool - self.first.pool) as f32;
        self.changes[slot + 3] = (books.river - self.first.river) as f32;
        self.changes[slot + 4] = (books.left - self.first.left) as f32;
        self.changes[slot + 5] = (0.0 as f32) - ((books.source - self.first.source) as f32);
        self.count = self.count + 1;
    }

    static fn most(a : i32, b : i32) : i32 {
        if (a > b) {
            return a;
        }
        return b;
    }

    static fn least(a : i32, b : i32) : i32 {
        if (a < b) {
            return a;
        }
        return b;
    }

    // The change of series `k` at the `i`-th oldest kept sample.
    fn at(self, i : i32, k : i32) : f32 {
        let oldest : i32 = BooksChart::most(self.count - CHART_SAMPLES, 0);
        let slot : i64 = (((oldest + i) % CHART_SAMPLES) as i64) * (CHART_SERIES as i64);
        return self.changes[slot + (k as i64)];
    }

    /** Draws the chart with its top-left corner at (`x`, `y`) on `frame`. */
    pub fn draw(self, frame : Frame, x : i32, y : i32) : void {
        frame.fillRect(Rect { x: x, y: y, w: CHART_WIDTH, h: CHART_HEIGHT }, Color::packBytes(18, 22, 30));
        let kept : i32 = BooksChart::least(self.count, CHART_SAMPLES);
        if (kept < 2) {
            return;
        }
        let mut scale : f32 = (1.0 as f32);
        for (i of 0..kept) {
            let mut up : f32 = (0.0 as f32);
            let mut down : f32 = (0.0 as f32);
            for (k of 0..CHART_SERIES) {
                let v : f32 = self.at(i, k);
                if (v > (0.0 as f32)) {
                    up = up + v;
                } else {
                    down = down - v;
                }
            }
            scale = ludax::max(scale, ludax::max(up, down));
        }
        let axis : i32 = y + CHART_HEIGHT / 2;
        let half : f32 = ((CHART_HEIGHT / 2) - 2) as f32;
        for (col of 0..CHART_WIDTH) {
            let i : i32 = (col * kept) / CHART_WIDTH;
            let mut top : f32 = (0.0 as f32);
            let mut bottom : f32 = (0.0 as f32);
            for (k of 0..CHART_SERIES) {
                let v : f32 = self.at(i, k);
                let h : f32 = v / scale * half;
                if (v > (0.0 as f32)) {
                    BooksChart::band(frame, x + col, axis - ((top + h) as i32), axis - (top as i32), k);
                    top = top + h;
                } else {
                    BooksChart::band(frame, x + col, axis + (bottom as i32), axis + ((bottom - h) as i32), k);
                    bottom = bottom - h;
                }
            }
        }
        frame.fillRect(Rect { x: x, y: axis, w: CHART_WIDTH, h: 1 }, Color::packBytes(255, 255, 255));
    }

    // A vertical run of one pixel column from `from` down to `to` in the ink of series `k`.
    static fn band(frame : Frame, x : i32, from : i32, to : i32, k : i32) : void {
        if (to <= from) {
            return;
        }
        frame.fillRect(Rect { x: x, y: from, w: 1, h: to - from }, BooksChart::ink(k));
    }

    /** The ink of series `k`. */
    pub static fn ink(k : i32) : i32 {
        return match k {
            0 => Color::packBytes(50, 100, 210),
            1 => Color::packBytes(235, 240, 245),
            2 => Color::packBytes(70, 200, 210),
            3 => Color::packBytes(70, 170, 90),
            4 => Color::packBytes(160, 160, 160),
            _ => Color::packBytes(235, 150, 50),
        };
    }
}

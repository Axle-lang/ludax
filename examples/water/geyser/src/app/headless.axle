// headless — the modes of the geyser that finish without a window.
//
// `--ticks N` advances the simulation and prints its state; `--frame FILE` advances it (by default to the
// middle of the second eruption, where the plume is up and the pool has visibly drained) and writes the same
// picture the window would show, through the identical `GxView::picture`. The BMP is the visual gate: the
// plume's height, the drained pool and the pressure readout must be legible in it. `--check` is the numeric one.

use fluidview::{Options, Stage};

use crate::gfx::scene::GxView;
use crate::sim::geyser::GeyserSim;

/** Eruptions a default `--frame` run waits for: the first starts from an empty chamber. */
const GY_HEADLESS_ERUPTIONS : i32 = 2;

/** Ticks into the eruption the default picture is taken at. */
const GY_HEADLESS_INTO : i32 = 100;

/** Ticks a default run gives up after, if the geyser never erupts (a broken engine, not a long cycle). */
const GY_HEADLESS_LIMIT : i32 = 20000;

/** The headless front end. */
pub class GeyserHeadless {
    /** Simulates to `o.ticks` (or into the second eruption) and writes the picture to `o.frame`. */
    pub static fn runFrame(o : Options) : i32 {
        let sim : GeyserSim = new GeyserSim();
        if (o.ticks > 0) {
            GeyserHeadless::advance(sim, o.ticks);
        } else if (!GeyserHeadless::intoEruption(sim)) {
            println("geyser: it never erupted");
            return 1;
        }
        GeyserHeadless::report(sim);

        let stage : Stage = new Stage(GxView::orbit(), GxView::fog());
        defer stage.close();
        let view : GxView = new GxView();
        view.picture(stage, sim, false);
        if (stage.write(o.frame)) {
            return 0;
        }
        return 1;
    }

    /** Advances `o.ticks` ticks and prints the state; no picture, no window. */
    pub static fn runTicks(o : Options) : i32 {
        let sim : GeyserSim = new GeyserSim();
        GeyserHeadless::advance(sim, o.ticks);
        GeyserHeadless::report(sim);
        return 0;
    }

    static fn advance(sim : GeyserSim, ticks : i32) : void {
        for (i of 0..ticks) {
            sim.tick();
        }
    }

    // Runs to a fixed time into the second eruption; false if the geyser never gets there.
    static fn intoEruption(sim : GeyserSim) : bool {
        let mut guard : i32 = 0;
        while (sim.chamberRef().eruptions() < GY_HEADLESS_ERUPTIONS) {
            sim.tick();
            guard = guard + 1;
            if (guard > GY_HEADLESS_LIMIT) {
                return false;
            }
        }
        GeyserHeadless::advance(sim, GY_HEADLESS_INTO);
        return true;
    }

    static fn report(sim : GeyserSim) : void {
        let seconds : f64 = sim.seconds();
        let head : f64 = sim.chamberRef().head();
        let volume : f64 = sim.volume();
        let flying : f64 = sim.sprayRef().volumeInFlight();
        let check : f64 = sim.imbalance();
        println("geyser: ${sim.tickCount()} ticks (${seconds} s), ${sim.phaseName()}, head ${head}, pool ${volume}, in flight ${flying}, check ${check}");
    }
}

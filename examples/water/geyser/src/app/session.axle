// session — the interactive geyser: a window and one simulation tick a frame.
//
// The window, the camera controls and the pacing are the shared viewer's. Each frame this loop advances the
// geyser exactly one tick, so simulation time is ticks times `GY_DT` and nothing reads a wall clock, then
// draws and presents. A slow frame slows the demo rather than skipping it: the cycle's pace is the point.

use fluidview::{Viewer, ViewerDesc};
use smalt::PlatformError;

use crate::gfx::scene::GxView;
use crate::sim::geyser::GeyserSim;

/** The interactive session. */
pub class GeyserSession {
    /** Opens the window and runs until the player quits; answers the exit code. */
    pub static fn run() : i32 {
        try {
            return GeyserSession::play();
        } catch e : PlatformError {
            println(e.message);
            return 1;
        }
    }

    static fn play() : i32 ! PlatformError {
        let view = new Viewer(ViewerDesc {
            title: "Geyser",
            shot: "geyser.bmp",
            orbit: GxView::orbit(),
            fog: GxView::fog(),
        });
        defer view.close();
        let picture : GxView = new GxView();
        let sim : GeyserSim = new GeyserSim();

        while (view.pump()) {
            if (!view.paused()) {
                sim.tick();
            }
            if (view.visible()) {
                picture.picture(view.stage, sim, view.paused());
                view.present();
            }
        }
        return 0;
    }
}

// main — geyser, a column-fluid geyser that erupts when its chamber pressure gives way.
//
// A pool over a hidden pressure chamber: the chamber fills from the pool, bursts at a threshold pressure,
// throws its water out at Torricelli's speed and shuts again, with nothing on a timer. The window shows it in
// a hand-rolled 3-D painter; `--frame FILE` renders a headless BMP mid-eruption, `--ticks N` advances the
// simulation without a window, and `--check` verifies the physics and exits with the number of claims that
// failed.

use fluidview::{Cli, Options};

use crate::app::check::GeyserCheck;
use crate::app::headless::GeyserHeadless;
use crate::app::session::GeyserSession;

fn main() : i32 {
    let o : Options = Cli::parse();
    if (o.problem.length > 0) {
        println(o.problem);
        println(Cli::usage("geyser"));
        return 2;
    }
    if (o.help) {
        println(Cli::usage("geyser"));
        return 0;
    }

    // The modes are exclusive: the numeric check, a picture, bare ticks, then the window.
    if (o.check) {
        return GeyserCheck::run();
    }
    if (o.frame.length > 0) {
        return GeyserHeadless::runFrame(o);
    }
    if (o.ticks > 0) {
        return GeyserHeadless::runTicks(o);
    }
    return GeyserSession::run();
}

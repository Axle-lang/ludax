// spray_view — the geyser's particles as billboards: droplets with a trail, and bubbles.
//
// All of it is screen-space squares pushed into the painter, which sorts them with everything else. Droplets
// are a bright core and ghosts back along their velocity, which is what makes a trajectory read as a line;
// bubbles are bright-rimmed discs that wobble. A pure read of the spray: nothing here changes the simulation.

use fluidview::{Brush, Proj};
use ludax::{sin, Vec3};

use crate::sim::geyser::GeyserSim;
use crate::sim::spray::{GeyserSpray, GxBubble, GxDrop};

/** Albedo of a bubble. */
const GY_BUBBLE_RGB : i32 = 0xbfe4f2;

/** Alpha of a bubble's body. */
const GY_BUBBLE_ALPHA : i32 = 130;

/** Alpha of a bubble's bright core. */
const GY_BUBBLE_RIM_ALPHA : i32 = 210;

/** World radius of a bubble, cells. */
const GY_BUBBLE_WORLD : f32 = 0.14;

/** Albedo of a droplet. */
const GY_DROP_RGB : i32 = 0xdaeefc;

/** Alpha of a droplet's core. */
const GY_DROP_ALPHA : i32 = 235;

/** World radius of a droplet, cells. */
const GY_DROP_WORLD : f32 = 0.1;

/** Smallest a droplet is drawn, pixels. */
const GY_DROP_PX_MIN : f32 = 2.0;

/** Largest a droplet is drawn, pixels. */
const GY_DROP_PX_MAX : f32 = 4.0;

/** Ghosts behind a droplet along its velocity. */
const GY_DROP_TRAIL : i32 = 3;

/** Seconds of travel between a droplet's ghosts. */
const GY_TRAIL_STEP : f32 = 0.06;

/** A bubble wobbles by this share of a radian's sine, in pixels, as its phase advances with depth. */
const GY_BUBBLE_SWAY : f32 = 0.5;

/** A bubble's world radius is seen across half the depth, so the pixel size stays small beside a droplet's. */
const GY_BUBBLE_DEPTH_SHARE : f32 = 0.5;

/** The bright core of a bubble is this share of its body. */
const GY_BUBBLE_CORE : f32 = 0.55;

/** Draws the geyser's particles; all of its state is the arguments. */
pub class GxSprayView {
    /** Pushes the bubbles and droplets of `sim` through `b`. */
    pub static fn draw(b : Brush, sim : GeyserSim) : void {
        let spray : GeyserSpray = sim.sprayRef();
        GxSprayView::bubbles(b, spray);
        GxSprayView::drops(b, spray);
    }

    // The plume's bubbles: small bright-rimmed discs wobbling upward through the water.
    static fn bubbles(b : Brush, spray : GeyserSpray) : void {
        for (i of 0..spray.bubbleCount()) {
            let bub : GxBubble = spray.bubbleAt(i);
            let at : Proj = b.cam.project(Vec3::make(bub.x, bub.y, bub.z));
            if (!at.ok) {
                continue;
            }
            let wobble : f32 = sin(bub.phase + at.depth) * GY_BUBBLE_SWAY;
            let size : f32 = GY_BUBBLE_WORLD * b.cam.focalLen() / (at.depth * GY_BUBBLE_DEPTH_SHARE) + wobble;
            b.painter.pushBillboard(at, size, GY_BUBBLE_RGB, GY_BUBBLE_ALPHA);
            b.painter.pushBillboard(at, size * GY_BUBBLE_CORE, GY_BUBBLE_RGB, GY_BUBBLE_RIM_ALPHA);
        }
    }

    // The droplets: a bright core and ghosts back along the velocity.
    static fn drops(b : Brush, spray : GeyserSpray) : void {
        for (i of 0..spray.dropCount()) {
            let d : GxDrop = spray.dropAt(i);
            let at : Proj = b.cam.project(Vec3::make(d.x, d.y, d.z));
            if (!at.ok) {
                continue;
            }
            b.painter.pushBillboard(at, GxSprayView::dropPx(b, at.depth), GY_DROP_RGB, GY_DROP_ALPHA);

            for (k of 1..(GY_DROP_TRAIL + 1)) {
                let back : f32 = (k as f32) * GY_TRAIL_STEP;
                let behind : Vec3 = Vec3::make(d.x - d.vx * back, d.y - d.vy * back, d.z - d.vz * back);
                let ghost : Proj = b.cam.project(behind);
                if (ghost.ok) {
                    let size : f32 = GxSprayView::dropPx(b, ghost.depth);
                    b.painter.pushBillboard(ghost, size, GY_DROP_RGB, GY_DROP_ALPHA / (k + 1));
                }
            }
        }
    }

    // A droplet's on-screen half-size: its world radius through the projection, clamped to readable pixels.
    static fn dropPx(b : Brush, depth : f32) : f32 {
        let mut px : f32 = GY_DROP_WORLD * b.cam.focalLen() / depth;
        if (px < GY_DROP_PX_MIN) {
            px = GY_DROP_PX_MIN;
        }
        if (px > GY_DROP_PX_MAX) {
            px = GY_DROP_PX_MAX;
        }
        return px;
    }
}

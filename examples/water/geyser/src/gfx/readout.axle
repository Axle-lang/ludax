// readout — what the geyser's HUD says, and where.
//
// The claim is that pressure becomes height, so the pressure leads: the chamber's head against the head that
// opens the vent, the speed it leaves at, and the height the jet reaches in theory (`v^2 / 2g`), which is what
// the plume in the picture should match. Under them come the pool and the water in flight, and the
// conservation check (pool plus chamber plus droplets minus what the spring injected stays at the rounding).
// This file owns the arrangement; the `Hud` class owns how ink lands.

use fluidview::{Hud, Pen, HUD_ACCENT, HUD_DIM, HUD_LEADING, HUD_MARGIN, HUD_TITLE_SCALE};
use smalt::Frame;

use crate::sim::chamber::{GeyserChamber, GY_HEAD_BURST};
use crate::sim::geyser::GeyserSim;
use crate::sim::spray::GeyserSpray;

/** x of the second column of figures. */
const GYRO_COL2 : i32 = 170;

/** The first row of figures sits this far below the title, pixels. */
const GYRO_FIGURES_DROP : i32 = 30;

/** Draws the geyser's HUD onto the scaled frame; `paused` adds the badge. */
pub fn gxHudDraw(h : Hud, f : Frame, sim : GeyserSim, paused : bool) : void {
    let chamber : GeyserChamber = sim.chamberRef();
    let spray : GeyserSpray = sim.sprayRef();

    let head : Pen = Pen::at(HUD_MARGIN, HUD_MARGIN, HUD_ACCENT);
    h.text(f, head.scaled(HUD_TITLE_SCALE), sim.phaseName());

    let row2 : i32 = HUD_MARGIN + GYRO_FIGURES_DROP;
    h.fixed(f, Pen::at(HUD_MARGIN, row2, HUD_ACCENT), "pressure ", chamber.head(), 1);
    h.fixed(f, Pen::at(GYRO_COL2, row2, HUD_DIM), "bursts at ", GY_HEAD_BURST, 1);

    let row3 : i32 = row2 + HUD_LEADING;
    h.fixed(f, Pen::at(HUD_MARGIN, row3, HUD_DIM), "exit speed ", sim.jetSpeed(), 1);
    h.fixed(f, Pen::at(GYRO_COL2, row3, HUD_DIM), "jet height ", sim.jetHeight(), 1);

    let row4 : i32 = row3 + HUD_LEADING;
    h.fixed(f, Pen::at(HUD_MARGIN, row4, HUD_DIM), "pool ", sim.volume(), 1);
    h.fixed(f, Pen::at(GYRO_COL2, row4, HUD_DIM), "in flight ", spray.volumeInFlight(), 1);

    let row5 : i32 = row4 + HUD_LEADING;
    h.whole(f, Pen::at(HUD_MARGIN, row5, HUD_DIM), "eruptions ", chamber.eruptions() as i64);
    h.fixed(f, Pen::at(GYRO_COL2, row5, HUD_DIM), "check ", sim.imbalance(), 4);

    let row6 : i32 = row5 + HUD_LEADING;
    h.fixed(f, Pen::at(HUD_MARGIN, row6, HUD_DIM), "time ", sim.seconds(), 1);

    h.chrome(f, paused);
}

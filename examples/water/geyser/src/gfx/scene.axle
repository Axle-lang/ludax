// scene — the geyser's picture: crater terrain, the pool's water sheet, and the spray above it.
//
// The terrain and the water are the shared ones (a sandy crater, deep blue pool); the plume is the geyser's
// own and lives in `spray_view`. One painter sorts everything by depth, so a nearer drop correctly hides the
// droplets behind it. The scene is a pure read of the simulation; it never mutates the world.

use fluidview::{CamOrbit, Fog, LandStyle, Landscape, Stage, WaterSheet, WaterStyle};
use ludax::{FluidWorld, Vec3};
use smalt::Color;

use crate::gfx::readout::gxHudDraw;
use crate::gfx::spray_view::GxSprayView;
use crate::sim::geyser::{GeyserSim, GY_GRID};

/** Ground height the albedo ramp starts at, cells. */
const GY_H_LO : f32 = -2.5;

/** Ground height the albedo ramp ends at, cells. */
const GY_H_HI : f32 = 4.5;

/** Fog starts at this view depth. */
const GY_FOG_NEAR : f32 = 40.0;

/** Fog is complete at this view depth. */
const GY_FOG_FAR : f32 = 110.0;

/** How far the fog ever goes. */
const GY_FOG_MAX : f32 = 0.7;

/** Water this deep counts as fully deep, cells. */
const GY_WATER_DEEP : f32 = 1.0;

/** Middle of the crater, which the camera circles, cells. */
const GY_VIEW_CENTER : f32 = 32.0;

/** The camera's orbit target stands this high above the ground plane, cells. */
const GY_VIEW_TARGET_Y : f32 = 1.0;

/** The camera starts this far from its target, cells. */
const GY_VIEW_DIST : f32 = 46.0;

/** The camera starts at this heading round the target, radians. */
const GY_VIEW_YAW : f32 = 0.8;

/** The camera starts looking down at this angle, radians. */
const GY_VIEW_PITCH : f32 = 0.5;

/** The albedo of the ground at the bottom of the height ramp, linear. */
const GY_ROCK_LOW_R : f32 = 0.4;
const GY_ROCK_LOW_G : f32 = 0.34;
const GY_ROCK_LOW_B : f32 = 0.28;

/** The albedo of the ground at the top of the height ramp, linear. */
const GY_ROCK_HIGH_R : f32 = 0.58;
const GY_ROCK_HIGH_G : f32 = 0.55;
const GY_ROCK_HIGH_B : f32 = 0.5;

/** The packed colour of the cut walls of the terrain, and the darkest they are shaded to. */
const GY_WALL : i32 = 0x4d4438;
const GY_WALL_MIN : f32 = 0.3;

/** The water's colour where it is shallow, linear. */
const GY_SHALLOW_R : f32 = 0.3;
const GY_SHALLOW_G : f32 = 0.75;
const GY_SHALLOW_B : f32 = 0.85;

/** The water's colour where it is deep, linear. */
const GY_DEEP_R : f32 = 0.04;
const GY_DEEP_G : f32 = 0.22;
const GY_DEEP_B : f32 = 0.55;

/** The alpha of the thinnest sheet of water, 0 to 255. */
const GY_WATER_ALPHA : i32 = 205;

/** The thinnest sheet that is drawn at all, cells of depth. */
const GY_SHEET_MIN : f32 = 0.08;

/** How much of the sun's light a film of water on the ground reflects. */
const GY_FILM_LIT : f32 = 0.95;

/** The geyser's picture over a stage. */
pub class GxView {
    water : WaterSheet;

    /** A view for the world of the demo. */
    constructor() {
        self.water = new WaterSheet(GY_GRID, GY_GRID);
    }

    /** The distance fog of the scene. */
    pub static fn fog() : Fog {
        return Fog { near: GY_FOG_NEAR, far: GY_FOG_FAR, max: GY_FOG_MAX };
    }

    /** Where the camera starts: low and close enough to see the whole column. */
    pub static fn orbit() : CamOrbit {
        return CamOrbit {
            target: Vec3 { x: GY_VIEW_CENTER, y: GY_VIEW_TARGET_Y, z: GY_VIEW_CENTER },
            dist: GY_VIEW_DIST,
            yaw: GY_VIEW_YAW,
            pitch: GY_VIEW_PITCH,
        };
    }

    /** One whole frame: scene, rasterisation, HUD. The window and the BMP writer both call this. */
    pub fn picture(mut self, stage : Stage, sim : GeyserSim, paused : bool) : void {
        let world : FluidWorld = sim.worldRef();
        stage.begin();
        Landscape::draw(stage.brush, world, GxView::land());
        self.water.draw(stage.brush, world, GxView::pool(), sim.seconds() as f32);
        GxSprayView::draw(stage.brush, sim);
        stage.finish();
        gxHudDraw(stage.hud, stage.frame(), sim, paused);
    }

    // Sandy crater: darker in the bowl, paler on the rim.
    static fn land() : LandStyle {
        return LandStyle {
            rockLow: Color { r: GY_ROCK_LOW_R, g: GY_ROCK_LOW_G, b: GY_ROCK_LOW_B },
            rockHigh: Color { r: GY_ROCK_HIGH_R, g: GY_ROCK_HIGH_G, b: GY_ROCK_HIGH_B },
            heightLow: GY_H_LO,
            heightHigh: GY_H_HI,
            wall: GY_WALL,
            wallMin: GY_WALL_MIN,
        };
    }

    // The pool: turquoise where it is shallow, deep blue over the vent.
    static fn pool() : WaterStyle {
        return WaterStyle {
            shallow: Color { r: GY_SHALLOW_R, g: GY_SHALLOW_G, b: GY_SHALLOW_B },
            deep: Color { r: GY_DEEP_R, g: GY_DEEP_G, b: GY_DEEP_B },
            deepLevel: GY_WATER_DEEP,
            alphaLow: GY_WATER_ALPHA,
            sheetMin: GY_SHEET_MIN,
            filmLit: GY_FILM_LIT,
        };
    }
}

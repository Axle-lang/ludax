// terrain — the geyser's ground: a plain with a crater bowl cut into it and a raised rim around the bowl.
//
// The bowl holds the pool the vent sits in. The rim is what keeps a full pool from spreading: a pool that is
// fed more than it loses rises until it spills over the rim, so the surplus runs away down the plain instead
// of climbing forever. A little deterministic relief keeps the slopes reading on an otherwise round shape;
// the same ground is baked into the fluid world once.

use ludax::{cosD, sinD, FluidGround};

/** World x of the vent column (and the crater centre). */
pub const GY_VENT_X : i32 = 32;

/** World z of the vent column. */
pub const GY_VENT_Z : i32 = 32;

/** Crater centre in world units, the point the bowl profile measures from. */
const GY_CENTER : f64 = 32.0;

/** Radius of the bowl dip, cells. */
const GY_BOWL_R : f64 = 7.0;

/** Depth of the bowl dip below the plain, cells. */
const GY_BOWL_DEPTH : f64 = 4.5;

/** Radius the rim ring peaks at, cells. */
const GY_RIM_R : f64 = 11.0;

/** Half-width of the rim ring, cells. */
const GY_RIM_W : f64 = 5.0;

/** Height of the rim ring above the plain, cells. */
const GY_RIM_H : f64 = 2.6;

/** Height of the plain the crater sits in, cells. */
const GY_PLAIN : f64 = 2.0;

/** Amplitude of the deterministic ground noise, cells. */
const GY_NOISE : f64 = 0.22;

/** The noise is two crossed sine trains and one diagonal one; these are their fixed frequencies and phases. */
const GY_NOISE_FX : f64 = 0.9;
const GY_NOISE_FZ : f64 = 1.1;
const GY_NOISE_FD : f64 = 0.55;
const GY_NOISE_PX : f64 = 1.3;
const GY_NOISE_PZ : f64 = 0.7;
const GY_NOISE_PD : f64 = 1.7;

/** Weight of the diagonal noise train against the crossed pair. */
const GY_NOISE_DIAG : f64 = 0.5;

/** The crater ground: plain, bowl dip, raised rim, deterministic noise. */
pub class GxTerrain : FluidGround {
    /** Height of the ground under column (`x`, `z`), cells. */
    pub fn heightAt(self, x : i32, z : i32) : f64 {
        let fx : f64 = (x as f64) - GY_CENTER;
        let fz : f64 = (z as f64) - GY_CENTER;
        let r : f64 = (fx * fx + fz * fz).sqrt();

        // The bowl: a parabolic dip, full depth at the vent, meeting the plain at `GY_BOWL_R`.
        let mut h : f64 = GY_PLAIN;
        if (r < GY_BOWL_R) {
            let t : f64 = r / GY_BOWL_R;
            h = h - GY_BOWL_DEPTH * (1.0 - t * t);
        }

        // The rim: a smooth bump ring around the bowl.
        let dr : f64 = r - GY_RIM_R;
        let q : f64 = 1.0 - (dr * dr) / (GY_RIM_W * GY_RIM_W);
        if (q > 0.0) {
            h = h + GY_RIM_H * q * q;
        }

        let crossed : f64 = sinD(fx * GY_NOISE_FX + GY_NOISE_PX) * cosD(fz * GY_NOISE_FZ + GY_NOISE_PZ);
        let diagonal : f64 = sinD((fx + fz) * GY_NOISE_FD + GY_NOISE_PD);
        return h + GY_NOISE * (crossed + GY_NOISE_DIAG * diagonal);
    }
}

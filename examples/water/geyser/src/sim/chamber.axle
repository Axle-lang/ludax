// chamber — the geyser's pressure vessel: the part that decides when it erupts and how hard.
//
// A geyser is a chamber that fills from below and is closed by a constriction until the pressure in it is
// enough to throw the water out. The model keeps only what that needs. The chamber holds a volume of
// water; the pressure it exerts is expressed as a head `h` (the height of water that pressure would
// support) and grows in proportion to the volume stored, as a cushion of compressed gas does. The vent
// stays shut until the head reaches `GY_HEAD_BURST`, then opens, and while it is open water leaves at
// Torricelli's speed `v = sqrt(2 g h)` through the vent's cross-section `GY_VENT_AREA`, so the discharge is
// `A v`. That drains the chamber, the head falls, the jet slows, and the vent closes again at
// `GY_HEAD_CLOSE`: the eruption starts and ends by itself, a relaxation oscillator with nothing on a timer.
// A water jet in air rises to the head that drives it (`v^2 / 2g = h`), which is the number the demo is
// held to: the height the plume reaches is the pressure that built up, and it sinks as the chamber empties.
//
// The chamber is pure arithmetic in f64 with no reference to the fluid world; `GeyserSim` connects its
// inflow to a drain on the pool and its outflow to the droplets, and owns the bookkeeping that nothing is
// lost between them.

use ludax::sqrtD;

/** Head per unit of stored volume, cells of water column per cell unit of volume. */
const GY_HEAD_PER_VOLUME : f64 = 0.1;

/** The head at which the closed vent gives way, cells: the plume's launch height. */
pub const GY_HEAD_BURST : f64 = 20.0;

/** The head at which the open vent shuts again, cells. */
pub const GY_HEAD_CLOSE : f64 = 3.0;

/** Cross-section of the vent, square cells: discharge is this times the exit speed. */
pub const GY_VENT_AREA : f64 = 1.2;

/** The pressure vessel of one geyser. */
pub class GeyserChamber {
    stored   : f64 = 0.0;
    gravity  : f64;
    venting  : bool = false;
    eruption : i32 = 0;

    /** An empty chamber under gravity `g` (cells per second squared), vent shut. */
    constructor(g : f64) {
        self.gravity = g;
    }

    /** Water in the chamber, cell units. */
    pub fn volume(self) : f64 {
        return self.stored;
    }

    /** The pressure head, cells: what the chamber could throw the water to. */
    pub fn head(self) : f64 {
        return self.stored * GY_HEAD_PER_VOLUME;
    }

    /** Whether the vent is open. */
    pub fn isVenting(self) : bool {
        return self.venting;
    }

    /** How many eruptions have begun. */
    pub fn eruptions(self) : i32 {
        return self.eruption;
    }

    /** The speed the water leaves the vent at right now, cells a second: Torricelli's `sqrt(2 g h)`. */
    pub fn exitSpeed(self) : f64 {
        return sqrtD(2.0 * self.gravity * self.head());
    }

    /** Adds `volume` of water arriving from the pool; the vent's state is decided by `step`. */
    pub fn charge(mut self, volume : f64) : void {
        self.stored = self.stored + volume;
    }

    /**
     * Advances the vent by one tick of `dt` seconds and answers the volume that left the chamber this tick:
     * zero while the vent is shut. The vent opens at the burst head and shuts at the closing head, and the
     * discharge never exceeds what the chamber holds.
     */
    pub fn step(mut self, dt : f64) : f64 {
        if (!self.venting && self.head() >= GY_HEAD_BURST) {
            self.venting = true;
            self.eruption = self.eruption + 1;
        } else if (self.venting && self.head() <= GY_HEAD_CLOSE) {
            self.venting = false;
        }
        if (!self.venting) {
            return 0.0;
        }

        let mut out : f64 = GY_VENT_AREA * self.exitSpeed() * dt;
        if (out > self.stored) {
            out = self.stored;
        }
        self.stored = self.stored - out;
        return out;
    }
}

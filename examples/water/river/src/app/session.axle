// session — the interactive river: a window and one simulation tick a frame.
//
// The window, the camera controls and the pacing are the shared viewer's. Each frame this loop advances the
// river exactly one tick, so simulation time is ticks times `RV_DT` and nothing reads a wall clock, then
// draws and presents. A slow frame slows the demo rather than skipping it: the current's pace is the point.

use fluidview::{Viewer, ViewerDesc};
use smalt::PlatformError;

use crate::gfx::scene::RvView;
use crate::sim::river::{RiverParams, RiverSim, RV_PULSE_OFF, RV_PULSE_ON};

/** The interactive session. */
pub class RiverSession {
    /** Opens the window and runs until the player quits; answers the exit code. */
    pub static fn run() : i32 {
        try {
            return RiverSession::play();
        } catch e : PlatformError {
            println(e.message);
            return 1;
        }
    }

    static fn play() : i32 ! PlatformError {
        let view = new Viewer(ViewerDesc {
            title: "River",
            shot: "river.bmp",
            orbit: RvView::orbit(),
            fog: RvView::fog(),
        });
        defer view.close();
        let picture : RvView = new RvView();
        let sim : RiverSim = new RiverSim(RiverParams {
            openSeconds: RV_PULSE_ON,
            shutSeconds: RV_PULSE_OFF,
        });

        while (view.pump()) {
            if (!view.paused()) {
                sim.tick();
            }
            if (view.visible()) {
                picture.picture(view.stage, sim, view.paused());
                view.present();
            }
        }
        return 0;
    }
}

// headless — the modes of the river that finish without a window.
//
// `--ticks N` advances the simulation and prints its state; `--frame FILE` advances it (by default well past
// the transient, where the channel is in steady flow and the streak pool is full) and writes the same picture
// the window would show, through the identical `RvView::picture`. The BMP is the visual gate: the current's
// streaks, the depth shading and the conservation check must be legible in it. `--check` is the numeric one.

use fluidview::{Options, Stage};

use crate::gfx::scene::RvView;
use crate::sim::river::{RiverParams, RiverSim, RV_DT, RV_PULSE_OFF, RV_PULSE_ON};

/** Default tick count of a `--frame` run: 130 s in, where the second cycle's spring is open and the flow is steady. */
const RV_HEADLESS_TICKS : i32 = 2600;

/** The headless front end. */
pub class RiverHeadless {
    /** Simulates to `o.ticks` (or the steady-flow default) and writes the picture to `o.frame`. */
    pub static fn runFrame(o : Options) : i32 {
        let sim : RiverSim = RiverHeadless::simulate(RiverHeadless::tickCount(o));
        RiverHeadless::report(sim);
        let stage : Stage = new Stage(RvView::orbit(), RvView::fog());
        defer stage.close();
        let view : RvView = new RvView();
        view.picture(stage, sim, false);
        if (stage.write(o.frame)) {
            return 0;
        }
        return 1;
    }

    /** Advances `o.ticks` ticks and prints the state; no picture, no window. */
    pub static fn runTicks(o : Options) : i32 {
        RiverHeadless::report(RiverHeadless::simulate(RiverHeadless::tickCount(o)));
        return 0;
    }

    // A fresh river run for `ticks` ticks.
    fn simulate(ticks : i32) : RiverSim {
        let sim : RiverSim = new RiverSim(RiverParams {
            openSeconds: RV_PULSE_ON,
            shutSeconds: RV_PULSE_OFF,
        });
        for (i of 0..ticks) {
            sim.tick();
        }
        return sim;
    }

    // The tick count the command line asks for, or the steady-flow default.
    static fn tickCount(o : Options) : i32 {
        if (o.ticks > 0) {
            return o.ticks;
        }
        return RV_HEADLESS_TICKS;
    }

    static fn report(sim : RiverSim) : void {
        let seconds : f64 = (sim.tickCount() as f64) * RV_DT;
        let volume : f64 = sim.volume();
        let check : f64 = sim.imbalance();
        let streaks : i32 = sim.streakField().alive();
        let wet : i32 = sim.wetColumns();
        let running : bool = sim.springRunning();
        println("river: ${sim.tickCount()} ticks (${seconds} s), volume ${volume}, check ${check}, streaks ${streaks}, wet columns ${wet}, spring running ${running}");
    }
}

// scene — the river's picture: shared terrain and water, with the streaks that show which way it flows.
//
// Everything here is a choice of colour. The valley is earthy green-brown, the water is the shared sheet
// (depth-tinted, rippling, reflecting the sky), and the streaks the simulation keeps ride on top as pale
// ink. The scene is a pure read of the simulation; it never mutates the world.

use fluidview::{CamOrbit, Fog, LandStyle, Landscape, Stage, WaterSheet, WaterStyle};
use ludax::{FluidWorld, Vec3};
use smalt::Color;

use crate::gfx::readout::rvHudDraw;
use crate::sim::river::{RiverSim, RV_GRID};

/** Ground height the albedo ramp starts at, cells. */
const RV_H_LO : f32 = 1.5;

/** Ground height the albedo ramp ends at, cells. */
const RV_H_HI : f32 = 8.0;

/** Fog starts at this view depth. */
const RV_FOG_NEAR : f32 = 55.0;

/** Fog is complete at this view depth. */
const RV_FOG_FAR : f32 = 130.0;

/** How far the fog ever goes. */
const RV_FOG_MAX : f32 = 0.65;

/** Water this deep counts as fully deep, cells. */
const RV_WATER_DEEP : f32 = 1.2;

/** Middle of the valley, which the camera circles, cells. */
const RV_CENTER : f32 = 31.5;

/** The camera's orbit target stands this high above the ground plane, cells. */
const RV_VIEW_TARGET_Y : f32 = 0.5;

/** The camera starts this far from its target, cells. */
const RV_VIEW_DIST : f32 = 55.0;

/** The camera starts at this heading round the target, radians. */
const RV_VIEW_YAW : f32 = 2.2;

/** The camera starts looking down at this angle, radians. */
const RV_VIEW_PITCH : f32 = 0.7;

/** The albedo of the ground at the bottom of the height ramp, linear. */
const RV_ROCK_LOW_R : f32 = 0.33;
const RV_ROCK_LOW_G : f32 = 0.38;
const RV_ROCK_LOW_B : f32 = 0.24;

/** The albedo of the ground at the top of the height ramp, linear. */
const RV_ROCK_HIGH_R : f32 = 0.55;
const RV_ROCK_HIGH_G : f32 = 0.52;
const RV_ROCK_HIGH_B : f32 = 0.44;

/** The packed colour of the cut walls of the terrain, and the darkest they are shaded to. */
const RV_WALL : i32 = 0x665e50;
const RV_WALL_MIN : f32 = 0.55;

/** The water's colour where it is shallow, linear. */
const RV_SHALLOW_R : f32 = 0.5;
const RV_SHALLOW_G : f32 = 0.72;
const RV_SHALLOW_B : f32 = 0.8;

/** The water's colour where it is deep, linear. */
const RV_DEEP_R : f32 = 0.03;
const RV_DEEP_G : f32 = 0.2;
const RV_DEEP_B : f32 = 0.46;

/** The alpha of the thinnest sheet of water, 0 to 255. */
const RV_WATER_ALPHA : i32 = 150;

/** The thinnest sheet that is drawn at all, cells of depth. */
const RV_SHEET_MIN : f32 = 0.08;

/** How much of the sun's light a film of water on the ground reflects. */
const RV_FILM_LIT : f32 = 1.05;

/** The river's picture over a stage. */
pub class RvView {
    water : WaterSheet;

    /** A view for the world of the demo. */
    constructor() {
        self.water = new WaterSheet(RV_GRID, RV_GRID);
    }

    /** The distance fog of the scene. */
    pub static fn fog() : Fog {
        return Fog { near: RV_FOG_NEAR, far: RV_FOG_FAR, max: RV_FOG_MAX };
    }

    /** Where the camera starts: above the valley's middle, looking down the slope at an angle. */
    pub static fn orbit() : CamOrbit {
        return CamOrbit {
            target: Vec3 { x: RV_CENTER, y: RV_VIEW_TARGET_Y, z: RV_CENTER },
            dist: RV_VIEW_DIST,
            yaw: RV_VIEW_YAW,
            pitch: RV_VIEW_PITCH,
        };
    }

    /** One whole frame: scene, rasterisation, HUD. The window and the BMP writer both call this. */
    pub fn picture(mut self, stage : Stage, sim : RiverSim, paused : bool) : void {
        let world : FluidWorld = sim.worldRef();
        stage.begin();
        Landscape::draw(stage.brush, world, RvView::land());
        self.water.draw(stage.brush, world, RvView::sea(), sim.seconds() as f32);
        sim.streakField().draw(stage.brush, world);
        stage.finish();
        rvHudDraw(stage.hud, stage.frame(), sim, paused);
    }

    // The valley: green-brown floor rising to pale hilltops, earth walls.
    static fn land() : LandStyle {
        return LandStyle {
            rockLow: Color { r: RV_ROCK_LOW_R, g: RV_ROCK_LOW_G, b: RV_ROCK_LOW_B },
            rockHigh: Color { r: RV_ROCK_HIGH_R, g: RV_ROCK_HIGH_G, b: RV_ROCK_HIGH_B },
            heightLow: RV_H_LO,
            heightHigh: RV_H_HI,
            wall: RV_WALL,
            wallMin: RV_WALL_MIN,
        };
    }

    // River water: pale shallows, deep blue where it pools.
    static fn sea() : WaterStyle {
        return WaterStyle {
            shallow: Color { r: RV_SHALLOW_R, g: RV_SHALLOW_G, b: RV_SHALLOW_B },
            deep: Color { r: RV_DEEP_R, g: RV_DEEP_G, b: RV_DEEP_B },
            deepLevel: RV_WATER_DEEP,
            alphaLow: RV_WATER_ALPHA,
            sheetMin: RV_SHEET_MIN,
            filmLit: RV_FILM_LIT,
        };
    }
}

// readout — what the river's HUD says, and where.
//
// The volume is the headline: it settles once the channel is wet, and the check beside it is the
// conservation claim (volume minus injected plus drained must stay at zero to the rounding). Under it come the
// measured inflow and outflow, which meet at steady state, the number of streaks and the simulation time.
// This file owns the arrangement; the `Hud` class owns how ink lands.

use fluidview::{Hud, Pen, HUD_ACCENT, HUD_DIM, HUD_LEADING, HUD_MARGIN, HUD_TITLE_SCALE};
use smalt::Frame;

use crate::sim::river::RiverSim;

/** x of the second column of figures. */
const RVO_COL2 : i32 = 170;

/** x of the conservation check beside the headline. */
const RVO_CHECK_X : i32 = 192;

/** x of the spring's state, after the time. */
const RVO_SPRING_X : i32 = 300;

// What the HUD says of the spring.
fn rvSpringLabel(running : bool) : string {
    if (running) {
        return "spring open";
    }
    return "spring shut";
}

/** Draws the river's HUD onto the scaled frame; `paused` adds the badge. */
pub fn rvHudDraw(h : Hud, f : Frame, sim : RiverSim, paused : bool) : void {
    let head : Pen = Pen::at(HUD_MARGIN, HUD_MARGIN, HUD_ACCENT);
    h.fixed(f, head.scaled(HUD_TITLE_SCALE), "volume ", sim.volume(), 1);
    h.fixed(f, Pen::at(RVO_CHECK_X, HUD_MARGIN + 8, HUD_DIM), "check ", sim.imbalance(), 4);

    let row2 : i32 = HUD_MARGIN + 30;
    h.fixed(f, Pen::at(HUD_MARGIN, row2, HUD_DIM), "inflow ", sim.inflow(), 1);
    h.fixed(f, Pen::at(RVO_COL2, row2, HUD_DIM), "outflow ", sim.outflow(), 1);

    let row3 : i32 = row2 + HUD_LEADING;
    h.whole(f, Pen::at(HUD_MARGIN, row3, HUD_DIM), "streaks ", sim.streakField().alive() as i64);
    h.fixed(f, Pen::at(RVO_COL2, row3, HUD_DIM), "time ", sim.seconds(), 1);
    h.text(f, Pen::at(RVO_SPRING_X, row3, HUD_ACCENT), rvSpringLabel(sim.springRunning()));

    h.chrome(f, paused);
}

// main — river, a column-fluid river whose current you can watch.
//
// A serpentine valley on a 64 x 64 column grid: an infinite source at the head, a drain at the foot, the
// FluidWorld moving the water between by gravity alone. The current is made visible two ways — streaks seeded
// from the tick's own flows (`flowAt`), drifting down the surface gradient, and a rippling, depth-tinted
// water sheet. The HUD holds the conservation check (volume minus injected plus drained) next to the volume.
// The window shows it in a hand-rolled 3-D painter; `--frame FILE` renders a headless BMP, `--ticks N`
// advances the simulation without a window, and `--check` verifies the physics and exits with the number of
// claims that failed.

use fluidview::{Cli, Options};

use crate::app::check::RiverCheck;
use crate::app::headless::RiverHeadless;
use crate::app::session::RiverSession;

fn main() : i32 {
    let o : Options = Cli::parse();
    if (o.problem.length > 0) {
        println(o.problem);
        println(Cli::usage("river"));
        return 2;
    }
    if (o.help) {
        println(Cli::usage("river"));
        return 0;
    }

    // The modes are exclusive: the numeric check, a picture, bare ticks, then the window.
    if (o.check) {
        return RiverCheck::run();
    }
    if (o.frame.length > 0) {
        return RiverHeadless::runFrame(o);
    }
    if (o.ticks > 0) {
        return RiverHeadless::runTicks(o);
    }
    return RiverSession::run();
}

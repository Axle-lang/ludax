// readout — what the intermittent's HUD says, and where.
//
// The claim is that a steady spring makes an unsteady flow, so the two flows sit side by side: the spring's
// constant inflow and the valley's outflow, which is nothing for most of the cycle and a rush while the siphon
// runs. The pool depth is the quantity the siphon reads, shown with its two thresholds; below it come the
// volume and the conservation check (volume minus injected plus drained stays at the rounding) and the number
// of times the siphon has primed. This file owns the arrangement; the `Hud` class owns how ink lands.

use fluidview::{Hud, Pen, HUD_ACCENT, HUD_DIM, HUD_LEADING, HUD_MARGIN, HUD_TITLE_SCALE};
use smalt::Frame;

use crate::sim::intermittent::{IntermittentSim, IN_DEPTH_OFF, IN_DEPTH_ON};

/** x of the second column of figures. */
const INO_COL2 : i32 = 190;

/** Draws the intermittent's HUD onto the scaled frame; `paused` adds the badge. */
pub fn inHudDraw(h : Hud, f : Frame, sim : IntermittentSim, paused : bool) : void {
    let head : Pen = Pen::at(HUD_MARGIN, HUD_MARGIN, HUD_ACCENT);
    h.text(f, head.scaled(HUD_TITLE_SCALE), sim.phaseName());

    let row1 : i32 = HUD_MARGIN + 30;
    h.fixed(f, Pen::at(HUD_MARGIN, row1, HUD_DIM), "for ", sim.phaseSeconds(), 1);
    h.fixed(f, Pen::at(INO_COL2, row1, HUD_DIM), "time ", sim.seconds(), 1);

    let row2 : i32 = row1 + HUD_LEADING;
    h.fixed(f, Pen::at(HUD_MARGIN, row2, HUD_ACCENT), "pool depth ", sim.poolDepth(), 2);
    h.fixed(f, Pen::at(INO_COL2, row2, HUD_DIM), "prime at ", IN_DEPTH_ON, 1);
    h.fixed(f, Pen::at(INO_COL2 + 120, row2, HUD_DIM), "break at ", IN_DEPTH_OFF, 1);

    let row3 : i32 = row2 + HUD_LEADING;
    h.fixed(f, Pen::at(HUD_MARGIN, row3, HUD_DIM), "spring in ", sim.inflow(), 1);
    h.fixed(f, Pen::at(INO_COL2, row3, HUD_ACCENT), "valley out ", sim.outflow(), 1);

    let row4 : i32 = row3 + HUD_LEADING;
    h.whole(f, Pen::at(HUD_MARGIN, row4, HUD_DIM), "cycles ", sim.primings() as i64);
    h.fixed(f, Pen::at(INO_COL2, row4, HUD_DIM), "check ", sim.imbalance(), 4);

    h.chrome(f, paused);
}

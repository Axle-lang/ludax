// scene — the intermittent's picture: shared terrain and water, and the streaks that show a burst running.
//
// The terrace and valley are drawn in different earth tones so the cliff the trench cuts through reads, and
// the water is the shared sheet. The streaks matter most here: they are born only where water crosses a
// frontier, so the channel is covered in ink during a burst and bare between bursts. The scene is a pure
// read of the simulation; it never mutates the world.

use fluidview::{CamOrbit, Fog, LandStyle, Landscape, Stage, WaterSheet, WaterStyle};
use ludax::{FluidWorld, Vec3};
use smalt::Color;

use crate::gfx::readout::inHudDraw;
use crate::sim::intermittent::{IntermittentSim, IN_GRID};

/** Ground height the albedo ramp starts at, cells. */
const IN_H_LO : f32 = 3.5;

/** Ground height the albedo ramp ends at, cells. */
const IN_H_HI : f32 = 9.0;

/** Fog starts at this view depth. */
const IN_FOG_NEAR : f32 = 55.0;

/** Fog is complete at this view depth. */
const IN_FOG_FAR : f32 = 130.0;

/** How far the fog ever goes. */
const IN_FOG_MAX : f32 = 0.65;

/** Water this deep counts as fully deep, cells. */
const IN_WATER_DEEP : f32 = 1.6;

/** Middle of the scene the camera circles, cells. */
const IN_CENTER : f32 = 32.0;

/** The camera's orbit target stands this high above the ground plane, cells. */
const IN_VIEW_TARGET_Y : f32 = 4.0;

/** The camera starts this far from its target, cells. */
const IN_VIEW_DIST : f32 = 58.0;

/** The camera starts at this heading round the target, radians. */
const IN_VIEW_YAW : f32 = 2.3;

/** The camera starts looking down at this angle, radians. */
const IN_VIEW_PITCH : f32 = 0.7;

/** The albedo of the ground at the bottom of the height ramp, linear. */
const IN_ROCK_LOW_R : f32 = 0.33;
const IN_ROCK_LOW_G : f32 = 0.38;
const IN_ROCK_LOW_B : f32 = 0.24;

/** The albedo of the ground at the top of the height ramp, linear. */
const IN_ROCK_HIGH_R : f32 = 0.6;
const IN_ROCK_HIGH_G : f32 = 0.54;
const IN_ROCK_HIGH_B : f32 = 0.45;

/** The packed colour of the cut walls of the terrain, and the darkest they are shaded to. */
const IN_WALL : i32 = 0x665e50;
const IN_WALL_MIN : f32 = 0.55;

/** The water's colour where it is shallow, linear. */
const IN_SHALLOW_R : f32 = 0.5;
const IN_SHALLOW_G : f32 = 0.72;
const IN_SHALLOW_B : f32 = 0.8;

/** The water's colour where it is deep, linear. */
const IN_DEEP_R : f32 = 0.03;
const IN_DEEP_G : f32 = 0.2;
const IN_DEEP_B : f32 = 0.46;

/** The alpha of the thinnest sheet of water, 0 to 255. */
const IN_WATER_ALPHA : i32 = 150;

/** The thinnest sheet that is drawn at all, cells of depth. */
const IN_SHEET_MIN : f32 = 0.08;

/** How much of the sun's light a film of water on the ground reflects. */
const IN_FILM_LIT : f32 = 1.05;

/** The intermittent's picture over a stage. */
pub class InView {
    water : WaterSheet;

    /** A view for the world of the demo. */
    constructor() {
        self.water = new WaterSheet(IN_GRID, IN_GRID);
    }

    /** The distance fog of the scene. */
    pub static fn fog() : Fog {
        return Fog { near: IN_FOG_NEAR, far: IN_FOG_FAR, max: IN_FOG_MAX };
    }

    /** Where the camera starts: above the terrace, looking along the trench and the valley. */
    pub static fn orbit() : CamOrbit {
        return CamOrbit {
            target: Vec3 { x: IN_CENTER, y: IN_VIEW_TARGET_Y, z: IN_CENTER },
            dist: IN_VIEW_DIST,
            yaw: IN_VIEW_YAW,
            pitch: IN_VIEW_PITCH,
        };
    }

    /** One whole frame: scene, rasterisation, HUD. The window and the BMP writer both call this. */
    pub fn picture(mut self, stage : Stage, sim : IntermittentSim, paused : bool) : void {
        let world : FluidWorld = sim.worldRef();
        stage.begin();
        Landscape::draw(stage.brush, world, InView::land());
        self.water.draw(stage.brush, world, InView::sea(), sim.seconds() as f32);
        sim.streakField().draw(stage.brush, world);
        stage.finish();
        inHudDraw(stage.hud, stage.frame(), sim, paused);
    }

    // Warm stone for the terrace and bowl, greener toward the valley floor.
    static fn land() : LandStyle {
        return LandStyle {
            rockLow: Color { r: IN_ROCK_LOW_R, g: IN_ROCK_LOW_G, b: IN_ROCK_LOW_B },
            rockHigh: Color { r: IN_ROCK_HIGH_R, g: IN_ROCK_HIGH_G, b: IN_ROCK_HIGH_B },
            heightLow: IN_H_LO,
            heightHigh: IN_H_HI,
            wall: IN_WALL,
            wallMin: IN_WALL_MIN,
        };
    }

    // Clear water: pale where it films, deep blue in the pool.
    static fn sea() : WaterStyle {
        return WaterStyle {
            shallow: Color { r: IN_SHALLOW_R, g: IN_SHALLOW_G, b: IN_SHALLOW_B },
            deep: Color { r: IN_DEEP_R, g: IN_DEEP_G, b: IN_DEEP_B },
            deepLevel: IN_WATER_DEEP,
            alphaLow: IN_WATER_ALPHA,
            sheetMin: IN_SHEET_MIN,
            filmLit: IN_FILM_LIT,
        };
    }
}

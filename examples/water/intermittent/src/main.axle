// main — intermittent, a reservoir that fills steadily and empties in bursts.
//
// A spring feeds a bowl at a constant rate; the bowl's siphon primes at a crest depth, drains it through a
// trench into a valley, and breaks at the inlet depth, so the valley sees bursts and dry stretches from a
// steady supply with nothing on a timer. The window shows it in a hand-rolled 3-D painter; `--frame FILE`
// renders the full/burst pair as headless BMPs, `--ticks N` advances the simulation without a window, and
// `--check` verifies the physics and exits with the number of claims that failed.

use fluidview::{Cli, Options};

use crate::app::check::IntermittentCheck;
use crate::app::headless::IntermittentHeadless;
use crate::app::session::IntermittentSession;

fn main() : i32 {
    let o : Options = Cli::parse();
    if (o.problem.length > 0) {
        println(o.problem);
        println(Cli::usage("intermittent"));
        return 2;
    }
    if (o.help) {
        println(Cli::usage("intermittent"));
        return 0;
    }

    // The modes are exclusive: the numeric check, a picture, bare ticks, then the window.
    if (o.check) {
        return IntermittentCheck::run();
    }
    if (o.frame.length > 0) {
        return IntermittentHeadless::runFrame(o);
    }
    if (o.ticks > 0) {
        return IntermittentHeadless::runTicks(o);
    }
    return IntermittentSession::run();
}

// headless — the modes of the intermittent that finish without a window.
//
// `--ticks N` advances the simulation and prints its state. `--frame FILE` is the demonstration pair: it runs
// to the second priming and writes `FILE` with `_full` before the extension at the last tick before the
// siphon primes (the bowl full, the valley bare) and with `_burst` a few seconds into the discharge (the
// bowl falling, the channel carrying the rush). The two BMPs are the same scene from the same angle, so the
// comparison is honest; `--ticks N` replaces the pair with one picture at tick N. The window path draws the
// identical picture through `InView::picture`. `--check` is the numeric gate.

use fluidview::{Cli, Options, Stage};

use crate::gfx::scene::InView;
use crate::sim::intermittent::{InPhase, IntermittentSim, IN_DEPTH_ON};

/** Primings the pair waits for: the first fill starts from an empty bowl, the second is the steady cycle. */
const IN_HEADLESS_CYCLE : i32 = 2;

/** How far below the crest depth the full picture is taken, cells: close enough to read as full. */
const IN_HEADLESS_NEAR : f64 = 0.05;

/** Ticks into the discharge the burst picture is taken at. */
const IN_HEADLESS_BURST : i32 = 40;

/** Ticks a run gives up after, if the siphon never primes (a broken engine, not a long cycle). */
const IN_HEADLESS_LIMIT : i32 = 20000;

/** The headless front end. */
pub class IntermittentHeadless {
    /** Writes the full/burst pair, or one picture at `o.ticks`. */
    pub static fn runFrame(o : Options) : i32 {
        let sim : IntermittentSim = new IntermittentSim();
        let stage : Stage = new Stage(InView::orbit(), InView::fog());
        defer stage.close();
        let view : InView = new InView();

        if (o.ticks > 0) {
            IntermittentHeadless::advance(sim, o.ticks);
            IntermittentHeadless::report(sim);
            view.picture(stage, sim, false);
            return IntermittentHeadless::exit(stage.write(o.frame));
        }

        // The bowl at the crest of the second fill, a hair before the siphon primes.
        let crest : f64 = IN_DEPTH_ON - IN_HEADLESS_NEAR;
        let mut guard : i32 = 0;
        while (sim.primings() < IN_HEADLESS_CYCLE - 1 || sim.phase() == InPhase::Draining
            || sim.poolDepth() < crest) {
            sim.tick();
            guard = guard + 1;
            if (guard > IN_HEADLESS_LIMIT) {
                println("intermittent: the siphon never primed");
                return 1;
            }
        }
        IntermittentHeadless::report(sim);
        view.picture(stage, sim, false);
        let okFull : bool = stage.write(Cli::beside(o.frame, "_full"));

        while (sim.phase() == InPhase::Filling) {
            sim.tick();
        }
        IntermittentHeadless::advance(sim, IN_HEADLESS_BURST);
        IntermittentHeadless::report(sim);
        view.picture(stage, sim, false);
        let okBurst : bool = stage.write(Cli::beside(o.frame, "_burst"));
        return IntermittentHeadless::exit(okFull && okBurst);
    }

    /** Advances `o.ticks` ticks and prints the state; no picture, no window. */
    pub static fn runTicks(o : Options) : i32 {
        let sim : IntermittentSim = new IntermittentSim();
        IntermittentHeadless::advance(sim, o.ticks);
        IntermittentHeadless::report(sim);
        return 0;
    }

    static fn advance(sim : IntermittentSim, ticks : i32) : void {
        for (i of 0..ticks) {
            sim.tick();
        }
    }

    static fn exit(ok : bool) : i32 {
        if (ok) {
            return 0;
        }
        return 1;
    }

    static fn report(sim : IntermittentSim) : void {
        let seconds : f64 = sim.seconds();
        let depth : f64 = sim.poolDepth();
        let volume : f64 = sim.volume();
        let check : f64 = sim.imbalance();
        println("intermittent: ${sim.tickCount()} ticks (${seconds} s), ${sim.phaseName()}, pool ${depth}, volume ${volume}, check ${check}, primings ${sim.primings()}");
    }
}

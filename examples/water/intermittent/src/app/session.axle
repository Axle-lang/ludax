// session — the interactive intermittent: a window and one simulation tick a frame.
//
// The window, the camera controls and the pacing are the shared viewer's. Each frame this loop advances the
// simulation exactly one tick, so simulation time is ticks times `IN_DT` and nothing reads a wall clock,
// then draws and presents. A slow frame slows the demo rather than skipping it: the cycle's pace is the point.

use fluidview::{Viewer, ViewerDesc};
use smalt::PlatformError;

use crate::gfx::scene::InView;
use crate::sim::intermittent::IntermittentSim;

/** The interactive session. */
pub class IntermittentSession {
    /** Opens the window and runs until the player quits; answers the exit code. */
    pub static fn run() : i32 {
        try {
            return IntermittentSession::play();
        } catch e : PlatformError {
            println(e.message);
            return 1;
        }
    }

    static fn play() : i32 ! PlatformError {
        let view = new Viewer(ViewerDesc {
            title: "Intermittent",
            shot: "intermittent.bmp",
            orbit: InView::orbit(),
            fog: InView::fog(),
        });
        defer view.close();
        let picture : InView = new InView();
        let sim : IntermittentSim = new IntermittentSim();

        while (view.pump()) {
            if (!view.paused()) {
                sim.tick();
            }
            if (view.visible()) {
                picture.picture(view.stage, sim, view.paused());
                view.present();
            }
        }
        return 0;
    }
}

// png — writes the canvas as a PNG file with the library's own encoder.
//
// The example draws into a plain RGB byte canvas; this turns it into a ludax `Image` and lets `PngCodec` (through
// `DataFiles`) do the encoding, so there is one PNG writer in the code base and not one per example.

use ludax::{DataFiles, Image};

/** Bytes per pixel in the canvas: red, green and blue. */
const PNG_CHANNELS : i32 = 3;

/** The low 8 bits of a channel; the canvas stores bytes in signed storage. */
const PNG_CHANNEL_MASK : i32 = 255;

/** The opaque alpha an RGB canvas gets in the image. */
const PNG_ALPHA : i32 = 255;

/** Saves RGB canvases as PNG. */
pub class PngWriter {
    /** Writes `width` x `height` pixels of `rgb` (3 bytes each, rows top to bottom) to `path`. */
    pub static fn write(path : string, width : i32, height : i32, rgb : i8[]) : void ! IOException {
        let mut img : Image = new Image(width, height);
        for (y of 0..height) {
            for (x of 0..width) {
                let at : i32 = (y * width + x) * PNG_CHANNELS;
                let r : i32 = (rgb[at] as i32) & PNG_CHANNEL_MASK;
                let g : i32 = (rgb[at + 1] as i32) & PNG_CHANNEL_MASK;
                let b : i32 = (rgb[at + 2] as i32) & PNG_CHANNEL_MASK;
                img.set(x, y, Image::pack(r, g, b, PNG_ALPHA));
            }
        }
        DataFiles::savePng(path, img);
    }
}

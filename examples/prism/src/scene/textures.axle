// textures — the pictures prism's surfaces use, drawn in code from a seeded generator so the example needs no asset.
//
// Three images, all 256 x 256 and all the same on every run: floor tiles (cream and sand squares with dark grout), a
// brick wall in running bond (each brick its own shade, mortar between) and the normal map of that wall. The normal map
// is a data texture, 8 bits a channel with (r, g, b) = (n + 1) / 2 and green pointing up in the picture; it is derived
// from the height of the wall (bricks stand proud of the mortar with a rounded edge) by finite differences, so the
// bumps the renderer shows are exactly the ones the colour picture draws.
//
// The generator is seeded per texture, so adding a call does not change the others. Grain is drawn per texel from the
// same stream as the tile and brick shades: it is what keeps the flat tints from banding.

use ludax::{Image, Pcg32, sqrt};

// The texture size, the tile size in texels, and the grout width between tiles.
const PRISM_TEX : i32 = 256;
const PRISM_TILE : i32 = 64;
const PRISM_GROUT : i32 = 3;

// The wall: bricks of 64 x 32 texels in rows of 4 and 8 rows, mortar 4 texels wide, with a 3-texel rounded edge.
const PRISM_BRICK_W : i32 = 64;
const PRISM_BRICK_H : i32 = 32;
const PRISM_MORTAR : i32 = 4;
const PRISM_BEVEL : i32 = 3;

// How many tiles across the picture (256 / 64), and how many distinct brick tints the wall needs.
const PRISM_TILES : i32 = 4;
const PRISM_BRICK_TINTS : i32 = 64;

// Grain and shade amplitudes: per-texel noise, per-tile shade, per-brick tint, per-brick grain.
const PRISM_TILE_GRAIN : i32 = 5;
const PRISM_TILE_SHADE : i32 = 10;
const PRISM_BRICK_TINT : i32 = 26;
const PRISM_BRICK_GRAIN : i32 = 9;

// The normal map is written as (n + 1) / 2 over this range.
const PRISM_NORMAL_HALF : f32 = 0.5;
const PRISM_BYTE_MAX : f32 = 255.0;

// The sky strip: this wide and this tall, the horizon at row 128, haze over the first 35 degrees.
const PRISM_SKY_W : i32 = 4;
const PRISM_SKY_H : i32 = 256;
const PRISM_SKY_HORIZON : i32 = 128;
const PRISM_SKY_DEGREES : f32 = 180.0;
const PRISM_SKY_HAZE : f32 = 35.0;

fn prismClamp(v : i32) : i32 {
    if (v < 0) {
        return 0;
    }
    if (v > 255) {
        return 255;
    }
    return v;
}

/** Cream and sand tiles of 64 texels with 3-texel grout, a touch of grain on each tile. */
pub fn prismFloorImage() : Image {
    let mut img : Image = new Image(PRISM_TEX, PRISM_TEX);
    let r : Pcg32 = new Pcg32(11, 3);
    let mut shade : i32[] = malloc<i32>((PRISM_TILES * PRISM_TILES) as i64);
    for (i of 0..(PRISM_TILES * PRISM_TILES)) {
        shade[i] = r.range(-PRISM_TILE_SHADE, PRISM_TILE_SHADE);
    }

    for (y of 0..PRISM_TEX) {
        for (x of 0..PRISM_TEX) {
            let tx : i32 = x / PRISM_TILE;
            let ty : i32 = y / PRISM_TILE;
            let lx : i32 = x % PRISM_TILE;
            let ly : i32 = y % PRISM_TILE;
            let grain : i32 = r.range(-PRISM_TILE_GRAIN, PRISM_TILE_GRAIN);
            if (lx < PRISM_GROUT || ly < PRISM_GROUT) {
                img.set(x, y, Image::pack(86 + grain, 80 + grain, 74 + grain, 255));
            } else if ((tx + ty) % 2 == 0) {
                let s : i32 = shade[ty * PRISM_TILES + tx];
                img.set(
                    x,
                    y,
                    Image::pack(
                        prismClamp(214 + s + grain),
                        prismClamp(204 + s + grain),
                        prismClamp(184 + s + grain),
                        255
                    )
                );
            } else {
                let s : i32 = shade[ty * PRISM_TILES + tx];
                img.set(
                    x,
                    y,
                    Image::pack(
                        prismClamp(188 + s + grain),
                        prismClamp(170 + s + grain),
                        prismClamp(140 + s + grain),
                        255
                    )
                );
            }
        }
    }
    return img;
}

// The height of the wall at a texel, 0 in the mortar rising to 1 inside a brick over 3 texels.
fn prismBrickHeight(x : i32, y : i32) : f32 {
    let row : i32 = y / PRISM_BRICK_H;
    let mut sx : i32 = x + (row % 2) * (PRISM_BRICK_W / 2);
    sx = ((sx % PRISM_TEX) + PRISM_TEX) % PRISM_TEX;
    let lx : i32 = sx % PRISM_BRICK_W;
    let ly : i32 = y % PRISM_BRICK_H;

    // Distance to the nearest brick edge, then the bevel: mortar, a rounded rise, flat top.
    let mut edge : i32 = lx;
    if (PRISM_BRICK_W - 1 - lx < edge) {
        edge = PRISM_BRICK_W - 1 - lx;
    }
    if (ly < edge) {
        edge = ly;
    }
    if (PRISM_BRICK_H - 1 - ly < edge) {
        edge = PRISM_BRICK_H - 1 - ly;
    }
    let inside : i32 = edge - PRISM_MORTAR / 2;
    if (inside <= 0) {
        return 0.0;
    }
    if (inside >= PRISM_BEVEL) {
        return 1.0;
    }
    return (inside as f32) / (PRISM_BEVEL as f32);
}

/** Red-brown bricks in running bond with grey mortar; every brick has its own tint. */
pub fn prismBrickImage() : Image {
    let mut img : Image = new Image(PRISM_TEX, PRISM_TEX);
    let r : Pcg32 = new Pcg32(21, 7);
    let mut tint : i32[] = malloc<i32>(PRISM_BRICK_TINTS as i64);
    for (i of 0..PRISM_BRICK_TINTS) {
        tint[i] = r.range(-PRISM_BRICK_TINT, PRISM_BRICK_TINT);
    }

    for (y of 0..PRISM_TEX) {
        for (x of 0..PRISM_TEX) {
            let row : i32 = y / PRISM_BRICK_H;
            let sx : i32 = ((x + (row % 2) * (PRISM_BRICK_W / 2)) % PRISM_TEX + PRISM_TEX) % PRISM_TEX;
            let col : i32 = sx / PRISM_BRICK_W;
            let grain : i32 = r.range(-PRISM_BRICK_GRAIN, PRISM_BRICK_GRAIN);
            let h : f32 = prismBrickHeight(x, y);
            if (h < PRISM_NORMAL_HALF) {
                let m : i32 = 150 + grain;
                img.set(x, y, Image::pack(prismClamp(m), prismClamp(m - 4), prismClamp(m - 12), 255));
            } else {
                let t : i32 = tint[row * PRISM_TILES + col];
                img.set(
                    x,
                    y,
                    Image::pack(
                        prismClamp(172 + t + grain),
                        prismClamp(72 + t / 2 + grain),
                        prismClamp(52 + grain),
                        255
                    )
                );
            }
        }
    }
    return img;
}

/** The normal map of the brick wall (tangent space, green up), `strength` scaling the slope. */
pub fn prismBrickNormals(strength : f32) : Image {
    let mut img : Image = new Image(PRISM_TEX, PRISM_TEX);
    for (y of 0..PRISM_TEX) {
        for (x of 0..PRISM_TEX) {
            // Central differences of the height, scaled to a slope.
            let gx : f32 = (prismBrickHeight(x + 1, y) - prismBrickHeight(x - 1, y)) * PRISM_NORMAL_HALF
                * strength;
            let gy : f32 = (prismBrickHeight(x, y + 1) - prismBrickHeight(x, y - 1)) * PRISM_NORMAL_HALF
                * strength;

            // Slope along the picture's "up" is minus the slope along its rows.
            let nx : f32 = -gx;
            let ny : f32 = gy;
            let nz : f32 = 1.0;
            let len : f32 = sqrt(nx * nx + ny * ny + nz * nz);
            let r : i32 = (((nx / len) * PRISM_NORMAL_HALF + PRISM_NORMAL_HALF) * PRISM_BYTE_MAX
                + PRISM_NORMAL_HALF) as i32;
            let g : i32 = (((ny / len) * PRISM_NORMAL_HALF + PRISM_NORMAL_HALF) * PRISM_BYTE_MAX
                + PRISM_NORMAL_HALF) as i32;
            let b : i32 = (((nz / len) * PRISM_NORMAL_HALF + PRISM_NORMAL_HALF) * PRISM_BYTE_MAX
                + PRISM_NORMAL_HALF) as i32;
            img.set(x, y, Image::pack(r, g, b, 255));
        }
    }
    return img;
}

/**
 * A sky for the dome: 4 x 256 texels over the whole sphere (row 0 the zenith, row 128 the horizon, the rest below it):
 * deep blue overhead, fading quadratically to pale haze over the first 35 degrees of elevation.
 */
pub fn prismSkyImage() : Image {
    let mut img : Image = new Image(PRISM_SKY_W, PRISM_SKY_H);
    for (y of 0..PRISM_SKY_H) {
        let mut elevation : f32 = ((PRISM_SKY_HORIZON - y) as f32) * PRISM_SKY_DEGREES / (PRISM_SKY_H as f32);
        if (elevation < (0.0 as f32)) {
            elevation = 0.0;
        }
        let mut t : f32 = elevation / PRISM_SKY_HAZE;
        if (t > (1.0 as f32)) {
            t = 1.0;
        }

        // Quadratic fall-off: deep blue (46, 96, 176) overhead towards haze (222, 226, 238).
        let k : f32 = ((1.0 as f32) - t) * ((1.0 as f32) - t);
        let r : i32 = (46.0 + 176.0 * k) as i32;
        let g : i32 = (96.0 + 130.0 * k) as i32;
        let b : i32 = (176.0 + 62.0 * k) as i32;
        for (x of 0..PRISM_SKY_W) {
            img.set(x, y, Image::pack(r, g, b, 255));
        }
    }
    return img;
}

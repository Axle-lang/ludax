// prism — the render abstraction end to end, headless: world, extraction, render graph, command stream, CPU backend.
//
// It builds a small stage in a world `Scene` (a tiled floor, ten spheres from glossy to rough in plastic and gold, a
// brick cube with a normal map, a steel column, a glass ball, a lamp and the sun), extracts it into a camera-relative
// snapshot, declares and compiles a render graph, records a command stream, and has the deterministic CPU backend
// draw 640 x 360 pixels with PBR shading from the lighting library and ray-traced shadows. It prints the graph report
// and what it checked, and writes prism.png. The GPU backend does not exist yet: this is the reference it will be
// compared with.
//
// The extra frames are deliberate comparisons rather than second renders: the same picture on one thread and on
// many, the same stage moved 4000 km, and the picture read back from disk. The exit status is the failed checks.

use ludax::{DVec3, DataFiles, GraphReport, Image, JobPool, nanosToMillis, nowNanos};

use crate::app::checks::PrismChecks;
use crate::app::frame::{PrismFrame, PRISM_WINDOW};
use crate::scene::stage::PrismStage;

// The picture size, and the smaller size the far-away comparison uses (a quarter of it in each direction).
const PRISM_WIDTH : i32 = 640;
const PRISM_HEIGHT : i32 = 360;
const PRISM_SMALL_W : i32 = 160;
const PRISM_SMALL_H : i32 = 90;

// A stage origin far enough that f32 world coordinates would have lost all their precision.
const PRISM_FAR_X : f64 = 4000000.0;
const PRISM_FAR_Z : f64 = -3000000.0;

const PRISM_PNG : string = "prism.png";

fn main() : i32 ! IOException {
    let w : i32 = PRISM_WIDTH;
    let h : i32 = PRISM_HEIGHT;
    let workers : i32 = JobPool::defaultWorkers();
    let checks : PrismChecks = new PrismChecks();

    let stage : PrismStage = new PrismStage(DVec3::make(0.0, 0.0, 0.0));
    println("prism: stage with ${stage.drawn} drawn entities, ${stage.world.count()} in the world");

    let began : i64 = nowNanos();
    let frame : PrismFrame = new PrismFrame(stage, w, h, workers);
    let spent : i64 = nowNanos() - began;
    println("prism: rendered ${w} x ${h} on ${workers} worker threads in ${nanosToMillis(spent)} ms"
        + " (extraction and planning included)");
    println("");
    println(GraphReport::text(frame.graph, frame.plan, frame.costs, true));

    checks.structure(stage, frame);
    checks.pixels(frame, w, h);

    // The same frame on the calling thread alone, and the same stage far from the origin at a smaller size.
    let serialBegan : i64 = nowNanos();
    let serial : PrismFrame = new PrismFrame(stage, w, h, 0);
    let serialMs : f64 = nanosToMillis(nowNanos() - serialBegan);
    println("prism: the same frame on the calling thread alone took ${serialMs} ms");
    checks.threads(serial, frame, w, h);
    checks.shadow(stage, frame, w, h);

    let small : PrismFrame = new PrismFrame(stage, PRISM_SMALL_W, PRISM_SMALL_H, 0);
    let moved : PrismStage = new PrismStage(DVec3::make(PRISM_FAR_X, 0.0, PRISM_FAR_Z));
    let faraway : PrismFrame = new PrismFrame(moved, PRISM_SMALL_W, PRISM_SMALL_H, 0);
    checks.largeWorld(small, faraway, PRISM_SMALL_W, PRISM_SMALL_H);

    let picture : Image = frame.renderer.picture(PRISM_WINDOW);
    DataFiles::savePng(PRISM_PNG, picture);
    let back : Image = DataFiles::loadPng(PRISM_PNG);
    checks.check("${PRISM_PNG} was written and reads back as the same picture", back.same(picture));
    println("prism: wrote ${PRISM_PNG} (${w} x ${h})");

    frame.close();
    serial.close();
    small.close();
    faraway.close();
    println("prism: ${checks.total} checks, ${checks.failed} failed");
    return checks.failed;
}

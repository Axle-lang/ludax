// pool — a fixed number of reusable slots, so shots and sparks are never allocated while the game runs.
//
// Bullets and particles come and go by the hundred. A pool builds all its slots once, hands them out from a
// free stack and takes them back on release; a `BitSet` records which slots are live, so a pass over the
// live ones skips the dead and visits them in ascending slot order, which is the same on every run. The free
// stack is seeded so that the first spawns take slots 0, 1, 2, ...; a released slot is the next one reused.
//
// Ludax has `Slab` for things that need a generation-checked id and `Vec` for packed storage, but nothing
// for "a fixed arena of slots that never grows": this is the small piece the game builds from `Vec` and
// `BitSet` (reported as a feature request in the example's notes).

use ludax::{Vec, BitSet};

/** A fixed-capacity pool of `T` slots addressed by plain indices. */
pub class Pool<T> {
    items : Vec<T>;
    live  : BitSet;
    spare : Vec<i32>;
    used  : i32 = 0;

    /** A pool of `capacity` slots, each starting as a copy of `blank`. */
    constructor(capacity : i32, blank : T) {
        self.items = new Vec<T>(capacity);
        self.live = new BitSet(capacity);
        self.spare = new Vec<i32>(capacity);
        for (i of 0..capacity) {
            self.items.push(blank);
        }
        self.refill();
    }

    // Every slot goes on the free stack, highest first, so the lowest is popped first.
    fn refill(mut self) : void {
        self.spare.clear();
        let mut i : i32 = self.items.len() - 1;
        while (i >= 0) {
            self.spare.push(i);
            i = i - 1;
        }
    }

    /** Takes a free slot, stores `v` in it and returns its index, or -1 when the pool is full. */
    pub fn acquire(mut self, v : T) : i32 {
        if (self.spare.isEmpty()) {
            return -1;
        }
        let slot : i32 = self.spare.pop();
        self.items.set(slot, v);
        self.live.set(slot);
        self.used = self.used + 1;
        return slot;
    }

    /** Gives `slot` back. False when it was not live, so releasing twice is harmless. */
    pub fn release(mut self, slot : i32) : bool {
        if (!self.isLive(slot)) {
            return false;
        }
        self.live.unset(slot);
        self.spare.push(slot);
        self.used = self.used - 1;
        return true;
    }

    /** True when `slot` currently holds a value. */
    pub fn isLive(self, slot : i32) : bool {
        return slot >= 0 && slot < self.items.len() && self.live.has(slot);
    }

    /** The value in `slot`; aborts when the slot is out of range, so ask `isLive` first. */
    pub fn get(self, slot : i32) : T {
        return self.items.get(slot);
    }

    /** Overwrites the value in `slot`. */
    pub fn put(mut self, slot : i32, v : T) : void {
        self.items.set(slot, v);
    }

    /** The first live slot, or -1 when none is live. */
    pub fn first(self) : i32 {
        return self.live.nextSet(0);
    }

    /** The first live slot after `slot`, or -1 at the end; walk with `first` and `next`. */
    pub fn next(self, slot : i32) : i32 {
        return self.live.nextSet(slot + 1);
    }

    /** How many slots are live. */
    pub fn count(self) : i32 {
        return self.used;
    }

    /** How many slots the pool has in all. */
    pub fn capacity(self) : i32 {
        return self.items.len();
    }

    /** Releases every slot. */
    pub fn clear(mut self) : void {
        self.live.clearAll();
        self.used = 0;
        self.refill();
    }
}

// factory — builds the entities the game spawns, with their stats, components and starting motion.
//
// The stats of every kind live here and nowhere else: how big a medium rock is, how many hit points a gunship
// has, which components a drone carries. The world only stores what the factory hands it.

use ludax::{EntityId, Vec2, sin, cos, TAU};

use crate::core::config::{
    ROCK_RADIUS_LARGE, ROCK_RADIUS_MEDIUM, ROCK_RADIUS_SMALL, ROCK_SPEED, DRONE_RADIUS,
    GUNSHIP_RADIUS, GUNSHIP_HP, GUNSHIP_RELOAD, PICKUP_RADIUS, PICKUP_TTL, FIELD_W, FIELD_H
};
use crate::core::types::{Entity, Brain, Kind, Power};
use crate::sim::world::World;

/** How far outside the field new arrivals appear. */
const SPAWN_MARGIN : f32 = 48.0;

/** Speed of a pick-up drifting about, pixels per second. */
const PICKUP_DRIFT : f32 = 28.0;

/** Speed of a large rock relative to `ROCK_SPEED`. */
const ROCK_SPEED_BASE : f32 = 1.0;

/** Extra speed per tier smaller, relative to `ROCK_SPEED`. */
const ROCK_SPEED_GAIN : f32 = 0.45;

/** Slowest random factor applied to a new rock's speed. */
const ROCK_SPEED_MIN : f32 = 0.7;

/** Fastest random factor applied to a new rock's speed. */
const ROCK_SPEED_MAX : f32 = 1.3;

/** Spin of a rock as a multiple of its drift speed. */
const ROCK_SPIN : f32 = 0.02;

/** Creates entities in a world. */
pub class Factory {
    /** The collision radius of a rock of `tier` (3 large, 2 medium, 1 small). */
    pub static fn rockRadius(tier : i32) : f32 {
        return match tier {
            3 => ROCK_RADIUS_LARGE,
            2 => ROCK_RADIUS_MEDIUM,
            _ => ROCK_RADIUS_SMALL,
        };
    }

    /** A random point just outside the field, on a random side. */
    pub static fn edgePoint(w : World) : Vec2 {
        let side : i32 = w.rng.range(0, 4);
        let along : f32 = w.rng.nextF32();
        return match side {
            0 => Vec2::make(along * FIELD_W, -SPAWN_MARGIN),
            1 => Vec2::make(FIELD_W + SPAWN_MARGIN, along * FIELD_H),
            2 => Vec2::make(along * FIELD_W, FIELD_H + SPAWN_MARGIN),
            _ => Vec2::make(-SPAWN_MARGIN, along * FIELD_H),
        };
    }

    /** A rock of `tier` at (`x`, `y`) moving at (`vx`, `vy`). */
    pub static fn rock(w : World, x : f32, y : f32, vx : f32, vy : f32, tier : i32) : EntityId {
        return w.add(Entity {
            kind: Kind::Rock,
            x: x,
            y: y,
            vx: vx,
            vy: vy,
            radius: Factory::rockRadius(tier),
            hp: tier,
            tier: tier,
            angle: w.rng.rangeF32(0.0, TAU),
            spin: w.rng.rangeF32(-1.0, 1.0) * ROCK_SPEED * ROCK_SPIN,
            seed: w.rng.range(0, 1000000),
        });
    }

    /** The typical drift speed of a rock of `tier`: smaller rocks are quicker. */
    pub static fn rockSpeed(tier : i32) : f32 {
        return ROCK_SPEED * (ROCK_SPEED_BASE + ROCK_SPEED_GAIN * ((3 - tier) as f32));
    }

    /** A rock of `tier` drifting in a random direction at a speed that suits its size. */
    pub static fn driftingRock(w : World, x : f32, y : f32, tier : i32) : EntityId {
        let angle : f32 = w.rng.rangeF32(0.0, TAU);
        let speed : f32 = Factory::rockSpeed(tier) * w.rng.rangeF32(ROCK_SPEED_MIN, ROCK_SPEED_MAX);
        return Factory::rock(w, x, y, cos(angle) * speed, sin(angle) * speed, tier);
    }

    /** A drone at (`x`, `y`). */
    pub static fn drone(w : World, x : f32, y : f32) : EntityId {
        let id : EntityId = w.add(Entity {
            kind: Kind::Drone,
            x: x,
            y: y,
            radius: DRONE_RADIUS,
            hp: 1,
        });
        w.brains.insert(id.index, Brain { reload: 0, orbit: 1.0, phase: w.rng.rangeF32(0.0, TAU) });
        return id;
    }

    /** A gunship at (`x`, `y`). */
    pub static fn gunship(w : World, x : f32, y : f32) : EntityId {
        let id : EntityId = w.add(Entity {
            kind: Kind::Gunship,
            x: x,
            y: y,
            radius: GUNSHIP_RADIUS,
            hp: GUNSHIP_HP,
        });
        let mut orbit : f32 = 1.0;
        if (w.rng.nextBool()) {
            orbit = -1.0;
        }
        // Half a reload of grace, so a gunship does not fire the moment it enters.
        w.brains.insert(id.index, Brain { reload: GUNSHIP_RELOAD / 2, orbit: orbit, phase: 0.0 });
        return id;
    }

    /** A pick-up of `power` at (`x`, `y`), drifting slowly and expiring if left alone. */
    pub static fn pickup(w : World, x : f32, y : f32, power : Power) : EntityId {
        let angle : f32 = w.rng.rangeF32(0.0, TAU);
        let id : EntityId = w.add(Entity {
            kind: Kind::Pickup,
            x: x,
            y: y,
            vx: cos(angle) * PICKUP_DRIFT,
            vy: sin(angle) * PICKUP_DRIFT,
            radius: PICKUP_RADIUS,
            hp: 1,
            tier: power as i32,
        });
        // The lifetime is a component because it is the only thing that expires a pick-up.
        w.lifetimes.insert(id.index, PICKUP_TTL);
        return id;
    }

    /** The power-up with number `n` (the inverse of `power as i32`). */
    pub static fn powerOf(n : i32) : Power {
        return match n {
            0 => Power::Shield,
            1 => Power::Rapid,
            2 => Power::Spread,
            _ => Power::Nova,
        };
    }
}

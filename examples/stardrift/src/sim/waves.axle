// waves — decides what arrives, when, and when the field is clear.
//
// A wave is a plan: a list of arrivals, each with a tick on which it enters, queued in the director. Wave `n`
// brings more and bigger rocks every time, drones from wave 2 in packs that grow, and gunships from wave 3.
// When every arrival has entered and the last enemy is gone, the system pays a bonus and rests before the
// next wave. On the title screen it only keeps a few rocks drifting behind the logo.

use ludax::Vec2;

use crate::core::config::{
    WAVE_PAUSE_TICKS, ENTITY_SOFT_CAP, SCORE_WAVE_BONUS, FIELD_W, FIELD_H, HALF
};
use crate::core::types::{Spawn, Kind, Sfx};
use crate::sim::director::Phase;
use crate::sim::factory::Factory;
use crate::sim::world::World;

/** Ticks between the arrivals of a pack of drones. */
const PACK_GAP : i32 = 8;

/** Ticks between the first arrival of one pack and the next. */
const PACK_SPACING : i32 = 210;

/** Ticks before the first drone pack arrives. */
const PACK_DELAY : i32 = 90;

/** Ticks before the first gunship arrives. */
const GUNSHIP_DELAY : i32 = 260;

/** Ticks between the arrivals of gunships. */
const GUNSHIP_SPACING : i32 = 150;

/** Ticks between the arrivals of rocks. */
const ROCK_GAP : i32 = 14;

/** Scatter of a pack's members around its entry point, in pixels. */
const PACK_SCATTER : f32 = 20.0;

/** Ticks the "wave" banner stays up. */
const BANNER_TICKS : i32 = 120;

/** Rocks in the title screen's backdrop. */
const ATTRACT_ROCKS : i32 = 7;

/** Ticks between the checks that keep the title backdrop populated. */
const ATTRACT_PERIOD : i32 = 45;

/** Rocks in wave one, and the most any wave brings. */
const WAVE_ROCKS_BASE : i32 = 3;
const WAVE_ROCKS_MAX : i32 = 10;

/** Drone packs in the second wave, the most any wave brings, and the first pack's size. */
const WAVE_PACKS_BASE : i32 = 1;
const WAVE_PACKS_MAX : i32 = 4;
const WAVE_PACK_SIZE_BASE : i32 = 2;
const WAVE_PACK_SIZE_MAX : i32 = 6;

/** Most gunships a wave brings. */
const WAVE_GUNSHIPS_MAX : i32 = 4;

/** Tier of the rocks the director and the title backdrop spawn. */
const WAVE_ROCK_TIER : i32 = 3;

/** The wave system. */
pub class Waves {
    /** One tick of the director. */
    pub static fn update(w : World) : void {
        let mut d = w.director;
        if (d.banner > 0) {
            d.banner = d.banner - 1;
        }
        if (w.attract) {
            Waves::keepBackdrop(w);
            return;
        }
        if (w.ship.lives <= 0 && !w.ship.alive) {
            return;
        }
        match d.phase {
            Phase::Resting => Waves::rest(w),
            Phase::Fighting => Waves::fight(w),
        }
    }

    /** Scatters the title screen's rocks over the field, so the backdrop is populated at once. */
    pub static fn seedBackdrop(w : World) : void {
        for (i of 0..ATTRACT_ROCKS) {
            let x : f32 = w.rng.rangeF32(0.0, FIELD_W);
            let y : f32 = w.rng.rangeF32(0.0, FIELD_H);
            Factory::driftingRock(w, x, y, WAVE_ROCK_TIER - w.rng.range(0, 3));
        }
    }

    // Keeps a handful of rocks drifting behind the title.
    static fn keepBackdrop(w : World) : void {
        let mut d = w.director;
        d.clock = d.clock - 1;
        if (d.clock > 0) {
            return;
        }
        d.clock = ATTRACT_PERIOD;
        if (w.enemyCount() < ATTRACT_ROCKS) {
            let p : Vec2 = Factory::edgePoint(w);
            Factory::driftingRock(w, p.x, p.y, WAVE_ROCK_TIER - w.rng.range(0, 3));
        }
    }

    static fn rest(w : World) : void {
        let mut d = w.director;
        d.clock = d.clock - 1;
        if (d.clock <= 0) {
            Waves::begin(w);
        }
    }

    // Starts the next wave: plans it and shows the banner.
    static fn begin(w : World) : void {
        let mut d = w.director;
        d.wave = d.wave + 1;
        d.phase = Phase::Fighting;
        d.clock = 0;
        d.banner = BANNER_TICKS;
        Waves::plan(w);
        w.sound(Sfx::Wave);
        w.tm.log.info("wave", "wave ${d.wave} begins, ${d.pending()} arrivals");
    }

    // Puts the arrivals of the current wave into the queue, each with the tick it enters on.
    static fn plan(w : World) : void {
        let mut d = w.director;
        let n : i32 = d.wave;
        let rocks : i32 = Waves::capped(WAVE_ROCKS_BASE + n, WAVE_ROCKS_MAX);
        for (i of 0..rocks) {
            d.schedule(Kind::Rock, Factory::edgePoint(w), i * ROCK_GAP);
        }

        if (n >= 2) {
            let packs : i32 = Waves::capped(WAVE_PACKS_BASE + (n - 1) / 2, WAVE_PACKS_MAX);
            let size : i32 = Waves::capped(WAVE_PACK_SIZE_BASE + n / 2, WAVE_PACK_SIZE_MAX);
            for (g of 0..packs) {
                let entry : Vec2 = Factory::edgePoint(w);
                for (i of 0..size) {
                    let scatter : Vec2 = Vec2::make(
                        w.rng.rangeF32(-PACK_SCATTER, PACK_SCATTER),
                        w.rng.rangeF32(-PACK_SCATTER, PACK_SCATTER)
                    );
                    let delay : i32 = PACK_DELAY + g * PACK_SPACING + i * PACK_GAP;
                    d.schedule(Kind::Drone, entry.plus(scatter), delay);
                }
            }
        }
        if (n >= 3) {
            let ships : i32 = Waves::capped((n - 1) / 2, WAVE_GUNSHIPS_MAX);
            for (i of 0..ships) {
                d.schedule(
                    Kind::Gunship,
                    Factory::edgePoint(w),
                    GUNSHIP_DELAY + i * GUNSHIP_SPACING
                );
            }
        }
    }

    static fn capped(value : i32, limit : i32) : i32 {
        if (value > limit) {
            return limit;
        }
        return value;
    }

    // Lets arrivals in as their time comes, and ends the wave once the field is clear.
    static fn fight(w : World) : void {
        let mut d = w.director;
        d.clock = d.clock + 1;
        while (d.hasDue() && w.enemyCount() < ENTITY_SOFT_CAP) {
            Waves::enter(w, d.takeNext());
        }
        if (d.pending() == 0 && w.enemyCount() == 0) {
            Waves::finish(w);
        }
    }

    static fn enter(w : World, s : Spawn) : void {
        match s.kind {
            Kind::Drone => Factory::drone(w, s.x, s.y),
            Kind::Gunship => Factory::gunship(w, s.x, s.y),
            _ => Factory::driftingRock(w, s.x, s.y, WAVE_ROCK_TIER),
        }
    }

    // Pays the bonus and starts the rest before the next wave.
    static fn finish(w : World) : void {
        let mut d = w.director;
        let bonus : i32 = SCORE_WAVE_BONUS * d.wave;
        w.score.bonus(bonus);
        w.fx.popup(FIELD_W * HALF, FIELD_H * HALF, bonus, 1);
        w.tm.log.info("wave", "wave ${d.wave} cleared, bonus ${bonus}");
        d.phase = Phase::Resting;
        d.clock = WAVE_PAUSE_TICKS;
    }
}

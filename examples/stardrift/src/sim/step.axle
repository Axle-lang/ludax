// step — runs one fixed tick of the simulation: the systems, in order.
//
// The order is part of the game's behaviour and of its determinism: the ship moves first, then the director
// lets arrivals in, enemies act, bullets fly, the grid is rebuilt and collisions resolved against the
// positions of this very tick, and finally the effects, score timers and stars advance. Each stage is timed
// by the profiler. The world only holds state; everything that changes it is a system called from here.

use crate::app::telemetry::{
    SCOPE_SIM, SCOPE_SHIP, SCOPE_WAVES, SCOPE_ENEMIES, SCOPE_SHOTS, SCOPE_COLLIDE, SCOPE_FX
};
use crate::core::types::Input;
use crate::sim::collide::Collide;
use crate::sim::enemies::Enemies;
use crate::sim::pilot::Pilot;
use crate::sim::shots::Shots;
use crate::sim::waves::Waves;
use crate::sim::world::World;

/** The simulation driver. */
pub class Step {
    /** Advances `w` by one tick with the player's `input`. */
    pub static fn tick(w : World, input : Input) : void {
        let tm = w.tm;
        let whole : i32 = tm.begin(SCOPE_SIM);
        w.sounds.clear();
        tm.log.setFrame(w.tickCount);

        let ship : i32 = tm.begin(SCOPE_SHIP);
        Pilot::update(w, input);
        tm.end(ship);

        let waves : i32 = tm.begin(SCOPE_WAVES);
        Waves::update(w);
        tm.end(waves);

        let enemies : i32 = tm.begin(SCOPE_ENEMIES);
        Enemies::update(w);
        tm.end(enemies);

        let shots : i32 = tm.begin(SCOPE_SHOTS);
        Shots::update(w);
        tm.end(shots);

        let collide : i32 = tm.begin(SCOPE_COLLIDE);
        Collide::run(w);
        tm.end(collide);

        let fx : i32 = tm.begin(SCOPE_FX);
        w.score.update();
        w.fx.update();
        w.stars.update(w.ship.vx, w.ship.vy);
        tm.end(fx);

        w.finishTick();
        tm.end(whole);
    }
}

// ship — the player's ship: its state.
//
// The ship is a single object with identity and changing state, so it is a class held by the world rather
// than an entity in the slab. Timed power-ups are plain countdowns in ticks. How the ship is flown is the
// business of `pilot`, which keeps this file free of the world and so free of an import cycle.

use ludax::{sin, cos, sqrt, HALF_PI};

use crate::core::config::{
    FIELD_W, FIELD_H, START_LIVES, FIRE_COOLDOWN, FIRE_COOLDOWN_RAPID, HALF, INVULN_TICKS
};

/** The player's ship. */
pub class Ship {
    /** Horizontal position of the centre. */
    pub x : f32 = 0.0;

    /** Vertical position of the centre. */
    pub y : f32 = 0.0;

    /** Horizontal velocity in pixels per second. */
    pub vx : f32 = 0.0;

    /** Vertical velocity in pixels per second. */
    pub vy : f32 = 0.0;

    /** Heading in radians; 0 points right, so straight up is -pi/2. */
    pub angle : f32 = 0.0;

    /** True while the ship is flying; false while waiting to respawn or after the last life. */
    pub alive : bool = false;

    /** Lives left, counting the one in play. */
    pub lives : i32 = 0;

    /** Ticks until the next shot may leave. */
    pub cooldown : i32 = 0;

    /** Ticks of invulnerability left. */
    pub invuln : i32 = 0;

    /** Ticks of shield left. */
    pub shield : i32 = 0;

    /** Ticks of rapid fire left. */
    pub rapid : i32 = 0;

    /** Ticks of spread shot left. */
    pub spread : i32 = 0;

    /** Ticks until the ship returns after a death. */
    pub respawn : i32 = 0;

    /** True on ticks when the engine fired, for the flame. */
    pub thrusting : bool = false;

    /** A ship that is not in play yet. */
    constructor() {}

    /** Puts the ship at the centre of the field with full lives. */
    pub fn start(mut self) : void {
        self.lives = START_LIVES;
        self.shield = 0;
        self.rapid = 0;
        self.spread = 0;
        self.place();
    }

    /** Puts the ship, stopped and invulnerable, at the centre of the field. */
    pub fn place(mut self) : void {
        self.x = FIELD_W * HALF;
        self.y = FIELD_H * HALF;
        self.vx = 0.0;
        self.vy = 0.0;
        self.angle = -HALF_PI;
        self.alive = true;
        self.cooldown = 0;
        self.invuln = INVULN_TICKS;
        self.respawn = 0;
    }

    /** Horizontal component of the unit vector the nose points along. */
    pub fn dirX(self) : f32 {
        return cos(self.angle);
    }

    /** Vertical component of the unit vector the nose points along. */
    pub fn dirY(self) : f32 {
        return sin(self.angle);
    }

    /** Speed in pixels per second. */
    pub fn speed(self) : f32 {
        return sqrt(self.vx * self.vx + self.vy * self.vy);
    }

    /** Ticks between shots with the power-ups currently on. */
    pub fn fireInterval(self) : i32 {
        if (self.rapid > 0) {
            return FIRE_COOLDOWN_RAPID;
        }
        return FIRE_COOLDOWN;
    }
}

// pilot — flies the player's ship each tick.
//
// Steering, thrust against a little drag, the soft bounce off the edges of the field, the power-up timers,
// the respawn countdown and the trigger. The ship's state is in `ship`; this is the system that changes it.

use ludax::{sin, cos};

use crate::core::config::{
    SHIP_TURN, SHIP_THRUST, SHIP_DRAG, SHIP_MAX_SPEED, SHIP_BOUNCE, SHIP_RADIUS, FIELD_W, FIELD_H,
    DT, RESPAWN_TICKS
};
use crate::core::types::Input;
use crate::sim::ship::Ship;
use crate::sim::shots::Shots;
use crate::sim::world::World;

/** How many exhaust sparks leave the nozzle per tick of thrust. */
const EXHAUST_PER_TICK : i32 = 2;

/** Distance from the ship's centre to its nozzle. */
const NOZZLE : f32 = 13.0;

/** Exhaust speed relative to the ship, pixels per second. */
const EXHAUST_SPEED : f32 = 170.0;

/** Colour of the exhaust. */
const EXHAUST_COLOR : i32 = 0x6CC8FF;

/** Spread of an exhaust spark's direction, in radians. */
const EXHAUST_SPREAD : f32 = 0.35;

/** Ticks an exhaust spark lives. */
const EXHAUST_LIFE : i32 = 9;

/** Flies the ship. */
pub class Pilot {
    /** One tick of the ship: respawn, steering, thrust, motion, timers and firing. */
    pub static fn update(w : World, input : Input) : void {
        let mut s : Ship = w.ship;
        if (!s.alive) {
            Pilot::waitToRespawn(w);
            return;
        }
        if (input.left) {
            s.angle = s.angle - SHIP_TURN * DT;
        }
        if (input.right) {
            s.angle = s.angle + SHIP_TURN * DT;
        }

        s.thrusting = input.thrust;
        if (input.thrust) {
            s.vx = s.vx + s.dirX() * SHIP_THRUST * DT;
            s.vy = s.vy + s.dirY() * SHIP_THRUST * DT;
            Pilot::exhaust(w);
        }

        Pilot::move(s);
        Pilot::countdown(s);

        s.cooldown = s.cooldown - 1;
        if (input.fire && s.cooldown <= 0) {
            Shots::fireShip(w);
            s.cooldown = s.fireInterval();
        }
    }

    // Counts down to the return of a dead ship; with no lives left it stays dead.
    static fn waitToRespawn(w : World) : void {
        let mut s : Ship = w.ship;
        s.thrusting = false;
        if (s.lives > 0 && s.respawn > 0) {
            s.respawn = s.respawn - 1;
            if (s.respawn == 0) {
                s.place();
            }
        }
    }

    // Drag, speed limit, integration and the soft bounce off the walls.
    static fn move(s : Ship) : void {
        s.vx = s.vx * SHIP_DRAG;
        s.vy = s.vy * SHIP_DRAG;
        let speed : f32 = s.speed();
        if (speed > SHIP_MAX_SPEED) {
            let k : f32 = SHIP_MAX_SPEED / speed;
            s.vx = s.vx * k;
            s.vy = s.vy * k;
        }
        s.x = s.x + s.vx * DT;
        s.y = s.y + s.vy * DT;
        if (s.x < SHIP_RADIUS) {
            s.x = SHIP_RADIUS;
            s.vx = -s.vx * SHIP_BOUNCE;
        }
        if (s.x > FIELD_W - SHIP_RADIUS) {
            s.x = FIELD_W - SHIP_RADIUS;
            s.vx = -s.vx * SHIP_BOUNCE;
        }
        if (s.y < SHIP_RADIUS) {
            s.y = SHIP_RADIUS;
            s.vy = -s.vy * SHIP_BOUNCE;
        }
        if (s.y > FIELD_H - SHIP_RADIUS) {
            s.y = FIELD_H - SHIP_RADIUS;
            s.vy = -s.vy * SHIP_BOUNCE;
        }
    }

    // Runs the invulnerability and power-up timers down.
    static fn countdown(s : Ship) : void {
        if (s.invuln > 0) {
            s.invuln = s.invuln - 1;
        }
        if (s.shield > 0) {
            s.shield = s.shield - 1;
        }
        if (s.rapid > 0) {
            s.rapid = s.rapid - 1;
        }
        if (s.spread > 0) {
            s.spread = s.spread - 1;
        }
    }

    // Sparks thrown backwards from the nozzle.
    static fn exhaust(w : World) : void {
        let s : Ship = w.ship;
        let nx : f32 = s.x - s.dirX() * NOZZLE;
        let ny : f32 = s.y - s.dirY() * NOZZLE;
        for (i of 0..EXHAUST_PER_TICK) {
            let spread : f32 = w.fx.jitter(EXHAUST_SPREAD);
            let c : f32 = cos(s.angle + spread);
            let d : f32 = sin(s.angle + spread);
            w.fx.sparkAt(
                nx,
                ny,
                s.vx - c * EXHAUST_SPEED,
                s.vy - d * EXHAUST_SPEED,
                EXHAUST_COLOR,
                EXHAUST_LIFE
            );
        }
    }

    /** Ticks a dead ship waits before it returns. */
    pub static fn respawnDelay() : i32 {
        return RESPAWN_TICKS;
    }
}

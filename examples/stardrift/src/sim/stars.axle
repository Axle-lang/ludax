// stars — the parallax starfield behind the action.
//
// Three depth layers of stars drift down and sideways at different rates, and slide against the ship's
// velocity by an amount proportional to their depth, so a fast ship appears to move through space and the
// nearest stars streak past. The field is part of the simulation (it is seeded and stepped like everything
// else) but it is not collidable and is left out of the checksum.

use ludax::{Pcg32, Vec};

use crate::core::config::{FIELD_W, FIELD_H, DT};

/** Number of stars. */
const STAR_COUNT : i32 = 150;

/** Constant downward drift of the nearest layer in pixels per second. */
const STAR_DRIFT : f32 = 18.0;

/** How strongly the ship's velocity moves the nearest layer. */
const STAR_PARALLAX : f32 = 0.22;

/** Number of depth layers, as a float. */
const STAR_LAYERS : f32 = 3.0;

/** One star. */
pub struct Star {
    /** Horizontal position of the centre. */
    pub x : f32 = 0.0;

    /** Vertical position of the centre. */
    pub y : f32 = 0.0;

    /** 1 (far, dim, slow), 2 or 3 (near, bright, fast). */
    pub layer : i32 = 1;

    /** Phase of the twinkle. */
    pub phase : i32 = 0;
}

/** The starfield. */
pub class Starfield {
    /** The stars, in a fixed order. */
    pub stars : Vec<Star>;

    /** A field scattered with `seed`. */
    constructor(seed : u64) {
        self.stars = new Vec<Star>(STAR_COUNT);
        self.scatter(seed);
    }

    /** Scatters the stars afresh. */
    pub fn scatter(mut self, seed : u64) : void {
        let rng : Pcg32 = new Pcg32(seed, 5);
        self.stars.clear();
        for (i of 0..STAR_COUNT) {
            self.stars.push(Star {
                x: rng.rangeF32(0.0, FIELD_W),
                y: rng.rangeF32(0.0, FIELD_H),
                layer: 1 + rng.range(0, 3),
                phase: rng.range(0, 360),
            });
        }
    }

    /** Moves every star for one tick; (`shipVx`, `shipVy`) is the ship's velocity, 0 when there is none. */
    pub fn update(mut self, shipVx : f32, shipVy : f32) : void {
        for (i of 0..self.stars.len()) {
            let mut s : Star = self.stars.get(i);
            let depth : f32 = (s.layer as f32) / STAR_LAYERS;
            s.x = s.x - shipVx * STAR_PARALLAX * depth * DT;
            s.y = s.y + (STAR_DRIFT * depth - shipVy * STAR_PARALLAX * depth) * DT;
            s.x = Starfield::wrap(s.x, FIELD_W);
            s.y = Starfield::wrap(s.y, FIELD_H);
            self.stars.set(i, s);
        }
    }

    // Brings `v` back into 0..size.
    static fn wrap(v : f32, size : f32) : f32 {
        if (v < 0.0) {
            return v + size;
        }
        if (v >= size) {
            return v - size;
        }
        return v;
    }
}

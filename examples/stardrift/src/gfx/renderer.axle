// renderer — composes a frame: the field, then whatever the current screen puts over it.
//
// The renderer owns the typefaces and the debug overlay and nothing about the game itself; it is handed the
// frame to draw into and the `Game` to draw. The scene is drawn offset by the screen shake, the HUD and the
// menus are not.

use smalt::Frame;

use crate::app::game::{Game, Mode};
use crate::app::telemetry::{SCOPE_DRAW_WORLD, SCOPE_DRAW_HUD};
use crate::gfx::draw::Offset;
use crate::gfx::field::FieldView;
use crate::gfx::hud::Hud;
use crate::gfx::overlay::Overlay;
use crate::gfx::screens::Screens;
use crate::gfx::typeface::Typeface;

/** Draws the game. */
pub class Renderer {
    /** The face used by everything on screen. */
    pub kit : Typeface;

    /** The F3 panel. */
    pub overlay : Overlay;

    /** Whether the F3 panel is showing. */
    pub debug : bool = false;

    /** A renderer with the debug panel hidden. */
    constructor() {
        self.kit = new Typeface();
        self.overlay = new Overlay();
    }

    /** Releases the typeface's buffers. */
    pub fn close(self) : void {
        self.kit.close();
    }

    /** Draws `game` into `f`; `fps` is the measured frame rate for the debug panel. */
    pub fn draw(mut self, f : Frame, game : Game, fps : f64) : void {
        let w = game.world;
        let tm = w.tm;
        let scene : i32 = tm.begin(SCOPE_DRAW_WORLD);
        let shake : Offset = Offset { x: w.fx.shakeX as i32, y: w.fx.shakeY as i32 };
        FieldView::draw(f, w, self.kit, shake);
        tm.end(scene);

        let hud : i32 = tm.begin(SCOPE_DRAW_HUD);
        match game.mode {
            Mode::Title => Screens::title(f, self.kit, game.uiTicks, game.best),
            Mode::Playing => Hud::draw(f, w, self.kit, game.uiTicks, game.best),
            Mode::Paused => {
                Hud::draw(f, w, self.kit, game.uiTicks, game.best);
                Screens::paused(f, self.kit, game.uiTicks);
            },
            Mode::Over => {
                Hud::draw(f, w, self.kit, game.uiTicks, game.best);
                Screens::over(f, self.kit, w, game.uiTicks, game.best, game.newBest);
            },
        }
        if (self.debug) {
            self.overlay.draw(f, self.kit, w, fps);
        }
        tm.end(hud);
    }
}

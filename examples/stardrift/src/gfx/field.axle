// field — draws the playfield: backdrop, stars, entities, shots, particles, popups and the screen flash.
//
// Everything here reads the world and writes pixels; nothing changes the simulation. The scene is drawn with
// an offset (the screen shake) so that the HUD, drawn afterwards without it, stays still while the world
// trembles. What the individual things look like is in `hulls`; this file is the order they are painted in
// and the effects that are not hulls. Sparks and glows are additive, so overlapping fire adds up to white
// the way light does.

use smalt::{Frame, Rect, Color};

use crate::core::config::{VIEW_W, VIEW_H};
use crate::core::palette::{PAL_SKY_TOP, PAL_SKY_BOTTOM, PAL_SHOT, PAL_BOLT};
use crate::core::types::{Entity, Kind, Bullet, Particle, Popup};
use crate::gfx::draw::{Draw, Offset};
use crate::gfx::hulls::Hulls;
use crate::gfx::typeface::Typeface;
use crate::sim::stars::Star;
use crate::sim::world::World;

/** Base brightness of a star and the range its twinkle adds, in 0..255. */
const STAR_BASE : i32 = 160;
const STAR_TWINKLE : i32 = 90;

/** Blue lead of a star over its red and green, and the layer that is nearest and so streaks. */
const STAR_BLUE : i32 = 30;
const STAR_NEAREST : i32 = 3;

/** Scale of a fully opaque colour channel. */
const FIELD_ALPHA : i32 = 256;

/** Core colours of an enemy bolt and of a ship shot. */
const BOLT_CORE : i32 = 0xFFD0C0;
const SHOT_CORE : i32 = 0xFFFFFF;

/** Ship speed per streak pixel behind the nearest stars, and the velocity divisor of a streak's length. */
const STREAK_SPEED : i32 = 90;
const STREAK_SCALE : i32 = 300;

/** Colour of a score popup and of its multiplier. */
const POPUP_COLOR : i32 = 0xFFE9A0;
const POPUP_MULTIPLIER : i32 = 0xFF8A4A;

/** Velocity divisor that turns a shot's velocity into the length of its streak. */
const SHOT_STREAK : i32 = 28;

/** Strength of the full-screen flash, in percent at full flash. */
const FLASH_PERCENT : f32 = 100.0;

/** Drawing of the playfield. */
pub class FieldView {
    /** Paints the whole field. `shake` is the screen-shake offset. */
    pub static fn draw(f : Frame, w : World, kit : Typeface, shake : Offset) : void {
        FieldView::backdrop(f);
        FieldView::stars(f, w, shake);
        FieldView::entities(f, w, shake, kit);
        FieldView::bullets(f, w, shake);
        Hulls::ship(f, w.ship, w.tickCount as i32, shake);
        FieldView::particles(f, w, shake);
        FieldView::popups(f, w, shake, kit);
        FieldView::flash(f, w);
    }

    // A vertical gradient, one row at a time.
    static fn backdrop(f : Frame) : void {
        for (y of 0..VIEW_H) {
            f.hLine(0, y, VIEW_W, Color::mix(PAL_SKY_TOP, PAL_SKY_BOTTOM, y, VIEW_H));
        }
    }

    // Stars twinkle; the nearest layer stretches into streaks against the ship's velocity.
    static fn stars(f : Frame, w : World, shake : Offset) : void {
        let streak : i32 = (w.ship.speed() as i32) / STREAK_SPEED;
        for (i of 0..w.stars.stars.len()) {
            let s : Star = w.stars.stars.get(i);
            let twinkle : i32 = STAR_BASE + ((w.tickCount as i32 + s.phase * 7) % STAR_TWINKLE);
            let level : i32 = (twinkle * s.layer) / STAR_NEAREST;
            let color : i32 = Color::packBytes(level, level, Color::clamp8(level + STAR_BLUE));
            let x : i32 = (s.x as i32) + shake.x * s.layer / STAR_NEAREST;
            let y : i32 = (s.y as i32) + shake.y * s.layer / STAR_NEAREST;
            Draw::add(f, x, y, color);
            if (s.layer == STAR_NEAREST) {
                Draw::add(f, x + 1, y, color);
                Draw::add(f, x, y + 1, Color::scale(color, 1, 2));
                for (k of 1..streak + 1) {
                    let tx : i32 = x - (w.ship.vx as i32) * k / STREAK_SCALE;
                    let ty : i32 = y - (w.ship.vy as i32) * k / STREAK_SCALE;
                    Draw::add(f, tx, ty, Color::scale(color, 1, k + 1));
                }
            }
        }
    }

    // Rocks, drones, gunships and pick-ups, each by its own hull.
    static fn entities(f : Frame, w : World, shake : Offset, kit : Typeface) : void {
        for (slot of 0..w.entities.slotCount()) {
            if (w.entities.isLiveAt(slot)) {
                let e : Entity = w.entities.valueAt(slot);
                match e.kind {
                    Kind::Rock => Hulls::rock(f, e, shake),
                    Kind::Drone => Hulls::drone(f, e, shake),
                    Kind::Gunship => Hulls::gunship(f, e, shake),
                    Kind::Pickup => {
                        let left : i32 = w.lifetimes.getOr(w.entities.idAt(slot).index, 0);
                        Hulls::pickup(f, e, left, shake, kit);
                    },
                }
            }
        }
    }

    // Ship shots are short streaks, enemy bolts are glowing orbs.
    static fn bullets(f : Frame, w : World, shake : Offset) : void {
        let mut slot : i32 = w.bullets.first();
        while (slot >= 0) {
            let b : Bullet = w.bullets.get(slot);
            let x : i32 = (b.x as i32) + shake.x;
            let y : i32 = (b.y as i32) + shake.y;
            if (b.hostile) {
                Draw::glow(f, x, y, 13, PAL_BOLT, 90);
                f.disc(x, y, 3, BOLT_CORE);
            } else {
                let tx : i32 = x - (b.vx as i32) / SHOT_STREAK;
                let ty : i32 = y - (b.vy as i32) / SHOT_STREAK;
                Draw::glow(f, x, y, 9, PAL_SHOT, 50);
                Draw::lineAdd(f, tx, ty, x, y, PAL_SHOT);
                Draw::lineAdd(f, tx + 1, ty, x + 1, y, Color::scale(PAL_SHOT, 1, 2));
                f.disc(x, y, 1, SHOT_CORE);
            }
            slot = w.bullets.next(slot);
        }
    }

    // Sparks fade with age; rings expand and thin out.
    static fn particles(f : Frame, w : World, shake : Offset) : void {
        let pool = w.fx.field.pool;
        let mut slot : i32 = pool.first();
        while (slot >= 0) {
            let p : Particle = pool.get(slot);
            let k : i32 = (p.life * FIELD_ALPHA) / p.span;
            let color : i32 = Color::scale(p.color, k, FIELD_ALPHA);
            let x : i32 = (p.x as i32) + shake.x;
            let y : i32 = (p.y as i32) + shake.y;
            if (p.ring) {
                Draw::ringAdd(f, x, y, p.size as i32, color);
                Draw::ringAdd(f, x, y, (p.size as i32) + 1, Color::scale(color, 1, 2));
            } else {
                Draw::add(f, x, y, color);
                if (k > 128) {
                    let dim : i32 = Color::scale(color, 1, 2);
                    Draw::add(f, x + 1, y, dim);
                    Draw::add(f, x - 1, y, dim);
                    Draw::add(f, x, y + 1, dim);
                    Draw::add(f, x, y - 1, dim);
                }
            }
            slot = pool.next(slot);
        }
    }

    // Floating score numbers, fading out; a multiplier is shown after the points.
    static fn popups(f : Frame, w : World, shake : Offset, kit : Typeface) : void {
        let pool = w.fx.popups;
        let mut slot : i32 = pool.first();
        while (slot >= 0) {
            let p : Popup = pool.get(slot);
            let fade : i32 = p.life * 4 + 40;
            let x : i32 = (p.x as i32) + shake.x;
            let y : i32 = (p.y as i32) + shake.y;
            let ink : i32 = Color::scale(POPUP_COLOR, fade, FIELD_ALPHA);
            let pen : i32 = kit.prefixed(f, x - 14, y, "+", p.value as i64, 1, ink);
            if (p.multiplier > 1) {
                let tint : i32 = Color::scale(POPUP_MULTIPLIER, fade, FIELD_ALPHA);
                kit.prefixed(f, pen + 3, y, "x", p.multiplier as i64, 1, tint);
            }
            slot = pool.next(slot);
        }
    }

    // A white wash over the whole screen for big explosions.
    static fn flash(f : Frame, w : World) : void {
        if (w.fx.flash > 0.0) {
            let percent : i32 = (w.fx.flash * FLASH_PERCENT) as i32;
            f.shade(Rect::make(0, 0, VIEW_W, VIEW_H), 0xFFFFFF, percent, 255);
        }
    }
}

// screens — the title, pause and game-over screens drawn over the world.
//
// The world keeps running behind the title and the game-over screens, so they only add what belongs to them:
// a dimming of the field, big lettering and a few lines of text. The lettering is the UI face at an integer
// multiple of its size, with an additive glow under it that pulses with the menu clock.

use ludax::{sin, TAU};
use smalt::{Frame, Rect, Color};

use crate::core::config::{VIEW_W, VIEW_H};
use crate::core::palette::{
    PAL_TEXT, PAL_TEXT_DIM, PAL_ACCENT, PAL_SHIP_EDGE, PAL_DRONE_EDGE, PAL_GUNSHIP_EDGE,
    PAL_ROCK_EDGE, PAL_SHIELD, PAL_RAPID, PAL_SPREAD, PAL_NOVA
};
use crate::core::types::Kind;
use crate::gfx::draw::Draw;
use crate::gfx::typeface::Typeface;
use crate::sim::world::World;

/** Scale of the title lettering. */
const TITLE_SCALE : i32 = 8;

/** Distance from the start of a key's name to its description. */
const KEY_COLUMN : i32 = 120;

/** Period of the title's brightness pulse in ticks, and how far it swings, in 0..255 steps. */
const TITLE_PULSE_TICKS : f32 = 240.0;
const TITLE_PULSE_DEPTH : f32 = 55.0;

/** Ticks of one blink of the "press enter" line. */
const BLINK : i64 = 36;

/** The non-play screens. */
pub class Screens {
    // Darkens the field so that text reads over it.
    static fn dim(f : Frame, num : i32) : void {
        f.shade(Rect::make(0, 0, VIEW_W, VIEW_H), 0x02030A, num, 10);
    }

    // The word `s` in lettering of `scale`, in `ink`, over a halo, centred on `cx`.
    static fn heading(
        f : Frame,
        kit : Typeface,
        cx : i32,
        top : i32,
        s : string,
        scale : i32,
        ink : i32
    ) : void {
        let half : i32 = kit.width(s, scale) / 2;
        let mid : i32 = top + kit.height(scale) / 2;
        Draw::glow(f, cx - half / 2, mid, kit.height(scale), ink, 18);
        Draw::glow(f, cx + half / 2, mid, kit.height(scale), ink, 18);
        kit.centred(f, cx + scale, top + scale, s, scale, Color::scale(ink, 1, 4));
        kit.centred(f, cx, top, s, scale, ink);
    }

    // A blinking prompt line.
    static fn prompt(f : Frame, kit : Typeface, top : i32, s : string, uiTicks : i64) : void {
        if ((uiTicks / BLINK) % 2 == 0) {
            kit.centred(f, VIEW_W / 2, top, s, 2, PAL_TEXT);
        }
    }

    /** The title screen. */
    pub static fn title(f : Frame, kit : Typeface, uiTicks : i64, best : i32) : void {
        Screens::dim(f, 4);
        let phase : f32 = TAU * (uiTicks as f32) / TITLE_PULSE_TICKS;
        let pulse : i32 = 200 + ((sin(phase) * TITLE_PULSE_DEPTH) as i32);
        let ink : i32 = Color::scale(PAL_SHIP_EDGE, pulse, 255);
        Screens::heading(f, kit, VIEW_W / 2, 120, "STARDRIFT", TITLE_SCALE, ink);
        kit.centred(f, VIEW_W / 2, 250, "DRIFT. SHOOT. SURVIVE THE WAVES.", 2, PAL_TEXT_DIM);
        Screens::prompt(f, kit, 320, "PRESS ENTER TO LAUNCH", uiTicks);
        Screens::controls(f, kit, 400);
        if (best > 0) {
            kit.centred(f, VIEW_W / 2 - 30, 556, "BEST", 1, PAL_TEXT_DIM);
            kit.number(f, VIEW_W / 2 + 4, 556, best as i64, 1, PAL_ACCENT);
        }
    }

    // One line of a two-column table: the key or label in `ink`, then its meaning in the normal colour.
    static fn row(
        f : Frame,
        kit : Typeface,
        x : i32,
        top : i32,
        key : string,
        meaning : string,
        ink : i32
    ) : void {
        kit.text(f, x, top, key, 1, ink);
        kit.text(f, x + KEY_COLUMN, top, meaning, 1, PAL_TEXT);
    }

    // Two columns: the keys, and what the pick-ups do.
    static fn controls(f : Frame, kit : Typeface, top : i32) : void {
        let left : i32 = VIEW_W / 2 - 320;
        let right : i32 = VIEW_W / 2 + 30;
        kit.text(f, left, top, "CONTROLS", 1, PAL_ACCENT);
        Screens::row(f, kit, left, top + 22, "LEFT / RIGHT", "turn (or A / D)", PAL_TEXT_DIM);
        Screens::row(f, kit, left, top + 40, "UP", "thrust (or W)", PAL_TEXT_DIM);
        Screens::row(f, kit, left, top + 58, "SPACE", "fire (or Z)", PAL_TEXT_DIM);
        Screens::row(f, kit, left, top + 76, "P", "pause", PAL_TEXT_DIM);
        Screens::row(
            f,
            kit,
            left,
            top + 94,
            "F3 / M / F12",
            "debug / sound / screenshot",
            PAL_TEXT_DIM
        );
        Screens::row(f, kit, left, top + 112, "ESC", "quit", PAL_TEXT_DIM);
        kit.text(f, right, top, "POWER-UPS", 1, PAL_ACCENT);
        Screens::row(f, kit, right, top + 22, "S  shield", "absorbs one hit", PAL_SHIELD);
        Screens::row(f, kit, right, top + 40, "R  rapid fire", "twice the rate", PAL_RAPID);
        Screens::row(f, kit, right, top + 58, "W  spread shot", "three at once", PAL_SPREAD);
        Screens::row(f, kit, right, top + 76, "N  nova", "blast around you", PAL_NOVA);
        Screens::row(
            f,
            kit,
            right,
            top + 94,
            "CHAIN",
            "kills in a row raise the multiplier",
            PAL_ACCENT
        );
    }

    /** The pause screen. */
    pub static fn paused(f : Frame, kit : Typeface, uiTicks : i64) : void {
        Screens::dim(f, 6);
        Screens::heading(f, kit, VIEW_W / 2, 200, "PAUSED", 6, PAL_TEXT);
        Screens::prompt(f, kit, 290, "PRESS P TO RESUME", uiTicks);
        Screens::controls(f, kit, 380);
    }

    /** The game-over screen with the result of the run. */
    pub static fn over(
        f : Frame,
        kit : Typeface,
        w : World,
        uiTicks : i64,
        best : i32,
        newBest : bool
    ) : void {
        Screens::dim(f, 6);
        Screens::heading(f, kit, VIEW_W / 2, 84, "GAME OVER", 7, PAL_DRONE_EDGE);
        kit.centred(f, VIEW_W / 2, 190, "SCORE", 1, PAL_TEXT_DIM);
        kit.numberCentred(f, VIEW_W / 2, 208, w.score.points as i64, 4, PAL_TEXT);
        if (newBest) {
            kit.centred(f, VIEW_W / 2, 262, "NEW BEST!", 2, PAL_ACCENT);
        } else {
            kit.prefixed(f, VIEW_W / 2 - 50, 266, "BEST ", best as i64, 1, PAL_TEXT_DIM);
        }
        Screens::stats(f, kit, w);
        Screens::prompt(f, kit, 500, "PRESS ENTER TO PLAY AGAIN", uiTicks);
    }

    // One statistic: a label and its number in a column of their own.
    static fn stat(
        f : Frame,
        kit : Typeface,
        top : i32,
        label : string,
        value : i32,
        ink : i32
    ) : void {
        let x : i32 = VIEW_W / 2 - 140;
        kit.text(f, x, top, label, 1, ink);
        kit.numberRight(f, x + 280, top, value as i64, 1, PAL_TEXT);
    }

    // Wave reached, longest chain and what was destroyed.
    static fn stats(f : Frame, kit : Typeface, w : World) : void {
        Screens::stat(f, kit, 318, "Wave reached", w.director.wave, PAL_TEXT_DIM);
        Screens::stat(f, kit, 338, "Longest chain", w.score.bestChain, PAL_TEXT_DIM);
        Screens::stat(
            f,
            kit,
            366,
            "Rocks destroyed",
            w.tally.getOr(Kind::Rock as i32, 0),
            PAL_ROCK_EDGE
        );
        Screens::stat(
            f,
            kit,
            386,
            "Drones destroyed",
            w.tally.getOr(Kind::Drone as i32, 0),
            PAL_DRONE_EDGE
        );
        let gunships : i32 = w.tally.getOr(Kind::Gunship as i32, 0);
        Screens::stat(f, kit, 406, "Gunships destroyed", gunships, PAL_GUNSHIP_EDGE);
    }
}

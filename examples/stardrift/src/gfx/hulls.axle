// hulls — what each thing in the slab looks like: rocks, drones, gunships, pick-ups and the ship.
//
// Vector style: a dark fill with a bright edge and, for the ships, an additive glow. A rock is a ring of
// vertices whose distance from the centre comes from a hash of the rock's seed, so every rock keeps its own
// outline however it spins; its facets are shaded by how far they face the light. Ships are arrowheads or
// hexagons built from triangles and lines.

use ludax::{sin, cos, mixI64, TAU, HALF_PI};
use smalt::{Frame, Rect, Color};

use crate::core::config::HALF;
use crate::core::palette::{
    PAL_ROCK_FILL, PAL_ROCK_EDGE, PAL_SHIP_FILL, PAL_SHIP_EDGE, PAL_DRONE_FILL, PAL_DRONE_EDGE,
    PAL_GUNSHIP_FILL, PAL_GUNSHIP_EDGE, PAL_SHIELD, PAL_RAPID, PAL_SPREAD, PAL_NOVA
};
use crate::core::types::Entity;
use crate::gfx::draw::{Draw, Offset};
use crate::gfx::typeface::Typeface;
use crate::sim::ship::Ship;

/** Direction the light comes from (up and to the left). */
const LIGHT_ANGLE : f32 = -2.4;

/** How far a facet turned towards the light brightens. */
const LIGHT_RANGE : f32 = 160.0;

/** Brightness a facet has when it faces away from the light, in 0..255. */
const LIGHT_BASE : i32 = 95;

/** Converts a percentage to a factor. */
const PERCENT : f32 = 0.01;

/** Vertices of a rock's outline. */
const ROCK_SIDES : i32 = 11;

/** Smallest share of its radius a rock's vertex reaches, in percent. */
const ROCK_ROUGH_MIN : i32 = 74;

/** Fill of a rock that was just hit. */
const ROCK_HIT_FILL : i32 = 0x6A7090;

/** Edge colour of anything that was just hit. */
const HIT_EDGE : i32 = 0xFFFFFF;

/** Length of a drone's drawn hull as a multiple of its radius. */
const DRONE_LENGTH : f32 = 1.5;

/** How far an arrowhead's wing tips sit behind its centre, as a share of its length. */
const WING_BACK : f32 = 0.7;

/** How far an arrowhead's tail notch sits behind its centre, as a share of its length. */
const NOTCH_BACK : f32 = 0.35;

/** Sides of a gunship's hull. */
const GUNSHIP_SIDES : i32 = 6;

/** Length of a gunship's barrel as a multiple of its radius. */
const BARREL_LENGTH : f32 = 1.9;

/** Colour of a gunship's core. */
const CORE_COLOR : i32 = 0xFFC090;

/** Fill of a gunship that was just hit. */
const GUNSHIP_HIT_FILL : i32 = 0x805040;

/** Length of the ship's drawn hull, a little larger than its collision circle. */
const SHIP_DRAW_LENGTH : f32 = 21.0;

/** Half-width of the ship's drawn hull. */
const SHIP_DRAW_WIDTH : f32 = 13.0;

/** Distance behind the ship where the engine glow sits. */
const ENGINE_OFFSET : f32 = 12.0;

/** Colour of the engine glow. */
const ENGINE_COLOR : i32 = 0xFF9A40;

/** Ticks before expiry when a pick-up starts to blink. */
const PICKUP_BLINK : i32 = 150;

/** Ticks of shield left when the bubble starts to flicker. */
const SHIELD_WARNING : i32 = 120;

/** Drawing of the things in the slab and of the ship. */
pub class Hulls {
    // The vertex `i` of rock `e`: its angle follows the rock's spin, its reach comes from a hash of the seed.
    static fn rockVertex(e : Entity, i : i32) : (x: i32, y: i32) {
        let hash : i32 = (mixI64((e.seed as i64) * 64 + (i as i64)) & 0xFFFF) as i32;
        let rough : i32 = ROCK_ROUGH_MIN + hash % (100 - ROCK_ROUGH_MIN);
        let reach : f32 = e.radius * (rough as f32) * PERCENT;
        let angle : f32 = e.angle + TAU * (i as f32) / (ROCK_SIDES as f32);
        return ((e.x + cos(angle) * reach) as i32, (e.y + sin(angle) * reach) as i32);
    }

    /** A faceted rock lit from the upper left: each facet brightens as it turns towards the light. */
    pub static fn rock(f : Frame, e : Entity, at : Offset) : void {
        let cx : i32 = (e.x as i32) + at.x;
        let cy : i32 = (e.y as i32) + at.y;
        let first = Hulls::rockVertex(e, 0);
        let mut px : i32 = first.x + at.x;
        let mut py : i32 = first.y + at.y;

        for (i of 1..ROCK_SIDES + 1) {
            let v = Hulls::rockVertex(e, i % ROCK_SIDES);
            let vx : i32 = v.x + at.x;
            let vy : i32 = v.y + at.y;
            let facing : f32 = e.angle + TAU * ((i as f32) - HALF) / (ROCK_SIDES as f32);
            let light : i32 = ((cos(facing - LIGHT_ANGLE) * LIGHT_RANGE) as i32).max(0);
            let mut fill : i32 = Color::scale(PAL_ROCK_FILL, 100 + light / 2, 100);
            let mut edge : i32 = Color::scale(PAL_ROCK_EDGE, LIGHT_BASE + light, 255);
            if (e.flash > 0) {
                fill = ROCK_HIT_FILL;
                edge = HIT_EDGE;
            }
            Draw::triangle(f, cx, cy, px, py, vx, vy, fill);
            Draw::line(f, px, py, vx, vy, edge);
            px = vx;
            py = vy;
        }
    }

    /** A drone: a small magenta arrowhead with a glow. */
    pub static fn drone(f : Frame, e : Entity, at : Offset) : void {
        let cx : i32 = (e.x as i32) + at.x;
        let cy : i32 = (e.y as i32) + at.y;
        Draw::glow(f, cx, cy, 20, PAL_DRONE_EDGE, 30);
        let length : f32 = e.radius * DRONE_LENGTH;
        Hulls::arrow(
            f,
            cx,
            cy,
            e.angle,
            length,
            e.radius,
            PAL_DRONE_FILL,
            PAL_DRONE_EDGE,
            e.flash > 0
        );
    }

    /** A gunship: a hexagon with a barrel pointing at its target, a core and one pip per hit point left. */
    pub static fn gunship(f : Frame, e : Entity, at : Offset) : void {
        let cx : i32 = (e.x as i32) + at.x;
        let cy : i32 = (e.y as i32) + at.y;
        Draw::glow(f, cx, cy, 34, PAL_GUNSHIP_EDGE, 28);
        let mut edge : i32 = PAL_GUNSHIP_EDGE;
        let mut fill : i32 = PAL_GUNSHIP_FILL;
        if (e.flash > 0) {
            edge = HIT_EDGE;
            fill = GUNSHIP_HIT_FILL;
        }
        let mut px : i32 = cx + (cos(e.angle) * e.radius) as i32;
        let mut py : i32 = cy + (sin(e.angle) * e.radius) as i32;
        for (i of 1..GUNSHIP_SIDES + 1) {
            let a : f32 = e.angle + TAU * (i as f32) / (GUNSHIP_SIDES as f32);
            let vx : i32 = cx + (cos(a) * e.radius) as i32;
            let vy : i32 = cy + (sin(a) * e.radius) as i32;
            Draw::triangle(f, cx, cy, px, py, vx, vy, fill);
            Draw::line(f, px, py, vx, vy, edge);
            px = vx;
            py = vy;
        }
        let bx : i32 = cx + (cos(e.angle) * e.radius * BARREL_LENGTH) as i32;
        let by : i32 = cy + (sin(e.angle) * e.radius * BARREL_LENGTH) as i32;
        Draw::line(f, cx, cy, bx, by, edge);
        f.disc(cx, cy, 4, CORE_COLOR);
        for (pip of 0..e.hp) {
            f.fillRect(Rect::make(cx - 8 + pip * 5, cy + (e.radius as i32) + 6, 4, 3), edge);
        }
    }

    // A filled arrowhead: nose ahead, two wing tips behind, a notch in the tail.
    static fn arrow(
        f : Frame,
        cx : i32,
        cy : i32,
        angle : f32,
        length : f32,
        width : f32,
        fill : i32,
        edge : i32,
        hot : bool
    ) : void {
        let c : f32 = cos(angle);
        let s : f32 = sin(angle);
        let back : f32 = length * WING_BACK;
        let nx : i32 = cx + (c * length) as i32;
        let ny : i32 = cy + (s * length) as i32;
        let lx : i32 = cx + (-c * back - s * width) as i32;
        let ly : i32 = cy + (-s * back + c * width) as i32;
        let rx : i32 = cx + (-c * back + s * width) as i32;
        let ry : i32 = cy + (-s * back - c * width) as i32;
        let tx : i32 = cx + (-c * length * NOTCH_BACK) as i32;
        let ty : i32 = cy + (-s * length * NOTCH_BACK) as i32;
        let mut body : i32 = fill;
        let mut rim : i32 = edge;
        if (hot) {
            body = HIT_EDGE;
            rim = HIT_EDGE;
        }
        Draw::triangle(f, nx, ny, lx, ly, tx, ty, body);
        Draw::triangle(f, nx, ny, rx, ry, tx, ty, body);
        Draw::line(f, nx, ny, lx, ly, rim);
        Draw::line(f, lx, ly, tx, ty, rim);
        Draw::line(f, tx, ty, rx, ry, rim);
        Draw::line(f, rx, ry, nx, ny, rim);
    }

    static fn powerColor(tier : i32) : i32 {
        return match tier {
            0 => PAL_SHIELD,
            1 => PAL_RAPID,
            2 => PAL_SPREAD,
            _ => PAL_NOVA,
        };
    }

    static fn powerLetter(tier : i32) : string {
        return match tier {
            0 => "S",
            1 => "R",
            2 => "W",
            _ => "N",
        };
    }

    /** A pick-up: a spinning diamond with its letter inside, blinking when about to expire. */
    pub static fn pickup(
        f : Frame,
        e : Entity,
        ticksLeft : i32,
        at : Offset,
        kit : Typeface
    ) : void {
        if (ticksLeft < PICKUP_BLINK && (ticksLeft / 6) % 2 == 0) {
            return;
        }
        let cx : i32 = (e.x as i32) + at.x;
        let cy : i32 = (e.y as i32) + at.y;
        let color : i32 = Hulls::powerColor(e.tier);
        Draw::glow(f, cx, cy, 26, color, 45);
        for (k of 0..4) {
            let a : f32 = e.angle + HALF_PI * (k as f32);
            let b : f32 = a + HALF_PI;
            let ax : i32 = cx + (cos(a) * e.radius) as i32;
            let ay : i32 = cy + (sin(a) * e.radius) as i32;
            let bx : i32 = cx + (cos(b) * e.radius) as i32;
            let by : i32 = cy + (sin(b) * e.radius) as i32;
            Draw::line(f, ax, ay, bx, by, color);
        }
        kit.centred(f, cx, cy - kit.height(1) / 2, Hulls::powerLetter(e.tier), 1, color);
    }

    /** The ship: hull, engine glow and the shield bubble; it blinks while invulnerable. */
    pub static fn ship(f : Frame, s : Ship, tick : i32, at : Offset) : void {
        if (!s.alive) {
            return;
        }
        if (s.invuln > 0 && s.shield == 0 && (s.invuln / 5) % 2 == 0) {
            return;
        }
        let cx : i32 = (s.x as i32) + at.x;
        let cy : i32 = (s.y as i32) + at.y;
        Draw::glow(f, cx, cy, 30, PAL_SHIP_EDGE, 22);
        if (s.thrusting) {
            let bx : i32 = cx - (s.dirX() * ENGINE_OFFSET) as i32;
            let by : i32 = cy - (s.dirY() * ENGINE_OFFSET) as i32;
            Draw::glow(f, bx, by, 14, ENGINE_COLOR, 80);
        }
        let (length, width) = (SHIP_DRAW_LENGTH, SHIP_DRAW_WIDTH);
        Hulls::arrow(f, cx, cy, s.angle, length, width, PAL_SHIP_FILL, PAL_SHIP_EDGE, false);
        if (s.shield > 0 && (s.shield >= SHIELD_WARNING || (s.shield / 6) % 2 == 1)) {
            let radius : i32 = 18 + (tick % 6) / 2;
            Draw::ringAdd(f, cx, cy, radius, PAL_SHIELD);
            Draw::ringAdd(f, cx, cy, radius + 1, Color::scale(PAL_SHIELD, 1, 3));
            Draw::glow(f, cx, cy, 24, PAL_SHIELD, 18);
        }
    }
}

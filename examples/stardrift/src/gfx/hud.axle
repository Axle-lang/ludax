// hud — the heads-up display: score, lives, combo, power-up timers, wave banner and the controls reminder.
//
// Drawn after the world and without the screen shake, so the numbers hold still while the field trembles.
// Layout is anchored to the corners of the 960x600 view: score at the top left, best score and wave at the
// top right, the power-up bars at the bottom centre and the key help along the bottom edge.

use smalt::{Frame, Rect, Color};

use crate::core::config::{VIEW_W, VIEW_H, POWER_TICKS, START_LIVES};
use crate::core::palette::{
    PAL_TEXT, PAL_TEXT_DIM, PAL_ACCENT, PAL_SHIP_EDGE, PAL_SHIP_FILL, PAL_SHIELD, PAL_RAPID,
    PAL_SPREAD
};
use crate::gfx::draw::Draw;
use crate::gfx::typeface::Typeface;
use crate::sim::director::Phase;
use crate::sim::world::World;

/** Margin between the HUD and the window edge. */
const MARGIN : i32 = 18;

/** Width of a power-up bar. */
const BAR_W : i32 = 110;

/** Height of a bar. */
const BAR_H : i32 = 6;

/** Width of the combo bar, which is a little longer than a power-up bar. */
const COMBO_BAR_W : i32 = 120;

/** Ticks the controls reminder is shown bright at the start of a game. */
const HELP_TICKS : i64 = 900;

/** Ticks the wave banner fades in over. */
const BANNER_FADE : i32 = 40;

/** The in-game display. */
pub class Hud {
    /** Draws everything for the running game; `uiTicks` animates the banner and the help line. */
    pub static fn draw(f : Frame, w : World, kit : Typeface, uiTicks : i64, best : i32) : void {
        Hud::score(f, w, kit, best);
        Hud::lives(f, w);
        Hud::combo(f, w, kit);
        Hud::powers(f, w, kit);
        Hud::banner(f, w, kit);
        Hud::help(f, kit, w.tickCount);
    }

    // Score big at the top left, best and wave at the top right.
    static fn score(f : Frame, w : World, kit : Typeface, best : i32) : void {
        kit.text(f, MARGIN, MARGIN, "SCORE", 1, PAL_TEXT_DIM);
        kit.number(f, MARGIN, MARGIN + 16, w.score.points as i64, 3, PAL_TEXT);
        kit.right(f, VIEW_W - MARGIN, MARGIN, "BEST", 1, PAL_TEXT_DIM);
        let mut shown : i32 = best;
        if (w.score.points > shown) {
            shown = w.score.points;
        }
        kit.numberRight(f, VIEW_W - MARGIN, MARGIN + 16, shown as i64, 2, PAL_TEXT);
        kit.prefixed(f, VIEW_W / 2 - 30, MARGIN, "WAVE ", w.director.wave as i64, 1, PAL_TEXT_DIM);
    }

    // One small ship icon per spare life.
    static fn lives(f : Frame, w : World) : void {
        for (i of 0..START_LIVES) {
            let x : i32 = MARGIN + 8 + i * 26;
            let y : i32 = MARGIN + 74;
            if (i < w.ship.lives) {
                Hud::icon(f, x, y, PAL_SHIP_EDGE);
            } else {
                Hud::icon(f, x, y, Color::scale(PAL_TEXT_DIM, 1, 3));
            }
        }
    }

    // A tiny upright ship.
    static fn icon(f : Frame, x : i32, y : i32, edge : i32) : void {
        Draw::triangle(f, x, y - 9, x - 7, y + 7, x + 7, y + 7, PAL_SHIP_FILL);
        Draw::line(f, x, y - 9, x - 7, y + 7, edge);
        Draw::line(f, x - 7, y + 7, x, y + 3, edge);
        Draw::line(f, x, y + 3, x + 7, y + 7, edge);
        Draw::line(f, x + 7, y + 7, x, y - 9, edge);
    }

    // The multiplier and a bar that drains as the chain timer runs out.
    static fn combo(f : Frame, w : World, kit : Typeface) : void {
        if (w.score.chain < 2) {
            return;
        }
        let y : i32 = MARGIN + 100;
        let pen : i32 = kit.prefixed(f, MARGIN, y, "x", w.score.multiplier() as i64, 3, PAL_ACCENT);
        kit.prefixed(f, pen + 8, y + 18, "CHAIN ", w.score.chain as i64, 1, PAL_TEXT_DIM);
        let fill : i32 = ((w.score.timerShare() * (COMBO_BAR_W as f32)) as i32).max(1);
        f.fillRect(Rect::make(MARGIN, y + 46, COMBO_BAR_W, BAR_H), Color::scale(PAL_ACCENT, 1, 4));
        f.fillRect(Rect::make(MARGIN, y + 46, fill, BAR_H), PAL_ACCENT);
    }

    // One labelled bar per active timed power-up, centred along the bottom.
    static fn powers(f : Frame, w : World, kit : Typeface) : void {
        let s = w.ship;
        let mut slot : i32 = 0;
        slot = Hud::power(f, kit, "SHIELD", s.shield, PAL_SHIELD, slot);
        slot = Hud::power(f, kit, "RAPID FIRE", s.rapid, PAL_RAPID, slot);
        slot = Hud::power(f, kit, "SPREAD SHOT", s.spread, PAL_SPREAD, slot);
    }

    // Draws one bar if its timer is running; answers the next free slot.
    static fn power(
        f : Frame,
        kit : Typeface,
        name : string,
        left : i32,
        color : i32,
        slot : i32
    ) : i32 {
        if (left <= 0) {
            return slot;
        }
        let x : i32 = VIEW_W / 2 - 170 + slot * 130;
        let y : i32 = VIEW_H - 62;
        kit.text(f, x, y, name, 1, color);
        let fill : i32 = (left * BAR_W) / POWER_TICKS;
        f.fillRect(Rect::make(x, y + 18, BAR_W, BAR_H), Color::scale(color, 1, 4));
        f.fillRect(Rect::make(x, y + 18, fill, BAR_H), color);
        return slot + 1;
    }

    // "WAVE n" fades in and out in the middle of the screen when a wave begins, and "CLEAR" between waves.
    static fn banner(f : Frame, w : World, kit : Typeface) : void {
        let d = w.director;
        if (d.banner > 0) {
            let level : i32 = (d.banner * 255) / BANNER_FADE;
            let k : i32 = level.min(255);
            kit.prefixed(
                f,
                VIEW_W / 2 - 100,
                150,
                "WAVE ",
                d.wave as i64,
                4,
                Color::scale(PAL_TEXT, k, 255)
            );
        } else if (d.phase == Phase::Resting && d.wave > 0 && w.ship.lives > 0) {
            kit.centred(f, VIEW_W / 2, 150, "WAVE CLEARED", 3, PAL_ACCENT);
        }
    }

    // The key reminder along the bottom edge, bright for the first moments of a game and dim after.
    static fn help(f : Frame, kit : Typeface, tick : i64) : void {
        let mut ink : i32 = PAL_TEXT_DIM;
        if (tick < HELP_TICKS) {
            ink = PAL_TEXT;
        }
        kit.centred(
            f,
            VIEW_W / 2,
            VIEW_H - 22,
            "LEFT/RIGHT turn    UP thrust    SPACE fire    P pause    F3 debug    M sound    ESC quit",
            1,
            ink
        );
    }
}

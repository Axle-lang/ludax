// draw — the 2-D primitives smalt's `Frame` does not have: lines, filled triangles and additive light.
//
// `Frame` fills rectangles and discs and plots single pixels; a vector-style shooter needs lines for hulls
// and beams, triangles for solid shapes and an additive blend so that sparks and glows brighten what is
// under them instead of covering it. All three are built here from `Frame.plot`, `Frame.at` and `Color`
// alone, with integer arithmetic only: the shapes of a frame are the same on every machine.

use smalt::{Frame, Color};

/** Denominator of the glow falloff table. */
const GLOW_SCALE : i32 = 256;

/** A magnitude wider than any coordinate; sentinel of an empty horizontal span. */
const DRAW_FAR : i32 = 1000000;

/** How far the scene is shifted on screen, in pixels: the screen shake. */
pub struct Offset {
    /** Horizontal shift. */
    pub x : i32 = 0;

    /** Vertical shift. */
    pub y : i32 = 0;
}

/** Drawing helpers over a `Frame`. */
pub class Draw {
    /** Adds `color` to the pixel at (`x`, `y`), clamping each channel; nothing outside the clip. */
    pub static fn add(f : Frame, x : i32, y : i32, color : i32) : void {
        if (f.holds(x, y)) {
            f.plot(x, y, Color::add(f.at(x, y), color));
        }
    }

    /** A line from (`x0`, `y0`) to (`x1`, `y1`) in `color` (Bresenham). */
    pub static fn line(f : Frame, x0 : i32, y0 : i32, x1 : i32, y1 : i32, color : i32) : void {
        Draw::stroke(f, x0, y0, x1, y1, color, false);
    }

    /** The same line, added to what is on the frame. */
    pub static fn lineAdd(f : Frame, x0 : i32, y0 : i32, x1 : i32, y1 : i32, color : i32) : void {
        Draw::stroke(f, x0, y0, x1, y1, color, true);
    }

    static fn stroke(
        f : Frame,
        x0 : i32,
        y0 : i32,
        x1 : i32,
        y1 : i32,
        color : i32,
        additive : bool
    ) : void {
        let dx : i32 = Draw::abs(x1 - x0);
        let dy : i32 = -Draw::abs(y1 - y0);
        let sx : i32 = Draw::step(x0, x1);
        let sy : i32 = Draw::step(y0, y1);
        let mut err : i32 = dx + dy;
        let mut x : i32 = x0;
        let mut y : i32 = y0;
        let mut guard : i32 = dx - dy + 2;

        while (guard > 0) {
            if (additive) {
                Draw::add(f, x, y, color);
            } else {
                f.plot(x, y, color);
            }
            if (x == x1 && y == y1) {
                return;
            }
            let e2 : i32 = 2 * err;
            if (e2 >= dy) {
                err = err + dy;
                x = x + sx;
            }
            if (e2 <= dx) {
                err = err + dx;
                y = y + sy;
            }
            guard = guard - 1;
        }
    }

    static fn abs(v : i32) : i32 {
        if (v < 0) {
            return -v;
        }
        return v;
    }

    static fn step(from : i32, to : i32) : i32 {
        if (from < to) {
            return 1;
        }
        return -1;
    }

    /** A filled triangle, one horizontal run per row. */
    pub static fn triangle(
        f : Frame,
        ax : i32,
        ay : i32,
        bx : i32,
        by : i32,
        cx : i32,
        cy : i32,
        color : i32
    ) : void {
        let top : i32 = Draw::min3(ay, by, cy);
        let bottom : i32 = Draw::max3(ay, by, cy);
        for (y of top..bottom + 1) {
            let mut lo : i32 = DRAW_FAR;
            let mut hi : i32 = -DRAW_FAR;
            let c1 : (lo: i32, hi: i32) = Draw::cross(ax, ay, bx, by, y, lo, hi);
            let c2 : (lo: i32, hi: i32) = Draw::cross(bx, by, cx, cy, y, c1.lo, c1.hi);
            let c3 : (lo: i32, hi: i32) = Draw::cross(cx, cy, ax, ay, y, c2.lo, c2.hi);
            if (c3.lo <= c3.hi) {
                f.hLine(c3.lo, y, c3.hi - c3.lo + 1, color);
            }
        }
    }

    // Widens the run [`lo`, `hi`] to include where the edge (`x0`, `y0`)-(`x1`, `y1`) crosses row `y`.
    static fn cross(
        x0 : i32,
        y0 : i32,
        x1 : i32,
        y1 : i32,
        y : i32,
        lo : i32,
        hi : i32
    ) : (lo: i32, hi: i32) {
        let ymin : i32 = Draw::min3(y0, y1, y1);
        let ymax : i32 = Draw::max3(y0, y1, y1);
        if (y < ymin || y > ymax) {
            return (lo, hi);
        }
        if (y0 == y1) {
            return (Draw::min3(lo, x0, x1), Draw::max3(hi, x0, x1));
        }
        let x : i32 = x0 + ((x1 - x0) * (y - y0)) / (y1 - y0);
        return (Draw::min3(lo, x, x), Draw::max3(hi, x, x));
    }

    static fn min3(a : i32, b : i32, c : i32) : i32 {
        return a.min(b).min(c);
    }

    static fn max3(a : i32, b : i32, c : i32) : i32 {
        return a.max(b).max(c);
    }

    /**
     * A soft disc of light: `color` at full strength in the middle, fading to nothing at `radius`, added to
     * what is below. `percent` scales the whole glow (100 is full).
     */
    pub static fn glow(
        f : Frame,
        cx : i32,
        cy : i32,
        radius : i32,
        color : i32,
        percent : i32
    ) : void {
        if (radius <= 0 || percent <= 0) {
            return;
        }
        let r2 : i32 = radius * radius;
        for (dy of -radius..radius + 1) {
            for (dx of -radius..radius + 1) {
                let d2 : i32 = dx * dx + dy * dy;
                if (d2 < r2) {
                    let t : i32 = ((r2 - d2) * GLOW_SCALE) / r2;
                    let k : i32 = (t * t * percent) / (GLOW_SCALE * 100);
                    Draw::add(f, cx + dx, cy + dy, Color::scale(color, k, GLOW_SCALE));
                }
            }
        }
    }

    /** A one-pixel circle outline of `radius` (midpoint algorithm), added to the frame. */
    pub static fn ringAdd(f : Frame, cx : i32, cy : i32, radius : i32, color : i32) : void {
        if (radius <= 0) {
            Draw::add(f, cx, cy, color);
            return;
        }
        let mut x : i32 = radius;
        let mut y : i32 = 0;
        let mut err : i32 = 1 - radius;
        while (x >= y) {
            Draw::octants(f, cx, cy, x, y, color);
            y = y + 1;
            if (err < 0) {
                err = err + 2 * y + 1;
            } else {
                x = x - 1;
                err = err + 2 * (y - x) + 1;
            }
        }
    }

    // The eight symmetric points of the circle at offset (`x`, `y`).
    static fn octants(f : Frame, cx : i32, cy : i32, x : i32, y : i32, color : i32) : void {
        Draw::add(f, cx + x, cy + y, color);
        Draw::add(f, cx - x, cy + y, color);
        Draw::add(f, cx + x, cy - y, color);
        Draw::add(f, cx - x, cy - y, color);
        Draw::add(f, cx + y, cy + x, color);
        Draw::add(f, cx - y, cy + x, color);
        Draw::add(f, cx + y, cy - x, color);
        Draw::add(f, cx - y, cy - x, color);
    }
}

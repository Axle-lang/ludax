// controls — turns the keyboard into what the game understands.
//
// Two kinds of input, handled differently on purpose. What the ship should do *right now* (turn, thrust,
// fire) is read from the held-key state every frame and held constant for every simulation tick of that
// frame. A button *press* (start, pause, toggles) is an edge and comes from the event queue, so a press is
// never missed between frames and never repeats while the key stays down.

use smalt::{Events, Event, EventKind, Scancode};

use crate::core::types::Input;

/** Something the player asked for with a single key press. */
pub enum Command : i8 {
    /** Nothing. */
    None,

    /** Start or restart. */
    Confirm,

    /** Pause or resume. */
    Pause,

    /** Show or hide the debug panel. */
    Debug,

    /** Mute or unmute. */
    Mute,

    /** Save a screenshot. */
    Screenshot,

    /** Leave the program. */
    Quit,
}

/** Keyboard reading. */
pub class Controls {
    /** The ship controls currently held down. */
    pub static fn held(events : Events) : Input {
        return Input {
            left: events.isKeyDown(Scancode::Left) || events.isKeyDown(Scancode::A),
            right: events.isKeyDown(Scancode::Right) || events.isKeyDown(Scancode::D),
            thrust: events.isKeyDown(Scancode::Up) || events.isKeyDown(Scancode::W),
            fire: events.isKeyDown(Scancode::Space) || events.isKeyDown(Scancode::Z),
        };
    }

    /** The command a key-down event stands for; `None` for any other event or an auto-repeat. */
    pub static fn command(e : Event) : Command {
        if (e.kind != EventKind::KeyDown || e.repeat) {
            return Command::None;
        }
        return match e.scancode {
            Scancode::Return => Command::Confirm,
            Scancode::KeypadEnter => Command::Confirm,
            Scancode::P => Command::Pause,
            Scancode::F3 => Command::Debug,
            Scancode::M => Command::Mute,
            Scancode::F12 => Command::Screenshot,
            Scancode::Escape => Command::Quit,
            _ => Command::None,
        };
    }
}

// options — the command line: every flag, its default, and the parser that turns argv into an `Options`.
//
// The program takes no argument-parsing dependency: the grammar is small, and a bad flag should stop the
// session before a window opens with a message that names it. Parsing stops at the first mistake and leaves
// it in `problem`, which `main` prints before the usage text.
//
//   --seed N        fix the random seed of the whole session (default 1)
//   --smoke N       run N fixed ticks with a scripted pilot, print a checksum of the final state and exit
//   --shot FILE     after the smoke run, save the final frame as a BMP (needs --smoke)
//   --wave N        start the first game at wave N (default 1), to meet the later enemies sooner
//   --debug         start with the F3 overlay on (and the profiler recording)
//   --mute          start with sound off
//   --selftest      check the game's own containers and exit
//   --help          print this

use std::lang::IndexOutOfBoundsException;
use std::sys::process::{argc, argAt};

/** Byte codes of `0` and `9`, for the hand-written decimal parser. */
const ASCII_ZERO : i32 = 48;
const ASCII_NINE : i32 = 57;

/** Base of that parser. */
const DECIMAL_BASE : i64 = 10;

/** What the command line asked for. */
pub class Options {
    /** Base seed of the session. */
    pub seed : i64 = 1;

    /** Ticks of the smoke run, or -1 for an interactive session. */
    pub smoke : i32 = -1;

    /** File to save the final frame to, or empty. */
    pub shot : string = "";

    /** Wave the first game starts at. */
    pub wave : i32 = 1;

    /** Whether the debug overlay starts visible. */
    pub debug : bool = false;

    /** Whether sound starts muted. */
    pub mute : bool = false;

    /** Whether to run the self-test instead of the game. */
    pub selftest : bool = false;

    /** Whether to print the usage text. */
    pub help : bool = false;

    /** A mistake in the arguments, or empty. */
    pub problem : string = "";

    /** Options with every default. */
    constructor() {}
}

/** Command-line parsing. */
pub class Cli {
    /** Reads the arguments of the running program. */
    pub static fn parse() : Options {
        let mut o : Options = new Options();
        let mut i : i32 = 1;
        while (i < argc() && o.problem.length == 0) {
            let arg : string = Cli::argument(i);
            if (arg == "--debug") {
                o.debug = true;
            } else if (arg == "--mute") {
                o.mute = true;
            } else if (arg == "--selftest") {
                o.selftest = true;
            } else if (arg == "--help" || arg == "-h") {
                o.help = true;
            } else if (arg == "--seed" || arg == "--smoke" || arg == "--shot" || arg == "--wave") {
                i = i + 1;
                if (i >= argc()) {
                    o.problem = "${arg} needs a value";
                } else {
                    Cli::withValue(o, arg, Cli::argument(i));
                }
            } else {
                o.problem = "unknown argument ${arg}";
            }
            i = i + 1;
        }
        return o;
    }

    // Argument `i`, or the empty string when there is none. The concatenation copies the argument, which the
    // argument list only lends.
    static fn argument(i : i32) : string {
        try {
            return argAt(i) + "";
        } catch e : IndexOutOfBoundsException {
            return "";
        }
    }

    // Applies an option that takes a value.
    static fn withValue(o : Options, name : string, value : string) : void {
        if (name == "--shot") {
            o.shot = value;
            return;
        }
        let n : i64 = Cli::number(value);
        if (n < 0) {
            o.problem = "${name} needs a whole number, not ${value}";
        } else if (name == "--seed") {
            o.seed = n;
        } else if (name == "--wave") {
            o.wave = n as i32;
        } else {
            o.smoke = n as i32;
        }
    }

    // The non-negative whole number written in `s`, or -1 when it is not one.
    static fn number(s : string) : i64 {
        if (s.length == 0) {
            return -1;
        }
        let mut n : i64 = 0;
        for (i of 0..s.byteLength) {
            let d : i32 = s.byteAt(i);
            if (d < ASCII_ZERO || d > ASCII_NINE) {
                return -1;
            }
            n = n * DECIMAL_BASE + ((d - ASCII_ZERO) as i64);
        }
        return n;
    }

    /** The usage text. */
    pub static fn usage() : string {
        return "stardrift [--seed N] [--wave N] [--smoke N [--shot FILE]] [--debug] [--mute] [--selftest]\n"
            + "  arrows/WASD move, SPACE fire, P pause, F3 debug, M mute, F12 screenshot, ESC quit";
    }
}

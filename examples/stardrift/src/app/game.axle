// game — the flow of the program around the simulation: title, play, pause, game over, and the best score.
//
// The world knows how to run a game; the `Game` knows which screen the player is on and what a button press
// means there. A new run takes its seed from the base seed and the run number, so `--seed N` fixes the whole
// session while every restart still plays differently. Sounds the simulation asks for are collected here and
// handed to the audio layer once per rendered frame.

use ludax::{Vec, mixI64};

use crate::app::telemetry::Telemetry;
use crate::core::types::{Input, Sfx};
use crate::sim::step::Step;
use crate::sim::waves::Waves;
use crate::sim::world::World;

/** Initial room of the sound outbox. */
const OUTBOX_ROOM : i32 = 32;

/** Which screen the player is on. */
pub enum Mode : i8 {
    /** The title screen, with rocks drifting behind it. */
    Title,

    /** A game in progress. */
    Playing,

    /** A game in progress, frozen. */
    Paused,

    /** The score screen after the last life. */
    Over,
}

/** The program's state machine and the world it runs. */
pub class Game {
    /** The simulation. */
    pub world : World;

    /** The screen the player is on. */
    pub mode : Mode = Mode::Title;

    /** The best score since the program started. */
    pub best : i32 = 0;

    /** True on the game-over screen when this run beat the previous best. */
    pub newBest : bool = false;

    /** Games started so far. */
    pub runs : i32 = 0;

    /** Ticks since the program started, driving menu animation (the simulation's clock restarts per game). */
    pub uiTicks : i64 = 0;

    /** Sounds requested since the last `takeSounds`. */
    pub outbox : Vec<Sfx>;

    /** The wave the next game starts at; every game after the first starts at 1. */
    pub firstWave : i32 = 1;

    baseSeed : u64;

    /** A game on the title screen; `seed` fixes the whole session. */
    constructor(seed : u64, own tm : Telemetry) {
        self.baseSeed = seed;
        self.world = new World(seed, tm);
        self.world.reset(seed, true);
        Waves::seedBackdrop(self.world);
        self.outbox = new Vec<Sfx>(OUTBOX_ROOM);
    }

    /** Stops the worker threads; call once at exit. */
    pub fn close(mut self) : void {
        self.world.close();
    }

    /** The seed of run number `run`. */
    pub fn seedOf(self, run : i32) : u64 {
        return mixI64(self.baseSeed as i64 + run as i64) as u64;
    }

    /** The confirm button: launches from the title screen and restarts from game over. */
    pub fn confirm(mut self) : void {
        match self.mode {
            Mode::Title => self.start(),
            Mode::Over => self.start(),
            _ => {},
        }
    }

    /** The pause button: freezes a running game and resumes a paused one. */
    pub fn togglePause(mut self) : void {
        match self.mode {
            Mode::Playing => {
                self.mode = Mode::Paused;
                self.world.tm.log.info("game", "paused");
            },
            Mode::Paused => {
                self.mode = Mode::Playing;
                self.world.tm.log.info("game", "resumed");
            },
            _ => {},
        }
    }

    // Begins a fresh game with its own seed.
    fn start(mut self) : void {
        self.runs = self.runs + 1;
        let seed : u64 = self.seedOf(self.runs);
        self.world.reset(seed, false);
        self.world.director.wave = self.firstWave - 1;
        self.firstWave = 1;
        self.mode = Mode::Playing;
        self.newBest = false;
        let run : i32 = self.runs;
        self.world.tm.log.info("game", "run ${run} starts, seed ${seed.toString()}");
    }

    /** Advances the program by one fixed tick with the player's `input`. */
    pub fn tick(mut self, input : Input) : void {
        self.uiTicks = self.uiTicks + 1;
        match self.mode {
            Mode::Paused => {},
            Mode::Playing => {
                Step::tick(self.world, input);
                self.collectSounds();
                if (self.world.isOver()) {
                    self.finish();
                }
            },
            _ => {
                Step::tick(self.world, Input {});
                self.collectSounds();
            },
        }
    }

    // Moves the sounds of the tick that just ran into the outbox.
    fn collectSounds(mut self) : void {
        for (i of 0..self.world.sounds.len()) {
            self.outbox.push(self.world.sounds.get(i));
        }
    }

    // The last life is gone: record the score and show the result.
    fn finish(mut self) : void {
        let points : i32 = self.world.score.points;
        if (points > self.best) {
            self.best = points;
            self.newBest = true;
        }
        self.mode = Mode::Over;
        self.world.tm.log.info("game", "game over, score ${points}");
    }

    /** True while the simulation is advancing, so the renderer knows whether motion is live. */
    pub fn isRunning(self) : bool {
        return self.mode != Mode::Paused;
    }
}

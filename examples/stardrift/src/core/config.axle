// config — every tuning number of the game, in one place.
//
// Units: pixels, ticks (one tick is 1/60 s) and radians. Speeds are written per second and multiplied by `DT`
// where the simulation applies them, so a designer reads "300 px/s" and the code reads `300 * DT`. A float
// literal next to an `f32` is an `f64` in Axle, so every number is a typed constant here and the code never
// spells a bare literal.

// --- shared small numbers ----------------------------------------------------------------------------

/** One half, typed so that `x * HALF` stays an `f32`. */
pub const HALF : f32 = 0.5;

/** One, typed. */
pub const ONE : f32 = 1.0;

/** A tiny distance that keeps a division by a length away from zero. */
pub const EPS : f32 = 0.001;

// --- screen and clock ---------------------------------------------------------------------------------

/** Width of the window and of the playfield, in pixels. */
pub const VIEW_W : i32 = 960;

/** Height of the window and of the playfield, in pixels. */
pub const VIEW_H : i32 = 600;

/** Playfield width as a float, to avoid a cast at every use. */
pub const FIELD_W : f32 = 960.0;

/** Playfield height as a float. */
pub const FIELD_H : f32 = 600.0;

/** Simulation ticks per second. */
pub const TICK_HZ : i32 = 60;

/** Length of one tick in seconds. */
pub const DT : f32 = 0.016666668;

/** Most ticks one rendered frame may owe before the rest is dropped. */
pub const MAX_STEPS_PER_FRAME : i32 = 5;

/** Frames per second the window loop paces itself to. */
pub const FRAME_RATE : i32 = 60;

// --- ship ---------------------------------------------------------------------------------------------

/** Collision radius of the ship. */
pub const SHIP_RADIUS : f32 = 12.0;

/** Rotation speed in radians per second. */
pub const SHIP_TURN : f32 = 4.4;

/** Forward acceleration in pixels per second squared. */
pub const SHIP_THRUST : f32 = 430.0;

/** Fraction of velocity kept each tick: the ship drifts a long way after the engine stops. */
pub const SHIP_DRAG : f32 = 0.9935;

/** Speed limit in pixels per second. */
pub const SHIP_MAX_SPEED : f32 = 380.0;

/** Share of the speed that survives a bounce off the playfield edge. */
pub const SHIP_BOUNCE : f32 = 0.55;

/** Lives at the start of a run. */
pub const START_LIVES : i32 = 3;

/** Ticks of invulnerability after a respawn or an absorbed hit. */
pub const INVULN_TICKS : i32 = 150;

/** Ticks between the ship's destruction and its return. */
pub const RESPAWN_TICKS : i32 = 100;

/** Ticks the game lingers on the wreck after the last life before the game-over screen. */
pub const OVER_DELAY_TICKS : i32 = 120;

// --- bullets ------------------------------------------------------------------------------------------

/** Slots in the bullet pool (player and enemy shots together). */
pub const BULLET_CAPACITY : i32 = 320;

/** Muzzle speed of the ship's shots, pixels per second. */
pub const SHOT_SPEED : f32 = 760.0;

/** Lifetime of a ship shot in ticks. */
pub const SHOT_LIFE : i32 = 52;

/** Ticks between shots with no power-up. */
pub const FIRE_COOLDOWN : i32 = 10;

/** Ticks between shots with the rapid-fire power-up. */
pub const FIRE_COOLDOWN_RAPID : i32 = 5;

/** Half-angle of the outer shots of the spread power-up, in radians. */
pub const SPREAD_ANGLE : f32 = 0.2;

/** Collision radius of a ship shot. */
pub const SHOT_RADIUS : f32 = 3.0;

/** Speed of an enemy bolt, pixels per second. */
pub const BOLT_SPEED : f32 = 270.0;

/** Lifetime of an enemy bolt in ticks. */
pub const BOLT_LIFE : i32 = 190;

/** Collision radius of an enemy bolt. */
pub const BOLT_RADIUS : f32 = 5.0;

// --- enemies ------------------------------------------------------------------------------------------

/** Radius of a large asteroid; the medium and small ones are fixed fractions of it in the code. */
pub const ROCK_RADIUS_LARGE : f32 = 40.0;

/** Radius of a medium asteroid. */
pub const ROCK_RADIUS_MEDIUM : f32 = 24.0;

/** Radius of a small asteroid. */
pub const ROCK_RADIUS_SMALL : f32 = 13.0;

/** Drift speed of an asteroid in pixels per second; smaller rocks are quicker. */
pub const ROCK_SPEED : f32 = 55.0;

/** Collision radius of a drone. */
pub const DRONE_RADIUS : f32 = 10.0;

/** Top speed of a drone in pixels per second. */
pub const DRONE_SPEED : f32 = 150.0;

/** How sharply a drone steers towards its target (fraction of the velocity error closed per tick). */
pub const DRONE_STEER : f32 = 0.045;

/** Distance under which two drones push each other apart. */
pub const DRONE_SPACING : f32 = 34.0;

/** Collision radius of a gunship. */
pub const GUNSHIP_RADIUS : f32 = 15.0;

/** Distance a gunship tries to keep from the ship. */
pub const GUNSHIP_ORBIT : f32 = 230.0;

/** Cruise speed of a gunship in pixels per second. */
pub const GUNSHIP_SPEED : f32 = 95.0;

/** Ticks between a gunship's shots. */
pub const GUNSHIP_RELOAD : i32 = 95;

/** Hit points of a gunship. */
pub const GUNSHIP_HP : i32 = 4;

/** Entities beyond this distance outside the playfield are discarded. */
pub const CULL_MARGIN : f32 = 140.0;

// --- scoring ------------------------------------------------------------------------------------------

/** Ticks a kill keeps the combo alive. */
pub const COMBO_TICKS : i32 = 150;

/** Kills needed to raise the multiplier by one. */
pub const COMBO_STEP : i32 = 4;

/** Highest score multiplier. */
pub const COMBO_MAX : i32 = 10;

/** Points of a large asteroid. */
pub const SCORE_ROCK_LARGE : i32 = 20;

/** Points of a medium asteroid. */
pub const SCORE_ROCK_MEDIUM : i32 = 50;

/** Points of a small asteroid. */
pub const SCORE_ROCK_SMALL : i32 = 100;

/** Points of a drone. */
pub const SCORE_DRONE : i32 = 150;

/** Points of a gunship. */
pub const SCORE_GUNSHIP : i32 = 400;

/** Points for picking up a power-up. */
pub const SCORE_PICKUP : i32 = 250;

/** Bonus per wave number for clearing a wave. */
pub const SCORE_WAVE_BONUS : i32 = 500;

// --- power-ups ----------------------------------------------------------------------------------------

/** Collision radius of a pick-up. */
pub const PICKUP_RADIUS : f32 = 12.0;

/** Ticks a pick-up waits to be collected. */
pub const PICKUP_TTL : i32 = 600;

/** Ticks a timed power-up lasts. */
pub const POWER_TICKS : i32 = 720;

/** Radius of the nova blast. */
pub const NOVA_RADIUS : f32 = 300.0;

// --- waves --------------------------------------------------------------------------------------------

/** Ticks of calm before the first wave and between waves. */
pub const WAVE_PAUSE_TICKS : i32 = 150;

/** Largest number of live entities the director allows before it holds spawns back. */
pub const ENTITY_SOFT_CAP : i32 = 90;

// --- effects ------------------------------------------------------------------------------------------

/** Slots in the particle pool. */
pub const PARTICLE_CAPACITY : i32 = 1800;

/** Slots in the score-popup pool. */
pub const POPUP_CAPACITY : i32 = 24;

/** Largest screen-shake offset in pixels at full trauma. */
pub const SHAKE_MAX : f32 = 15.0;

/** Fraction of trauma kept each tick. */
pub const SHAKE_DECAY : f32 = 0.93;

/** Particles handled per job chunk. */
pub const PARTICLE_GRAIN : i32 = 300;

// --- collision grid -----------------------------------------------------------------------------------

/** Side of a grid cell in pixels. */
pub const GRID_CELL : i32 = 64;

/** Upper bound on proxies in the grid. */
pub const GRID_PROXY_HINT : i32 = 256;

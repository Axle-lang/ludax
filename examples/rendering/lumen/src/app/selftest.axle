// selftest — checks of the renderer against things that must be true, run with `--selftest`.
//
// A picture cannot be asserted pixel by pixel, but its ingredients can: the flat world must agree with the
// light engine's own ray walker, a lamp's colour must survive from its spec to the light volume, a pass mask
// must let exactly its classes through, the sky lookup must agree with the integral it caches, and a frame must
// be the same bit for bit whatever the number of threads. The exit status is the number of checks that failed.

use ludax::{BlockLightTable, Checks, Pcg32, Ray, Vec3, DRay, DVec3, LightSky, LightSource, VoxRayTracer};
use ludax::{LumenLightSample, LumenView, ShaftPlane, LumenShaft};

use crate::app::session::{LumenSession, LumenShot};
use crate::render::worker::WORKER_SKY;
use crate::world::blocks::{
    lumenLightTable, LumenBlock, LumenObstacle, LumenObstacles, LumenLayer, LumenLayers
};
use crate::world::hit::LumenHit;
use crate::world::lampspec::LumenLampSpec;
use crate::world::scene::{LumenScene, SCENE_DETAIL};

// The picture every check renders: small enough to be quick, large enough to hold every kind of surface.
/** The picture the light shafts are checked on: wide enough that the border strip is a small part of it. */
const SHAFT_W : i32 = 256;
const SHAFT_H : i32 = 144;

const TEST_W : i32 = 96;
const TEST_H : i32 = 54;
const TEST_THREADS : i32 = 4;

// How far the camera turns between the still passes and the moving one, radians.
const TEST_TURN : f32 = 0.02;

/** Rays the walker comparison fires, and the margin, floor and height of the box their origins fill, cells. */
const WALKER_RAYS : i32 = 3000;
const WALKER_MARGIN : f32 = 4.0;
const WALKER_FLOOR : f32 = 20.0;
const WALKER_HEIGHT : f32 = 30.0;

/** How far the walker comparison looks along each ray, cells. */
const WALKER_REACH : f64 = 60.0;

/** The comparable rays must number at least this many, and at most one in `WALKER_GRAZE` may disagree. */
const WALKER_MIN_TESTED : i32 = 500;
const WALKER_GRAZE : i32 = 1000;

/** The walker's ray is comparable when it ends within this of either end of its span: it hit or it missed. */
const WALKER_NEAR_END : f64 = 0.0001;

/** Rays the visibility comparison fires, and the margin, floor and height of the box their origins fill, cells. */
const VISIBILITY_RAYS : i32 = 6000;
const VISIBILITY_MARGIN : f32 = 2.0;
const VISIBILITY_FLOOR : f32 = 1.0;
const VISIBILITY_HEIGHT : f32 = 60.0;

/** How far the visibility comparison looks, cells; at least this many rays must be tested and this many blocked. */
const VISIBILITY_REACH : f32 = 400.0;
const VISIBILITY_MIN_TESTED : i32 = 3000;
const VISIBILITY_MIN_BLOCKED : i32 = 500;

/** A random direction shorter than this is too close to the zero vector to normalise. */
const RAY_MIN_LENGTH : f32 = 0.05;

/** Where random test rays start: a margin from the world's sides, a floor, and a height of spread above it. */
struct TestBox {
    margin : f32 = 0.0;
    floor  : f32 = 0.0;
    height : f32 = 0.0;
}

// How many random rays look for leaves past the scene's texel detail distance.
const FAR_LEAF_RAYS : i32 = 6000;

/** A random ray, or none when the draw was unusable (a degenerate direction or an origin inside a block). */
struct TestAim {
    ok  : bool = false;
    ray : Ray = Ray { origin: Vec3 { x: 0.0, y: 0.0, z: 0.0 }, direction: Vec3 { x: 0.0, y: 0.0, z: -1.0 } };
}

/** The checks. */
pub class LumenSelfTest {
    /** Runs every check and returns how many failed. */
    pub static fn run() : i32 {
        let c : Checks = new Checks();
        let a : LumenSession = new LumenSession(TEST_THREADS, TEST_W, TEST_H, 1);
        // The frame is rendered first: the random streams follow the frame number, so a comparison needs both
        // sessions to have drawn the same frames.
        let hdrA : f32[] = LumenSelfTest::render(a);
        LumenSelfTest::walker(c, a);
        LumenSelfTest::farLeaves(c, a);
        LumenSelfTest::visibility(c, a);
        LumenSelfTest::bakedSun(c, a);
        LumenSelfTest::lamps(c, a);
        LumenSelfTest::passes(c, a);
        LumenSelfTest::sky(c, a);
        a.close();
        let b : LumenSession = new LumenSession(1, TEST_W, TEST_H, 1);
        let hdrB : f32[] = LumenSelfTest::render(b);
        let n : i64 = (TEST_W as i64) * (TEST_H as i64) * 3;
        let mut differ : i32 = 0;
        for (i of 0..n) {
            if (hdrA[i] != hdrB[i]) {
                differ = differ + 1;
            }
        }
        c.sameInt("a frame is identical on 4 threads and on 1 (values that differ)", differ, 0);
        c.that("the frame is not black", LumenSelfTest::brightest(hdrA, n) > 0.01);
        c.sameInt("and no value of it is NaN", LumenSelfTest::nans(hdrA, n), 0);
        b.close();
        println("lumen selftest: ${c.count()} checks, ${c.failures()} failed");
        return c.failures();
    }

    // Four passes of the first viewpoint, as the radiance picture, and the same frame number for both sessions:
    // two with the camera still (the history is the same pixel), one turned a little (the history is reprojected
    // through the previous camera) and one still again. The spatial filter is switched on, which it is not by
    // default, so every stage of the frame takes part in the comparison between thread counts.
    static fn render(mut s : LumenSession) : f32[] {
        s.goTo(LumenSession::shot(1));
        s.env.settings.view = LumenView::Final;
        s.env.settings.denoise = true;
        s.pass();
        s.pass();
        s.cam.yaw = s.cam.yaw + TEST_TURN;
        s.pass();
        s.pass();
        let n : i64 = (TEST_W as i64) * (TEST_H as i64) * 3;
        let mut copy : f32[] = new f32[n];
        for (i of 0..n) {
            copy[i] = s.frame.hdr[i];
        }
        return copy;
    }

    // How many of the first `n` values are not a number.
    static fn nans(h : f32[], n : i64) : i32 {
        let mut count : i32 = 0;
        for (i of 0..n) {
            if (h[i] != h[i]) {
                count = count + 1;
            }
        }
        return count;
    }

    static fn brightest(h : f32[], n : i64) : f32 {
        let mut m : f32 = 0.0;
        for (i of 0..n) {
            if (h[i] > m) {
                m = h[i];
            }
        }
        return m;
    }

    // The next random ray of a test: an origin in `box` (the world is square, so one span serves x and z) and a
    // direction from the cube's middle, unit length. The draws are always made in the same order, so a seed
    // gives the same rays whatever the test does with them.
    static fn aim(r : Pcg32, scene : LumenScene, box : TestBox) : TestAim {
        let span : f32 = (scene.sx as f32) - (2.0 as f32) * box.margin;
        let ox : f32 = box.margin + r.nextF32() * span;
        let oz : f32 = box.margin + r.nextF32() * span;
        let oy : f32 = box.floor + r.nextF32() * box.height;
        let dx : f32 = r.nextF32() - (0.5 as f32);
        let dy : f32 = r.nextF32() - (0.5 as f32);
        let dz : f32 = r.nextF32() - (0.5 as f32);
        let len : f32 = (dx * dx + dy * dy + dz * dz).sqrt();
        if (len <= RAY_MIN_LENGTH || scene.isSolid(ox as i32, oy as i32, oz as i32)) {
            return TestAim { ok: false };
        }
        let dir : Vec3 = Vec3 { x: dx / len, y: dy / len, z: dz / len };
        return TestAim { ok: true, ray: Ray::make(Vec3::make(ox, oy, oz), dir) };
    }

    // The flat walker and the engine's walker must agree on whether a ray reaches an opaque block.
    static fn walker(c : Checks, s : LumenSession) : void {
        let scene : LumenScene = s.env.scene;
        let tracer : VoxRayTracer = new VoxRayTracer();
        let table : Shared<BlockLightTable> = lumenLightTable();
        let r : Pcg32 = new Pcg32(5, 9);
        let mut tested : i32 = 0;
        let mut wrong : i32 = 0;
        let box : TestBox = TestBox { margin: WALKER_MARGIN, floor: WALKER_FLOOR, height: WALKER_HEIGHT };
        for (k of 0..WALKER_RAYS) {
            let aim : TestAim = LumenSelfTest::aim(r, scene, box);
            if (!aim.ok) {
                continue;
            }

            let sight : Ray = aim.ray;
            let from : DVec3 = DVec3::make(
                sight.origin.x as f64,
                sight.origin.y as f64,
                sight.origin.z as f64
            );
            let toward : DVec3 = DVec3::make(
                sight.direction.x as f64,
                sight.direction.y as f64,
                sight.direction.z as f64
            );
            tracer.trace(s.engine().grid, table, DRay::make(from, toward), WALKER_REACH);
            let hit : LumenHit = scene.trace(sight, WALKER_REACH as f32, true, 0);
            let f : f64 = tracer.fraction();
            if (f < WALKER_NEAR_END || f > 1.0 - WALKER_NEAR_END) {
                tested = tested + 1;
                if ((f < 0.5) != hit.hit) {
                    wrong = wrong + 1;
                }
            }
        }
        c.that("enough rays were comparable (${tested})", tested > WALKER_MIN_TESTED);
        // A ray grazing a block edge may fall either side in f32 and f64: one in a thousand is that, more is a bug.
        c.that(
            "the flat walker and the engine's walker agree on opaque hits (${wrong} disagreements of ${tested})",
            wrong * WALKER_GRAZE <= tested
        );
    }

    // A seen ray must strike a leaf at any distance: past the detail distance a leaf is no longer resolved into
    // texels, but it is still there. A canopy that only shadow rays could feel vanished from the picture as soon as
    // it was farther than that.
    static fn farLeaves(c : Checks, s : LumenSession) : void {
        let scene : LumenScene = s.env.scene;
        let r : Pcg32 = new Pcg32(8, 3);
        let box : TestBox = TestBox { margin: WALKER_MARGIN, floor: WALKER_FLOOR, height: WALKER_HEIGHT };
        let mut far : i32 = 0;
        for (k of 0..FAR_LEAF_RAYS) {
            let aim : TestAim = LumenSelfTest::aim(r, scene, box);
            if (!aim.ok) {
                continue;
            }
            let hit : LumenHit = scene.trace(aim.ray, WALKER_REACH as f32, false, 0);
            if (hit.hit && hit.block == LumenBlock::Leaves.id() && hit.t >= SCENE_DETAIL) {
                far = far + 1;
            }
        }
        c.that("seen rays strike leaves past the detail distance (${far} of ${FAR_LEAF_RAYS} rays)", far > 0);
    }

    // The lean occlusion walk and the full walk must agree on whether something opaque is in the way, for rays
    // of every length and direction: a shadow ray that lets the sun through a mountain is the worst bug a
    // renderer of light can have.
    static fn visibility(c : Checks, s : LumenSession) : void {
        let scene : LumenScene = s.env.scene;
        let r : Pcg32 = new Pcg32(21, 4);
        let mut tested : i32 = 0;
        let mut wrong : i32 = 0;
        let mut blocked : i32 = 0;
        let box : TestBox = TestBox {
            margin: VISIBILITY_MARGIN,
            floor: VISIBILITY_FLOOR,
            height: VISIBILITY_HEIGHT,
        };
        for (k of 0..VISIBILITY_RAYS) {
            let aim : TestAim = LumenSelfTest::aim(r, scene, box);
            if (!aim.ok) {
                continue;
            }

            let hit : LumenHit = scene.trace(aim.ray, VISIBILITY_REACH, true, 0);
            let seen : Vec3 = scene.visibility(aim.ray, VISIBILITY_REACH, 0);
            let a : bool = hit.hit;
            let b : bool = seen.maxComponent() <= 0.0;
            tested = tested + 1;
            if (a) {
                blocked = blocked + 1;
            }
            if (a != b) {
                wrong = wrong + 1;
            }
        }
        c.that(
            "enough rays were tested (${tested}, ${blocked} blocked)",
            tested > VISIBILITY_MIN_TESTED && blocked > VISIBILITY_MIN_BLOCKED
        );
        c.sameInt(
            "the lean walk and the full walk agree on whether a ray is blocked (disagreements)",
            wrong,
            0
        );
    }

    // The sun's shadow baked by the light engine into the volume must agree with a ray cast from the same place:
    // where the volume says the sun is hidden a ray finds something in the way, and where it says the sun is
    // seen a ray finds the sky. The two measure the same thing (one with 40 rays over the disc, one with one), so
    // they may differ in the penumbra, not elsewhere.
    static fn bakedSun(c : Checks, s : LumenSession) : void {
        s.goTo(LumenSession::shot(3));
        s.setDay(0.5);
        LumenSelfTest::agree(c, s, "at noon");
        // Moving the sun re-bakes a slice of the shell each frame; once the frames have run the volume must
        // describe the new sun and not the old one.
        s.setDay(0.33);
        // A world this size has a shell of hundreds of thousands of cells, a slice a frame.
        let mut frames : i32 = 0;
        while (s.bakeStale && frames < 600) {
            s.pass();
            frames = frames + 1;
        }
        c.that("the re-bake toward the new sun has finished", !s.bakeStale);
        LumenSelfTest::agree(c, s, "after the sun moved");
        s.goTo(LumenShot { x: 53.0, y: 23.4, z: 56.0, yaw: 0.0, pitch: 0.0, day: 0.33 });
        LumenSelfTest::agree(c, s, "after a full bake at the same sun");
    }

    static fn agree(c : Checks, s : LumenSession, when : string) : void {
        let scene : LumenScene = s.env.scene;
        let toward : Vec3 = s.env.sky.sunDir;
        let r : Pcg32 = new Pcg32(33, 8);
        let mut sunny : i32 = 0;
        let mut shaded : i32 = 0;
        let mut wrong : i32 = 0;
        for (k of 0..30000) {
            let x : i32 = 3 + (r.nextF32() * ((scene.sx - 6) as f32)) as i32;
            let z : i32 = 3 + (r.nextF32() * ((scene.sx - 6) as f32)) as i32;
            let top : i32 = scene.columnTop(x, z);
            if (top > 12 && top < 55 && scene.at(x, top, z) != LumenBlock::Water.id()) {
                let px : f32 = x as f32 + (0.5 as f32);
                let pz : f32 = z as f32 + (0.5 as f32);
                let at : Vec3 = Vec3::make(px, top as f32 + (1.55 as f32), pz);
                let probe : LumenLightSample = s.env.lightAt(at);
                // The engine bakes from the middle of the cell, so the ray starts there too.
                let probeRay : Ray = Ray::make(
                    Vec3::make(px, top as f32 + (1.5 as f32), pz),
                    Vec3::make(toward.x, toward.y, toward.z)
                );
                let seen : Vec3 = scene.visibility(probeRay, 400.0, 0);
                let baked : bool = probe.sun > 0.5;
                let ray : bool = seen.maxComponent() > 0.5;
                if (probe.sun > 0.92 && ray) {
                    sunny = sunny + 1;
                } else if (probe.sun < 0.08 && !ray) {
                    shaded = shaded + 1;
                } else if ((probe.sun > 0.92 && !ray) || (probe.sun < 0.08 && ray)) {
                    wrong = wrong + 1;
                }
            }
        }
        c.that(
            "the baked sun has both lit and shaded ground in it, ${when} (${sunny} lit, ${shaded} shaded)",
            sunny > 200 && shaded > 30
        );
        c.that(
            "where the volume is sure (lit or shaded) a ray agrees, ${when}, to within 3 per cent (${wrong} of ${sunny + shaded + wrong} disagree)",
            wrong * 33 < sunny + shaded + wrong
        );
    }

    // A lamp's colour reaches the light volume, and its layers reach the light.
    static fn lamps(c : Checks, s : LumenSession) : void {
        let book = s.env.lamps;
        let mut teal : i32 = -1;
        let mut candle : i32 = -1;
        for (i of 0..book.specs.len()) {
            // The last teal lamp is the farthest out on the pier, away from the warm lamps of the cabin.
            let spec : LumenLampSpec = book.specs.get(i);
            if (spec.colour.x < 0.5 && spec.colour.y > 0.8) {
                teal = i;
            }
            if (candle < 0 && spec.exclude.bits != 0) {
                candle = i;
            }
        }
        c.that("a teal pier lamp and a candle lamp exist", teal >= 0 && candle >= 0);
        let t : LumenLampSpec = book.specs.get(teal);
        let beside : Vec3 = Vec3::make(t.x as f32 + 1.5, t.y as f32 + 0.5, t.z as f32 + 0.5);
        let near : LumenLightSample = s.env.lightAt(beside);
        c.that(
            "the teal lamp's fill is teal: more green than red",
            near.block.y > near.block.x * (1.5 as f32)
        );
        c.that("and it is not dark", near.block.y > 0.05);
        let candleLight : LightSource = book.lights.get(candle);
        c.that(
            "the candle lamp lights terrain",
            candleLight.mayLight(LumenLayers::only(LumenLayer::Terrain).bits, 0)
        );
        c.that("and never foliage", !candleLight.mayLight(LumenLayers::only(LumenLayer::Foliage).bits, 0));
        let far : i32 = book.far.get(0);
        c.that(
            "the beacon is a far lamp that goes through glass and leaves",
            book.specs.get(far).pass.has(LumenObstacle::Glass)
                && book.specs.get(far).pass.has(LumenObstacle::Foliage)
        );
    }

    // A ray straight down onto a leaf stops there, unless it is told to ignore foliage.
    static fn passes(c : Checks, s : LumenSession) : void {
        let scene : LumenScene = s.env.scene;
        let mut found : bool = false;
        let mut lx : i32 = 0;
        let mut ly : i32 = 0;
        let mut lz : i32 = 0;
        for (z of 0..scene.sz) {
            for (x of 0..scene.sx) {
                if (found) {
                    continue;
                }
                let top : i32 = scene.columnTop(x, z);
                if (top >= 0 && scene.at(x, top, z) == LumenBlock::Leaves.id() && top < 60) {
                    found = true;
                    lx = x;
                    ly = top;
                    lz = z;
                }
            }
        }
        c.that("the world has a tree", found);
        let from : f32 = (ly + 3) as f32;
        let down : Ray = Ray::make(
            Vec3::make(lx as f32 + 0.5, from, lz as f32 + 0.5),
            Vec3::make(0.0, -1.0, 0.0)
        );
        let stopped : LumenHit = scene.trace(down, 80.0, true, 0);
        c.that("a ray down onto a treetop stops in the foliage or a leaf hole", stopped.hit);
        let through : LumenHit = scene.trace(
            down,
            80.0,
            true,
            LumenObstacles::only(LumenObstacle::Foliage).bits
        );
        c.that(
            "the same ray ignoring foliage never stops at a leaf",
            through.hit && through.block != LumenBlock::Leaves.id()
        );
    }

    // The cached sky agrees with the integral it caches, away from the sun's glow.
    static fn sky(c : Checks, s : LumenSession) : void {
        s.setDay(0.5);
        let real : LightSky = LightSky::atDayTime(0.5, 0.25);
        let r : Pcg32 = new Pcg32(11, 2);
        let mut worst : f32 = 0.0;
        for (k of 0..200) {
            let a : f32 = r.nextF32() * (6.2831 as f32);
            let e : f32 = (0.1 as f32) + r.nextF32() * (1.2 as f32);
            let dir : Vec3 = Vec3 {
                x: ludax::sin(a) * ludax::cos(e),
                y: ludax::sin(e),
                z: ludax::cos(a) * ludax::cos(e),
            };
            if (dir.dot(real.sunDirection()) < (0.9 as f32)) {
                let want : Vec3 = real.skyRadiance(dir);
                let got : Vec3 = s.env.sky.base(dir);
                let err : f32 = ludax::abs(got.y - want.y) / (want.y + (0.01 as f32));
                if (err > worst) {
                    worst = err;
                }
            }
        }
        c.that("the sky map is within 6 per cent of the integral (worst ${worst})", worst < (0.06 as f32));
        LumenSelfTest::shafts(c);
    }

    // The light shafts are smooth and bounded. They used to add a step each time the march toward the sun left the
    // picture, a band across the sky every few degrees, and a fixed step pattern drew columns over the leaves. The
    // shaft of a pixel is averaged over 24 frames of jitter, as the frame does, and checked on an open sky and on
    // a sky seen through gaps: no pixel differs from its neighbour by more than a few per cent, and every one lies
    // in 0..1. The sun is in the picture, beside it and far above it.
    static fn shafts(c : Checks) : void {
        let n : i64 = (SHAFT_W as i64) * (SHAFT_H as i64);
        let mut open : i32[] = new i32[n];
        let mut gaps : i32[] = new i32[n];
        for (y of 0..SHAFT_H) {
            for (x of 0..SHAFT_W) {
                let i : i64 = (y as i64) * (SHAFT_W as i64) + (x as i64);
                open[i] = WORKER_SKY;
                gaps[i] = 1;
                if (ludax::lnHash(x / 10, y / 10, 0, 9) % 3 == 0) {
                    gaps[i] = WORKER_SKY;
                }
            }
        }
        let mut worstOpen : f32 = 0.0;
        let mut worstGaps : f32 = 0.0;
        for (k of 0..6) {
            let sun : Vec3 = Vec3 {
                x: (SHAFT_W as f32) * ((0.5 as f32) + ((k % 3) as f32) * (0.9 as f32)),
                y: ((k / 3) as f32) * (SHAFT_H as f32) * (-3.0 as f32) + (SHAFT_H as f32) * (0.4 as f32),
                z: 1.0,
            };
            worstOpen = ludax::max(worstOpen, LumenSelfTest::roughness(open, sun));
            worstGaps = ludax::max(worstGaps, LumenSelfTest::roughness(gaps, sun));
        }
        c.that(
            "light shafts over an open sky have no band (steepest step ${worstOpen})",
            worstOpen < (0.06 as f32)
        );
        c.that(
            "light shafts over leaf gaps are smooth (steepest step ${worstGaps})",
            worstGaps < (0.2 as f32)
        );
    }

    // The steepest step between neighbouring pixels of the 24-frame mean shaft over the sky mask `mask`, away from
    // the border strip; a value outside 0..1 counts as a step of its own size, so a bound that fails fails the
    // check that calls this.
    static fn roughness(mask : i32[], sun : Vec3) : f32 {
        let n : i64 = (SHAFT_W as i64) * (SHAFT_H as i64);
        let mut mean : f32[] = new f32[n];
        let mut pos : f32[] = new f32[n * 3];
        for (i of 0..(n * 3)) {
            pos[i] = 0.0;
        }
        for (frame of 0..24) {
            let plane : ShaftPlane = ShaftPlane {
                w: SHAFT_W,
                h: SHAFT_H,
                sids: mask,
                sky: WORKER_SKY,
                pos: pos,
                eye: Vec3::zero(),
                sun: sun,
                frame: frame,
            };
            for (y of 0..SHAFT_H) {
                for (x of 0..SHAFT_W) {
                    let i : i64 = (y as i64) * (SHAFT_W as i64) + (x as i64);
                    let v : f32 = LumenShaft::march(plane, x, y);
                    mean[i] = mean[i] + v / (24.0 as f32);
                    if (v < 0.0 || v > 1.0) {
                        mean[i] = mean[i] + (100.0 as f32);
                    }
                }
            }
        }
        // The mean of 24 frames still carries the jitter's residue, about 0.03 a pixel, which a step between two
        // neighbours would count twice; a 5 x 5 box mean of it leaves what is coherent, the way a band is. The
        // window ramps the shaft down over the picture's border strip, as steeply as the strip is narrow in this
        // small picture, so the steps are measured inside it.
        let strip : i32 = SHAFT_H / 6;
        let mut worst : f32 = 0.0;
        for (y of strip..(SHAFT_H - strip)) {
            for (x of strip..(SHAFT_W - strip)) {
                let here : f32 = LumenSelfTest::box(mean, x, y);
                worst = ludax::max(worst, ludax::abs(here - LumenSelfTest::box(mean, x - 1, y)));
                worst = ludax::max(worst, ludax::abs(here - LumenSelfTest::box(mean, x, y - 1)));
            }
        }
        return worst;
    }

    // The mean of the 5 x 5 pixels around (x, y) of `v`, a picture SHAFT_W wide.
    static fn box(v : f32[], x : i32, y : i32) : f32 {
        let mut sum : f32 = 0.0;
        for (dy of -2..3) {
            for (dx of -2..3) {
                sum = sum + v[((y + dy) as i64) * (SHAFT_W as i64) + ((x + dx) as i64)];
            }
        }
        return sum / (25.0 as f32);
    }
}

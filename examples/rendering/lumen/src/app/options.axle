// options — the command line.
//
//   --frame FILE      render one picture to a BMP and exit (no window)
//   --shot N          start at hero viewpoint 1..4 (default 1)
//   --time T          time of day 0..1: 0.25 sunrise, 0.5 noon, 0.75 sunset, 0 midnight
//   --yaw A           turn the viewpoint to the heading A in radians, 0 to 6.28 (0 faces north, 1.57 east)
//   --x X, --z Z      put the viewpoint at world column X or Z (the world is 320 cells across)
//   --down A          tip the viewpoint down by A radians, -1.5 (up) to 1.5
//   --altitude Y      put the viewpoint at height Y cells, 1 to 62
//   --samples N       samples per pixel for --frame (default 64)
//   --size WxH        render size, e.g. 960x540
//   --scale N         show the picture N times larger than it is rendered (default 1)
//   --view N          debug view: 0 final 1 albedo 2 normal 3 direct 4 indirect 5 depth 6 flood 7 access 8 raw
//   --threads N       worker threads (default: all but one)
//   --drift           turn and move the camera during the --frame render, to judge the picture in motion
//   --map FILE        write a top-down map of the world to a BMP, one pixel a column, and exit
//   --bench           time the stages of a frame at the chosen viewpoint and exit
//   --flicker         measure how much a still picture changes from frame to frame and exit
//   --prof            time the renderer's inner loops one call at a time and exit
//   --no-lamps        lamps cast no shadows or highlights (their baked light stays)
//   --no-bounce       no traced diffuse bounce: the baked tint only
//   --no-rays         no light shafts
//   --denoise         switch the spatial filter on (off by default: the light is baked, there is no noise)
//   --fog F           fog density scale, 0 off, 1 default
//   --bloom F         bloom strength, 0 off, 0.32 default
//   --exposure S      exposure compensation in stops, -4 to 4
//   --softness R      angular radius of the sun's shadows in radians, 0 to 0.2 (default 0.03)
//   --selftest        check the light of the world against known answers and exit
//   --help            print this

use std::lang::IndexOutOfBoundsException;
use std::sys::process::{argc, argAt};

use ludax::JobPool;
use ludax::{LumenSettings, LumenView};

// The ASCII codes `number`, `decimal` and `size` look for.
const CLI_ZERO : i32 = 48;
const CLI_NINE : i32 = 57;
const CLI_DOT : i32 = 46;
const CLI_X : i32 = 120;
const CLI_MINUS : i32 = 45;

// The ranges the numeric options accept: the hero viewpoints, fog and bloom strengths, exposure stops, and the
// sun's angular radius in radians.
const SHOT_MAX : i32 = 4;
const STRENGTH_MAX : f64 = 8.0;
const EXPOSURE_MAX : f64 = 4.0;
const SOFTNESS_MAX : f64 = 0.2;

/** What the command line asked for. */
pub class Options {
    /** File to render to, or empty for the window. */
    pub frame : string = "";

    /** Hero viewpoint, 1..4. */
    pub shot : i32 = 1;

    /** Time of day override, or -1 to take the viewpoint's own. */
    pub time : f64 = -1.0;

    /** Heading override in radians, or -1 for the viewpoint's own. */
    pub yaw : f64 = -1.0;

    /** Column override x, or -1 for the viewpoint's own. */
    pub atX : f64 = -1.0;

    /** Column override z, or -1 for the viewpoint's own. */
    pub atZ : f64 = -1.0;

    /** Downward tilt in radians (negative looks up), or -999 to keep the viewpoint's own. */
    pub down : f64 = -999.0;

    /** Altitude override, or -1 for the viewpoint's own. */
    pub altitude : f64 = -1.0;

    /** Samples per pixel of a --frame render. */
    pub samples : i32 = 64;

    /** Render width. */
    pub width : i32 = 0;

    /** Render height. */
    pub height : i32 = 0;

    /** Display scale. */
    pub scale : i32 = 1;

    /** Debug view. */
    pub view : i32 = 0;

    /** Worker threads, or 0 for the default. */
    pub threads : i32 = 0;

    /** Move the camera while rendering a --frame picture. */
    pub drift : bool = false;

    /** Measure how much the picture changes from frame to frame instead. */
    pub flicker : bool = false;

    /** True: lamps are baked light only, with no shadows or highlights of their own. */
    pub noLamps : bool = false;

    /** True: no traced diffuse bounce. */
    pub noBounce : bool = false;

    /** True: no light shafts. */
    pub noRays : bool = false;

    /** True: switch the spatial filter on. */
    pub denoise : bool = false;

    /** Fog density scale, or -1 to keep the default. */
    pub fog : f64 = -1.0;

    /** Bloom strength, or -1 to keep the default. */
    pub bloom : f64 = -1.0;

    /** Sun shadow softness in radians, or -1 to keep the default. */
    pub softness : f64 = -1.0;

    /** Exposure compensation in stops, added to the automatic exposure. */
    pub exposure : f64 = 0.0;

    /** File to write the map of the world to, or empty. */
    pub map : string = "";

    /** Time the stages of a frame instead of rendering a picture. */
    pub bench : bool = false;

    /** True: measure the renderer's inner loops one call at a time. */
    pub prof : bool = false;

    /** Run the checks instead. */
    pub selftest : bool = false;

    /** Print the usage. */
    pub help : bool = false;

    /** True for `--valley`, which only selects this original mode. */
    pub valley : bool = false;

    /** A mistake in the arguments, or empty. */
    pub problem : string = "";

    /** Options with every default. */
    constructor() {}

    /** The number of worker threads to start: the one asked for, else every core but one. */
    pub fn workerCount(self) : i32 {
        if (self.threads < 1) {
            return JobPool::defaultWorkers();
        }
        return self.threads;
    }

    /** The debug view the `--view` number stands for. */
    pub fn viewChosen(self) : LumenView {
        return match self.view {
            1 => LumenView::Albedo,
            2 => LumenView::Normal,
            3 => LumenView::Direct,
            4 => LumenView::Indirect,
            5 => LumenView::Depth,
            6 => LumenView::Flood,
            7 => LumenView::Access,
            8 => LumenView::Raw,
            _ => LumenView::Final,
        };
    }

    /** Puts every renderer option the command line named into `s`; the ones it did not name stay as they are. */
    pub fn applyTo(self, s : LumenSettings) : void {
        s.view = self.viewChosen();
        s.lamps = !self.noLamps;
        s.bounce = !self.noBounce;
        s.godRays = !self.noRays;
        s.denoise = self.denoise;
        s.exposureBias = self.exposure as f32;
        if (self.fog >= 0.0) {
            s.fog = self.fog as f32;
        }
        if (self.bloom >= 0.0) {
            s.bloom = self.bloom as f32;
        }
        if (self.softness >= 0.0) {
            s.sunSoftness = self.softness as f32;
        }
    }
}

/** Command-line parsing. */
pub class Cli {
    /** Reads the arguments of the running program. */
    pub static fn parse() : Options {
        let mut o : Options = new Options();
        let mut i : i32 = 1;
        while (i < argc() && o.problem.length == 0) {
            let arg : string = Cli::argument(i);
            if (arg == "--selftest") {
                o.selftest = true;
            } else if (arg == "--flicker") {
                o.flicker = true;
            } else if (arg == "--bench") {
                o.bench = true;
            } else if (arg == "--prof") {
                o.prof = true;
            } else if (arg == "--drift") {
                o.drift = true;
            } else if (arg == "--no-lamps") {
                o.noLamps = true;
            } else if (arg == "--no-bounce") {
                o.noBounce = true;
            } else if (arg == "--no-rays") {
                o.noRays = true;
            } else if (arg == "--denoise") {
                o.denoise = true;
            } else if (arg == "--valley") {
                o.valley = true;
            } else if (arg == "--help" || arg == "-h") {
                o.help = true;
            } else if (Cli::needsValue(arg)) {
                i = i + 1;
                if (i >= argc()) {
                    o.problem = "${arg} needs a value";
                } else {
                    Cli::withValue(o, arg, Cli::argument(i));
                }
            } else {
                o.problem = "unknown argument ${arg}";
            }
            i = i + 1;
        }
        return o;
    }

    // True when the option `name` takes the argument that follows it as its value.
    static fn needsValue(name : string) : bool {
        return name == "--map" || name == "--frame" || name == "--shot" || name == "--time" || name == "--yaw"
            || name == "--down"
            || name == "--x"
            || name == "--z"
            || name == "--altitude"
            || name == "--samples"
            || name == "--size"
            || name == "--scale"
            || name == "--view"
            || name == "--fog"
            || name == "--bloom"
            || name == "--exposure"
            || name == "--softness"
            || name == "--threads";
    }

    static fn argument(i : i32) : string {
        try {
            return argAt(i) + "";
        } catch e : IndexOutOfBoundsException {
            return "";
        }
    }

    static fn withValue(o : Options, name : string, value : string) : void {
        if (name == "--map") {
            o.map = value;
        } else if (name == "--frame") {
            o.frame = value;
        } else if (name == "--time") {
            o.time = Cli::decimal(value);
            if (o.time < 0.0) {
                o.problem = "--time needs a number from 0 to 1";
            }
        } else if (name == "--yaw") {
            o.yaw = Cli::decimal(value);
            if (o.yaw < 0.0) {
                o.problem = "--yaw needs a number from 0 to 6.28";
            }
        } else if (name == "--down") {
            Cli::tilt(o, value);
        } else if (name == "--x") {
            o.atX = Cli::decimal(value);
        } else if (name == "--z") {
            o.atZ = Cli::decimal(value);
        } else if (name == "--altitude") {
            o.altitude = Cli::decimal(value);
            if (o.altitude < 1.0) {
                o.problem = "--altitude needs a number from 1 to 62";
            }
        } else if (name == "--size") {
            Cli::size(o, value);
        } else if (name == "--fog" || name == "--bloom") {
            Cli::strength(o, name, value);
        } else if (name == "--softness") {
            o.softness = Cli::decimal(value);
            if (o.softness < 0.0 || o.softness > SOFTNESS_MAX) {
                o.problem = "--softness needs a number from 0 to 0.2";
            }
        } else if (name == "--exposure") {
            Cli::stops(o, value);
        } else {
            let n : i32 = Cli::number(value);
            if (n < 0) {
                o.problem = "${name} needs a whole number, not ${value}";
            } else if (name == "--shot") {
                o.shot = n;
                if (n < 1 || n > SHOT_MAX) {
                    o.problem = "--shot needs a viewpoint from 1 to 4";
                }
            } else if (name == "--samples") {
                o.samples = n;
            } else if (name == "--scale") {
                o.scale = n;
            } else if (name == "--view") {
                o.view = n;
            } else {
                o.threads = n;
            }
        }
    }

    // Reads the non-negative strength of `--fog` or `--bloom`.
    static fn strength(o : Options, name : string, value : string) : void {
        let v : f64 = Cli::decimal(value);
        if (v < 0.0 || v > STRENGTH_MAX) {
            o.problem = "${name} needs a number from 0 to 8";
            return;
        }
        if (name == "--fog") {
            o.fog = v;
        } else {
            o.bloom = v;
        }
    }

    // Reads --down, a decimal with an optional minus sign (a negative tilt looks up).
    static fn tilt(o : Options, value : string) : void {
        let mut digits : string = value;
        let negative : bool = value.length > 0 && value.byteAt(0) == CLI_MINUS;
        if (negative) {
            try {
                digits = value.substring(1, value.byteLength as i32);
            } catch e : IndexOutOfBoundsException {
                o.problem = "--down needs a number of radians from -1.5 to 1.5";
                return;
            }
        }
        let v : f64 = Cli::decimal(digits);
        if (v < 0.0) {
            o.problem = "--down needs a number of radians from -1.5 to 1.5";
            return;
        }
        o.down = v;
        if (negative) {
            o.down = -v;
        }
    }

    // Reads the exposure compensation, a decimal with an optional minus sign.
    static fn stops(o : Options, value : string) : void {
        let mut digits : string = value;
        let negative : bool = value.length > 0 && value.byteAt(0) == CLI_MINUS;
        if (negative) {
            try {
                digits = value.substring(1, value.byteLength as i32);
            } catch e : IndexOutOfBoundsException {
                o.problem = "--exposure needs a number of stops from -4 to 4";
                return;
            }
        }
        let v : f64 = Cli::decimal(digits);
        if (v < 0.0 || v > EXPOSURE_MAX) {
            o.problem = "--exposure needs a number of stops from -4 to 4";
            return;
        }
        o.exposure = v;
        if (negative) {
            o.exposure = -v;
        }
    }

    // Reads WxH.
    static fn size(o : Options, value : string) : void {
        let mut at : i32 = -1;
        for (i of 0..value.byteLength) {
            if (value.byteAt(i) == CLI_X) {
                at = i as i32;
            }
        }
        if (at < 1) {
            o.problem = "--size needs WxH, e.g. 960x540";
            return;
        }
        try {
            o.width = Cli::number(value.substring(0, at));
            o.height = Cli::number(value.substring(at + 1, value.byteLength as i32));
        } catch e : IndexOutOfBoundsException {
            o.problem = "--size needs WxH, e.g. 960x540";
            return;
        }
        if (o.width < 16 || o.height < 16) {
            o.problem = "--size needs WxH of at least 16x16";
        }
    }

    // The non-negative whole number written in `s`, or -1.
    static fn number(s : string) : i32 {
        if (s.length == 0) {
            return -1;
        }
        let mut n : i32 = 0;
        for (i of 0..s.byteLength) {
            let d : i32 = s.byteAt(i);
            if (d < CLI_ZERO || d > CLI_NINE) {
                return -1;
            }
            n = n * 10 + (d - CLI_ZERO);
        }
        return n;
    }

    // A decimal like 0.25, or -1 when it is not one.
    static fn decimal(s : string) : f64 {
        if (s.length == 0) {
            return -1.0;
        }
        let mut whole : f64 = 0.0;
        let mut frac : f64 = 0.0;
        let mut scale : f64 = 1.0;
        let mut seenDot : bool = false;
        for (i of 0..s.byteLength) {
            let d : i32 = s.byteAt(i);
            if (d == CLI_DOT && !seenDot) {
                seenDot = true;
            } else if (d < CLI_ZERO || d > CLI_NINE) {
                return -1.0;
            } else if (seenDot) {
                scale = scale / 10.0;
                frac = frac + (d - CLI_ZERO) as f64 * scale;
            } else {
                whole = whole * 10.0 + (d - CLI_ZERO) as f64;
            }
        }
        return whole + frac;
    }

    /** The usage text. */
    pub static fn usage() : string {
        return "lumen [--map FILE.bmp] [--frame FILE.bmp] [--shot 1..4] [--time 0..1] [--yaw A] [--down A] [--x X] [--z Z] [--altitude Y] [--samples N] [--size WxH] [--scale N] [--view N] [--threads N] [--drift] [--flicker] [--bench] [--prof] [--no-lamps] [--no-bounce] [--no-rays] [--denoise] [--fog F] [--bloom F] [--exposure S] [--softness R] [--selftest]\n"
            + "  click captures the mouse (Esc releases), WASD move, Space up, Shift down, Ctrl sprint, Q/E time of day, T auto time, 1-4 viewpoints\n"
            + "  V cycle debug view, B bounce, L lamps, G light shafts, F fog, O bloom, X exposure, R spatial filter, I invert mouse, F12 screenshot, Esc quit";
    }
}

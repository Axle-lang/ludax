// env — everything a ray needs to know about the world, gathered in one place.
//
// The world (scene), its baked light (volumes), the sky of the moment, the point lights, the BRDF table and the
// settings. The workers of a frame all read one `LumenEnv`; between frames the interface changes the time of
// day and the settings. Nothing in it is written while a frame is being drawn.

use ludax::{LightDfgTable, Vec3, saturate};
use ludax::{LumenLightSample, LumenSky, LumenSettings};

use crate::light::lamps::LumenLamps;
use crate::light::lightvol::LumenLight;
use crate::world::scene::LumenScene;

// The split-sum DFG table: 24 roughness steps by 48 N.V steps, enough that a lookup interpolates smoothly.
const ENV_DFG_ROUGH : i32 = 24;
const ENV_DFG_NV : i32 = 48;

// How much the eye's own sky access opens the fog and the light shafts: a cave has none, a clearing has all.
const ENV_OPEN_GAIN : f32 = 1.6;

/** The world as the shader sees it. */
pub class LumenEnv {
    /** The flat blocks and the ray walker over them. */
    pub scene : LumenScene;

    /** The baked light volumes read by every shading call. */
    pub vol : LumenLight;

    /** The sky of the current moment: its radiance map, dome and lights. */
    pub sky : LumenSky;

    /** The world's lamps as point lights, with their spatial index. */
    pub lamps : LumenLamps;

    /** The split-sum DFG table shared by every shaded point. */
    pub dfg : LightDfgTable;

    /** The knobs the interface changes between frames. */
    pub settings : LumenSettings;

    /** Seconds of animation: waves, lava, flames, clouds. */
    pub time : f32 = 0.0;

    /** Gathers the pieces. */
    constructor(own scene : LumenScene, own vol : LumenLight, own sky : LumenSky, own lamps : LumenLamps) {
        self.scene = scene;
        self.vol = vol;
        self.sky = sky;
        self.lamps = lamps;
        self.dfg = new LightDfgTable(ENV_DFG_ROUGH, ENV_DFG_NV);
        self.settings = new LumenSettings();
    }

    /**
     * How open to the sky the eye is, 0 in a cave to 1 in the open: what scales the fog and the light shafts so
     * that neither fills a room the sun cannot reach.
     */
    pub fn eyeOpen(self, eye : Vec3) : f32 {
        let here : LumenLightSample = self.lightAt(eye);

        return saturate(here.sky * ENV_OPEN_GAIN);
    }

    /** The baked light at the point `p` of the world: block light, sky, bounce tint and the sun's and moon's share. */
    pub fn lightAt(self, p : Vec3) : LumenLightSample {
        return self.vol.sample(self.scene, p);
    }

    /** Advances the animation clock; the cloud deck and the stars share it. */
    pub fn setTime(mut self, seconds : f32) : void {
        self.time = seconds;
        self.sky.time = seconds;
    }
}

// forest — the trees: where they stand, how tall their trunks are and what shape their crowns take.
//
// One tree is tried per cell of a coarse lattice and jittered inside it, so the woods look scattered but are the
// same on every run: every decision is a hash of the cell under its own seed, never a random draw. Density follows
// a slow noise (thick woods, open meadows), trees keep away from buildings and out of the water and the snow.
// Half of the trees are pines (a cone), the rest broad-leaved (a squashed ball), and a fifth are birches.

use ludax::{VoxelGrid, abs};
use ludax::{lnFbm2, lnUnit};

use crate::world::blocks::LumenBlock;
use crate::world::layout::{WORLD_XZ, WORLD_SEA, WgCell, nearSite};
use crate::world::terrain::worldHeight;

/** Trees are tried on a lattice of this many cells, each jittered within its own cell. */
const FOREST_LATTICE : i32 = 5;

/** A tree stands this many cells off its lattice point at most, along each axis. */
const FOREST_JITTER : f32 = 4.0;

/** Trees stand at least this far above the water, so shores stay bare, and at most at `FOREST_LINE`. */
const FOREST_SHORE : i32 = 3;
const FOREST_LINE : i32 = 32;

/** The density noise: frequency, octaves and seed, and the density below which no tree grows. */
const FOREST_DENSITY_FREQ : f32 = 0.05;
const FOREST_DENSITY_OCTAVES : i32 = 3;
const FOREST_DENSITY_SEED : i32 = 9;
const FOREST_DENSITY_MIN : f32 = 0.42;

/** Even in the thick of the woods a hash above this drops the tree, so they are not a regular grid. */
const FOREST_KEEP : f32 = 0.8;

/** Trees keep this many cells from a cabin or a tower. */
const FOREST_SITE_CLEAR : f32 = 8.0;

/** One hash seed per decision, so the decisions of one tree do not follow each other. */
const FOREST_SEED_JITTER_X : i32 = 201;
const FOREST_SEED_JITTER_Z : i32 = 202;
const FOREST_SEED_KEEP : i32 = 203;
const FOREST_SEED_KIND : i32 = 204;
const FOREST_SEED_TRUNK : i32 = 205;
const FOREST_SEED_CROWN : i32 = 206;

/** A kind hash above this is a birch; below `FOREST_PINE_BELOW` a pine; in between a broad-leaved tree. */
const FOREST_BIRCH_ABOVE : f32 = 0.8;
const FOREST_PINE_BELOW : f32 = 0.5;

/** A trunk is this many logs tall at least, and up to `FOREST_TRUNK_SPREAD` more. */
const FOREST_TRUNK_MIN : i32 = 4;
const FOREST_TRUNK_SPREAD : f32 = 4.0;

/** A broad crown is a ball of this radius, and up to `FOREST_CROWN_SPREAD` cells more. */
const FOREST_CROWN_MIN : i32 = 2;
const FOREST_CROWN_SPREAD : f32 = 2.0;

/** The ball is squashed: a cell's height counts this much more than its width, so the crown is flatter than round. */
const FOREST_CROWN_SQUASH : i32 = 2;

/** A cell belongs to the ball when its distance from the middle is within the radius plus this. */
const FOREST_CROWN_SLACK : f32 = 0.3;

/** A pine's skirt widens by this many cells from the top layer to the bottom one. */
const FOREST_PINE_FLARE : i32 = 3;

/** A pine's corner cell is left out when its squared distance passes the squared radius by more than this. */
const FOREST_PINE_CORNER : f32 = 0.5;

/**
 * Grows the tree of the lattice cell whose south-west corner is column (gx, gz), if its hashes allow one there.
 */
fn forestTree(grid : Shared<VoxelGrid>, gx : i32, gz : i32) : void {
    let x : i32 = gx + (lnUnit(gx, 1, gz, FOREST_SEED_JITTER_X) * FOREST_JITTER) as i32;
    let z : i32 = gz + (lnUnit(gx, 2, gz, FOREST_SEED_JITTER_Z) * FOREST_JITTER) as i32;
    let h : i32 = worldHeight(x, z);
    if (h < WORLD_SEA + FOREST_SHORE || h > FOREST_LINE) {
        return;
    }
    if (grid.blockAt(x, h, z) != LumenBlock::Grass.id()) {
        return;
    }

    let fx : f32 = x as f32;
    let fz : f32 = z as f32;
    let density : f32 = lnFbm2(
        fx * FOREST_DENSITY_FREQ,
        fz * FOREST_DENSITY_FREQ,
        FOREST_DENSITY_OCTAVES,
        FOREST_DENSITY_SEED
    );
    if (density < FOREST_DENSITY_MIN || lnUnit(x, 3, z, FOREST_SEED_KEEP) > FOREST_KEEP) {
        return;
    }
    if (nearSite(x, z, FOREST_SITE_CLEAR)) {
        return;
    }

    let kind : f32 = lnUnit(x, 4, z, FOREST_SEED_KIND);
    let trunk : i32 = FOREST_TRUNK_MIN + (lnUnit(x, 5, z, FOREST_SEED_TRUNK) * FOREST_TRUNK_SPREAD) as i32;
    let mut log : i32 = LumenBlock::Log.id();
    if (kind > FOREST_BIRCH_ABOVE) {
        log = LumenBlock::Birch.id();
    }
    for (i of 1..(trunk + 1)) {
        grid.setBlock(x, h + i, z, log);
    }

    let top : WgCell = WgCell::at(x, h + trunk, z);
    if (kind < FOREST_PINE_BELOW) {
        pine(grid, top, trunk);
        return;
    }
    let radius : i32 = FOREST_CROWN_MIN + (lnUnit(x, 6, z, FOREST_SEED_CROWN) * FOREST_CROWN_SPREAD) as i32;
    blob(grid, top, radius);
}

/** Grows every tree of the world: one try per lattice cell. */
pub fn forestGrow(grid : Shared<VoxelGrid>) : void {
    for (z of 0..(WORLD_XZ / FOREST_LATTICE)) {
        for (x of 0..(WORLD_XZ / FOREST_LATTICE)) {
            forestTree(grid, x * FOREST_LATTICE, z * FOREST_LATTICE);
        }
    }
}

// A ball of leaves of radius `r` around `c`, squashed in height, that grows only into air.
fn blob(grid : Shared<VoxelGrid>, c : WgCell, r : i32) : void {
    for (dz of -r..(r + 1)) {
        for (dy of -r..(r + 1)) {
            for (dx of -r..(r + 1)) {
                let d : f32 = ((dx * dx + dy * dy * FOREST_CROWN_SQUASH + dz * dz) as f32).sqrt();
                let at : WgCell = WgCell::at(c.x + dx, c.y + dy, c.z + dz);
                if (d <= (r as f32) + FOREST_CROWN_SLACK && grid.blockAt(at.x, at.y, at.z) == 0) {
                    grid.setBlock(at.x, at.y, at.z, LumenBlock::Leaves.id());
                }
            }
        }
    }
}

// A pine's cone of leaves from the top of a trunk of `trunk` logs, `top` being the trunk's last cell. The top layer
// is a single leaf; each layer below is wider, with its corners cut so it reads as round.
fn pine(grid : Shared<VoxelGrid>, top : WgCell, trunk : i32) : void {
    let layers : i32 = trunk + 1;
    for (i of 0..layers) {
        let y : i32 = top.y + 1 - i;
        let r : i32 = 1 + (i * FOREST_PINE_FLARE) / layers;
        let isTip : bool = i == 0;
        for (dz of -r..(r + 1)) {
            for (dx of -r..(r + 1)) {
                let corner : bool = abs((dx * dx + dz * dz) as f32) > (r * r) as f32 + FOREST_PINE_CORNER;
                let off : bool = isTip && (dx != 0 || dz != 0);
                if (!corner && !off && grid.blockAt(top.x + dx, y, top.z + dz) == 0) {
                    grid.setBlock(top.x + dx, y, top.z + dz, LumenBlock::Leaves.id());
                }
            }
        }
    }
}

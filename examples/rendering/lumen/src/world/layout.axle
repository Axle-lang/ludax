// layout — where things are in the world: its size, its sea, the valley and the sites buildings stand on.
//
// The generator is four files (terrain, forest, buildings and the `worldgen` that runs them) and all four need the
// same few facts: how big the world is, how high the water stands, where the cabins and towers are. They live
// here, in one place, so a building can be moved by editing a number and the land, the trees and the lamps follow.
// Sites are plain data (`WgSite`); the helpers answer distances on the ground plane, which is all the generator
// ever asks of two places.

/** Width and depth of the world in cells. */
pub const WORLD_XZ : i32 = 320;

/** Height of the world in cells. */
pub const WORLD_Y : i32 = 64;

/** The water surface: the top cell of the lake is at this height. */
pub const WORLD_SEA : i32 = 13;

/** Where the original valley sits in the world: its south-west corner, in cells. The valley is 160 cells across. */
pub const WORLD_VALLEY : i32 = 80;

/** Cells along an edge of a chunk of the voxel grid. */
pub const WORLD_CHUNK : i32 = 16;

/** The level cabins stand on. */
pub const PAD_Y : i32 = 17;

/** How far above the sea the hill under a tower is raised. */
pub const HILL_ABOVE_SEA : i32 = 8;

/** How many more cabins the land around the valley has. */
pub const SITE_CABINS : i32 = 4;

/** How many more towers the land around the valley has. */
pub const SITE_TOWERS : i32 = 2;

// The valley's own cabin, at its valley coordinates (112, 50) plus `WORLD_VALLEY`, and its tower at (137, 96).
const SITE_VALLEY_CABIN_X : i32 = 192;
const SITE_VALLEY_CABIN_Z : i32 = 130;
const SITE_VALLEY_TOWER_X : i32 = 217;
const SITE_VALLEY_TOWER_Z : i32 = 176;

/** The outer cabins, named for where they stand in the world (z grows to the south). */
const SITE_NORTH_CABIN_X : i32 = 160;
const SITE_NORTH_CABIN_Z : i32 = 44;
const SITE_WEST_CABIN_X : i32 = 44;
const SITE_WEST_CABIN_Z : i32 = 170;
const SITE_EAST_CABIN_X : i32 = 276;
const SITE_EAST_CABIN_Z : i32 = 150;
const SITE_SOUTH_CABIN_X : i32 = 160;
const SITE_SOUTH_CABIN_Z : i32 = 276;

/** The outer towers. */
const SITE_NORTHWEST_TOWER_X : i32 = 52;
const SITE_NORTHWEST_TOWER_Z : i32 = 60;
const SITE_SOUTHEAST_TOWER_X : i32 = 270;
const SITE_SOUTHEAST_TOWER_Z : i32 = 272;

/** A cabin keeps trees this much farther away than a tower does, for its porch and its pier. */
const SITE_CABIN_MARGIN : f32 = 6.0;

/** A voxel cell by its integer coordinates; two of them are the corners of a box, the far one excluded. */
pub struct WgCell {
    /** The column. */
    pub x : i32 = 0;

    /** The row. */
    pub y : i32 = 0;

    /** The depth. */
    pub z : i32 = 0;

    /** The cell (x, y, z). */
    pub static fn at(x : i32, y : i32, z : i32) : WgCell {
        return WgCell { x: x, y: y, z: z };
    }
}

/** A building site: the column (x, z) of the middle of a cabin or a tower. */
pub struct WgSite {
    /** The column of the middle. */
    pub x : i32 = 0;

    /** The depth of the middle. */
    pub z : i32 = 0;

    /** The site with its middle at column (x, z). */
    pub static fn at(x : i32, z : i32) : WgSite {
        return WgSite { x: x, z: z };
    }

    /** The site as a place on the ground plane. */
    pub fn place(self) : Vec2 {
        return wgPlace(self.x, self.z);
    }
}

/** The distance on the ground plane between two points, each as (x, z). */
pub fn wgDist(a : Vec2, b : Vec2) : f32 {
    let dx : f32 = a.x - b.x;
    let dz : f32 = a.y - b.y;
    return (dx * dx + dz * dz).sqrt();
}

/** The ground-plane place (x, z) of a cell column. */
pub fn wgPlace(x : i32, z : i32) : Vec2 {
    return Vec2 { x: x as f32, y: z as f32 };
}

/** The cabin the valley was built around. */
pub fn siteValleyCabin() : WgSite {
    return WgSite::at(SITE_VALLEY_CABIN_X, SITE_VALLEY_CABIN_Z);
}

/** The tower the valley was built around. */
pub fn siteValleyTower() : WgSite {
    return WgSite::at(SITE_VALLEY_TOWER_X, SITE_VALLEY_TOWER_Z);
}

/** The outer cabin number `i`, 0 to `SITE_CABINS - 1`: the places the land is levelled for. */
pub fn siteCabin(i : i32) : WgSite {
    return match i {
        0 => WgSite::at(SITE_NORTH_CABIN_X, SITE_NORTH_CABIN_Z),
        1 => WgSite::at(SITE_WEST_CABIN_X, SITE_WEST_CABIN_Z),
        2 => WgSite::at(SITE_EAST_CABIN_X, SITE_EAST_CABIN_Z),
        _ => WgSite::at(SITE_SOUTH_CABIN_X, SITE_SOUTH_CABIN_Z),
    };
}

/** The outer tower number `i`, 0 to `SITE_TOWERS - 1`. */
pub fn siteTower(i : i32) : WgSite {
    return match i {
        0 => WgSite::at(SITE_NORTHWEST_TOWER_X, SITE_NORTHWEST_TOWER_Z),
        _ => WgSite::at(SITE_SOUTHEAST_TOWER_X, SITE_SOUTHEAST_TOWER_Z),
    };
}

/** True when (x, z) lies within `r` cells of a cabin or a tower of the world. */
pub fn nearSite(x : i32, z : i32, r : f32) : bool {
    let at : Vec2 = wgPlace(x, z);
    let cabinReach : f32 = r + SITE_CABIN_MARGIN;
    if (wgDist(at, siteValleyCabin().place()) < cabinReach || wgDist(at, siteValleyTower().place()) < r) {
        return true;
    }

    for (i of 0..SITE_CABINS) {
        if (wgDist(at, siteCabin(i).place()) < cabinReach) {
            return true;
        }
    }
    for (i of 0..SITE_TOWERS) {
        if (wgDist(at, siteTower(i).place()) < r) {
            return true;
        }
    }
    return false;
}

// lampspec — one lamp of the world as data: everything that makes it different from the lamp next to it.
//
// A block id would give every lantern the same light. A spec is per lamp: its colour and strength, how far it
// reaches, how it flickers, which obstacle classes its light passes through (a beacon shines through its
// glass, a lantern in a tree through the leaves), which surface layers it lights, and how its shadow is found.
// The world generator emits specs; the flood gets each as an emitter override and the shader gets each as a
// point light, so the filled light and the sharp light of one lamp always agree on its colour.

use ludax::{Vec, Vec3, LightShadowMode};

use crate::world::blocks::{LUMEN_ALL_LAYERS, LumenObstacles, LumenLayers};

/** A lamp. */
pub struct LumenLampSpec {
    /** The column of the cell it sits in. */
    pub x : i32 = 0;

    /** The row of the cell it sits in. */
    pub y : i32 = 0;

    /** The depth of the cell it sits in. */
    pub z : i32 = 0;

    /** Linear colour of its light; the brightest channel is scaled to 1. */
    pub colour : Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 };

    /** Luminous intensity in candela. */
    pub candela : f32 = 9000.0;

    /** Radius of the glowing body in cells: no light is brighter than at it. */
    pub radius : f32 = 0.4;

    /** The distance at which its light ends, in cells. */
    pub range : f32 = 20.0;

    /** Share of its strength the flicker takes away and gives back, 0 steady to 1 candle. */
    pub flicker : f32 = 0.0;

    /** Speed of the flicker in radians per second. */
    pub pace : f32 = 7.0;

    /** Strength of its flooded fill: 255 is a lamp block, up to 1023. */
    pub fill : i32 = 255;

    /** The obstacle classes its light goes through as if they were air. */
    pub pass : LumenObstacles = LumenObstacles { bits: 0 };

    /** The surface layers it lights; every layer (`LUMEN_ALL_LAYERS`, spelled out: a field default must be a literal). */
    pub include : LumenLayers = LumenLayers { bits: 4294967295 };

    /** The surface layers it never lights. */
    pub exclude : LumenLayers = LumenLayers { bits: 0 };

    /** How its shadow is found: `Ray` traces one, `None` lets it shine through everything. */
    pub shadows : LightShadowMode = LightShadowMode::Ray;
}

/** The lamps a world generator has placed so far. */
pub class LumenLampBook {
    items : Vec<LumenLampSpec>;

    /** An empty book. */
    constructor() {
        self.items = new Vec<LumenLampSpec>();
    }

    /** Adds a lamp. */
    pub fn add(mut self, s : LumenLampSpec) : void {
        self.items.push(s);
    }

    /** How many lamps there are. */
    pub fn len(self) : i32 {
        return self.items.len();
    }

    /** Lamp `i`. */
    pub fn get(self, i : i32) : LumenLampSpec {
        return self.items.get(i);
    }
}

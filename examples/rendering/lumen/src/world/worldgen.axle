// worldgen — the valley: its land, buildings, trees, cave and lamps, all generated from a cell function.
//
// A lake under a snowy mountain, a lit cabin and pier, a forest, a watch tower and a crystal cave with a lava
// pool. Everything is a function of the cell, so the world is the same on every run. The composition is meant
// to show the light: open water for reflections, snow and sand for bounce, deep shade under the pines, warm
// lanterns against a cold dusk sky, and a cave lit only by coloured stone.
//
// This file only orders the work. The facts of where things stand are in `layout`, the ground, cave and
// crystals in `terrain`, the trees in `forest` and the cabins, piers, towers and their lamps in `buildings`.
// The order matters twice: buildings are written over the trees, and the lamps enter the book in the order the
// buildings are made, which is the order the renderer sees them.

use ludax::VoxelGrid;

use crate::world::buildings::Buildings;
use crate::world::forest::forestGrow;
use crate::world::lampspec::LumenLampBook;
use crate::world::layout::{
    WORLD_XZ, WORLD_Y, WORLD_CHUNK, SITE_CABINS, SITE_TOWERS, siteValleyCabin, siteValleyTower, siteCabin,
    siteTower
};
use crate::world::terrain::{terrainColumn, carveCave};

/**
 * Writes the world into `grid` and the lamps it places into `lamps`. Chunks are created for the whole volume
 * first so every cell exists.
 */
pub fn worldBuild(grid : Shared<VoxelGrid>, lamps : LumenLampBook) : void {
    for (cy of 0..(WORLD_Y / WORLD_CHUNK)) {
        for (cz of 0..(WORLD_XZ / WORLD_CHUNK)) {
            for (cx of 0..(WORLD_XZ / WORLD_CHUNK)) {
                grid.ensureChunk(cx, cy, cz);
            }
        }
    }
    for (z of 0..WORLD_XZ) {
        for (x of 0..WORLD_XZ) {
            terrainColumn(grid, x, z);
        }
    }
    carveCave(grid);
    forestGrow(grid);

    let build : Buildings = new Buildings(grid);
    build.cabin(siteValleyCabin());
    build.pier(siteValleyCabin());
    build.tower(siteValleyTower());
    build.plaza();
    build.lanternPath(siteValleyCabin(), siteValleyTower());
    for (i of 0..SITE_CABINS) {
        build.cabin(siteCabin(i));
        build.pier(siteCabin(i));
        build.lanternPath(siteCabin(i), siteTower(i % SITE_TOWERS));
    }
    for (i of 0..SITE_TOWERS) {
        build.tower(siteTower(i));
    }
    build.handOver(lamps);
}

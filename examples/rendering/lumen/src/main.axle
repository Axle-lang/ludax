// lumen — a voxel valley lit by the Ludax lighting library and ray traced on the CPU.
//
// A lake under a snowy mountain, a cabin and pier with lanterns, a forest, a watch tower with a beacon and a crystal
// cave over a lava pool, all generated from seeds; a physical sky, soft sun shadows, coloured block light, real point
// lights, one traced diffuse bounce, a lake that reflects and refracts, bloom and an eye that adapts. The sky, shading
// and post of the picture are `ludax`'s `render/pathlight`; this example owns the valley that is drawn with them.
// `app/options.axle` lists the flags (`--valley` is accepted and ignored) and `README.md` the controls.

use crate::app::headless::LumenHeadless;
use crate::app::measure::LumenMeasure;
use crate::app::options::{Cli, Options};
use crate::app::selftest::LumenSelfTest;
use crate::app::window::LumenApp;

fn main() : i32 {
    let o : Options = Cli::parse();
    if (o.problem.length > 0) {
        println(o.problem);
        println(Cli::usage());
        return 2;
    }
    if (o.help) {
        println(Cli::usage());
        return 0;
    }
    // The modes are exclusive and checked most specific first; only the fall-through opens a window.
    if (o.selftest) {
        return LumenSelfTest::run();
    }
    if (o.map.length > 0) {
        return LumenHeadless::map(o);
    }
    if (o.flicker) {
        return LumenMeasure::flicker(o);
    }
    if (o.bench) {
        return LumenMeasure::bench(o);
    }
    if (o.prof) {
        return LumenMeasure::prof(o);
    }
    if (o.frame.length > 0) {
        return LumenHeadless::run(o);
    }
    return LumenApp::run(o);
}

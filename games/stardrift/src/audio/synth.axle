// synth — builds the game's sound effects from arithmetic, and writes them as WAV files smalt can load.
//
// Nothing is recorded: each effect is a few oscillators and a noise source shaped by an envelope. Noise comes
// from a `Pcg32`, so the samples are the same on every run and every machine, and the oscillators use
// Ludax's own sine rather than libm. smalt only loads sounds from files, so `Wav::write` puts the samples
// in a short-lived file that the caller loads and deletes.

use std::ffi::libc::fs;

use ludax::{Pcg32, Vec, sinD, TAU_D};

/** Sample rate of the generated sounds; it matches the mixer's, so loading does no resampling. */
const SYNTH_RATE : i32 = 44100;

/** Largest sample value of a 16-bit signal. */
const SYNTH_PEAK : f64 = 32000.0;

/** Largest signed 16-bit sample, for clipping on the way out. */
const SYNTH_CLIP_HIGH : i32 = 32767;

/** Smallest signed 16-bit sample, for clipping on the way out. */
const SYNTH_CLIP_LOW : i32 = -32768;

/** Fraction of a sound spent fading in, which removes the click of a hard start. */
const SYNTH_ATTACK : f64 = 0.01;

/** Bytes in the WAV header. */
const WAV_HEADER : i64 = 44;

/** Format tag of uncompressed PCM in a WAV header. */
const WAV_FORMAT_PCM : i32 = 1;

/** Channels in every sound: mono. */
const WAV_CHANNELS : i32 = 1;

/** Bytes in one 16-bit sample. */
const WAV_SAMPLE_BYTES : i32 = 2;

/** Bits in one sample. */
const WAV_BITS : i32 = 16;

/** Bytes of the header that the RIFF size field counts: the whole header less "RIFF" and the size itself. */
const WAV_RIFF_OVERHEAD : i64 = 36;

/** Bytes in the "fmt " chunk of an uncompressed PCM file. */
const WAV_FMT_BYTES : i32 = 16;

/** Where each field of the header starts, in bytes from the start of the file. */
const WAV_AT_RIFF : i64 = 0;
const WAV_AT_RIFF_SIZE : i64 = 4;
const WAV_AT_WAVE : i64 = 8;
const WAV_AT_FMT : i64 = 12;
const WAV_AT_FMT_BYTES : i64 = 16;
const WAV_AT_FORMAT : i64 = 20;
const WAV_AT_CHANNELS : i64 = 22;
const WAV_AT_RATE : i64 = 24;
const WAV_AT_BYTE_RATE : i64 = 28;
const WAV_AT_BLOCK : i64 = 32;
const WAV_AT_BITS : i64 = 34;
const WAV_AT_DATA : i64 = 36;
const WAV_AT_DATA_BYTES : i64 = 40;

/** Bytes in a chunk tag such as "RIFF". */
const WAV_TAG_BYTES : i32 = 4;

/** WAV stores numbers little-endian: a byte holds 8 bits, a 16-bit word two bytes. */
const WAV_BYTE_BITS : i32 = 8;
const WAV_BYTE_MASK : i32 = 255;
const WAV_WORD_BITS : i32 = 16;
const WAV_WORD_MASK : i32 = 65535;

/** A square wave is high for this share of its cycle. */
const SYNTH_SQUARE_DUTY : f64 = 0.5;

/** Noise has less energy than a tone of the same peak, so it is raised by this much to sound as loud. */
const SYNTH_NOISE_BOOST : f64 = 2.0;

/** Shapes of oscillator. */
pub enum Wave : i8 {
    /** A pure tone. */
    Sine,

    /** A hollow, buzzy tone. */
    Square,

    /** A bright, harsh tone. */
    Saw,
}

/** A tone that glides in pitch and fades out: what `Synth::sweep` builds. */
pub struct Tone {
    /** The oscillator shape. */
    pub kind : Wave;

    /** Pitch at the start, in Hz. */
    pub from : f64;

    /** Pitch at the end, in Hz. */
    pub to : f64;

    /** Length in seconds. */
    pub seconds : f64;

    /** How many e-folds of loudness are lost by the end (3 is nearly silent). */
    pub decay : f64;

    /** Loudness at the start, 0 to 1. */
    pub gain : f64;
}

/** A burst of low-passed noise: what `Synth::noise` builds. */
pub struct Hiss {
    /** Length in seconds. */
    pub seconds : f64;

    /** Low-pass strength: close to 1 is dull and rumbling, 0 is hissing. */
    pub smooth : f64;

    /** How many e-folds of loudness are lost by the end. */
    pub decay : f64;

    /** Loudness at the start, 0 to 1. */
    pub gain : f64;
}

/** Sample builders. */
pub class Synth {
    /** Samples in `seconds`. */
    pub static fn frames(seconds : f64) : i32 {
        return (seconds * (SYNTH_RATE as f64)) as i32;
    }

    /** One cycle position `phase` (0 to 1) of the wave `kind`, from -1 to 1. */
    pub static fn osc(kind : Wave, phase : f64) : f64 {
        return match kind {
            Wave::Sine => sinD(phase * TAU_D),
            Wave::Square => Synth::squareOf(phase),
            Wave::Saw => Synth::signed(phase),
        };
    }

    // A number in 0..1 stretched to -1..1.
    static fn signed(unit : f64) : f64 {
        return 2.0 * unit - 1.0;
    }

    static fn squareOf(phase : f64) : f64 {
        if (phase < SYNTH_SQUARE_DUTY) {
            return 1.0;
        }
        return -1.0;
    }

    /** A tone that glides from `tone.from` to `tone.to` Hz, fading out exponentially. */
    pub static fn sweep(tone : Tone) : Vec<i32> {
        let n : i32 = Synth::frames(tone.seconds);
        let out : Vec<i32> = new Vec<i32>(n);
        let mut phase : f64 = 0.0;
        for (i of 0..n) {
            let t : f64 = (i as f64) / (n as f64);
            let hz : f64 = tone.from + (tone.to - tone.from) * t;
            phase = phase + hz / (SYNTH_RATE as f64);
            phase = phase - phase.floor();
            let level : f64 = Synth::fade(t, tone.decay) * tone.gain;
            out.push((Synth::osc(tone.kind, phase) * level * SYNTH_PEAK) as i32);
        }
        return out;
    }

    // Exponential fade with a few samples of fade-in so the start does not click.
    static fn fade(t : f64, decay : f64) : f64 {
        let mut level : f64 = (-decay * t).exp();
        if (t < SYNTH_ATTACK) {
            level = level * t / SYNTH_ATTACK;
        }
        return level;
    }

    /** Filtered noise: white noise smoothed by a one-pole low-pass, faded out over `hiss.seconds`. */
    pub static fn noise(rng : Pcg32, hiss : Hiss) : Vec<i32> {
        let n : i32 = Synth::frames(hiss.seconds);
        let out : Vec<i32> = new Vec<i32>(n);
        let mut held : f64 = 0.0;
        for (i of 0..n) {
            let t : f64 = (i as f64) / (n as f64);
            let white : f64 = Synth::signed(rng.nextF64());
            held = held * hiss.smooth + white * (1.0 - hiss.smooth);
            let faded : f64 = held * Synth::fade(t, hiss.decay);
            out.push((faded * hiss.gain * SYNTH_PEAK * SYNTH_NOISE_BOOST) as i32);
        }
        return out;
    }

    /** Adds `other` onto `base`, starting `offset` samples in; `base` grows if needed. */
    pub static fn mixIn(base : Vec<i32>, other : Vec<i32>, offset : i32) : void {
        while (base.len() < offset + other.len()) {
            base.push(0);
        }
        for (i of 0..other.len()) {
            base.set(offset + i, base.get(offset + i) + other.get(i));
        }
    }
}

/** Writes WAV files. */
pub class Wav {
    /** Writes `samples` as a mono 16-bit PCM file at `path`; answers whether it landed. */
    pub static fn write(path : string, samples : Vec<i32>) : bool {
        let dataBytes : i64 = (samples.len() as i64) * (WAV_SAMPLE_BYTES as i64);
        let buf : i8[] = new i8[WAV_HEADER + dataBytes];
        Wav::header(buf, dataBytes);

        for (i of 0..samples.len()) {
            let v : i32 = samples.get(i).min(SYNTH_CLIP_HIGH).max(SYNTH_CLIP_LOW);
            Wav::put16(buf, WAV_HEADER + (i as i64) * (WAV_SAMPLE_BYTES as i64), v);
        }

        let stream = fs::fopen(path, "wb");
        if (Wav::isNil(stream)) {
            return false;
        }
        fs::fwrite(Wav::bytes(buf), 1, WAV_HEADER + dataBytes, stream);
        fs::fclose(stream);
        return true;
    }

    // The RIFF/WAVE header of a mono, 16-bit, `SYNTH_RATE` Hz file with `dataBytes` of samples.
    static fn header(buf : i8[], dataBytes : i64) : void {
        Wav::tag(buf, WAV_AT_RIFF, "RIFF");
        Wav::put32(buf, WAV_AT_RIFF_SIZE, (WAV_RIFF_OVERHEAD + dataBytes) as i32);
        Wav::tag(buf, WAV_AT_WAVE, "WAVE");
        Wav::tag(buf, WAV_AT_FMT, "fmt ");
        Wav::put32(buf, WAV_AT_FMT_BYTES, WAV_FMT_BYTES);
        Wav::put16(buf, WAV_AT_FORMAT, WAV_FORMAT_PCM);
        Wav::put16(buf, WAV_AT_CHANNELS, WAV_CHANNELS);
        Wav::put32(buf, WAV_AT_RATE, SYNTH_RATE);
        Wav::put32(buf, WAV_AT_BYTE_RATE, SYNTH_RATE * WAV_SAMPLE_BYTES);
        Wav::put16(buf, WAV_AT_BLOCK, WAV_SAMPLE_BYTES);
        Wav::put16(buf, WAV_AT_BITS, WAV_BITS);
        Wav::tag(buf, WAV_AT_DATA, "data");
        Wav::put32(buf, WAV_AT_DATA_BYTES, dataBytes as i32);
    }

    static fn tag(buf : i8[], at : i64, s : string) : void {
        for (i of 0..WAV_TAG_BYTES) {
            buf[at + i] = s.byteAt(i) as i8;
        }
    }

    static fn put16(buf : i8[], at : i64, v : i32) : void {
        buf[at] = (v & WAV_BYTE_MASK) as i8;
        buf[at + 1] = ((v >> WAV_BYTE_BITS) & WAV_BYTE_MASK) as i8;
    }

    static fn put32(buf : i8[], at : i64, v : i32) : void {
        Wav::put16(buf, at, v & WAV_WORD_MASK);
        Wav::put16(buf, at + 2, (v >> WAV_WORD_BITS) & WAV_WORD_MASK);
    }

    static fn bytes(buf : i8[]) : ptr {
        unsafe {
            return buf as ptr;
        }
    }

    static fn isNil(p : ptr) : bool {
        unsafe {
            return (p as i64) == 0;
        }
    }
}

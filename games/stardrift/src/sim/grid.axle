// grid — a uniform spatial grid that answers "what is near this point?" without testing every pair.
//
// Each tick the world rebuilds the grid from scratch: every collidable thing is filed as a `Proxy` under the
// cell that holds its centre. Cells are singly linked lists threaded through two `Vec<i32>`, so a rebuild is
// a clear, one push per proxy and no allocation. A query visits the block of cells that the search circle,
// widened by the largest proxy radius seen, can touch; because a proxy lives in one cell only, no result is
// reported twice and no de-duplication is needed. The candidates are not exact: the caller runs the circle
// test it cares about.
//
// Proxies keep a reference (slab index or pool slot) and the generation of the entity they came from, so a
// proxy that outlives its entity within one tick is detected with `Slab.has` instead of dereferencing a
// recycled slot.

use ludax::{Vec, Vec2};

use crate::core::config::{VIEW_W, VIEW_H, GRID_CELL, GRID_PROXY_HINT};
use crate::core::types::Layer;

/** One collidable thing as the grid sees it. */
pub struct Proxy {
    /** Horizontal position of the centre. */
    pub x : f32;

    /** Vertical position of the centre. */
    pub y : f32;

    /** Collision radius. */
    pub r : f32;

    /** What kind of thing it is, for filtering. */
    pub layer : Layer;

    /** Slab index of the entity. */
    pub index : i32;

    /** Generation of the slab slot when the proxy was filed. */
    pub generation : i32;

    /** True when the circle of radius `r` around `at` overlaps this proxy's circle. */
    pub fn touches(self, at : Vec2, r : f32) : bool {
        let dx : f32 = self.x - at.x;
        let dy : f32 = self.y - at.y;
        let reach : f32 = self.r + r;
        return dx * dx + dy * dy <= reach * reach;
    }
}

/** The uniform grid over the playfield. */
pub class SpatialGrid {
    cols    : i32;
    rows    : i32;
    heads   : Vec<i32>;
    links   : Vec<i32>;
    proxies : Vec<Proxy>;
    widest  : f32 = 0.0;

    /** An empty grid covering the playfield. */
    constructor() {
        self.cols = (VIEW_W + GRID_CELL - 1) / GRID_CELL;
        self.rows = (VIEW_H + GRID_CELL - 1) / GRID_CELL;
        self.heads = new Vec<i32>(self.cols * self.rows);
        self.links = new Vec<i32>(GRID_PROXY_HINT);
        self.proxies = new Vec<Proxy>(GRID_PROXY_HINT);
        self.clear();
    }

    /** Forgets every proxy; call at the start of a rebuild. */
    pub fn clear(mut self) : void {
        self.heads.clear();
        for (c of 0..self.cols * self.rows) {
            self.heads.push(-1);
        }
        self.links.clear();
        self.proxies.clear();
        self.widest = 0.0;
    }

    // The cell column of an x coordinate, clamped to the grid: things outside the field share the edge cells.
    fn column(self, x : f32) : i32 {
        let c : i32 = (x as i32) / GRID_CELL;
        if (x < 0.0) {
            return 0;
        }
        if (c >= self.cols) {
            return self.cols - 1;
        }
        return c;
    }

    // The cell row of a y coordinate, clamped.
    fn row(self, y : f32) : i32 {
        let r : i32 = (y as i32) / GRID_CELL;
        if (y < 0.0) {
            return 0;
        }
        if (r >= self.rows) {
            return self.rows - 1;
        }
        return r;
    }

    /** Files a proxy and returns its index in the grid. */
    pub fn insert(mut self, p : Proxy) : i32 {
        let id : i32 = self.proxies.len();
        let cell : i32 = self.row(p.y) * self.cols + self.column(p.x);
        self.proxies.push(p);
        self.links.push(self.heads.get(cell));
        self.heads.set(cell, id);
        if (p.r > self.widest) {
            self.widest = p.r;
        }
        return id;
    }

    /** The proxy filed under grid index `id`. */
    pub fn proxy(self, id : i32) : Proxy {
        return self.proxies.get(id);
    }

    /** How many proxies are filed. */
    pub fn count(self) : i32 {
        return self.proxies.len();
    }

    /**
     * Appends to `out` the grid index of every proxy whose cell the circle of radius `r` around `at` could touch.
     * `out` is cleared first. The results are candidates; test them exactly.
     */
    pub fn query(self, at : Vec2, r : f32, out : Vec<i32>) : void {
        out.clear();
        let reach : f32 = r + self.widest;
        let c0 : i32 = self.column(at.x - reach);
        let c1 : i32 = self.column(at.x + reach);
        let r0 : i32 = self.row(at.y - reach);
        let r1 : i32 = self.row(at.y + reach);
        for (row of r0..r1 + 1) {
            for (col of c0..c1 + 1) {
                let mut id : i32 = self.heads.get(row * self.cols + col);
                while (id >= 0) {
                    out.push(id);
                    id = self.links.get(id);
                }
            }
        }
    }
}

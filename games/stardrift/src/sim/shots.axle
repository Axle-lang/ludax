// shots — bullets: firing them, moving them, and retiring them.
//
// The ship's shots and the enemies' bolts live in one pool of preallocated slots. A shot is a point with a
// velocity and a lifetime; whether it came from the player is a flag, so the collision pass can treat the two
// sets differently. Slots come back to the pool when a shot runs out of life, leaves the field or hits.

use ludax::{Vec2, sin, cos};

use crate::core::config::{
    SHOT_SPEED, SHOT_LIFE, SPREAD_ANGLE, BOLT_SPEED, BOLT_LIFE, FIELD_W, FIELD_H, DT, CULL_MARGIN
};
use crate::core::types::{Bullet, Sfx};
use crate::sim::fx::SparkSpec;
use crate::sim::world::World;

/** Distance from the ship's centre to the muzzle. */
const MUZZLE : f32 = 14.0;

/** The flash at the ship's muzzle: sparks per shot, their speed range, life and colour. */
const MUZZLE_SPARKS : i32 = 3;
const MUZZLE_SPARK_SLOW : f32 = 40.0;
const MUZZLE_SPARK_FAST : f32 = 140.0;
const MUZZLE_SPARK_LIFE : i32 = 5;
const MUZZLE_COLOR : i32 = 0xBFF4FF;

/** The flash at an enemy gun: sparks per bolt, their speed range, life and colour. */
const BOLT_FLASH_SPARKS : i32 = 4;
const BOLT_FLASH_SLOW : f32 = 30.0;
const BOLT_FLASH_FAST : f32 = 110.0;
const BOLT_FLASH_LIFE : i32 = 6;
const BOLT_FLASH_COLOR : i32 = 0xFF6A5A;

/** Fires and moves bullets. */
pub class Shots {
    /** Fires the ship's volley: one shot, or three with the spread power-up. */
    pub static fn fireShip(w : World) : void {
        let s = w.ship;
        let muzzle : Vec2 = Vec2::make(s.x + s.dirX() * MUZZLE, s.y + s.dirY() * MUZZLE);
        Shots::launch(w, muzzle, s.angle, false);
        if (s.spread > 0) {
            Shots::launch(w, muzzle, s.angle - SPREAD_ANGLE, false);
            Shots::launch(w, muzzle, s.angle + SPREAD_ANGLE, false);
        }

        let flash : SparkSpec = SparkSpec {
            slow: MUZZLE_SPARK_SLOW,
            fast: MUZZLE_SPARK_FAST,
            color: MUZZLE_COLOR,
            life: MUZZLE_SPARK_LIFE,
        };
        for (i of 0..MUZZLE_SPARKS) {
            w.fx.spark(muzzle, flash);
        }
        w.sound(Sfx::Shoot);
    }

    /** Fires an enemy bolt from `at` along `angle`. */
    pub static fn fireBolt(w : World, at : Vec2, angle : f32) : void {
        Shots::launch(w, at, angle, true);

        let flash : SparkSpec = SparkSpec {
            slow: BOLT_FLASH_SLOW,
            fast: BOLT_FLASH_FAST,
            color: BOLT_FLASH_COLOR,
            life: BOLT_FLASH_LIFE,
        };
        for (i of 0..BOLT_FLASH_SPARKS) {
            w.fx.spark(at, flash);
        }
    }

    // Takes a slot from the pool; a full pool means the shot is simply not fired. An enemy bolt is slower and
    // lives longer than a ship shot.
    static fn launch(w : World, at : Vec2, angle : f32, hostile : bool) : void {
        let mut speed : f32 = SHOT_SPEED;
        let mut life : i32 = SHOT_LIFE;
        if (hostile) {
            speed = BOLT_SPEED;
            life = BOLT_LIFE;
        }
        w.bullets.acquire(Bullet {
            x: at.x,
            y: at.y,
            vx: cos(angle) * speed,
            vy: sin(angle) * speed,
            life: life,
            hostile: hostile,
        });
    }

    /** Moves every live bullet one tick and retires the spent ones. */
    pub static fn update(w : World) : void {
        let mut slot : i32 = w.bullets.first();
        while (slot >= 0) {
            let next : i32 = w.bullets.next(slot);
            let mut b : Bullet = w.bullets.get(slot);
            b.x = b.x + b.vx * DT;
            b.y = b.y + b.vy * DT;
            b.life = b.life - 1;

            if (b.life <= 0 || Shots::outside(b)) {
                w.bullets.release(slot);
            } else {
                w.bullets.put(slot, b);
            }
            slot = next;
        }
    }

    // A ship shot dies at the edge of the field; a bolt gets a margin so it can graze in from outside.
    static fn outside(b : Bullet) : bool {
        let mut margin : f32 = 0.0;
        if (b.hostile) {
            margin = CULL_MARGIN;
        }
        return b.x < -margin || b.x > FIELD_W + margin || b.y < -margin || b.y > FIELD_H + margin;
    }
}

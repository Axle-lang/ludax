// score — points and the combo multiplier.
//
// Every kill within `COMBO_TICKS` of the previous one extends the chain; every `COMBO_STEP` kills in the
// chain raises the multiplier by one, up to `COMBO_MAX`. Letting the timer run out, or being hit, drops the
// chain.

use crate::core::config::{COMBO_TICKS, COMBO_STEP, COMBO_MAX};

/** The running score of one game. */
pub class Score {
    /** Points so far. */
    pub points : i32 = 0;

    /** Kills in the current chain. */
    pub chain : i32 = 0;

    /** The longest chain of the game. */
    pub bestChain : i32 = 0;

    /** Ticks left before the chain drops. */
    pub timer : i32 = 0;

    /** A fresh score. */
    constructor() {}

    /** Starts over. */
    pub fn reset(mut self) : void {
        self.points = 0;
        self.chain = 0;
        self.bestChain = 0;
        self.timer = 0;
    }

    /** The multiplier the next kill is worth. */
    pub fn multiplier(self) : i32 {
        let m : i32 = 1 + self.chain / COMBO_STEP;
        if (m > COMBO_MAX) {
            return COMBO_MAX;
        }
        return m;
    }

    /** Scores a kill worth `base`, extends the chain and returns the points added. */
    pub fn award(mut self, base : i32) : i32 {
        let gained : i32 = base * self.multiplier();
        self.points = self.points + gained;
        self.chain = self.chain + 1;
        self.timer = COMBO_TICKS;
        if (self.chain > self.bestChain) {
            self.bestChain = self.chain;
        }
        return gained;
    }

    /** Adds points that do not count towards the chain (pick-ups, wave bonuses). */
    pub fn bonus(mut self, amount : i32) : void {
        self.points = self.points + amount;
    }

    /** Drops the chain at once. */
    pub fn breakChain(mut self) : void {
        self.chain = 0;
        self.timer = 0;
    }

    /** Runs the chain timer down by one tick. */
    pub fn update(mut self) : void {
        if (self.timer > 0) {
            self.timer = self.timer - 1;
            if (self.timer == 0) {
                self.chain = 0;
            }
        }
    }

    /** Share of the chain timer left, 0 to 1, for the combo bar. */
    pub fn timerShare(self) : f32 {
        return (self.timer as f32) / (COMBO_TICKS as f32);
    }
}

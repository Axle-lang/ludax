// director — the state of the wave sequence: which wave it is, whether the field is resting or fighting, and
// the queue of arrivals that have not entered yet.
//
// The arrivals sit in a `Heap` keyed by the tick on which they enter, so the director only ever looks at the
// earliest one. What a wave contains, and when to start the next, is decided by the `waves` system.

use ludax::{Heap, Vec2};

use crate::core::config::WAVE_PAUSE_TICKS;
use crate::core::types::{Kind, Spawn};

/** What the director is doing. */
pub enum Phase : i8 {
    /** Waiting before a wave begins. */
    Resting,

    /** The wave is on: arrivals are entering and the player is fighting. */
    Fighting,
}

/** The wave sequence. */
pub class Director {
    /** The wave number, 0 before the first. */
    pub wave : i32 = 0;

    /** Resting or fighting. */
    pub phase : Phase = Phase::Resting;

    /** Ticks left of the rest, or ticks since the wave began while fighting. */
    pub clock : i32 = 0;

    /** Ticks left to show the "wave" banner. */
    pub banner : i32 = 0;

    queue : Heap<Spawn>;

    /** A director waiting to start wave 1. */
    constructor() {
        self.queue = new Heap<Spawn>();
        self.reset();
    }

    /** Back to before the first wave. */
    pub fn reset(mut self) : void {
        self.wave = 0;
        self.phase = Phase::Resting;
        self.clock = WAVE_PAUSE_TICKS;
        self.banner = 0;
        self.queue.clear();
    }

    /** Arrivals still waiting to enter. */
    pub fn pending(self) : i32 {
        return self.queue.len();
    }

    /** Queues an arrival of `kind` at `at`, entering `delay` ticks after the wave began. */
    pub fn schedule(mut self, kind : Kind, at : Vec2, delay : i32) : void {
        self.queue.push(delay as i64, Spawn { kind: kind, x: at.x, y: at.y });
    }

    /** True when the earliest queued arrival is due at wave tick `clock`. */
    pub fn hasDue(self) : bool {
        return !self.queue.isEmpty() && self.queue.peekKey() <= self.clock as i64;
    }

    /** Takes the earliest queued arrival; call only when `hasDue`. */
    pub fn takeNext(mut self) : Spawn {
        return self.queue.pop();
    }
}

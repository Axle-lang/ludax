// typeface — text for the HUD and the menus.
//
// One baked face from smalt, drawn at integer multiples of its size, plus a scratch block so that numbers
// are formatted into bytes and drawn straight from them: a HUD redrawn sixty times a second allocates
// nothing. Every draw takes the *top* of the text rather than its baseline, because layouts are described
// from the top edge.

use smalt::{BitmapFont, Face, Frame, Scratch, Mem};

/** Bytes in the scratch block; far more than any figure on screen needs. */
const TYPE_SCRATCH_BYTES : i32 = 128;

/** Text drawing for the whole game. */
pub class Typeface {
    ui      : BitmapFont;
    scratch : Scratch;

    /** The frame the text is drawn into; the renderer binds it again at the start of every repaint. */
    canvas : Frame;

    /** The UI face and a formatting block, drawing into `canvas` until it is bound to another. */
    constructor(canvas : Frame) {
        self.canvas = canvas;
        self.ui = BitmapFont::baked(Face::Ui);
        self.scratch = new Scratch(TYPE_SCRATCH_BYTES);
    }

    /** Binds the typeface to the frame of this repaint. */
    pub fn bind(mut self, canvas : Frame) : void {
        self.canvas = canvas;
    }

    /** Releases the formatting block. */
    pub fn close(self) : void {
        self.scratch.close();
    }

    /** Width of `s` at `scale`. */
    pub fn width(self, s : string, scale : i32) : i32 {
        return self.ui.widthScaled(s, scale);
    }

    /** Height of a line of text at `scale`. */
    pub fn height(self, scale : i32) : i32 {
        return self.ui.height() * scale;
    }

    /** Draws `s` with its top edge at `top`, starting at `x`; answers the pen position after it. */
    pub fn text(self, x : i32, top : i32, s : string, scale : i32, ink : i32) : i32 {
        return self.ui.drawScaled(self.canvas, x, self.ui.baselineFor(top, scale), s, scale, ink);
    }

    /** Draws `s` centred on `cx`. */
    pub fn centred(self, cx : i32, top : i32, s : string, scale : i32, ink : i32) : void {
        self.text(cx - self.width(s, scale) / 2, top, s, scale, ink);
    }

    /** Draws `s` ending at `right`. */
    pub fn right(self, right : i32, top : i32, s : string, scale : i32, ink : i32) : void {
        self.text(right - self.width(s, scale), top, s, scale, ink);
    }

    /** Draws the whole number `v`, thousands grouped, from `x`; answers the pen position after it. */
    pub fn number(mut self, x : i32, top : i32, v : i64, scale : i32, ink : i32) : i32 {
        self.scratch.reset();
        self.scratch.grouped(v);
        return self.drawScratch(x, top, scale, ink);
    }

    /** Draws the whole number `v` ending at `right`. */
    pub fn numberRight(mut self, right : i32, top : i32, v : i64, scale : i32, ink : i32) : void {
        self.scratch.reset();
        self.scratch.grouped(v);
        self.drawScratch(right - self.scratchWidth(scale), top, scale, ink);
    }

    /** Draws the whole number `v` centred on `cx`. */
    pub fn numberCentred(mut self, cx : i32, top : i32, v : i64, scale : i32, ink : i32) : void {
        self.scratch.reset();
        self.scratch.grouped(v);
        self.drawScratch(cx - self.scratchWidth(scale) / 2, top, scale, ink);
    }

    /** Draws a number with a leading `prefix`, e.g. `+150` or `x4`. */
    pub fn prefixed(
        mut self,
        x : i32,
        top : i32,
        prefix : string,
        v : i64,
        scale : i32,
        ink : i32
    ) : i32 {
        self.scratch.reset();
        self.scratch.literal(prefix);
        self.scratch.grouped(v);
        return self.drawScratch(x, top, scale, ink);
    }

    /** Draws `prefix` and the whole number `v` without grouping, e.g. a tick count or a seed. */
    pub fn plain(
        mut self,
        x : i32,
        top : i32,
        prefix : string,
        v : i64,
        scale : i32,
        ink : i32
    ) : i32 {
        self.scratch.reset();
        self.scratch.literal(prefix);
        self.scratch.decimal(v);
        return self.drawScratch(x, top, scale, ink);
    }

    /** Draws `v` with `decimals` places, e.g. a time in milliseconds. */
    pub fn fixed(
        mut self,
        x : i32,
        top : i32,
        v : f64,
        decimals : i32,
        scale : i32,
        ink : i32
    ) : i32 {
        self.scratch.reset();
        self.scratch.fixed(v, decimals);
        return self.drawScratch(x, top, scale, ink);
    }

    // The width in pixels of the scratch block's contents at `scale`.
    fn scratchWidth(self, scale : i32) : i32 {
        return self.ui.widthBytes(self.scratch.at(), 0, self.scratch.length()) * scale;
    }

    // The scratch block's contents, drawn pixel-multiplied by `scale` from `x`.
    fn drawScratch(self, x : i32, top : i32, scale : i32, ink : i32) : i32 {
        let baseline : i32 = self.ui.baselineFor(top, scale);
        let mut pen : i32 = x;
        for (i of 0..self.scratch.length()) {
            let code : i32 = Mem::byteAt(self.scratch.at(), i as i64);
            pen = pen + self.ui.glyphScaled(self.canvas, pen, baseline, code, scale, ink);
        }
        return pen;
    }
}

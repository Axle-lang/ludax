// hud — the heads-up display: score, lives, combo, power-up timers, wave banner and the controls reminder.
//
// Drawn after the world and without the screen shake, so the numbers hold still while the field trembles.
// Layout is anchored to the corners of the 960x600 view: score at the top left, best score and wave at the
// top right, the power-up bars at the bottom centre and the key help along the bottom edge. Every offset is a
// named constant, measured from the anchor it belongs to.

use smalt::{Frame, Rect, Color};

use crate::core::config::{VIEW_W, VIEW_H, POWER_TICKS, START_LIVES};
use crate::core::palette::{
    PAL_TEXT, PAL_TEXT_DIM, PAL_ACCENT, PAL_SHIP_EDGE, PAL_SHIP_FILL, PAL_SHIELD, PAL_RAPID,
    PAL_SPREAD
};
use crate::gfx::draw::{Draw, Pixel};
use crate::gfx::typeface::Typeface;
use crate::sim::director::Phase;
use crate::sim::world::World;

/** Margin between the HUD and the window edge. */
const MARGIN : i32 = 18;

/** The brightest value of one colour channel. */
const HUD_CHANNEL_MAX : i32 = 255;

/** Text scale of a label, of the score and of the best score. */
const LABEL_SCALE : i32 = 1;
const SCORE_SCALE : i32 = 3;
const BEST_SCALE : i32 = 2;

/** How far a number sits below its label. */
const NUMBER_DROP : i32 = 16;

/** How far the "WAVE n" label left of the view's middle starts. */
const WAVE_LABEL_LEFT : i32 = 30;

/** The row of life icons: distance below the top margin, from the left margin to the first icon, and between them. */
const LIVES_ROW : i32 = 74;
const LIFE_INSET : i32 = 8;
const LIFE_STEP : i32 = 26;

/** A life icon's nose above its centre, its wing tips beside and below it, and its tail notch below. */
const ICON_NOSE : i32 = 9;
const ICON_WING_X : i32 = 7;
const ICON_WING_Y : i32 = 7;
const ICON_NOTCH : i32 = 3;

/** Width of a power-up bar. */
const BAR_W : i32 = 110;

/** Height of a bar. */
const BAR_H : i32 = 6;

/** Width of the combo bar, which is a little longer than a power-up bar. */
const COMBO_BAR_W : i32 = 120;

/** The chain length from which the combo is shown. */
const COMBO_SHOW_FROM : i32 = 2;

/** The combo: distance below the top margin, text scale of the multiplier, and where the chain count sits. */
const COMBO_ROW : i32 = 100;
const COMBO_SCALE : i32 = 3;
const CHAIN_GAP : i32 = 8;
const CHAIN_DROP : i32 = 18;

/** How far the combo bar sits below the multiplier's row. */
const COMBO_BAR_DROP : i32 = 46;

/** The power-up bars: the first one's distance left of the middle, the step between bars, the bottom gap. */
const POWER_LEFT : i32 = 170;
const POWER_STEP : i32 = 130;
const POWER_BOTTOM : i32 = 62;

/** How far a power-up's bar sits below its label. */
const POWER_BAR_DROP : i32 = 18;

/** Ticks the controls reminder is shown bright at the start of a game. */
const HELP_TICKS : i64 = 900;

/** Distance of the controls reminder above the bottom edge. */
const HELP_BOTTOM : i32 = 22;

/** Ticks the wave banner fades in over. */
const BANNER_FADE : i32 = 40;

/** The banner: its top edge, how far its text starts left of the middle, and the text scale of each form. */
const BANNER_TOP : i32 = 150;
const BANNER_LEFT : i32 = 100;
const BANNER_SCALE : i32 = 4;
const CLEARED_SCALE : i32 = 3;

/** One timed power-up: what to call it, the ticks it has left and the colour of its bar. */
struct PowerBar {
    name  : string;
    left  : i32;
    color : i32;
}

/** The in-game display. */
pub class Hud {
    /** Draws everything for the running game; `uiTicks` animates the banner and the help line. */
    pub static fn draw(f : Frame, w : World, kit : Typeface, uiTicks : i64, best : i32) : void {
        Hud::score(w, kit, best);
        Hud::lives(f, w);
        Hud::combo(f, w, kit);
        Hud::powers(f, w, kit);
        Hud::banner(w, kit);
        Hud::help(kit, w.tickCount);
    }

    // Score big at the top left, best and wave at the top right.
    static fn score(w : World, kit : Typeface, best : i32) : void {
        let right : i32 = VIEW_W - MARGIN;
        let numberTop : i32 = MARGIN + NUMBER_DROP;
        let mut shown : i32 = best;
        if (w.score.points > shown) {
            shown = w.score.points;
        }

        kit.text(MARGIN, MARGIN, "SCORE", LABEL_SCALE, PAL_TEXT_DIM);
        kit.number(MARGIN, numberTop, w.score.points as i64, SCORE_SCALE, PAL_TEXT);
        kit.right(right, MARGIN, "BEST", LABEL_SCALE, PAL_TEXT_DIM);
        kit.numberRight(right, numberTop, shown as i64, BEST_SCALE, PAL_TEXT);

        let waveLeft : i32 = VIEW_W / 2 - WAVE_LABEL_LEFT;
        kit.prefixed(
            waveLeft,
            MARGIN,
            "WAVE ",
            w.director.wave as i64,
            LABEL_SCALE,
            PAL_TEXT_DIM
        );
    }

    // One small ship icon per spare life.
    static fn lives(f : Frame, w : World) : void {
        let y : i32 = MARGIN + LIVES_ROW;
        let spent : i32 = Draw::third(PAL_TEXT_DIM);
        for (i of 0..START_LIVES) {
            let x : i32 = MARGIN + LIFE_INSET + i * LIFE_STEP;
            if (i < w.ship.lives) {
                Hud::icon(f, Pixel::at(x, y), PAL_SHIP_EDGE);
            } else {
                Hud::icon(f, Pixel::at(x, y), spent);
            }
        }
    }

    // A tiny upright ship centred on `at`.
    static fn icon(f : Frame, at : Pixel, edge : i32) : void {
        let nose : Pixel = Pixel::at(at.x, at.y - ICON_NOSE);
        let left : Pixel = Pixel::at(at.x - ICON_WING_X, at.y + ICON_WING_Y);
        let notch : Pixel = Pixel::at(at.x, at.y + ICON_NOTCH);
        let right : Pixel = Pixel::at(at.x + ICON_WING_X, at.y + ICON_WING_Y);
        Draw::triangle(f, nose, left, right, PAL_SHIP_FILL);
        Draw::line(f, nose, left, edge);
        Draw::line(f, left, notch, edge);
        Draw::line(f, notch, right, edge);
        Draw::line(f, right, nose, edge);
    }

    // The multiplier and a bar that drains as the chain timer runs out.
    static fn combo(f : Frame, w : World, kit : Typeface) : void {
        if (w.score.chain < COMBO_SHOW_FROM) {
            return;
        }
        let y : i32 = MARGIN + COMBO_ROW;
        let multiplier : i64 = w.score.multiplier() as i64;
        let pen : i32 = kit.prefixed(MARGIN, y, "x", multiplier, COMBO_SCALE, PAL_ACCENT);
        kit.prefixed(
            pen + CHAIN_GAP,
            y + CHAIN_DROP,
            "CHAIN ",
            w.score.chain as i64,
            LABEL_SCALE,
            PAL_TEXT_DIM
        );

        let fill : i32 = ((w.score.timerShare() * (COMBO_BAR_W as f32)) as i32).max(1);
        let barTop : i32 = y + COMBO_BAR_DROP;
        f.fillRect(Rect::make(MARGIN, barTop, COMBO_BAR_W, BAR_H), Draw::quarter(PAL_ACCENT));
        f.fillRect(Rect::make(MARGIN, barTop, fill, BAR_H), PAL_ACCENT);
    }

    // One labelled bar per active timed power-up, centred along the bottom.
    static fn powers(f : Frame, w : World, kit : Typeface) : void {
        let s = w.ship;
        let shield : PowerBar = PowerBar { name: "SHIELD", left: s.shield, color: PAL_SHIELD };
        let rapid : PowerBar = PowerBar { name: "RAPID FIRE", left: s.rapid, color: PAL_RAPID };
        let spread : PowerBar = PowerBar { name: "SPREAD SHOT", left: s.spread, color: PAL_SPREAD };

        let mut slot : i32 = 0;
        slot = Hud::power(f, kit, shield, slot);
        slot = Hud::power(f, kit, rapid, slot);
        slot = Hud::power(f, kit, spread, slot);
    }

    // Draws one bar if its timer is running; answers the next free slot.
    static fn power(f : Frame, kit : Typeface, bar : PowerBar, slot : i32) : i32 {
        if (bar.left <= 0) {
            return slot;
        }
        let x : i32 = VIEW_W / 2 - POWER_LEFT + slot * POWER_STEP;
        let y : i32 = VIEW_H - POWER_BOTTOM;
        let fill : i32 = (bar.left * BAR_W) / POWER_TICKS;
        kit.text(x, y, bar.name, LABEL_SCALE, bar.color);
        f.fillRect(Rect::make(x, y + POWER_BAR_DROP, BAR_W, BAR_H), Draw::quarter(bar.color));
        f.fillRect(Rect::make(x, y + POWER_BAR_DROP, fill, BAR_H), bar.color);
        return slot + 1;
    }

    // "WAVE n" fades in and out in the middle of the screen when a wave begins, and "CLEAR" between waves.
    static fn banner(w : World, kit : Typeface) : void {
        let d = w.director;
        if (d.banner > 0) {
            let level : i32 = (d.banner * HUD_CHANNEL_MAX) / BANNER_FADE;
            let k : i32 = level.min(HUD_CHANNEL_MAX);
            let ink : i32 = Color::scale(PAL_TEXT, k, HUD_CHANNEL_MAX);
            let left : i32 = VIEW_W / 2 - BANNER_LEFT;
            kit.prefixed(left, BANNER_TOP, "WAVE ", d.wave as i64, BANNER_SCALE, ink);
        } else if (d.phase == Phase::Resting && d.wave > 0 && w.ship.lives > 0) {
            kit.centred(VIEW_W / 2, BANNER_TOP, "WAVE CLEARED", CLEARED_SCALE, PAL_ACCENT);
        }
    }

    // The key reminder along the bottom edge, bright for the first moments of a game and dim after.
    static fn help(kit : Typeface, tick : i64) : void {
        let mut ink : i32 = PAL_TEXT_DIM;
        if (tick < HELP_TICKS) {
            ink = PAL_TEXT;
        }
        let keys : string = "LEFT/RIGHT turn    UP thrust    SPACE fire    P pause    F3 debug    M sound    ESC quit";
        kit.centred(VIEW_W / 2, VIEW_H - HELP_BOTTOM, keys, LABEL_SCALE, ink);
    }
}

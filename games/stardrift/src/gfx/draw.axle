// draw — the 2-D primitives smalt's `Frame` does not have: lines, filled triangles and additive light.
//
// `Frame` fills rectangles and discs and plots single pixels; a vector-style shooter needs lines for hulls
// and beams, triangles for solid shapes and an additive blend so that sparks and glows brighten what is
// under them instead of covering it. All three are built here from `Frame.plot`, `Frame.at` and `Color`
// alone, with integer arithmetic only: the shapes of a frame are the same on every machine.

use smalt::{Frame, Color};

/** Denominator of the glow falloff table. */
const GLOW_SCALE : i32 = 256;

/** A magnitude wider than any coordinate; sentinel of an empty horizontal span. */
const DRAW_FAR : i32 = 1000000;

/** A glow's strength is given in percent. */
const DRAW_PERCENT : i32 = 100;

/** Steps a line may take beyond its longest side before the loop gives up, so a bad end point cannot spin forever. */
const DRAW_LINE_SLACK : i32 = 2;

/** How far the scene is shifted on screen, in pixels: the screen shake. */
pub struct Offset {
    /** Horizontal shift. */
    pub x : i32 = 0;

    /** Vertical shift. */
    pub y : i32 = 0;
}

/** A position on the frame, in pixels from the top left corner. */
pub struct Pixel {
    /** Pixels from the left. */
    pub x : i32;

    /** Pixels from the top. */
    pub y : i32;

    /** The pixel in column `x` of row `y`. */
    pub static fn at(x : i32, y : i32) : Pixel {
        return Pixel { x: x, y: y };
    }

    /** The pixel the scene position (`x`, `y`) lands on once the screen shake `by` is applied. */
    pub static fn shaken(x : f32, y : f32, by : Offset) : Pixel {
        return Pixel { x: (x as i32) + by.x, y: (y as i32) + by.y };
    }

    /** This pixel moved by the screen shake `by`. */
    pub fn moved(self, by : Offset) : Pixel {
        return Pixel { x: self.x + by.x, y: self.y + by.y };
    }
}

/** Drawing helpers over a `Frame`. */
pub class Draw {
    /** `color` at half strength. */
    pub static fn half(color : i32) : i32 {
        return Color::scale(color, 1, 2);
    }

    /** `color` at a third of its strength. */
    pub static fn third(color : i32) : i32 {
        return Color::scale(color, 1, 3);
    }

    /** `color` at a quarter of its strength. */
    pub static fn quarter(color : i32) : i32 {
        return Color::scale(color, 1, 4);
    }

    /** Adds `color` to the pixel at (`x`, `y`), clamping each channel; nothing outside the clip. */
    pub static fn add(f : Frame, x : i32, y : i32, color : i32) : void {
        if (f.holds(x, y)) {
            f.plot(x, y, Color::add(f.at(x, y), color));
        }
    }

    /** A line from `from` to `to` in `color` (Bresenham). */
    pub static fn line(f : Frame, from : Pixel, to : Pixel, color : i32) : void {
        Draw::stroke(f, from, to, color, false);
    }

    /** The same line, added to what is on the frame. */
    pub static fn lineAdd(f : Frame, from : Pixel, to : Pixel, color : i32) : void {
        Draw::stroke(f, from, to, color, true);
    }

    static fn stroke(f : Frame, from : Pixel, to : Pixel, color : i32, additive : bool) : void {
        let dx : i32 = Draw::abs(to.x - from.x);
        let dy : i32 = -Draw::abs(to.y - from.y);
        let sx : i32 = Draw::step(from.x, to.x);
        let sy : i32 = Draw::step(from.y, to.y);
        let mut err : i32 = dx + dy;
        let mut x : i32 = from.x;
        let mut y : i32 = from.y;
        let mut guard : i32 = dx - dy + DRAW_LINE_SLACK;

        while (guard > 0) {
            if (additive) {
                Draw::add(f, x, y, color);
            } else {
                f.plot(x, y, color);
            }
            if (x == to.x && y == to.y) {
                return;
            }
            let e2 : i32 = 2 * err;
            if (e2 >= dy) {
                err = err + dy;
                x = x + sx;
            }
            if (e2 <= dx) {
                err = err + dx;
                y = y + sy;
            }
            guard = guard - 1;
        }
    }

    static fn abs(v : i32) : i32 {
        if (v < 0) {
            return -v;
        }
        return v;
    }

    static fn step(from : i32, to : i32) : i32 {
        if (from < to) {
            return 1;
        }
        return -1;
    }

    /** A filled triangle, one horizontal run per row. */
    pub static fn triangle(f : Frame, a : Pixel, b : Pixel, c : Pixel, color : i32) : void {
        let top : i32 = Draw::min3(a.y, b.y, c.y);
        let bottom : i32 = Draw::max3(a.y, b.y, c.y);
        for (y of top..bottom + 1) {
            let ab : (lo: i32, hi: i32) = Draw::cross(a, b, y, DRAW_FAR, -DRAW_FAR);
            let bc : (lo: i32, hi: i32) = Draw::cross(b, c, y, ab.lo, ab.hi);
            let ca : (lo: i32, hi: i32) = Draw::cross(c, a, y, bc.lo, bc.hi);
            if (ca.lo <= ca.hi) {
                f.hLine(ca.lo, y, ca.hi - ca.lo + 1, color);
            }
        }
    }

    // Widens the run [`lo`, `hi`] to include where the edge `from`-`to` crosses row `y`.
    static fn cross(from : Pixel, to : Pixel, y : i32, lo : i32, hi : i32) : (lo: i32, hi: i32) {
        if (y < from.y.min(to.y) || y > from.y.max(to.y)) {
            return (lo, hi);
        }
        if (from.y == to.y) {
            return (Draw::min3(lo, from.x, to.x), Draw::max3(hi, from.x, to.x));
        }
        let x : i32 = from.x + ((to.x - from.x) * (y - from.y)) / (to.y - from.y);
        return (lo.min(x), hi.max(x));
    }

    static fn min3(a : i32, b : i32, c : i32) : i32 {
        return a.min(b).min(c);
    }

    static fn max3(a : i32, b : i32, c : i32) : i32 {
        return a.max(b).max(c);
    }

    /**
     * A soft disc of light: `color` at full strength in the middle, fading to nothing at `radius`, added to
     * what is below. `percent` scales the whole glow (100 is full).
     */
    pub static fn glow(f : Frame, at : Pixel, radius : i32, color : i32, percent : i32) : void {
        if (radius <= 0 || percent <= 0) {
            return;
        }
        let r2 : i32 = radius * radius;
        for (dy of -radius..radius + 1) {
            for (dx of -radius..radius + 1) {
                let d2 : i32 = dx * dx + dy * dy;
                if (d2 >= r2) {
                    continue;
                }
                let t : i32 = ((r2 - d2) * GLOW_SCALE) / r2;
                let k : i32 = (t * t * percent) / (GLOW_SCALE * DRAW_PERCENT);
                Draw::add(f, at.x + dx, at.y + dy, Color::scale(color, k, GLOW_SCALE));
            }
        }
    }

    /** A one-pixel circle outline of `radius` (midpoint algorithm), added to the frame. */
    pub static fn ringAdd(f : Frame, at : Pixel, radius : i32, color : i32) : void {
        if (radius <= 0) {
            Draw::add(f, at.x, at.y, color);
            return;
        }
        let mut x : i32 = radius;
        let mut y : i32 = 0;
        let mut err : i32 = 1 - radius;
        while (x >= y) {
            Draw::octants(f, at, Pixel::at(x, y), color);
            y = y + 1;
            if (err < 0) {
                err = err + 2 * y + 1;
            } else {
                x = x - 1;
                err = err + 2 * (y - x) + 1;
            }
        }
    }

    // The eight symmetric points of the circle around `centre` at offset `d`.
    static fn octants(f : Frame, centre : Pixel, d : Pixel, color : i32) : void {
        Draw::add(f, centre.x + d.x, centre.y + d.y, color);
        Draw::add(f, centre.x - d.x, centre.y + d.y, color);
        Draw::add(f, centre.x + d.x, centre.y - d.y, color);
        Draw::add(f, centre.x - d.x, centre.y - d.y, color);
        Draw::add(f, centre.x + d.y, centre.y + d.x, color);
        Draw::add(f, centre.x - d.y, centre.y + d.x, color);
        Draw::add(f, centre.x + d.y, centre.y - d.x, color);
        Draw::add(f, centre.x - d.y, centre.y - d.x, color);
    }
}

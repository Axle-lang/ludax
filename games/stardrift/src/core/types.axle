// types — the plain data of the game: what an entity, a bullet, a particle and a sound event are.
//
// Everything here is a `struct` or an `enum`: copied freely, held by value in the containers of Ludax. The
// behaviour lives in the systems under `sim/`; nothing in this file knows how an entity moves.

/** What an entity in the slab is; every kind is handled by `match`, never by an `if` ladder. */
pub enum Kind : i8 {
    /** A drifting rock that splits when destroyed. */
    Rock,

    /** A small kamikaze ship that homes on the player. */
    Drone,

    /** A ship that keeps its distance and fires aimed bolts. */
    Gunship,

    /** A power-up waiting to be collected. */
    Pickup,
}

/** Which power-up a pick-up carries. */
pub enum Power : i8 {
    /** Absorbs the next hit. */
    Shield,

    /** Doubles the rate of fire for a while. */
    Rapid,

    /** Fires three shots at once for a while. */
    Spread,

    /** Detonates at once and wipes out whatever is near. */
    Nova,
}

/** Which collision layer a proxy in the grid belongs to. */
pub enum Layer : i8 {
    /** Anything the player's shots can hurt. */
    Enemy,

    /** Anything the ship can collect. */
    Pickup,
}

/** Sound effects the simulation asks for; the audio layer decides how they sound. */
pub enum Sfx : i8 {
    /** The ship fires. */
    Shoot,

    /** A shot lands without destroying its target. */
    Hit,

    /** A small thing blows up. */
    Boom,

    /** A large thing blows up. */
    BigBoom,

    /** The player collects a power-up. */
    Pickup,

    /** A wave begins. */
    Wave,

    /** The ship is destroyed. */
    Death,

    /** The nova power-up goes off. */
    Nova,
}

/** One thing in the slab: a rock, a drone, a gunship or a pick-up. */
pub struct Entity {
    /** What it is. */
    pub kind : Kind = Kind::Rock;

    /** Horizontal position of its centre. */
    pub x : f32 = 0.0;

    /** Vertical position of the centre. */
    pub y : f32 = 0.0;

    /** Horizontal velocity in pixels per second. */
    pub vx : f32 = 0.0;

    /** Vertical velocity in pixels per second. */
    pub vy : f32 = 0.0;

    /** Collision radius. */
    pub radius : f32 = 0.0;

    /** Hit points left. */
    pub hp : i32 = 0;

    /** Rocks: 3, 2 or 1 for large, medium, small. Pick-ups: the `Power` as a number. Otherwise 0. */
    pub tier : i32 = 0;

    /** Heading in radians, used when drawing. */
    pub angle : f32 = 0.0;

    /** Angular velocity in radians per second. */
    pub spin : f32 = 0.0;

    /** Ticks left of the white flash after being hit. */
    pub flash : i32 = 0;

    /** Seed of the outline of a rock, so each one keeps its own shape. */
    pub seed : i32 = 0;
}

/** The thinking state of a drone or a gunship, kept in a sparse set next to the slab. */
pub struct Brain {
    /** Ticks until the next shot. */
    pub reload : i32 = 0;

    /** Which way a gunship circles: 1 or -1. */
    pub orbit : f32 = 0.0;

    /** Phase of the wobble a drone adds to its course. */
    pub phase : f32 = 0.0;
}

/** A shot in flight, from the player or from an enemy. */
pub struct Bullet {
    /** Horizontal position of the centre. */
    pub x : f32 = 0.0;

    /** Vertical position of the centre. */
    pub y : f32 = 0.0;

    /** Horizontal velocity in pixels per second. */
    pub vx : f32 = 0.0;

    /** Vertical velocity in pixels per second. */
    pub vy : f32 = 0.0;

    /** Ticks left before it fades. */
    pub life : i32 = 0;

    /** True for an enemy bolt, false for a ship shot. */
    pub hostile : bool = false;
}

/** A spark, a puff of smoke or an expanding ring, drawn additively. */
pub struct Particle {
    /** Horizontal position of the centre. */
    pub x : f32 = 0.0;

    /** Vertical position of the centre. */
    pub y : f32 = 0.0;

    /** Horizontal velocity in pixels per second. */
    pub vx : f32 = 0.0;

    /** Vertical velocity in pixels per second. */
    pub vy : f32 = 0.0;

    /** Ticks left. */
    pub life : i32 = 0;

    /** Ticks it started with, to fade by age. */
    pub span : i32 = 0;

    /** Packed 0xRRGGBB colour at full brightness. */
    pub color : i32 = 0;

    /** Fraction of velocity kept per tick. */
    pub drag : f32 = 0.0;

    /** Radius in pixels; a ring grows by `growth` each tick instead of moving. */
    pub size : f32 = 0.0;

    /** Pixels a ring grows by each tick. */
    pub growth : f32 = 0.0;

    /** True when drawn as a ring outline. */
    pub ring : bool = false;
}

/** A score number floating up from where something died. */
pub struct Popup {
    /** Horizontal position of the centre. */
    pub x : f32 = 0.0;

    /** Vertical position of the centre. */
    pub y : f32 = 0.0;

    /** Points shown. */
    pub value : i32 = 0;

    /** Ticks left. */
    pub life : i32 = 0;

    /** Score multiplier it was earned at; 1 shows nothing. */
    pub multiplier : i32 = 0;
}

/** One thing the player asked the ship to do this tick. */
pub struct Input {
    /** Turn anticlockwise. */
    pub left : bool = false;

    /** Turn clockwise. */
    pub right : bool = false;

    /** Fire the engine. */
    pub thrust : bool = false;

    /** Fire the guns. */
    pub fire : bool = false;
}

/** A scheduled arrival, queued in the wave director's heap. */
pub struct Spawn {
    /** What is arriving. */
    pub kind : Kind;

    /** Horizontal position of the centre. */
    pub x : f32 = 0.0;

    /** Vertical position of the centre. */
    pub y : f32 = 0.0;
}

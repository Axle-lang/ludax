// palette — the colours the game is made of, shared by the simulation's effects and by the renderer.
//
// Colours are packed 0xRRGGBB words, the format of smalt's `Frame`. A hull has a dark fill and a bright edge;
// the edge colour doubles as the colour of the debris and glow of that thing.

/** Top of the backdrop gradient. */
pub const PAL_SKY_TOP : i32 = 0x04050C;

/** Bottom of the backdrop gradient. */
pub const PAL_SKY_BOTTOM : i32 = 0x0C1330;

/** Fill of a rock. */
pub const PAL_ROCK_FILL : i32 = 0x1E2233;

/** Outline of a rock (lit facets), and its debris. */
pub const PAL_ROCK_EDGE : i32 = 0xA9B4D4;

/** Fill of the player's ship, and its debris. */
pub const PAL_SHIP_FILL : i32 = 0x0F2A44;

/** Outline of the ship, and its glow. */
pub const PAL_SHIP_EDGE : i32 = 0x6FE3FF;

/** Fill of a drone, and its debris. */
pub const PAL_DRONE_FILL : i32 = 0x3A0F36;

/** Outline of a drone, and its glow. */
pub const PAL_DRONE_EDGE : i32 = 0xFF5ACD;

/** Fill of a gunship, and its debris. */
pub const PAL_GUNSHIP_FILL : i32 = 0x3A140F;

/** Outline of a gunship, and its glow. */
pub const PAL_GUNSHIP_EDGE : i32 = 0xFF7A4A;

/** A ship shot. */
pub const PAL_SHOT : i32 = 0xA8F0FF;

/** An enemy bolt. */
pub const PAL_BOLT : i32 = 0xFF4A3A;

/** Shield power-up. */
pub const PAL_SHIELD : i32 = 0x58FFD8;

/** Rapid-fire power-up. */
pub const PAL_RAPID : i32 = 0xFFE05A;

/** Spread-shot power-up. */
pub const PAL_SPREAD : i32 = 0x7DFF5A;

/** Nova power-up. */
pub const PAL_NOVA : i32 = 0xFFFFFF;

/** Bright text. */
pub const PAL_TEXT : i32 = 0xE8EEF8;

/** Secondary, dim text. */
pub const PAL_TEXT_DIM : i32 = 0x7C88A4;

/** Accent for headings and the combo. */
pub const PAL_ACCENT : i32 = 0xFFC94A;

// stardrift — a top-down arcade space shooter built on the Ludax engine core and the smalt platform library.
//
// Drift and shoot through waves of rocks, drones and gunships, chain kills for a bigger score multiplier and
// pick up power-ups. The simulation runs in fixed 1/60 s steps from a seeded random stream, so a run is
// reproducible: `--seed N --smoke T` plays T scripted ticks and prints a checksum of the final state. See
// `app/options.axle` for every flag and `README.md` for the controls.

use crate::app::options::Cli;
use crate::app::selftest::SelfTest;
use crate::app::session::Session;
use crate::app::smoke::Smoke;

/** Exit code for a command line the program cannot run. */
const MAIN_EXIT_USAGE : i32 = 2;

fn main() : i32 {
    let o = Cli::parse();
    if (o.problem.length > 0) {
        println(o.problem);
        println(Cli::usage());
        return MAIN_EXIT_USAGE;
    }
    if (o.help) {
        println(Cli::usage());
        return 0;
    }
    if (o.selftest) {
        return SelfTest::run();
    }
    if (o.smoke >= 0) {
        return Smoke::run(o);
    }
    return Session::run(o);
}

// checksum — one number that stands for the whole simulated state.
//
// Two runs with the same seed and the same inputs must agree on it exactly; any divergence in a position, a
// score, a pool slot or the order of entities changes it. Floats are quantised to 1/64 pixel before hashing,
// which is far finer than anything visible and keeps the result independent of how a value is printed. The
// walk is in slot order everywhere, which is deterministic by the design of the containers.

use ludax::{EntityId, hashCombine};

use crate::app::game::Game;
use crate::core::types::{Entity, Bullet, Particle};
use crate::sim::world::World;

/** Fixed-point scale applied to floats before hashing. */
const QUANTUM : f32 = 64.0;

/** The FNV-1a offset basis, so a hash depends on every value folded into it. */
const CHECKSUM_SEED : i64 = 1469598103934665603;

/** The state hash. */
pub class Checksum {
    // Folds a whole number into the running hash.
    static fn fold(h : i64, v : i64) : i64 {
        return hashCombine(h, v);
    }

    // Folds a real number in at 1/64 precision.
    static fn real(h : i64, v : f32) : i64 {
        return hashCombine(h, (v * QUANTUM) as i64);
    }

    /** The hash of the game's simulated state: world, score, ship, entities, shots and particles. */
    pub static fn stateOf(g : Game) : i64 {
        let w : World = g.world;
        let mut h : i64 = CHECKSUM_SEED;
        h = Checksum::fold(h, w.tickCount);
        h = Checksum::fold(h, w.score.points as i64);
        h = Checksum::fold(h, w.score.chain as i64);
        h = Checksum::fold(h, w.director.wave as i64);
        h = Checksum::fold(h, w.ship.lives as i64);
        h = Checksum::real(h, w.ship.x);
        h = Checksum::real(h, w.ship.y);
        h = Checksum::real(h, w.ship.angle);
        h = Checksum::fold(h, g.best as i64);
        h = Checksum::fold(h, g.runs as i64);
        h = Checksum::entities(h, w);
        h = Checksum::bullets(h, w);
        return Checksum::particles(h, w);
    }

    static fn entities(start : i64, w : World) : i64 {
        let mut h : i64 = start;
        for (slot of 0..w.entities.slotCount()) {
            if (!w.entities.isLiveAt(slot)) {
                continue;
            }
            let id : EntityId = w.entities.idAt(slot);
            let e : Entity = w.entities.valueAt(slot);
            h = Checksum::fold(h, id.bits());
            h = Checksum::fold(h, e.kind as i64);
            h = Checksum::real(h, e.x);
            h = Checksum::real(h, e.y);
            h = Checksum::real(h, e.vx);
            h = Checksum::real(h, e.vy);
            h = Checksum::fold(h, e.hp as i64);
        }
        return h;
    }

    static fn bullets(start : i64, w : World) : i64 {
        let mut h : i64 = start;
        let mut slot : i32 = w.bullets.first();
        while (slot >= 0) {
            let b : Bullet = w.bullets.get(slot);
            h = Checksum::fold(h, slot as i64);
            h = Checksum::real(h, b.x);
            h = Checksum::real(h, b.y);
            h = Checksum::fold(h, b.life as i64);
            slot = w.bullets.next(slot);
        }
        return h;
    }

    static fn particles(start : i64, w : World) : i64 {
        let pool = w.fx.field.pool;
        let mut h : i64 = start;
        let mut slot : i32 = pool.first();
        while (slot >= 0) {
            let p : Particle = pool.get(slot);
            h = Checksum::fold(h, slot as i64);
            h = Checksum::real(h, p.x);
            h = Checksum::real(h, p.y);
            h = Checksum::fold(h, p.life as i64);
            slot = pool.next(slot);
        }
        return h;
    }
}

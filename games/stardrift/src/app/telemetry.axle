// telemetry — the profiler and the log the game reports to, bundled so one object can be handed around.
//
// The F3 overlay reads both: the profiler ranks the scopes of the last finished frame, the memory sink keeps
// the last few log lines. The scope ids are constants so a hot loop never touches a string; the constructor
// registers the names in the same order, which is what makes `names.id(...)` hand back exactly these numbers.

use ludax::{Profiler, ProfileNames, Logger, MemorySink, LogLevel};

/** Scope covering a whole frame of the window loop. */
pub const SCOPE_FRAME : i32 = 0;

/** Scope for reading input and turning it into commands. */
pub const SCOPE_INPUT : i32 = 1;

/** Scope for one simulation tick as a whole. */
pub const SCOPE_SIM : i32 = 2;

/** Scope for the ship's movement and firing. */
pub const SCOPE_SHIP : i32 = 3;

/** Scope for the wave director. */
pub const SCOPE_WAVES : i32 = 4;

/** Scope for enemy behaviour. */
pub const SCOPE_ENEMIES : i32 = 5;

/** Scope for moving bullets. */
pub const SCOPE_SHOTS : i32 = 6;

/** Scope for rebuilding the grid and resolving collisions. */
pub const SCOPE_COLLIDE : i32 = 7;

/** Scope for particles, popups and shake. */
pub const SCOPE_FX : i32 = 8;

/** Scope for drawing the whole frame. */
pub const SCOPE_RENDER : i32 = 9;

/** Scope for drawing the playfield (stars, entities, particles). */
pub const SCOPE_DRAW_WORLD : i32 = 10;

/** Scope for drawing the HUD and the overlays. */
pub const SCOPE_DRAW_HUD : i32 = 11;

/** Scope for putting the frame on the window. */
pub const SCOPE_PRESENT : i32 = 12;

/** Number of scopes registered. */
const TELEMETRY_SCOPES : i32 = 13;

/** Frames of history the profiler keeps. */
const TELEMETRY_FRAMES : i32 = 4;

/** Samples one frame may record. */
const TELEMETRY_SAMPLES : i32 = 256;

/** Lines of log the overlay can show. */
const TELEMETRY_LOG_LINES : i32 = 64;

/** The profiler, its scope names and the in-memory log. */
pub class Telemetry {
    /** Records scope timings; disabled until the overlay is switched on. */
    pub prof : Profiler;

    /** Scope names, for the overlay. */
    pub names : ProfileNames;

    /** The game's log; the last lines are kept in memory. */
    pub log : Logger<MemorySink>;

    /** Telemetry with the profiler switched off. */
    constructor() {
        self.prof = new Profiler(TELEMETRY_FRAMES, TELEMETRY_SAMPLES, TELEMETRY_SCOPES);
        self.names = new ProfileNames(TELEMETRY_SCOPES);
        self.log = new Logger<MemorySink>(new MemorySink(TELEMETRY_LOG_LINES), LogLevel::Info);
        self.names.id("frame");
        self.names.id("input");
        self.names.id("sim");
        self.names.id("sim.ship");
        self.names.id("sim.waves");
        self.names.id("sim.enemies");
        self.names.id("sim.shots");
        self.names.id("sim.collide");
        self.names.id("sim.fx");
        self.names.id("render");
        self.names.id("render.world");
        self.names.id("render.hud");
        self.names.id("present");
    }

    /** Opens a timing scope; hand the result to `end`. Costs one test while the profiler is off. */
    pub fn begin(mut self, scope : i32) : i32 {
        return self.prof.begin(scope);
    }

    /** Closes the scope that `begin` opened. */
    pub fn end(mut self, token : i32) : void {
        self.prof.end(token);
    }
}

// smoke — the scripted, windowless run behind `--smoke N`.
//
// A scripted pilot plays N fixed ticks of the real game, pressing Enter on the menus, so every system of the
// simulation runs: waves, enemies, shots, collisions, power-ups, deaths and restarts. Nothing here depends on
// a window, a clock or a sound device. It prints one line with the final state and a checksum of it; the same
// seed gives the same line every time, which is what makes this a test as well as a demo. With `--shot` the
// final frame is drawn into an off-screen surface and saved, so the picture can be looked at without a
// display.

use ludax::{Profiler, FixedStep};
use smalt::{Surface, Bmp};

use crate::app::bot::Bot;
use crate::app::checksum::Checksum;
use crate::app::controls::Command;
use crate::app::game::{Game, Mode};
use crate::app::options::Options;
use crate::app::telemetry::Telemetry;
use crate::core::config::{VIEW_W, VIEW_H, TICK_HZ};
use crate::gfx::renderer::Renderer;

/** Frame rate printed on the debug panel of a screenshot, which has no real frames. */
const FPS_SHOWN : f64 = 60.0;

/** The smoke run. */
pub class Smoke {
    /** Plays `opts.smoke` ticks, prints the summary, saves the last frame if asked; answers the exit code. */
    pub static fn run(opts : Options) : i32 {
        let mut game : Game = new Game(opts.seed as u64, new Telemetry());
        let screen : Surface = new Surface(VIEW_W, VIEW_H);
        let mut renderer : Renderer = new Renderer(screen.frame());
        renderer.debug = opts.debug;
        game.firstWave = opts.wave;
        let prof : Profiler = game.world.tm.prof;
        prof.setEnabled(opts.debug);

        let fixed : FixedStep = FixedStep::atHertz(TICK_HZ, 1);
        let mut sounds : i32 = 0;
        let mut previous : Mode = game.mode;
        for (t of 0..opts.smoke) {
            if (Bot::command(game) == Command::Confirm) {
                game.confirm();
            }
            prof.beginFrame();
            // One frame of exactly one step: the same stepper the window uses, fed a perfect clock.
            fixed.advanceNanos(fixed.stepNanos());
            while (fixed.takeStep()) {
                game.tick(Bot::decide(game));
            }
            if (opts.shot.length > 0 && t == opts.smoke - 1) {
                // The last frame also draws, so the debug panel of the screenshot ranks every scope.
                renderer.draw(screen.frame(), game, FPS_SHOWN);
            }
            prof.endFrame();
            sounds = sounds + game.outbox.len();
            game.outbox.clear();
            if (game.mode != previous) {
                Smoke::report(game, t);
                previous = game.mode;
            }
        }
        Smoke::summary(game, opts, sounds);
        if (opts.debug) {
            Smoke::printLog(game);
        }

        let mut code : i32 = 0;
        if (opts.shot.length > 0) {
            code = Smoke::shoot(game, renderer, screen, opts);
        }
        screen.close();
        renderer.close();
        game.close();
        return code;
    }

    // One line when the game changes screen.
    static fn report(game : Game, tick : i32) : void {
        let w = game.world;
        let name : string = match game.mode {
            Mode::Title => "title",
            Mode::Playing => "playing",
            Mode::Paused => "paused",
            Mode::Over => "game over",
        };
        println("  tick ${tick}: ${name}  score ${w.score.points}  wave ${w.director.wave}  run ${game.runs}");
    }

    // The final line: everything a regression would change.
    static fn summary(game : Game, opts : Options, sounds : i32) : void {
        let w = game.world;
        let scoreText : string = "score=${w.score.points} best=${game.best} wave=${w.director.wave}";
        let countText : string = "entities=${w.enemyCount()} sounds=${sounds}";
        println("smoke: ticks=${opts.smoke} seed=${opts.seed} runs=${game.runs} ${scoreText} ${countText}");
        println("checksum: ${Checksum::stateOf(game)}");
    }

    // The log the game kept in memory, oldest first: what `--debug` adds to a smoke run.
    static fn printLog(game : Game) : void {
        let sink = game.world.tm.log.sink();
        println("log (${sink.count()} of ${sink.received()} records):");
        for (i of 0..sink.count()) {
            println("  ${sink.at(i).format()}");
        }
    }

    // Draws the last state once more, now that the profiler holds a finished frame, and writes it as a BMP.
    static fn shoot(game : Game, renderer : Renderer, screen : Surface, opts : Options) : i32 {
        renderer.draw(screen.frame(), game, FPS_SHOWN);
        if (!Bmp::write(opts.shot, screen.frame())) {
            println("could not write ${opts.shot}");
            return 1;
        }
        println("wrote ${opts.shot}");
        return 0;
    }
}

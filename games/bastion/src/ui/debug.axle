// debug — the F3 overlay: timings from the profiler, counters from every system, and the recent log.
//
// It answers "where did the frame go and what is the world doing" without a debugger: the profiler's
// costliest scopes of the last frame, the entity and path counters, how much the frustum culled, and the
// newest lines of the in-game log.

use ludax::{ProfileEntry, LogRecord};
use smalt::Rect;

use crate::app::game::Game;
use crate::app::probe::NANOS_PER_MICRO;
use crate::ui::hud::panel;
use crate::ui::palette::{C_TEXT, C_DIM, C_ACCENT, C_GOLD};
use crate::ui::pen::Pen;

/** Rows of profiler output shown. */
const PROFILE_ROWS : i32 = 8;

/** Log lines shown. */
const LOG_ROWS : i32 = 6;

/** Pixels between two figures on one line of counters. */
const COUNTER_GAP : i32 = 14;

/** The panel: its left and top edge, and its width and height. */
const DEBUG_X : i32 = 12;
const DEBUG_Y : i32 = 92;
const DEBUG_W : i32 = 370;
const DEBUG_H : i32 = 300;

/** Inside the panel: the left inset of the text, and the gap above the heading. */
const DEBUG_PAD_X : i32 = 12;
const DEBUG_PAD_TOP : i32 = 10;

/** Vertical steps: below the heading, between two lines of counters, between two rows of the profile or log. */
const DEBUG_HEADING_STEP : i32 = 20;
const DEBUG_COUNTER_STEP : i32 = 18;
const DEBUG_ROW_STEP : i32 = 16;

/** The gap under the last counters, and between the profile and the log. */
const DEBUG_COUNTERS_AFTER : i32 = 24;
const DEBUG_LOG_GAP : i32 = 6;

/** The profile's columns: where the microseconds and the call counts start, from the text's left edge. */
const PROFILE_MICROS_X : i32 = 190;
const PROFILE_CALLS_X : i32 = 262;

/** The figures the renderer measured, which the game itself does not keep. */
pub struct DebugCounts {
    /** Frames per second, as the pacer measured them. */
    pub fps : i32;

    /** Objects the last 3-D pass drew. */
    pub drawn : i32;

    /** Objects the frustum rejected in the last 3-D pass. */
    pub culled : i32;

    /** Length of the shown route in tiles. */
    pub routeLength : i32;
}

/** Draws the overlay at the left of the window below the hints. */
pub fn drawDebug(pen : Pen, g : Game, counts : DebugCounts) : void {
    let r : Rect = Rect::make(DEBUG_X, DEBUG_Y, DEBUG_W, DEBUG_H);
    panel(pen, r);

    let x : i32 = r.x + DEBUG_PAD_X;
    let mut y : i32 = r.y + DEBUG_PAD_TOP;
    pen.text(x, y, "F3  debug", C_ACCENT);
    y = y + DEBUG_HEADING_STEP;
    y = drawCounters(pen, g, counts, y);
    y = drawProfile(pen, g, y);
    drawLog(pen, g, y + DEBUG_LOG_GAP);
}

// The counter lines: frame figures, entity counts, path counts and culling. Returns the y below them.
fn drawCounters(pen : Pen, g : Game, counts : DebugCounts, top : i32) : i32 {
    let w = g.world;
    let x : i32 = DEBUG_X + DEBUG_PAD_X;
    let mut y : i32 = top;

    let mut end : i32 = pen.labelled(x, y, "fps ", counts.fps as i64, C_TEXT);
    end = pen.labelled(end + COUNTER_GAP, y, "tick ", w.tick as i64, C_TEXT);
    pen.labelled(end + COUNTER_GAP, y, "seed ", w.seed as i64, C_TEXT);
    y = y + DEBUG_COUNTER_STEP;

    end = pen.labelled(x, y, "enemies ", w.enemies.len() as i64, C_TEXT);
    end = pen.labelled(end + COUNTER_GAP, y, "towers ", w.towers.len() as i64, C_TEXT);
    end = pen.labelled(end + COUNTER_GAP, y, "shots ", w.shots.len() as i64, C_TEXT);
    pen.labelled(end + COUNTER_GAP, y, "fx ", w.fx.len() as i64, C_TEXT);
    y = y + DEBUG_COUNTER_STEP;

    end = pen.labelled(x, y, "route ", counts.routeLength as i64, C_TEXT);
    end = pen.labelled(end + COUNTER_GAP, y, "A* searches ", w.routes.searchCount() as i64, C_TEXT);
    pen.labelled(end + COUNTER_GAP, y, "map v", w.routes.version() as i64, C_TEXT);
    y = y + DEBUG_COUNTER_STEP;

    end = pen.labelled(x, y, "drawn ", counts.drawn as i64, C_TEXT);
    pen.labelled(end + COUNTER_GAP, y, "culled ", counts.culled as i64, C_TEXT);
    return y + DEBUG_COUNTERS_AFTER;
}

// The costliest scopes of the last profiled frame, in microseconds and calls. Returns the y below them.
fn drawProfile(pen : Pen, g : Game, top : i32) : i32 {
    let x : i32 = DEBUG_X + DEBUG_PAD_X;
    let mut y : i32 = top;
    pen.text(x, y, "profile  (microseconds, calls)", C_GOLD);
    y = y + DEBUG_COUNTER_STEP;

    let prof = g.probe.profiler;
    let rows : i32 = prof.entryCount();
    for (rank of 0..rows) {
        if (rank >= PROFILE_ROWS) {
            break;
        }

        let e : ProfileEntry = prof.entry(rank);
        pen.text(x, y, g.probe.names.name(e.scope), C_TEXT);
        pen.number(x + PROFILE_MICROS_X, y, e.inclusiveNanos / NANOS_PER_MICRO, C_TEXT);
        pen.number(x + PROFILE_CALLS_X, y, e.calls as i64, C_DIM);
        y = y + DEBUG_ROW_STEP;
    }
    return y;
}

// The newest log lines, oldest first.
fn drawLog(pen : Pen, g : Game, top : i32) : void {
    let x : i32 = DEBUG_X + DEBUG_PAD_X;
    let mut y : i32 = top;
    let sink = g.log.sink();
    let count : i32 = sink.count();
    let mut first : i32 = count - LOG_ROWS;
    if (first < 0) {
        first = 0;
    }

    for (i of first..count) {
        let rec : LogRecord = sink.at(i);
        pen.text(x, y, rec.message, C_DIM);
        y = y + DEBUG_ROW_STEP;
    }
}

// screens — the title, pause and game-over overlays.
//
// Each dims what is behind it (the 3-D board keeps being drawn, so the title has a living backdrop) and puts
// a banner and a few lines on top. Text sizes use the integer scale of the baked face, which keeps its edges.
// Every position is a constant named for the screen and the thing it places, so a card can be moved or resized
// without reading the drawing code.

use smalt::Rect;

use crate::app::game::Game;
use crate::ui::hud::panel;
use crate::ui::palette::{C_TEXT, C_DIM, C_GOLD, C_RED, C_ACCENT, C_GREEN};
use crate::ui::pen::Pen;

/** Frames in one blink cycle of a prompt. */
const PROMPT_BLINK_PERIOD : i32 = 80;

/** Frames of that cycle during which the prompt shows. */
const PROMPT_BLINK_ON : i32 = 52;

/** The prompt line of a blinking screen is a banner of this scale. */
const PROMPT_SCALE : i32 = 2;

/** The darkening behind the title: black, `TITLE_DIM_NUM` parts in `TITLE_DIM_DEN`. */
const TITLE_DIM_TINT : i32 = 0x000000;
const TITLE_DIM_NUM : i32 = 2;
const TITLE_DIM_DEN : i32 = 5;

/** The title banner: top, and the scale of its letters. */
const TITLE_BANNER_Y : i32 = 110;
const TITLE_BANNER_SCALE : i32 = 7;

/** The tagline under the banner: top. */
const TITLE_TAGLINE_Y : i32 = 190;

/** The card of instructions: half width, width, top and height. */
const TITLE_CARD_HALF_W : i32 = 250;
const TITLE_CARD_W : i32 = 500;
const TITLE_CARD_Y : i32 = 232;
const TITLE_CARD_H : i32 = 188;

/** Inside the card, text starts this far from the left edge. */
const TITLE_CARD_INSET : i32 = 24;

/** Inside the card: the top of the headline, of the first control line, and of the closing warning. */
const TITLE_HEADLINE_Y : i32 = 16;
const TITLE_CONTROLS_Y : i32 = 48;
const TITLE_WARNING_Y : i32 = 154;

/** Distance between two control lines. */
const TITLE_ROW_STEP : i32 = 20;

/** The blinking start prompt: top. */
const TITLE_PROMPT_Y : i32 = 440;

/** The best score: the left edge's distance from the middle, and the top. */
const TITLE_BEST_LEFT : i32 = 60;
const TITLE_BEST_Y : i32 = 500;

/** The darkening behind the pause card: black, `PAUSE_DIM_NUM` parts in `PAUSE_DIM_DEN`. */
const PAUSE_DIM_TINT : i32 = 0x000000;
const PAUSE_DIM_NUM : i32 = 1;
const PAUSE_DIM_DEN : i32 = 2;

/** The pause banner sits this far above the window's middle, at this scale; its hint this far below. */
const PAUSE_BANNER_RISE : i32 = 70;
const PAUSE_BANNER_SCALE : i32 = 6;
const PAUSE_HINT_DROP : i32 = 20;

/** The darkening behind the game-over card: dark red, `OVER_DIM_NUM` parts in `OVER_DIM_DEN`. */
const OVER_DIM_TINT : i32 = 0x300000;
const OVER_DIM_NUM : i32 = 3;
const OVER_DIM_DEN : i32 = 5;

/** The game-over banner: top, and the scale of its letters. */
const OVER_BANNER_Y : i32 = 120;
const OVER_BANNER_SCALE : i32 = 4;

/** The score card: half width, width, top and height. */
const OVER_CARD_HALF_W : i32 = 190;
const OVER_CARD_W : i32 = 380;
const OVER_CARD_Y : i32 = 220;
const OVER_CARD_H : i32 = 150;

/** Inside the card, text starts this far from the left edge. */
const OVER_CARD_INSET : i32 = 28;

/** Inside the card: the top of the score label, of the big score figure (it is taller), and of the first tally line. */
const OVER_SCORE_Y : i32 = 18;
const OVER_FIGURE_Y : i32 = 14;
const OVER_TALLY_Y : i32 = 54;

/** Distance between two tally lines. */
const OVER_TALLY_STEP : i32 = 22;

/** The blinking play-again prompt and the title hint: top. */
const OVER_PROMPT_Y : i32 = 410;
const OVER_HINT_Y : i32 = 460;

/** The title: name, tagline, controls, the best score and the call to start. */
pub fn drawTitle(pen : Pen, g : Game) : void {
    pen.canvas.shade(Rect::make(0, 0, g.width, g.height), TITLE_DIM_TINT, TITLE_DIM_NUM, TITLE_DIM_DEN);
    let cx : i32 = g.width / 2;
    pen.banner(cx, TITLE_BANNER_Y, "BASTION", TITLE_BANNER_SCALE, C_ACCENT);
    pen.centred(cx, TITLE_TAGLINE_Y, "a tower defence on a tile grid, written in Axle", C_TEXT);

    let card : Rect = Rect::make(cx - TITLE_CARD_HALF_W, TITLE_CARD_Y, TITLE_CARD_W, TITLE_CARD_H);
    panel(pen, card);
    let x : i32 = card.x + TITLE_CARD_INSET;
    pen.text(x, card.y + TITLE_HEADLINE_Y, "Build towers. Bend the route. Hold the keep.", C_GOLD);

    let mut y : i32 = card.y + TITLE_CONTROLS_Y;
    pen.text(x, y, "1 / 2 / 3  choose Arrow, Cannon, Frost, then click a tile", C_TEXT);
    y = y + TITLE_ROW_STEP;
    pen.text(x, y, "click a tower to select it:  U upgrade   X sell", C_TEXT);
    y = y + TITLE_ROW_STEP;
    pen.text(x, y, "Space  call the next wave early for a bonus", C_TEXT);
    y = y + TITLE_ROW_STEP;
    pen.text(x, y, "WASD pan   Q/E turn   R/F tilt   wheel zoom   right-drag orbit", C_TEXT);
    y = y + TITLE_ROW_STEP;
    pen.text(x, y, "P pause    F3 debug overlay    M mute    F12 screenshot", C_TEXT);
    pen.text(
        x,
        card.y + TITLE_WARNING_Y,
        "Towers are walls: you may bend the route but never close it.",
        C_DIM
    );

    if (g.frames % PROMPT_BLINK_PERIOD < PROMPT_BLINK_ON) {
        pen.banner(cx, TITLE_PROMPT_Y, "press ENTER to start", PROMPT_SCALE, C_GREEN);
    }
    if (g.best > 0) {
        let after : i32 = pen.text(cx - TITLE_BEST_LEFT, TITLE_BEST_Y, "best score  ", C_DIM);
        pen.number(after, TITLE_BEST_Y, g.best as i64, C_GOLD);
    }
}

/** The pause card. */
pub fn drawPaused(pen : Pen, g : Game) : void {
    pen.canvas.shade(Rect::make(0, 0, g.width, g.height), PAUSE_DIM_TINT, PAUSE_DIM_NUM, PAUSE_DIM_DEN);
    let cx : i32 = g.width / 2;
    let middle : i32 = g.height / 2;
    pen.banner(cx, middle - PAUSE_BANNER_RISE, "PAUSED", PAUSE_BANNER_SCALE, C_TEXT);
    pen.centred(cx, middle + PAUSE_HINT_DROP, "P or ESC resume      T back to the title", C_DIM);
}

/** The end-of-run card: score, best, and how to go again. */
pub fn drawGameOver(pen : Pen, g : Game) : void {
    pen.canvas.shade(Rect::make(0, 0, g.width, g.height), OVER_DIM_TINT, OVER_DIM_NUM, OVER_DIM_DEN);
    let cx : i32 = g.width / 2;
    pen.banner(cx, OVER_BANNER_Y, "THE BASTION HAS FALLEN", OVER_BANNER_SCALE, C_RED);

    let card : Rect = Rect::make(cx - OVER_CARD_HALF_W, OVER_CARD_Y, OVER_CARD_W, OVER_CARD_H);
    panel(pen, card);
    let left : i32 = card.x + OVER_CARD_INSET;
    let afterLabel : i32 = pen.text(left, card.y + OVER_SCORE_Y, "score   ", C_DIM);
    pen.figure(afterLabel, card.y + OVER_FIGURE_Y, g.world.score as i64, C_GOLD);

    let mut y : i32 = card.y + OVER_TALLY_Y;
    let mut x : i32 = pen.text(left, y, "waves survived   ", C_DIM);
    pen.number(x, y, (g.world.wave - 1) as i64, C_TEXT);
    y = y + OVER_TALLY_STEP;
    x = pen.text(left, y, "enemies defeated   ", C_DIM);
    pen.number(x, y, g.world.kills as i64, C_TEXT);
    y = y + OVER_TALLY_STEP;
    x = pen.text(left, y, "best this session   ", C_DIM);
    pen.number(x, y, g.best as i64, C_GOLD);

    if (g.frames % PROMPT_BLINK_PERIOD < PROMPT_BLINK_ON) {
        pen.banner(cx, OVER_PROMPT_Y, "ENTER  play again", PROMPT_SCALE, C_GREEN);
    }
    pen.centred(cx, OVER_HINT_Y, "T  title", C_DIM);
}

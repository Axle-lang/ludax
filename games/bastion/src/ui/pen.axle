// pen — drawing text and figures with smalt's baked faces.
//
// `Pen` holds the two faces (prose and headline figures), a scratch block that numbers are formatted into, so a
// repaint draws gold and scores without allocating a string for each, and the frame it draws into: the owner
// binds the frame once per repaint and every call after that names only what to draw and where. Positions are
// the *top* of the text, which is what layout code thinks in; the pen converts to the baseline the faces want.

use smalt::{BitmapFont, Face, Scratch, Frame, Rect};

/** Bytes reserved for a formatted number, enough for a 64-bit figure with grouping. */
const SCRATCH_BYTES : i32 = 160;

/** Text drawing for the overlay. */
pub class Pen : Closeable {
    ui      : BitmapFont;
    big     : BitmapFont;
    scratch : Scratch;

    /** The frame the pen draws into; the interface code also paints its panels and bars there. */
    pub(crate) canvas : Frame;

    /** A pen with both baked faces, drawing into `canvas` until it is bound to another. */
    constructor(canvas : Frame) {
        self.canvas = canvas;
        self.ui = BitmapFont::baked(Face::Ui);
        self.big = BitmapFont::baked(Face::Headline);
        self.scratch = new Scratch(SCRATCH_BYTES);
    }

    /** Binds the pen to the frame of this repaint (the framebuffer view is renewed when the window resizes). */
    pub fn bind(mut self, canvas : Frame) : void {
        self.canvas = canvas;
    }

    /** Draws `s` with its top at `y`; returns the x where the next character would go. */
    pub fn text(self, x : i32, y : i32, s : string, ink : i32) : i32 {
        return self.ui.draw(self.canvas, x, y + self.ui.ascent(), s, ink);
    }

    /** Draws `s` with a one-pixel shadow so it reads over the 3-D scene. */
    pub fn shadowed(self, x : i32, y : i32, s : string, ink : i32, shade : i32) : i32 {
        self.ui.draw(self.canvas, x + 1, y + 1 + self.ui.ascent(), s, shade);
        return self.ui.draw(self.canvas, x, y + self.ui.ascent(), s, ink);
    }

    /** Draws `s` centred on `cx`. */
    pub fn centred(self, cx : i32, y : i32, s : string, ink : i32) : i32 {
        return self.text(cx - self.ui.width(s) / 2, y, s, ink);
    }

    /** Draws `s` ending at `right`. */
    pub fn right(self, right : i32, y : i32, s : string, ink : i32) : i32 {
        return self.text(right - self.ui.width(s), y, s, ink);
    }

    /** Draws `s` at an integer `scale`, centred on `cx`, for titles. */
    pub fn banner(self, cx : i32, y : i32, s : string, scale : i32, ink : i32) : void {
        let x : i32 = cx - self.ui.widthScaled(s, scale) / 2;
        self.ui.drawScaled(self.canvas, x, self.ui.baselineFor(y, scale), s, scale, ink);
    }

    /** The width of `s` in pixels. */
    pub fn width(self, s : string) : i32 {
        return self.ui.width(s);
    }

    /** Draws a whole number in the big face with its top at `y`; returns the x after it. */
    pub fn figure(mut self, x : i32, y : i32, n : i64, ink : i32) : i32 {
        self.scratch.reset();
        self.scratch.grouped(n);
        return self.drawScratch(self.big, x, y, ink);
    }

    /** Draws a whole number in the prose face; returns the x after it. */
    pub fn number(mut self, x : i32, y : i32, n : i64, ink : i32) : i32 {
        self.scratch.reset();
        self.scratch.decimal(n);
        return self.drawScratch(self.ui, x, y, ink);
    }

    /** Draws a label then a number then a suffix: `Wave 4 `. */
    pub fn labelled(mut self, x : i32, y : i32, label : string, n : i64, ink : i32) : i32 {
        let after : i32 = self.text(x, y, label, ink);
        return self.number(after, y, n, ink);
    }

    /** A tenths figure such as `3.5` from `tenths` = 35, in the prose face. */
    pub fn tenths(mut self, x : i32, y : i32, tenths : i64, ink : i32) : i32 {
        self.scratch.reset();
        self.scratch.tenths(tenths);
        return self.drawScratch(self.ui, x, y, ink);
    }

    /** A figure with two decimals such as `1.25` from `hundredths` = 125, in the prose face. */
    pub fn hundredths(mut self, x : i32, y : i32, hundredths : i64, ink : i32) : i32 {
        self.scratch.reset();
        self.scratch.hundredths(hundredths);
        return self.drawScratch(self.ui, x, y, ink);
    }

    /** Draws `s` centred in `r`. */
    pub fn inside(self, r : Rect, s : string, ink : i32) : void {
        self.ui.drawCentred(self.canvas, r, s, ink);
    }

    // The formatted number in the scratch block, drawn in `face` with its top at `y`.
    fn drawScratch(self, face : BitmapFont, x : i32, y : i32, ink : i32) : i32 {
        return face.drawBytes(
            self.canvas,
            x,
            y + face.ascent(),
            self.scratch.at(),
            0,
            self.scratch.length(),
            ink
        );
    }

    /** Releases the scratch block. */
    pub fn close(self) : void {
        self.scratch.close();
    }
}

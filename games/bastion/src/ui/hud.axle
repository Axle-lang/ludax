// hud — the heads-up display: the figures bar, the build dock, the selected tower's card and the messages.
//
// Drawn over the finished 3-D frame through smalt's `Frame`. Every rectangle comes from `Layout`, the same
// rectangles the mouse is tested against, and every colour from `palette`. Nothing here changes the game. Each
// pixel offset inside a bar, button or card is a constant named for the element it places, so the interface can
// be re-spaced without reading the drawing code.

use smalt::{Rect, Color};

use crate::app::game::Game;
use crate::sim::commands::sellValue;
use crate::sim::config::{TICK_HZ, MAX_LEVEL, EARLY_BONUS_PER_SECOND};
use crate::sim::stats::{TowerKind, EnemyKind, towerStats, TowerStats};
use crate::sim::units::Tower;
use crate::ui::layout::{Layout, BAR_H, BUILD_SLOTS};
use crate::ui::palette::{C_PANEL, C_EDGE, C_TEXT, C_DIM, C_GOLD, C_RED, C_GREEN, C_ACCENT, C_ICE, C_SHADOW};
use crate::ui::pen::Pen;

/** Corner radius of a panel and of a button. */
const HUD_CORNER : i32 = 8;

/** Corner radius of the small colour swatch of a tower design. */
const HUD_SWATCH_CORNER : i32 = 3;

/** A button's fill is its edge colour mixed into the panel colour, 1 part in this many; a disabled one is darker. */
const BUTTON_EDGE_MIX : i32 = 7;
const BUTTON_DISABLED_MIX : i32 = 3;

/** The figures bar: the text's top, the big figures' top (their face is taller) and the middle of the icons. */
const TOP_TEXT_Y : i32 = 12;
const TOP_FIGURE_Y : i32 = 8;
const TOP_ICON_Y : i32 = 20;

/** The game's name sits this far from the left edge. */
const TOP_TITLE_X : i32 = 14;

/** The gold coin: its x, the figure's x, its radius and its dark rim. */
const TOP_GOLD_X : i32 = 118;
const TOP_GOLD_FIGURE_X : i32 = 134;
const TOP_ICON_RADIUS : i32 = 8;
const TOP_COIN_RIM : i32 = 0x8A6A10;

/** The lives drop: its x and the figure's x. */
const TOP_LIVES_X : i32 = 258;
const TOP_LIVES_FIGURE_X : i32 = 274;

/** The wave number's x, and the gap between it and the wave status. */
const TOP_WAVE_X : i32 = 358;
const TOP_STATUS_GAP : i32 = 10;

/** At the right: the "Score" label, the score figure and the best score sit this far from the right edge. */
const TOP_SCORE_LABEL_FROM_RIGHT : i32 = 150;
const TOP_SCORE_FROM_RIGHT : i32 = 140;
const TOP_BEST_FROM_RIGHT : i32 = 70;

/** A build button: how far its contents sit from its edge, the swatch's width, and the columns of its text. */
const BUILD_PAD : i32 = 8;
const BUILD_SWATCH_W : i32 = 8;
const BUILD_KEY_X : i32 = 24;
const BUILD_LABEL_X : i32 = 40;

/** A build button's two text rows: the top of the name row and of the cost row, and the gap before "gold". */
const BUILD_NAME_Y : i32 = 8;
const BUILD_COST_Y : i32 = 30;
const BUILD_UNIT_GAP : i32 = 4;

/** The wave-call button: the text's left inset and its two rows, and the gap before the "next" preview. */
const CALL_INSET : i32 = 12;
const CALL_TITLE_Y : i32 = 8;
const CALL_NOTE_Y : i32 = 30;
const CALL_NEXT_GAP : i32 = 8;

/** The preview shows at most this many kinds (that is what fits before the button's edge), and a gap after each. */
const PREVIEW_MAX_KINDS : i32 = 3;
const PREVIEW_GAP : i32 = 4;

/** The selected tower's card: the swatch's left inset, top inset and height, and the text columns. */
const CARD_SWATCH_X : i32 = 10;
const CARD_SWATCH_Y : i32 = 12;
const CARD_SWATCH_H : i32 = 26;
const CARD_NAME_X : i32 = 26;
const CARD_STATS_X : i32 = 12;
const CARD_EFFECT_X : i32 = 110;

/** The card's rows: the name, the level, then damage, range and rate, which are `CARD_ROW_STEP` apart. */
const CARD_NAME_Y : i32 = 10;
const CARD_LEVEL_Y : i32 = 28;
const CARD_DAMAGE_Y : i32 = 52;
const CARD_ROW_STEP : i32 = 18;

/** Decimal figures are drawn in tenths: a range is scaled by this, and a rate counts ticks per ten seconds. */
const CARD_TENTHS : f64 = 10.0;
const CARD_RATE_TICKS : i32 = 600;

/** A card button's text: its inset from the left and the top of its two rows. */
const CARD_BUTTON_PAD : i32 = 8;
const CARD_BUTTON_TOP_Y : i32 = 3;
const CARD_BUTTON_BOTTOM_Y : i32 = 18;

/** The message line: its distance above the dock, its height, its padding either side of the text, the text's top. */
const TOAST_RISE : i32 = 38;
const TOAST_H : i32 = 28;
const TOAST_PAD : i32 = 28;
const TOAST_TEXT_Y : i32 = 6;

/** The control reminders: the left edge, the distance below the figures bar, and the step between the two lines. */
const HINT_X : i32 = 12;
const HINT_DROP : i32 = 8;
const HINT_STEP : i32 = 16;

/** The colour of a design's swatch in the interface, one per tower design. */
const SWATCH_ARROW : i32 = 0xC49A5A;
const SWATCH_CANNON : i32 = 0x8A8A94;
const SWATCH_FROST : i32 = 0x7FD8FF;

/** The selected tower and the numbers of its level: what the card and its buttons need together. */
struct Selected {
    /** The tower. */
    tower : Tower;

    /** The stats of its design at its level. */
    stats : TowerStats;
}

/** Draws the whole heads-up display for a running or paused game. */
pub fn drawHud(pen : Pen, g : Game, lay : Layout) : void {
    drawTopBar(pen, g, lay);
    drawDock(pen, g, lay);
    drawCard(pen, g, lay);
    drawToast(pen, g, lay);
    drawHints(pen, lay);
}

/** Draws a raised panel with a thin edge. */
pub fn panel(pen : Pen, r : Rect) : void {
    pen.canvas.fillRound(r, HUD_CORNER, C_PANEL);
    pen.canvas.roundBorder(r, HUD_CORNER, C_EDGE);
}

// A button: darker when it cannot be used, outlined in `edge`.
fn button(pen : Pen, r : Rect, edge : i32, enabled : bool) : void {
    let mut fill : i32 = Color::mix(C_PANEL, edge, 1, BUTTON_EDGE_MIX);
    if (!enabled) {
        fill = Color::mix(C_PANEL, 0x000000, 1, BUTTON_DISABLED_MIX);
    }
    pen.canvas.fillRound(r, HUD_CORNER, fill);
    pen.canvas.roundBorder(r, HUD_CORNER, edge);
}

// Gold, lives, wave, score, best.
fn drawTopBar(pen : Pen, g : Game, lay : Layout) : void {
    pen.canvas.fillRect(lay.top, C_PANEL);
    pen.canvas.hLine(0, BAR_H - 1, g.width, C_EDGE);
    pen.text(TOP_TITLE_X, TOP_TEXT_Y, "BASTION", C_ACCENT);

    pen.canvas.disc(TOP_GOLD_X, TOP_ICON_Y, TOP_ICON_RADIUS, C_GOLD);
    pen.canvas.ring(TOP_GOLD_X, TOP_ICON_Y, TOP_ICON_RADIUS, TOP_COIN_RIM);
    pen.figure(TOP_GOLD_FIGURE_X, TOP_FIGURE_Y, g.world.gold as i64, C_GOLD);

    pen.canvas.disc(TOP_LIVES_X, TOP_ICON_Y, TOP_ICON_RADIUS, C_RED);
    pen.figure(TOP_LIVES_FIGURE_X, TOP_FIGURE_Y, g.world.lives as i64, C_TEXT);

    let after : i32 = pen.labelled(TOP_WAVE_X, TOP_TEXT_Y, "Wave ", g.world.wave as i64, C_TEXT);
    waveStatus(pen, g, after + TOP_STATUS_GAP);

    pen.right(g.width - TOP_SCORE_LABEL_FROM_RIGHT, TOP_TEXT_Y, "Score", C_DIM);
    pen.figure(g.width - TOP_SCORE_FROM_RIGHT, TOP_FIGURE_Y, g.world.score as i64, C_TEXT);
    pen.labelled(g.width - TOP_BEST_FROM_RIGHT, TOP_TEXT_Y, "Best ", g.best as i64, C_DIM);
}

// "incoming" while enemies are still being released, a countdown otherwise.
fn waveStatus(pen : Pen, g : Game, x : i32) : void {
    if (g.world.spawning) {
        let left : i32 = g.world.plan.len() - g.world.planCursor;
        let after : i32 = pen.labelled(x, TOP_TEXT_Y, "- ", left as i64, C_RED);
        pen.text(after, TOP_TEXT_Y, " still to arrive", C_RED);
        return;
    }

    let seconds : i32 = g.world.countdown / TICK_HZ;
    let after : i32 = pen.text(x, TOP_TEXT_Y, "- next in ", C_DIM);
    let unit : i32 = pen.number(after, TOP_TEXT_Y, seconds as i64, C_DIM);
    pen.text(unit, TOP_TEXT_Y, " s", C_DIM);
}

// The three build buttons and the wave call.
fn drawDock(pen : Pen, g : Game, lay : Layout) : void {
    pen.canvas.fillRect(lay.dock, C_PANEL);
    pen.canvas.hLine(0, lay.dock.y, g.width, C_EDGE);
    for (slot of 0..BUILD_SLOTS) {
        buildButton(pen, g, lay.buildButton(slot), slot);
    }
    callButton(pen, g, lay);
}

// One build button: key, name, cost, and a swatch in the tower's colour.
fn buildButton(pen : Pen, g : Game, r : Rect, slot : i32) : void {
    let kind : TowerKind = TowerKind::fromSlot(slot);
    let cost : i32 = towerStats(kind, 1).cost;
    let affordable : bool = g.world.gold >= cost;
    let chosen : bool = g.ui.building && g.ui.kind == kind;
    let mut edge : i32 = C_EDGE;
    if (chosen) {
        edge = C_ACCENT;
    }
    button(pen, r, edge, affordable);

    let swatchHeight : i32 = r.h - 2 * BUILD_PAD;
    let swatchRect : Rect = Rect::make(r.x + BUILD_PAD, r.y + BUILD_PAD, BUILD_SWATCH_W, swatchHeight);
    pen.canvas.fillRound(swatchRect, HUD_SWATCH_CORNER, swatch(kind));
    pen.labelled(r.x + BUILD_KEY_X, r.y + BUILD_NAME_Y, "", (slot + 1) as i64, C_DIM);
    pen.text(r.x + BUILD_LABEL_X, r.y + BUILD_NAME_Y, kind.label(), C_TEXT);

    let mut ink : i32 = C_GOLD;
    if (!affordable) {
        ink = C_RED;
    }
    let after : i32 = pen.number(r.x + BUILD_KEY_X, r.y + BUILD_COST_Y, cost as i64, ink);
    pen.text(after + BUILD_UNIT_GAP, r.y + BUILD_COST_Y, "gold", C_DIM);
}

/** The colour that stands for a tower design in the interface. */
pub fn swatch(kind : TowerKind) : i32 {
    return match kind {
        TowerKind::Arrow => SWATCH_ARROW,
        TowerKind::Cannon => SWATCH_CANNON,
        TowerKind::Frost => SWATCH_FROST,
    };
}

// "Space: call wave" with the bonus it pays, and a count of what the next wave holds.
fn callButton(pen : Pen, g : Game, lay : Layout) : void {
    let r : Rect = lay.call;
    let ready : bool = !g.world.spawning;
    let mut edge : i32 = C_EDGE;
    if (ready) {
        edge = C_GREEN;
    }
    button(pen, r, edge, ready);

    let x : i32 = r.x + CALL_INSET;
    pen.text(x, r.y + CALL_TITLE_Y, "SPACE  call next wave", C_TEXT);
    if (!ready) {
        pen.text(x, r.y + CALL_NOTE_Y, "a wave is arriving", C_DIM);
        return;
    }

    let y : i32 = r.y + CALL_NOTE_Y;
    let bonus : i32 = g.world.countdown / TICK_HZ * EARLY_BONUS_PER_SECOND;
    let mut end : i32 = pen.text(x, y, "bonus ", C_DIM);
    end = pen.number(end, y, bonus as i64, C_GOLD);
    end = pen.text(end + CALL_NEXT_GAP, y, "next: ", C_DIM);
    drawPreview(pen, g, end, y);
}

// The mix of the coming wave as short counts: `7g 3r 1b`.
fn drawPreview(pen : Pen, g : Game, x : i32, y : i32) : void {
    let mut shown : i32 = 0;
    let mut pos : i32 = x;
    for (k of 0..EnemyKind::Boss as i32 + 1) {
        let n : i32 = g.world.upcomingOf(k);
        if (n <= 0 || shown >= PREVIEW_MAX_KINDS) {
            continue;
        }

        pos = pen.number(pos, y, n as i64, C_TEXT);
        pos = pen.text(pos, y, previewLetter(k), C_DIM) + PREVIEW_GAP;
        shown = shown + 1;
    }
}

fn previewLetter(kind : i32) : string {
    return match EnemyKind::fromIndex(kind) {
        EnemyKind::Grunt => "g",
        EnemyKind::Runner => "r",
        EnemyKind::Brute => "B",
        EnemyKind::Boss => "BOSS",
    };
}

// The selected tower: level, numbers, and the upgrade and sell buttons.
fn drawCard(pen : Pen, g : Game, lay : Layout) : void {
    if (g.ui.selected.isNone() || !g.world.towers.has(g.ui.selected)) {
        return;
    }

    let t : Tower = g.world.towers.get(g.ui.selected);
    let sel : Selected = Selected { tower: t, stats: towerStats(t.kind, t.level) };
    let s : TowerStats = sel.stats;
    let r : Rect = lay.card;
    panel(pen, r);

    let swatchRect : Rect = Rect::make(
        r.x + CARD_SWATCH_X,
        r.y + CARD_SWATCH_Y,
        BUILD_SWATCH_W,
        CARD_SWATCH_H
    );
    pen.canvas.fillRound(swatchRect, HUD_SWATCH_CORNER, swatch(t.kind));
    pen.text(r.x + CARD_NAME_X, r.y + CARD_NAME_Y, "${t.kind.label()} tower", C_TEXT);
    let after : i32 = pen.labelled(r.x + CARD_NAME_X, r.y + CARD_LEVEL_Y, "level ", t.level as i64, C_DIM);
    pen.labelled(after, r.y + CARD_LEVEL_Y, " / ", MAX_LEVEL as i64, C_DIM);

    let left : i32 = r.x + CARD_STATS_X;
    let damageY : i32 = r.y + CARD_DAMAGE_Y;
    let rangeY : i32 = damageY + CARD_ROW_STEP;
    let rateY : i32 = rangeY + CARD_ROW_STEP;
    pen.labelled(left, damageY, "damage  ", s.damage as i64, C_TEXT);
    let rangeEnd : i32 = pen.text(left, rangeY, "range   ", C_TEXT);
    pen.tenths(rangeEnd, rangeY, (s.range * CARD_TENTHS) as i64, C_TEXT);
    let rateEnd : i32 = pen.text(left, rateY, "shots/s ", C_TEXT);
    pen.tenths(rateEnd, rateY, (CARD_RATE_TICKS / s.cooldown) as i64, C_TEXT);

    drawCardEffect(pen, r, s);
    cardButtons(pen, g, lay, sel);
}

// The kind's special: blast radius, or slow strength.
fn drawCardEffect(pen : Pen, r : Rect, s : TowerStats) : void {
    let x : i32 = r.x + CARD_EFFECT_X;
    let y : i32 = r.y + CARD_DAMAGE_Y;
    if (s.splash > 0.0) {
        let end : i32 = pen.text(x, y, "blast ", C_DIM);
        pen.tenths(end, y, (s.splash * CARD_TENTHS) as i64, C_DIM);
    }
    if (s.slowPercent > 0) {
        let end : i32 = pen.number(x, y, s.slowPercent as i64, C_ICE);
        pen.text(end, y, "% slow", C_ICE);
    }
}

// The upgrade button, with its price or "MAX", and the sell button with what a sale pays.
fn cardButtons(pen : Pen, g : Game, lay : Layout, sel : Selected) : void {
    let s : TowerStats = sel.stats;
    let maxed : bool = sel.tower.level >= MAX_LEVEL;
    let canPay : bool = !maxed && g.world.gold >= s.upgradeCost;
    let mut edge : i32 = C_EDGE;
    if (canPay) {
        edge = C_GREEN;
    }
    button(pen, lay.upgrade, edge, canPay);

    if (maxed) {
        pen.inside(lay.upgrade, "MAX", C_DIM);
    } else {
        let x : i32 = lay.upgrade.x + CARD_BUTTON_PAD;
        pen.text(x, lay.upgrade.y + CARD_BUTTON_TOP_Y, "U  upgrade", C_TEXT);
        let mut ink : i32 = C_GOLD;
        if (!canPay) {
            ink = C_RED;
        }
        pen.number(x, lay.upgrade.y + CARD_BUTTON_BOTTOM_Y, s.upgradeCost as i64, ink);
    }

    button(pen, lay.sell, C_EDGE, true);
    let sellX : i32 = lay.sell.x + CARD_BUTTON_PAD;
    pen.text(sellX, lay.sell.y + CARD_BUTTON_TOP_Y, "X  sell", C_TEXT);
    let after : i32 = pen.text(sellX, lay.sell.y + CARD_BUTTON_BOTTOM_Y, "+", C_GOLD);
    pen.number(after, lay.sell.y + CARD_BUTTON_BOTTOM_Y, sellValue(sel.tower) as i64, C_GOLD);
}

// The message line above the dock.
fn drawToast(pen : Pen, g : Game, lay : Layout) : void {
    if (g.ui.toastFrames <= 0) {
        return;
    }

    let mut ink : i32 = C_TEXT;
    if (g.ui.toastBad) {
        ink = C_RED;
    }
    let w : i32 = pen.width(g.ui.toast) + TOAST_PAD;
    let r : Rect = Rect::make((g.width - w) / 2, lay.dock.y - TOAST_RISE, w, TOAST_H);
    panel(pen, r);
    pen.centred(g.width / 2, r.y + TOAST_TEXT_Y, g.ui.toast, ink);
}

// A reminder of the controls under the figures bar.
fn drawHints(pen : Pen, lay : Layout) : void {
    let y : i32 = BAR_H + HINT_DROP;
    pen.shadowed(
        HINT_X,
        y,
        "WASD pan   Q/E turn   R/F tilt   wheel zoom   right-drag orbit",
        C_DIM,
        C_SHADOW
    );

    let second : string = "1 2 3 build   click tower: U upgrade, X sell   P pause   F3 debug   M mute";
    pen.shadowed(HINT_X, y + HINT_STEP, second, C_DIM, C_SHADOW);
}

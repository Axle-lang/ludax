// renderer — the 3-D half of a frame: point smalt's camera and light, then draw the scene.
//
// `Renderer` owns the software device and everything the scene is drawn from. It is the one place that turns
// the game's numbers (ludax `f32`, the rig, the sky) into smalt's (`f64`, a `Camera`, a `DirectionalLight`).
// A frame is `scene(...)` for the 3-D pass, then the caller draws the 2-D overlay on `frame()`, then
// `present`. With no window (screenshots, tests) the framebuffer is simply written to a file.

use ludax::Vec3;
use smalt::{SoftDevice, Camera, DirectionalLight, Color, Vec3 as SVec3, Frame, Window};

use crate::gfx::assets::Assets;
use crate::gfx::ctx::DrawCtx;
use crate::gfx::effect_art::{drawShots, drawEffects};
use crate::gfx::enemy_art::drawEnemies;
use crate::gfx::ground::{Scenery, drawGround};
use crate::gfx::look::{DrawStats, Lighting};
use crate::gfx::marking::{Marking, drawMarking};
use crate::gfx::rig::Rig;
use crate::gfx::route::RouteOverlay;
use crate::gfx::sky::Sky;
use crate::gfx::tower_art::drawTowers;
use crate::gfx::view::View;
use crate::sim::world::World;

/** Draws the 3-D scene into an owned software framebuffer. */
pub class Renderer : Closeable {
    dev     : SoftDevice;
    camera  : Camera;
    assets  : Assets;
    stats   : DrawStats;
    scenery : Scenery;
    route   : RouteOverlay;
    frames  : i32 = 0;

    /** A renderer for a `w` by `h` window, with scenery for `seed`. */
    constructor(w : i32, h : i32, seed : u64) {
        self.dev = new SoftDevice(w, h);
        self.camera = new Camera();
        self.assets = new Assets();
        self.stats = new DrawStats();
        self.scenery = new Scenery(seed);
        self.route = new RouteOverlay();
    }

    /** Re-scatters the trees for a new run. */
    pub fn newRun(mut self, seed : u64) : void {
        self.scenery = new Scenery(seed);
    }

    /** Matches the framebuffer to a new window size. */
    pub fn resize(mut self, w : i32, h : i32) : void {
        self.dev.resize(w, h);
    }

    /** Objects drawn in the last 3-D pass. */
    pub fn drawnCount(self) : i32 {
        return self.stats.drawn;
    }

    /** Objects the frustum rejected in the last 3-D pass. */
    pub fn culledCount(self) : i32 {
        return self.stats.culled;
    }

    /** Length of the shown route in tiles. */
    pub fn routeLength(self) : i32 {
        return self.route.length();
    }

    /** The 2-D drawing view of the framebuffer, valid until the next resize. */
    pub fn frame(mut self) : Frame {
        return self.dev.frame();
    }

    /** Draws the 3-D scene for `world` as seen by `view`, lit by `sky`. */
    pub fn scene(mut self, world : World, rig : Rig, view : View, sky : Sky, marking : Marking) : void {
        self.frames = self.frames + 1;
        self.stats.reset();
        self.route.refresh(world);
        self.aim(rig, view);
        self.dev.setCamera(self.camera);
        self.lightWith(sky);

        let light = Lighting { ambient: sky.ambient, night: sky.night, clock: self.frames as f32 };
        let ctx : DrawCtx = DrawCtx {
            dev: self.dev,
            assets: self.assets,
            view: view,
            light: light,
            stats: self.stats,
        };
        drawGround(ctx, world, self.route, self.scenery);
        drawTowers(ctx, world);
        drawEnemies(ctx, world);
        drawShots(ctx, world);
        drawEffects(ctx, world);
        drawMarking(ctx, marking);
    }

    /** Shows the finished frame in `win`. */
    pub fn present(mut self, win : Window) : void {
        self.dev.endFrame(win);
    }

    /** Releases the device. */
    pub fn close(self) : void {
        self.dev.close();
    }

    // Points smalt's camera where the rig looks, with the field of view and planes the view uses.
    fn aim(mut self, rig : Rig, view : View) : void {
        self.camera.moveTo(toSmalt(rig.eye()));
        self.camera.lookAt(toSmalt(rig.target()));
        self.camera.setFieldOfView(View::fov() as f64);
        self.camera.setRange(View::nearPlane() as f64, View::farPlane() as f64);
        self.camera.setViewport(view.pixelsWide(), view.pixelsHigh());
    }

    // The sun or moon of `sky` as smalt's one directional light, and the colour the frame is cleared to.
    fn lightWith(mut self, sky : Sky) : void {
        let colour : Color = Color::rgb(sky.red as f64, sky.green as f64, sky.blue as f64);
        self.dev.setLight(DirectionalLight::make(toSmalt(sky.direction), colour));

        let back : Color = Color::rgb(sky.backRed as f64, sky.backGreen as f64, sky.backBlue as f64);
        self.dev.beginFrame(back);
    }
}

// A ludax vector as smalt's.
fn toSmalt(v : Vec3) : SVec3 {
    return SVec3::make(v.x as f64, v.y as f64, v.z as f64);
}

// model — small helpers that build the matrices and materials the scene draws with.
//
// The simulation speaks in `f32` and ludax types; smalt wants `f64` and its own. These functions are the
// seam: they take ludax vectors and give back smalt values, so the scene's drawing code reads as "put a
// box here" without conversions on every line.

use ludax::Vec3;
use smalt::{Mat4 as SMat4, Vec3 as SVec3, Material, Color};

/** The sharpness of a polished highlight: the exponent of the specular term. */
const MODEL_SHININESS : f64 = 40.0;

/** The model matrix of a thing at `at`, turned `yaw` radians about the vertical, scaled by `size` along each axis. */
pub fn placed(at : Vec3, yaw : f32, size : Vec3) : SMat4 {
    return SMat4::translation(SVec3::make(at.x as f64, at.y as f64, at.z as f64))
        .mul(SMat4::rotationY(yaw as f64))
        .mul(SMat4::scaling(SVec3::make(size.x as f64, size.y as f64, size.z as f64)));
}

/** The same without a turn. */
pub fn boxAt(at : Vec3, size : Vec3) : SMat4 {
    return placed(at, 0.0, size);
}

/** A colour from a packed 0xRRGGBB word. */
pub fn tint(packed : i32) : Color {
    return Color::unpack(packed);
}

/** A flat-coloured material with the scene's current `ambient` and no gloss. */
pub fn flat(packed : i32, ambient : f32) : Material {
    let mut m : Material = Material::matte(Color::unpack(packed));
    m.ambient = ambient as f64;
    return m;
}

/** A flat material that glows: its ambient rises toward full as `glow` goes from 0 to 1. */
pub fn lamp(packed : i32, ambient : f32, glow : f32) : Material {
    return flat(packed, ambient + (1.0 - ambient) * glow);
}

/** A textured material tinted by `packed` (0xFFFFFF leaves the texture as it is). */
pub fn skinned(packed : i32, ambient : f32) : Material {
    let mut m : Material = Material::textured();
    m.albedo = Color::unpack(packed);
    m.ambient = ambient as f64;
    return m;
}

/** A glossy textured material for polished things. */
pub fn glossy(packed : i32, ambient : f32, shine : f32) : Material {
    let mut m : Material = Material::glossy(shine as f64, MODEL_SHININESS);
    m.albedo = Color::unpack(packed);
    m.ambient = ambient as f64;
    return m;
}

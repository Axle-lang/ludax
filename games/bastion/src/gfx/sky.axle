// sky — the time of day: where the light comes from, what colour it is, and the colour behind the board.
//
// A full day is `DAY_TICKS` simulation ticks, so the cycle is a function of the tick count and a replay shows
// the same lighting. The sun rides a half circle over the board; when it sinks the moon rises on the opposite
// side with a dim blue light. The result is a plain struct of numbers: the renderer turns them into smalt's
// light, material ambience and clear colour, and this file stays free of smalt types.

use ludax::{Vec3, sin, cos, lerp, smoothstep, saturate, max, TAU};

use crate::sim::config::DAY_TICKS;

/** The lighting of one moment. */
pub struct Sky {
    /** Direction the light travels (unit length). */
    pub direction : Vec3;

    /** Red of the light. */
    pub red : f32;

    /** Green of the light. */
    pub green : f32;

    /** Blue of the light. */
    pub blue : f32;

    /** How much of a surface's colour shows without light, 0 to 1. */
    pub ambient : f32;

    /** Red of the clear colour behind the board. */
    pub backRed : f32;

    /** Green of the clear colour. */
    pub backGreen : f32;

    /** Blue of the clear colour. */
    pub backBlue : f32;

    /** 0 in full day, 1 in the middle of the night; lamps and windows glow by it. */
    pub night : f32;
}

/** The game starts this fraction of a day into the cycle, in the morning: one over this many. */
pub(crate) const SKY_START_DIVISOR : i32 = 8;

/** Height of the sun, as a sine, at which day has begun and at which it is complete. */
const SKY_DAY_FROM : f32 = -0.18;
const SKY_DAY_TO : f32 = 0.28;

/** Height of the sun at which dusk colours have faded out again. */
const SKY_DUSK_TO : f32 = 0.5;

/** The sun's path: how far it swings along x (it also leans over the board by `SKY_SUN_LEAN` along z). */
const SKY_SUN_SWING : f64 = 0.9;
const SKY_SUN_LEAN : f32 = 0.4;

/** The moon's path: the same, on the opposite side. */
const SKY_MOON_SWING : f64 = 0.7;
const SKY_MOON_LEAN : f32 = 0.5;

/** The light of the moon: a dim blue. */
const SKY_MOON_RED : f32 = 0.30;
const SKY_MOON_GREEN : f32 = 0.38;
const SKY_MOON_BLUE : f32 = 0.62;

/** The light of the sun at noon. */
const SKY_NOON_RED : f32 = 1.0;
const SKY_NOON_GREEN : f32 = 0.96;
const SKY_NOON_BLUE : f32 = 0.88;

/** The light of the sun at dusk: redder, with the blue sinking. */
const SKY_DUSK_RED : f32 = 1.0;
const SKY_DUSK_GREEN : f32 = 0.72;
const SKY_DUSK_BLUE : f32 = 0.50;

/** The share of a colour that shows without light at night and by day. */
const SKY_AMBIENT_NIGHT : f32 = 0.30;
const SKY_AMBIENT_DAY : f32 = 0.38;

/** The clear colour behind the board at night. */
const SKY_BACK_NIGHT_RED : f32 = 0.03;
const SKY_BACK_NIGHT_GREEN : f32 = 0.04;
const SKY_BACK_NIGHT_BLUE : f32 = 0.10;

/** The clear colour at noon. */
const SKY_BACK_NOON_RED : f32 = 0.42;
const SKY_BACK_NOON_GREEN : f32 = 0.62;
const SKY_BACK_NOON_BLUE : f32 = 0.88;

/** The clear colour at dusk, an orange glow over the horizon. */
const SKY_BACK_DUSK_RED : f32 = 0.85;
const SKY_BACK_DUSK_GREEN : f32 = 0.50;
const SKY_BACK_DUSK_BLUE : f32 = 0.40;

/** The night falls as day rises, `SKY_NIGHT_FADE` times as fast, so lamps are lit before the sun is gone. */
const SKY_NIGHT_FADE : f64 = 1.4;

/** The fraction of the day, 0 to 1, at simulation tick `tick`; the game starts in the morning. */
pub fn dayPhase(tick : i32) : f32 {
    let into : i32 = (tick + DAY_TICKS / SKY_START_DIVISOR) % DAY_TICKS;
    return into as f32 / DAY_TICKS as f32;
}

/** The sky at simulation tick `tick`. */
pub fn skyAt(tick : i32) : Sky {
    let angle : f32 = dayPhase(tick) * TAU;
    let height : f32 = sin(angle);
    let day : f32 = smoothstep(SKY_DAY_FROM, SKY_DAY_TO, height);
    let dusk : f32 = (1.0 as f32) - smoothstep((0.0 as f32), SKY_DUSK_TO, max(height, (0.0 as f32)));
    let sun : Vec3 = Vec3::make(cos(angle) * SKY_SUN_SWING, height, SKY_SUN_LEAN).normalized();
    let moon : Vec3 = Vec3::make(-cos(angle) * SKY_MOON_SWING, -height, SKY_MOON_LEAN).normalized();
    let glow : f32 = dusk * day;
    return Sky {
        direction: moon.lerp(sun, day).normalized().negated(),
        red: skyBlend(SKY_MOON_RED, SKY_NOON_RED, SKY_DUSK_RED, dusk, day),
        green: skyBlend(SKY_MOON_GREEN, SKY_NOON_GREEN, SKY_DUSK_GREEN, dusk, day),
        blue: skyBlend(SKY_MOON_BLUE, SKY_NOON_BLUE, SKY_DUSK_BLUE, dusk, day),
        ambient: lerp(SKY_AMBIENT_NIGHT, SKY_AMBIENT_DAY, day),
        backRed: skyBlend(SKY_BACK_NIGHT_RED, SKY_BACK_NOON_RED, SKY_BACK_DUSK_RED, glow, day),
        backGreen: skyBlend(SKY_BACK_NIGHT_GREEN, SKY_BACK_NOON_GREEN, SKY_BACK_DUSK_GREEN, glow, day),
        backBlue: skyBlend(SKY_BACK_NIGHT_BLUE, SKY_BACK_NOON_BLUE, SKY_BACK_DUSK_BLUE, glow, day),
        night: saturate(1.0 - day * SKY_NIGHT_FADE),
    };
}

// One colour channel: `night` in the dark, and by day `noon` turning toward `dusk` as `duskness` rises.
fn skyBlend(night : f32, noon : f32, dusk : f32, duskness : f32, day : f32) : f32 {
    return lerp(night, lerp(noon, dusk, duskness), day);
}

// frame — one complete picture: the 3-D scene, then the overlay that belongs to the current screen.
//
// Both the window loop and the headless screenshot call this, so what a screenshot shows is exactly what the
// window would. It decides nothing about the game; it only reads `Game` and paints.

use crate::app::game::Game;
use crate::gfx::marking::Marking;
use crate::gfx::renderer::Renderer;
use crate::gfx::sky::{Sky, skyAt};
use crate::sim::commands::{Verdict, checkBuild};
use crate::ui::debug::{DebugCounts, drawDebug};
use crate::ui::hud::drawHud;
use crate::ui::layout::Layout;
use crate::ui::overlay::drawWorldLabels;
use crate::ui::palette::{C_GREEN, C_RED, C_GOLD, C_SHADOW};
use crate::ui::pen::Pen;
use crate::ui::screens::{drawTitle, drawPaused, drawGameOver};
use crate::ui::state::Screen;

/** Ticks of sky that pass per frame behind the title, so the day turns while nobody plays. */
const TITLE_SKY_SPEED : i32 = 3;

/** Where the build hint sits relative to the pointer: pixels right of it and below it. */
const HINT_OFFSET_X : i32 = 16;
const HINT_OFFSET_Y : i32 = 12;

/** Draws the frame for the game's current screen into `r`'s framebuffer (not yet presented). */
pub fn drawFrame(r : Renderer, pen : Pen, g : Game, fps : i32) : void {
    g.updateView();
    let verdict : Verdict = placementVerdict(g);
    let marking : Marking = markingFor(g, verdict);
    let sceneToken : i32 = g.probe.profiler.begin(g.probe.scene);
    r.scene(g.world, g.rig, g.view, skyFor(g), marking);
    g.probe.profiler.end(sceneToken);
    let overlayToken : i32 = g.probe.profiler.begin(g.probe.overlay);
    drawOverlay(r, pen, g, fps, verdict);
    g.probe.profiler.end(overlayToken);
}

// The sky for the current screen: the run's clock while playing, a slowly turning day behind the menus.
fn skyFor(g : Game) : Sky {
    if (g.screen == Screen::Title) {
        return skyAt(g.frames * TITLE_SKY_SPEED);
    }
    return skyAt(g.world.tick);
}

// Whether the design being placed may go on the hovered tile.
fn placementVerdict(g : Game) : Verdict {
    if (g.screen != Screen::Playing || !g.ui.building || g.ui.hoverTile < 0) {
        return Verdict::Done;
    }
    return checkBuild(g.world, g.ui.kind, g.ui.hoverTile);
}

// The coloured tile under the pointer and the ring on the selected tower.
fn markingFor(g : Game, verdict : Verdict) : Marking {
    let mut hover : i32 = -1;
    let mut colour : i32 = C_GOLD;
    if (g.screen == Screen::Playing && g.ui.hoverTile >= 0) {
        hover = g.ui.hoverTile;
        if (g.ui.building) {
            colour = C_GREEN;
            if (verdict != Verdict::Done) {
                colour = C_RED;
            }
        }
    }
    let mut selected : i32 = -1;
    if (!g.ui.selected.isNone() && g.world.towers.has(g.ui.selected)) {
        selected = g.world.towers.get(g.ui.selected).tile;
    }
    return Marking { hover: hover, hoverColor: colour, selected: selected };
}

// The 2-D layer for the current screen.
fn drawOverlay(r : Renderer, pen : Pen, g : Game, fps : i32, verdict : Verdict) : void {
    pen.bind(r.frame());
    let lay : Layout = Layout::forWindow(g.width, g.height);
    match g.screen {
        Screen::Title => drawTitle(pen, g),
        Screen::Playing => {
            drawBoard(pen, g, lay, verdict);
            drawBuildHint(pen, g, verdict);
        },
        Screen::Paused => {
            drawBoard(pen, g, lay, verdict);
            drawPaused(pen, g);
        },
        Screen::GameOver => {
            drawBoard(pen, g, lay, verdict);
            drawGameOver(pen, g);
        },
    }

    if (g.ui.showDebug) {
        let counts : DebugCounts = DebugCounts {
            fps: fps,
            drawn: r.drawnCount(),
            culled: r.culledCount(),
            routeLength: r.routeLength(),
        };
        drawDebug(pen, g, counts);
    }
}

// What every screen with a board shows: the labels over the world and the heads-up display.
fn drawBoard(pen : Pen, g : Game, lay : Layout, verdict : Verdict) : void {
    drawWorldLabels(pen, g, verdict);
    drawHud(pen, g, lay);
}

// Why the hovered tile will not take the chosen tower, next to the pointer.
fn drawBuildHint(pen : Pen, g : Game, verdict : Verdict) : void {
    if (verdict == Verdict::Done || g.ui.hoverTile < 0) {
        return;
    }
    let x : i32 = g.ui.mouseX + HINT_OFFSET_X;
    let y : i32 = g.ui.mouseY + HINT_OFFSET_Y;
    pen.shadowed(x, y, verdict.message(), C_RED, C_SHADOW);
}

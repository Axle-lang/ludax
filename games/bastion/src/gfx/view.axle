// view — what the camera sees, as the maths the game needs: projection, culling, picking rays.
//
// Built once a frame from the rig and the window size. The view-projection matrix is ludax's (Vulkan clip
// space, y down), so the same matrix feeds the `Frustum` that culls what is drawn, the inverse that turns a
// mouse position into a ray, and the projection that puts health bars over enemies. The smalt device draws
// from its own camera, which the renderer points at the same eye and target; the two agree because both are
// perspective looks at the same point with the same field of view.

use ludax::{Mat4, Frustum, Aabb, Ray, Plane, RayHit, Vec3, Vec4, Containment, rayPlane, toRadians};

use crate::gfx::rig::Rig;
use crate::sim::config::FOV_DEGREES;
use crate::sim::grid::Grid;

/** Nearest drawn distance. */
const NEAR_PLANE : f32 = 0.5;

/** Farthest drawn distance. */
const FAR_PLANE : f32 = 90.0;

/** Clip-space w at or below which a point is behind the camera and cannot be projected. */
const BEHIND_CAMERA_W : f32 = 0.0001;

/** Clip space runs from -1 to 1; this maps it to 0 to 1 of the window. Double, so the sum rounds once. */
const VIEW_NDC_HALF : f64 = 0.5;

/** A pixel's own point is its middle, this far from its corner. */
const VIEW_PIXEL_CENTRE : f32 = 0.5;

/** A point on the screen, or the news that it is not on it. */
pub struct ScreenPoint {
    /** Pixels from the left. */
    pub x : i32;

    /** Pixels from the top. */
    pub y : i32;

    /** False when the point is behind the camera. */
    pub visible : bool;
}

/** The camera's matrices, frustum and viewport for one frame. */
pub class View {
    width    : i32 = 1;
    height   : i32 = 1;
    eye      : Vec3 = Vec3::zero();
    viewProj : Mat4 = Mat4::identity();
    inverse  : Mat4 = Mat4::identity();
    frustum  : Frustum = Frustum {};

    /** Vertical field of view in radians, shared with the smalt camera. */
    pub static fn fov() : f32 {
        return toRadians(FOV_DEGREES);
    }

    /** Near plane shared with the smalt camera. */
    pub static fn nearPlane() : f32 {
        return NEAR_PLANE;
    }

    /** The far plane. */
    pub static fn farPlane() : f32 {
        return FAR_PLANE;
    }

    /** Recomputes everything for `rig` and a `w` by `h` window. */
    pub fn update(mut self, rig : Rig, w : i32, h : i32) : void {
        self.width = w;
        self.height = h;
        self.eye = rig.eye();
        let aspect : f32 = w as f32 / h as f32;
        let proj : Mat4 = Mat4::perspective(View::fov(), aspect, NEAR_PLANE, FAR_PLANE);
        let look : Mat4 = Mat4::lookAt(self.eye, rig.target(), Vec3::unitY());
        self.viewProj = proj.mul(look);
        self.inverse = self.viewProj.inverse();
        self.frustum = Frustum::fromViewProjection(self.viewProj);
    }

    /** Window width in pixels. */
    pub fn pixelsWide(self) : i32 {
        return self.width;
    }

    /** Window height in pixels. */
    pub fn pixelsHigh(self) : i32 {
        return self.height;
    }

    /** Camera position in world space. */
    pub fn eyePosition(self) : Vec3 {
        return self.eye;
    }

    /** True when any part of the box centred at `center` with half sizes `half` may be seen. */
    pub fn seesBox(self, center : Vec3, half : Vec3) : bool {
        let box : Aabb = Aabb::fromCenterHalfSize(center, half);
        return self.frustum.testAabb(box) != Containment::Outside;
    }

    /** Where world point (`x`, `y`, `z`) lands on the screen. */
    pub fn project(self, x : f32, y : f32, z : f32) : ScreenPoint {
        let clip : Vec4 = self.viewProj.transformVec4(Vec4 { x: x, y: y, z: z, w: 1.0 });
        if (clip.w <= BEHIND_CAMERA_W) {
            return ScreenPoint { x: 0, y: 0, visible: false };
        }
        let nx : f32 = clip.x / clip.w;
        let ny : f32 = clip.y / clip.w;
        let px : i32 = ((nx * VIEW_NDC_HALF + VIEW_NDC_HALF) * self.width as f32) as i32;
        let py : i32 = ((ny * VIEW_NDC_HALF + VIEW_NDC_HALF) * self.height as f32) as i32;
        return ScreenPoint { x: px, y: py, visible: true };
    }

    /** The ray from the camera through window pixel (`px`, `py`). */
    pub fn rayThrough(self, px : i32, py : i32) : Ray {
        let across : f32 = (px as f32 + VIEW_PIXEL_CENTRE) / self.width as f32;
        let down : f32 = (py as f32 + VIEW_PIXEL_CENTRE) / self.height as f32;
        let nx : f32 = across * (2.0 as f32) - (1.0 as f32);
        let ny : f32 = down * (2.0 as f32) - (1.0 as f32);
        let near : Vec3 = self.inverse.projectPoint(Vec3::make(nx, ny, 0.0));
        let far : Vec3 = self.inverse.projectPoint(Vec3::make(nx, ny, 1.0));
        return Ray::between(near, far);
    }

    /** The tile where the ray through window pixel (`px`, `py`) meets the ground, or -1 off the board. */
    pub fn groundTile(self, px : i32, py : i32) : i32 {
        let ray : Ray = self.rayThrough(px, py);
        let hit : RayHit = rayPlane(ray, Plane::fromPointNormal(Vec3::zero(), Vec3::unitY()));
        if (!hit.hit) {
            return -1;
        }
        let p : Vec3 = ray.at(hit.t);
        return Grid::tileAt(p.x, p.z);
    }
}

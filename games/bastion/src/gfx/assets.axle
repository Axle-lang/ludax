// assets — the meshes and textures the scene is drawn from, made in code.
//
// There are no files to load: every mesh is one of smalt's primitives and every texture is painted here from
// a fixed-seed `Pcg32`, so a build is self-contained and looks the same on every machine. `Assets` owns them
// all for the life of the program; the scene borrows them each frame.

use ludax::Pcg32;
use smalt::{Mesh, Primitives, Texture, Color};

/** Texels along one side of a tile texture. */
const TEX_SIZE : i32 = 48;

/** Brightness of a speckle texel, in percent of the mixed colour. */
const SPECKLE_SHADE : i32 = 86;

/** Brightness of the darker border that makes a tile read as a grid, in percent. */
const EDGE_SHADE : i32 = 78;

/** Every texel mixes its two colours by a share out of this many. */
const TEX_MIX_STEPS : i32 = 100;

/** The textures are painted from this seed and stream, fixed so every machine gets the same look. */
const TEX_SEED : u64 = 20241104;
const TEX_STREAM : u64 = 9;

/** A tile and a cube are one unit across; a sphere has this radius. */
const MESH_UNIT : f64 = 1.0;
const MESH_BALL_RADIUS : f64 = 0.5;

/** The ball's rings and segments, and the coarser ones of the pebble. */
const MESH_BALL_RINGS : i32 = 12;
const MESH_BALL_SEGMENTS : i32 = 8;
const MESH_PEBBLE_RINGS : i32 = 6;
const MESH_PEBBLE_SEGMENTS : i32 = 4;

/** The land around the board: width along x and depth along z, in tiles. */
const MESH_LAND_WIDTH : f64 = 120.0;
const MESH_LAND_DEPTH : f64 = 60.0;

/** Grass: dark and light speckle colours, and the chance in percent that a texel is a darker speckle. */
const GRASS_DARK : i32 = 0x4E8F3A;
const GRASS_LIGHT : i32 = 0x7DBB56;
const GRASS_SPECKLE : i32 = 14;

/** Trodden earth, the same. */
const DIRT_DARK : i32 = 0x9C7B4E;
const DIRT_LIGHT : i32 = 0xC4A56E;
const DIRT_SPECKLE : i32 = 18;

/** Grey stone, the same. */
const STONE_DARK : i32 = 0x7A7F86;
const STONE_LIGHT : i32 = 0xA9AEB5;
const STONE_SPECKLE : i32 = 22;

/** Planks, the same. */
const WOOD_DARK : i32 = 0x6B4A2B;
const WOOD_LIGHT : i32 = 0x8E6A3F;
const WOOD_SPECKLE : i32 = 16;

/** Leaves, the same. */
const LEAVES_DARK : i32 = 0x2F6B2C;
const LEAVES_LIGHT : i32 = 0x4F9A3D;
const LEAVES_SPECKLE : i32 = 20;

/** Every mesh and texture the game draws with. */
pub class Assets {
    /** A one-by-one ground quad facing up. */
    pub tile : Mesh;

    /** A unit cube centred on the origin. */
    pub cube : Mesh;

    /** A sphere of radius one half. */
    pub ball : Mesh;

    /** A coarse sphere for small things (shots, sparks). */
    pub pebble : Mesh;

    /** A big quad for the land around the board. */
    pub land : Mesh;

    /** Short grass. */
    pub grass : Texture;

    /** Trodden earth, drawn under the enemies' current route. */
    pub dirt : Texture;

    /** Grey stone for rocks, tower bases and the keep. */
    pub stone : Texture;

    /** Planks. */
    pub wood : Texture;

    /** Leaves. */
    pub leaves : Texture;

    /** Meshes and textures, painted from a fixed seed. */
    constructor() {
        self.tile = Primitives::ground(MESH_UNIT, MESH_UNIT);
        self.cube = Primitives::cube(MESH_UNIT);
        self.ball = Primitives::sphere(MESH_BALL_RADIUS, MESH_BALL_RINGS, MESH_BALL_SEGMENTS);
        self.pebble = Primitives::sphere(MESH_BALL_RADIUS, MESH_PEBBLE_RINGS, MESH_PEBBLE_SEGMENTS);
        self.land = Primitives::ground(MESH_LAND_WIDTH, MESH_LAND_DEPTH);
        let rng = new Pcg32(TEX_SEED, TEX_STREAM);
        self.grass = painted(rng, GRASS_DARK, GRASS_LIGHT, GRASS_SPECKLE, true);
        self.dirt = painted(rng, DIRT_DARK, DIRT_LIGHT, DIRT_SPECKLE, true);
        self.stone = painted(rng, STONE_DARK, STONE_LIGHT, STONE_SPECKLE, false);
        self.wood = painted(rng, WOOD_DARK, WOOD_LIGHT, WOOD_SPECKLE, false);
        self.leaves = painted(rng, LEAVES_DARK, LEAVES_LIGHT, LEAVES_SPECKLE, false);
    }
}

// A square texture of speckle between two colours, with an optional darker edge so tiles read as a grid.
fn painted(rng : Pcg32, dark : i32, light : i32, speckle : i32, edged : bool) : Texture {
    let t = new Texture(TEX_SIZE, TEX_SIZE);
    for (y of 0..TEX_SIZE) {
        for (x of 0..TEX_SIZE) {
            let mut c : i32 = Color::mix(dark, light, rng.range(0, TEX_MIX_STEPS), TEX_MIX_STEPS);
            if (rng.range(0, TEX_MIX_STEPS) < speckle) {
                c = Color::scale(c, SPECKLE_SHADE, TEX_MIX_STEPS);
            }
            if (edged && (x == 0 || y == 0 || x == TEX_SIZE - 1 || y == TEX_SIZE - 1)) {
                c = Color::scale(c, EDGE_SHADE, TEX_MIX_STEPS);
            }
            t.put(x, y, c);
        }
    }
    return t;
}

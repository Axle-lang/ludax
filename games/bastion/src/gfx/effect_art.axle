// effect_art — drawing what flies and flashes: projectiles in flight, sparks, blast rings and leak puffs.
//
// Shots are placed from their simulation position and height and turned toward where they are heading; effects
// shrink or grow with the fraction of their life left. The gold labels of `Fx` are not drawn here: the overlay
// owns text. Nothing here changes the simulation.

use ludax::{Vec3, sin, cos, atan2};

use crate::gfx::ctx::{BoxSpec, DrawCtx};
use crate::sim::stats::TowerKind;
use crate::sim::units::{Shot, Fx, FxKind};
use crate::sim::world::World;

/** A shot's bounds for the frustum test: its half extent. */
const SHOT_CULL_HALF : f32 = 0.3;

/** An arrow in flight: its length and thickness, and its tint. */
const SHOT_ARROW_LENGTH : f32 = 0.34;
const SHOT_ARROW_THICK : f32 = 0.04;
const SHOT_ARROW_TINT : i32 = 0xF0E8D0;

/** A cannonball: its size and tint. */
const SHOT_CANNON_SIZE : f32 = 0.26;
const SHOT_CANNON_TINT : i32 = 0x202024;

/** A frost bolt: its size and tint. */
const SHOT_FROST_SIZE : f32 = 0.2;
const SHOT_FROST_TINT : i32 = 0x9FE8FF;

/** An effect's bounds for the frustum test: its half extent. */
const FX_CULL_HALF : f32 = 1.6;

/** A spark's size is the base plus a share of its remaining life, and it glows this colour. */
const SPARK_SIZE_BASE : f32 = 0.06;
const SPARK_SIZE_LIFE : f32 = 0.05;
const SPARK_TINT : i32 = 0xFFC040;

/** A leak puff grows from the base by the elapsed share of its life, and glows this colour. */
const LEAK_SIZE_BASE : f32 = 0.3;
const LEAK_SIZE_GROWTH : f32 = 1.0;
const LEAK_TINT : i32 = 0xFF3030;

/** Pebbles that make a blast ring. */
const RING_PEBBLES : i32 = 14;

/** Radians between two pebbles: one fourteenth of a turn, written out so the picture is byte-identical to the original. */
const RING_STEP : f32 = 0.4488;

/** A ring's `value` is its radius in hundredths of a tile; it shrinks by this share of the radius over its life. */
const RING_VALUE_UNIT : f32 = 100.0;
const RING_FADE : f32 = 0.6;

/** A ring pebble's size is the base plus a share of its remaining life; it lies flat at this height and colour. */
const RING_PEBBLE_BASE : f32 = 0.05;
const RING_PEBBLE_LIFE : f32 = 0.1;
const RING_PEBBLE_FLAT : f32 = 0.5;
const RING_PEBBLE_Y : f32 = 0.08;
const RING_TINT : i32 = 0xFF9A30;

/** Draws every projectile in flight. */
pub fn drawShots(ctx : DrawCtx, world : World) : void {
    for (d of 0..world.shots.len()) {
        let s : Shot = world.shots.valueAt(d);
        let at : Vec3 = Vec3::make(s.pos.x, s.height, s.pos.y);
        let half : Vec3 = Vec3::splat(SHOT_CULL_HALF);
        if (!ctx.sees(at, half)) {
            continue;
        }

        let ahead = s.aimAt.minus(s.pos);
        let yaw : f32 = (0.0 as f32) - atan2(ahead.y, ahead.x);
        match s.kind {
            TowerKind::Arrow => {
                let size : Vec3 = Vec3::make(SHOT_ARROW_LENGTH, SHOT_ARROW_THICK, SHOT_ARROW_THICK);
                let arrow : BoxSpec = BoxSpec::make(at, size, SHOT_ARROW_TINT);
                ctx.paintTurned(ctx.assets.cube, ctx.assets.stone, arrow, yaw);
            },
            TowerKind::Cannon => {
                let ball : BoxSpec = BoxSpec::make(at, Vec3::splat(SHOT_CANNON_SIZE), SHOT_CANNON_TINT);
                ctx.paintBox(ctx.assets.ball, ctx.assets.stone, ball);
            },
            TowerKind::Frost => {
                let bolt : BoxSpec = BoxSpec::make(at, Vec3::splat(SHOT_FROST_SIZE), SHOT_FROST_TINT);
                ctx.glowBox(ctx.assets.ball, ctx.assets.stone, bolt, 1.0);
            },
        }
    }
}

/** Draws the sparks, blast rings and leak puffs (the gold labels are drawn by the overlay). */
pub fn drawEffects(ctx : DrawCtx, world : World) : void {
    for (d of 0..world.fx.len()) {
        let f : Fx = world.fx.valueAt(d);
        let at : Vec3 = Vec3::make(f.pos.x, f.pos.y, f.pos.z);
        if (!ctx.sees(at, Vec3::splat(FX_CULL_HALF))) {
            continue;
        }

        let fraction : f32 = f.life as f32 / f.span as f32;
        match f.kind {
            FxKind::Spark => {
                let k : f32 = SPARK_SIZE_BASE + SPARK_SIZE_LIFE * fraction;
                let spark : BoxSpec = BoxSpec::make(at, Vec3::splat(k), SPARK_TINT);
                ctx.glowBox(ctx.assets.pebble, ctx.assets.stone, spark, 1.0);
            },
            FxKind::Ring => drawRing(ctx, f, fraction),
            FxKind::Leak => {
                let k : f32 = LEAK_SIZE_BASE + LEAK_SIZE_GROWTH * ((1.0 as f32) - fraction);
                let puff : BoxSpec = BoxSpec::make(at, Vec3::splat(k), LEAK_TINT);
                ctx.glowBox(ctx.assets.pebble, ctx.assets.stone, puff, 1.0);
            },
            FxKind::Coin => {},
        }
    }
}

// A ring of pebbles that grows to the blast radius and fades by shrinking.
fn drawRing(ctx : DrawCtx, f : Fx, fraction : f32) : void {
    let radius : f32 = f.value as f32 / RING_VALUE_UNIT * ((1.0 as f32) - fraction * RING_FADE);
    let k : f32 = RING_PEBBLE_BASE + RING_PEBBLE_LIFE * fraction;
    let size : Vec3 = Vec3::make(k, k * RING_PEBBLE_FLAT, k);
    for (i of 0..RING_PEBBLES) {
        let angle : f32 = i as f32 * RING_STEP;
        let at : Vec3 = Vec3::make(
            f.pos.x + cos(angle) * radius,
            RING_PEBBLE_Y,
            f.pos.z + sin(angle) * radius
        );
        let pebble : BoxSpec = BoxSpec::make(at, size, RING_TINT);
        ctx.glowBox(ctx.assets.pebble, ctx.assets.stone, pebble, 1.0);
    }
}

// marking — what the pointer marks on the ground: a coloured tile under it and a ring on the selected tower.
//
// Both are glowing slabs just above the ground so they read at any time of day. The hover colour is chosen by
// the caller (green for a valid build, red for a refused one, gold for plain hovering); the ring pulses on the
// renderer's frame clock, not the simulation's, so it keeps breathing while the game is paused.

use ludax::{Vec2, Vec3, sin};

use crate::gfx::ctx::{BoxSpec, DrawCtx};
use crate::sim::grid::Grid;

/** The hover marker: height of its centre, side length and thickness. */
const MARK_HOVER_Y : f32 = 0.03;
const MARK_HOVER_SIDE : f32 = 0.94;
const MARK_HOVER_THICK : f32 = 0.04;

/** The selection ring: height of its centre, thickness, and its warm yellow. */
const MARK_RING_Y : f32 = 0.025;
const MARK_RING_THICK : f32 = 0.03;
const MARK_RING_TINT : i32 = 0xFFE27A;

/** The ring's side swells by `MARK_PULSE_DEPTH` of a tile around one tile, `MARK_PULSE_SPEED` radians per frame. */
const MARK_PULSE_DEPTH : f32 = 0.04;
const MARK_PULSE_SPEED : f32 = 0.15;

/** What the pointer marks on the ground this frame. */
pub struct Marking {
    /** Tile under the pointer, -1 for none. */
    pub hover : i32;

    /** Colour of the hover marker as 0xRRGGBB. */
    pub hoverColor : i32;

    /** Tile of the selected tower, -1 for none. */
    pub selected : i32;
}

/** Draws the hover tile and the selection ring that `m` asks for. */
pub fn drawMarking(ctx : DrawCtx, m : Marking) : void {
    if (m.hover >= 0) {
        let c : Vec2 = Grid::centerOf(m.hover);
        let size : Vec3 = Vec3::make(MARK_HOVER_SIDE, MARK_HOVER_THICK, MARK_HOVER_SIDE);
        let tile : BoxSpec = BoxSpec::make(Vec3::make(c.x, MARK_HOVER_Y, c.y), size, m.hoverColor);
        ctx.glowBox(ctx.assets.cube, ctx.assets.stone, tile, 1.0);
    }

    if (m.selected >= 0) {
        let c : Vec2 = Grid::centerOf(m.selected);
        let pulse : f32 = (1.0 as f32) + MARK_PULSE_DEPTH * sin(ctx.light.clock * MARK_PULSE_SPEED);
        let size : Vec3 = Vec3::make(pulse, MARK_RING_THICK, pulse);
        let ring : BoxSpec = BoxSpec::make(Vec3::make(c.x, MARK_RING_Y, c.y), size, MARK_RING_TINT);
        ctx.glowBox(ctx.assets.cube, ctx.assets.stone, ring, 1.0);
    }
}

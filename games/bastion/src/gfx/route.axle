// route — which tiles the enemies' current route crosses, for drawing it on the ground.
//
// The renderer must not ask the world's own route book (answering would fill its memo in an order that
// depends on whether anyone is drawing), so the overlay keeps a pathfinder of its own and recomputes the
// spawn-to-base route only when the world's map version changes. The route shown is the one a new enemy
// would take right now, which is exactly what the player is shaping by building.

use ludax::{BitSet, Vec};

use crate::sim::grid::Grid;
use crate::sim::pathing::Pathfinder;
use crate::sim::world::World;

/** The tiles of the current spawn-to-base route. */
pub class RouteOverlay {
    finder   : Pathfinder;
    tiles    : BitSet;
    path     : Vec<i32>;
    known    : i32 = -1;
    knownMap : i32 = -1;

    /** An overlay that has not seen a world yet. */
    constructor() {
        self.finder = new Pathfinder();
        self.tiles = new BitSet(Grid::tileCount());
        self.path = new Vec<i32>();
    }

    /** Recomputes the route when `world`'s map differs from the one last seen. */
    pub fn refresh(mut self, world : World) : void {
        let version : i32 = world.routes.version();
        if (version == self.known && world.seed as i32 == self.knownMap) {
            return;
        }
        self.known = version;
        self.knownMap = world.seed as i32;
        self.tiles.clear();
        if (self.finder.find(world.grid.blockedSet(), Grid::spawnTile(), Grid::goalTile(), self.path)) {
            for (i of 0..self.path.len()) {
                self.tiles.set(self.path.get(i));
            }
        }
    }

    /** True when tile `t` is on the route. */
    pub fn covers(self, t : i32) : bool {
        return self.tiles.has(t);
    }

    /** The length of the route in tiles, 0 when there is none. */
    pub fn length(self) : i32 {
        return self.path.len();
    }
}

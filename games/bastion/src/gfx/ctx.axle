// ctx — what every scene draw function needs, bundled once instead of passed as five arguments.
//
// The device to draw on, the assets to draw with, the view that culls, the light that tints and the counters the
// cull feeds. `BoxSpec` is the other repeated shape of the scene: a cube or ball placed by centre and size, with
// the tint it is lit with. The context holds no state of its own; it only spares each draw function from
// repeating `dev.drawMesh(mesh, boxAt(..), texture, light.skin(..))`.

use ludax::Vec3;
use smalt::{Mesh, SoftDevice, Texture};

use crate::gfx::assets::Assets;
use crate::gfx::look::{DrawStats, Lighting};
use crate::gfx::model::{boxAt, placed};
use crate::gfx::view::View;

/** One box-shaped thing: where its centre is, how big it is along each axis, and the tint it is lit with. */
pub struct BoxSpec {
    /** The centre, in world units. */
    pub at : Vec3;

    /** The full extent along x, y and z. */
    pub size : Vec3;

    /** The packed 0xRRGGBB tint; 0xFFFFFF leaves the texture as it is. */
    pub tint : i32;

    /** A box at `at` of `size` with `tint`. */
    pub static fn make(at : Vec3, size : Vec3, tint : i32) : BoxSpec {
        return BoxSpec { at: at, size: size, tint: tint };
    }
}

/** The device, assets, view, light and cull counters a draw function works with. */
pub struct DrawCtx {
    /** The device drawn on. */
    pub dev : SoftDevice;

    /** The meshes and textures. */
    pub assets : Assets;

    /** The camera, for the frustum test. */
    pub view : View;

    /** The light of this frame. */
    pub light : Lighting;

    /** The cull counters of this frame. */
    pub stats : DrawStats;

    /** Whether a box at `center` with half extents `half` is in view; counts it as drawn or culled. */
    pub fn sees(mut self, center : Vec3, half : Vec3) : bool {
        return self.stats.visible(self.view.seesBox(center, half));
    }

    /** Draws `mesh` as the box `spec`, textured with `tex` and lit by this frame's light. */
    pub fn skinBox(mut self, mesh : Mesh, tex : Texture, spec : BoxSpec) : void {
        self.dev.drawMesh(mesh, boxAt(spec.at, spec.size), tex, self.light.skin(spec.tint));
    }

    /** The same in a flat colour, ignoring the texture's pattern. */
    pub fn paintBox(mut self, mesh : Mesh, tex : Texture, spec : BoxSpec) : void {
        self.dev.drawMesh(mesh, boxAt(spec.at, spec.size), tex, self.light.paint(spec.tint));
    }

    /** The same glowing by `amount` (0 to 1) whatever the light is. */
    pub fn glowBox(mut self, mesh : Mesh, tex : Texture, spec : BoxSpec, amount : f32) : void {
        self.dev.drawMesh(mesh, boxAt(spec.at, spec.size), tex, self.light.glow(spec.tint, amount));
    }

    /** `skinBox` turned `yaw` radians about the vertical. */
    pub fn skinTurned(mut self, mesh : Mesh, tex : Texture, spec : BoxSpec, yaw : f32) : void {
        self.dev.drawMesh(mesh, placed(spec.at, yaw, spec.size), tex, self.light.skin(spec.tint));
    }

    /** `paintBox` turned `yaw` radians about the vertical. */
    pub fn paintTurned(mut self, mesh : Mesh, tex : Texture, spec : BoxSpec, yaw : f32) : void {
        self.dev.drawMesh(mesh, placed(spec.at, yaw, spec.size), tex, self.light.paint(spec.tint));
    }

    /** `glowBox` turned `yaw` radians about the vertical. */
    pub fn glowTurned(mut self, mesh : Mesh, tex : Texture, spec : BoxSpec, amount : f32, yaw : f32) : void {
        self.dev.drawMesh(mesh, placed(spec.at, yaw, spec.size), tex, self.light.glow(spec.tint, amount));
    }
}

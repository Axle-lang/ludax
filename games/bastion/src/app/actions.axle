// actions — the player's intentions, turned into commands on the world and messages for the interface.
//
// Input code decides *what the player meant* (a click on tile 57 while a cannon is chosen); this file does it:
// asks the world's rules, then writes the answer on the message line. Keeping it apart from the event
// handling lets the smoke test's bot use exactly the same entry points.

use ludax::EntityId;

use crate::app::game::Game;
use crate::sim::commands::{Verdict, buildTower, upgradeTower, sellTower, callWaveEarly, sellValue};
use crate::sim::stats::{TowerKind, towerStats};
use crate::ui::pick::pointAt;

/** Chooses tower design `slot` (0 to 2) for placing, or drops the choice if it is already chosen. */
pub fn chooseKind(g : Game, slot : i32) : void {
    let kind : TowerKind = TowerKind::fromSlot(slot);
    if (g.ui.building && g.ui.kind == kind) {
        g.ui.building = false;
        return;
    }
    g.ui.building = true;
    g.ui.kind = kind;
    g.ui.selected = EntityId::none();

    let cost : i32 = towerStats(kind, 1).cost;
    g.ui.say("${kind.label()} tower: click a free tile to build (${cost} gold)", false);
}

/** Works out the tile and tower under the pointer from the camera of this frame. */
pub fn refreshHover(g : Game) : void {
    let at = pointAt(g.world, g.view, g.ui.mouseX, g.ui.mouseY);
    g.ui.hoverTile = at.tile;
    g.ui.hoverTower = at.tower;
}

/** A left click on the map: build where the pointer is, or select the tower there. */
pub fn clickMap(g : Game) : void {
    refreshHover(g);
    if (!g.ui.hoverTower.isNone()) {
        g.ui.selected = g.ui.hoverTower;
        g.ui.building = false;
        return;
    }
    if (g.ui.building && g.ui.hoverTile >= 0) {
        let verdict : Verdict = buildTower(g.world, g.ui.kind, g.ui.hoverTile);
        report(g, verdict, "Built a ${g.ui.kind.label()} tower");
        return;
    }
    g.ui.selected = EntityId::none();
}

/** Upgrades the selected tower. */
pub fn upgradeSelected(g : Game) : void {
    if (g.ui.selected.isNone()) {
        return;
    }
    report(g, upgradeTower(g.world, g.ui.selected), "Tower upgraded");
}

/** Sells the selected tower. */
pub fn sellSelected(g : Game) : void {
    if (g.ui.selected.isNone()) {
        return;
    }
    let mut paid : i32 = 0;
    if (g.world.towers.has(g.ui.selected)) {
        paid = sellValue(g.world.towers.get(g.ui.selected));
    }

    let verdict : Verdict = sellTower(g.world, g.ui.selected);
    if (verdict == Verdict::Done) {
        g.ui.selected = EntityId::none();
    }
    report(g, verdict, "Sold for ${paid} gold");
}

/** Calls the next wave early. */
pub fn callWave(g : Game) : void {
    report(g, callWaveEarly(g.world), "Next wave called");
}

// Writes the verdict on the message line: the success text, or the reason for the refusal.
fn report(g : Game, verdict : Verdict, done : string) : void {
    if (verdict == Verdict::Done) {
        g.ui.say(done, false);
    } else {
        g.ui.say(verdict.message(), true);
    }
}

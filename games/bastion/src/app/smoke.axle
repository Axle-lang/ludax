// smoke — playing the game headless: a scripted player, fixed ticks, and a checksum at the end.
//
// `--smoke N` makes a `Game`, lets the bot play N ticks through the same events a person would cause, and prints
// the summary and a checksum of the final state. The same seed gives the same line every time; that is the
// determinism check. With `--shot FILE` the final frame is drawn into a software framebuffer (no window) and
// written as a BMP, which is how the picture is verified without a display.

use smalt::Bmp;

use crate::app::args::Args;
use crate::app::bot::Bot;
use crate::app::game::Game;
use crate::gfx::frame::drawFrame;
use crate::gfx::renderer::Renderer;
use crate::sim::checksum::checksum;
use crate::sim::config::{VIEW_W, VIEW_H};
use crate::ui::pen::Pen;
use crate::ui::state::Screen;

/** Ticks the game-over screenshot may run before it is taken without a defeat. */
const SMOKE_GAME_OVER_GUARD : i32 = 200000;

/** Frames the renderer believes have passed for a screenshot, so its animation has settled. */
const SMOKE_SHOT_FRAMES : i32 = 20;

/** The frame rate a screenshot reports on the F3 overlay, since no pacer measured one. */
const SMOKE_SHOT_FPS : i32 = 60;

/** Plays `ticks` ticks of a scripted game and prints the result; returns the exit code. */
pub fn runSmoke(args : Args) : i32 {
    let mut game = new Game(args.seed, true);
    game.ui.showDebug = args.debugOverlay;
    let bot = new Bot(args.seed);
    let mut ticks : i32 = args.smokeTicks;
    if (args.shotScreen == "title") {
        ticks = 0;
    } else {
        game.begin();
    }
    for (i of 0..ticks) {
        bot.act(game);
        game.tickOnce();
    }
    if (args.shotScreen == "over") {
        forceGameOver(game);
    }
    printSummary(game, bot, ticks);
    if (args.shotPath.length > 0) {
        return writeShot(args, game);
    }
    return 0;
}

// For the game-over screenshot: let the world run with no defence until the base falls.
fn forceGameOver(game : Game) : void {
    let mut guard : i32 = 0;
    while (game.screen == Screen::Playing && guard < SMOKE_GAME_OVER_GUARD) {
        game.tickOnce();
        guard = guard + 1;
    }
}

// The one line the determinism check compares, then the bot's tally.
fn printSummary(game : Game, bot : Bot, ticks : i32) : void {
    let w = game.world;
    println("smoke: ticks ${ticks} wave ${w.wave} gold ${w.gold} lives ${w.lives} score ${w.score} kills ${w.kills}");
    println("smoke: towers ${w.towers.len()} enemies ${w.enemies.len()} shots ${w.shots.len()} fx ${w.fx.len()} searches ${w.routes.searchCount()}");
    println("smoke: bot built ${bot.builds} refused ${bot.refused} upgraded ${bot.upgrades} sold ${bot.sales} called ${bot.calls} misclicks ${bot.misses}");
    println("smoke: checksum ${checksum(w)}");
}

// Renders the game once into a software framebuffer and writes it out.
fn writeShot(args : Args, game : Game) : i32 {
    let renderer = new Renderer(VIEW_W, VIEW_H, args.seed);
    defer renderer.close();
    let pen = new Pen(renderer.frame());
    defer pen.close();
    game.frames = SMOKE_SHOT_FRAMES;
    game.rig.reset();
    drawFrame(renderer, pen, game, SMOKE_SHOT_FPS);
    if (!Bmp::write(args.shotPath, renderer.frame())) {
        println("bastion: could not write ${args.shotPath}");
        return 1;
    }
    println("wrote ${args.shotPath}");
    return 0;
}

// args — the command line.
//
// `--seed N` fixes the run (every restart replays the same map and waves), `--smoke N` plays N simulation
// ticks with a scripted player and no window, `--shot FILE` writes the finished frame as a BMP (`--screen`
// picks play, title or over), `--frames N` closes the window after N frames, `--autoplay` lets the scripted
// player drive the window, `--debug` opens the F3 overlay, and `--check` runs the self-tests. Anything unknown
// is reported and ignored.

use std::lang::{IndexOutOfBoundsException, ParseException};
use std::sys::process::{argc, argAt};

/** Seed used when `--seed` is absent: a fixed date, so a bare run still replays. */
const ARGS_DEFAULT_SEED : u64 = 20241104;

/** What the command line asked for. */
pub class Args {
    /** The seed, when `--seed` was given. */
    pub(crate) seed : u64 = ARGS_DEFAULT_SEED;

    /** True when `--seed` was given. */
    pub(crate) seedGiven : bool = false;

    /** Ticks to play headless, or 0 for an interactive game. */
    pub(crate) smokeTicks : i32 = 0;

    /** Where to write a BMP of the last frame, or empty. */
    pub(crate) shotPath : string = "";

    /** Which screen the shot shows: play, title or over. */
    pub(crate) shotScreen : string = "play";

    /** Frames after which an interactive run closes itself, or 0 for never. */
    pub(crate) maxFrames : i32 = 0;

    /** True to run the self-tests and exit. */
    pub(crate) check : bool = false;

    /** True to let the scripted player drive the window (a demo, and a test of the live loop). */
    pub(crate) autoplay : bool = false;

    /** True to show the F3 overlay from the start (for screenshots). */
    pub(crate) debugOverlay : bool = false;

    /** Reads the process arguments. */
    pub static fn parse() : Args {
        let mut a : Args = new Args();
        let mut i : i32 = 1;
        while (i < argc()) {
            try {
                let flag : string = argAt(i);
                i = i + 1;
                if (flag == "--seed") {
                    a.seed = argAt(i).toI64() as u64;
                    a.seedGiven = true;
                    i = i + 1;
                } else if (flag == "--smoke") {
                    a.smokeTicks = argAt(i).toI32();
                    i = i + 1;
                } else if (flag == "--shot") {
                    // A copy: `argAt` lends the process argument, and the path outlives parsing.
                    a.shotPath = argAt(i) + "";
                    i = i + 1;
                } else if (flag == "--screen") {
                    a.shotScreen = argAt(i) + "";
                    i = i + 1;
                } else if (flag == "--frames") {
                    a.maxFrames = argAt(i).toI32();
                    i = i + 1;
                } else if (flag == "--check") {
                    a.check = true;
                } else if (flag == "--autoplay") {
                    a.autoplay = true;
                } else if (flag == "--debug") {
                    a.debugOverlay = true;
                } else {
                    println("bastion: ignoring unknown argument ${flag}");
                }
            } catch e : IndexOutOfBoundsException {
                println("bastion: a flag is missing its value");
                return a;
            } catch e : ParseException {
                println("bastion: a flag has a value that is not a number");
                return a;
            }
        }
        return a;
    }
}

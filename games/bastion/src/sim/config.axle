// config — the numbers that define Bastion: the map, the clock, the economy and the screen.
//
// Everything a designer would tune without touching logic lives here, so a balance change is one edit in one
// place. Per-kind stat tables are in `stats.axle`; this file holds the scalars. Distances are in world units
// (one tile is one unit), times in simulation ticks, and the simulation runs at `TICK_HZ` ticks per second.

/** Tiles across the map (x axis). */
pub const GRID_W : i32 = 22;

/** Tiles deep (z axis). */
pub const GRID_H : i32 = 15;

/** The row, counted from the top, where enemies enter on the left edge and leave on the right edge. */
pub const LANE_ROW : i32 = 7;

/** Simulation ticks per second of game time. */
pub const TICK_HZ : i32 = 60;

/** Most ticks a single frame may owe the simulation before time is dropped. */
pub const MAX_TICKS_PER_FRAME : i32 = 6;

/** Percent figures are whole parts out of this: a share of 70 means 70 of `PERCENT_WHOLE`. */
pub const PERCENT_WHOLE : i32 = 100;

/** Gold the player starts a run with. */
pub const START_GOLD : i32 = 160;

/** Lives the base starts with. */
pub const START_LIVES : i32 = 20;

/** Share of the invested gold a sale gives back, in percent. */
pub const SELL_PERCENT : i32 = 70;

/** Ticks the player gets to prepare before the first wave. */
pub const FIRST_WAVE_DELAY : i32 = 900;

/** Ticks between the end of one wave's spawning and the start of the next. */
pub const WAVE_GAP : i32 = 1500;

/** Gold given for calling a wave early, per second of waiting that is skipped. */
pub const EARLY_BONUS_PER_SECOND : i32 = 1;

/** Highest tower level. */
pub const MAX_LEVEL : i32 = 3;

/** Most enemies a single wave may contain. */
pub const MAX_WAVE_SIZE : i32 = 48;

/** Height above the ground at which a tower launches a shot, in tiles. */
pub const SHOT_HEIGHT : f32 = 0.8;

/** Ticks in a full day and night. */
pub const DAY_TICKS : i32 = 7200;

/** Share of the map's tiles that are turned into rocks, in percent. */
pub const ROCK_PERCENT : i32 = 13;

/** Pixel width of the window's client area. */
pub const VIEW_W : i32 = 1024;

/** Pixel height of the window's client area. */
pub const VIEW_H : i32 = 640;

/** Frames per second the display loop is paced to. */
pub const FRAME_RATE : i32 = 60;

/** Height of the camera's vertical field of view, in degrees. */
pub const FOV_DEGREES : f32 = 50.0;

// units — the components the simulation keeps: enemies, towers, shots and effects.
//
// Each is a plain struct stored by value in a ludax container (`Slab` for things other things refer to,
// `SparseSet` for things nobody refers to). The structs hold numbers only; what they mean is decided by the
// systems beside it in `sim/`. Positions are on the ground plane, so a `Vec2` is (x, z) in world units.

use ludax::{EntityId, Vec2, Vec3};

use crate::sim::stats::{TowerKind, EnemyKind};

/** One walker on its way to the base. */
pub struct Enemy {
    /** What it is. */
    pub kind : EnemyKind;

    /** Where it stands. */
    pub pos : Vec2;

    /** Direction it faces, radians around the vertical axis. */
    pub heading : f32;

    /** The tile it last stood on the middle of. */
    pub fromTile : i32;

    /** The tile it is walking to. */
    pub toTile : i32;

    /** Hit points left. */
    pub health : i32;

    /** Hit points at birth, for the health bar. */
    pub maxHealth : i32;

    /** Distance walked so far; the "first" targeting order uses it. */
    pub walked : f32;

    /** Ticks since it spawned, for the walking bob. */
    pub age : i32;

    /** A fresh enemy of `kind` standing on tile `tile`'s middle with `health` hit points. */
    pub static fn newborn(kind : EnemyKind, tile : i32, centre : Vec2, health : i32) : Enemy {
        return Enemy {
            kind: kind,
            pos: centre,
            heading: 0.0,
            fromTile: tile,
            toTile: tile,
            health: health,
            maxHealth: health,
            walked: 0.0,
            age: 0,
        };
    }
}

/** A status effect that slows an enemy; kept in its own sparse set, keyed by the enemy's slot. */
pub struct Slow {
    /** Percent of speed removed. */
    pub percent : i32;

    /** Ticks left. */
    pub ticks : i32;
}

/** A tower standing on one tile. */
pub struct Tower {
    /** Which design. */
    pub kind : TowerKind;

    /** The tile it stands on. */
    pub tile : i32;

    /** 1 to `MAX_LEVEL`. */
    pub level : i32;

    /** Ticks until it may fire again. */
    pub cooldown : i32;

    /** Gold put into it so far; a sale returns a share of this. */
    pub invested : i32;

    /** Direction the head faces, radians around the vertical axis. */
    pub aim : f32;

    /** Ticks since it last fired, for the recoil animation. */
    pub sinceShot : i32;
}

/** A projectile in flight. */
pub struct Shot {
    /** The tower design that fired it; decides its look and its effect. */
    pub kind : TowerKind;

    /** Position on the ground plane. */
    pub pos : Vec2;

    /** Height above the ground, for drawing the arc. */
    pub height : f32;

    /** The enemy it chases. */
    pub target : EntityId;

    /** Where the target was last seen; the shot flies on to here if the target dies first. */
    pub aimAt : Vec2;

    /** Distance to the target when it was fired, for the arc. */
    pub startDistance : f32;

    /** Hit points taken on impact. */
    pub damage : i32;

    /** Blast radius, 0 for none. */
    pub splash : f32;

    /** Percent of speed removed from what it hits. */
    pub slowPercent : i32;

    /** Duration of that slow in ticks. */
    pub slowTicks : i32;

    /** Speed in tiles per tick. */
    pub speed : f32;
}

/** What a visual effect is. */
pub enum FxKind : i8 {
    /** A spark of debris that flies out and falls. */
    Spark = 0,

    /** A "+gold" label that floats up. */
    Coin = 1,

    /** An expanding ring on the ground, for a blast. */
    Ring = 2,

    /** A red puff where an enemy reached the base. */
    Leak = 3,
}

/** A request to start a visual effect: what, where, how it moves, and for how long. */
pub struct FxSpawn {
    /** What to show. */
    pub kind : FxKind;

    /** Where it starts. */
    pub pos : Vec3;

    /** Velocity per tick. */
    pub vel : Vec3;

    /** Ticks it lives. */
    pub life : i32;

    /** Gold to show for a coin, or a size for a ring. */
    pub value : i32;
}

/** A short-lived visual effect; the simulation owns it so it replays exactly. */
pub struct Fx {
    /** What it is. */
    pub kind : FxKind;

    /** World position. */
    pub pos : Vec3;

    /** Velocity per tick. */
    pub vel : Vec3;

    /** Ticks left. */
    pub life : i32;

    /** Ticks it started with. */
    pub span : i32;

    /** A number to show (gold for a coin) or a size (percent of a tile for a ring). */
    pub value : i32;
}

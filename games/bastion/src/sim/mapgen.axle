// mapgen — scattering the rocks of a map from a seed.
//
// Rocks are drawn tile by tile from a `Pcg32`, keeping the lane's two ends clear, and the draw is repeated
// until the pathfinder's flood fill says the spawn can still reach the base. After eight unlucky draws the
// map is left open, so every seed gives a map the enemies can cross.

use ludax::Pcg32;

use crate::sim::config::{ROCK_PERCENT, PERCENT_WHOLE};
use crate::sim::grid::Grid;
use crate::sim::pathing::Pathfinder;

/** How many times a draw is retried before the map is left without rocks. */
const MAP_ATTEMPTS : i32 = 8;

/** Fills `grid` with rocks drawn from `rng`, leaving the route from spawn to base open. */
pub fn scatterRocks(grid : Grid, rng : Pcg32, finder : Pathfinder) : void {
    for (attempt of 0..MAP_ATTEMPTS) {
        grid.clearRocks();
        for (t of 0..Grid::tileCount()) {
            if (Grid::rockAllowed(t) && rng.range(0, PERCENT_WHOLE) < ROCK_PERCENT) {
                grid.placeRock(t);
            }
        }
        if (finder.canReach(grid.blockedSet(), Grid::spawnTile(), Grid::goalTile())) {
            return;
        }
    }
    grid.clearRocks();
}

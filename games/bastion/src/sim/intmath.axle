// intmath — the one integer helper the game shares across its layers.
//
// ludax's scalar maths is `f32`; pointer deltas, grid steps and Bresenham lines are whole numbers, and each
// of them needs the magnitude of one. It lives here once so the layers do not grow a private copy apiece.

/** The magnitude of `v`; `i32::MIN` has none and is not a value the game produces. */
pub fn intAbs(v : i32) : i32 {
    if (v < 0) {
        return 0 - v;
    }
    return v;
}

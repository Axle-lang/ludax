// stats — what each kind of tower and enemy is worth, costs and does.
//
// Plain data behind small enums: the simulation asks `towerStats(kind, level)` or `enemyStats(kind)` and never
// branches on a kind itself. Numbers are tuned together; read the columns across kinds to see the intent
// (arrows are cheap and quick, cannons hit groups, frost slows what the others finish).

use crate::sim::config::MAX_LEVEL;

/** Hit points an enemy gains per wave after the first, in percent of its base. */
const ENEMY_GROWTH_PERCENT : i32 = 14;

/** Percent is stored as whole parts of this. */
const STAT_PERCENT_SCALE : i32 = 100;

/** The three towers a player can build. */
pub enum TowerKind : i8 {
    /** Cheap, fast, single target. */
    Arrow = 0,

    /** Slow lobbed shells that hurt everything near the impact. */
    Cannon = 1,

    /** Weak bolts that slow whatever they hit. */
    Frost = 2,

    /** The tower for key slot `i` (0, 1, 2); anything else answers Arrow. */
    pub static fn fromSlot(i : i32) : TowerKind {
        return match i {
            1 => TowerKind::Cannon,
            2 => TowerKind::Frost,
            _ => TowerKind::Arrow,
        };
    }

    /** Short display name. */
    pub fn label(self) : string {
        return match self {
            TowerKind::Arrow => "Arrow",
            TowerKind::Cannon => "Cannon",
            TowerKind::Frost => "Frost",
        };
    }
}

/** The kinds of enemy a wave is built from. */
pub enum EnemyKind : i8 {
    /** The plain walker. */
    Grunt = 0,

    /** Fast and fragile. */
    Runner = 1,

    /** Slow, armoured and costly to let through. */
    Brute = 2,

    /** A wave-ending giant. */
    Boss = 3,

    /** The kind stored as `i` in a wave plan. */
    pub static fn fromIndex(i : i32) : EnemyKind {
        return match i {
            1 => EnemyKind::Runner,
            2 => EnemyKind::Brute,
            3 => EnemyKind::Boss,
            _ => EnemyKind::Grunt,
        };
    }

    /** Short display name. */
    pub fn label(self) : string {
        return match self {
            EnemyKind::Grunt => "Grunt",
            EnemyKind::Runner => "Runner",
            EnemyKind::Brute => "Brute",
            EnemyKind::Boss => "Boss",
        };
    }
}

/** One tower kind at one level. */
pub struct TowerStats {
    /** Gold to build (level 1) — upgrades use `upgradeCost`. */
    pub cost : i32;

    /** Gold to raise this level to the next, 0 at the top level. */
    pub upgradeCost : i32;

    /** How far it can shoot, in tiles. */
    pub range : f32;

    /** Hit points taken from the target. */
    pub damage : i32;

    /** Ticks between shots. */
    pub cooldown : i32;

    /** Projectile speed in tiles per tick. */
    pub shotSpeed : f32;

    /** Radius of the blast around the impact, 0 for a single target. */
    pub splash : f32;

    /** Percent of speed removed from what is hit, 0 for none. */
    pub slowPercent : i32;

    /** How long that slow lasts, in ticks. */
    pub slowTicks : i32;
}

/** The numbers for `kind` at `level` (1 to `MAX_LEVEL`; other levels are clamped). */
pub fn towerStats(kind : TowerKind, level : i32) : TowerStats {
    let mut l : i32 = level;
    if (l < 1) {
        l = 1;
    }
    if (l > MAX_LEVEL) {
        l = MAX_LEVEL;
    }
    return match kind {
        TowerKind::Arrow => arrowStats(l),
        TowerKind::Cannon => cannonStats(l),
        TowerKind::Frost => frostStats(l),
    };
}

fn arrowStats(l : i32) : TowerStats {
    return TowerStats {
        cost: 50,
        upgradeCost: pick3(l, 45, 80, 0),
        range: pick3f(l, 3.1, 3.5, 3.9),
        damage: pick3(l, 9, 16, 28),
        cooldown: pick3(l, 24, 19, 14),
        shotSpeed: 0.24,
        splash: 0.0,
        slowPercent: 0,
        slowTicks: 0,
    };
}

fn cannonStats(l : i32) : TowerStats {
    return TowerStats {
        cost: 110,
        upgradeCost: pick3(l, 90, 150, 0),
        range: pick3f(l, 3.4, 3.7, 4.0),
        damage: pick3(l, 34, 60, 100),
        cooldown: pick3(l, 80, 70, 60),
        shotSpeed: 0.12,
        splash: pick3f(l, 1.1, 1.3, 1.55),
        slowPercent: 0,
        slowTicks: 0,
    };
}

fn frostStats(l : i32) : TowerStats {
    return TowerStats {
        cost: 85,
        upgradeCost: pick3(l, 65, 110, 0),
        range: pick3f(l, 2.9, 3.2, 3.5),
        damage: pick3(l, 4, 7, 11),
        cooldown: pick3(l, 38, 32, 26),
        shotSpeed: 0.16,
        splash: 0.0,
        slowPercent: pick3(l, 40, 52, 64),
        slowTicks: pick3(l, 100, 130, 160),
    };
}

/** The first, second or third value for level 1, 2 or 3. */
fn pick3(level : i32, a : i32, b : i32, c : i32) : i32 {
    if (level <= 1) {
        return a;
    }
    if (level == 2) {
        return b;
    }
    return c;
}

/** The float twin of `pick3`. */
fn pick3f(level : i32, a : f32, b : f32, c : f32) : f32 {
    if (level <= 1) {
        return a;
    }
    if (level == 2) {
        return b;
    }
    return c;
}

/** One enemy kind at wave 1; hit points grow with the wave number (see `scaledHealth`). */
pub struct EnemyStats {
    /** Hit points at wave 1. */
    pub health : i32;

    /** Speed in tiles per tick. */
    pub speed : f32;

    /** Gold paid when it dies. */
    pub bounty : i32;

    /** Score paid when it dies. */
    pub points : i32;

    /** Lives lost when it reaches the base. */
    pub leakDamage : i32;

    /** Radius of its body, in tiles, for hit tests and drawing. */
    pub radius : f32;

    /** Points it counts for when a wave is composed. */
    pub weight : i32;
}

/** The numbers for `kind`. */
pub fn enemyStats(kind : EnemyKind) : EnemyStats {
    return match kind {
        EnemyKind::Grunt => EnemyStats {
            health: 30,
            speed: 0.016,
            bounty: 4,
            points: 10,
            leakDamage: 1,
            radius: 0.22,
            weight: 3,
        },
        EnemyKind::Runner => EnemyStats {
            health: 17,
            speed: 0.030,
            bounty: 4,
            points: 14,
            leakDamage: 1,
            radius: 0.17,
            weight: 4,
        },
        EnemyKind::Brute => EnemyStats {
            health: 150,
            speed: 0.0105,
            bounty: 14,
            points: 40,
            leakDamage: 3,
            radius: 0.30,
            weight: 12,
        },
        EnemyKind::Boss => EnemyStats {
            health: 800,
            speed: 0.0085,
            bounty: 90,
            points: 250,
            leakDamage: 10,
            radius: 0.40,
            weight: 60,
        },
    };
}

/** Hit points of an enemy spawned during `wave`: +14 percent of the base for every wave after the first. */
pub fn scaledHealth(base : i32, wave : i32) : i32 {
    return base * (STAT_PERCENT_SCALE + ENEMY_GROWTH_PERCENT * (wave - 1)) / STAT_PERCENT_SCALE;
}

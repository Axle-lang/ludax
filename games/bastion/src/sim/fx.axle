// fx — ageing the visual effects.
//
// Sparks fall under gravity, labels drift up, rings and puffs just count down. They live in the simulation
// rather than the renderer so that a replay produces the same picture and the checksum covers them.

use ludax::Vec3;

use crate::sim::units::{Fx, FxKind};
use crate::sim::world::World;

/** Downward pull on sparks, in tiles per tick squared. */
const SPARK_GRAVITY : f32 = 0.0035;

/** Height a spark settles at, so it does not sink through the ground. */
const SPARK_FLOOR : f32 = 0.03;

/** One tick for every effect; finished ones are removed. */
pub fn stepFx(w : World) : void {
    w.doomedKeys.clear();
    for (d of 0..w.fx.len()) {
        let mut f : Fx = w.fx.valueAt(d);
        f.pos = f.pos.plus(f.vel);
        if (f.kind == FxKind::Spark) {
            f.vel.y = f.vel.y - SPARK_GRAVITY;
            if (f.pos.y < SPARK_FLOOR) {
                f.pos.y = SPARK_FLOOR;
                f.vel = Vec3::zero();
            }
        }
        f.life = f.life - 1;
        w.fx.setValueAt(d, f);
        if (f.life <= 0) {
            w.doomedKeys.push(w.fx.keyAt(d));
        }
    }
    for (i of 0..w.doomedKeys.len()) {
        let key : i32 = w.doomedKeys.get(i);
        w.fx.remove(key);
        w.fxIds.destroy(w.fxIds.idAt(key));
    }
}
